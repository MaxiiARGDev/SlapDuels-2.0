-- Catalog only; no purchases, grants or persistence are performed here.
local Existing = require(script.Parent.PointEffectDefinitions)
local frost = assert(Existing.Get("Frost"))
local void = assert(Existing.Get("Void"))
return {
 DefaultFall = {
