        <Item class="ModuleScript" referent="296">
          <Properties>
            <string name="Name">VariationDefinitions</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Generated cosmetic manifest. Commercial settings remain unchanged.
return {
