          <string name="Name">Crates</string>
        </Properties>
        <Item class="ModuleScript" referent="950">
          <Properties>
            <string name="Name">AnnouncementAdapter</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Local TextChat bridge only. Optional global transport contract is inert until a later authorised phase.
local Adapter={};Adapter.__index=Adapter
function Adapter.new(sendLocal,globalProvider)
 return setmetatable({SendLocal=sendLocal,GlobalProvider=globalProvider,GlobalEnabled=false,Seen={}},Adapter)
end
function Adapter:AnnounceOnce(id,packet)
 if self.Seen[id]then return false,"AlreadyAnnounced"end
 self.Seen[id]=true
 local ok=pcall(self.SendLocal,packet)
 return ok,if ok then nil else "DeliveryUnknown"
end
function Adapter:PublishGlobal(_id,_packet)
 -- No MessagingService lookup, no cross-server writes or hidden activation switch in V1.
 return false,"GlobalAnnouncementsRequireAuthorisedBackend"
end
return Adapter
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="951">
          <Properties>
            <string name="Name">CrateBatchEngine</string>
            <string name="Source"><![CDATA[--!nonstrict
-- No-yield staging/reservations in one Studio server. Never a durable cross-server transaction.
local RS=game:GetService("ReplicatedStorage")
local Inventory=require(RS.Shared.SlapCrates.Inventory)
local Odds=require(RS.Shared.SlapCrates.Odds)
local VisualMetadata=require(script.Parent.RewardVisualMetadata)
local Batch={}
function Batch.Stage(data,crate,id,uid,catalog,stock,random,available,quantity)
 local inv=Inventory.Extend(data.Inventory)
 local valid,reason=Inventory.Validate(inv);if not valid then return nil,reason end
 if (inv.Crates[crate.CrateId]or 0)<quantity then return nil,"InsufficientCrates"end
 if type(random)~="function"then return nil,"InvalidRandomSource"end
 local nextData=table.clone(data);nextData.Inventory=inv
 local op={OperationId=id,BatchId=tostring(uid)..":"..id,UnitId=tostring(uid)..":"..id,
  Kind="Open",CrateId=crate.CrateId,Quantity=quantity,OwnerUserId=uid,CreatedAt=os.time(),
  State="GrantCommitted",PresentationSent=false,Rewards={}}
 local reserved={}
 local ok,failure=pcall(function()
  for index=1,quantity do
   -- Newly owned prizes and previous reservations alter eligibility for the next draw.
   local rows,why=Odds.Resolve(crate,catalog,inv,stock,available)
   if not rows then error(why or "NoEligibleResults",0)end
   local reward=Odds.Roll(rows,random());local variation=catalog.Variations.ById[reward.VariationId]
   local percent,eligible=VisualMetadata.Read(rows,reward.RewardId)
   if index==1 then op.PreviewRewardIds=eligible end
   local unitId=op.BatchId..":"..index
   table.insert(reserved,unitId) -- Also release if Reserve throws after allocating.
   local held,code=stock:Reserve(unitId,uid,reward,variation)
   if not held then error(code or "StockUnavailable",0)end
   local unit={UnitId=unitId,RewardId=reward.RewardId,SlapId=reward.SlapId,VariationId=reward.VariationId,
    OperationId=id,OwnerUserId=uid,EditionId=reward.EditionId,VariationEditionId=variation.EditionId,Origin="Crate",EffectivePercent=percent}
   table.insert(op.Rewards,unit);inv.SlapUnits[unitId]=unit;inv.Owned.Slaps[reward.RewardId]=true
  end
 end)
 if not ok then
  for _,unitId in ipairs(reserved)do stock:Release(unitId)end
  return nil,tostring(failure)
 end
 inv.Crates[crate.CrateId]-=quantity
 op.RewardId=op.Rewards[1].RewardId;op.SlapId=op.Rewards[1].SlapId;op.VariationId=op.Rewards[1].VariationId
 op.EffectivePercent=op.Rewards[1].EffectivePercent
 inv.CrateOperations[id]=op
 return nextData,nil,op,false
end
return Batch
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="952">
          <Properties>
            <string name="Name">CrateEngine</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Pure staging on the EXISTING profile, then stock reservation; presentation never grants items.
local RS=game:GetService("ReplicatedStorage")
local Inventory=require(RS.Shared.SlapCrates.Inventory)
local Odds=require(RS.Shared.SlapCrates.Odds)
local BatchRules=require(RS.Shared.SlapCrates.BatchOpening)
local BatchEngine=require(script.Parent.CrateBatchEngine)
local VisualMetadata=require(script.Parent.RewardVisualMetadata)
local Engine={}
function Engine.Approved(crate)
 if crate and crate.PremiumOnly then return crate.Enabled==true and crate.OddsApproved==true and crate.OpeningApproved==true end
 return crate and crate.Enabled==true and crate.PriceApproved==true and crate.OddsApproved==true
  and type(crate.PriceCoins)=="number" and crate.PriceCoins>0 and crate.PriceCoins<math.huge and crate.PriceCoins%1==0
end
function Engine.Stage(data,crate,kind,id,uid,catalog,stock,unit,available,quantity)
 if crate and crate.PremiumOnly and kind=="Purchase"then return nil,"PremiumPurchaseRequired"end
 quantity=BatchRules.Quantity(quantity);if not quantity then return nil,"InvalidQuantity"end
 if not Engine.Approved(crate)then return nil,"CommercialApprovalPending" end
 local inv=Inventory.Extend(data.Inventory);local old=inv.CrateOperations[id]
 if old then
  if old.Kind~=kind or old.CrateId~=crate.CrateId or(kind=="Open"and (old.Quantity or 1)~=quantity)then return nil,"OperationConflict" end
  -- Return the authoritative journal entry, not the deep copy used for staging.
  return data,nil,data.Inventory.CrateOperations[id],true
 end
 if kind=="Open"and quantity>1 then return BatchEngine.Stage(data,crate,id,uid,catalog,stock,unit,available,quantity)end
 local valid,reason=Inventory.Validate(inv);if not valid then return nil,reason end
 local rows,err=Odds.Resolve(crate,catalog,inv,stock,available);if not rows then return nil,err end
 local nextData=table.clone(data);nextData.Inventory=inv
 local op={OperationId=id,Kind=kind,CrateId=crate.CrateId,State="Committed",OwnerUserId=uid,CreatedAt=os.time()}
 if kind=="Purchase" then
  if type(data.Coins)~="number" or data.Coins~=data.Coins or data.Coins==math.huge or data.Coins<crate.PriceCoins then return nil,"InsufficientFunds" end
  nextData.Coins=data.Coins-crate.PriceCoins;inv.Crates[crate.CrateId]=(inv.Crates[crate.CrateId] or 0)+1
 elseif kind=="Open" then
  if (inv.Crates[crate.CrateId] or 0)<1 then return nil,"NoCrate" end
  local reward=Odds.Roll(rows,if type(unit)=="function"then unit()else unit)
  op.EffectivePercent,op.PreviewRewardIds=VisualMetadata.Read(rows,reward.RewardId)
  local v=catalog.Variations.ById[reward.VariationId]
  op.RewardId=reward.RewardId;op.SlapId=reward.SlapId;op.VariationId=reward.VariationId
  op.EditionId=reward.EditionId;op.VariationEditionId=v.EditionId
  -- Unit identity stays original, scoped by owner and unique operation, including negative Studio IDs.
  op.UnitId=tostring(uid)..":"..id;op.State="GrantCommitted"
  inv.Crates[crate.CrateId]-=1;inv.Owned.Slaps[reward.RewardId]=true
  inv.SlapUnits[op.UnitId]={UnitId=op.UnitId,RewardId=reward.RewardId,SlapId=reward.SlapId,VariationId=reward.VariationId,
   OperationId=id,OwnerUserId=uid,EditionId=reward.EditionId,VariationEditionId=v.EditionId,Origin="Crate"}
  -- All allocations staged before the reservation. The caller still owns the only profile commit.
  local ok,why=stock:Reserve(op.UnitId,uid,reward,v);if not ok then return nil,why end
 else return nil,"InvalidOperation" end
 inv.CrateOperations[id]=op
 return nextData,nil,op,false
end
function Engine.Release(op,stock)
 for _,unit in ipairs(BatchRules.Rewards(op))do if unit.UnitId then stock:Release(unit.UnitId)end end
end
function Engine.Reconcile(data,stock)
 local complete=true
 for _,op in pairs(data.Inventory.CrateOperations or {})do
  if op.Kind=="Open" and op.State=="GrantCommitted"then
   local all=true
   for _,unit in ipairs(BatchRules.Rewards(op))do
    local success,ok=pcall(stock.Commit,stock,unit.UnitId);if not success or not ok then all=false end
   end
   if all then op.State="Completed"else complete=false end
  end
 end
 return complete
end
return Engine
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="953">
          <Properties>
            <string name="Name">InMemoryStock</string>
            <string name="Source"><![CDATA[--!nonstrict
local Ledger=require(script.Parent.StockLedger)
local Stock={};Stock.__index=Stock
function Stock.new(sharedState)return setmetatable({State=sharedState or {Buckets={},Operations={}},Scope="StudioServerInMemory",WritesToCloud=false},Stock)end
function Stock:View(reward,variation)
 local cs,reason=Ledger.Constraints(reward,variation);if not cs then return nil,reason end
 local view,err=Ledger.View(self.State,cs,reward.RewardId);if view then view.Scope=self.Scope end;return view,err
end
function Stock:Reserve(id,userId,reward,variation)
 local cs,reason=Ledger.Constraints(reward,variation);if not cs then return false,reason end
 return Ledger.Reserve(self.State,id,userId,reward,cs)
end
function Stock:Commit(id)return Ledger.Finish(self.State,id,true)end
function Stock:Release(id)return Ledger.Finish(self.State,id,false)end
return Stock
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="954">
          <Properties>
            <string name="Name">ProductionStockAdapter</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Prepared adapter only: injected store, no DataStoreService lookup, never selected in V1.
local Ledger=require(script.Parent.StockLedger)
local Adapter={};Adapter.__index=Adapter
function Adapter.new(store,key)
 assert(store and type(store.UpdateAsync)=="function" and type(key)=="string","StoreRequired")
 return setmetatable({Store=store,Key=key,Scope="ProductionLedgerUnvalidated",WritesToCloud=true},Adapter)
end
function Adapter:View(reward,variation)
 local cs,reason=Ledger.Constraints(reward,variation);if not cs then return nil,reason end
 -- A potentially cached read cannot prove current available stock for a purchase quote.
 return nil,"AuthoritativeSnapshotRequired"
end
function Adapter:_update(transform)
 local accepted,reason
 local ok,err=pcall(function()self.Store:UpdateAsync(self.Key,function(old)
  local state=old or {Buckets={},Operations={}}
  accepted,reason=transform(state)
  return if accepted then state else nil
 end)end)
 if not ok then return false,"StockOutcomeUnknown:"..tostring(err) end
 return accepted,reason
end
function Adapter:Reserve(id,uid,reward,variation)
 local cs,reason=Ledger.Constraints(reward,variation);if not cs then return false,reason end
 return self:_update(function(state)return Ledger.Reserve(state,id,uid,reward,cs)end)
end
function Adapter:Commit(id)return self:_update(function(state)return Ledger.Finish(state,id,true)end)end
function Adapter:Release(id)return self:_update(function(state)return Ledger.Finish(state,id,false)end)end
return Adapter
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="955">
          <Properties>
            <string name="Name">RewardVisualMetadata</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Read-only snapshot of the distribution already used by Odds.Roll. Never rolls.
local Metadata={}
function Metadata.Read(rows,rewardId)
 local percent;local eligible={}
 for _,row in ipairs(rows)do
  if row.Probability>0 then table.insert(eligible,row.Reward.RewardId)end
  if row.Reward.RewardId==rewardId then percent=row.Percent end
 end
 return percent,eligible
end
return Metadata
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="956">
          <Properties>
            <string name="Name">SlapResourceRegistry</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Only physical Tools in two server-owned folders are inspected. Never require asset scripts.
local Registry={}
local function id(value)
 return type(value)=='string'and #value>0 and #value<=64 and value:match('^[%w_%-]+$')~=nil
end
local function canonical(name)return name:gsub('^Slap_','')end
local function unique(parent)
 local seen={};if parent then for _,o in ipairs(parent:GetChildren())do assert(not seen[o.Name],'DuplicateSlapResource:'..o.Name);seen[o.Name]=o end end;return seen
end
local function valid(tool)
 if not tool or not tool:IsA('Tool')then return false end
 local hand=tool:FindFirstChild('Hand');local c=tool:FindFirstChild('Configuration')
 local p=c and c:FindFirstChild('Power');local cd=c and c:FindFirstChild('SlapCooldown')
 return hand and hand:IsA('BasePart')and p and p:IsA('NumberValue')and p.Value==p.Value and p.Value>0 and p.Value<math.huge
  and cd and cd:IsA('NumberValue')and cd.Value==cd.Value and cd.Value>=0 and cd.Value<math.huge
end
function Registry.Discover(slaps,variants,variations)
 local known={};for _,v in ipairs(variations)do known[v.Id]=v end
 local models={};local diagnostics={}
 for _,tool in pairs(unique(slaps))do
  if valid(tool)then
   local key=tool:GetAttribute('SlapId')or canonical(tool.Name);assert(id(key),'InvalidSlapId')
   assert(not models[key],'DuplicateSlapId:'..key)
   models[key]={SlapId=key,Model=tool.Name,DisplayName=tool:GetAttribute('DisplayName')or(key=='Classic'and 'Clásico'or key),Base=tool,Templates={Basic=tool}}
  else table.insert(diagnostics,'Invalid base: '..tool.Name)end
 end
 for _,folder in pairs(unique(variants))do
  if folder:IsA('Folder')then
   local key=folder:GetAttribute('SlapId')or canonical(folder.Name);assert(id(key),'InvalidSlapFolder')
   local model=models[key]
   if not model then model={SlapId=key,Model=folder:GetAttribute('BaseModel')or key,DisplayName=folder:GetAttribute('DisplayName')or key,Templates={}};models[key]=model end
   assert(not model.VariantsFolder,'AmbiguousSlapVariants:'..key);model.VariantsFolder=folder.Name
   for name,tool in pairs(unique(folder))do
    if known[name]and valid(tool)then model.Templates[name]=tool
    else table.insert(diagnostics,'Invalid/unknown variant: '..folder.Name..'/'..name)end
   end
  end
 end
 local result={}
 for _,model in pairs(models)do
  model.VariationIds={}
  for _,v in ipairs(variations)do if model.Templates[v.Id]then table.insert(model.VariationIds,v.Id)end end
  if #model.VariationIds>0 then table.insert(result,model)end
 end
 table.sort(result,function(a,b)return a.SlapId<b.SlapId end)
 local default=false;for _,m in ipairs(result)do if m.SlapId=='Classic'and m.Templates.Basic then default=true end end
 assert(default,'DefaultClassicBasicRequired')
 return result,diagnostics
end
function Registry.Preview(tool,name)
 local copy=tool:Clone();local model=Instance.new('Model');model.Name=name
 for _,child in ipairs(copy:GetChildren())do child.Parent=model end;copy:Destroy()
 model.PrimaryPart=model:FindFirstChild('Hand')
 if model.PrimaryPart then model.PrimaryPart:SetAttribute('SlapVariationAuthored',true)end
 for _,o in ipairs(model:GetDescendants())do
  if o:IsA('LuaSourceContainer')then o:Destroy()
  elseif o:IsA('BasePart')then o.Anchored=true;o.CanCollide=false;o.CanTouch=false;o.CanQuery=false end
 end
 return model
end
function Registry.Publish()
 local rs=game:GetService('ReplicatedStorage');local ss=game:GetService('ServerStorage')
 local variations=require(rs.Shared.SlapCrates.VariationDefinitions)
 local models,diagnostics=Registry.Discover(ss:FindFirstChild('Slaps'),ss:FindFirstChild('SlapVariations'),variations)
 local metadata=Instance.new('Folder');metadata.Name='SlapCatalog';metadata:SetAttribute('SchemaVersion',1)
 local previews=Instance.new('Folder');previews.Name='SlapVariationPreviews'
 local bases=Instance.new('Folder');bases.Name='CrateRewardPreviews'
 for _,model in ipairs(models)do
  local entry=Instance.new('Folder');entry.Name=model.SlapId
  entry:SetAttribute('Model',model.Model);entry:SetAttribute('DisplayName',model.DisplayName)
  entry:SetAttribute('VariantsFolder',model.VariantsFolder or model.SlapId)
  local names=Instance.new('Folder');names.Name='Variations';names.Parent=entry
  local visuals=Instance.new('Folder');visuals.Name=model.SlapId
  for _,variation in ipairs(model.VariationIds)do
   local marker=Instance.new('Folder');marker.Name=variation;marker.Parent=names
   local preview=Registry.Preview(model.Templates[variation],variation)
   preview:SetAttribute('SlapId',model.SlapId);preview:SetAttribute('VariationId',variation)
   preview:SetAttribute('PreviewOfRewardId',model.SlapId..':'..variation);preview.Parent=visuals
  end
  local base=Registry.Preview(model.Templates.Basic or model.Templates[model.VariationIds[1]],model.SlapId);base.Parent=bases
  entry.Parent=metadata;visuals.Parent=previews
 end
 -- Build first, then publish. Clients wait for the runtime-ready marker before requiring Catalog.
 rs:SetAttribute('SlapCatalogReady',false)
 for _,new in ipairs({metadata,previews,bases})do local old=rs:FindFirstChild(new.Name);if old then old:Destroy()end;new.Parent=rs end
 rs:SetAttribute('SlapCatalogReady',true)
 for _,message in ipairs(diagnostics)do warn('[SlapCatalog] '..message)end
 print('[SlapCatalog] Registered '..#models..' physical Slap models')
 return models,diagnostics
end
return Registry
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="957">
          <Properties>
            <string name="Name">StandOpeningLedger</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Pure leases; never grants inventory or Coins. Time is injected and authoritative.
local Ledger={};Ledger.__index=Ledger
function Ledger.new(config,plan,clock)
 return setmetatable({Config=config,Plan=plan,Clock=clock,Players={},Stands={},Cooldowns={}},Ledger)
end
function Ledger:Release(userId,committed)
 local row=self.Players[userId];if not row then return end
 self.Players[userId]=nil
 if self.Stands[row.StandId]==row then self.Stands[row.StandId]=nil end
 if committed or row.Committed then
  local key=tostring(userId)..":"..row.StandId
  self.Cooldowns[key]=if self.Config.Stand.ReopenCooldown>0 then math.max(self.Cooldowns[key]or 0,self.Clock()+self.Config.Stand.ReopenCooldown)else nil
 end
 return row
end
function Ledger:Acquire(userId,standId,operationId,plan)
 self:Step()
 local existing=self.Players[userId]
 if existing then
  if existing.StandId==standId and existing.OperationId==operationId then return existing,nil,true end
  return nil,"OpeningInProgress"
 end
 if self.Clock()<(self.Cooldowns[tostring(userId)..":"..standId]or 0)then return nil,"StandCooldown"end
 if self.Config.Stand.ExclusiveOpening and self.Stands[standId]then return nil,"StandBusy"end
 local row={UserId=userId,StandId=standId,OperationId=operationId,Plan=plan or self.Plan,State="Reserved",Until=self.Clock()+self.Config.Stand.MaxSequenceDuration}
 self.Players[userId]=row
 if self.Config.Stand.ExclusiveOpening then self.Stands[standId]=row end
 return row
end
function Ledger:Commit(row,openingId)
 if self.Players[row.UserId]~=row or row.Committed then return false end
 row.Committed=true;row.OpeningId=openingId;row.Started=self.Clock();row.State="Opening"
 row.Until=row.Started+row.Plan.Duration
 return true
end
function Ledger:Step()
 local expired={};local now=self.Clock()
 for id,row in pairs(self.Players)do
  if now>=row.Until then table.insert(expired,id)
  elseif row.Committed then
   local elapsed=now-row.Started
   local reward=row.Plan.Stages[8].Start;local outro=row.Plan.Stages[9].Start
   row.State=if elapsed>=outro then "Finishing"elseif elapsed>=reward then "Revealing"else "Opening"
  end
 end
 local released={};for _,id in ipairs(expired)do table.insert(released,self:Release(id))end
 for key,deadline in pairs(self.Cooldowns)do if now>=deadline then self.Cooldowns[key]=nil end end
 return released
end
return Ledger
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="958">
          <Properties>
            <string name="Name">StandOpeningService</string>
            <string name="Source"><![CDATA[--!nonstrict
local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local RS=game:GetService("ReplicatedStorage")
local Config=require(RS.Shared.SlapCrates.OpeningConfig)
local Timeline=require(RS.Shared.SlapCrates.OpeningTimeline)
local Ledger=require(script.Parent.StandOpeningLedger)
local Batch=require(RS.Shared.SlapCrates.BatchOpening)
local Service={};Service.__index=Service
function Service.new(owner)
 local plan,errorCode=Timeline.Build(Config)
 return setmetatable({Owner=owner,Plan=plan,Error=errorCode,Connections={},Prompts={},
  Ledger=plan and Ledger.new(Config,plan,os.clock),Active={},AccessRate={}},Service)
end
function Service:IsStandMode()return Config.Mode=="StandCinematic"end
function Service:Context()return {Mode=if self.Error then "Disabled"else Config.Mode,AllowedOpenQuantities=Config.AllowedOpenQuantities}end
function Service:FindStand(id)
 if type(id)~="string"or #id>64 then return nil end
 local folder=workspace:FindFirstChild("CrateStands");local found
 for _,model in ipairs(folder and folder:GetChildren()or {})do
  if model:IsA("Model")and model:GetAttribute("StandId")==id then if found then return nil end;found=model end
 end
 if not found or found:GetAttribute("Enabled")==false then return nil end
 for _,name in ipairs({"InteractionPart","SpawnPoint","CameraPoint","RewardPoint"})do
  local part=found:FindFirstChild(name);if not part or not part:IsA("BasePart")then return nil end
 end
 return found
end
function Service:Validate(player,id)
 if self.Error then return nil,self.Error end
 if not self:IsStandMode()or not Config.Stand.Enabled then return nil,"StandDisabled"end
 if not self.Owner:_lobby(player)then return nil,"LobbyOnly"end
 local model=self:FindStand(id);if not model then return nil,"InvalidStandId"end
 local char=player.Character;local root=char and char:FindFirstChild("HumanoidRootPart")
 local hum=char and char:FindFirstChildOfClass("Humanoid")
 if not root or not hum or hum.Health<=0 then return nil,"CharacterUnavailable"end
 local distance=(root.Position-model.InteractionPart.Position).Magnitude
 if distance~=distance or distance>Config.Stand.MaxActivationDistance then return nil,"StandTooFar"end
 return model
end
function Service:Release(userId,reason)
 local row=self.Ledger and self.Ledger:Release(userId)
 local visual=self.Active[userId];self.Active[userId]=nil
 if visual then
  for _,observer in ipairs(visual.Audience)do if observer.Parent==Players then
   local untilAt=self.Ledger.Cooldowns[tostring(userId)..":"..visual.Packet.StandId]
   self.Remote:FireClient(observer,{Kind="Cancel",OpeningId=visual.Packet.OpeningId,StandId=visual.Packet.StandId,Reason=reason,
    CooldownUntil=if observer.UserId==userId and untilAt then workspace:GetServerTimeNow()+math.max(0,untilAt-os.clock())else nil})
  end end
 end
 return row
end
function Service:Open(player,args,callback)
 if self.Error then return {Ok=false,Code=self.Error}end
 if not self:IsStandMode()then return callback()end
 local model,why=self:Validate(player,args.StandId);if not model then return {Ok=false,Code=why}end
 local quantity=Batch.Quantity(args.Quantity);if not quantity then return {Ok=false,Code="InvalidQuantity"}end
 local plan,planError=Timeline.Build(Config,quantity);if not plan then return {Ok=false,Code=planError}end
 local row,code=self.Ledger:Acquire(player.UserId,args.StandId,args.OperationId,plan)
 if not row then return {Ok=false,Code=code}end
 if not row.Player then row.Player=player;row.Character=player.Character end
 local ok,result=pcall(callback)
 if not ok then self:Release(player.UserId,"TransactionError");error(result)end
 -- Eligibility may yield. Present revalidates the lease, character, stand and distance.
 if not result.Ok or(result.Replay and not row.Committed)then self:Release(player.UserId,"NoNewPresentation")end
 result.Presentation={Mode="StandCinematic",OpeningId=result.Operation and result.Operation.UnitId}
 return result
end
function Service:Cancel(player,openingId)
 local visual=self.Active[player.UserId]
 if not visual then return {Ok=true}end
 if visual.Packet.OpeningId~=openingId then return {Ok=false,Code="OpeningMismatch"}end
 self:Release(player.UserId,"ClientCancelled")
 return {Ok=true}
end
function Service:Present(player,crate,op)
 local row=self.Ledger.Players[player.UserId]
 if not row or row.OperationId~=op.OperationId then return end
 -- This method is called after the existing economic commit, even if visuals cannot start.
 if not self.Ledger:Commit(row,op.UnitId)then return end
 local model=self:Validate(player,row and row.StandId)
 if row.Character~=player.Character or not model then
  self:Release(player.UserId,"PresentationUnavailable");return
 end
 local packet={Kind="Opening",Mode="StandCinematic",StandId=row.StandId,OpeningId=op.UnitId,
  Operation={RewardId=op.RewardId,CrateId=crate.CrateId,SlapId=op.SlapId,VariationId=op.VariationId,Quantity=op.Quantity or 1,Rewards=op.Rewards and table.clone(op.Rewards),EffectivePercent=op.EffectivePercent,PreviewRewardIds=op.PreviewRewardIds and table.clone(op.PreviewRewardIds)},
  StartedAt=workspace:GetServerTimeNow(),Duration=row.Plan.Duration,BuyerUserId=player.UserId,
  Exclusive=Config.Stand.ExclusiveOpening,Model=crate.Model}
 local audience={player}
 if Config.Stand.ExclusiveOpening then for _,other in ipairs(Players:GetPlayers())do
  local root=other.Character and other.Character:FindFirstChild("HumanoidRootPart")
  if other~=player and root and self.Owner:_lobby(other)and(root.Position-model.InteractionPart.Position).Magnitude<=Config.Stand.SpectatorRadius then table.insert(audience,other)end
 end end
 self.Active[player.UserId]={Packet=packet,Audience=audience,Character=player.Character}
 for _,other in ipairs(audience)do self.Remote:FireClient(other,packet)end
end
function Service:SyncStands()
 local folder=workspace:FindFirstChild("CrateStands")
 for _,model in ipairs(folder and folder:GetChildren()or {})do
  local id=model:GetAttribute("StandId");local valid=self:FindStand(id)==model
  local part=model:FindFirstChild("InteractionPart");local prompt=part and part:FindFirstChildWhichIsA("ProximityPrompt")
  if prompt then
   prompt.Enabled=valid and not self.Error and self:IsStandMode()and Config.Stand.Enabled
   if not self.Prompts[prompt]then
    self.Prompts[prompt]=prompt.Triggered:Connect(function(player)
     local now=os.clock();if now<(self.AccessRate[player]or 0)then return end;self.AccessRate[player]=now+.5
     local stand=self:Validate(player,model:GetAttribute("StandId"));if not stand then return end
     self.Remote:FireClient(player,{Kind="Access",StandId=model:GetAttribute("StandId"),Mode=Config.Mode})
    end)
   end
  end
  local lease=self.Ledger and self.Ledger.Stands[id]
  local state=lease and lease.State or "Idle"
  if model:GetAttribute("OpeningState")~=state then model:SetAttribute("OpeningState",state)end
  local anchor=model:FindFirstChild("BillboardAnchor");local gui=anchor and anchor:FindFirstChild("BillboardGui")
  local status=gui and gui:FindFirstChild("Status",true)
  local title=gui and gui:FindFirstChild("Title",true);local subtitle=gui and gui:FindFirstChild("Price",true)
  if title then title.Text=if state~="Idle"then "APERTURA EN CURSO"else "CAJAS"end
  if subtitle then subtitle.Text=if state~="Idle"then "Esperá tu turno"else "Abrí cajas y conseguí slaps exclusivos"end
  if status then status.Text=if state~="Idle"then "EN USO"elseif not valid then "STAND NO DISPONIBLE"else "VER PRECIOS Y PROBABILIDADES"end
 end
 for prompt,connection in pairs(self.Prompts)do if not prompt:IsDescendantOf(workspace)then connection:Disconnect();self.Prompts[prompt]=nil end end
end
function Service:Start(remote)
 self.Remote=remote;self:SyncStands()
 local last=0
 table.insert(self.Connections,RunService.Heartbeat:Connect(function()
  if os.clock()-last<.25 then return end;last=os.clock()
  if self.Ledger then
   for _,row in ipairs(self.Ledger:Step())do self:Release(row.UserId,"Completed")end
   for id,row in pairs(self.Ledger.Players)do
    if not row.Player or row.Player.Character~=row.Character or not self:Validate(row.Player,row.StandId)then self:Release(id,"ContextChanged")end
   end
   for _,visual in pairs(self.Active)do
    if visual.Packet.Exclusive then
     local model=self:FindStand(visual.Packet.StandId)
     if model then for _,other in ipairs(Players:GetPlayers())do
      local root=other.Character and other.Character:FindFirstChild("HumanoidRootPart")
      if root and self.Owner:_lobby(other)and(root.Position-model.InteractionPart.Position).Magnitude<=Config.Stand.SpectatorRadius
       and not table.find(visual.Audience,other)then
       table.insert(visual.Audience,other);self.Remote:FireClient(other,visual.Packet)
      end
     end end
    end
   end
  end
  self:SyncStands()
 end))
 table.insert(self.Connections,Players.PlayerRemoving:Connect(function(player)self:Release(player.UserId,"Disconnected");self.AccessRate[player]=nil end))
end
return Service
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="959">
          <Properties>
            <string name="Name">StockLedger</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Single-key ledger: reward and optional aggregate variation supply change atomically.
local Ledger={}
local function valid(n)return type(n)=="number" and n>=0 and n<math.huge and n%1==0 end
function Ledger.Constraints(reward,variation)
 local constraints={}
 for _,d in ipairs({{Definition=reward,Key="Reward:"..reward.RewardId},{Definition=variation,Key="Variation:"..variation.Id}})do
  local x=d.Definition
  if x.LimitedStock then
   if not valid(x.TotalSupply or x.DefaultStock) or type(x.EditionId)~="string" or x.EditionId=="" then return nil,"StockUnconfigured" end
   table.insert(constraints,{Key=d.Key..":"..x.EditionId,Supply=x.TotalSupply or x.DefaultStock,EditionId=x.EditionId})
  end
 end
 return constraints
end
function Ledger.View(state,constraints,rewardId)
 local remaining=nil;local issued=0;local totalSupply=nil
 for _,op in pairs(state.Operations)do if op.RewardId==rewardId and op.State=="Issued"then issued+=1 end end
 for _,c in ipairs(constraints)do
  local bucket=state.Buckets[c.Key]
  if bucket and bucket.Supply~=c.Supply then return nil,"SupplyChanged" end
  local n=bucket and bucket.Reserved or 0;local i=bucket and bucket.Issued or 0
  if not valid(n)or not valid(i)or n+i>c.Supply then return nil,"StockCorrupt" end
  remaining=math.min(remaining or math.huge,c.Supply-n-i)
  if c.Key:sub(1,7)=="Reward:"then totalSupply=c.Supply end
 end
 return {UnlimitedStock=#constraints==0,LimitedStock=#constraints>0,TotalSupply=totalSupply,RemainingStock=remaining,IssuedCount=issued,
  CurrentlyOwnedUnits=nil,UniqueOwnerCount=nil,SoldOut=remaining~=nil and remaining<=0,Scope="Ledger",Constraints=constraints}
end
function Ledger.Reserve(state,operationId,userId,reward,constraints)
 local existing=state.Operations[operationId]
 if existing then
  if existing.UserId~=userId or existing.RewardId~=reward.RewardId then return false,"OperationConflict" end
  return existing.State~="Released",existing.State=="Released" and "ReservationReleased" or nil
 end
 local size=0 for _ in pairs(state.Operations)do size+=1 end
 if size>=1024 then return false,"StockJournalCapacity" end
 local view,reason=Ledger.View(state,constraints,reward.RewardId);if not view then return false,reason end
 if view.SoldOut then return false,"SoldOut" end
 for _,c in ipairs(constraints)do
  local b=state.Buckets[c.Key] or {Supply=c.Supply,Reserved=0,Issued=0};state.Buckets[c.Key]=b;b.Reserved+=1
 end
 state.Operations[operationId]={UserId=userId,RewardId=reward.RewardId,State="Reserved",Constraints=constraints}
 return true
end
function Ledger.Finish(state,id,commit)
 local op=state.Operations[id];if not op then return false,"ReservationMissing" end
 local target=if commit then "Issued" else "Released"
 if op.State==target then return true end
 if op.State~="Reserved" then return false,"InvalidStockTransition" end
 for _,c in ipairs(op.Constraints)do local b=state.Buckets[c.Key];b.Reserved-=1;if commit then b.Issued+=1 end end
 op.State=target;return true
end
return Ledger
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="960">
          <Properties>
            <string name="Name">UnlimitedProductionStock</string>
            <string name="Source"><![CDATA[--!nonstrict
-- The current approved catalogue has unlimited supply. Ownership/units live in profiles.
-- Never use server-local stock for a future globally limited item.
local Ledger=require(script.Parent.StockLedger)
local Stock={};Stock.__index=Stock
function Stock.new(catalog)
 for _,r in pairs(catalog.Rewards)do local v=catalog.Variations.ById[r.VariationId];local cs=Ledger.Constraints(r,v);assert(cs and #cs==0,'Limited stock needs a durable global backend before enabling this catalogue')end
 return setmetatable({Scope='ProductionUnlimited_ProfileUnitsDurable',WritesToCloud=false},Stock)
end
function Stock:View(r,v)
 local cs,why=Ledger.Constraints(r,v);if not cs or #cs~=0 then return nil,why or 'LimitedStockBackendRequired'end
 return Ledger.View({Buckets={},Operations={}},cs,r.RewardId)
end
function Stock:Reserve(_id,_uid,r,v)local view,why=self:View(r,v);return view~=nil,why end
function Stock:Commit(_id)return true end
function Stock:Release(_id)return true end
return Stock
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="961">
        <Properties>
          <string name="Name">DeathEffectService</string>
          <string name="Source"><![CDATA[--!nonstrict
-- A presentation subscriber to the FINAL elimination decision. Never awards anything.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local RunService = game:GetService("RunService")
local Config = require(ReplicatedStorage.Shared.DeathFeedbackConfig)
local Catalog = require(ReplicatedStorage.Shared.DeathEffectDefinitions)
local Contract = require(ReplicatedStorage.Shared.DeathFeedbackContract)
local GameConfig = require(ReplicatedStorage.Shared.Config)
local Service = {Name="DeathEffectService"}
function Service:Init(context)
 self._context=context
 self._seen={}
 self._connections={}
 self._remote=ReplicatedStorage.Remotes.Match:FindFirstChild("DeathFeedback")
 if not self._remote then
  self._remote=Instance.new("RemoteEvent"); self._remote.Name="DeathFeedback"
  self._remote.Parent=ReplicatedStorage.Remotes.Match
 end
 assert(self._remote:IsA("RemoteEvent"),"DeathFeedback remote class invalid")
 -- Replicate templates, never live effects. Local clones are visible only to recipients.
 local source=assert(ServerStorage:FindFirstChild("DeathEffects"),"ServerStorage.DeathEffects missing")
 local assets=ReplicatedStorage:FindFirstChild("DeathEffectAssets")
 if not assets then assets=Instance.new("Folder");assets.Name="DeathEffectAssets";assets.Parent=ReplicatedStorage end
 for _,definition in pairs(Catalog) do
  local model=source:FindFirstChild(definition.ModelName)
  assert(model and model:IsA("Model") and model:FindFirstChild("Origin"),"Death effect template missing: "..definition.ModelName)
  for _,item in ipairs(model:GetDescendants()) do
   assert(not item:IsA("LuaSourceContainer") and not item:IsA("Explosion"),"Unsafe death effect template")
   if item:IsA("BasePart") then
    assert(item.Anchored and not item.CanCollide and not item.CanTouch and not item.CanQuery,"Unsafe death effect Part")
   end
  end
  if not assets:FindFirstChild(model.Name) then model:Clone().Parent=assets end
 end
end
function Service:HandleConfirmed(record)
 if type(record)~="table" or type(record.EliminationId)~="string" then return false end
 local function reject(reason)
  if GameConfig.Respawn.Debug then warn("[RespawnDebug] FeedbackRejectedServer",record.MatchId,record.EliminationId,record.Reason,reason) end
  return false
 end
 local snapshot=record.FeedbackSnapshot
 local killPart=record.Reason=="KillPart" or record.Reason=="KillPart_NormalFall"
 local snapshotEffect=type(snapshot)=="table" and snapshot.SessionId==record.MatchId
  and snapshot.EliminationId==record.EliminationId and typeof(snapshot.ImpactCFrame)=="CFrame"
  and Catalog[snapshot.EffectId]~=nil
 -- Compatibility for old receipts without an impact snapshot; current sensors always supply one.
 local rewardOnly=not snapshotEffect and not killPart and record.Killer~=nil and (record.RewardCoins or 0)>0
  and (record.Reason=="VoidBoundary" or record.Reason=="VoidBoundaryPolling")
 if (not snapshotEffect and not killPart and not rewardOnly) or (killPart and typeof(record.ImpactCFrame)~="CFrame") then return reject("MissingSnapshotOrImpact") end
 local rounds=self._context:GetService("RoundService")
 local session=rounds:GetSessionById(record.MatchId)
 if not session or not rounds:IsSessionActive(record.MatchId) or session.Closing or session.Closed
  or session.Cancelled or session.GameplayFrozen or not Contract.IsFeedbackState(session.State)
  or record.StateVersion~=session.StateVersion or type(record.ConfirmedAt)~="number"
  or workspace:GetServerTimeNow()-record.ConfirmedAt>Config.EventLifetime then return reject("SessionStateVersionOrAge") end
 local victim=record.Victim
 local participant=victim and rounds:GetSessionParticipant(session.Id,victim)
 if not participant or victim.Parent~=Players or victim:GetAttribute("MatchId")~=session.Id then return reject("VictimNotInSession") end
 local killer=record.Killer
 if killer then
  local attacker=rounds:GetSessionParticipant(session.Id,killer)
  if not attacker or killer==victim or killer.Parent~=Players or attacker.Team==participant.Team
   or killer:GetAttribute("MatchId")~=session.Id then return reject("AttackerNotInSession") end
 end
 local seen=self._seen[session.Id]
 if not seen then seen={};self._seen[session.Id]=seen end
 if seen[record.EliminationId] then return reject("DuplicateEliminationId") end
 seen[record.EliminationId]=true
 local effectId=if snapshotEffect then snapshot.EffectId else Contract.ResolveEffect(self._context:GetService("PlayerService"),victim,killer~=nil,Catalog,Config.DeathEffects)
 if not Catalog[effectId] then warn("[DeathEffectService] Effect not allowlisted");return false end
 local payload={
  SessionId=session.Id, StateVersion=session.StateVersion, EliminationId=record.EliminationId,
  Kind=if snapshotEffect then snapshot.Kind else (killer and "CreditedKill" or "UnattributedFall"),
  VictimUserId=if snapshotEffect then snapshot.VictimUserId else victim.UserId, VictimName=if snapshotEffect then snapshot.VictimName else victim.DisplayName,
  KillerUserId=if snapshotEffect then snapshot.KillerUserId else (killer and killer.UserId), KillerName=if snapshotEffect then snapshot.KillerName else (killer and killer.DisplayName),
  EffectId=effectId, ImpactCFrame=if snapshotEffect then snapshot.ImpactCFrame else record.ImpactCFrame,
  Debug=GameConfig.Respawn.Debug==true, Generation=if snapshotEffect then snapshot.Generation else nil, Reason=record.Reason,
  RewardOnly=rewardOnly,
  SentAt=record.ConfirmedAt,
 }
 for _,member in ipairs(session.Participants) do
  local player=member.Player
  if (not rewardOnly or player==killer) and player and player.Parent==Players and rounds:GetSessionParticipant(session.Id,player)==member
   and player:GetAttribute("MatchId")==session.Id then
   local private=table.clone(payload)
   -- Other spectators never receive a reward trigger, even inside this session.
   private.RewardCoins=player==killer and math.max(0,record.RewardCoins or 0) or 0
   self._remote:FireClient(player,private)
   if GameConfig.Respawn.Debug then print("[RespawnDebug] FeedbackSent",session.Id,record.EliminationId,"To",player.UserId,"Effect",effectId,"RewardOnly",rewardOnly,"Coins",private.RewardCoins) end
  end
 end
 print("[DeathEffectService] Confirmed",session.Id,record.EliminationId,payload.Kind,effectId)
 return true
end
function Service:Start(context)
 table.insert(self._connections,context:GetService("EliminationService").PlayerEliminated:Connect(function(record)
  local ok,failure=pcall(self.HandleConfirmed,self,record)
  if not ok then warn("[DeathEffectService] "..tostring(failure)) end
 end))
 local elapsed=0
 table.insert(self._connections,RunService.Heartbeat:Connect(function(dt)
  elapsed+=dt;if elapsed<1 then return end;elapsed=0
  local rounds=context:GetService("RoundService")
  for id in pairs(self._seen) do if not rounds:IsSessionActive(id) then self._seen[id]=nil end end
 end))
end
return Service
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="962">
        <Properties>
          <string name="Name">DisappearingPlatformsService</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Authoritative, instance-scoped platforms. One detector while registered maps exist.
local Config=require(game.ReplicatedStorage.Shared.DisappearingPlatformsConfig)
local Policy=require(script.Parent.Platforms.PlatformPolicy)
local Controller={}
Controller.__index=Controller
function Controller.new(raw,deps)
 local config,reason=Policy.Validate(raw)
 assert(config,reason)
 return setmetatable({Config=config,Deps=deps,Maps={},Heartbeat=nil,Elapsed=0},Controller)
end
function Controller:_current(record)
 if self.Maps[record.Id]~=record then return false end
 local session,info=record.Session,record.Info
 return not session.Closing and not session.Closed and not session.Cancelled and not session.Result
  and self.Deps.GetSession(record.Id)==session and session.InstanceInfo==info
  and self.Deps.GetInstance(record.Id)==info and info.InstanceModel==record.Map
  and record.Map.Parent==info.Container and record.Map:IsDescendantOf(self.Deps.World)
  and record.Geometry:IsDescendantOf(record.Map)
end
function Controller:_partCurrent(record,part,entry)
 return self:_current(record) and record.Parts[part]==entry and part:IsDescendantOf(record.Geometry)
end
local function release(entry)
 if entry.Timer then pcall(task.cancel,entry.Timer);entry.Timer=nil end
 if entry.Connection then entry.Connection:Disconnect();entry.Connection=nil end
 if entry.Tween then entry.Tween:Cancel();entry.Tween:Destroy();entry.Tween=nil end
end
function Controller:UnbindMap(id,expectedInfo)
 local record=self.Maps[id]
 if not record or (expectedInfo and record.Info~=expectedInfo) then return end
 self.Maps[id]=nil -- invalidate callbacks BEFORE cancellation can dispatch Completed.
 for _,connection in ipairs(record.Connections) do connection:Disconnect() end
 for _,entry in pairs(record.Parts) do release(entry) end
 table.clear(record.Parts);table.clear(record.Connections)
 record.Session=nil;record.Info=nil;record.Map=nil;record.Geometry=nil
 if next(self.Maps)==nil and self.Heartbeat then
  self.Heartbeat:Disconnect();self.Heartbeat=nil;self.Elapsed=0
 end
end
function Controller:BindMap(session,info)
 if not self.Config.Enabled then return true end
 if not session or not info or session.Id~=info.MatchId or self.Deps.GetSession(session.Id)~=session
  or self.Deps.GetInstance(session.Id)~=info then return false,"UnauthorizedMap" end
 local current=self.Maps[session.Id]
 if current then return current.Info==info,"AlreadyBound" end
 local map=info.InstanceModel
 if not map or not map:IsA("Model") or map.Parent~=info.Container or not map:IsDescendantOf(self.Deps.World)
  or map:IsDescendantOf(self.Deps.Templates) then return false,"ExpectedActiveClone" end
 local geometry=map:FindFirstChild(self.Config.GeometryFolderName)
 if not geometry or (not geometry:IsA("Folder") and not geometry:IsA("Model")) then return false,"GeometryMissing" end
 local record={Id=session.Id,Session=session,Info=info,Map=map,Geometry=geometry,Parts={},Connections={}}
 for _,part in ipairs(geometry:GetDescendants()) do
  if part:IsA("BasePart") and part.Name==self.Config.TargetPartName then
   record.Parts[part]={State="Idle"}
  end
 end
 if next(record.Parts)==nil then return true end
 self.Maps[record.Id]=record
 table.insert(record.Connections,map.Destroying:Connect(function()self:UnbindMap(record.Id,info)end))
 table.insert(record.Connections,map.AncestryChanged:Connect(function()
  if map.Parent~=info.Container or not map:IsDescendantOf(self.Deps.World) then self:UnbindMap(record.Id,info) end
 end))
 if not self.Heartbeat then
  self.Heartbeat=self.Deps.Heartbeat:Connect(function(dt)self:Step(dt)end)
 end
 local count=0
 for _ in pairs(record.Parts) do count+=1 end
 print(string.format("[DisappearingPlatforms] Bound Match=%s Map=%s Platforms=%d",record.Id,tostring(info.MapName),count))
 return true
end
function Controller:_fade(record,part,entry)
 if not self:_partCurrent(record,part,entry) or entry.State~="Triggered" then return end
 entry.State="Fading"
 local tween=self.Deps.TweenService:Create(part,TweenInfo.new(self.Config.FadeDuration,Enum.EasingStyle.Linear),{Transparency=1})
 entry.Tween=tween
 entry.Connection=tween.Completed:Connect(function(state)
  if state~=Enum.PlaybackState.Completed then
   if self:_partCurrent(record,part,entry) then entry.State="Cancelled";release(entry) end
   return
  end
  if not self:_partCurrent(record,part,entry) or entry.State~="Fading" then return end
  part.Transparency=1 -- Collision is removed ONLY after completed, never on Cancel.
  part.CanCollide=false
  entry.State="Disappeared"
  release(entry)
 end)
 tween:Play()
end
function Controller:_trigger(record,part)
 local entry=record.Parts[part]
 if not entry or entry.State~="Idle" or not part.CanCollide or part.Transparency>=1
  or not self:_partCurrent(record,part,entry) then return false end
 entry.State="Triggered" -- reserve synchronously: two players cannot create two tweens.
 if self.Config.FadeDelay>0 then
  entry.Timer=task.delay(self.Config.FadeDelay,function()
   entry.Timer=nil
   self:_fade(record,part,entry)
  end)
 else self:_fade(record,part,entry) end
 return true
end
function Controller:_detect(record,player)
 if typeof(player)~="Instance" or not player:IsA("Player") or player.Parent~=self.Deps.Players
  or player:GetAttribute("MatchId")~=record.Id or self.Deps.GetPlayerSession(player)~=record.Session
  or not self.Deps.GetParticipant(record.Id,player) then return end
 local character=player.Character
 if not character or not character:IsDescendantOf(self.Deps.World) then return end
 local humanoid=character:FindFirstChildOfClass("Humanoid")
 local root=character:FindFirstChild("HumanoidRootPart")
 if not humanoid or not root or not root:IsA("BasePart") or not Policy.CanStand(character,humanoid,root,self.Config) then return end
 local height=Policy.ExpectedHeight(character,humanoid,root)
 if not height then return end
 local params=RaycastParams.new()
 params.FilterType=Enum.RaycastFilterType.Exclude
 params.FilterDescendantsInstances={character}
 params.RespectCanCollide=true
 -- Use a body's collision group, not the noncolliding arena root group.
 local foot=character:FindFirstChild(if humanoid.RigType==Enum.HumanoidRigType.R6 then "Left Leg" else "LeftFoot")
 if foot and foot:IsA("BasePart") then params.CollisionGroup=foot.CollisionGroup end
 local hit=self.Deps.World:Raycast(root.Position,Vector3.new(0,-(height+self.Config.SupportTolerance),0),params)
 if not hit then return end
 local entry=record.Parts[hit.Instance]
 if entry and Policy.IsTopSupport(hit.Instance,root,hit,height,self.Config) then self:_trigger(record,hit.Instance) end
end
function Controller:Step(dt)
 self.Elapsed+=dt
 if self.Elapsed<self.Config.DetectionInterval then return end
 self.Elapsed%=self.Config.DetectionInterval -- no burst of catch-up queries after a stalled frame.
 for id,record in pairs(self.Maps) do
  if not self:_current(record) then self:UnbindMap(id,record.Info)
  else
   local session=record.Session
   if session.State=="Playing" and not session.GameplayFrozen and not session.PointInProgress
    and session.GameplayRound and not session.GameplayRound.Resolved then
    for _,participant in ipairs(session.Participants or {}) do
     if participant.State~="Left" and participant.State~="Released" then self:_detect(record,participant.Player) end
    end
   end
  end
 end
end
function Controller:Destroy()
 while next(self.Maps) do
  local id=next(self.Maps)
  self:UnbindMap(id)
 end
end
local Service={Name="DisappearingPlatformsService",new=Controller.new}
function Service:Init(context)
 self._context=context
 if self._controller then self._controller:Destroy() end
 local rounds=context:GetService("RoundService")
 local instances=context:GetService("MatchInstanceService")
 local ok,result=pcall(Controller.new,Config,{
  World=game:GetService("Workspace"),Templates=game:GetService("ServerStorage"),Players=game:GetService("Players"),
  TweenService=game:GetService("TweenService"),Heartbeat=game:GetService("RunService").Heartbeat,
  GetSession=function(id)return rounds:GetSessionById(id)end,
  GetInstance=function(id)return instances:GetInstance(id)end,
  GetPlayerSession=function(player)return rounds:GetSessionForPlayer(player)end,
  GetParticipant=function(id,player)return rounds:GetSessionParticipant(id,player)end,
 })
 if ok then self._controller=result
 else self._controller=nil;warn("[DisappearingPlatforms] Disabled: "..tostring(result)) end
end
function Service:Start(_context) end -- detection starts only when an authorized map is bound.
function Service:BindMap(session,info)
 if not self._controller then return true end -- invalid configuration disables this feature, not the match.
 return self._controller:BindMap(session,info)
end
function Service:UnbindMap(id,info)
 if self._controller then self._controller:UnbindMap(id,info) end
end
return Service
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="963">
        <Properties>
          <string name="Name">EliminationService</string>
          <string name="Source"><![CDATA[--!strict
-- EliminationService
-- Servicio autoritativo de resolución de eliminaciones y atribución de Kills.
-- Responsabilidad exclusiva:
-- - Detectar cuando un jugador en partida es eliminado (contacto con KillPart o Humanoid.Died).
-- - Validar que la eliminación pertenezca a una partida activa en estado Playing.
-- - Resolver el último atacante válido (LastAttacker) a través de CombatService.
-- - Validar ventana de tiempo (LastHitLifetime), pertenencia al mismo MatchId y attacker ~= victim.
-- - Otorgar autoritativamente +1 Kill al atacante vía PlayerService.
-- - Garantizar protección estricta contra Kills duplicadas (Anti-Duplicate por MatchId + Victim + EliminationId).
-- - Limpiar CombatTags una vez resuelta la Kill.
-- NO administra la lógica de puntos de partida (ScoreService) ni reposicionamiento de spawns.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Config = require(ReplicatedStorage.Shared.Config)
local Constants = require(ReplicatedStorage.Shared.Constants)
local CompetitiveTransit = require(script.Parent.Respawn.CompetitiveTransit)
local Types = require(ReplicatedStorage.Shared.Types)
local DeathFeedbackContract = require(ReplicatedStorage.Shared.DeathFeedbackContract)
local ArenaRespawnPolicy = require(ReplicatedStorage.Shared.ArenaRespawnPolicy)
local DeathEffectCatalog = require(ReplicatedStorage.Shared.DeathEffectDefinitions)
local DeathFeedbackSettings = require(ReplicatedStorage.Shared.DeathFeedbackConfig)

type MatchSession = Types.MatchSession
type EliminationRecord = Types.EliminationRecord

local EliminationService = {}
EliminationService.Name = "EliminationService"

-- Evento Bindable para que otros sistemas puedan suscribirse a eliminaciones confirmadas
local playerEliminatedBindable = Instance.new("BindableEvent")
EliminationService.PlayerEliminated = playerEliminatedBindable.Event

EliminationService._transits = CompetitiveTransit.new()
EliminationService._context = nil :: any
EliminationService._connections = {} :: { [string]: { RBXScriptConnection } }
EliminationService._resolvedEliminations = {} :: { [string]: boolean }
EliminationService._processingEliminations = {} :: { [Player]: number }
EliminationService._eliminationCounters = {} :: { [Player]: number }
EliminationService._activeSessions = {} :: { [string]: MatchSession }
EliminationService._isPolling = false
EliminationService._pollThread = nil :: thread?
EliminationService._combatService = nil :: any
EliminationService._playerService = nil :: any
EliminationService._roundService = nil :: any
EliminationService._spawnService = nil :: any

function EliminationService:Init(context: any)
	self._context = context
	self._transits = CompetitiveTransit.new()
	self._connections = {}
	self._resolvedEliminations = {}
	self._processingEliminations = {}
	self._eliminationCounters = {}
	self._activeSessions = {}
	self._isPolling = false
	self._pollThread = nil
end

function EliminationService:Start(context: any)
	self._context = context
	self._playerRemovingConnection = Players.PlayerRemoving:Connect(function(player)
		for sessionId in pairs(self._activeSessions) do self._transits:ForgetPlayer(sessionId,player) end
	end)
	print("[EliminationService] Servicio de eliminación iniciado y listo")
end

-- ==================================================
-- RESOLUCIÓN DE SERVICIOS
-- ==================================================

function EliminationService:_getCombatService(): any
	if self._combatService then return self._combatService end
	if self._context and type(self._context.GetService) == "function" then
		local s = self._context:GetService("CombatService")
		if s then self._combatService = s; return s end
	end
	local servicesFolder = ServerScriptService:FindFirstChild("Services")
	local mod = servicesFolder and servicesFolder:FindFirstChild("CombatService")
	if mod and mod:IsA("ModuleScript") then
		local ok, result = pcall(require, mod)
		if ok and result then self._combatService = result; return result end
	end
	return nil
end

function EliminationService:_getPlayerService(): any
	if self._playerService then return self._playerService end
	if self._context and type(self._context.GetService) == "function" then
		local s = self._context:GetService("PlayerService")
		if s then self._playerService = s; return s end
	end
	local servicesFolder = ServerScriptService:FindFirstChild("Services")
	local mod = servicesFolder and servicesFolder:FindFirstChild("PlayerService")
	if mod and mod:IsA("ModuleScript") then
		local ok, result = pcall(require, mod)
		if ok and result then self._playerService = result; return result end
	end
	return nil
end

function EliminationService:_getRoundService(): any
	if self._roundService then return self._roundService end
	if self._context and type(self._context.GetService) == "function" then
		local s = self._context:GetService("RoundService")
		if s then self._roundService = s; return s end
	end
	local servicesFolder = ServerScriptService:FindFirstChild("Services")
	local mod = servicesFolder and servicesFolder:FindFirstChild("RoundService")
	if mod and mod:IsA("ModuleScript") then
		local ok, result = pcall(require, mod)
		if ok and result then self._roundService = result; return result end
	end
	return nil
end

function EliminationService:_getSpawnService(): any
	if self._spawnService then return self._spawnService end
	if self._context and type(self._context.GetService) == "function" then
		local s = self._context:GetService("SpawnService")
		if s then self._spawnService = s; return s end
	end
	local servicesFolder = ServerScriptService:FindFirstChild("Services")
	local mod = servicesFolder and servicesFolder:FindFirstChild("SpawnService")
	if mod and mod:IsA("ModuleScript") then
		local ok, result = pcall(require, mod)
		if ok and result then self._spawnService = result; return result end
	end
	return nil
end

local function isPlayer(p: any): boolean
	if not p then return false end
	if typeof(p) == "Instance" then
		return p:IsA("Player")
	end
	if (typeof(p) == "userdata" or typeof(p) == "table") and type(p.IsA) == "function" then
		return p:IsA("Player")
	end
	return false
end

-- Obtiene el Player a partir de cualquier BasePart del personaje de forma robusta
local function getPlayerFromPart(part: BasePart): Player?
	if not part or not part:IsA("BasePart") then return nil end
	local current: Instance? = part
	while current and current ~= workspace do
		if current:IsA("Model") then
			local humanoid = current:FindFirstChildOfClass("Humanoid")
			if humanoid then
				local player = Players:GetPlayerFromCharacter(current)
				if player then return player end
			end
		end
		current = current.Parent
	end
	return nil
end

function EliminationService:_getActiveSession(sessionId: string): MatchSession?
	local roundService = self:_getRoundService()
	if not roundService
		or type(roundService.GetSessionById) ~= "function"
		or type(roundService.IsSessionActive) ~= "function"
		or not roundService:IsSessionActive(sessionId) then
		return nil
	end
	return roundService:GetSessionById(sessionId)
end

function EliminationService:_getParticipant(sessionId: string, player: Player): any?
	local roundService = self:_getRoundService()
	if not roundService or type(roundService.GetSessionParticipant) ~= "function" then
		return nil
	end
	return roundService:GetSessionParticipant(sessionId, player)
end

function EliminationService:_isOpposingParticipant(sessionId: string, attacker: Player, victim: Player): boolean
	local attackerParticipant = self:_getParticipant(sessionId, attacker)
	local victimParticipant = self:_getParticipant(sessionId, victim)
	return attackerParticipant ~= nil
		and victimParticipant ~= nil
		and attackerParticipant.Team ~= victimParticipant.Team
end

-- ==================================================
-- VINCULACIÓN CON MAPAS Y PARTIDAS
-- ==================================================

-- Vincula la detección de KillParts, VoidBoundary y muertes a una MatchSession activa
-- Called by ScoreService after its own zone/team validations, before any goal callbacks/yields.
function EliminationService:TryProtectGoal(session: MatchSession, player: Player, character: Model, pointId: string): boolean
 if self:_getActiveSession(session.Id) ~= session or session.State ~= Constants.RoundState.Playing then return false end
 if not self:_getParticipant(session.Id,player) or player.Character~=character or not character.Parent then return false end
 if character:GetAttribute("ArenaRespawnPending") then return false end
 local humanoid=character:FindFirstChildOfClass("Humanoid")
 if not humanoid or humanoid.Health<=0 then return false end
 return self._transits:Claim(session,player,character,character:GetAttribute("ArenaPhysicsGeneration") or 0,"Goal",pointId)
end

function EliminationService:ReleaseGoalProtections(sessionId: string)
 self._transits:ReleaseGoals(sessionId)
end

function EliminationService:BindMatch(session: MatchSession)
	if not session or not session.Id then return end
	local matchId = session.Id
	if self:_getActiveSession(matchId) ~= session then return end
	self:UnbindMatch(matchId)

	local conns: { RBXScriptConnection } = {}
	self._connections[matchId] = conns

	-- 1. Vincular partes de eliminación física (KillParts) como sensores no letales
	local killParts: { BasePart } = {}
	if session.InstanceInfo then
		if session.InstanceInfo.KillParts and #session.InstanceInfo.KillParts > 0 then
			killParts = session.InstanceInfo.KillParts
		elseif session.InstanceInfo.InstanceModel then
			for _, desc in ipairs(session.InstanceInfo.InstanceModel:GetDescendants()) do
				if desc:IsA("BasePart") and desc.Name == "KillPart" then
					table.insert(killParts, desc)
				end
			end
		end
	end

	for _, killPart in ipairs(killParts) do
		local conn = killPart.Touched:Connect(function(otherPart)
			self:HandleKillPartTouch(killPart, otherPart, session)
		end)
		table.insert(conns, conn)
	end

	-- 2. Vincular sensor de límite de vacío (VoidBoundaryPart) como sensor no letal
	if session.InstanceInfo and session.InstanceInfo.VoidBoundaryPart then
		local voidBoundary = session.InstanceInfo.VoidBoundaryPart
		local voidConn = voidBoundary.Touched:Connect(function(otherPart)
			self:HandleVoidBoundaryTouch(voidBoundary, otherPart, session)
		end)
		table.insert(conns, voidConn)
	end

	-- 3. Escuchar Humanoid.Died en modo diagnóstico pasivo (Fase 4B Zero-Death)
	local trackPlayerDeath = function(player: Player)
		if not player then return end

		local function onCharacter(character: Model)
			self._transits:ForgetPlayer(matchId,player)
			table.insert(conns, character.Destroying:Connect(function()
				if player.Character==character then self._transits:ForgetPlayer(matchId,player) end
			end))
			local hum = character:WaitForChild("Humanoid", 5) :: Humanoid?
			if hum then
				local diedConn = hum.Died:Connect(function()
					warn(string.format("[EliminationService] [DIAGNOSTIC] Humanoid.Died detectado en '%s' durante Match '%s'. Evento absorbido pasivamente por Zero-Death (sin scoring, sin respawn).",
						player.Name, matchId))
				end)
				table.insert(conns, diedConn)
			end
		end

		if player.Character then
			onCharacter(player.Character)
		end
		table.insert(conns, player.CharacterRemoving:Connect(function() self._transits:ForgetPlayer(matchId,player) end))
		table.insert(conns, player:GetAttributeChangedSignal("MatchId"):Connect(function()
			if player:GetAttribute("MatchId")~=matchId then self._transits:ForgetPlayer(matchId,player) end
		end))
		local charConn = player.CharacterAdded:Connect(onCharacter)
		table.insert(conns, charConn)
	end

	for _, participant in ipairs(session.Participants) do
		if self:_getParticipant(matchId, participant.Player) == participant then
			trackPlayerDeath(participant.Player)
		end
	end

	-- Registrar sesión activa y arrancar polling fail-safe si corresponde
	self._activeSessions[matchId] = session
	self:_startPollingIfNeeded()

	print(string.format("[EliminationService] Vinculación completada para Match '%s' (%d KillParts, VoidBoundary: %s)",
		matchId, #killParts, tostring(session.InstanceInfo and session.InstanceInfo.VoidBoundaryPart ~= nil)))
end

-- Desvincula los listeners y limpia el registro de una partida finalizada
function EliminationService:UnbindMatch(matchId: string)
	if not matchId then return end
	self._transits:ClearSession(matchId)
	local spawn = self:_getSpawnService()
	if spawn and spawn.CancelSessionRespawns then spawn:CancelSessionRespawns(matchId, "MatchUnbound") end

	local conns = self._connections[matchId]
	if conns then
		for _, c in ipairs(conns) do
			c:Disconnect()
		end
		self._connections[matchId] = nil
	end

	-- Desregistrar sesión activa y detener polling si no quedan partidas
	self._activeSessions[matchId] = nil
	if next(self._activeSessions) == nil then
		self:_stopPolling()
	end

	-- Limpiar claves resueltas asociadas al matchId
	local prefix = matchId .. "_"
	for key, _ in pairs(self._resolvedEliminations) do
		if string.sub(key, 1, #prefix) == prefix then
			self._resolvedEliminations[key] = nil
		end
	end

	-- Limpiar debounces y contadores temporales de jugadores desconectados
	for player, _ in pairs(self._processingEliminations) do
		if not player:IsDescendantOf(Players) then
			self._processingEliminations[player] = nil
		end
	end
	for player, _ in pairs(self._eliminationCounters) do
		if not player:IsDescendantOf(Players) then
			self._eliminationCounters[player] = nil
		end
	end
end

-- ==================================================
-- SENSORES NO LETALES (Zero-Death Fase 3A / 3B)
-- ==================================================

-- Procesa el contacto con un KillPart como sensor de eliminación/caída (Humanoid.Health intacto)
function EliminationService:_publishReceipt(record: EliminationRecord,beforeRoundClose: boolean?)
 -- Deferred Bindable delivery may run after a fifth-goal terminal barrier.
 -- Deliver this same receipt synchronously before closing; normal subscriber dedup remains authoritative.
 if beforeRoundClose then
  local effects=self._context and self._context:GetService("DeathEffectService")
  if effects then
   local ok,err=pcall(function() effects:HandleConfirmed(record) end)
   if not ok then warn("[EliminationService] Sudden-death presentation failed: "..tostring(err)) end
  end
 end
 playerEliminatedBindable:Fire(record)
end

-- Third authoritative Slap hit: same receipt/award/effect/Zero-Death pipeline, at the actual victim position.
function EliminationService:HandleSlapThreshold(victim: Player,session: MatchSession,attacker: Player): boolean
 if not self:_isOpposingParticipant(session.Id,attacker,victim) then return false end
 local combat=self:_getCombatService()
 local last,matchId=combat:GetLastAttacker(victim,Config.Combat.LastHitLifetime)
 if last~=attacker or matchId~=session.Id then return false end
 return self:_processEliminationEvent(victim,session,"SlapThreshold")==true
end

function EliminationService:HandleKillPartTouch(killPart: BasePart, hitPart: BasePart, session: MatchSession)
	local player = getPlayerFromPart(hitPart)
	if not player then return end
	if not ArenaRespawnPolicy.IsContactCurrent(killPart.CFrame, killPart.Size, hitPart.Position, hitPart.Size) then return end
	self:_processEliminationEvent(player, session, "KillPart", killPart, hitPart)
end

-- Controlled impact capability; modules never call the elimination/economy service.
function EliminationService:HandleAbilityHit(victim: Player, session: MatchSession, attacker: Player, reason: string): boolean
 if reason~="StrongSlap" and reason~="AbilityImpact" then return false end
 if not self:_isOpposingParticipant(session.Id,attacker,victim) then return false end
 local last,matchId=self:_getCombatService():GetLastAttacker(victim,Config.Combat.LastHitLifetime)
 if last~=attacker or matchId~=session.Id then return false end
 return self:_processEliminationEvent(victim,session,reason)==true
end

-- Procesa el contacto con el sensor VoidBoundaryPart de la arena (Humanoid.Health intacto)
function EliminationService:HandleVoidBoundaryTouch(voidBoundary: BasePart, hitPart: BasePart, session: MatchSession)
	local player = getPlayerFromPart(hitPart)
	if not player then return end
	if not ArenaRespawnPolicy.IsContactCurrent(voidBoundary.CFrame, voidBoundary.Size, hitPart.Position, hitPart.Size) then return end
	self:_processEliminationEvent(player, session, "VoidBoundary", voidBoundary, hitPart)
end

-- Núcleo unificado de procesamiento autoritativo de salida / eliminación sin muerte física
function EliminationService:_processEliminationEvent(player: Player, session: MatchSession, source: string, boundaryPart: BasePart?, hitPart: BasePart?)
	-- 1. Validar que la instancia sea un Player conectado
	if not player or not isPlayer(player) or not player:IsDescendantOf(Players) then return end

	-- 2. Validar que la sesión esté activa y en estado válido para el lifecycle
	if not session or not session.Id then return end
	local matchId = session.Id

	local roundService = self:_getRoundService()
	if self:_getActiveSession(matchId) ~= session then return end
	local currentState = roundService:GetSessionState(matchId)

	-- Estados permitidos: Playing, PointRestartCountdown, StartCountdown, Ending
	if currentState ~= Constants.RoundState.Playing
		and currentState ~= Constants.RoundState.PointRestartCountdown
		and currentState ~= Constants.RoundState.StartCountdown
		and currentState ~= Constants.RoundState.Ending then
		return
	end

	if currentState==Constants.RoundState.Playing and not roundService:IsGameplayRoundOpen(session) then return end

	-- 3. Validar pertenencia estricta del jugador a este match específico
	if not self:_getParticipant(matchId, player) then return end
	local respawnOwner = self:_getSpawnService()
	if respawnOwner and respawnOwner.IsKillPartRespawnPending and respawnOwner:IsKillPartRespawnPending(player) then return end

	-- 4. Multi-match isolation: Validar que el boundaryPart pertenezca al contenedor de esta MatchInstance
	if boundaryPart and session.InstanceInfo then
		local container = session.InstanceInfo.Container
		if container and not boundaryPart:IsDescendantOf(container) then
			-- El sensor tocado pertenece a otra arena
			return
		end
	end

	-- Reject the exact already-resolved transit BEFORE debounce, attribution, awards or feedback.
 local character = player.Character
 if not character or not character.Parent then return end
 if hitPart and not hitPart:IsDescendantOf(character) then return end
 local humanoid=character:FindFirstChildOfClass("Humanoid")
 if not humanoid or humanoid.Health<=0 then return end
 local generation=character:GetAttribute("ArenaPhysicsGeneration") or 0
 local resolved=self._transits:Get(session,player,character,generation)
 if resolved then
  if Config.Respawn.Debug then print("[ScoreKillPart] ContactSuppressed",matchId,player.UserId,resolved.Kind,resolved.EventId,generation,source) end
  return
 end

 -- Countdown contacts can use the existing placement recovery, but are not competitive eliminations.
 -- A protected goal Character has already returned above; do not give it a second recovery.
 if currentState~=Constants.RoundState.Playing then
  if respawnOwner and respawnOwner.ResetCharacterInArena then respawnOwner:ResetCharacterInArena(player,matchId) end
  return
 end

 -- Existing debounce remains for accepted elimination attempts only.
 local now=os.clock()
 local lastTouch=self._processingEliminations[player]
 if lastTouch and now-lastTouch<0.5 then return end
 self._processingEliminations[player]=now

	-- First validated authority wins; no callback/yield before reserving this life.
 if not self._transits:Claim(session,player,character,generation,"Elimination",source) then return end
 local abilities=self._context and self._context:GetService("AbilityService")
 if abilities then abilities:CancelPlayer(player,"Eliminated") end
 local round=session.GameplayRound
 local fall=source=="KillPart" or source=="VoidBoundary" or source=="VoidBoundaryPolling"
 local suddenGoal=fall and currentState==Constants.RoundState.Playing and round~=nil
  and round.SuddenDeath and Config.Round.SuddenDeath.FallAwardsGoal
 local suddenRoundId=round and round.Id
 if suddenGoal and not roundService:TryResolveGameplayRound(session,"SuddenDeathFall") then return end

	-- Capture contact BEFORE ResetCharacterInArena; never read a later spawn position in the feed.
	local impactCFrame: CFrame? = if source=="SlapThreshold" or source=="StrongSlap" or source=="AbilityImpact" then character:GetPivot() else nil
		if boundaryPart then
			local impactPart = hitPart or character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if impactPart then impactCFrame = DeathFeedbackContract.ImpactCFrame(boundaryPart.CFrame, boundaryPart.Size, impactPart.Position) end
	end
	local rewardCoins = 0

	-- 8. Resolver atacante en CombatService (solo elegible durante Playing o PointRestartCountdown)
	local combatEligible = (currentState == Constants.RoundState.Playing or currentState == Constants.RoundState.PointRestartCountdown)
	local combatService = self:_getCombatService()
	local killer: Player? = nil

	if combatEligible and combatService and type(combatService.GetLastAttacker) == "function" then
		local attacker, attackerMatchId = combatService:GetLastAttacker(
			player,
			(Config.Combat and Config.Combat.LastHitLifetime) or 10
		)

		if attacker and attacker ~= player and isPlayer(attacker) and attacker.Parent
			and attackerMatchId == matchId
			and self:_isOpposingParticipant(matchId, attacker, player) then
			killer = attacker
		end
	end

	-- 9. Clasificación del evento: CombatElimination vs Normal Fall
	local counter = (self._eliminationCounters[player] or 0) + 1
	self._eliminationCounters[player] = counter
	local elimKey = string.format("%s_%d_%d", matchId, player.UserId, counter)
		-- Resolve the victim cosmetic and immutable presentation identity BEFORE retirement.
		local effectId = DeathFeedbackContract.ResolveEffect(self:_getPlayerService(), player, killer ~= nil, DeathEffectCatalog, DeathFeedbackSettings.DeathEffects)
		local feedbackSnapshot = table.freeze({
			SessionId=matchId, StateVersion=session.StateVersion, EliminationId=elimKey,
			VictimUserId=player.UserId, VictimName=player.DisplayName,
			KillerUserId=killer and killer.UserId, KillerName=killer and killer.DisplayName,
			EffectId=effectId, ImpactCFrame=impactCFrame, Reason=source,
			Kind=if killer then "CreditedKill" else "UnattributedFall",
			Generation=character:GetAttribute("ArenaPhysicsGeneration") or 0,
		})
		if Config.Respawn.Debug then print("[RespawnDebug] EliminationConfirmed",matchId,elimKey,player.UserId,feedbackSnapshot.Generation,currentState,source,killer and killer.UserId,effectId) end
	local deferredRespawn = false
		if currentState == Constants.RoundState.Playing and not suddenGoal
		and respawnOwner and respawnOwner.BeginKillPartRespawn then
		-- Identity/impact/attacker are already captured. Retire now, before any downstream callbacks.
			-- Touched and void polling must use the SAME retirement/quiet recovery path.
			deferredRespawn = respawnOwner:BeginKillPartRespawn(player, session, elimKey, source .. (if killer then "_Kill" else "_NormalFall"))
	end

	if killer then
		-- CASO A: COMBAT ELIMINATION (+1 Kill)
		if not self._resolvedEliminations[elimKey] then
			self._resolvedEliminations[elimKey] = true
				-- Deaths means accepted competitive eliminations, never normal zero-death falls.
				if roundService.RecordMatchPerformance then
					roundService:RecordMatchPerformance(matchId, "Elimination_" .. elimKey, nil, killer, player)
				end

			local playerService = self:_getPlayerService()
			if playerService and type(playerService.AddKill) == "function" then
					playerService:AddKill(killer, 1, "SlapElimination")
					if type(playerService.AwardConfirmedKill) == "function" then
						-- Credit once by EliminationId; only the committed amount enters the visual receipt.
						rewardCoins = playerService:AwardConfirmedKill(killer, player, matchId, elimKey)
					end
			end

			print(string.format("[EliminationService] COMBAT ELIMINATION (%s): '%s' eliminó a '%s' (+1 Kill) en Match '%s'",
				source, killer.Name, player.Name, matchId))

			-- Limpiar CombatTag consumido
			if combatService and type(combatService.ClearCombatTag) == "function" then
				combatService:ClearCombatTag(player)
			end

			-- Emitir BindableEvent para sistemas de estadísticas y feed
			local record: EliminationRecord = {
				Victim = player,
				Killer = killer,
				MatchId = matchId,
				Timestamp = now,
				Reason = source,
				EliminationId = elimKey,
					FeedbackSnapshot = feedbackSnapshot,
					ImpactCFrame = impactCFrame,
					RewardCoins = rewardCoins,
					StateVersion = session.StateVersion,
					ConfirmedAt = workspace:GetServerTimeNow(),
			}
			self:_publishReceipt(record,suddenGoal)
		end
	else
		-- CASO B: NORMAL FALL (+0 Kill)
		print(string.format("[EliminationService] NORMAL FALL (%s): '%s' cayó sin atacante en Match '%s' (Estado: %s)",
			source, player.Name, matchId, tostring(currentState)))

		-- Limpiar CombatTag residual si existiese
		if combatService and type(combatService.ClearCombatTag) == "function" then
			combatService:ClearCombatTag(player)
		end

		local record: EliminationRecord = {
			Victim = player,
			Killer = nil,
			MatchId = matchId,
			Timestamp = now,
			Reason = source .. "_NormalFall",
			EliminationId = elimKey,
				FeedbackSnapshot = feedbackSnapshot,
			ImpactCFrame = impactCFrame,
			RewardCoins = 0,
				StateVersion = session.StateVersion,
				ConfirmedAt = workspace:GetServerTimeNow(),
		}
		self:_publishReceipt(record,suddenGoal)
	end

	if suddenGoal then
  local score=self._context and self._context:GetService("ScoreService")
  if not score or not score:AwardSuddenDeathGoal(session,player,suddenRoundId) then
   roundService:CloseSession(matchId,{Cancelled=true,Reason="SuddenDeathGoalCommitFailed"})
  end
  return true
 end

	-- 10. Reposicionamiento del Character EXISTENTE sin matar Humanoid ni recargar rig
	local spawnService = self:_getSpawnService()
	if not deferredRespawn and spawnService and type(spawnService.ResetCharacterInArena) == "function" then
		spawnService:ResetCharacterInArena(player)
	end
	return true
end

-- ==================================================
-- POLLING FAIL-SAFE DE CAÍDAS AL VACÍO (Fase 3B)
-- ==================================================

function EliminationService:_startPollingIfNeeded()
	if self._isPolling then return end
	self._isPolling = true
	self._pollThread = task.spawn(function()
		self:_pollActiveSessions()
	end)
end

function EliminationService:_stopPolling()
	self._isPolling = false
	if self._pollThread then
		task.cancel(self._pollThread)
		self._pollThread = nil
	end
end

-- Chequeo periódico exclusivo sobre participantes de partidas activas
function EliminationService:_pollActiveSessions()
	local pollInterval = (Config.Arena and Config.Arena.VoidBoundaryPollInterval) or 0.2

	while self._isPolling do
		task.wait(pollInterval)
		if not self._isPolling then break end

		for matchId, session in pairs(self._activeSessions) do
			if not session or not session.InstanceInfo then continue end
			if self:_getActiveSession(matchId) ~= session then continue end
			local boundaryPart = session.InstanceInfo.VoidBoundaryPart
			if not boundaryPart or not boundaryPart.Parent then continue end

			local roundService = self:_getRoundService()
			local currentState = roundService:GetSessionState(matchId)
			if currentState ~= Constants.RoundState.Playing
				and currentState ~= Constants.RoundState.PointRestartCountdown
				and currentState ~= Constants.RoundState.StartCountdown
				and currentState ~= Constants.RoundState.Ending then
				continue
			end

			-- Criterio de altura: relativa a la geometría del VoidBoundary de esta MatchInstance
			local thresholdY = boundaryPart.Position.Y + (boundaryPart.Size.Y * 0.5)

			local playersToCheck: { Player } = {}
			for _, participant in ipairs(session.Participants) do
				if self:_getParticipant(matchId, participant.Player) == participant then
					table.insert(playersToCheck, participant.Player)
				end
			end

			local now = os.clock()
			for _, player in ipairs(playersToCheck) do
				if not player:IsDescendantOf(Players) then continue end

				-- Descarte rápido si ya está en procesamiento activo por Touched
				local lastTouch = self._processingEliminations[player]
				if lastTouch and (now - lastTouch) < 0.5 then
					continue
				end

				local character = player.Character
				if not character or not character.Parent then continue end
				local hrp = character:FindFirstChild("HumanoidRootPart") :: BasePart?
				if not hrp then continue end

				if hrp.Position.Y <= thresholdY then
					self:_processEliminationEvent(player, session, "VoidBoundaryPolling", boundaryPart)
				end
			end
		end
	end
end

-- ==================================================
-- RESOLUCIÓN DE ELIMINACIONES Y KILLS (Compatibilidad)
-- ==================================================

-- Invocado cuando un jugador es eliminado; resuelve la atribución de Kill de forma segura
function EliminationService:OnPlayerEliminated(victim: Player, reason: string, overrideMatchId: string?): (boolean, Player?)
	-- 1. Validar que la víctima exista y sea Player
	if not isPlayer(victim) then
		return false, nil
	end

	-- 2. Resolver y validar MatchId
	local matchId = overrideMatchId
	local roundService = self:_getRoundService()
	local session: MatchSession? = nil

	if matchId then
		if roundService and type(roundService.GetSessionById) == "function" then
			session = roundService:GetSessionById(matchId)
		end
	else
		if roundService and type(roundService.GetSessionForPlayer) == "function" then
			session = roundService:GetSessionForPlayer(victim)
			if session then
				matchId = session.Id
			end
		end
	end

	if not matchId or not session then
		-- Jugador fuera de partida o match no encontrado
		return false, nil
	end
	if self:_getActiveSession(matchId) ~= session or not self:_getParticipant(matchId, victim) then
		return false, nil
	end

	-- En arquitectura Zero-Death, las eliminaciones autoritativas ocurren exclusivamente via KillPart/VoidBoundary
	local currentState = roundService:GetSessionState(matchId)
	if currentState == Constants.RoundState.Playing or currentState == Constants.RoundState.PointRestartCountdown then
		warn(string.format("[EliminationService] [DIAGNOSTIC] OnPlayerEliminated invocado para '%s' (Razón: %s) en partida Zero-Death. Se descarta scoring o respawn secundario.",
			victim.Name, tostring(reason)))
		return false, nil
	end

	-- 3. Validar que la partida no esté cancelada ni terminada
	if session.Result == "Cancelled" then
		return false, nil
	end

	local currentCharacter=victim.Character
 if currentCharacter and self._transits:Get(session,victim,currentCharacter,currentCharacter:GetAttribute("ArenaPhysicsGeneration") or 0) then return false,nil end

	-- 4. ANTI-DUPLICATE CHECK: Cada eliminación produce exactamente 1 resolución
	local char = victim.Character
	local charId = if char then tostring(char:GetDebugId()) else tostring(victim.UserId)
	local elimKey = string.format("%s_%d_%s", matchId, victim.UserId, charId)

	if self._resolvedEliminations[elimKey] then
		-- Ya fue resuelta para este personaje / ciclo de vida
		return false, nil
	end
	self._resolvedEliminations[elimKey] = true

	-- 5. Resolver el último atacante válido mediante CombatService
	local combatService = self:_getCombatService()
	local killer: Player? = nil

	if combatService and type(combatService.GetLastAttacker) == "function" then
		local attacker, attackerMatchId, _hitTimestamp = combatService:GetLastAttacker(
			victim,
			(Config.Combat and Config.Combat.LastHitLifetime) or 10
		)

		-- 6. Validaciones estrictas sobre el atacante
		if attacker and attacker ~= victim and isPlayer(attacker) and attacker.Parent
			and attackerMatchId == matchId
			and self:_isOpposingParticipant(matchId, attacker, victim) then
			killer = attacker
		end
	end

	-- 7. Limpiar CombatTag de la víctima para no reutilizar impactos previos
	if combatService and type(combatService.ClearCombatTag) == "function" then
		combatService:ClearCombatTag(victim)
	end

	-- 8. Atribución autoritativa de Kill si existe atacante válido
	if killer then
		local playerService = self:_getPlayerService()
		if playerService and type(playerService.AddKill) == "function" then
			playerService:AddKill(killer, 1, "SlapElimination")
		end

		print(string.format("[EliminationService] KILL CONFIRMADA: '%s' eliminó a '%s' en Match '%s' (Razón: %s)",
			killer.Name, victim.Name, matchId, reason or "KillPart"))
	else
		print(string.format("[EliminationService] Eliminación de '%s' en Match '%s' sin atacante válido (Razón: %s)",
			victim.Name, matchId, reason or "Fall/Suicide"))
	end

	-- 9. Emitir registro a través del BindableEvent
	local record: EliminationRecord = {
		Victim = victim,
		Killer = killer,
		MatchId = matchId,
		Timestamp = os.clock(),
		Reason = reason or "Unknown",
		EliminationId = elimKey,
	}
	playerEliminatedBindable:Fire(record)

	return true, killer
end

return EliminationService
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="964">
        <Properties>
          <string name="Name">Gameplay</string>
        </Properties>
        <Item class="ModuleScript" referent="965">
          <Properties>
            <string name="Name">PartyQueueModel</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Pure transaction model. No yielding, remotes, clocks, random calls or cloud access.
local M={}
function M.Copy(v)
 if type(v)~='table'then return v end
 local out={};for k,x in pairs(v)do out[k]=M.Copy(x)end;return out
end
function M.Empty()return {Tickets={},Matches={}}end
function M.Prune(s,now)
 for id,m in pairs(s.Matches)do if now>=m.ExpiresAt then s.Matches[id]=nil end end
 for id,t in pairs(s.Tickets)do
  if now>=t.ExpiresAt or t.Match and not s.Matches[t.Match]then s.Tickets[id]=nil end
 end
end
function M.Add(s,t,c,now)
 if s.Tickets[t.Id]then return false,'AlreadyQueued'end
 local n=0;local ids={};for _,v in ipairs(t.Members)do if ids[v]then return false,'DuplicatePlayer'end;ids[v]=true end
 for _,existing in pairs(s.Tickets)do n+=1;for _,id in ipairs(existing.Members)do if ids[id]then return false,'AlreadyQueued'end end end
 if n>=c.MaxTickets then return false,'QueueFull'end
 s.Tickets[t.Id]=M.Copy(t);s.Tickets[t.Id].ExpiresAt=now+c.TicketTTL;return true
end
function M.Cancel(s,id,job)
 local t=s.Tickets[id];if not t then return true end
 if t.Job~=job then return false,'Forbidden'end
 if t.Match then return false,'MatchFound'end
 s.Tickets[id]=nil;return true
end
function M.Heartbeat(s,id,job,now,c)
 local t=s.Tickets[id];if not t or t.Job~=job then return false end
 t.ExpiresAt=now+(t.Match and c.MatchTTL or c.TicketTTL);return true
end
local function compatible(a,b,now,c)
 if now-math.min(a.CreatedAt,b.CreatedAt)>=c.RegionRelaxSeconds then return true end
 return a.Region==b.Region and math.abs(a.Ping-b.Ping)<=c.PingSpread
end
-- Bounded dynamic programming (at most 25 states for 4v4), never split a ticket.
function M.Select(s,size,now,c)
 local list={};for _,t in pairs(s.Tickets)do if not t.Match and t.ExpiresAt>now and #t.Members<=size then table.insert(list,t)end end
 table.sort(list,function(a,b)return a.CreatedAt==b.CreatedAt and a.Id<b.Id or a.CreatedAt<b.CreatedAt end)
 for _,anchor in ipairs(list)do
  local dp={['0:0']={Red={},Blue={}}}
  for _,t in ipairs(list)do if compatible(anchor,t,now,c)then
   local nextDP=table.clone(dp)
   for key,teams in pairs(dp)do
    local r,b=key:match('(%d+):(%d+)');r=tonumber(r);b=tonumber(b)
    for _,side in ipairs({'Red','Blue'})do
     local nr=r+(side=='Red'and #t.Members or 0);local nb=b+(side=='Blue'and #t.Members or 0)
     local k=nr..':'..nb
     if nr<=size and nb<=size and not nextDP[k]then
      local selected={Red=table.clone(teams.Red),Blue=table.clone(teams.Blue)}
      table.insert(selected[side],t.Id);nextDP[k]=selected
     end
    end
   end
   dp=nextDP
  end end
  if dp[size..':'..size]then return dp[size..':'..size]end
 end
end
function M.Assign(s,id,mode,size,job,now,c)
 local count=0;for _ in pairs(s.Matches)do count+=1 end;if count>=c.MaxMatches then return end
 local teams=M.Select(s,size,now,c);if not teams then return end
 local m={Id=id,Mode=mode,Size=size,Owner=job,State='Allocating',CreatedAt=now,ExpiresAt=now+c.MatchTTL,AllocateUntil=now+c.AllocationSeconds,Red={},Blue={},Parties={}}
 for _,side in ipairs({'Red','Blue'})do for _,key in ipairs(teams[side])do
  local t=s.Tickets[key];t.Match=id;t.ExpiresAt=m.ExpiresAt
  table.insert(m.Parties,M.Copy(t));for _,uid in ipairs(t.Members)do table.insert(m[side],uid)end
 end end
 s.Matches[id]=m;return m
end
function M.Fail(s,id,reason)
 local m=s.Matches[id];if m and m.State~='Running'then m.State='Failed';m.Reason=reason end
end
function M.IsMember(m,id)
 return table.find(m.Red,id)~=nil or table.find(m.Blue,id)~=nil
end
function M.ValidArrival(m,id,privateId,now)
 return m~=nil and m.State=='Ready'and m.ExpiresAt>now and m.PrivateId==privateId and M.IsMember(m,id)
end
return M
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="966">
          <Properties>
            <string name="Name">PartyQueueStore</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Studio does not even acquire MemoryStoreService.
local Model=require(script.Parent.PartyQueueModel)
local Store={};Store.__index=Store
function Store.new(global,namespace)
 local map
 if global then map=game:GetService('MemoryStoreService'):GetSortedMap(namespace)end
 return setmetatable({Map=map,Local={}},Store)
end
function Store:Update(mode,transform)
 if self.Map then
  return self.Map:UpdateAsync(mode,function(old)
   local s=Model.Copy(old or Model.Empty());transform(s);return s
  end,600)
 end
 local s=Model.Copy(self.Local[mode]or Model.Empty());transform(s);self.Local[mode]=s;return Model.Copy(s)
end
function Store:Read(mode)
 return self.Map and self.Map:GetAsync(mode)or Model.Copy(self.Local[mode]or Model.Empty())
end
return Store
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="967">
          <Properties>
            <string name="Name">RoundClock</string>
            <string name="Source"><![CDATA[--!strict
-- Pure deadline contract; callers supply monotonic/server network time for isolated tests.
local Clock={}
function Clock.Start(sessionId: string,index: number,duration: number,now: number,networkNow: number): any
 return {Id=sessionId..":Round:"..index,Index=index,Deadline=now+duration,NetworkDeadline=networkNow+duration,Resolved=nil,SuddenDeath=false}
end
function Clock.IsOpen(round: any,now: number): boolean
 return round~=nil and round.Resolved==nil and now<round.Deadline
end
function Clock.Remaining(round: any,now: number): number
 return math.max(0,math.ceil(round.Deadline-now))
end
function Clock.Resolve(round: any,kind: string,now: number): boolean
 if not round or round.Resolved~=nil then return false end
 if kind=="Timeout" then if now<round.Deadline then return false end
 elseif now>=round.Deadline then return false end
 round.Resolved=kind;round.ResolvedAt=now
 return true
end
return Clock
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="968">
          <Properties>
            <string name="Name">SeasonState</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Pure compare-and-swap transform; no side effects inside UpdateAsync callbacks.
local M=require(game.ReplicatedStorage.Shared.Progression.Model)
local State={}
function State.Valid(row)
 if type(row)~='table'or not M.Integer(row.Revision)then return false end
 local s=row.Active;if s==nil then return true end
 if type(s)~='table'or type(s.Id)~='string'or #s.Id==0 or type(s.DisplayName)~='string'or not M.Integer(s.StartsAt)or not M.Integer(s.EndsAt)or s.EndsAt<s.StartsAt or not M.Integer(s.StageXP)or s.StageXP<1 or s.Stages~=30 or type(s.Rewards)~='table'then return false end
 for i=1,30 do local reward=s.Rewards[i];if type(reward)~='table'or type(reward.Label)~='string'or(reward.Kind~='Coins'and reward.Kind~='Slap'and reward.Kind~='Effect')then return false end end
 return true
end
function State.Apply(old,expected,command,definition,days,id,operation,now,actor)
 old=old or {Revision=0}
 if not State.Valid(old)then return nil,'SeasonCorrupted'end
 if old.LastOperation==operation then return old,'Replay'end
 if old.Revision~=expected then return nil,'SeasonChanged'end
 if command=='Start'and M.Active(old.Active,now)then return nil,'SeasonAlreadyActive'end
 if command~='Start'and command~='Restart'and command~='End'then return nil,'InvalidCommand'end
 local nextState=M.Copy(old);nextState.Revision+=1;nextState.LastOperation=operation;nextState.ActorUserId=actor;nextState.ChangedAt=now
 if command=='End'then
  if not M.Active(old.Active,now)then return nil,'NoActiveSeason'end
  nextState.Active.EndsAt=now
 else
  if not definition or not M.Integer(days)or days<1 or days>365 then return nil,'InvalidDuration'end
  nextState.Active={Id=id,PresetId=definition.Id,Version=definition.Version,DisplayName=definition.DisplayName,StartsAt=now,EndsAt=now+days*86400,StageXP=definition.StageXP,Stages=definition.Stages,Rewards=M.Copy(definition.Rewards),StudioOnly=definition.StudioOnly==true}
 end
 return nextState,'Applied'
end
return State
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="969">
          <Properties>
            <string name="Name">SocialPlayEngine</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Disposable server state. No remotes, persistence or client-supplied rosters.
local Engine={};Engine.__index=Engine
function Engine.new(config,deps)
 return setmetatable({C=config,D=deps,Groups={},Membership={},Pending={},Busy={},LastInvite={},Grants={}},Engine)
end
function Engine:Group(id)return self.Groups[self.Membership[id]]end
function Engine:GroupView(id)
 local g=self:Group(id);if not g then return nil end
 local members={};for _,v in ipairs(g.Members)do table.insert(members,{UserId=v,DisplayName=self.D.Name(v)})end
 return {Id=g.Id,Leader=g.Leader,Members=members,Revision=g.Revision}
end
function Engine:_publish(g)
 for _,id in ipairs(g.Members)do self.Membership[id]=g.Id;self.D.GroupChanged(id,g.Id);self.D.Emit(id,'Group',self:GroupView(id))end
end
function Engine:_finish(request,reason)
 if self.Pending[request.Id]~=request then return end
 self.Pending[request.Id]=nil
 for _,id in ipairs({request.From,request.To})do
  if self.Busy[id]==request.Id then self.Busy[id]=nil end
  self.D.Emit(id,'RequestClosed',{Id=request.Id,Reason=reason})
 end
end
function Engine:_available(id)
 return self.D.Eligible(id) and not self.Busy[id]
end
function Engine:_groupFree(g)
 for _,id in ipairs(g.Members)do if not self.D.Eligible(id)then return false end end
 return true
end
function Engine:CanChallenge(a,b)
 return a~=b and not self:Group(a)and not self:Group(b)and self:_available(a)and self:_available(b)
end
function Engine:Invite(from,to,kind)
 if kind~='Duel'and kind~='Group'then return false,'InvalidKind'end
 if from==to or not self:_available(from)or not self:_available(to)then return false,'PlayerUnavailable'end
 if kind=='Duel'and not self.D.Near(from,to)then return false,'OutOfRange'end
 local group=self:Group(from)
 if kind=='Duel'then
  if group or self:Group(to)then return false,'InGroup'end
 else
  if self:Group(to)then return false,'AlreadyGrouped'end
  if group and (group.Leader~=from or #group.Members>=self.C.MaxGroupSize or not self:_groupFree(group))then return false,'GroupUnavailable'end
 end
 local now=self.D.Clock()
 if now-(self.LastInvite[from]or -math.huge)<self.C.InviteCooldown then return false,'InviteCooldown'end
 local req={Id=self.D.Id(),Kind=kind,From=from,To=to,ExpiresAt=now+self.C.RequestLifetime,GroupId=group and group.Id,Revision=group and group.Revision}
 self.LastInvite[from]=now;self.Pending[req.Id]=req;self.Busy[from]=req.Id;self.Busy[to]=req.Id
 for _,id in ipairs({from,to})do self.D.Emit(id,'Request',{Id=req.Id,Kind=kind,From=from,To=to,FromName=self.D.Name(from),ToName=self.D.Name(to),ExpiresAt=req.ExpiresAt})end
 return true,req.Id
end
function Engine:Respond(id,key,accept)
 local req=self.Pending[key]
 if not req or req.To~=id or type(accept)~='boolean'then return false,'InvalidRequest'end
 if self.D.Clock()>=req.ExpiresAt then self:_finish(req,'Expired');return false,'Expired'end
 if not accept then self:_finish(req,'Declined');return true end
 if not self.D.Eligible(req.From)or not self.D.Eligible(req.To)then self:_finish(req,'PlayerUnavailable');return false,'PlayerUnavailable'end
 if req.Kind=='Duel'then
  if self:Group(req.From)or self:Group(req.To)then self:_finish(req,'InGroup');return false,'InGroup'end
  local grant={ZoneId='Duel:'..req.Id,Token=self.D.Id(),A=req.From,B=req.To,ExpiresAt=self.D.Clock()+self.C.DuelReservationLifetime,Consumed=false}
  self:_finish(req,'Accepted');self.Grants[grant.ZoneId]=grant
  local ok,started,why=pcall(self.D.StartDuel,grant)
  if not ok or not started then
   self.Grants[grant.ZoneId]=nil
   for _,uid in ipairs({grant.A,grant.B})do self.D.Emit(uid,'Notice',{Reason=ok and why or 'DuelStartFailed'})end
   return false,ok and why or 'DuelStartFailed'
  end
 else
  local group=self:Group(req.From)
  if self:Group(req.To)or (group and (group.Leader~=req.From or group.Id~=req.GroupId or group.Revision~=req.Revision or #group.Members>=self.C.MaxGroupSize or not self:_groupFree(group)))or (not group and req.GroupId)then
   self:_finish(req,'GroupChanged');return false,'GroupChanged'
  end
  if not group then group={Id=self.D.Id(),Leader=req.From,Members={req.From},Revision=0};self.Groups[group.Id]=group end
  self:_finish(req,'Accepted');table.insert(group.Members,req.To);group.Revision+=1;self:_publish(group)
 end
 return true
end
function Engine:Leave(id,disband,force)
 local group=self:Group(id);if not group then return false,'NotGrouped'end
 if not force and not self:_groupFree(group)then return false,'GroupBusy'end
 if disband and group.Leader~=id then return false,'NotLeader'end
 local old=table.clone(group.Members)
 if disband then table.clear(group.Members)else table.remove(group.Members,table.find(group.Members,id))end
 self.Membership[id]=nil;self.D.GroupChanged(id,nil);self.D.Emit(id,'Group',nil)
 if #group.Members<2 then
  self.Groups[group.Id]=nil
  for _,member in ipairs(old)do self.Membership[member]=nil;self.D.GroupChanged(member,nil);self.D.Emit(member,'Group',nil)end
 else
  if group.Leader==id then group.Leader=group.Members[1]end
  group.Revision+=1;self:_publish(group)
 end
 return true
end
function Engine:CanQueueTeam(players,teamSize)
 local present={};for _,p in ipairs(players)do present[p.UserId]=true end
 for _,p in ipairs(players)do local g=self:Group(p.UserId)
  if g then
   if #g.Members>teamSize then return false,'GroupTooLarge'end
   for _,id in ipairs(g.Members)do if not present[id]then return false,'IncompleteGroup'end end
  end
 end
 return true
end
function Engine:Tick()
 for _,req in pairs(self.Pending)do
  if self.D.Clock()>=req.ExpiresAt or not self.D.Eligible(req.From)or not self.D.Eligible(req.To)then self:_finish(req,'ExpiredOrUnavailable')end
 end
 for zone,g in pairs(self.Grants)do if self.D.Clock()>=g.ExpiresAt then self.Grants[zone]=nil end end
end
function Engine:Disconnect(id)
 local req=self.Pending[self.Busy[id]];if req then self:_finish(req,'Disconnected')end
 self:Leave(id,false,true);self.LastInvite[id]=nil
 for zone,g in pairs(self.Grants)do if g.A==id or g.B==id then self.Grants[zone]=nil end end
end
return Engine
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="970">
          <Properties>
            <string name="Name">TrainingState</string>
            <string name="Source"><![CDATA[--!strict
local State={}
function State.Begin(record: any,sequence: any,now: number): (boolean,string?)
 if type(sequence)~='number' or sequence~=sequence or sequence%1~=0 or sequence<1 or sequence>1000000 then return false,'InvalidSequence' end
 if sequence<=(record.LastSequence or 0)then return false,'Replayed' end
 record.LastSequence=sequence
 if record.Pending or now<(record.ReadyAt or 0)then return false,'Recovery' end
 record.Pending=sequence
 return true
end
function State.Finish(record: any,sequence: number,now: number,hit: boolean,combo: any,cooldown: number): boolean
 if record.Pending~=sequence then return false end
 record.Pending=nil
 record.ReadyAt=now+(if combo.Enabled then (if hit then combo.SuccessfulHitRecovery else combo.MissRecovery)else cooldown)
 return true
end
return State
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="971">
          <Properties>
            <string name="Name">WinStreak</string>
            <string name="Source"><![CDATA[--!strict
-- Permanent blocks earned, plus only the unfinished consecutive-win block.
local Config=require(game:GetService('ReplicatedStorage').Shared.SocialPlayConfig)
local Streak={}
function Streak.Normalize(value: any): { [string]: any }
 local v=if type(value)=='table' then value else {}
 local function integer(n: any): number
  return if type(n)=='number' and n==n and n>=0 and n<9007199254740991 then math.floor(n) else 0
 end
 return {Total=integer(v.Total),Progress=integer(v.Progress)%Config.WinBlockSize,
  LastMatchId=if type(v.LastMatchId)=='string' and #v.LastMatchId<=128 then v.LastMatchId else nil}
end
function Streak.Apply(data: any,matchId: string,outcome: string): boolean
 if type(matchId)~='string' or #matchId==0 or #matchId>128 then return false end
 if outcome~='Win' and outcome~='Loss' and outcome~='Draw' then return false end
 local stats=Streak.Normalize(data.WinStreak)
 if stats.LastMatchId==matchId then return false end
 stats.LastMatchId=matchId
 if outcome=='Win' then
  stats.Progress+=1
  if stats.Progress==Config.WinBlockSize then stats.Total+=1;stats.Progress=0 end
 else stats.Progress=0 end
 data.WinStreak=stats
 return true
end
return Streak
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="972">
