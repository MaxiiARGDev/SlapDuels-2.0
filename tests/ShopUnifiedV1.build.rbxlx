      <Item class="Folder" referent="4322">
        <Properties>
          <string name="Name">EndCinematic</string>
        </Properties>
        <Item class="Folder" referent="4323">
          <Properties>
            <string name="Name">Modules</string>
          </Properties>
          <Item class="ModuleScript" referent="4324">
            <Properties>
              <string name="Name">EndCinematicAnimations</string>
              <string name="Source"><![CDATA[--!nonstrict
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Config = require(game.ReplicatedStorage.Shared.EndCinematicConfig)
local Module = {}
local function make(class, properties, parent)
 local object = Instance.new(class)
 for key, value in pairs(properties) do object[key] = value end
 object.Parent = parent
 return object
end
function Module.Play(run, entry, index)
	task.wait(Config.Winners.WalkStartDelay + (index - 1) * Config.Winners.EntryStagger)
	if not run:IsAlive() then return end
	local track
	if Config.Winners.WalkAnimationId ~= "" then
		local ok, result = pcall(function()
			local animator = entry.Model:FindFirstChildOfClass("Humanoid"):FindFirstChildOfClass("Animator")
			local animation = make("Animation", { AnimationId = Config.Winners.WalkAnimationId }, run.Container)
			return animator:LoadAnimation(animation)
		end)
		if ok then track = result; table.insert(run.Tracks, track); track:Play() else warn("[EndCinematic] Animation unavailable: " .. tostring(result)) end
	end
	local alpha = make("NumberValue", { Value = 0 }, run.Container)
	table.insert(run.Connections, alpha.Changed:Connect(function(v)
		if run:IsAlive() then entry.Model:PivotTo(entry.Start:Lerp(entry.Finish, v)) end
	end))
	run:Tween(alpha, Config.Winners.WalkDuration, { Value = 1 })
	if track then track:Stop(0.15) end
	if run:IsAlive() then entry.Model:PivotTo(entry.Finish); run.WalksDone += 1 end
end


function Module.Cleanup(run)
 for _, track in ipairs(run.Tracks) do pcall(function() track:Stop(0); track:Destroy() end) end
 run.Tracks = {}
end
return Module
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="4325">
            <Properties>
              <string name="Name">EndCinematicAudio</string>
              <string name="Source"><![CDATA[--!nonstrict
local Config = require(game.ReplicatedStorage.Shared.EndCinematicConfig)
local Module = {}

local function normalizeSoundId(id)
    if type(id) ~= "string" or id == "" then
        return nil
    end

    if id:match("^%d+$") then
        return "rbxassetid://" .. id
    end

    return id
end

function Module.PlayTransition(run, closed)
 local config = Config.TransitionAudio
 if not run:IsAlive() or not config.Enabled then return false end
 local phase = closed and "Close" or "Open"
 run.TransitionStarted = run.TransitionStarted or {}
 if run.TransitionStarted[phase] then return false end
 run.TransitionStarted[phase] = true
 local name = config[phase .. "SoundName"]
 local source = name and name ~= "" and run.Scene:FindFirstChild(name, true)
 local id = config[phase .. "SoundId"]
 if not (source and source:IsA("Sound")) and (type(id) ~= "string" or id == "") then return false end
 local sound = source and source:IsA("Sound") and source:Clone() or Instance.new("Sound")
 if not source or not source:IsA("Sound") then
    sound.SoundId = normalizeSoundId(id) or ""
 end
 if sound.SoundId == "" then sound:Destroy(); return false end
 sound.Name = "EndCinematic" .. phase .. "Whoosh"
 sound.Looped = false
 sound.Volume = math.clamp(config[phase .. "Volume"], 0, 10)
 sound.PlaybackSpeed = math.max(.01, config[phase .. "PlaybackSpeed"])
 sound.TimePosition = math.max(0, config[phase .. "StartOffset"])
 if not run.TransitionAudioFolder then
  run.TransitionAudioFolder = Instance.new("Folder")
  run.TransitionAudioFolder.Name = "EndCinematicTransitionAudio_" .. run.Id
  run.TransitionAudioFolder.Parent = game:GetService("SoundService")
  table.insert(run.Resources, run.TransitionAudioFolder)
 end
 sound.Parent = run.TransitionAudioFolder
 run.TransitionSounds = run.TransitionSounds or {}
 table.insert(run.TransitionSounds, sound)
 sound:Play()
 return true
end

function Module.Prepare(run, stage)
 run.AudioCopies = {}
 run.AudioStarted = {}
 local confetti = stage:FindFirstChild("Confeti")
 if not confetti then return end
 for _, dropName in ipairs({ "DropT1", "DropT2" }) do
  local drop = confetti:FindFirstChild(dropName)
  local folder = drop and drop:FindFirstChild("AllSoundsPlay")
  local localDrop = run.Effects:FindFirstChild(dropName)
  if folder and localDrop then
   for _, object in ipairs(folder:GetDescendants()) do
    if object:IsA("Sound") then
     local sound = object:Clone()
     sound:Stop()
     sound.Parent = localDrop
     table.insert(run.AudioCopies, sound)
    end
   end
  end
 end
end

function Module.Play(run)
 if not run:IsAlive() or not Config.Effects.SoundsEnabled then return end
 for _, sound in ipairs(run.AudioCopies or {}) do
  if sound.SoundId ~= "" and not Config.Effects.DisabledSounds[sound.Name] and not run.AudioStarted[sound] then
   run.AudioStarted[sound] = true
   sound:Play()
  end
 end
end

function Module.Stop(run)
 for _, sound in ipairs(run.AudioCopies or {}) do
  if run.AudioStarted[sound] then sound:Stop() end
 end
end

function Module.Cleanup(run)
 Module.Stop(run)
 for _, sound in ipairs(run.TransitionSounds or {}) do sound:Stop(); sound:Destroy() end
 run.TransitionSounds = {}
 run.TransitionStarted = {}
 for _, sound in ipairs(run.AudioCopies or {}) do sound:Destroy() end
 run.AudioCopies = {}
 run.AudioStarted = {}
end
return Module
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="4326">
            <Properties>
              <string name="Name">EndCinematicAvatars</string>
              <string name="Source"><![CDATA[--!nonstrict
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Config = require(game.ReplicatedStorage.Shared.EndCinematicConfig)
local Module = {}
local function make(class, properties, parent)
 local object = Instance.new(class)
 for key, value in pairs(properties) do object[key] = value end
 object.Parent = parent
 return object
end
function Module.Prepare(run, winner, slot, stage, cameraEnd)
	local description
	local descriptions = run.Scene and run.Scene:FindFirstChild("WinnerDescriptions")
	local snapshot = descriptions and winner.DescriptionKey and descriptions:FindFirstChild(winner.DescriptionKey)
		local player = Players:GetPlayerByUserId(winner.AppearanceUserId or winner.UserId)
	local humanoid = player and player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		local resolved, failure=pcall(function()
		if snapshot and snapshot:IsA("HumanoidDescription") then description = snapshot:Clone()
	elseif humanoid then description = humanoid:GetAppliedDescription()
	elseif winner.UserId > 0 then description = Players:GetHumanoidDescriptionFromUserIdAsync(winner.UserId)
		end
		end)
		if not resolved or not description then
			warn("[EndCinematic] Appearance unavailable for "..tostring(winner.UserId)..": "..tostring(failure))
			description=Instance.new("HumanoidDescription")
		end
	if not run:IsAlive() then description:Destroy(); return end
	local ok, rig = pcall(function() return Players:CreateHumanoidModelFromDescriptionAsync(description, Enum.HumanoidRigType.R15) end)
	description:Destroy()
	if not ok then error(rig) end
	if not run:IsAlive() then rig:Destroy(); return end
	rig.Name = "Winner_" .. tostring(winner.UserId)
	for _, object in ipairs(rig:GetDescendants()) do
		if object:IsA("LuaSourceContainer") or object:IsA("Tool") then object:Destroy()
		elseif object:IsA("BasePart") then object.CanCollide = false; object.CanTouch = false; object.CanQuery = false end
	end
	local root = assert(rig:FindFirstChild("HumanoidRootPart"), "Rig root missing")
	root.Anchored = true
	rig.Parent = run.Container
	local _, size = rig:GetBoundingBox()
	local rigHumanoid = rig:FindFirstChildOfClass("Humanoid")
	local bottomOffset = rig:GetPivot().Position.Y - root.Position.Y + rigHumanoid.HipHeight + root.Size.Y / 2
	local finish = slot.CFrame * CFrame.new(0, slot.Size.Y / 2 + bottomOffset, 0)
	-- Walk ends at the authored slot; clamp its starting point to the platform.
	local distance = math.max(0, Config.Winners.WalkDistance)
	local floor = stage.Structure:FindFirstChild("Floor")
	while distance > 0 do
		local start = finish * CFrame.new(0, 0, distance)
		local localPoint = floor.CFrame:PointToObjectSpace(start.Position)
		if math.abs(localPoint.X) + size.X / 2 + Config.Winners.PlatformMargin <= floor.Size.X / 2
			and math.abs(localPoint.Z) + size.Z / 2 + Config.Winners.PlatformMargin <= floor.Size.Z / 2
			and (start.Position - cameraEnd.Position).Magnitude >= Config.Winners.CameraClearance then break end
		distance = math.max(0, distance - 0.25)
	end
	local start = finish * CFrame.new(0, 0, distance)
	rig:PivotTo(start)
		local entry={ Model = rig, Start = start, Finish = finish, Participant = winner, CinematicSlot = winner.CinematicSlot }
		table.insert(run.Rigs, entry)
		table.insert(run.Connections,rig.Destroying:Connect(function()
			if run:IsAlive() and run.OnRigRemoved then run.OnRigRemoved() end
		end))
		return entry
end


function Module.Cleanup(run)
 for _, entry in ipairs(run.Rigs) do entry.Model:Destroy() end
 run.Rigs = {}
end
return Module
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="4327">
            <Properties>
              <string name="Name">EndCinematicBillboards</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Controls authored UI in the authorized scene; never creates UI or follows rigs.
local Config = require(game.ReplicatedStorage.Shared.EndCinematicConfig)
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Billboards = {}
local owners = setmetatable({}, { __mode = "k" })
local stats = {
 {"Goals", "GoalsLabel", "GOLES", "ShowGoals"},
 {"Kills", "KillsLabel", "KILLS", "ShowKills"},
 {"Deaths", "DeathsLabel", "BAJAS", "ShowDeaths"},
 {"MatchPoints", "MatchPointsLabel", "PUNTOS", "ShowPoints"},
}
local function child(parent, name, class)
 local object = parent:FindFirstChild(name)
 assert(object and object:IsA(class), "[EndCinematicBillboards] PhysicalResourceMissingOrInvalid: "
  .. parent:GetFullName() .. "/" .. name .. " expected " .. class .. "; install V1.4.1 in Edit")
 return object
end
local function ordinal(rank)
 local tail = rank % 100
 if tail >= 11 and tail <= 13 then return rank .. "th" end
 return rank .. (({[1]="st", [2]="nd", [3]="rd"})[rank % 10] or "th")
end
local function enabled(run)
 return Config.Billboards.Enabled and run.BillboardsEnabled ~= false
  and (run.Mode ~= "1v1" or Config.Billboards.ShowIn1v1)
end
local function reset(record)
 record.Gui.Enabled = false
 record.Frame.GroupTransparency = record.Transparency
 for label, original in pairs(record.Labels) do
  label.Text = original.Static and original.Text or ""
  label.Visible = false
  label.TextColor3 = original.Color
 end
 if record.Stroke then record.Stroke.Color = record.StrokeColor end
end
function Billboards.Cleanup(run)
 run.BillboardsGeneration = (run.BillboardsGeneration or 0) + 1
 for _, connection in ipairs(run.BillboardConnections or {}) do connection:Disconnect() end
 for _, tween in ipairs(run.BillboardTweens or {}) do tween:Cancel(); tween:Destroy() end
 for _, record in ipairs(run.Billboards or {}) do
  if owners[record.Gui] == run then
   if record.Gui.Parent then
    reset(record)
    if record.Scale then record.Scale.Scale = record.OriginalScale end
   end
   owners[record.Gui] = nil
  end
 end
 run.Billboards = {}
 run.BillboardConnections = {}
 run.BillboardTweens = {}
end
function Billboards.Prepare(run)
 Billboards.Cleanup(run)
 local scene = run.Scene
 assert(scene and scene:IsA("Model") and scene:IsDescendantOf(workspace), "BillboardsSceneCloneRequired")
 assert(run.Context and run.Context.Scene == scene, "BillboardsSceneContextMismatch")
 if run.Context.IsMatch then
  assert(run.Context.Payload and scene:GetAttribute("SessionId") == run.Context.Payload.SessionId,
   "BillboardsSessionMismatch")
 else
  assert(RunService:IsStudio() and scene:GetAttribute("PreviewOwnerUserId") == Players.LocalPlayer.UserId,
   "BillboardsPreviewOwnerMismatch")
 end
 local slots = child(scene, "Players", "Instance")
 local resolved = {}
 -- Validate all five slots before changing any GUI, including unused slots.
 for index = 1, 5 do
  local slot = child(slots, "SlotPlayer_" .. index, "BasePart")
  local anchor = child(slot, "BillboardAnchor", "Part")
  assert(anchor.Anchored and anchor.Transparency == 1 and not anchor.CanCollide
   and not anchor.CanTouch and not anchor.CanQuery and not anchor.CastShadow,
   "[EndCinematicBillboards] UnsafeAnchor: " .. anchor:GetFullName())
  local gui = child(anchor, "BillboardGui", "BillboardGui")
  assert(gui.Adornee == nil or gui.Adornee == anchor, "BillboardAdorneeMustBePhysicalAnchor")
  assert(not owners[gui] or owners[gui] == run, "BillboardPlaybackAlreadyOwned")
  local frame = child(gui, "MainFrame", "CanvasGroup")
  local labels = {}
  for _, name in ipairs({"RankLabel", "PlayerName", "MVPLabel", "Username", "TeamLabel", "PreviewLabel"}) do
   local label = child(frame, name, "TextLabel")
   labels[label] = {Text=label.Text, Color=label.TextColor3,
    Static=name == "MVPLabel" or name == "PreviewLabel"}
  end
  local statsFrame = child(frame, "StatsFrame", "Frame")
  for _, stat in ipairs(stats) do
   local label = child(statsFrame, stat[2], "TextLabel")
   labels[label] = {Color=label.TextColor3}
  end
  local stroke = frame:FindFirstChildOfClass("UIStroke")
  local scale = frame:FindFirstChildOfClass("UIScale")
  resolved[index] = {Gui=gui, Frame=frame, Labels=labels, Stroke=stroke,
   StrokeColor=stroke and stroke.Color, Transparency=frame.GroupTransparency,
   Scale=scale, OriginalScale=scale and scale.Scale}
 end
 run.Billboards = resolved
 for _, record in ipairs(resolved) do owners[record.Gui] = run; reset(record) end
 local occupied = {}
 for _, entry in ipairs(run.Rigs) do
  local data = entry.Participant
  if not data then continue end -- Never inherit another participant's row.
  local index = data.CinematicSlot
  assert(type(index) == "number" and index % 1 == 0 and resolved[index] and not occupied[index],
   "BillboardsInvalidOrDuplicateCinematicSlot")
  occupied[index] = true
  local record = resolved[index]
  record.Occupied = true
  local frame = record.Frame
  frame.RankLabel.Text = ordinal(data.Rank); frame.RankLabel.Visible = true
  frame.PlayerName.Text = data.DisplayName or tostring(data.UserId); frame.PlayerName.Visible = true
  frame.Username.Text = data.Username and ("@" .. data.Username) or ""
  frame.Username.Visible = Config.Billboards.ShowUsername and data.Username ~= nil
  frame.TeamLabel.Text = data.Team == run.WinningTeam and "EQUIPO GANADOR" or "EQUIPO RIVAL"
  frame.TeamLabel.Visible = true
  frame.MVPLabel.Visible = Config.Billboards.ShowMVP and data.IsMVP == true
  frame.PreviewLabel.Visible = run.Ranking.Preview == true
  for _, stat in ipairs(stats) do
   local value = data[stat[1]]
   local label = frame.StatsFrame[stat[2]]
   label.Visible = Config.Billboards[stat[4]] and value ~= nil
   label.Text = value ~= nil and (stat[3] .. " " .. value) or ""
  end
  if Config.Billboards.DynamicColors ~= false then
   local medal = Config.Billboards.RankColors[data.Rank] or record.Labels[frame.RankLabel].Color
   frame.RankLabel.TextColor3 = medal
   frame.TeamLabel.TextColor3 = Config.Billboards.TeamColors[data.Team] or medal
   if record.Stroke then record.Stroke.Color = medal end
  end
  -- Scale the existing authored pixel canvas, without changing layout or world size.
  if record.Scale and frame.Size.X.Scale == 0 and frame.Size.X.Offset > 0 then
   local function fit()
    if owners[record.Gui] == run then
     record.Scale.Scale = math.max(.01, record.Gui.AbsoluteSize.X / frame.Size.X.Offset)
    end
   end
   fit()
   table.insert(run.BillboardConnections, record.Gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(fit))
   table.insert(run.BillboardConnections, frame:GetPropertyChangedSignal("Size"):Connect(fit))
  end
 end
end
function Billboards.Play(run)
 if not enabled(run) then return end
 if not run.Billboards or #run.Billboards == 0 then Billboards.Prepare(run) end
 local generation = run.BillboardsGeneration
 task.wait(Config.Billboards.ShowDelay)
 if not run:IsAlive() or not enabled(run) or generation ~= run.BillboardsGeneration then return end
 for _, record in ipairs(run.Billboards) do
  if record.Occupied and record.Gui.Parent and owners[record.Gui] == run then
   record.Frame.GroupTransparency = 1
   record.Gui.Enabled = true
   local tween = TweenService:Create(record.Frame, TweenInfo.new(Config.Billboards.FadeDuration),
    {GroupTransparency=record.Transparency})
   table.insert(run.BillboardTweens, tween)
   tween:Play()
  end
 end
end
return Billboards
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="4328">
            <Properties>
              <string name="Name">EndCinematicCamera</string>
              <string name="Source"><![CDATA[--!nonstrict
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local Config = require(game.ReplicatedStorage.Shared.EndCinematicConfig)
local Module = {}

function Module.ComputeFloatingFrame(anchor, baseFocus, focus, elapsed, dt, state, config)
 local ramp=math.clamp(elapsed/math.max(config.FadeInDuration,.001),0,1)
 ramp=ramp*ramp*(3-2*ramp)
 local offset=Vector3.new(math.sin(elapsed*config.LateralFrequency)*config.LateralAmplitude,
  math.sin(elapsed*config.VerticalFrequency)*config.VerticalAmplitude,0)*ramp
 if config.PreserveBaseDistance and offset.Magnitude>config.DistanceTolerance then
  offset=offset.Unit*math.max(0,config.DistanceTolerance)
 end
 local yaw,pitch=0,0
 if config.FollowEnabled then
  local a,b=anchor:PointToObjectSpace(baseFocus),anchor:PointToObjectSpace(focus)
  local function angles(v) return math.atan2(-v.X,-v.Z),math.atan2(v.Y,Vector2.new(v.X,v.Z).Magnitude) end
  local ya,pa=angles(a); local yb,pb=angles(b)
  yaw=math.atan2(math.sin(yb-ya),math.cos(yb-ya))
  pitch=pb-pa
 end
 local maxYaw,maxPitch=math.rad(config.MaxYawDegrees),math.rad(config.MaxPitchDegrees)
 yaw=math.clamp(yaw+math.rad(.15)*math.sin(elapsed*.32),-maxYaw,maxYaw)*ramp
 pitch=math.clamp(pitch+math.rad(.1)*math.sin(elapsed*.41),-maxPitch,maxPitch)*ramp
 local alpha=1-math.exp(-math.max(0,config.FollowResponsiveness)*math.max(0,dt))
 state.Yaw=(state.Yaw or 0)+(yaw-(state.Yaw or 0))*alpha
 state.Pitch=(state.Pitch or 0)+(pitch-(state.Pitch or 0))*alpha
 return anchor*CFrame.new(offset)*CFrame.Angles(state.Pitch,state.Yaw,0)
end

local function focusOf(run)
 local sum,count=Vector3.zero,0
 for _,entry in ipairs(run.Rigs) do
  if entry.Model.Parent then
   local position=entry.Model:GetPivot().Position
   -- Ignore teleports unrelated to the authored entrance animation.
   if (position-entry.Finish.Position).Magnitude<=Config.FloatingFollow.MaxTargetStep then
    sum+=position+Vector3.new(0,Config.FloatingFollow.FocusHeight,0); count+=1
   end
  end
 end
 return count>0 and sum/count or nil
end

function Module.StartFloating(run, anchor)
 if not Config.FloatingFollow.Enabled or run.FloatingEnabled==false or run.FloatingConnection then return end
 local baseFocus=focusOf(run) or (anchor.Position+anchor.LookVector*10)
 local focus=baseFocus
 local elapsed,state=0,{}
 run.FloatingAnchor=anchor
 run.FloatingConnection=RunService.RenderStepped:Connect(function(dt)
  if not run:IsAlive() or workspace.CurrentCamera~=run.Camera then return end
  elapsed+=dt
  local target=focusOf(run)
  if target and (target-focus).Magnitude<=Config.FloatingFollow.MaxTargetStep then focus=target end
  run.Camera.CFrame=Module.ComputeFloatingFrame(anchor,baseFocus,focus,elapsed,dt,state,Config.FloatingFollow)
  if Config.FloatingFollow.FieldOfViewLocked then run.Camera.FieldOfView=run.FieldOfView end
 end)
 table.insert(run.Connections,run.FloatingConnection)
end

function Module.StopFloating(run)
 local connection=run.FloatingConnection
 if connection then
  connection:Disconnect()
  local index=table.find(run.Connections,connection)
  if index then table.remove(run.Connections,index) end
  run.FloatingConnection=nil
 end
 if run.Camera and run.CameraDone then run.Camera.CFrame=run.Destination end
end
local function make(class, properties, parent)
 local object = Instance.new(class)
 for key, value in pairs(properties) do object[key] = value end
 object.Parent = parent
 return object
end
function Module.Play(run, from, target)
	local alpha = make("NumberValue", { Value = 0 }, run.Container)
	local bounce = false
		local travelConnection = alpha.Changed:Connect(function(value)
		if not run:IsAlive() then return end
		local frame
		if bounce then
			frame = target * CFrame.new(0, 0, -math.sin(value * math.pi) * Config.Camera.ArrivalBounceStrength)
		else
			frame = from:Lerp(target, value)
			if Config.Camera.HorizontalRotationEnabled then frame *= CFrame.Angles(0, math.rad(Config.Camera.HorizontalRotationDegrees) * math.sin(value * math.pi), 0) end
		end
		run.Camera.CFrame = frame
		end)
		table.insert(run.Connections,travelConnection)
	if not run:Tween(alpha, Config.Camera.TravelDuration, { Value = 1 }) then return end
	if Config.Camera.ArrivalBounceEnabled then
		bounce = true; alpha.Value = 0
		if not run:Tween(alpha, Config.Camera.ArrivalBounceDuration, { Value = 1 }) then return end
	end
	run.Camera.CFrame = target
		travelConnection:Disconnect()
	run.CameraDone = true
		Module.StartFloating(run,target)

end


function Module.Resolve(stage, mode)
 local folder = stage:FindFirstChild("TransCamera")
 local startName = Config.Camera.StartPart
 local endName = Config.Camera.Destinations[mode] or Config.Camera.Destinations.Default
 local from = folder and folder:FindFirstChild(startName)
 local target = folder and folder:FindFirstChild(endName)
 if not from or not from:IsA("BasePart") then return nil, nil, "CameraStartMissing:" .. startName end
 if not target or not target:IsA("BasePart") then return nil, nil, "CameraDestinationMissing:" .. endName end
 return from.CFrame, target.CFrame
end

function Module.Prepare(run, from)
 local camera = workspace.CurrentCamera
 assert(camera, "CameraMissing")
 run.Camera = camera
 run.CameraType = camera.CameraType
 run.CameraSubject = camera.CameraSubject
 run.CameraCFrame = camera.CFrame
 run.FieldOfView = camera.FieldOfView
 camera.CameraType = Enum.CameraType.Scriptable
 camera.CFrame = from
end

function Module.Cleanup(run)
 Module.StopFloating(run)
 if not run.Camera then return end
 pcall(function()
  run.Camera.CameraType = run.CameraType
  local subject = run.CameraSubject
  if not subject or not subject.Parent then
   local char = Players.LocalPlayer.Character
   subject = char and char:FindFirstChildOfClass("Humanoid")
  end
  run.Camera.CameraSubject = subject
  run.Camera.CFrame = run.CameraCFrame
  run.Camera.FieldOfView = run.FieldOfView
 end)
end

return Module
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="4329">
            <Properties>
              <string name="Name">EndCinematicHUD</string>
              <string name="Source"><![CDATA[--!nonstrict
local Players = game:GetService("Players")
local Config = require(game.ReplicatedStorage.Shared.EndCinematicConfig)
local Module = {}

function Module.Resolve()
 local gui = Players.LocalPlayer.PlayerGui:FindFirstChild("EndCinematicHUD")
 local panel = gui and gui:FindFirstChild("MainFrame")
 if not gui or not gui:IsA("ScreenGui") or not panel or not panel:IsA("CanvasGroup") then return nil, "PhysicalHUDMissing" end
 for _, name in ipairs({ "Title", "Subtitle", "WinnerNames", "WinningTeam", "Score", "ReturnButton", "RematchButton", "RematchCounter" }) do
  if not panel:FindFirstChild(name, true) then return nil, "HUDChildMissing:" .. name end
 end
 return gui
end

function Module.Prepare(run, gui, stop)
 run.HUD = gui
 run.HUDPanel = gui.MainFrame
 run.HUDEnabled = gui.Enabled
 run.HUDTransparency = gui.MainFrame.GroupTransparency
 run.HiddenHUDs = {}
 for _, object in ipairs(Players.LocalPlayer.PlayerGui:GetChildren()) do
  if object:IsA("ScreenGui") and object ~= gui and object.Name ~= "EndCinematicPreview" then
   run.HiddenHUDs[object] = object.Enabled; object.Enabled = false
  end
 end
 gui.Enabled = false
 gui.MainFrame.GroupTransparency = 1
 table.insert(run.Connections, gui.MainFrame.ReturnButton.Activated:Connect(function()
  if run:IsAlive() then stop() end
 end))
 table.insert(run.Connections, gui.Destroying:Connect(function() if run:IsAlive() then stop() end end))
end

function Module.Play(run, data, winners)
 if not run:IsAlive() then return end
 local panel = run.HUDPanel
 panel.ReturnButton.Active = true
 local won = data.LocalTeam == data.WinningTeam
 local draw = data.WinningTeam == "Draw"
 panel.Title.Text = draw and "EMPATE" or (won and "VICTORIA" or "DERROTA")
 panel.Title.TextColor3 = won and Color3.fromRGB(255, 207, 74) or Color3.fromRGB(255, 104, 115)
 panel.Subtitle.Text = draw and "EL DUELO TERMINÓ EN EMPATE" or (won and "GANASTE EL DUELO" or "PERDISTE EL DUELO")
 local names = {}
 for _, winner in ipairs(winners) do table.insert(names, winner.DisplayName) end
 -- Kept on one visual line, as in V1, but separately editable in Explorer.
 local line = panel.WinnerLine
 line.WinningTeam.Text = draw and "SIN GANADOR" or ("EQUIPO " .. data.WinningTeam .. "  ·  ")
 line.WinnerNames.Text = table.concat(names, ", ")
 local function fitNames()
  if not run:IsAlive() then return end
  local text = line.WinningTeam.Text .. line.WinnerNames.Text
  local width = game:GetService("TextService"):GetTextSize(text, 17, Enum.Font.GothamBold, Vector2.new(10000, 42)).X
  local size = math.min(17, math.max(8, 17 * line.AbsoluteSize.X / math.max(width, 1)))
  line.WinningTeam.TextSize = size
  line.WinnerNames.TextSize = size
 end
 fitNames()
 table.insert(run.Connections, line:GetPropertyChangedSignal("AbsoluteSize"):Connect(fitNames))
 panel.Score.Text = string.format("%d  —  %d", data.Score.Red, data.Score.Blue)
 local eligible = data.EligibleParticipantCount or (#winners * 2)
 panel.RematchButton.Text = string.format("REVANCHA (0/%d)", eligible)
 panel.RematchButton.Active = false
 panel.RematchButton.AutoButtonColor = false
 panel.RematchCounter.Text = "REVANCHA · PRÓXIMAMENTE"
 run.HUD.Enabled = true
 run:Tween(panel, Config.HUD.FadeDuration, { GroupTransparency = 0 })
end

function Module.Cleanup(run)
 if run.HUD and run.HUD.Parent then
  run.HUD.Enabled = false
  run.HUDPanel.GroupTransparency = run.HUDTransparency
 end
 for gui, enabled in pairs(run.HiddenHUDs or {}) do if gui.Parent then gui.Enabled = enabled end end
end
return Module
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="4330">
            <Properties>
              <string name="Name">EndCinematicParticles</string>
              <string name="Source"><![CDATA[--!nonstrict
local Config = require(game.ReplicatedStorage.Shared.EndCinematicConfig)
local Module = {}

function Module.Prepare(run, stage)
 local original = stage:FindFirstChild("Confeti")
 local effects = original and original:Clone() or Instance.new("Folder")
 effects.Name = "Particles"
 for _, object in ipairs(effects:GetDescendants()) do
  if object:IsA("LuaSourceContainer") or object:IsA("Sound") then object:Destroy()
  elseif object:IsA("ParticleEmitter") then object.Enabled = false; object:Clear()
  elseif object:IsA("BasePart") then
   object.Anchored = true; object.CanCollide = false; object.CanTouch = false; object.Transparency = 1
  end
 end
 effects.Parent = run.Container
 run.Effects = effects
 if original then
  for _, object in ipairs(original:GetDescendants()) do
   if object:IsA("ParticleEmitter") and object.Enabled then
    warn("[EndCinematic] Original emitter active outside preview: " .. object:GetFullName())
   end
  end
 end
end

function Module.Play(run)
 if not run:IsAlive() or not Config.Effects.ConfettiEnabled then return end
 for _, object in ipairs(run.Effects:GetDescendants()) do
  if object:IsA("ParticleEmitter") then
   object.Enabled = object.Rate > 0
   if object.Rate == 0 then object:Emit(object:GetAttribute("EmitCount") or Config.Effects.BurstCount) end
  end
 end
end

function Module.Stop(run)
 if not run.Effects then return end
 for _, object in ipairs(run.Effects:GetDescendants()) do
  if object:IsA("ParticleEmitter") then object.Enabled = false end
 end
end

function Module.Cleanup(run)
 Module.Stop(run)
 if run.Effects then run.Effects:Destroy(); run.Effects = nil end
end
return Module
]]></string>
