          <Properties>
            <string name="Name">PartyMatchController</string>
            <string name="Source"><![CDATA[--!nonstrict
local Players=game:GetService('Players')
local RS=game:GetService('ReplicatedStorage')
local Run=game:GetService('RunService')
local player=Players.LocalPlayer
local Config=require(RS.Shared.PartyMatchConfig)
local Controller={Name='PartyMatchController'}
local messages={NotLeader='Solo el líder puede realizar esta acción.',GroupTooLarge='Tu grupo supera el tamaño del equipo.',PlayerUnavailable='Un integrante está ocupado o no está listo.',QueueUnavailable='No se pudo actualizar la búsqueda. Reintentá en unos segundos.',QueueExpired='La búsqueda venció. Podés volver a buscar.',ModeUnavailable='Esta modalidad no está disponible.',MatchFound='Partida encontrada; ya no se puede cancelar.',Cancelled='Búsqueda cancelada.',Disconnected='Un integrante se desconectó.',TeleportFailed='No se pudo completar el traslado.',ReservationFailed='No se pudo reservar el servidor.',ReservationTimeout='La reserva venció.',ArrivalFailed='No llegaron todos los jugadores. Volvé al lobby para buscar otra partida.',DestinationLatency='La conexión al destino supera el límite. Volvé al lobby para reintentar.',DestinationUnavailable='El destino no está disponible.',Unavailable='Búsqueda no disponible en este servidor.',RateLimited='Esperá un momento.'}
function Controller:Notice(reason)
 self.Hud.Status.Text=messages[reason]or reason or '';self.MessageUntil=os.clock()+6
end
function Controller:Call(action,arg)
 if self.Pending then return end;self.Pending=true
 task.spawn(function()
  local ok,r=pcall(self.Remote.InvokeServer,self.Remote,action,arg);self.Pending=false
  if not ok or type(r)~='table'then self:Notice('QueueUnavailable');return end
  if r.State then self.Data=r end
  if r.Reason then self:Notice(r.Reason)end
  self:Render()
 end)
end
function Controller:Group()
 local social=self.Context:GetController('SocialPlayController');return social and social.Group
end
function Controller:InviteList()
 local list=self.Hud.InvitePanel.List
 local present={}
 local all=Players:GetPlayers();table.sort(all,function(a,b)return a.DisplayName:lower()<b.DisplayName:lower()end)
 local n=0;local g=self:Group();local leader=not g or g.Leader==player.UserId
 for _,p in ipairs(all)do if p~=player then
  n+=1;present[p.UserId]=true;local row=self.InviteRows[p.UserId]
  if not row then
   row=self.Hud.InviteTemplate:Clone();row.Name='Player_'..p.UserId;row:SetAttribute('PartyInviteRow',true)
   self.InviteRows[p.UserId]=row
   self.InviteConnections[p.UserId]=row.Invite.Activated:Connect(function()
    if row.Invite.Active then self.Context:GetController('SocialPlayController'):Invite('Group',p.UserId)end
   end)
  end
  row.LayoutOrder=n
  row.Avatar.Image='rbxthumb://type=AvatarHeadShot&id='..p.UserId..'&w=150&h=150'
  row.Username.Text=p.DisplayName..' (@'..p.Name..')'
  local available=leader and not p:GetAttribute('SocialGroupId')and not p:GetAttribute('MatchId')and not p:GetAttribute('PartyQueueTicket')and not player:GetAttribute('PartyQueueTicket')and(not g or #g.Members<4)
  row.Invite.Text=available and 'Invitar'or 'No disponible';row.Invite.Active=available;row.Invite.AutoButtonColor=available
  row.Visible=true;row.Parent=list
 end end
 for id,row in pairs(self.InviteRows)do if not present[id]then self.InviteConnections[id]:Disconnect();self.InviteConnections[id]=nil;row:Destroy();self.InviteRows[id]=nil end end
 self.Hud.InvitePanel.Empty.Visible=n==0
end
function Controller:Render()
 if not self.Hud then return end
 local g=self:Group();local members=g and g.Members or {{UserId=player.UserId,DisplayName=player.DisplayName}}
 local leader=not g or g.Leader==player.UserId;local d=self.Data or {};local state=d.State or 'Idle'
 local busy=state~='Idle'or player:GetAttribute('MatchId')~=nil or player:GetAttribute('ResultsSessionId')~=nil or player:GetAttribute('PartyQueueTicket')~=nil
 local dock=self.Hud.Dock;dock.Visible=true;dock.Count.Text=#members..' / 4'
 for i=1,4 do local slot=dock.Members['Slot'..i];local m=members[i];slot.Visible=m~=nil
  if m then slot.Avatar.Image='rbxthumb://type=AvatarHeadShot&id='..m.UserId..'&w=150&h=150';slot.Caption.Text=m.UserId==player.UserId and 'TÚ'or m.DisplayName;slot.Leader.Visible=g and m.UserId==g.Leader or not g end
 end
 dock.Members.Add.Visible=#members<4;dock.Members.Add.Active=leader and not busy;dock.Members.Add.AutoButtonColor=dock.Members.Add.Active
 dock.Play.Active=leader and not busy and d.Enabled==true;dock.Play.AutoButtonColor=dock.Play.Active
 dock.Play.Text=state=='Searching'and 'Buscando…'or not leader and 'Esperando al líder'or busy and 'En partida / traslado'or 'Jugar'
 dock.Leave.Visible=g~=nil;dock.Leave.Active=not busy
 local search=self.Hud.Search;search.Visible=state=='Searching'or state=='Matched'or state=='Teleporting'
 search.Title.Text=state=='Searching'and 'Buscando jugadores…'or state=='Teleporting'and 'Viajando a la partida…'or 'Partida encontrada'
 search.Mode.Text=d.Mode or '';search.Cancel.Visible=d.CanCancel==true
 self.Hud.Return.Visible=d.CanReturn==true;self.Hud.Return.Active=leader
 for _,mode in ipairs(Config.Modes)do local b=self.Hud.ModePanel.Modes[mode]
  local allowed=#members<=tonumber(mode:sub(1,1))and leader and not busy and d.Enabled==true and d.Modes and d.Modes[mode]==true
  b.Active=allowed;b.AutoButtonColor=allowed;b.Hint.Text=allowed and 'Buscar partida'or #members>tonumber(mode:sub(1,1))and 'Grupo demasiado grande'or 'No disponible'
  b.BackgroundTransparency=allowed and 0 or .5
 end
 if busy then self.Hud.ModePanel.Visible=false;self.Hud.InvitePanel.Visible=false end
end
function Controller:Init(context)
 self.Context=context;self.Connections={};self.InviteConnections={};self.InviteRows={}
 self.Hud=player:WaitForChild('PlayerGui'):WaitForChild('PartyMatchHUD',15);assert(self.Hud,'PartyMatchHUD missing')
 local folder=RS:WaitForChild('Remotes'):WaitForChild('PartyMatch',15);assert(folder,'PartyMatch remote missing')
 self.Remote=folder:WaitForChild('Request');self.Updated=folder:WaitForChild('Updated')
 local function bind(button,callback)table.insert(self.Connections,button.Activated:Connect(callback))end
 self.Hud.Enabled=true;self.Hud.InvitePanel.Visible=false;self.Hud.ModePanel.Visible=false;self.Hud.Search.Visible=false
 bind(self.Hud.Dock.Members.Add,function()if self.Hud.Dock.Members.Add.Active then self:InviteList();self.Hud.InvitePanel.Visible=true end end)
 bind(self.Hud.Dock.Play,function()if self.Hud.Dock.Play.Active then self:Render();self.Hud.ModePanel.Visible=true end end)
 bind(self.Hud.Dock.Leave,function()if self.Hud.Dock.Leave.Active then self.Context:GetController('SocialPlayController'):Send('Leave')end end)
 for _,name in ipairs({'InvitePanel','ModePanel'})do bind(self.Hud[name].Close,function()self.Hud[name].Visible=false end)end
 for _,mode in ipairs(Config.Modes)do bind(self.Hud.ModePanel.Modes[mode],function()if self.Hud.ModePanel.Modes[mode].Active then self:Call('Join',mode)end end)end
 bind(self.Hud.Search.Cancel,function()self:Call('Cancel')end)
 bind(self.Hud.Return,function()self:Call('Return')end)
 table.insert(self.Connections,self.Updated.OnClientEvent:Connect(function(s)self.Data=s;if s.Reason then self:Notice(s.Reason)end;self:Render()end))
end
function Controller:Start()
 if not self.Hud then return end;self:Call('State');self:Render()
 local elapsed,frames=0,0
 table.insert(self.Connections,Run.RenderStepped:Connect(function(dt)
  elapsed+=dt;frames+=1;if elapsed<1 then return end
  local fps=math.floor(frames/elapsed+.5);elapsed=0;frames=0
  local ok,ping=pcall(player.GetNetworkPing,player);local d=self.Data or {}
  self.Hud.Telemetry.Text=string.format('%d FPS  ·  %s ms  ·  Servidor %s  ·  v%d',fps,ok and tostring(math.floor(ping*1000+.5))or '—',d.Server or '…',d.Version or 0)
  self.Hud.Telemetry:SetAttribute('ServerRegion',d.Region or 'No disponible')
  self.Hud.Search.Timer.Text=string.format('%d:%02d',math.floor(math.max(0,workspace:GetServerTimeNow()-(d.Since or 0))/60),math.floor(math.max(0,workspace:GetServerTimeNow()-(d.Since or 0)))%60)
  if self.MessageUntil and os.clock()>self.MessageUntil then self.Hud.Status.Text=''end
  self:Render();if self.Hud.InvitePanel.Visible then self:InviteList()end
 end))
end
function Controller:Destroy()
 for _,c in ipairs(self.Connections or {})do c:Disconnect()end
 for _,c in pairs(self.InviteConnections or {})do c:Disconnect()end
 self.Hud=nil
end
return Controller
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="4290">
          <Properties>
            <string name="Name">PlayerHUDController</string>
            <string name="Source"><![CDATA[--!strict
-- PlayerHUDController
-- Controlador del HUD global del jugador (Avatar, Nombre, Coins, Wins, Losses).
-- Se enlaza con StarterGui.PlayerHUD (replicado a PlayerGui.PlayerHUD)
-- y escucha las actualizaciones autoritativas emitidas por PlayerService.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Types = require(ReplicatedStorage.Shared.Types)

type PlayerData = Types.PlayerData

local localPlayer = Players.LocalPlayer

local PlayerHUDController = {}
PlayerHUDController.Name = "PlayerHUDController"

-- Referencias a instancias de PlayerGui.PlayerHUD
PlayerHUDController._hud = nil :: ScreenGui?
PlayerHUDController._profileCard = nil :: Frame?
PlayerHUDController._avatar = nil :: ImageLabel?
PlayerHUDController._playerName = nil :: TextLabel?
PlayerHUDController._winsLabel = nil :: TextLabel?
PlayerHUDController._lossesLabel = nil :: TextLabel?
PlayerHUDController._killsLabel = nil :: TextLabel?
PlayerHUDController._coinsContainer = nil :: Frame?
PlayerHUDController._coinsLabel = nil :: TextLabel?

-- Estado interno
PlayerHUDController._currentCoins = 0
PlayerHUDController._currentWins = 0
PlayerHUDController._currentLosses = 0
PlayerHUDController._currentKills = 0
PlayerHUDController._coinTween = nil :: Tween?
PlayerHUDController._coinAnimValue = nil :: NumberValue?
PlayerHUDController._origCoinsContainerSize = nil :: UDim2?

function PlayerHUDController:Init(context: any)
	self:_bindHUD()
end

function PlayerHUDController:Start(context: any)
	self:_setupIdentity()
	self:_connectRemotes()
	print("[PlayerHUDController] HUD global iniciado y enlazado a PlayerGui.PlayerHUD")
end

function PlayerHUDController:_bindHUD()
	local playerGui = localPlayer:WaitForChild("PlayerGui")
	local hud = playerGui:WaitForChild("PlayerHUD", 15) :: ScreenGui?
	if not hud then
		warn("[PlayerHUDController] No se encontro PlayerHUD en PlayerGui")
		return
	end
	self._hud = hud

	local profileCard = hud:WaitForChild("ProfileCard", 10) :: Frame?
	if not profileCard then
		warn("[PlayerHUDController] No se encontro ProfileCard en PlayerHUD")
		return
	end
	self._profileCard = profileCard

	self._avatar = profileCard:FindFirstChild("Avatar") :: ImageLabel?
	self._playerName = profileCard:FindFirstChild("PlayerName") :: TextLabel?
	self._winsLabel = profileCard:FindFirstChild("WinsLabel") :: TextLabel?
	self._lossesLabel = profileCard:FindFirstChild("LossesLabel") :: TextLabel?
	self._killsLabel = profileCard:FindFirstChild("KillsLabel") :: TextLabel?

	local coinsContainer = profileCard:FindFirstChild("CoinsContainer") :: Frame?
	if coinsContainer then
		self._coinsContainer = coinsContainer
		self._origCoinsContainerSize = coinsContainer.Size
		self._coinsLabel = coinsContainer:FindFirstChild("CoinsLabel") :: TextLabel?
	end

	-- NumberValue auxiliar para interpolación suave de Coins
	local animVal = Instance.new("NumberValue")
	animVal.Value = 0
	animVal.Changed:Connect(function(val: number)
		if self._coinsLabel then
			self._coinsLabel.Text = string.format("%d", math.floor(val + 0.5))
		end
	end)
	self._coinAnimValue = animVal
end

function PlayerHUDController:_setupIdentity()
	-- Nombre del jugador
	if self._playerName then
		self._playerName.Text = localPlayer.DisplayName or localPlayer.Name
	end

	-- Avatar circular del jugador usando thumbnail oficial de Roblox
	if self._avatar then
		local thumbType = Enum.ThumbnailType.HeadShot
		local thumbSize = Enum.ThumbnailSize.Size150x150
		task.spawn(function()
			local content, isReady = Players:GetUserThumbnailAsync(localPlayer.UserId, thumbType, thumbSize)
			if self._avatar then
				self._avatar.Image = content
			end
		end)
	end

	-- Estado inicial por defecto en UI
	self:_renderData({
		Coins = self._currentCoins,
		Wins = self._currentWins,
		Losses = self._currentLosses,
	}, false)
end

function PlayerHUDController:_connectRemotes()
	local remotesFolder = ReplicatedStorage:WaitForChild("Remotes", 10)
	if not remotesFolder then
		warn("[PlayerHUDController] Carpeta Remotes no encontrada en ReplicatedStorage")
		return
	end

	local playerRemotes = remotesFolder:WaitForChild("Player", 10)
	if not playerRemotes then
		warn("[PlayerHUDController] Carpeta Remotes.Player no encontrada")
		return
	end

	local dataUpdated = playerRemotes:WaitForChild("DataUpdated", 10) :: RemoteEvent?
	if not dataUpdated then
		warn("[PlayerHUDController] RemoteEvent DataUpdated no encontrado")
		return
	end

	dataUpdated.OnClientEvent:Connect(function(data: PlayerData)
		if type(data) ~= "table" then
			return
		end
		self:_renderData(data, true)
	end)
end

function PlayerHUDController:_renderData(data: PlayerData, animateChanges: boolean)
	local newCoins = if typeof(data.Coins) == "number" then data.Coins else self._currentCoins
	local newWins = if typeof(data.Wins) == "number" then data.Wins else self._currentWins
	local newLosses = if typeof(data.Losses) == "number" then data.Losses else self._currentLosses
	local newKills = if typeof(data.Kills) == "number" then data.Kills else self._currentKills

	-- Actualizar Wins
	if self._winsLabel then
		self._winsLabel.Text = string.format("Wins: %d", newWins)
	end
	self._currentWins = newWins

	-- Actualizar Losses
	if self._lossesLabel then
		self._lossesLabel.Text = string.format("Losses: %d", newLosses)
	end
	self._currentLosses = newLosses

	-- Actualizar Kills (si KillsLabel existe en la UI)
	if self._killsLabel then
		self._killsLabel.Text = string.format("Kills: %d", newKills)
	end
	self._currentKills = newKills

	-- Actualizar Coins con animación si aumenta
	local oldCoins = self._currentCoins
	self._currentCoins = newCoins

	if animateChanges and newCoins > oldCoins and self._coinAnimValue and self._coinsLabel then
		self:_animateCoinsIncrease(oldCoins, newCoins)
	else
		if self._coinAnimValue then
			self._coinAnimValue.Value = newCoins
		end
		if self._coinsLabel then
			self._coinsLabel.Text = string.format("%d", newCoins)
		end
	end
end

function PlayerHUDController:_animateCoinsIncrease(fromVal: number, toVal: number)
	if not self._coinAnimValue then
		return
	end

	if self._coinTween then
		self._coinTween:Cancel()
		self._coinTween = nil
	end

	self._coinAnimValue.Value = fromVal

	-- Interpolación de número durante 0.25 segundos
	local tweenInfo = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local tween = TweenService:Create(self._coinAnimValue, tweenInfo, { Value = toVal })
	self._coinTween = tween
	tween:Play()

	-- Feedback visual sutil (pulse) en CoinsContainer
	if self._coinsContainer and self._origCoinsContainerSize then
		local origSize = self._origCoinsContainerSize
		local popSize = UDim2.new(
			origSize.X.Scale,
			origSize.X.Offset + 8,
			origSize.Y.Scale,
			origSize.Y.Offset + 4
		)

		local popTween = TweenService:Create(
			self._coinsContainer,
			TweenInfo.new(0.12, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
			{ Size = popSize }
		)
		local returnTween = TweenService:Create(
			self._coinsContainer,
			TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
			{ Size = origSize }
		)

		popTween.Completed:Connect(function()
			returnTween:Play()
		end)
		popTween:Play()
	end
end

return PlayerHUDController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="4291">
          <Properties>
            <string name="Name">PremiumShopController</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Binds permanent Edit templates. Never grants currency/items or acknowledges receipts.
local Players=game:GetService("Players");local RS=game:GetService("ReplicatedStorage")
local Tween=game:GetService("TweenService");local Marketplace=game:GetService("MarketplaceService")
local Player=Players.LocalPlayer
local PurchaseFlow=require(script.Parent.Parent.PremiumShop.PremiumPurchaseFlow)
local Reserved=require(RS.Shared.PremiumShop.PlaceholderProductIds)
local Controller={}
local function numberText(value)
 return (tostring(value):reverse():gsub('(%d%d%d)','%1,'):reverse():gsub('^,',''))
end
function Controller:CoinPresentation(product)
 local provisional=product.PriceRobux==nil and product.IsPlaceholder==true and product.SuggestedRobux~=nil
 local price=product.PriceRobux or (provisional and product.SuggestedRobux)
 return {Title=numberText(product.Rewards.Coins),Content='COINS GARANTIZADAS',
  Price=price and(numberText(price)..' ROBUX'..(provisional and ' · PRECIO PROVISIONAL'or ''))or 'PRECIO NO DISPONIBLE',
  Buy=price and(numberText(price)..' ROBUX')or 'PRÓXIMAMENTE',
  Status=provisional and 'VISTA PREVIA' or nil,Provisional=provisional}
end
local messages={PurchasesDisabled="Compras con Robux deshabilitadas.",ContentsPending="Contenido pendiente de aprobación.",ProductIdPending="Producto Roblox sin configurar.",
 DuplicatePolicyPending="Política de duplicados pendiente.",ApprovalPending="Venta pendiente de aprobación.",ProductDisabled="Producto deshabilitado.",DurableBackendPending="Persistencia durable pendiente.",
 PaidRandomItemsRestricted="Artículos aleatorios pagados restringidos por Roblox.",PolicyUnavailable="No se pudo verificar elegibilidad.",CommercialApprovalPending="Probabilidades y venta pendientes.",RateLimited="Esperá un momento y reintentá.",
 PlaceholderProduct="No configurado: ProductId provisional.",TestingEnvironment="Entorno de prueba: sin cobros.",TestingOrUnapprovedEnvironment="Entorno sin compras productivas.",
 ProfileLifecycleIntegrationPending="Integración durable de perfiles pendiente.",PriceUnavailable="Precio de Roblox no disponible.",PriceChanged="Cambió el precio: revisalo antes de volver a comprar.",
 ViewOddsFirst="Consultá las probabilidades actuales antes de comprar.",OddsChanged="Cambió el stock o la probabilidad. Volvé a consultar.",PersistenceTemporaryError="Error temporal de persistencia; la compra sigue pendiente."}
local categories={{"Coins","COINS","C"}}
function Controller:Init(context)self.Context=context;self.Connections={};self.Cards={};self.CardConnections={};self.Opened=false;self.Generation=0;self.Category="Coins"end
function Controller:IsBlocked()
 local ending=self.Context:GetController("EndCinematicController");local opening=self.Context:GetController("CrateStandCinematicController")
 return Player:GetAttribute("MatchId")~=nil or Player:GetAttribute("ResultsSessionId")~=nil
  or ending and ending:IsPlaying()or opening and opening:IsPlaying()
end
function Controller:_call(action,args)
 if not self.Request then return {Ok=false,Code="NoResponse"}end
 local ok,result=pcall(self.Request.InvokeServer,self.Request,action,args or {})
 return if ok and type(result)=="table"then result else {Ok=false,Code="NoResponse"}
end
function Controller:_preview(viewport,product)
 local world=viewport:FindFirstChildWhichIsA("WorldModel");local camera=viewport:FindFirstChildWhichIsA("Camera")
 if not world or not camera then return end
 for _,obj in ipairs(world:GetChildren())do obj:Destroy()end
 local folder=RS:FindFirstChild("PremiumShopPreviews")
 local modelName=product.PreviewModel or(if product.Category=="Coins"then "CoinsDisplay"else "ComboDisplay")
 local source=(folder and folder:FindFirstChild(modelName))or RS.CrateEffects:FindFirstChild(modelName)
 if not source then return end
 local model=source:Clone()
 for _,obj in ipairs(model:GetDescendants())do
  if obj:IsA("BasePart")then obj.Anchored=true;obj.CanCollide=false;obj.CanTouch=false;obj.CanQuery=false
  elseif obj:IsA("LuaSourceContainer")then obj:Destroy()end
 end
 model.Parent=world;model:PivotTo(CFrame.new())
 local extent=model:GetExtentsSize();local size=math.max(extent.X,extent.Y,extent.Z)
 local aspect=math.max(.5,viewport.AbsoluteSize.X/math.max(1,viewport.AbsoluteSize.Y))
 camera.FieldOfView=35;camera.CFrame=CFrame.lookAt(Vector3.new(size*.8,size*.55,size*2.1/math.min(1,aspect)),Vector3.zero)
 viewport.CurrentCamera=camera
end
function Controller:_clear()
 for _,c in ipairs(self.CardConnections)do c:Disconnect()end;table.clear(self.CardConnections)
 for _,c in ipairs(self.Cards)do
  if not c:GetAttribute('PremiumPersistentCard') then c:Destroy()end
 end
 table.clear(self.Cards)
end
function Controller:_coinCardFor(product)
 if not self.Main then return nil end
 local container = self.Main:FindFirstChild("Paquetes de monedas")
 if not container then return nil end
 for _, card in ipairs(container:GetChildren()) do
  if card:IsA("GuiObject") and card:GetAttribute("PremiumProductId") == product.Id then
   return card
  end
 end
 for _, card in ipairs(container:GetChildren()) do
  if card:IsA("GuiObject") and card.Name:find(tostring(product.Rewards.Coins or "")) then
   return card
  end
 end
 return nil
end
function Controller:_cardFor(product)
 if product.Category == 'Coins' then
  return self:_coinCardFor(product)
 end
 return self.Main.Catalog.ProductCardTemplate:Clone()
end
function Controller:_layout()
 if not self.Main then return end
 local width=self.Main.AbsoluteSize.X
 if self.Main:FindFirstChild("Catalog") and self.Main.Catalog:FindFirstChild("UIGridLayout") then
  local grid=self.Main.Catalog.UIGridLayout
  grid.CellSize=UDim2.new(if width<620 then 1 else .49,if width<620 then -4 else -6,0,224)
 end
 if self.Main:FindFirstChild("Tabs") then
  for _,tab in ipairs(self.Main.Tabs:GetChildren())do if tab:IsA("TextButton")then tab.TextSize=if width<480 then 11 else 14 end end
 end
end
function Controller:_render()
 if not self.Main then return end;self:_clear()
 local coinsContainer = self.Main:FindFirstChild("Paquetes de monedas")
 local isCoins = (self.Category == "Coins")
 if coinsContainer then coinsContainer.Visible = isCoins end
 if self.Main:FindFirstChild("Catalog") then self.Main.Catalog.Visible = not isCoins end

 for _,card in ipairs(self.Main.Catalog:GetChildren())do
  if card:IsA('GuiObject')and card:GetAttribute('PremiumPersistentCard') then card.Visible=false end
 end
 local count=0
 for _,product in ipairs(self.Products or {})do if product.Category==self.Category then
  local card=self:_cardFor(product);if not card then continue end
  count+=1;card.Name="Product_"..product.Id;card.Visible=true
  if not card:GetAttribute('PremiumPersistentCard') then
   card.LayoutOrder=product.SortOrder or count
   card.Title.Text=product.DisplayName;card.Description.Text=product.Description
   card.Content.Text=if product.Category=="Combos"then "VER CONTENIDO GARANTIZADO"else "MODELO PROVISIONAL · ODDS PENDIENTES"
   card.Price.Text=if product.PriceRobux~=nil then tostring(product.PriceRobux).." ROBUX"else "ROBUX · SIN CONFIGURAR"
   card.Status.Text=messages[product.ConfigurationStatus]or messages[product.Status]or "Venta no habilitada"
   card.Buy.Active=product.PurchaseAllowed==true and product.PriceRobux~=nil;card.Buy.AutoButtonColor=card.Buy.Active
   card.Buy.Text=if card.Buy.Active then "COMPRAR"else "COMPRAR · BLOQUEADO"
   card.Buy.BackgroundTransparency=if card.Buy.Active then 0 else .5
   card.Parent=self.Main.Catalog;table.insert(self.Cards,card)
   self:_preview(card.Preview,product)
   table.insert(self.CardConnections,card.Activated:Connect(function()self:Details(product)end))
   table.insert(self.CardConnections,card.Buy.Activated:Connect(function()self:Details(product)end))
  else
   local view=self:CoinPresentation(product)
   local priceLabel=card:FindFirstChild("Precio provisional",true) or card:FindFirstChild("Precio",true)
   if priceLabel and priceLabel:IsA("TextLabel") then
    local price=product.PriceRobux or (view.Provisional and product.SuggestedRobux)
    priceLabel.Text=if price then (numberText(price).." ROBUX") else view.Price
   end
   local descLabel=card:FindFirstChild("Descripción",true)
   if descLabel and descLabel:IsA("TextLabel") then
    descLabel.Visible=false
   end
   local buyBtn=card:FindFirstChild("Comprar",true) or card:FindFirstChild("Botón de compra",true)
   if buyBtn and (buyBtn:IsA("GuiButton") or buyBtn:FindFirstChildWhichIsA("GuiButton")) then
    local btn = if buyBtn:IsA("GuiButton") then buyBtn else buyBtn:FindFirstChildWhichIsA("GuiButton")
    table.insert(self.CardConnections,btn.Activated:Connect(function()
     if product.PurchaseAllowed==true and product.PriceRobux~=nil and not self.Purchasing and not self:IsBlocked() then
      self.Purchasing=true;self.BuyingKey=product.Id
      task.spawn(function()
       self.Flow:Begin(product);self.Purchasing=false
       if self.Flow.Pending then self:_pollReceipt()end
      end)
     else
      self:Details(product)
     end
    end))
   end
   local trigger=card:FindFirstChildWhichIsA("GuiButton")
   if trigger and trigger~=buyBtn and (not buyBtn or not trigger:IsDescendantOf(buyBtn)) then
    table.insert(self.CardConnections,trigger.Activated:Connect(function()self:Details(product)end))
   end
  end
 end end
 for _,row in ipairs(categories)do
  local tab=self.Main.Tabs:FindFirstChild(row[1])
  if tab and tab:IsA("GuiObject") then
   tab.BackgroundColor3=if self.Category==row[1]then Color3.fromRGB(94,54,176)else Color3.fromRGB(20,28,58)
  end
 end
 local cabecera=self.Main:FindFirstChild("Cabecera de la tienda")
 if cabecera then
  local bCombos=cabecera:FindFirstChild("Boton-Combos")
  local bCajas=cabecera:FindFirstChild("Boton-Cajas")
  if bCombos then bCombos.Visible=false end
  if bCajas then bCajas.Visible=false end
  local bCoins=cabecera:FindFirstChild("Boton-Coins")
  if bCoins then
   bCoins.AnchorPoint=Vector2.new(0.5, 0.5)
   bCoins.Position=UDim2.new(0.5, 0, 0.860294104, 0)
   local tabFrame=bCoins:FindFirstChild("Pestaña de categoría") or bCoins
   local stroke=tabFrame:FindFirstChildWhichIsA("UIStroke")
   if stroke then
    stroke.Color=Color3.fromRGB(255,220,100)
    stroke.Thickness=2.5
   end
  end
 end
 self:_layout()
end
local function contents(product)
 local r=product.Rewards;local lines={}
 if r.Coins>0 then table.insert(lines,tostring(r.Coins).." Coins garantizadas")end
 for _,item in ipairs(r.Crates)do table.insert(lines,tostring(item.Quantity).." × caja "..item.CrateId.." cerrada (contenido aleatorio)")end
 for _,item in ipairs(r.Slaps)do table.insert(lines,"Slap garantizado: "..item.SlapId.." ["..item.VariationId.."]")end
 for _,id in ipairs(r.KillEffects)do table.insert(lines,"Kill Effect garantizado: "..id)end
 if #lines==0 then table.insert(lines,"Contenidos sin configurar. Este borrador no se puede comprar.")end
 table.insert(lines,"\nDuplicados: "..(({OncePerPlayer="compra única por jugador",RestrictOwned="bloqueado si ya poseés un premio permanente",RepeatableNoCompensation="repetible; sin compensación por duplicados",Unspecified="política pendiente"})[product.DuplicatePolicy]or "política pendiente"))
 if product.HasRandomContents then table.insert(lines,"\n"..product.OddsNotice)end
 if product.SuggestedRobux then
  if product.Category=='Coins'and product.IsPlaceholder then
   table.insert(lines,'\nPrecio previsto: '..numberText(product.SuggestedRobux)..' Robux. Compras todavía no disponibles.')
  else table.insert(lines,"\nPrecio sugerido para Creator Hub: "..product.SuggestedRobux.." Robux. NO es el precio de compra; Roblox determina el precio real.")end
 end
 return table.concat(lines,"\n")
end
function Controller:Details(product)
 if product.HasRandomContents then product.QuoteTokens=nil end
 self.Selected=product;local details=self.Main.Details;details.Visible=true
 details.Title.Text=product.DisplayName;details.Scroll.Content.Text=contents(product)
 details.Status.Text=messages[product.ConfigurationStatus]or messages[product.Status]or "Venta no habilitada"
 details.Buy.Text=if product.PriceRobux then "COMPRAR · "..product.PriceRobux.." ROBUX"else "COMPRAR · PRODUCTO SIN CONFIGURAR"
 if product.Category=='Coins'and product.IsPlaceholder then
  local view=self:CoinPresentation(product)
  details.Title.Text=view.Title..' Coins';details.Status.Text='Vista previa: compras todavía no disponibles.'
  details.Buy.Text=view.Buy..' · PRÓXIMAMENTE'
 end
 details.Buy.Active=product.PurchaseAllowed==true and product.PriceRobux~=nil and(not product.HasRandomContents or product.QuoteTokens~=nil)and not(self.Flow and(self.Flow.Pending or self.Flow.Busy));details.Buy.AutoButtonColor=details.Buy.Active;details.Buy.BackgroundTransparency=if details.Buy.Active then 0 else .55
 details.ViewCrate.Visible=product.CrateId~=nil;details.ViewCrate.Text="VER INVENTARIO / APERTURA"
 local token=self.Generation
 if product.HasRandomContents then task.spawn(function()
  task.wait(.55);if token~=self.Generation or self.Selected~=product or not self.Opened then return end
  local result=self:_call("Odds",{Id=product.Id})
  if token~=self.Generation or self.Selected~=product or not self.Opened then return end
  local lines={contents(product),"\nPROBABILIDADES ACTUALES POR RECOMPENSA"}
  if result.Ok then
   local tokens={};local valid=true
   for crateId,quote in pairs(result.Quotes)do
    table.insert(lines,"\n"..crateId)
    if quote.Ok then
     tokens[crateId]=quote.Token
     for _,outcome in ipairs(quote.Outcomes)do table.insert(lines,string.format("%s: %.8g %%",outcome.DisplayName,outcome.Percent))end
     for _,excluded in ipairs(quote.ExcludedOutcomes or {})do table.insert(lines,excluded.DisplayName..": excluido ("..excluded.Reason..")")end
    else valid=false;table.insert(lines,messages[quote.Code]or quote.Code)end
   end
   product.QuoteTokens=if valid and next(tokens)then tokens else nil
   details.Buy.Active=product.PurchaseAllowed==true and product.PriceRobux~=nil and product.QuoteTokens~=nil and not self.Flow.Pending
  else table.insert(lines,messages[result.Code]or "No se pudo consultar. Reabrí el detalle para reintentar.")end
  details.Scroll.Content.Text=table.concat(lines,"\n")
 end)end
end
function Controller:Open()
 if not self.Main or self:IsBlocked()then return end
 self.Generation+=1;local token=self.Generation;self.Opened=true
 local navigation=self.Context:GetController('WindowNavigationController')
 local shop=self.Context:GetController("ShopController");if shop and not navigation then shop:Close()end
 local crate=self.Context:GetController("CrateController");if crate and crate._panel and not navigation then crate._panel.Visible=false end
 self.Hud.Enabled=true;self.Main.Visible=true;self.Main.Details.Visible=false;self.Main.OpenScale.Scale=.94
 Tween:Create(self.Main.OpenScale,TweenInfo.new(.18,Enum.EasingStyle.Quad),{Scale=1}):Play()
 self.Main.Banner.Text="Cargando catálogo…"
 task.spawn(function()
  local result=self:_call("Catalog")
  if token~=self.Generation or not self.Opened then return end
  if not result.Ok then self.Main.Banner.Text=messages[result.Code]or "Catálogo no disponible. Cerrá y reintentá.";return end
  self.Products=result.Products;self.CrateProducts=result.CrateProducts;self.Category=result.DefaultCategory or "Coins"
  self.Main.Banner.Text=if result.PurchasesEnabled then "TIENDA PREMIUM · PRECIOS DE ROBLOX"else "VISTA PREVIA · COMPRAS ROBUX DESHABILITADAS"
  if not result.Policy.RandomAllowed then self.Main.Banner.Text..=" · Aleatorios restringidos o sin verificar"end
  self:_render()
  for _,p in ipairs(self.Products)do
   if p.CommercialVerified and p.IsPlaceholder==false then
    local price,why=self.Flow:Price(p);p.PriceRobux=price
    if not price then p.PurchaseAllowed=false;p.Status=why;warn("[PremiumShop] Precio no disponible: "..p.Id)end
   end
  end
  if token~=self.Generation or not self.Opened then return end
  self:_render();task.wait(.55)
  local status=self:_call("Status");if status.Ok then self.Flow:Status(status.Receipts or {})end
 end)
end
function Controller:Close()
 local navigation=self.Context and self.Context:GetController('WindowNavigationController');if navigation then navigation:Forget('Premium')end
 if self.Flow then self.Flow:CancelAuthorization()end
 self.Generation+=1;self.Opened=false;self.Selected=nil;self:_clear()
 if self.Hud then self.Hud.Enabled=false;self.Main.Visible=false;self.Main.Details.Visible=false end
end
function Controller:_purchaseState(state,extra)
 local labels={Processing="Consultando compra…",Purchasing="Comprando…",AwaitingConfirmation="Esperando confirmación del servidor…",Credited="Compra acreditada por el servidor.",TemporaryError="Error temporal.",Restricted="Producto restringido.",Available="Disponible.",Unavailable="No disponible."}
 if not self.Main then return end
 local text=labels[state]or state
 if type(extra)=="string"and messages[extra]then text..=" "..messages[extra]end
 self.Main.Banner.Text=text
 if self.Selected and(self.Selected.Id==self.BuyingKey or state=="Credited"and self.Selected.Id==extra)then
  self.Main.Details.Status.Text=text
  if state=="Purchasing"and type(extra)=="number"then self.Main.Details.Buy.Text="COMPRAR · "..extra.." ROBUX"end
  if state=="Credited"and self.Selected.DuplicatePolicy~="RepeatableNoCompensation"then self.Selected.PurchaseAllowed=false end
  if extra=="PriceChanged"and self.Selected.PriceRobux then self.Main.Details.Buy.Text="COMPRAR · "..self.Selected.PriceRobux.." ROBUX"end
  self.Main.Details.Buy.Active=(state=="Available"or state=="Credited"or state=="TemporaryError")and self.Selected.PurchaseAllowed==true and self.Selected.PriceRobux~=nil and not(self.Flow.Pending or self.Flow.Busy)
 end
end
function Controller:_pollReceipt()
 if self.Polling then return end;self.Polling=true
 task.spawn(function()
  for _=1,20 do
   task.wait(2);if self.Destroyed or not self.Flow.Pending then break end
   local status=self:_call("Status");if status.Ok then self.Flow:Status(status.Receipts or {})end
  end
  self.Polling=false
 end)
end
function Controller:Start()
 task.spawn(function()
  local pg=Player:WaitForChild("PlayerGui");self.Hud=pg:WaitForChild("PremiumShopHUD",15)
  local mainHUD=pg:WaitForChild("PlayerHUD",15);local remote=RS:WaitForChild("Remotes"):WaitForChild("PremiumShop",15)
  if not self.Hud or not mainHUD or not remote then warn("[PremiumShop] Missing Edit resources");return end
  self.Request=remote:WaitForChild("Request",15);self.Main=self.Hud.MainFrame
  self.Flow=PurchaseFlow.new(Marketplace,Player,function(action,args)return self:_call(action,args)end,function(state,extra)self:_purchaseState(state,extra)end,nil,Reserved)
  local delivery=remote:WaitForChild("Delivery",15)
  if delivery then table.insert(self.Connections,delivery.OnClientEvent:Connect(function(receipt)self.Flow:Delivery(receipt)end))end
  table.insert(self.Connections,Marketplace.PromptProductPurchaseFinished:Connect(function(uid,pid,bought)self.Flow:PromptClosed(uid,pid,bought)end))
  self:Close()
  local button=mainHUD:WaitForChild("PremiumShopButton",15);if not button then return end
  table.insert(self.Connections,button.Activated:Connect(function()if self.Opened and self.Main.Visible then self:Close()else self:Open()end end))
  for _, desc in ipairs(self.Main:GetDescendants()) do
   if desc.Name == "Close" and desc:IsA("GuiButton") and not desc:IsDescendantOf(self.Main.Details) then
    table.insert(self.Connections, desc.Activated:Connect(function() self:Close() end))
   end
  end
  if self.Main:FindFirstChild("Details") and self.Main.Details:FindFirstChild("Close") then
   table.insert(self.Connections,self.Main.Details.Close.Activated:Connect(function()self.Main.Details.Visible=false;self.Selected=nil end))
  end
  for _,row in ipairs(categories)do
   local tab=self.Main.Tabs:FindFirstChild(row[1])
   if tab and tab:IsA("GuiButton") then
    table.insert(self.Connections,tab.Activated:Connect(function()self.Category=row[1];self.Main.Details.Visible=false;self:_render()end))
   end
  end
  table.insert(self.Connections,self.Main.Details.Buy.Activated:Connect(function()
   local p=self.Selected;if not p or not p.PurchaseAllowed or self:IsBlocked()or self.Purchasing then return end
   self.Purchasing=true;self.BuyingKey=p.Id
   task.spawn(function()
    self.Flow:Begin(p);self.Purchasing=false
    if self.Flow.Pending then self:_pollReceipt()end
   end)
  end))
  table.insert(self.Connections,self.Main.Details.ViewCrate.Activated:Connect(function()
   local p=self.Selected;local crate=self.Context:GetController("CrateController");if not p or not p.CrateId or not crate or self:IsBlocked()then return end
   crate:SetCatalog(self.CrateProducts or {});if not self.Context:GetController('WindowNavigationController')then self:Close()end;crate:ShowCrate(p.CrateId)
  end))
  table.insert(self.Connections,self.Main:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()self:_layout()end))
  for _,attribute in ipairs({"MatchId","ResultsSessionId"})do table.insert(self.Connections,Player:GetAttributeChangedSignal(attribute):Connect(function()if self:IsBlocked()then self:Close()end end))end
 end)
end
function Controller:Destroy()self.Destroyed=true;self:Close();for _,c in ipairs(self.Connections)do c:Disconnect()end;table.clear(self.Connections)end
return Controller
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="4292">
          <Properties>
            <string name="Name">SettingsController</string>
            <string name="Source"><![CDATA[--!strict
-- SettingsController
-- Controlador cliente de la interfaz de configuración (Settings/Ajustes).
-- Gestiona la interfaz de usuario de forma modular y se comunica exclusivamente
-- con MusicController para aplicar cambios de volumen y estado de la música.

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local localPlayer = Players.LocalPlayer

local SettingsController = {}
SettingsController.Name = "SettingsController"

-- Referencias a instancias de PlayerGui.SettingsGUI
SettingsController._hud = nil :: ScreenGui?
SettingsController._openButton = nil :: TextButton?
SettingsController._mainFrame = nil :: Frame?
SettingsController._closeButton = nil :: TextButton?

-- AudioSection - Music Toggle
SettingsController._musicToggle = nil :: TextButton?
SettingsController._toggleStatusText = nil :: TextLabel?
SettingsController._toggleStroke = nil :: UIStroke?

-- AudioSection - Music Slider
SettingsController._volumePercent = nil :: TextLabel?
SettingsController._slider = nil :: TextButton?
SettingsController._sliderTrack = nil :: Frame?
SettingsController._sliderFill = nil :: Frame?
SettingsController._sliderKnob = nil :: Frame?

-- Estado interno
SettingsController._context = nil :: any
SettingsController._isDragging = false
SettingsController._dragConnection = nil :: RBXScriptConnection?
SettingsController._endedConnection = nil :: RBXScriptConnection?

--------------------------------------------------------------------------------
-- Enlace a la Interfaz de Usuario
--------------------------------------------------------------------------------

function SettingsController:_bindHUD()
	local playerGui = localPlayer:WaitForChild("PlayerGui")
	local hud = playerGui:WaitForChild("SettingsGUI", 15) :: ScreenGui?
	if not hud then
		warn("[SettingsController] No se encontro SettingsGUI en PlayerGui")
		return
	end
	self._hud = hud

	-- Botón de apertura global (en esquina de pantalla)
	self._openButton = hud:WaitForChild("SettingsButton", 5) :: TextButton?

	-- Modal principal
	local mainFrame = hud:WaitForChild("MainFrame", 5) :: Frame?
	if not mainFrame then
		warn("[SettingsController] No se encontro MainFrame en SettingsGUI")
		return
	end
	self._mainFrame = mainFrame
	mainFrame.Visible = false

	-- Header y botón de cierre
	local header = mainFrame:FindFirstChild("Header")
	if header then
		self._closeButton = header:FindFirstChild("CloseButton") :: TextButton?
	end

	-- Sección de Audio
	local content = mainFrame:FindFirstChild("Content")
	local audioSection = content and content:FindFirstChild("AudioSection")
	if audioSection then
		-- Toggle de Música
		local toggleRow = audioSection:FindFirstChild("MusicToggleRow")
		if toggleRow then
			local toggle = toggleRow:FindFirstChild("MusicToggle") :: TextButton?
			if toggle then
				self._musicToggle = toggle
				self._toggleStatusText = toggle:FindFirstChild("StatusText") :: TextLabel?
				self._toggleStroke = toggle:FindFirstChildOfClass("UIStroke")
			end
		end

		-- Slider de Volumen
		local volumeRow = audioSection:FindFirstChild("MusicVolumeRow")
		if volumeRow then
			local topRow = volumeRow:FindFirstChild("TopRow")
			if topRow then
				self._volumePercent = topRow:FindFirstChild("MusicVolumePercent") :: TextLabel?
			end

			local slider = volumeRow:FindFirstChild("MusicSlider") :: TextButton?
			if slider then
				self._slider = slider
				self._sliderTrack = slider:FindFirstChild("Track") :: Frame?
				if self._sliderTrack then
					self._sliderFill = self._sliderTrack:FindFirstChild("Fill") :: Frame?
				end
				self._sliderKnob = slider:FindFirstChild("Knob") :: Frame?
			end
		end
	end
end

--------------------------------------------------------------------------------
-- Conexión de Eventos de Interacción (Mouse, Touch, Móvil)
--------------------------------------------------------------------------------

function SettingsController:_connectEvents()
	-- 1. Apertura y Cierre
	if self._openButton then
		self._openButton.Activated:Connect(function()
			self:Toggle()
		end)
	end

	if self._closeButton then
		self._closeButton.Activated:Connect(function()
			self:Close()
		end)
	end

	-- 2. Toggle de Música (ON / OFF)
	if self._musicToggle then
		self._musicToggle.Activated:Connect(function()
			local musicController = self:_getMusicController()
			if not musicController then return end

			local current = musicController:IsMusicEnabled()
			local nextState = not current
			musicController:SetMusicEnabled(nextState)
			self:_updateToggleUI(nextState)
				self:_savePreferences()
		end)
	end

	-- 3. Slider de Volumen (Soporte Mouse y Touch Drag)
	if self._slider then
		self._slider.InputBegan:Connect(function(input: InputObject)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				self._isDragging = true
				self:_processSliderInput(input.Position.X, false)

				self:_setupGlobalDragListeners()
			end
		end)
	end
end

function SettingsController:_setupGlobalDragListeners()
	self:_cleanupGlobalDragListeners()

	-- Movimiento continuo (arrastre del slider con mouse o dedo en pantalla táctil)
	self._dragConnection = UserInputService.InputChanged:Connect(function(input: InputObject)
		if not self._isDragging then return end

		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			self:_processSliderInput(input.Position.X, true)
		end
	end)

	-- Fin del arrastre
	self._endedConnection = UserInputService.InputEnded:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			if self._isDragging then
				self._isDragging = false
				self:_processSliderInput(input.Position.X, false)
				self:_cleanupGlobalDragListeners()
			end
		end
	end)
end

function SettingsController:_cleanupGlobalDragListeners()
	if self._dragConnection then
		self._dragConnection:Disconnect()
		self._dragConnection = nil
	end
	if self._endedConnection then
		self._endedConnection:Disconnect()
		self._endedConnection = nil
	end
end

--------------------------------------------------------------------------------
-- Procesamiento Matemático del Slider
--------------------------------------------------------------------------------

function SettingsController:_processSliderInput(inputX: number, isDragging: boolean)
	if not self._slider then return end

	local sliderAbsPos = self._slider.AbsolutePosition
	local sliderAbsSize = self._slider.AbsoluteSize
	if sliderAbsSize.X <= 0 then return end

	local relativeX = inputX - sliderAbsPos.X
	local volumeFraction = math.clamp(relativeX / sliderAbsSize.X, 0, 1)

	-- Actualizar UI visualmente al instante
	self:_updateSliderUI(volumeFraction)

	-- Enviar valor autoritativo al MusicController
	local musicController = self:_getMusicController()
	if musicController then
		-- Si está en arrastre continuo usar fadeDuration 0 para latencia cero
		local fade = if isDragging then 0 else 0.1
		musicController:SetMusicVolume(volumeFraction, fade)
			if not isDragging then self:_savePreferences()end
	end
end

--------------------------------------------------------------------------------
-- Actualización Visual de Componentes
--------------------------------------------------------------------------------

function SettingsController:_updateToggleUI(enabled: boolean)
	if self._musicToggle then
		local targetColor = if enabled
			then Color3.fromRGB(40, 140, 75)
			else Color3.fromRGB(45, 55, 75)
		local targetStroke = if enabled
			then Color3.fromRGB(60, 180, 100)
			else Color3.fromRGB(65, 80, 105)

		self._musicToggle.BackgroundColor3 = targetColor
		if self._toggleStroke then
			self._toggleStroke.Color = targetStroke
		end
	end

	if self._toggleStatusText then
		self._toggleStatusText.Text = if enabled then "ON" else "OFF"
		self._toggleStatusText.TextColor3 = if enabled
			then Color3.fromRGB(255, 255, 255)
			else Color3.fromRGB(160, 175, 200)
	end
end

function SettingsController:_updateSliderUI(volume: number)
	local clamped = math.clamp(volume, 0, 1)
	local percentInt = math.floor(clamped * 100 + 0.5)

	-- Porcentaje de texto
	if self._volumePercent then
		self._volumePercent.Text = string.format("%d%%", percentInt)
	end

	-- Barra de relleno (Fill)
	if self._sliderFill then
		self._sliderFill.Size = UDim2.new(clamped, 0, 1, 0)
	end

	-- Perilla de arrastre (Knob)
	if self._sliderKnob then
		self._sliderKnob.Position = UDim2.new(clamped, 0, 0.5, 0)
	end
end

--------------------------------------------------------------------------------
-- Sincronización y Acceso a MusicController
--------------------------------------------------------------------------------

function SettingsController:_getMusicController(): any
	if self._context and typeof(self._context.GetController) == "function" then
		return self._context:GetController("MusicController")
	end
	return nil
end

function SettingsController:SyncWithMusicController()
	local musicController = self:_getMusicController()
	if not musicController then return end

	local enabled = musicController:IsMusicEnabled()
	local volume = musicController:GetMusicVolume()

	self:_updateToggleUI(enabled)
	self:_updateSliderUI(volume)
end

--------------------------------------------------------------------------------
-- API Pública
--------------------------------------------------------------------------------

function SettingsController:Open()
	if self._mainFrame then
		self:SyncWithMusicController()
		self._mainFrame.Visible = true
	end
end

function SettingsController:Close()
	if self._mainFrame then
		self._mainFrame.Visible = false
		self._isDragging = false
		self:_cleanupGlobalDragListeners()
	end
end

function SettingsController:Toggle()
	if self._mainFrame then
		if self._mainFrame.Visible then
			self:Close()
		else
			self:Open()
		end
	end
end

function SettingsController:IsOpen(): boolean
	return self._mainFrame ~= nil and self._mainFrame.Visible == true
end

--------------------------------------------------------------------------------
-- Ciclo de Vida Bootstrap
--------------------------------------------------------------------------------

function SettingsController:Init(context: any)
	self._context = context
	self:_bindHUD()
end

function SettingsController:_savePreferences()
	self._preferenceVersion=(self._preferenceVersion or 0)+1
	local version=self._preferenceVersion
	task.delay(.5,function()
		if version~=self._preferenceVersion or not self._preferencesRemote then return end
		local music=self:_getMusicController();if not music then return end
		local ok,result=pcall(self._preferencesRemote.InvokeServer,self._preferencesRemote,"Update",{MusicEnabled=music:IsMusicEnabled(),MusicVolume=music:GetMusicVolume()})
		if not ok or not result or not result.Ok then warn("[Settings] No se confirmó el envío de preferencias; reintentá el ajuste")end
	end)
end
function SettingsController:Start(context: any)
	self._context = context
	self:_connectEvents()
	self:SyncWithMusicController()
		task.spawn(function()
			local remote=game.ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("PlayerPreferences",20);if not remote then return end
			self._preferencesRemote=remote
			for _=1,30 do
				if (self._preferenceVersion or 0)>0 then self:_savePreferences();return end
				local ok,result=pcall(remote.InvokeServer,remote,"Snapshot")
				if ok and result and result.Ok then
					if (self._preferenceVersion or 0)>0 then self:_savePreferences();return end
					local music=self:_getMusicController();if music then music:SetMusicEnabled(result.Preferences.MusicEnabled);music:SetMusicVolume(result.Preferences.MusicVolume);self:SyncWithMusicController()end
					return
				end
				task.wait(1)
			end
		end)
	print("[SettingsController] Controlador de ajustes iniciado y enlazado a SettingsGUI")
end

return SettingsController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="4293">
          <Properties>
            <string name="Name">ShopController</string>
            <string name="Source"><![CDATA[--!strict
-- ShopController
-- Controlador cliente de la tienda (docs/SHOP_SYSTEM.md → ShopController / ShopUI).
-- - Enlaza las instancias existentes de PlayerGui.ShopHUD (creadas en Studio). No construye UI por código:
--   solo clona ProductCardTemplate por producto y modifica propiedades de instancias existentes.
-- - Obtiene el catálogo y solicita compra/equipamiento mediante Remotes.Shop (RemoteFunctions de ShopRemotes).
-- - Coins e Inventory se reflejan exclusivamente desde Remotes.Player.DataUpdated (fuente autoritativa).
-- - Sin operaciones optimistas: la UI solo cambia de estado cuando el servidor lo confirma.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local CrateView = require(ReplicatedStorage.Shared.SlapCrates.CrateShopView)
local ShopLayout = require(script.Parent.Parent.UI.ShopLayout)

local localPlayer = Players.LocalPlayer

local ShopController = {}
ShopController.Name = "ShopController"

local DEFAULT_CATEGORY = "PointEffects"
local REMOTE_TIMEOUT = 15

-- Mensajes legibles para los códigos de error reales devueltos por ShopService / Providers / ShopRemotes
local ERROR_MESSAGES: { [string]: string } = {
	InsufficientFunds = "No tenés Coins suficientes.",
	AlreadyOwned = "Ya tenés este producto.",
	AlreadyEquipped = "Este producto ya está equipado.",
	NotOwned = "Todavía no tenés este producto.",
	TransactionInProgress = "Ya hay una compra en curso.",
	RateLimited = "Esperá un momento antes de reintentar.",
	ProductNotFound = "El producto no existe.",
	ProductUnavailable = "El producto no está disponible.",
	ProviderNotFound = "Esta categoría todavía no está disponible.",
	NotEquippable = "Este producto no se puede equipar.",
	MarketplaceIntegrationPendingPhase6 = "Las compras con Robux todavía no están disponibles.",
	MissingRobloxProductId = "Las compras con Robux todavía no están disponibles.",
	UnsupportedCurrency = "Moneda no soportada.",
	PlayerServiceNotAvailable = "El servidor no está listo. Reintentá en unos segundos.",
	InternalError = "Error del servidor. Reintentá.",
	NoResponse = "Sin respuesta del servidor. Reintentá.",
	DataNotLoaded = "Tus datos todavía no están disponibles. Reintentá cuando terminen de cargar.",
	PurchasesNotEnabled = "Las compras de esta categoría todavía no están habilitadas.",
}

type UIRefs = {
	Hud: ScreenGui,
	OpenButton: GuiButton?,
	Main: Frame,
	OpenScale: UIScale?,
	CloseButton: GuiButton?,
	CoinsLabel: TextLabel?,
	Tabs: Frame?,
	Catalog: ScrollingFrame,
	CardTemplate: GuiButton,
	EmptyState: GuiObject?,
	LoadingLabel: GuiObject?,
	MessageLabel: TextLabel?,
	Detail: {
		Frame: Frame,
		PreviewLabel: TextLabel?,
		PreviewIcon: ImageLabel?,
		NameLabel: TextLabel?,
		RarityLabel: TextLabel?,
		DescriptionLabel: TextLabel?,
		PriceRow: GuiObject?,
		PriceLabel: TextLabel?,
		StatusLabel: TextLabel?,
		ActionButton: TextButton?,
		SecondaryButton: TextButton?,
	},
}

ShopController._context = nil :: any
ShopController._ui = nil :: UIRefs?
ShopController._remotes = {} :: { [string]: RemoteFunction }
ShopController._dataUpdated = nil :: RemoteEvent?
ShopController._dataConnection = nil :: RBXScriptConnection?
ShopController._connections = {} :: { RBXScriptConnection }
ShopController._cardConnections = {} :: { RBXScriptConnection }
ShopController._tabs = {} :: { [string]: GuiButton }
ShopController._tabBaseColors = {} :: { [GuiButton]: Color3 }
ShopController._tabBaseImageColors = {} :: { [ImageButton]: Color3 }
ShopController._cards = {} :: { [string]: GuiButton }
ShopController._cardBaseStroke = nil :: { Color: Color3, Thickness: number }?

ShopController._catalog = nil :: { any }?
ShopController._catalogLoading = false
ShopController._playerData = nil :: any
ShopController._category = DEFAULT_CATEGORY
ShopController._selectedId = nil :: string?
ShopController._busy = false
ShopController._isOpen = false
ShopController._messageToken = 0

--------------------------------------------------------------------------------
-- Utilidades
--------------------------------------------------------------------------------

local function attrColor(inst: Instance?, name: string, default: Color3): Color3
	local v = inst and inst:GetAttribute(name)
	if typeof(v) == "Color3" then
		return v
	end
	return default
end

local function find(parent: Instance?, path: { string }): Instance?
	local current = parent
	for _, name in ipairs(path) do
		if not current then return nil end
		current = current:FindFirstChild(name)
	end
	return current
end

local function formatNumber(n: number): string
	local s = tostring(math.floor(n))
	local formatted = s:reverse():gsub("(%d%d%d)", "%1."):reverse()
	return (formatted:gsub("^%.", ""))
end

--------------------------------------------------------------------------------
-- Enlace de UI
--------------------------------------------------------------------------------

function ShopController:_bindHUD(): boolean
	local playerGui = localPlayer:WaitForChild("PlayerGui")
	local hud = playerGui:WaitForChild("ShopHUD", REMOTE_TIMEOUT) :: ScreenGui?
	if not hud then
		warn("[ShopController] No se encontró ShopHUD en PlayerGui")
		return false
	end

 local main = hud:FindFirstChild("MainFrame") :: Frame?
	local catalog = find(main, { "Body", "Catalog" }) :: ScrollingFrame?
	local template = catalog and catalog:FindFirstChild("ProductCardTemplate") :: GuiButton?
	local _, detailFrame = ShopLayout.Prepare(hud)
	if not main or not catalog or not template or not detailFrame then
		warn("[ShopController] Estructura de ShopHUD incompleta (MainFrame/Body/Catalog/ProductCardTemplate/DetailPanel)")
		return false
	end

	template.Visible = false
	main.Visible = false

	self._ui = {
		Hud = hud,
		OpenButton = hud:FindFirstChild("ShopButton") :: GuiButton?,
		Main = main,
		OpenScale = main:FindFirstChild("OpenScale") :: UIScale?,
		CloseButton = find(main, { "Header", "CloseButton" }) :: GuiButton?,
		CoinsLabel = find(main, { "Header", "CoinsContainer", "CoinsLabel" }) :: TextLabel?,
		Tabs = main:FindFirstChild("Tabs") :: Frame?,
		Catalog = catalog,
		CardTemplate = template,
		EmptyState = find(main, { "Body", "EmptyState" }) :: GuiObject?,
		LoadingLabel = find(main, { "Body", "LoadingLabel" }) :: GuiObject?,
		MessageLabel = main:FindFirstChild("MessageLabel") :: TextLabel?,
		Detail = {
			Frame = detailFrame,
			Preview = detailFrame:FindFirstChild("Preview") :: Frame?,
			PreviewLabel = find(detailFrame, { "Preview", "PreviewLabel" }) :: TextLabel?,
			PreviewIcon = find(detailFrame, { "Preview", "PreviewIcon" }) :: ImageLabel?,
			NameLabel = detailFrame:FindFirstChild("NameLabel") :: TextLabel?,
			RarityLabel = detailFrame:FindFirstChild("RarityLabel") :: TextLabel?,
			DescriptionLabel = detailFrame:FindFirstChild("DescriptionLabel") :: TextLabel?,
			PriceRow = detailFrame:FindFirstChild("PriceRow") :: GuiObject?,
			PriceLabel = find(detailFrame, { "PriceRow", "PriceLabel" }) :: TextLabel?,
			StatusLabel = detailFrame:FindFirstChild("StatusLabel") :: TextLabel?,
			ActionButton = detailFrame:FindFirstChild("ActionButton") :: TextButton?,
			SecondaryButton = detailFrame:FindFirstChild("SecondaryButton") :: TextButton?,
		},
	}

	local templateStroke = template:FindFirstChildOfClass("UIStroke")
	if templateStroke then
		self._cardBaseStroke = { Color = templateStroke.Color, Thickness = templateStroke.Thickness }
	end

	-- Pestañas: cualquier GuiButton dentro de Tabs con atributo Category
	local tabsFrame = self._ui.Tabs
	if tabsFrame then
		for _, child in ipairs(tabsFrame:GetChildren()) do
			local category = child:GetAttribute("Category")
			if child:IsA("GuiButton") and typeof(category) == "string" then
				self._tabs[category] = child
				self._tabBaseColors[child] = child.BackgroundColor3
				if child:IsA("ImageButton") then self._tabBaseImageColors[child] = child.ImageColor3 end
				table.insert(self._connections, child.Activated:Connect(function()
					self:_selectCategory(category)
				end))
			end
		end
	end

	local ui = self._ui
	if ui.OpenButton then
		ui.OpenButton.Visible=false -- Ordinary access is the server-validated physical CoinShop.
	end
	if ui.CloseButton then
		table.insert(self._connections, ui.CloseButton.Activated:Connect(function()
			self:Close()
		end))
	end
	if ui.Detail.ActionButton then
		table.insert(self._connections, ui.Detail.ActionButton.Activated:Connect(function()
			self:_onActionPressed()
		end))
	end
	if ui.Detail.SecondaryButton then
		table.insert(self._connections, ui.Detail.SecondaryButton.Activated:Connect(function()
			self:_onSecondaryPressed()
		end))
	end

	local back=main.Body.BackToCollection
	table.insert(self._connections,back.Activated:Connect(function()
		self._detailFocused=false
		ShopLayout.Apply(hud,false)
	end))
	table.insert(self._connections,main:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		ShopLayout.Apply(hud,self._detailFocused)
	end))
	main.AnchorPoint=Vector2.new(.5,.5);main.Position=UDim2.fromScale(.5,.5);main.Size=UDim2.new(1,-24,1,-24)
	for _,constraint in main:GetChildren()do
		if constraint:IsA("UISizeConstraint")then constraint.MinSize=Vector2.new(0,0);constraint.MaxSize=Vector2.new(1400,900)end
		if constraint:IsA("UIAspectRatioConstraint")then constraint:Destroy()end
	end
	ShopLayout.Apply(hud,false)
	return true
end

function ShopController:_bindRemotes()
	local remotes = ReplicatedStorage:WaitForChild("Remotes", REMOTE_TIMEOUT)
	local shopFolder = remotes and remotes:WaitForChild("Shop", REMOTE_TIMEOUT)
	if shopFolder then
		local access=shopFolder:WaitForChild("CoinShopAccess",REMOTE_TIMEOUT)
		if access and access:IsA("RemoteEvent")then
			table.insert(self._connections,access.OnClientEvent:Connect(function()self:Open()end))
		end
		for _, name in ipairs({ "GetCatalog", "PurchaseProduct", "EquipProduct", "UnequipProduct" }) do
			local rf = shopFolder:WaitForChild(name, REMOTE_TIMEOUT)
			if rf and rf:IsA("RemoteFunction") then
				self._remotes[name] = rf
			else
				warn(string.format("[ShopController] RemoteFunction Shop.%s no disponible", name))
			end
		end
	end

	local playerFolder = remotes and remotes:WaitForChild("Player", REMOTE_TIMEOUT)
	local dataUpdated = playerFolder and playerFolder:WaitForChild("DataUpdated", REMOTE_TIMEOUT)
	if dataUpdated and dataUpdated:IsA("RemoteEvent") then
		-- Se conecta de forma diferida en la primera apertura (ver _ensureDataListener)
		self._dataUpdated = dataUpdated
	else
		warn("[ShopController] RemoteEvent Player.DataUpdated no disponible")
	end
end

-- Conecta DataUpdated recién cuando el jugador abre la tienda.
-- Motivo: los eventos disparados antes de que exista un listener quedan encolados y se entregan al primer
-- handler que se conecta; conectar aquí evita robarle el snapshot inicial a PlayerHUDController.
-- El snapshot para la tienda lo reenvía el servidor al invocar GetCatalog.
function ShopController:_ensureDataListener()
	if self._dataConnection or not self._dataUpdated then return end
	self._dataConnection = self._dataUpdated.OnClientEvent:Connect(function(data: any)
		if type(data) == "table" then
			self._playerData = data
			self:_refresh()
		end
	end)
end

--------------------------------------------------------------------------------
-- Estado derivado (siempre desde datos del servidor)
--------------------------------------------------------------------------------

function ShopController:_isOwned(product: any): boolean
	local inv = self._playerData and self._playerData.Inventory
	local owned = inv and inv.Owned and inv.Owned[product.Category]
	return type(owned) == "table" and owned[product.Id] == true
end

function ShopController:_isEquipped(product: any): boolean
	local inv = self._playerData and self._playerData.Inventory
	return inv ~= nil and inv.Equipped ~= nil and inv.Equipped[product.Category] == product.Id
end

function ShopController:_getProducts(category: string): { any }
	local list = {}
	for _, product in ipairs(self._catalog or {}) do
		if product.Category == category then
			if product.Metadata and product.Metadata.PremiumOnly then
				local crates=self._playerData and self._playerData.Inventory and self._playerData.Inventory.Crates
				if not crates or (crates[product.Id]or 0)<=0 then continue end
			end
			table.insert(list, product)
		end
	end
		return CrateView.SortProducts(list, category)
end

function ShopController:_getProduct(productId: string?): any
	if not productId then return nil end
	for _, product in ipairs(self._catalog or {}) do
		if product.Id == productId and product.Category == self._category then return product end
	end
	return nil
end

-- Una categoría está activa si el servidor expone productos para ella (proveedor registrado)
function ShopController:_isCategoryActive(category: string): boolean
	return #self:_getProducts(category) > 0
end

--------------------------------------------------------------------------------
-- Render
--------------------------------------------------------------------------------

function ShopController:_showMessage(text: string, kind: string?)
	local ui = self._ui
	if not ui or not ui.MessageLabel then return end
	local colorName = "MessageColor_" .. (kind or "Info")
	ui.MessageLabel.TextColor3 = attrColor(ui.Main, colorName, ui.MessageLabel.TextColor3)
	ui.MessageLabel.Text = text

	self._messageToken += 1
	local token = self._messageToken
	if text ~= "" then
		task.delay(4, function()
			if self._messageToken == token and self._ui and self._ui.MessageLabel then
				self._ui.MessageLabel.Text = ""
			end
		end)
	end
end

function ShopController:_renderCoins()
	local ui = self._ui
	if not ui or not ui.CoinsLabel then return end
	local coins = self._playerData and self._playerData.Coins
	ui.CoinsLabel.Text = if typeof(coins) == "number" then formatNumber(coins) else "—"
end

function ShopController:_renderTabs()
	local ui = self._ui
	if not ui then return end
	local activeColor = attrColor(ui.Tabs, "ActiveColor", Color3.fromRGB(0, 120, 215))
	for category, tab in pairs(self._tabs) do
		local isSelected = category == self._category
		local isActive = self._catalog ~= nil and self:_isCategoryActive(category)
		tab.BackgroundColor3 = if isSelected then activeColor else (self._tabBaseColors[tab] or tab.BackgroundColor3)
		if tab:IsA("ImageButton") then
			tab.ImageColor3 = if isSelected then activeColor else (self._tabBaseImageColors[tab] or tab.ImageColor3)
		end
		local badge = tab:FindFirstChild("SoonBadge")
		if badge and badge:IsA("GuiObject") then
			badge.Visible = self._catalog ~= nil and not isActive
		end
	end
end

function ShopController:_clearCards()
	for _, conn in ipairs(self._cardConnections) do
		conn:Disconnect()
	end
	table.clear(self._cardConnections)
	for _, card in pairs(self._cards) do
		card:Destroy()
	end
	table.clear(self._cards)
end

function ShopController:_rarityColor(rarity: string?): Color3
	local ui = self._ui
	return attrColor(ui and ui.Main, "RarityColor_" .. tostring(rarity), Color3.fromRGB(170, 180, 200))
end

function ShopController:_crateView(product: any): any
	local c = self._context and self._context.GetController and self._context:GetController("CrateController")
	return if c then c:GetView(product, self._playerData) else CrateView.State(product, self._playerData, nil, workspace:GetServerTimeNow(), false)
end

function ShopController:_cratePreview(preview: Instance?, product: any)
	if not preview then return end

	local oldCrate = preview:FindFirstChild("CratePreview")
	if oldCrate then oldCrate:Destroy() end
	local oldIcon = preview:FindFirstChild("Icon2D_Preview")
	if oldIcon then oldIcon:Destroy() end

	local fallback=preview:FindFirstChild("PreviewIcon")
 if fallback then
  local tab=self._tabs.Crates
  local art=tab and tab:FindFirstChild("IconImage")
  if art then fallback.Image=art.Image end
  fallback.Visible=true
 end
 local icon2dFolder = ReplicatedStorage:FindFirstChild("CrateEffects") and ReplicatedStorage.CrateEffects:FindFirstChild("Icon2D")
	local icon2dTemplate: GuiObject? = nil
	if icon2dFolder then
		icon2dTemplate = icon2dFolder:FindFirstChild(product.Id)
			or (product.Metadata and icon2dFolder:FindFirstChild(product.Metadata.Model))
		if not icon2dTemplate and (product.Id == "Arcoiris" or (product.Metadata and product.Metadata.Model == "Arcoiris")) then
			icon2dTemplate = icon2dFolder:FindFirstChild("Arcoiris") or icon2dFolder:FindFirstChild("Emote")
		end
	end

	if icon2dTemplate then
		local icon2d = icon2dTemplate:Clone()
		icon2d.Name = "Icon2D_Preview"
		icon2d.AnchorPoint = Vector2.new(0.5, 0.5)
		icon2d.Position = UDim2.fromScale(0.5, 0.5)
		icon2d.Size = UDim2.fromScale(0.85, 0.85)
		icon2d.BackgroundTransparency = 1
		icon2d.Visible = true
		icon2d.Parent = preview

		local label = preview:FindFirstChild("PreviewLabel")
		if label then label.Visible = false end
		local icon = preview:FindFirstChild("PreviewIcon")
		if icon then icon.Visible = false end
		return
	end

	local template = self._ui.Hud:FindFirstChild("CratePreviewTemplate")
	local models = ReplicatedStorage:FindFirstChild("CrateEffects")
	local model = models and product.Metadata and models:FindFirstChild(product.Metadata.Model)
	if not template or not model then return end

	local viewport = template:Clone()
	viewport.Name = "CratePreview"
	viewport.Visible = true
	viewport.Parent = preview

	local camera = viewport:FindFirstChildWhichIsA("Camera") :: Camera?
	if not camera then
		camera = Instance.new("Camera")
		camera.Name = "Camera"
		camera.FieldOfView = 45
		camera.Parent = viewport
	end
	local clone = model:Clone()
	clone:PivotTo(CFrame.new())
	clone.Parent = viewport.WorldModel
	local distance = math.clamp(clone:GetExtentsSize().Magnitude * 1.2, 4, 24)
	camera.CFrame = CFrame.lookAt(Vector3.new(distance, distance * 0.65, distance), Vector3.new())
	viewport.CurrentCamera = camera

	local label = preview:FindFirstChild("PreviewLabel")
	if label then label.Visible = false end
	local icon = preview:FindFirstChild("PreviewIcon")
	if icon then icon.Visible = false end
end

function ShopController:_applyCardState(card: GuiButton, product: any)
	local ui = self._ui
	if not ui then return end
	local owned = self:_isOwned(product)
	local equipped = self:_isEquipped(product)
		if product.Category == "Crates" then
			local state=self:_crateView(product)
			local price=card:FindFirstChild("PriceLabel");if price then price.Visible=true;price.Text=state.PriceText end
			local coin=card:FindFirstChild("CoinIcon");if coin then coin.Visible=false end
			local badge=card:FindFirstChild("StateBadge");if badge then badge.Visible=false end
			local stroke=card:FindFirstChildOfClass("UIStroke")
			if stroke and self._cardBaseStroke then
				stroke.Color=if product.Id==self._selectedId then attrColor(ui.Main,"SelectedStrokeColor",self._cardBaseStroke.Color)else self._cardBaseStroke.Color
			end
			local actions=card:FindFirstChild("CrateActions")
			if actions then
				actions.Action.Text=if state.BuyEnabled then "COMPRAR" elseif state.Quantity>0 and state.OpenEnabled then "ABRIR" else "VER CAJA"
				actions.Action.Active=state.BuyEnabled or state.OpenEnabled
				if actions:FindFirstChild("StockLabel") then actions.StockLabel.Text=state.StockText end
			end
			return
		end

	local badge = card:FindFirstChild("StateBadge") :: TextLabel?
	if badge then
		if not product.IsAvailable then
			badge.Visible = true
			badge.Text = "NO DISPONIBLE"
			badge.BackgroundColor3 = attrColor(badge, "Color_Unavailable", badge.BackgroundColor3)
		elseif equipped then
			badge.Visible = true
			badge.Text = if product.Category == "Abilities" then "PREFERIDA" else "EQUIPADO"
			badge.BackgroundColor3 = attrColor(badge, "Color_Equipped", badge.BackgroundColor3)
		elseif owned then
			badge.Visible = true
			badge.Text = "TUYO"
			badge.BackgroundColor3 = attrColor(badge, "Color_Owned", badge.BackgroundColor3)
		else
			badge.Visible = false
		end
	end

	local priceLabel = card:FindFirstChild("PriceLabel") :: TextLabel?
	local coinIcon = card:FindFirstChild("CoinIcon") :: GuiObject?
	local showPrice = not owned and product.Currency == "Coins"
	if priceLabel then
		priceLabel.Visible = not owned
			priceLabel.Text = if product.Category == "Slaps" then "SOLO EN CAJAS" elseif product.Metadata and product.Metadata.PricePending then "PRECIO PENDIENTE" elseif product.Currency == "Coins" then formatNumber(product.Price or 0)
			else string.format("%s R$", formatNumber(product.Price or 0))
	end
		if coinIcon then coinIcon.Visible = showPrice and product.Category ~= "Slaps" and not (product.Metadata and product.Metadata.PricePending) end

	local cardStroke = card:FindFirstChildOfClass("UIStroke")
	if cardStroke and self._cardBaseStroke then
		local selected = product.Id == self._selectedId
		cardStroke.Color = if selected then attrColor(ui.Main, "SelectedStrokeColor", self._cardBaseStroke.Color) else self._cardBaseStroke.Color
		cardStroke.Thickness = if selected then self._cardBaseStroke.Thickness + 1 else self._cardBaseStroke.Thickness
	end
end

function ShopController:_renderCatalog()
	local ui = self._ui
	if not ui then return end
	self:_clearCards()

	local loading = self._catalog == nil
	if ui.LoadingLabel then ui.LoadingLabel.Visible = loading end

	local products = if loading then {} else self:_getProducts(self._category)
	local isEmpty = not loading and #products == 0
	if ui.EmptyState then ui.EmptyState.Visible = isEmpty end
	ui.Catalog:SetAttribute("HasProducts",not loading and not isEmpty)
	ui.Catalog.Visible = not loading and not isEmpty
	ui.Detail.Frame.Visible = not loading and not isEmpty

	for index, product in ipairs(products) do
		local card = ui.CardTemplate:Clone()
		card.Name = "Card_" .. tostring(product.Id)
		card.LayoutOrder = index
		card.Visible = true
		ShopLayout.Card(card)

		local nameLabel = card:FindFirstChild("NameLabel") :: TextLabel?
		if nameLabel then nameLabel.Text = product.DisplayName or product.Id end
		local rarityLabel = card:FindFirstChild("RarityLabel") :: TextLabel?
		if rarityLabel then
			rarityLabel.Text = product.Rarity or ""
				if product.Category == "Crates" then rarityLabel.Visible=false end
			rarityLabel.TextColor3 = self:_rarityColor(product.Rarity)
		end
		local preview = card:FindFirstChild("Preview")
			if product.Category=="Crates" then self:_cratePreview(preview,product) end

		local previewStroke = preview and preview:FindFirstChildOfClass("UIStroke")
		if previewStroke then previewStroke.Color = self:_rarityColor(product.Rarity) end
		local icon = preview and preview:FindFirstChild("PreviewIcon") :: ImageLabel?
		if product.Category ~= "Crates" and icon and type(product.Icon) == "string" and product.Icon ~= "" then
			icon.Image = product.Icon
			icon.Visible = true
			local placeholder = preview and preview:FindFirstChild("PreviewLabel") :: GuiObject?
			if placeholder then placeholder.Visible = false end
		end

		self:_applyCardState(card, product)
		card.Parent = ui.Catalog
		self._cards[product.Id] = card

		local productId = product.Id
		table.insert(self._cardConnections, card.Activated:Connect(function()
			local crates=self._context:GetController("CrateController")
			if product.Category=="Crates" and crates and (crates._busy or crates._pendingAction) and crates._crateId~=productId then return end
			self._selectedId = productId
			self._detailFocused=true
			self:_refreshStates()
		end))
	end

	-- Mantener selección válida dentro de la categoría
	if not self:_getProduct(self._selectedId) or (self:_getProduct(self._selectedId).Category ~= self._category) then
		self._selectedId = if #products > 0 then products[1].Id else nil
	end
	self:_refreshStates()
end

function ShopController:_renderDetail()
	local ui = self._ui
	if not ui then return end
	local d = ui.Detail
	local product = self:_getProduct(self._selectedId)

	if not product then
		local crates=self._context:GetController("CrateController")
		if crates and crates._panel then crates._panel.Visible=false end
		local oldCrate = d.Preview and (d.Preview:FindFirstChild("CratePreview") or d.Preview:FindFirstChild("Icon2D_Preview"))
		if oldCrate then oldCrate:Destroy() end
		if d.NameLabel then d.NameLabel.Text = "Seleccioná un producto" end
		if d.RarityLabel then d.RarityLabel.Text = "" end
		if d.DescriptionLabel then d.DescriptionLabel.Text = "" end
		if d.PriceRow then d.PriceRow.Visible = false end
		if d.StatusLabel then d.StatusLabel.Text = "" end
		if d.ActionButton then d.ActionButton.Visible = false end
		if d.SecondaryButton then d.SecondaryButton.Visible = false end
		return
	end
 local crate=self._context:GetController("CrateController")
 if product.Category == "Crates" then
  d.Frame.Visible=false
  if crate then
   crate:ShowCrate(product.Id,true)
   local panel=crate._panel
   if panel and panel:FindFirstChild("CrateThumbnail") and panel:GetAttribute("PreviewProduct")~=product.Id then
    self:_cratePreview(panel.CrateThumbnail,product)
    panel:SetAttribute("PreviewProduct",product.Id)
   end
  end
  ShopLayout.Apply(ui.Hud,self._detailFocused)
  return
 end
 if crate and crate._panel then crate._panel.Visible=false end
 d.Frame.Visible=true
 ShopLayout.Apply(ui.Hud,self._detailFocused)

	local oldCrate = d.Preview and (d.Preview:FindFirstChild("CratePreview") or d.Preview:FindFirstChild("Icon2D_Preview"))
	if oldCrate then oldCrate:Destroy() end

	local owned = self:_isOwned(product)
	local equipped = self:_isEquipped(product)
	local rarityColor = self:_rarityColor(product.Rarity)

	if d.NameLabel then d.NameLabel.Text = product.DisplayName or product.Id end
	if d.RarityLabel then
		d.RarityLabel.Text = product.Rarity or ""
		d.RarityLabel.TextColor3 = rarityColor
	end
	if d.DescriptionLabel then d.DescriptionLabel.Text = product.Description or "" end
	if d.PreviewIcon and d.PreviewLabel then
		local hasIcon = type(product.Icon) == "string" and product.Icon ~= ""
		d.PreviewIcon.Image = if hasIcon then product.Icon else ""
		d.PreviewIcon.Visible = hasIcon
		d.PreviewLabel.Visible = not hasIcon
	end
	if d.PriceRow then d.PriceRow.Visible = not owned end
		if d.PriceLabel then
			d.PriceLabel.Text = if product.Category == "Abilities" and product.Metadata and product.Metadata.PricePending then "Precio pendiente de aprobación" elseif product.Currency == "Coins" then string.format("%s Coins", formatNumber(product.Price or 0))
			else string.format("%s Robux", formatNumber(product.Price or 0))
	end

	local status, actionText, actionKind, actionEnabled
		if product.Category == "Slaps" and not owned then
			status, actionText, actionKind, actionEnabled = "Se obtiene abriendo cajas", "SOLO EN CAJAS", "Disabled", false
		elseif not product.IsAvailable then
		status, actionText, actionKind, actionEnabled = "Producto no disponible", "NO DISPONIBLE", "Disabled", false
	elseif equipped then
			status, actionText, actionKind, actionEnabled = if product.Category == "Abilities" then "Preferencia para la próxima ronda" else "Equipado actualmente", if product.Category == "Abilities" then "PREFERIDA" else "EQUIPADO", "Disabled", false
	elseif owned then
				status, actionText, actionKind, actionEnabled = "Ya es tuyo", "EQUIPAR", "Equip", true
			elseif product.Category == "Abilities" and (not product.Metadata or not product.Metadata.PurchaseEnabled or not product.Metadata.PriceApproved) then
			status, actionText, actionKind, actionEnabled = "Precio pendiente de aprobación", "PRÓXIMAMENTE", "Disabled", false
	elseif product.Currency ~= "Coins" then
		status, actionText, actionKind, actionEnabled = "Compras con Robux próximamente", "PRÓXIMAMENTE", "Disabled", false
	else
		local coins = self._playerData and self._playerData.Coins
		local canAfford = typeof(coins) == "number" and coins >= (product.Price or 0)
		status = if canAfford then "Disponible para comprar" else "Coins insuficientes"
			actionText, actionKind, actionEnabled = "COMPRAR", "Buy", canAfford
	end

	if self._busy then
		actionText, actionEnabled = "PROCESANDO…", false
	end

	if d.StatusLabel then d.StatusLabel.Text = status end
	if d.ActionButton then
		local btn = d.ActionButton
		btn.Visible = true
		btn.Text = actionText
		btn.Active = actionEnabled
		btn.AutoButtonColor = actionEnabled
		btn.BackgroundColor3 = attrColor(btn, "Color_" .. actionKind, btn.BackgroundColor3)
	end
	if d.SecondaryButton then
		-- Desequipar solo tiene sentido si el producto equipado no es el gratuito por defecto de la categoría
		d.SecondaryButton.Visible = equipped and (product.Price or 0) > 0
		d.SecondaryButton.Active = not self._busy
	end
end

-- Recalcula estados (cards + detalle + saldo) sin reconstruir las tarjetas
function ShopController:_refreshStates()
	for productId, card in pairs(self._cards) do
		local product = self:_getProduct(productId)
		if product then
			self:_applyCardState(card, product)
		end
	end
	self:_renderDetail()
	self:_renderCoins()
	if self._ui then ShopLayout.Apply(self._ui.Hud,self._detailFocused)end
end

function ShopController:_refresh()
	if not self._ui then return end
	self:_renderCoins()
	if self._isOpen then
		self:_renderTabs()
		self:_refreshStates()
	end
end

--------------------------------------------------------------------------------
-- Interacción
--------------------------------------------------------------------------------

function ShopController:_selectCategory(category: string)
	if self._category == category then return end
	self._category = category
	self._detailFocused=false
	self._selectedId = nil
	self:_renderTabs()
	self:_renderCatalog()
	if self._catalog and not self:_isCategoryActive(category) then
		self:_showMessage("Esta categoría estará disponible próximamente.", "Info")
	end
end

function ShopController:_loadCatalog()
	if self._catalogLoading then return end
	local rf = self._remotes.GetCatalog
	if not rf then
		self:_showMessage("La tienda no está disponible en este momento.", "Error")
		return
	end
	self._catalogLoading = true
	task.spawn(function()
		local ok, result = pcall(function()
			return rf:InvokeServer()
		end)
		self._catalogLoading = false
		if ok and type(result) == "table" then
			self._catalog = result
				local crates=self._context and self._context.GetController and self._context:GetController("CrateController")
				if crates then crates:SetCatalog(result) end
		else
			warn(string.format("[ShopController] GetCatalog falló: %s", tostring(result)))
			self:_showMessage("No se pudo cargar el catálogo. Cerrá y volvé a abrir la tienda.", "Error")
		end
		if self._isOpen then
			self:_renderTabs()
			self:_renderCatalog()
		end
	end)
end

-- Ejecuta una operación del servidor bloqueando acciones repetidas hasta obtener respuesta
function ShopController:_request(remoteName: string, arg: string, successText: string, category: string?)
	if self._busy then return end
	local rf = self._remotes[remoteName]
	if not rf then
		self:_showMessage("La tienda no está disponible en este momento.", "Error")
		return
	end
	self._busy = true
	self:_renderDetail()

	task.spawn(function()
		local ok, success, code = pcall(function()
			return rf:InvokeServer(arg, category)
		end)
		self._busy = false
		if not ok then
			warn(string.format("[ShopController] %s falló: %s", remoteName, tostring(success)))
			self:_showMessage(ERROR_MESSAGES.NoResponse, "Error")
		elseif success == true then
			self:_showMessage(successText, "Success")
		else
			local key = tostring(code)
			self:_showMessage(ERROR_MESSAGES[key] or string.format("No se pudo completar la operación (%s).", key), "Error")
		end
		self:_refreshStates()
	end)
end

function ShopController:_onActionPressed()
	local product = self:_getProduct(self._selectedId)
	if not product or self._busy or not product.IsAvailable then return end
	if product.Category == "Crates" then
		local controller=self._context:GetController("CrateController")
		if controller then controller:ShowCrate(product.Id) end
		return
	end
	if product.Category == "Slaps" and not self:_isOwned(product) then return end
	if self:_isEquipped(product) then return end

	if self:_isOwned(product) then
			self:_request("EquipProduct", product.Id, if product.Category == "Abilities" then "Preferencia guardada para la próxima ronda." else string.format("%s equipado.", product.DisplayName or product.Id), product.Category)
	elseif product.Currency == "Coins" then
			if product.ProductType == "Ability" and (not product.Metadata
				or product.Metadata.PurchaseEnabled ~= true or product.Metadata.PriceApproved ~= true) then return end
			local coins = self._playerData and self._playerData.Coins
			if typeof(coins) ~= "number" or coins < product.Price then return end
		self:_request("PurchaseProduct", product.Id, string.format("¡Compraste %s!", product.DisplayName or product.Id), product.Category)
	end
end

function ShopController:_onSecondaryPressed()
	local product = self:_getProduct(self._selectedId)
	if not product or self._busy or not self:_isEquipped(product) then return end
	self:_request("UnequipProduct", product.Category, "Producto desequipado.")
end

--------------------------------------------------------------------------------
-- Apertura / cierre
--------------------------------------------------------------------------------

function ShopController:OpenCategory(category: string)
	if category ~= "Crates" then return end
	self._category = category
	if self._isOpen then self:_selectCategory(category) else self:Open() end
end

function ShopController:Open()
	local ui = self._ui
	if not ui or self._isOpen then return end
	local premium=self._context:GetController("PremiumShopController")
	if premium and premium.IsBlocked and premium:IsBlocked()then return end
	local navigation=self._context:GetController("WindowNavigationController")
	if premium and not navigation then premium:Close()end
	self._isOpen = true
	ui.Main.Visible = true

	if ui.OpenScale then
		ui.OpenScale.Scale = 0.92
		TweenService:Create(ui.OpenScale, TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	end

	self:_renderTabs()
	self:_renderCatalog()
	-- El catálogo se solicita en cada apertura; GetCatalog también reenvía el snapshot de DataUpdated
	self:_ensureDataListener()
	self:_loadCatalog()
end

function ShopController:Close()
	local navigation=self._context and self._context:GetController("WindowNavigationController")
	if navigation then navigation:Forget('Shop')end
	local ui = self._ui
	if not ui or not self._isOpen then return end
	self._isOpen = false
	local crates=self._context:GetController("CrateController")
	if crates and crates._panel then crates._panel.Visible=false end
	-- Las operaciones en curso continúan en el servidor; su resultado llegará por DataUpdated
	self:_clearCards()
	ui.Main.Visible = false
	if ui.OpenScale then ui.OpenScale.Scale = 1 end
end

function ShopController:Toggle()
	if self._isOpen and self._ui and not self._ui.Main.Visible then self._ui.Main.Visible=true;return end
	if self._isOpen then self:Close() else self:Open() end
end

--------------------------------------------------------------------------------
-- Ciclo de vida
--------------------------------------------------------------------------------

function ShopController:Init(context)
	self._context = context
end

function ShopController:Start(context)
	self._context = context
	task.spawn(function()
		if not self:_bindHUD() then return end
		self:_bindRemotes()
		self:_renderCoins()
		print("[ShopController] Tienda enlazada y lista")
	end)
end

function ShopController:Destroy()
	self:Close()
	self:_clearCards()
	for _, conn in ipairs(self._connections) do
		conn:Disconnect()
	end
	table.clear(self._connections)
	if self._dataConnection then
		self._dataConnection:Disconnect()
		self._dataConnection = nil
	end
	table.clear(self._tabs)
	table.clear(self._tabBaseColors)
	table.clear(self._tabBaseImageColors)
	self._ui = nil
end

return ShopController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="4294">
          <Properties>
            <string name="Name">SlapController</string>
            <string name="Source"><![CDATA[--!strict
-- SlapController
-- Controlador cliente de Slaps.
-- Responsabilidad exclusiva:
-- 1. Detectar cuando el jugador equipa un Slap (Tool con Configuration.Power).
-- 2. Conectar al evento Tool.Activated.
-- 3. Predecir Swing inmediatamente y reconciliar solo su presentación.
-- 4. Solicitar la ejecucion autoritativa al servidor via ReplicatedStorage.Remotes.Combat.PerformSlap.
-- 5. Manejar un debounce local liviano para evitar saturar la red con clics repetidos.
-- NO calcula daño, distancia autoritativa, knockback ni fisica.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local StarterGui = game:GetService("StarterGui")
local Config = require(ReplicatedStorage.Shared.Config)

local localPlayer = Players.LocalPlayer

local SlapController = {}
SlapController.Name = "SlapController"

SlapController._context = nil :: any
SlapController._performSlapRemote = nil :: RemoteEvent?
SlapController._equippedTool = nil :: Tool?
SlapController._activatedConn = nil :: RBXScriptConnection?
SlapController._swingTrack = nil :: AnimationTrack?
SlapController._localNextSlapTime = 0
SlapController._awaitingUntil = 0
SlapController._predictionUntil = 0
SlapController._lastSequence = 0
SlapController._requestId = 0
SlapController._connections = {} :: { RBXScriptConnection }
SlapController._characterConnections = {} :: { RBXScriptConnection }
SlapController._pending = nil :: any
SlapController._scope = nil :: any
SlapController._sessionId = nil :: string?
SlapController._roundId = nil :: string?
SlapController._roundIndex = 0
SlapController._stateVersion = -1
SlapController._playing = false
SlapController._roundClosed = false
SlapController._visualStart = nil :: number?

function SlapController:_stopSwing(release: boolean?)
	local track = self._swingTrack
	if not track then return end
	pcall(function() track:Stop(0.05) end)
	if release then
		self._swingTrack = nil
		pcall(function() track:Destroy() end)
	end
end

function SlapController:GetCooldownState(now: number)
	local deadline = math.max(self._localNextSlapTime, self._predictionUntil)
	local pending = self._pending ~= nil and now < self._awaitingUntil
	local remaining = math.max(0, deadline - now)
	local blocked = remaining > 0 or now < self._awaitingUntil
	local startTime = self._visualStart or now
	local duration = math.max(0, deadline - startTime)
	local progress = if duration > 0 then math.clamp((now - startTime) / duration, 0, 1) else 1
	-- A pending result cannot visually advertise readiness when its provisional clock ends.
	if pending then progress = math.min(progress, 0.98) end
	return {
		Blocked = blocked, Pending = pending, Remaining = remaining, Deadline = deadline,
		Progress = if blocked then progress else 1,
		Text = if not blocked then "" elseif remaining > 0 then string.format("%.1f s", remaining) else "…",
	}
end

function SlapController:_hideNativeBackpack()
	if self._backpackHidden then return end
	local ok = pcall(function()
		if self._originalBackpackEnabled == nil then
			self._originalBackpackEnabled = StarterGui:GetCoreGuiEnabled(Enum.CoreGuiType.Backpack)
		end
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
	end)
	self._backpackHidden = ok
end

function SlapController:_renderSlot()
	local now = workspace:GetServerTimeNow()
	if not self._backpackHidden and now >= (self._nextBackpackAttempt or 0) then
		self._nextBackpackAttempt = now + 0.5; self:_hideNativeBackpack()
	end
	local root = self._slotRoot
	if not root then return end
	local tool = self._equippedTool
	local char = localPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local inMatch = localPlayer:GetAttribute("MatchId") ~= nil
		and localPlayer:GetAttribute("MatchId") == self._sessionId
	local visible = inMatch and tool ~= nil and tool.Parent == char and hum ~= nil and hum.Health > 0
		and char:GetAttribute("ArenaRespawnPending") ~= true
		and localPlayer:GetAttribute("ResultsSessionId") == nil
		and (self._matchState == "StartCountdown" or self._matchState == "Playing" or self._matchState == "PointRestartCountdown")
	root.Visible = visible
	if not visible then return end
	local slot = root.SlapSlot
	local name = tool:GetAttribute("DisplayName")
	if type(name) ~= "string" or name == "" then name = tool.ToolTip end
	if type(name) ~= "string" or name == "" then
		local configuredTool = slot:FindFirstChild("DefaultToolName")
		local configuredName = slot:FindFirstChild("DefaultDisplayName")
		name = if configuredTool and configuredName and tool.Name == configuredTool.Value then configuredName.Value else tool.Name
	end
	slot.NameLabel.Text = name or tool.Name
	slot.ToolIcon.Image = tool.TextureId
	slot.ToolIcon.Visible = tool.TextureId ~= ""
	slot.FallbackIcon.Visible = not slot.ToolIcon.Visible
	local view = self:GetCooldownState(now)
	local overlay = slot.CooldownOverlay
	overlay.Visible = view.Blocked
	overlay.CooldownTimeLabel.Text = view.Text
	overlay.CooldownBarBackground.CooldownBarFill.Size = UDim2.new(view.Progress, 0, 1, 0)
end

function SlapController:_trace(phase: string, reason: string?, data: any?)
	if not RunService:IsStudio() or ReplicatedStorage:GetAttribute("SlapDiagnosticsEnabled") ~= true then return end
	local second = math.floor(os.clock())
	if self._diagnosticSecond ~= second then self._diagnosticSecond = second; self._diagnosticCount = 0 end
	if self._diagnosticCount >= 12 then return end
	self._diagnosticCount += 1
	local p = if type(data) == "table" then data else (self._pending or {})
	print("[SlapTrace] " .. HttpService:JSONEncode({
		Build = "CombatSystemV132", Side = "Client", Phase = phase, UserId = localPlayer.UserId,
		RequestId = p.RequestId, AttackId = p.ServerAttackId or p.AttackId,
		PredictionId = p.PredictionId, SessionId = self._sessionId,
		RoundId = self._roundId, CharacterGeneration = self._scope and self._scope.Generation,
		RecoveryUntil = self._localNextSlapTime, RejectionReason = reason,
		PredictionUntil = self._predictionUntil, RequestTime = p.RequestTime,
		ReportedRecoveryUntil = p.RecoveryUntil, RecoveryType = p.Outcome,
		AttackStartTime = p.AttackStartTime, AttackWindowClosed = p.AttackWindowClosed,
		HitConfirmed = p.Hit,
		ServerTime = workspace:GetServerTimeNow(),
	}))
end

function SlapController:_resetRecovery()
	self._pending = nil; self._awaitingUntil = 0; self._localNextSlapTime = 0; self._predictionUntil = 0
	self._visualStart = nil
	self:_stopSwing()
end

function SlapController:_refreshScope()
	local char = localPlayer.Character
	local sessionId = localPlayer:GetAttribute("MatchId")
	local roundId = if sessionId == self._sessionId then self._roundId else nil
	local generation = char and (char:GetAttribute("ArenaPhysicsGeneration") or 0)
	local scope = self._scope
	if not scope or scope.Character ~= char or scope.Generation ~= generation
		or scope.SessionId ~= sessionId or scope.RoundId ~= roundId then
		self:_resetRecovery()
		self._scope = { Character = char, Generation = generation, SessionId = sessionId, RoundId = roundId }
	end
	return self._scope
end

function SlapController:_acceptMatch(data: any): boolean
	if type(data) ~= "table" or data.SessionId ~= localPlayer:GetAttribute("MatchId")
		or type(data.SessionId) ~= "string" or type(data.StateVersion) ~= "number" then return false end
	if self._sessionId ~= data.SessionId then
		self._sessionId = data.SessionId; self._roundId = nil; self._roundIndex = 0
		self._stateVersion = -1; self._roundClosed = false; self._playing = false
		self:_resetRecovery()
	end
	if data.StateVersion < self._stateVersion then return false end
	self._stateVersion = data.StateVersion
	return true
end

function SlapController:_onMatchState(state: string, data: any)
	if not self:_acceptMatch(data) then return end
	self._matchState = state
	if state ~= "Playing" then
		self._playing = false; self._roundClosed = true; self:_resetRecovery()
	end
end

function SlapController:_onCountdown(_remaining: number, label: string, data: any)
	if label ~= "PLAYING" or not self:_acceptMatch(data)
		or type(data.RoundId) ~= "string" or type(data.RoundIndex) ~= "number"
		or data.RoundIndex < self._roundIndex then return end
	if data.RoundId ~= self._roundId then
		if data.RoundIndex <= self._roundIndex then return end
		self._roundIndex = data.RoundIndex; self._roundId = data.RoundId; self._roundClosed = false
		self:_refreshScope()
	end
	if data.Resolved then self._roundClosed = true; self:_resetRecovery() end
	self._playing = not self._roundClosed
	if self._playing then self._matchState = "Playing" end
end

function SlapController:_onFeedback(data: any)
	local scope = self:_refreshScope()
	local pending = self._pending
		if type(data) ~= "table" or data.Protocol ~= 3 or not pending
		or data.RequestId ~= pending.RequestId
		or data.PredictionId ~= pending.PredictionId
		or data.Character ~= scope.Character or data.Generation ~= scope.Generation
		or data.SessionId ~= scope.SessionId or data.RoundId ~= scope.RoundId
		or type(data.Sequence) ~= "number" or data.Sequence <= self._lastSequence then
		self:_trace("FeedbackIgnored", "ObsoleteOrUnrelated", data); return
	end
	if data.Phase ~= "Started" and data.Phase ~= "Rejected" and data.Phase ~= "Result" and data.Phase ~= "Cancelled" then return end
	if data.Phase ~= "Rejected" and (type(data.AttackId) ~= "string" or data.Accepted ~= true) then return end
	if pending.ServerAttackId and data.AttackId ~= pending.ServerAttackId then return end
	local ready = data.RecoveryUntil
	if ready ~= nil and (type(ready) ~= "number" or ready ~= ready or math.abs(ready) == math.huge) then return end
	self._lastSequence = data.Sequence
	self:_trace("FeedbackReceived", data.Reason, data)
	if data.Phase == "Started" then
		-- The prediction already animated at input. Bind server identity; never replay.
		pending.ServerAttackId = data.AttackId
		return
	end
	if data.Phase == "Result" and (ready == nil or (data.Outcome ~= "Hit" and data.Outcome ~= "Miss")) then return end
	if ready then self._localNextSlapTime = math.max(self._localNextSlapTime, ready) end
	if data.Phase == "Rejected" or data.Phase == "Cancelled" or data.Reason == "SwingInvalidated" then
		-- Correct THIS prediction only; a stale reply never gets past the scope checks.
		self:_stopSwing()
		self:_trace("PredictionCancelled", data.Reason, data)
	end
	if data.WindowPending then
		-- A rejected retry cannot pretend an earlier in-flight swing ended.
		return
	end
	-- Only a confirmed result may replace the conservative local prediction.
	-- In particular, an early rejection cannot turn the input back on immediately.
	if data.Phase == "Result" then self._predictionUntil = 0 end
	self._pending = nil; self._awaitingUntil = 0
end

--------------------------------------------------------------------------------
-- Remotes
--------------------------------------------------------------------------------

function SlapController:_getPerformRemote(): RemoteEvent?
	if self._performSlapRemote then return self._performSlapRemote end

	local remotes = ReplicatedStorage:WaitForChild("Remotes", 5) :: Folder?
	local combat = remotes and remotes:WaitForChild("Combat", 5) :: Folder?
	local remote = combat and combat:WaitForChild("PerformSlap", 5) :: RemoteEvent?
	if remote and remote:IsA("RemoteEvent") then
		self._performSlapRemote = remote
		return remote
	end
	return nil
end

--------------------------------------------------------------------------------
-- Animaciones y Ciclo del Tool
--------------------------------------------------------------------------------

local function isSlapTool(tool: Instance): boolean
	if not tool:IsA("Tool") then return false end
	if tool:GetAttribute("IsSlapWeapon") ~= true then return false end
	local config = tool:FindFirstChild("Configuration")
	if config and config:FindFirstChild("Power") then
		return true
	end
	return false
end

function SlapController:_onToolEquipped(tool: Tool)
	if not isSlapTool(tool) then return end
	if self._equippedTool == tool and self._swingTrack and self._activatedConn and self._activatedConn.Connected then return end

	self:_onToolUnequipped()
	self._equippedTool = tool

	-- Preparar animacion de swing si existe
	local swingAnim = tool:FindFirstChild("Swing") :: Animation?
	local char = localPlayer.Character
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")
	local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")

	if swingAnim and swingAnim:IsA("Animation") and animator then
		local ok, track = pcall(function()
			return animator:LoadAnimation(swingAnim)
		end)
		if ok and track then
			track.Priority = Enum.AnimationPriority.Action
			track.Looped = false
			self._swingTrack = track
		end
	end

	-- Conectar activacion del Tool
	self._activatedConn = tool.Activated:Connect(function()
		self:_onToolActivated(tool)
	end)
end

function SlapController:_onToolUnequipped()
	if self._activatedConn then
		self._activatedConn:Disconnect()
		self._activatedConn = nil
	end

	self:_stopSwing(true)

	self._equippedTool = nil
	-- Recovery belongs to the competitive life, never to this Tool.
end

function SlapController:_onToolActivated(tool: Tool)
	local scope = self:_refreshScope()
	local now = workspace:GetServerTimeNow()
	if self:GetCooldownState(now).Blocked then
		self:_trace("ClientBlocked", "RecoveryOrPending")
		return
	end
	local char = localPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not self._playing or self._roundClosed or not scope.RoundId or scope.SessionId ~= self._sessionId
		or self._equippedTool ~= tool or tool.Parent ~= char or not hum or hum.Health <= 0
		or hum.PlatformStand or hum:GetAttribute("MovementLocked") == true
		or char:GetAttribute("ArenaRespawnPending") or localPlayer:GetAttribute("ResultsSessionId") ~= nil then
		self:_trace("ClientBlocked", "CompetitiveState"); return
	end
	local remote = self:_getPerformRemote()
	if remote then
		-- Remote discovery may yield. Another input or lifecycle event can win meanwhile.
		now = workspace:GetServerTimeNow()
		if self:GetCooldownState(now).Blocked or self:_refreshScope() ~= scope
			or not self._playing or self._roundClosed or self._equippedTool ~= tool
			or tool.Parent ~= char or hum.Health <= 0 or hum.PlatformStand
			or hum:GetAttribute("MovementLocked") == true or char:GetAttribute("ArenaRespawnPending")
			or localPlayer:GetAttribute("ResultsSessionId") ~= nil then return end
		self._requestId += 1
		local predictionId = scope.SessionId .. ":Prediction:" .. tostring(localPlayer.UserId) .. ":" .. tostring(self._requestId)
		local request = { RequestId = self._requestId, PredictionId = predictionId, Character = char, Generation = scope.Generation,
			SessionId = scope.SessionId, RoundId = scope.RoundId }
		local combo = Config.Combat.SlapCombo
		local toolConfig = tool:FindFirstChild("Configuration")
		local cooldown = toolConfig and toolConfig:FindFirstChild("SlapCooldown")
		local predictedDuration = if combo.Enabled then combo.SwingWindow + combo.MissRecovery
			else (cooldown and cooldown.Value or Config.Combat.SlapCooldown)
		self._predictionUntil = now + predictedDuration
		self._visualStart = now
		self._pending = { RequestId = request.RequestId, AttackId = predictionId,
			PredictionId = predictionId, Tool = tool, RequestTime = now }
		self._awaitingUntil = now + 2 -- Transport retry only, never grants a hit or animation.
		self:_trace("ClientRequest")
		if self._swingTrack then
			pcall(function()
				self._swingTrack.Looped = false
				if self._swingTrack.IsPlaying then self._swingTrack:Stop(0) end
				self._swingTrack:Play(0.05, 1, 1.2)
			end)
		end
		self:_trace("PredictionPlayed")
		remote:FireServer(tool, request)
	end
end

--------------------------------------------------------------------------------
-- Enlace de Personaje
--------------------------------------------------------------------------------

function SlapController:_bindCharacter(character: Model)
	self._backpackHidden = false
	for _, connection in ipairs(self._characterConnections) do connection:Disconnect() end
	self._characterConnections = {}
	self:_onToolUnequipped()
	self:_refreshScope()

	-- Detectar herramientas equipadas
	table.insert(self._characterConnections, character.ChildAdded:Connect(function(child)
		if localPlayer.Character ~= character then return end
		if child:IsA("Tool") then
			self:_onToolEquipped(child)
		end
	end))

	table.insert(self._characterConnections, character.ChildRemoved:Connect(function(child)
		if child == self._equippedTool then
			self:_onToolUnequipped()
		end
	end))
	table.insert(self._characterConnections, character:GetAttributeChangedSignal("ArenaPhysicsGeneration"):Connect(function()
		self:_onToolUnequipped()
		self:_refreshScope()
		if localPlayer.Character == character then
			for _, child in ipairs(character:GetChildren()) do
				if isSlapTool(child) then self:_onToolEquipped(child); break end
			end
		end
	end))
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		table.insert(self._characterConnections, humanoid.Died:Connect(function()
			if localPlayer.Character ~= character then return end
			self._pending = nil; self._awaitingUntil = 0
			self:_onToolUnequipped()
		end))
	end

	-- Si ya tenia una herramienta equipada al iniciar
	for _, child in ipairs(character:GetChildren()) do
		if child:IsA("Tool") then
			self:_onToolEquipped(child)
			break
		end
	end
end

--------------------------------------------------------------------------------
-- Ciclo de Vida Bootstrap
--------------------------------------------------------------------------------

function SlapController:Init(context: any)
	self._context = context
	if self._initialized then return end
	self._initialized = true
	self._connections = {}; self._characterConnections = {}
	self._requestId = 0; self._lastSequence = 0; self._scope = nil
	self._sessionId = nil; self._roundId = nil; self._roundIndex = 0; self._stateVersion = -1
	self._playing = false; self._roundClosed = false; self:_resetRecovery()
	self:_getPerformRemote()
 local combat=ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Combat")
 local feedback=combat:WaitForChild("SlapFeedback",10)
 if feedback and feedback:IsA("RemoteEvent") then
  table.insert(self._connections, feedback.OnClientEvent:Connect(function(data) self:_onFeedback(data) end))
 end
	local match = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Match")
	table.insert(self._connections, match:WaitForChild("StateChanged").OnClientEvent:Connect(function(state, data)
		self:_onMatchState(state, data)
	end))
	table.insert(self._connections, match:WaitForChild("Countdown").OnClientEvent:Connect(function(remaining, label, data)
		self:_onCountdown(remaining, label, data)
	end))
	table.insert(self._connections, localPlayer:GetAttributeChangedSignal("MatchId"):Connect(function()
		self:_refreshScope()
	end))
end

function SlapController:Start(context: any)
	self._context = context
	if self._started then return end
	self._started = true
	self:_hideNativeBackpack()
	local gui = localPlayer:FindFirstChildOfClass("PlayerGui")
	local hud = gui and gui:FindFirstChild("PlayerHUD")
	self._slotRoot = hud and hud:FindFirstChild("CombatSlots")
	if not self._slotRoot then warn("[SlapController] PlayerHUD.CombatSlots missing") end
	table.insert(self._connections, RunService.RenderStepped:Connect(function()
		if not self._slotRoot or not self._slotRoot.Parent then
			local playerGui = localPlayer:FindFirstChildOfClass("PlayerGui")
			local currentHUD = playerGui and playerGui:FindFirstChild("PlayerHUD")
			self._slotRoot = currentHUD and currentHUD:FindFirstChild("CombatSlots")
		end
		self:_renderSlot()
	end))

	if localPlayer.Character then
		self:_bindCharacter(localPlayer.Character)
	end

	table.insert(self._connections, localPlayer.CharacterAdded:Connect(function(char)
		self:_bindCharacter(char)
	end))

	print("[SlapController] Controlador de Slaps iniciado y listo (CombatSystemV132 Protocol=3)")
end

function SlapController:Destroy()
	for _, connection in ipairs(self._characterConnections) do connection:Disconnect() end
	for _, connection in ipairs(self._connections) do connection:Disconnect() end
	self._characterConnections = {}; self._connections = {}
	self:_onToolUnequipped()
	self:_resetRecovery()
	if self._slotRoot then self._slotRoot.Visible = false end
	self._slotRoot = nil
	if self._originalBackpackEnabled ~= nil then
		pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, self._originalBackpackEnabled) end)
	end
	self._backpackHidden = false; self._originalBackpackEnabled = nil
	self._initialized = false; self._started = false
end

return SlapController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="4295">
          <Properties>
            <string name="Name">SocialController</string>
            <string name="Source"><![CDATA[--!nonstrict
local Players=game:GetService('Players')
local RS=game:GetService('ReplicatedStorage')
local RunService=game:GetService('RunService')
local UIS=game:GetService('UserInputService')
local CAS=game:GetService('ContextActionService')
local Tween=game:GetService('TweenService')
local Config=require(RS.Shared.SocialConfig)
local Catalog=require(RS.Shared.SlapCrates.Catalog)
local Targeting=require(script.Parent.Parent.Social.Targeting)
local Viewports=require(script.Parent.Parent.Social.ViewportPool)
local player=Players.LocalPlayer
local Controller={Name='SocialController'}
local PROFILE_ACTION='SlapDuelsSocialProfile'
local terminal={Cancelled=true,Completed=true,FailedRecoverable=true}
local reasons={TradeCommitDisabled='PRUEBA FINALIZADA: no se transfirió ningún Slap.',RateLimited='Esperá un momento antes de volver a intentar.',
 OutOfRange='El jugador está fuera del alcance.',PlayerUnavailable='Jugador no disponible o en partida.',PlayerBusy='Uno de los jugadores ya tiene una solicitud o trade.',
 InviteCooldown='Esperá antes de enviar otra invitación.',ItemNotTradable='Este artículo no es comerciable.',StaleRevision='La oferta cambió. Revisala nuevamente.',
 OffersLocked='La oferta está bloqueada durante la confirmación.',InvitationDeclined='Solicitud rechazada.',Expired='La solicitud o el trade expiró.',InvitationsDisabled='El jugador no recibe solicitudes.'}
local function text(reason)return reasons[reason]or tostring(reason or '')end
local categoryNames={Slaps='SLAPS',PointEffects='EFECTOS DE PUNTO',DeathEffects='EFECTOS DE MUERTE'}
local rarityColors={Basic=Color3.fromRGB(220,225,235),Common=Color3.fromRGB(190,205,220),Rare=Color3.fromRGB(69,138,255),Epic=Color3.fromRGB(145,58,225),Legendary=Color3.fromRGB(255,156,37)}
function Controller:EquipItem(item)
 if self.PendingEquip or self.PendingProfile or self.ProfileMode~='SelfProfile'or self.ProfileTarget~=player.UserId or not self.Profile.Enabled or item.Equipped then return end
 if item.Available==false then self:Message('Este recurso no está disponible.');return end
 local category=item.Category or 'Slaps';if not categoryNames[category]then return end
 self.PendingEquip=true;local generation=self.Generation;local page=self.ProfilePage
 self:Message('Guardando selección…')
 task.spawn(function()
  local ok,response=pcall(self.Equip.InvokeServer,self.Equip,category,item.ProductId or item.RewardId,page)
  self.PendingEquip=false
  if generation~=self.Generation or self.ProfileMode~='SelfProfile'or self.ProfileTarget~=player.UserId then return end
  if not ok or type(response)~='table'then self:Message('No se pudo confirmar. Actualizá el inventario para revisar tu selección.');return end
  if not response.Ok then self:Message(text(response.Reason));return end
  if response.Profile and response.Profile.UserId==player.UserId then self:ApplyProfile(response.Profile,true);self:Message('Selección equipada para tus partidas.')end
 end)
end
function Controller:Sound(gui,name)
 local folder=gui and gui:FindFirstChild('Audio');local sound=folder and folder:FindFirstChild(name)
 if self.LastSound and self.LastSound.IsPlaying then self.LastSound:Stop()end
 if sound and sound.SoundId~=''then sound:Play();self.LastSound=sound end
end
function Controller:Message(message)
 local shown=false
 for _,gui in ipairs({self.Profile,self.Request,self.Trade})do if gui.Enabled then gui.MainFrame.Status.Text=message;shown=true end end
 if not shown then
  local social=self.Context and self.Context:GetController('SocialPlayController')
  if social and social.Hud and social.Hud.Enabled then social:Notice(message)
  else warn('[Social] '..tostring(message)) end
 end
end
function Controller:RequestAction(action,id,revision,value,callback)
 if self.PendingAction then return end
 self.PendingAction=true
 task.spawn(function()
  local ok,response=pcall(self.Action.InvokeServer,self.Action,action,id,revision,value)
  self.PendingAction=false
  if not ok or type(response)~='table'then self:Message('No se pudo contactar al servidor.');return end
  if not response.Ok then self:Sound(self.Trade.Enabled and self.Trade or self.Profile,'Error');self:Message(text(response.Reason))end
  if callback then callback(response)end
  if self.PendingInventoryPage then local page=self.PendingInventoryPage;self.PendingInventoryPage=nil;task.delay(.3,function()self:OwnPage(page)end)end
 end)
end
function Controller:ClearCards(container)
 for i=#self.Cards,1,-1 do local record=self.Cards[i]
  if record.Container==container then
   self.Pool:Remove(record.View)
   if record.Connection then record.Connection:Disconnect()end
   record.Card:Destroy();table.remove(self.Cards,i)
  end
 end
end
function Controller:RefreshPreviews()
 local live=0
 for _,entry in ipairs(self.Cards)do
  local s=entry.Container;local visible=entry.Gui.Enabled and s.Visible
  local pos,size=entry.Card.AbsolutePosition,entry.Card.AbsoluteSize;local p,z=s.AbsolutePosition,s.AbsoluteSize
  visible=visible and pos.Y+size.Y>p.Y and pos.Y<p.Y+z.Y and pos.X+size.X>p.X and pos.X<p.X+z.X
  if visible and live<Config.MaxActivePreviews-2 then
   if (entry.Item.Category==nil or entry.Item.Category=='Slaps')and self.Pool:Slap(entry.View,entry.Item)then live+=1 end
  else self.Pool:Remove(entry.View)end
 end
end
function Controller:CardsFor(gui,container,items,mode)
 self:ClearCards(container)
 local template=gui.CardTemplate
 for index,item in ipairs(items)do
  local card=template:Clone();card.Name='Item_'..index;card.LayoutOrder=index;card.Visible=true
  card:FindFirstChild('ItemName').Text=item.DisplayName;card.Variation.Text=item.VariationName
  local variation=Catalog.Variations.ById[item.VariationId];local color=variation and variation.Color or rarityColors[item.Rarity]or Color3.fromRGB(90,205,220)
  card.Accent.Color=color;card.Variation.TextColor3=color
  card.Aura.BackgroundColor3=color;card.Preview.BackgroundTransparency=1
  card.Aura.Gradient.Color=ColorSequence.new(color,Color3.fromRGB(12,20,32))
  local ownProfile=gui==self.Profile and self.ProfileMode=='SelfProfile'and self.ProfileTarget==player.UserId
  card.State.Text=ownProfile and(item.Equipped and 'EQUIPADO'or item.Available==false and 'NO DISPONIBLE'or 'EQUIPAR')or ((item.Equipped and 'EQUIPADO · 'or '')..(item.Tradable and(mode=='Add'and '+ OFRECER'or mode=='Remove'and 'RETIRAR'or 'COMERCIABLE')or 'NO COMERCIABLE'))
  card.UnitId.Text=item.Category and item.Category~='Slaps'and 'PERSONAL · NO INTERCAMBIABLE'or(item.Tradable and 'SLAP INTERCAMBIABLE'or 'SLAP NO INTERCAMBIABLE');card.UnitId.TextSize=10
  local effect=card:FindFirstChild('EffectBadge')
  if effect then effect.Visible=item.Category~=nil and item.Category~='Slaps';effect.Text=item.Category=='PointEffects'and 'PUNTO'or 'MUERTE';effect.TextColor3=color;card.Preview.Visible=not effect.Visible end
  card.Parent=container
  local connection=card.Activated:Connect(function()
   if ownProfile then self:EquipItem(item)
   elseif mode and item.UnitId and self.CurrentTrade and (mode=='Remove'or item.Tradable)then
    local t=self.CurrentTrade;self:RequestAction(mode,t.TradeId,t.Revision,item.UnitId)
   end
   self:Sound(gui,'Click')
   Tween:Create(card.Accent,TweenInfo.new(.15),{Thickness=3}):Play()
  end)
  table.insert(self.Cards,{Card=card,View=card.Preview,Item=item,Container=container,Gui=gui,Connection=connection})
 end
 local grid=container:FindFirstChildOfClass('UIGridLayout')
 if grid then
  local columns=container.AbsoluteSize.X>=300 and 3 or container.AbsoluteSize.X>=185 and 2 or 1
  grid.CellSize=UDim2.new(1/columns,-8,0,180)
 end
end
function Controller:Show(gui)
 self.DisplayTokens[gui]=(self.DisplayTokens[gui]or 0)+1
 if self.Fades[gui]then self.Fades[gui]:Cancel();self.Fades[gui]:Destroy()end
 gui.Enabled=true;gui.MainFrame.GroupTransparency=1
 local fade=Tween:Create(gui.MainFrame,TweenInfo.new(.2),{GroupTransparency=0});self.Fades[gui]=fade;fade:Play();self:Sound(gui,'Open')
end
function Controller:Close(gui)
 local navigation=self.Context and self.Context:GetController('WindowNavigationController');if navigation then navigation:Forget(gui.Name)end
 self.DisplayTokens[gui]=(self.DisplayTokens[gui]or 0)+1;local token=self.DisplayTokens[gui]
 if self.Fades[gui]then self.Fades[gui]:Cancel();self.Fades[gui]:Destroy();self.Fades[gui]=nil end
 if gui.Enabled then
  self:Sound(gui,'Close')
  local fade=Tween:Create(gui.MainFrame,TweenInfo.new(.15),{GroupTransparency=1});self.Fades[gui]=fade;fade:Play()
  task.delay(.16,function()if self.DisplayTokens[gui]==token then gui.Enabled=false end end)
 end
 self.Generation+=1
 for _,entry in ipairs(self.Cards)do if entry.Gui==gui then self.Pool:Remove(entry.View)end end
 if gui==self.Profile then local summary=gui.MainFrame:FindFirstChild('Summary');if summary then self.Pool:Remove(summary.Equipped.Preview)end;self.ProfileData=nil;self.Pool:Remove(gui.MainFrame.Avatar);self.ProfileTarget=nil;self.ProfileMode=nil;self.NextSelfRefresh=nil end
 if gui==self.Request then self.Pool:Remove(gui.MainFrame.Avatar)end
 if gui==self.Trade then self.Pool:Remove(gui.MainFrame.Mine.Avatar);self.Pool:Remove(gui.MainFrame.Theirs.Avatar)end
 local containers={};for _,entry in ipairs(self.Cards)do if entry.Gui==gui then containers[entry.Container]=true end end
 for container in pairs(containers)do self:ClearCards(container)end
end
-- These existing windows own their own lifecycle; this controller never changes them.
function Controller:WindowBusy()
 local gui=player:FindFirstChild('PlayerGui')
 if not gui then return true end
 for _,name in ipairs({'ShopHUD','PremiumShopHUD','SettingsGUI','CrateOpeningHUD'})do
  local hud=gui:FindFirstChild(name)
  local main=hud and hud:FindFirstChild('MainFrame')
  local navigation=self.Context and self.Context:GetController('WindowNavigationController')
  if hud and hud.Enabled and (name=='CrateOpeningHUD'or not navigation and main and main.Visible)then return true end
 end
 return self.Request.Enabled or self.Trade.Enabled
end
function Controller:SetArticlesMode(show)
 if show and self.ProfileMode=='SelfProfile' and self.ProfileTarget==player.UserId then
  local inventory=self.Context and self.Context:GetController('InventoryController')
  if inventory then inventory:Open();return end
 end
 local m=self.Profile.MainFrame;local summary=m:FindFirstChild('Summary')
 if not summary then return end
 self.ArticlesVisible=show;summary.Visible=not show;m.Collection.Visible=show
 for _,name in ipairs({'InventoryTabs','CollectionTitle','CollectionHint'})do local o=m:FindFirstChild(name);if o then o.Visible=show end end
 local loadout=m:FindFirstChild('SelectedEffects');if loadout then loadout.Visible=not show end
 for _,name in ipairs({'Previous','Page','Next'})do m[name].Visible=show end
 m.Articles.Text=show and 'Volver al perfil'or 'Ver inventario'
 local cards=m:FindFirstChild('ProgressCards');if cards then cards.Visible=not show end
 local label=m.Articles:FindFirstChild('ActionLabel');if label then label.Text=m.Articles.Text end
 if not show then for _,entry in ipairs(self.Cards)do if entry.Gui==self.Profile then self.Pool:Remove(entry.View)end end end
end
function Controller:ProfileActions(data)
 local m=self.Profile.MainFrame;local own=data.UserId==player.UserId
 local target=Players:GetPlayerByUserId(data.UserId)
 local solo=not player:GetAttribute('SocialGroupId')and target and not target:GetAttribute('SocialGroupId')
 for _,entry in ipairs({{'Challenge',not own and solo and data.Actions and data.Actions.Challenge},{'Invite',not own and data.Actions and data.Actions.Invite}})do
  local button=m:FindFirstChild(entry[1]);if button then local enabled=entry[2]==true;button.Visible=enabled;button.Active=enabled;button.Selectable=enabled end
 end
 local articles=m:FindFirstChild('Articles')
 local badge=m:FindFirstChild('ProfileBadge');if badge and m.AbsoluteSize then badge.Visible=m.AbsoluteSize.X>=560 end
 if articles then articles.Position=UDim2.new(.02,0,.87,0);articles.Size=UDim2.new(own and .96 or .225,0,.095,0)end
end
function Controller:ApplyProfile(data,refresh)
 if type(data)~='table'or player:GetAttribute('MatchId')or self:WindowBusy()then return false end
 local owner=Players:GetPlayerByUserId(data.UserId)
 local own=data.UserId==player.UserId
 if not owner or data.ProfileMode~=(own and 'SelfProfile'or 'OtherPlayerProfile')then return false end
 self.ProfileTarget=data.UserId;self.ProfileMode=data.ProfileMode
 self.ProfilePage=data.Page;self.ProfileHasNext=data.HasNext
 self.NextSelfRefresh=workspace:GetServerTimeNow()+Config.SelfProfileRefreshSeconds
 if not refresh then self:Show(self.Profile)end
 local m=self.Profile.MainFrame
 m.Trade.Visible=not own;m.Trade.Active=not own;m.Trade.Selectable=not own
 m.Trade.AutoButtonColor=not own
 self.ProfileData=data;self:ProfileActions(data)
 if not refresh then self:SetArticlesMode(false)end
 local summary=m:FindFirstChild('Summary')
 if summary then
  summary.Streak.Value.Text=tostring(data.Stats.Streaks or 0);summary.Wins.Value.Text=tostring(data.Stats.Wins);summary.Kills.Value.Text=tostring(data.Stats.TotalKills)
 end
 local username=m:FindFirstChild('Username')
 if username then m.Identity.Text=data.DisplayName;username.Text='@'..data.Username
 else m.Identity.Text=data.DisplayName..'\n@'..data.Username end
 local badge=m:FindFirstChild('ProfileBadge');if badge then badge.Label.Text=own and 'TU PERFIL'or 'JUGADOR'end
 local collectionTitle=m:FindFirstChild('CollectionTitle');if collectionTitle then collectionTitle.Text='COLECCIÓN  /  '..tostring(data.TotalItems)..' ARTÍCULOS'end
 local hint=m:FindFirstChild('CollectionHint');if hint then hint.Text=own and 'Tocá un artículo para equiparlo. Solo los Slaps admiten intercambio.'or 'Colección de consulta. Solo los Slaps admiten intercambio.'end
 if summary then local tile=summary:FindFirstChild('Equipped');local heading=tile and tile:FindFirstChild('Eyebrow');if heading then heading.Text=own and 'TU SLAP EQUIPADO'or 'SLAP EQUIPADO'end end
 m.Stats.Text=string.format('VICTORIAS %d\nDERROTAS %d\nKILLS %d',data.Stats.Wins,data.Stats.Losses,data.Stats.TotalKills)
 m.Progression.Text='NIVEL '..tostring(owner:GetAttribute('Level')or 0)..' · Derrotas '..tostring(data.Stats.Losses);m.Page.Text=string.format('%d · %d artículos',data.Page,data.TotalItems)
 local progression=self.Context and self.Context:GetController('BattlePassController');if progression then progression:RenderProfile()end
 m.Status.Text=''
 -- Keep the same avatar and card pool on unchanged refreshes (no rotation reset).
 if not refresh then self.Pool:Remove(m.Avatar);self.Pool:Add(m.Avatar,owner,true)end
 local category=data.Category or 'Slaps';self.ProfileCategory=category
 local tabs=m:FindFirstChild('InventoryTabs');if tabs then for key in pairs(categoryNames)do tabs[key].BackgroundColor3=key==category and Color3.fromRGB(29,105,145)or Color3.fromRGB(20,30,45)end end
 local selected=m:FindFirstChild('SelectedEffects')
 if selected then for _,key in ipairs({'PointEffects','DeathEffects'})do local item=data.EquippedLoadout and data.EquippedLoadout[key];selected[key].Text=(key=='PointEffects'and 'PUNTO: 'or 'MUERTE: ')..(item and item.DisplayName or 'Sin selección disponible')end end
 local fingerprint=game:GetService('HttpService'):JSONEncode({Inventory=data.Inventory,Loadout=data.EquippedLoadout,Category=category})..':'..tostring(data.EquippedSlap and data.EquippedSlap.RewardId)
 if not refresh or self.ProfileInventoryFingerprint~=fingerprint then
  self.ProfileInventoryFingerprint=fingerprint
  self:CardsFor(self.Profile,m.Collection,data.Inventory,nil)
  if summary then
   local equipped=data.EquippedSlap
   self.Pool:Remove(summary.Equipped.Preview)
   if equipped then self.Pool:Slap(summary.Equipped.Preview,equipped);summary.Equipped.Caption.Text=string.find(string.lower(equipped.DisplayName),string.lower(equipped.VariationName),1,true)and equipped.DisplayName or equipped.DisplayName..' · '..equipped.VariationName
   else summary.Equipped.Caption.Text='Consultá Ver artículos para ver el Slap equipado'end
  end
 end
 return true
end
function Controller:OpenProfile(id,page,refresh,category)
 if self.PendingProfile or self.PendingEquip or player:GetAttribute('MatchId')or self:WindowBusy()then return end
 category=category or(refresh and self.ProfileCategory)or 'Slaps'
 local own=id==player.UserId
 self.PendingProfile=true;local generation=self.Generation
 task.spawn(function()
  local remote=own and self.SelfInspect or self.Inspect
  local ok,response
  if own then ok,response=pcall(remote.InvokeServer,remote,page,category)
  else ok,response=pcall(remote.InvokeServer,remote,id,page,category)end
  self.PendingProfile=false
  if generation~=self.Generation then return end
  if not ok or type(response)~='table'or not response.Ok then
   if refresh then
    self.NextSelfRefresh=workspace:GetServerTimeNow()+Config.RequestIntervalSeconds
    if type(response)=='table'and response.Reason~='RateLimited'then self:Close(self.Profile)end
   else self:Message(text(type(response)=='table'and response.Reason or 'Error de red'))end
   return
  end
  if response.Profile.UserId~=id then return end
  self:ApplyProfile(response.Profile,refresh)
 end)
end
function Controller:OpenSelfProfile()
 if self.Profile.Enabled and self.ProfileMode=='SelfProfile'then self:Close(self.Profile);return end
 self:OpenProfile(player.UserId,1)
end
function Controller:BindProfileButton(button)
 local base=button.BackgroundColor3
 table.insert(self.Connections,button.Activated:Connect(function()self:Sound(self.Profile,'Click');self:OpenSelfProfile()end))
 table.insert(self.Connections,button.MouseEnter:Connect(function()
  self:Sound(self.Profile,'Hover');Tween:Create(button,TweenInfo.new(.12),{BackgroundColor3=base:Lerp(Color3.fromRGB(70,160,195),.25)}):Play()
 end))
 table.insert(self.Connections,button.MouseLeave:Connect(function()Tween:Create(button,TweenInfo.new(.12),{BackgroundColor3=base}):Play()end))
end
function Controller:OwnPage(page)
 local t=self.CurrentTrade;if not t or terminal[t.State]then return end
 if self.PendingAction then self.PendingInventoryPage=page;return end
 self:RequestAction('Inventory',t.TradeId,t.Revision,page,function(response)
  if not response.Ok or not self.CurrentTrade or self.CurrentTrade.TradeId~=t.TradeId or terminal[self.CurrentTrade.State]then return end
  self.OwnPageNumber=response.Profile.Page;self.OwnHasNext=response.Profile.HasNext
  self.Trade.MainFrame.Page.Text='PÁGINA '..response.Profile.Page
  self:CardsFor(self.Trade,self.Trade.MainFrame.Mine.Inventory,response.Profile.Inventory,'Add')
 end)
end
function Controller:TradePacket(t)
 local previous=self.CurrentTrade
 if previous and previous.TradeId==t.TradeId and (t.Sequence or 0)<=(previous.Sequence or 0)then return end
 self.CurrentTrade=t
 if terminal[t.State]then
  self.Request.MainFrame.Requester.Text=text(t.Reason);self:Close(self.Request)
  if self.Trade.Enabled then self.Trade.MainFrame.Status.Text=text(t.Reason);self.Trade.MainFrame.Accept.Active=false;self.Trade.MainFrame.Confirm.Active=false;self:Sound(self.Trade,'Cancel')end
  self:Message(text(t.Reason));return
 end
 local uid=player.UserId;local mine=tostring(uid);local other=tostring(t.A==uid and t.B or t.A)
 if t.State=='Requested'then
  if t.B==uid then
   self:Show(self.Request);self.Request.MainFrame.Requester.Text=t.Names[tostring(t.A)]..' quiere intercambiar Slaps.'
   self.Request.MainFrame.Status.Text='Solo negociación: transferencias reales desactivadas.'
   self.Pool:Add(self.Request.MainFrame.Avatar,Players:GetPlayerByUserId(t.A),true)
  else self:Message('Solicitud enviada. Esperando respuesta.')end
  return
 end
 if not(self.Context and self.Context:GetController('WindowNavigationController'))then self:Close(self.Profile)end;self:Close(self.Request)
 local navigation=self.Context and self.Context:GetController('WindowNavigationController')
 if not self.Trade.Enabled and not(navigation and navigation:Contains('TradeHUD'))then self:Show(self.Trade)end
 local m=self.Trade.MainFrame
 m.Mine.Identity.Text=t.Names[mine];m.Theirs.Identity.Text=t.Names[other]
 m.Mine.Accepted.Text=t.Accepted[mine]and 'OFERTA ACEPTADA'or 'REVISANDO'
 m.Theirs.Accepted.Text=t.Accepted[other]and 'OFERTA ACEPTADA'or 'REVISANDO'
 for _,entry in ipairs({{Label=m.Mine.Accepted,Accepted=t.Accepted[mine]},{Label=m.Theirs.Accepted,Accepted=t.Accepted[other]}})do
  Tween:Create(entry.Label,TweenInfo.new(.18),{TextColor3=entry.Accepted and Color3.fromRGB(110,235,160)or Color3.fromRGB(180,205,225)}):Play()
 end
 self:CardsFor(self.Trade,m.Mine.Offers,t.Offers[mine]or {},'Remove')
 self:CardsFor(self.Trade,m.Theirs.Offers,t.Offers[other]or {},nil)
 self.Pool:Add(m.Mine.Avatar,player,true);self.Pool:Add(m.Theirs.Avatar,Players:GetPlayerByUserId(tonumber(other)),true)
 m.Accept.Active=t.State=='Negotiating';m.Confirm.Active=t.State=='FinalConfirmation'
 m.Accept.AutoButtonColor=m.Accept.Active;m.Confirm.AutoButtonColor=m.Confirm.Active
 m.Status.Text=t.State=='FinalConfirmation'and 'REVISÁ LO QUE ENTREGÁS Y RECIBÍS. Confirmación individual obligatoria.'or 'NEGOCIACIÓN DE PRUEBA · NO TRANSFIERE OBJETOS'
 if not previous or previous.TradeId~=t.TradeId or previous.State=='Requested'then task.delay(.3,function()self:OwnPage(1)end)end
end
function Controller:TraceProfileInput(event)
 if player:GetAttribute('SocialProfileInputDebug') then
  print('[SocialProfileInput]',event,self.Target and self.Target.UserId or 'none')
 end
end
function Controller:CancelProfileHold()
 local hold=self.ProfileHold
 self.ProfileHold=nil
 if not hold then return end
 if hold.Thread then pcall(task.cancel,hold.Thread);hold.Thread=nil end
 if hold.Prompt.Parent then pcall(hold.Prompt.InputHoldEnd,hold.Prompt) end
 self:TraceProfileInput('HoldCancelled')
end
function Controller:ActivateProfileTarget(target,character,prompt)
 local camera=workspace.CurrentCamera
 local inventory=self.Context and self.Context:GetController('InventoryController')
 if self.Target~=target or self.Prompt~=prompt or target.Character~=character or self.PendingProfile or self.PendingEquip
  or self.Profile.Enabled or self.Request.Enabled or self.Trade.Enabled or self:WindowBusy()
  or inventory and inventory.Hud and inventory.Hud.Enabled
  or not Targeting.Valid(player,target,Config.InspectDistance) or not camera
  or not Targeting.Visible(workspace,player,target,camera.CFrame.Position) then self:TraceProfileInput('RejectedOrStale');return end
 self:TraceProfileInput('Activate')
 -- Invalidate both native Triggered and the explicit hold before starting the request.
 self:SetTarget(nil)
 self:OpenProfile(target.UserId)
end
function Controller:BindProfileInput(target,character,prompt)
 CAS:BindActionAtPriority(PROFILE_ACTION,function(_,state,input)
  if state==Enum.UserInputState.Begin then
   if UIS:GetFocusedTextBox() then self:TraceProfileInput('TextFocus');return Enum.ContextActionResult.Pass end
   if self.ProfileHold then return Enum.ContextActionResult.Sink end
   local hold={Prompt=prompt,Key=input.KeyCode,ViewerCharacter=player.Character}
   self.ProfileHold=hold
   self:TraceProfileInput('HoldBegin')
   hold.Thread=task.delay(prompt.HoldDuration,function()
    hold.Thread=nil
    if self.ProfileHold~=hold or player.Character~=hold.ViewerCharacter or UIS:GetFocusedTextBox() then return end
    self:TraceProfileInput('HoldComplete')
    self:ActivateProfileTarget(target,character,prompt)
   end)
   -- Keep the native progress ring for keyboard/controller as well as click/touch.
   pcall(prompt.InputHoldBegin,prompt)
  elseif state==Enum.UserInputState.Cancel or state==Enum.UserInputState.End then
   if self.ProfileHold and (state==Enum.UserInputState.Cancel or input.KeyCode==self.ProfileHold.Key) then self:CancelProfileHold() end
  end
  return Enum.ContextActionResult.Sink
 end,false,Enum.ContextActionPriority.High.Value,Enum.KeyCode.F,Enum.KeyCode.ButtonY)
 self.ProfileInputBound=true
 self:TraceProfileInput('Bound')
end
function Controller:SetTarget(target)
 if target and not Targeting.Valid(player,target,Config.InspectDistance) then target=nil end
 local character=target and target.Character
 local root=character and character:FindFirstChild('HumanoidRootPart')
 if self.Target==target and (not target or self.Prompt and self.Prompt.Parent==root and self.Prompt.Enabled)then return end
 self:CancelProfileHold()
 if self.ProfileInputBound then CAS:UnbindAction(PROFILE_ACTION);self.ProfileInputBound=nil end
 if self.PromptConnection then self.PromptConnection:Disconnect();self.PromptConnection=nil end
 if self.Prompt then self.Prompt:Destroy();self.Prompt=nil end
 if self.Highlight then self.Highlight:Destroy();self.Highlight=nil end
 self.Target=target
 if not target then return end
 local prompt=Instance.new('ProximityPrompt');prompt.Name='SocialProfilePrompt';prompt.ActionText='Ver perfil';prompt.ObjectText=target.DisplayName
 prompt.HoldDuration=Config.PromptHoldSeconds;prompt.MaxActivationDistance=Config.InspectDistance;prompt.RequiresLineOfSight=false
 -- E/X belong to shops/NPCs nearby. Only this one local social prompt uses F/Y.
 prompt.KeyboardKeyCode=Enum.KeyCode.F;prompt.GamepadKeyCode=Enum.KeyCode.ButtonY
 prompt.Exclusivity=Enum.ProximityPromptExclusivity.AlwaysShow;prompt.ClickablePrompt=true;prompt.Parent=root
 local highlight=Instance.new('Highlight');highlight.Name='SocialTargetHighlight';highlight.Adornee=target.Character
 highlight.FillTransparency=.85;highlight.OutlineColor=Color3.fromRGB(74,210,240);highlight.FillColor=highlight.OutlineColor
 highlight.DepthMode=Enum.HighlightDepthMode.Occluded;highlight.Parent=target.Character
 self.Prompt=prompt;self.Highlight=highlight
 self.PromptConnection=prompt.Triggered:Connect(function()
  self:TraceProfileInput('NativeTriggered')
  self:ActivateProfileTarget(target,character,prompt)
 end)
 self:BindProfileInput(target,character,prompt)
end
function Controller:PollTarget()
 local inventory=self.Context and self.Context:GetController('InventoryController')
 if inventory and inventory.Hud and inventory.Hud.Enabled then self:SetTarget(nil);return end
 if self.PendingProfile or self.PendingEquip or self.Profile.Enabled or self.Request.Enabled or self.Trade.Enabled or player:GetAttribute('MatchId')or self:WindowBusy()then self:SetTarget(nil);return end
 local camera=workspace.CurrentCamera;if not camera then self:SetTarget(nil);return end
 local point=UIS:GetMouseLocation();local ray
 if UIS.TouchEnabled or UIS.GamepadEnabled then ray=camera:ViewportPointToRay(camera.ViewportSize.X/2,camera.ViewportSize.Y/2)
 else ray=camera:ScreenPointToRay(point.X,point.Y)end
 local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude;params.FilterDescendantsInstances=player.Character and {player.Character}or {}
 local hit=workspace:Raycast(ray.Origin,ray.Direction*200,params)
 local target=hit and Targeting.FromHit(Players,hit.Instance)
 self:SetTarget(Targeting.Select(player,Players:GetPlayers(),target,Config.InspectDistance,function(candidate)
  return Targeting.Visible(workspace,player,candidate,camera.CFrame.Position)
 end))
end
function Controller:Init(context)
 if self.Initialized then return end
 self.Initialized=true;self.Context=context
 self.Generation=0;self.Cards={};self.Connections={};self.DisplayTokens={};self.Fades={};self.Pool=Viewports.new(Config.MaxActivePreviews)
 local gui=player:WaitForChild('PlayerGui')
 self.Profile=gui:WaitForChild('PlayerProfileHUD',15);self.Request=gui:WaitForChild('TradeRequestHUD',15);self.Trade=gui:WaitForChild('TradeHUD',15)
 assert(self.Profile and self.Request and self.Trade,'Social HUDs missing in Edit')
 local remotes=RS:WaitForChild('Remotes'):WaitForChild('Social');self.SelfInspect=remotes:WaitForChild('SelfProfile');self.Inspect=remotes:WaitForChild('Inspect');self.Action=remotes:WaitForChild('Action');self.Update=remotes:WaitForChild('Updated')
 self.Equip=remotes:WaitForChild('Equip')
 for _,hud in ipairs({self.Profile,self.Request,self.Trade})do
  hud.Enabled=false
  for _,button in ipairs(hud:GetDescendants())do if button:IsA('TextButton')then
   local surface=hud==self.Profile and button:FindFirstChild('Surface')
   local visual=surface or button;local base=visual.BackgroundColor3
   local border=surface and button:FindFirstChild('Stroke');local thickness=border and border.Thickness
   table.insert(self.Connections,button.MouseEnter:Connect(function()
    self:Sound(hud,'Hover');Tween:Create(visual,TweenInfo.new(.12),{BackgroundColor3=base:Lerp(Color3.fromRGB(135,210,255),surface and .15 or .25)}):Play()
    if border then Tween:Create(border,TweenInfo.new(.12),{Thickness=thickness+1}):Play()end
   end))
   table.insert(self.Connections,button.MouseLeave:Connect(function()
    Tween:Create(visual,TweenInfo.new(.12),{BackgroundColor3=base}):Play()
    if border then Tween:Create(border,TweenInfo.new(.12),{Thickness=thickness}):Play()end
   end))
  end end
 end
 self:BindProfileButton(gui:WaitForChild('PlayerHUD'):WaitForChild('ProfileButton',15))
 local function connect(button,fn)table.insert(self.Connections,button.Activated:Connect(fn))end
 local articles=self.Profile.MainFrame:FindFirstChild('Articles')
 if articles then connect(articles,function()self:Sound(self.Profile,'Click');self:SetArticlesMode(not self.ArticlesVisible)end)end
 for _,entry in ipairs({{'Challenge','Duel'},{'Invite','Group'}})do
  local button=self.Profile.MainFrame:FindFirstChild(entry[1])
  if button then connect(button,function()
   if button.Active and self.ProfileMode=='OtherPlayerProfile'and self.ProfileTarget~=player.UserId then
    local play=self.Context and self.Context:GetController('SocialPlayController')
    if play then self:Sound(self.Profile,'Click');play:Invite(entry[2],self.ProfileTarget)end
   end
  end)end
 end
 connect(self.Profile.MainFrame.Close,function()self:Close(self.Profile)end)
 connect(self.Profile.MainFrame.Previous,function()if (self.ProfilePage or 1)>1 then self:OpenProfile(self.ProfileTarget,self.ProfilePage-1,true,self.ProfileCategory)end end)
 connect(self.Profile.MainFrame.Next,function()if self.ProfileHasNext then self:OpenProfile(self.ProfileTarget,self.ProfilePage+1,true,self.ProfileCategory)end end)
 local tabs=self.Profile.MainFrame:FindFirstChild('InventoryTabs')
 if tabs then for category in pairs(categoryNames)do connect(tabs[category],function()if self.ProfileTarget then self:OpenProfile(self.ProfileTarget,1,true,category)end end)end end
 connect(self.Profile.MainFrame.Trade,function()if self.ProfileMode=='OtherPlayerProfile'and self.ProfileTarget and self.ProfileTarget~=player.UserId and self.Profile.MainFrame.Trade.Active then self:RequestAction('Invite',self.ProfileTarget)end end)
 local function act(name,value)local t=self.CurrentTrade;if t then self:RequestAction(name,t.TradeId,t.Revision,value)end end
 connect(self.Request.MainFrame.Accept,function()self:Sound(self.Request,'Accept');act('Respond',true)end)
 connect(self.Request.MainFrame.Decline,function()act('Respond',false)end)
 connect(self.Request.MainFrame.Close,function()act('Respond',false)end)
 connect(self.Trade.MainFrame.Close,function()if self.CurrentTrade and terminal[self.CurrentTrade.State]then self:Close(self.Trade)else act('Cancel')end end)
 connect(self.Trade.MainFrame.Cancel,function()if self.CurrentTrade and terminal[self.CurrentTrade.State]then self:Close(self.Trade)else act('Cancel')end end)
 connect(self.Trade.MainFrame.Accept,function()self:Sound(self.Trade,'Accept');act('Accept')end)
 connect(self.Trade.MainFrame.Confirm,function()self:Sound(self.Trade,'Confirm');act('Confirm')end)
 connect(self.Trade.MainFrame.Previous,function()if (self.OwnPageNumber or 1)>1 then self:OwnPage(self.OwnPageNumber-1)end end)
 connect(self.Trade.MainFrame.Next,function()if self.OwnHasNext then self:OwnPage(self.OwnPageNumber+1)end end)
end
function Controller:Start()
 if self.Started then return end
 self.Started=true
 if not self.Update or not self.Profile or not self.Request or not self.Trade then warn('[Social] Init incomplete; controller disabled');return end
 table.insert(self.Connections,self.Update.OnClientEvent:Connect(function(kind,payload)
  if kind=='Trade'then self:TradePacket(payload)
  elseif kind=='ProfileUnavailable'and self.ProfileTarget==payload.UserId then self:Close(self.Profile)end
 end))
 local function closeAll()self:SetTarget(nil);for _,hud in ipairs({self.Profile,self.Request,self.Trade})do self:Close(hud)end;self.Pool:Clear()end
 table.insert(self.Connections,UIS.WindowFocusReleased:Connect(function()self:CancelProfileHold()end))
 table.insert(self.Connections,UIS.TextBoxFocused:Connect(function()self:CancelProfileHold()end))
 table.insert(self.Connections,player:GetAttributeChangedSignal('MatchId'):Connect(function()if player:GetAttribute('MatchId')then closeAll()end end))
 table.insert(self.Connections,player.CharacterRemoving:Connect(closeAll))
 table.insert(self.Connections,Players.PlayerRemoving:Connect(function(p)if self.ProfileTarget==p.UserId then self:Close(self.Profile)end;if self.Target==p then self:SetTarget(nil)end end))
 local dataUpdated=RS:WaitForChild('Remotes'):WaitForChild('Player'):WaitForChild('DataUpdated')
 table.insert(self.Connections,dataUpdated.OnClientEvent:Connect(function()
  -- Invalidation only; never render the client's private cached inventory.
  if self.ProfileMode=='SelfProfile'then self.NextSelfRefresh=workspace:GetServerTimeNow()+Config.RequestIntervalSeconds end
 end))
 local gui=player:WaitForChild('PlayerGui')
 for _,name in ipairs({'ShopHUD','PremiumShopHUD','SettingsGUI','CrateOpeningHUD'})do
  local hud=gui:FindFirstChild(name);local main=hud and hud:FindFirstChild('MainFrame')
  if main then
   local function changed()if self.ProfileTarget and self:WindowBusy()and not(self.Context and self.Context:GetController('WindowNavigationController'))then self:Close(self.Profile)end end
   table.insert(self.Connections,main:GetPropertyChangedSignal('Visible'):Connect(changed))
   table.insert(self.Connections,hud:GetPropertyChangedSignal('Enabled'):Connect(changed))
  end
 end
 local elapsed=0
 table.insert(self.Connections,RunService.RenderStepped:Connect(function(dt)
  self.Pool:Step(dt);elapsed+=dt
  if elapsed<Config.AimPollSeconds then return end;elapsed=0
  self:PollTarget();self:RefreshPreviews();if self.ProfileData then self:ProfileActions(self.ProfileData)end
  if self.ProfileTarget and self:WindowBusy()and not(self.Context and self.Context:GetController('WindowNavigationController'))then self:Close(self.Profile)end
  if self.ProfileTarget and self.Profile.Enabled and workspace:GetServerTimeNow()>=(self.NextSelfRefresh or math.huge)then
   self:OpenProfile(self.ProfileTarget,self.ProfilePage,true)
  end
  local t=self.CurrentTrade
  if t and not terminal[t.State]then
   local now=workspace:GetServerTimeNow()
   if t.State=='Requested'then self.Request.MainFrame.Countdown.Text='Expira en '..math.max(0,math.ceil(t.ExpiresAt-now))..' s'
   elseif t.State=='SafetyCountdown'then self.Trade.MainFrame.Status.Text='SEGURIDAD: '..math.max(0,math.ceil(t.Deadline-now))..' s · NO TRANSFIERE OBJETOS'end
  end
 end))
end
function Controller:Destroy()
 self.Initialized=false;self.Started=false;self.Generation+=1;self:SetTarget(nil);self.Pool:Clear()
 for _,c in ipairs(self.Connections or {})do c:Disconnect()end;self.Connections={}
 for _,hud in ipairs({self.Profile,self.Request,self.Trade})do self:Close(hud)end
end
return Controller
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="4296">
          <Properties>
            <string name="Name">SocialPlayController</string>
            <string name="Source"><![CDATA[--!nonstrict
local Players=game:GetService('Players')
local RS=game:GetService('ReplicatedStorage')
local Run=game:GetService('RunService')
local player=Players.LocalPlayer
local Controller={Name='SocialPlayController'}
local reasons={InGroup='El desafío requiere que ambos estén sin grupo.',AlreadyGrouped='Ese jugador ya tiene grupo.',GroupUnavailable='Solo el líder puede invitar y debe haber espacio.',GroupChanged='El grupo cambió. Enviá otra invitación.',GroupBusy='Salgan de la cola/partida antes de modificar el grupo.',NotLeader='Solo el líder puede disolver el grupo.',PlayerUnavailable='Jugador no disponible o en cola/partida.',OutOfRange='Acercate al jugador.',InviteCooldown='Esperá antes de enviar otra solicitud.',RoundUnavailable='Hay una partida en curso. Intentá nuevamente después.',Expired='La solicitud expiró.',Declined='Solicitud rechazada.',Accepted='Solicitud aceptada.',RateLimited='Esperá un momento.',InvalidRequest='Solicitud no válida.',DuelStartFailed='No se pudo iniciar el desafío.'}
function Controller:Notice(reason)
 if not self.Hud then return end
 self.NoticeToken=(self.NoticeToken or 0)+1;local token=self.NoticeToken
 self.Hud.Notice.Text=reasons[reason]or tostring(reason or '')
 self.Hud.Notice.Visible=true
 task.delay(4,function()if self.NoticeToken==token then self.Hud.Notice.Visible=false end end)
end
function Controller:Send(action,id,value,callback)
 if self.Pending then return end;self.Pending=true
 task.spawn(function()
  local ok,response=pcall(self.Remote.InvokeServer,self.Remote,action,id,value)
  self.Pending=false
  if not ok or type(response)~='table'then self:Notice('DuelStartFailed');return end
  if not response.Ok then self:Notice(response.Reason)end
  if callback then callback(response)end
 end)
end
function Controller:Invite(kind,target)
 if target==player.UserId or player:GetAttribute('MatchId')then return end
 if kind=='Duel'and (player:GetAttribute('SocialGroupId')or target and Players:GetPlayerByUserId(target)and Players:GetPlayerByUserId(target):GetAttribute('SocialGroupId'))then return end
 self:Send(kind,target)
end
function Controller:RenderGroup(group)
 self.Group=group;local panel=self.Hud.GroupPanel
 panel.Visible=group~=nil and self:GroupPanelAllowed()
 if not group then return end
 local names={};for _,member in ipairs(group.Members)do table.insert(names,(member.UserId==group.Leader and '★ 'or '')..member.DisplayName)end
 panel.Members.Text='GRUPO '..#group.Members..'/4\n'..table.concat(names,' · ')
 panel.Disband.Visible=group.Leader==player.UserId;panel.Disband.Active=panel.Disband.Visible
end
function Controller:GroupPanelAllowed()
 local party=self.Context and self.Context:GetController('PartyMatchController');if party and party.Hud then return false end
 if player:GetAttribute('MatchId')or self.Hud.RequestPanel.Visible then return false end
 local gui=player:FindFirstChild('PlayerGui');if not gui then return false end
 for _,name in ipairs({'PlayerProfileHUD','TradeHUD','TradeRequestHUD','ShopHUD','PremiumShopHUD','SettingsGUI','CrateOpeningHUD'})do
  local hud=gui:FindFirstChild(name);local main=hud and hud:FindFirstChild('MainFrame')
  if hud and hud.Enabled and (name=='CrateOpeningHUD'or main and main.Visible)then return false end
 end
 return true
end
function Controller:Init(context)
 if self.Initialized then return end;self.Initialized=true
 self.Context=context;self.Connections={};self.Hud=player:WaitForChild('PlayerGui'):WaitForChild('SocialPlayHUD',15)
 assert(self.Hud,'SocialPlayHUD missing in Edit')
 local folder=RS:WaitForChild('Remotes'):WaitForChild('SocialPlay')
 self.Remote=folder:WaitForChild('Request');self.Updated=folder:WaitForChild('Updated')
 self.Hud.Enabled=true;self.Hud.RequestPanel.Visible=false;self.Hud.GroupPanel.Visible=false;self.Hud.Notice.Visible=false
 local function bind(button,fn)table.insert(self.Connections,button.Activated:Connect(fn))end
 bind(self.Hud.RequestPanel.Accept,function()if self.Request then self:Send('Respond',self.Request.Id,true)end end)
 bind(self.Hud.RequestPanel.Decline,function()if self.Request then self:Send('Respond',self.Request.Id,false)end end)
 bind(self.Hud.GroupPanel.Leave,function()self:Send('Leave')end)
 bind(self.Hud.GroupPanel.Disband,function()self:Send('Disband')end)
end
function Controller:Start()
 if self.Started or not self.Updated then return end;self.Started=true
 table.insert(self.Connections,self.Updated.OnClientEvent:Connect(function(kind,data)
  if kind=='Group'then self:RenderGroup(data)
  elseif kind=='Request'then
   self.Request=data;local incoming=data.To==player.UserId
   local panel=self.Hud.RequestPanel;panel.Visible=true
   panel.Message.Text=incoming and (data.FromName..(data.Kind=='Duel'and ' te desafía a un 1v1.'or ' te invita a su grupo.'))or ('Solicitud enviada a '..data.ToName)
   panel.Accept.Visible=incoming;panel.Accept.Active=incoming;panel.Decline.Visible=incoming;panel.Decline.Active=incoming
  elseif kind=='RequestClosed'then
   if self.Request and self.Request.Id==data.Id then self.Request=nil;self.Hud.RequestPanel.Visible=false;self:Notice(data.Reason)end
  elseif kind=='Notice'then self:Notice(data.Reason)end
 end))
 table.insert(self.Connections,player:GetAttributeChangedSignal('MatchId'):Connect(function()
  self:RenderGroup(self.Group)
  if player:GetAttribute('MatchId')then self.Hud.RequestPanel.Visible=false end
 end))
 table.insert(self.Connections,Run.RenderStepped:Connect(function()
  self.Hud.GroupPanel.Visible=self.Group~=nil and self:GroupPanelAllowed()
  local req=self.Request
  if req then
   self.Hud.RequestPanel.Countdown.Text=math.max(0,math.ceil(req.ExpiresAt-workspace:GetServerTimeNow()))..' s'
   if workspace:GetServerTimeNow()>=req.ExpiresAt then self.Hud.RequestPanel.Visible=false;self.Request=nil end
  end
 end))
 self:Send('State',nil,nil,function(response)if response.Ok then self:RenderGroup(response.Group)end end)
end
function Controller:Destroy()
 for _,c in ipairs(self.Connections or {})do c:Disconnect()end
 self.Connections={};self.Started=false;self.Initialized=false;self.NoticeToken=(self.NoticeToken or 0)+1
 if self.Hud then self.Hud.Enabled=false end
end
return Controller
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="4297">
          <Properties>
            <string name="Name">SuddenDeathController</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Local-only additive colour correction; never edits the server or base Lighting.
local Players=game:GetService("Players")
local Lighting=game:GetService("Lighting")
local TweenService=game:GetService("TweenService")
local Config=require(game.ReplicatedStorage.Shared.Config)
local Controller={Name="SuddenDeathController"}
function Controller:Init(context)
 self._context=context;self._roundIndex=0;self._active=false;self._epoch=0
 self._connections={}
end
function Controller:_set(active,restoreArena)
 if self._active==active then return end
 self._active=active;self._epoch+=1
 local epoch=self._epoch
 local settings=Config.SuddenDeathPresentation
 local hud=Players.LocalPlayer.PlayerGui:FindFirstChild("SuddenDeathHUD")
 if hud then local label=hud:FindFirstChild("Notice");if label then label.Visible=active end end
 local music=self._context:GetController("MusicController")
 local match=self._context:GetController("MatchController")
 if music then music:SetSuddenDeath(active,match and match:GetCurrentSelectedMap(),restoreArena) end
 if self._tween then self._tween:Cancel();self._tween:Destroy();self._tween=nil end
 if active then
  if not self._effect then
   local assets=game.ReplicatedStorage:FindFirstChild("UIAssets")
   local folder=assets and assets:FindFirstChild("SuddenDeathAssets")
   local source=folder and folder:FindFirstChild("RedCorrection")
   if not source then warn("[SuddenDeath] Physical RedCorrection missing");return end
   self._effect=source:Clone()
   self._effect.Name="LocalSuddenDeathCorrection"
   self._effect.Enabled=true;self._effect.Brightness=0;self._effect.Contrast=0
   self._effect.Saturation=0;self._effect.TintColor=Color3.new(1,1,1)
   self._effect.Parent=Lighting
  end
  self._tween=TweenService:Create(self._effect,TweenInfo.new(settings.TransitionDuration),
   {Brightness=settings.Brightness,Contrast=settings.Contrast,Saturation=settings.Saturation,TintColor=settings.TintColor})
  self._tween:Play()
 elseif self._effect then
  local effect=self._effect
  local tween=TweenService:Create(effect,TweenInfo.new(settings.TransitionDuration),
   {Brightness=0,Contrast=0,Saturation=0,TintColor=Color3.new(1,1,1)})
  self._tween=tween
  tween.Completed:Connect(function()
   if self._epoch==epoch and not self._active and self._effect==effect then effect:Destroy();self._effect=nil end
  end)
  tween:Play()
 end
end
function Controller:Start(context)
 local player=Players.LocalPlayer
 local match=context:GetController("MatchController")
 local remotes=game.ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Match")
 table.insert(self._connections,remotes.Countdown.OnClientEvent:Connect(function(_,label,data)
  if label~="PLAYING" or type(data)~="table" or data.SessionId~=match:GetCurrentMatchId()
   or player:GetAttribute("MatchId")~=data.SessionId or not match:IsParticipant()
   or data.StateVersion~=match:GetCurrentStateVersion() then return end
  if self._sessionId~=data.SessionId then self._sessionId=data.SessionId;self._roundIndex=0 end
  if type(data.RoundIndex)~="number" or data.RoundIndex<self._roundIndex then return end
  self._roundIndex=data.RoundIndex
  self:_set(data.SuddenDeath==true and not data.Resolved,true)
 end))
 table.insert(self._connections,remotes.StateChanged.OnClientEvent:Connect(function(state,data)
  if type(data)=="table" and data.SessionId==self._sessionId and state~="Playing"
   and type(data.StateVersion)=="number" and data.StateVersion>=match:GetCurrentStateVersion() then
   self:_set(false,state=="PointRestartCountdown")
  end
 end))
 table.insert(self._connections,player:GetAttributeChangedSignal("MatchId"):Connect(function()
  if player:GetAttribute("MatchId")~=self._sessionId then self:_set(false,false);self._sessionId=nil;self._roundIndex=0 end
 end))
end
return Controller
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="4298">
          <Properties>
            <string name="Name">TrainingController</string>
            <string name="Source"><![CDATA[--!nonstrict
local Players=game:GetService('Players')
local RS=game:GetService('ReplicatedStorage')
local Run=game:GetService('RunService')
local Config=require(RS.Shared.Config)
local player=Players.LocalPlayer
local Controller={Name='TrainingController'}
function Controller:Unbind()
 if self.Activated then self.Activated:Disconnect();self.Activated=nil end
 if self.Track then pcall(function()self.Track:Stop(0);self.Track:Destroy()end);self.Track=nil end
 self.Tool=nil
end
function Controller:Bind(tool)
 if self.Tool==tool then return end
 self:Unbind();self.Tool=tool
 local h=player.Character and player.Character:FindFirstChildOfClass('Humanoid');local animator=h and h:FindFirstChildOfClass('Animator');local animation=tool:FindFirstChild('Swing')
 if animator and animation and animation:IsA('Animation')then local ok,track=pcall(animator.LoadAnimation,animator,animation);if ok then self.Track=track;track.Priority=Enum.AnimationPriority.Action end end
 self.Activated=tool.Activated:Connect(function()self:Activate()end)
end
function Controller:Activate()
 local tool=self.Tool;local sid=player:GetAttribute('TrainingSessionId');local now=workspace:GetServerTimeNow()
 if not sid or not tool or tool.Parent~=player.Character or player:GetAttribute('MatchId')or now<self.ReadyAt or self.Pending then return end
 local h=player.Character:FindFirstChildOfClass('Humanoid');if not h or h.Health<=0 or h.PlatformStand then return end
 self.Sequence+=1;local sequence=self.Sequence;self.Pending=sequence
 local combo=Config.Combat.SlapCombo;local c=tool:FindFirstChild('Configuration');local cd=c and c:FindFirstChild('SlapCooldown')
 self.ReadyAt=now+(combo.Enabled and combo.SwingWindow+combo.MissRecovery or cd and cd.Value or Config.Combat.SlapCooldown)
 if self.Track then self.Track.Looped=false;pcall(function()self.Track:Play(.05,1,1.2)end)end
 self.ActivateRemote:FireServer(tool,sid,sequence)
 task.delay(2,function()if self.Session==sid and self.Pending==sequence then self.Pending=nil;self.Hud.Panel.Status.Text='Sin respuesta: volvé a intentar.'end end)
end
function Controller:Refresh()
 local sid=player:GetAttribute('TrainingSessionId')
 if sid~=self.Session then self:Unbind();self.Session=sid;self.Sequence=0;self.Pending=nil;self.ReadyAt=0;self.LastAck=0 end
 local visible=sid~=nil and player:GetAttribute('MatchId')==nil;self.Hud.Panel.Visible=visible
 if not visible then self:Unbind();return end
 local char=player.Character;local found
 if char then for _,o in ipairs(char:GetChildren())do if o:IsA('Tool')and o:GetAttribute('IsTrainingSlap')==true then found=o;break end end end
 if found then self:Bind(found)elseif self.Tool then self:Unbind()end
 local remaining=math.max(0,self.ReadyAt-workspace:GetServerTimeNow())
 self.Hud.Panel.Attack.Text=self.Pending and 'ESPERANDO…'or remaining>0 and string.format('RECUPERACIÓN %.1f',remaining)or 'GOLPEAR'
end
function Controller:Init()
 self.Connections={};self.Sequence=0;self.ReadyAt=0;self.LastAck=0
 self.Hud=player:WaitForChild('PlayerGui'):WaitForChild('TrainingHUD',15);assert(self.Hud,'TrainingHUD missing in Edit');self.Hud.Panel.Visible=false
 local folder=RS:WaitForChild('Remotes'):WaitForChild('Training');self.ActivateRemote=folder:WaitForChild('Activate');self.Leave=folder:WaitForChild('Leave');self.Updated=folder:WaitForChild('Updated')
 table.insert(self.Connections,self.Hud.Panel.Attack.Activated:Connect(function()self:Activate()end))
 table.insert(self.Connections,self.Hud.Panel.Exit.Activated:Connect(function()self.Leave:FireServer()end))
end
function Controller:Start()
 if not self.Hud then return end
 table.insert(self.Connections,self.Updated.OnClientEvent:Connect(function(data)
  if type(data)~='table'or data.SessionId~=self.Session or type(data.Sequence)~='number'or data.Sequence<self.LastAck then return end
  self.LastAck=data.Sequence
  if data.Sequence~=self.Pending then return end
  self.Pending=nil
  if type(data.ReadyAt)=='number'then self.ReadyAt=math.max(workspace:GetServerTimeNow(),data.ReadyAt)end
  self.Hud.Panel.Status.Text=data.Hit and '¡IMPACTO! El maniquí se recupera y vuelve a su base.'or 'Fallo o maniquí protegido durante el ragdoll.'
 end))
 table.insert(self.Connections,Run.RenderStepped:Connect(function()self:Refresh()end))
 table.insert(self.Connections,player.CharacterRemoving:Connect(function()self:Unbind()end))
end
function Controller:Destroy()
 self:Unbind();for _,c in ipairs(self.Connections or {})do c:Disconnect()end
 if self.Hud then self.Hud.Enabled=false end
end
return Controller
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="4299">
          <Properties>
            <string name="Name">WindowNavigationController</string>
            <string name="Source"><![CDATA[--!nonstrict
local Players=game:GetService('Players')
local Stack=require(script.Parent.Parent.UI.WindowStack)
local Controller={Name='WindowNavigationController'}
function Controller:Init(context)
 self.Context=context;self.Entries={};self.Connections={};self.Expected={};self.Muting=false
 self.Stack=Stack.new(function(top)
  local function valid(id)
   if id=='SocialRequest'and self.Context then local c=self.Context:GetController('SocialPlayController');return c and c.Request and workspace:GetServerTimeNow()<c.Request.ExpiresAt end
   if id=='Admin'and Players.LocalPlayer then return Players.LocalPlayer:GetAttribute('AdminPanelAllowed')==true end
   return true
  end
  while top and not valid(top)do table.remove(self.Stack.Order);top=self.Stack.Order[#self.Stack.Order]end
  self.Muting=true
  for id,entry in pairs(self.Entries)do if entry.Object.Parent then
   self.Expected[id]=id==top;entry.Object[entry.Property]=id==top
   if entry.Dim then entry.Dim.Visible=id==top end
  end end
  self.Muting=false
 end)
end
function Controller:Forget(id)if self.Stack then self.Stack:Remove(id)end end
function Controller:Contains(id)for _,key in ipairs(self.Stack and self.Stack.Order or {})do if key==id then return true end end;return false end
function Controller:Watch(id,object,property)
 if self.Entries[id]then return end
 self.Entries[id]={Object=object,Property=property,Dim=id=='Shop'and object.Parent:FindFirstChild('DimBackground')or id=='Premium'and object.Parent:FindFirstChild('Dim')or nil}
 table.insert(self.Connections,object:GetPropertyChangedSignal(property):Connect(function()
  if self.Muting then return end
  -- Property signals may be deferred by Roblox; a synchronous mute alone is insufficient.
  if self.Expected[id]~=nil and object[property]==self.Expected[id]then return end
  self.Expected[id]=nil
  if object[property]then self.Stack:Push(id)else self.Stack:Remove(id)end
 end))
 if object[property]then self.Stack:Push(id)end
end
function Controller:Start()
 local player=Players.LocalPlayer;local gui=player:WaitForChild('PlayerGui')
 local definitions={{'ShopHUD','MainFrame','Shop'},{'ShopHUD','CrateSpinPanel','CrateSpin'},{'PremiumShopHUD','MainFrame','Premium'},{'SettingsGUI','MainFrame','Settings'},{'AdminHUD','MainFrame','Admin'},{'SocialPlayHUD','RequestPanel','SocialRequest'},{'ProgressionHUD','MainFrame','BattlePass'}}
 for _,d in ipairs(definitions)do task.spawn(function()
  local hud=gui:WaitForChild(d[1],20);local main=hud and hud:WaitForChild(d[2],20)
  if main then self:Watch(d[3],main,'Visible')end
 end)end
 for _,name in ipairs({'InvitePanel','ModePanel'})do task.spawn(function()
  local hud=gui:WaitForChild('PartyMatchHUD',20);local panel=hud and hud:WaitForChild(name,20)
  if panel then self:Watch('Party'..name,panel,'Visible')end
 end)end
 for _,name in ipairs({'PlayerProfileHUD','TradeRequestHUD','TradeHUD','CrateOpeningHUD'})do task.spawn(function()
  local hud=gui:WaitForChild(name,20);if hud then self:Watch(name,hud,'Enabled')end
 end)end
 local function clear()
  self.Stack:Clear()
  for _,name in ipairs({'ShopController','PremiumShopController','SettingsController'})do
   local c=self.Context and self.Context:GetController(name);if c and type(c.Close)=='function'then c:Close()end
  end
 end
 local function reset()if player:GetAttribute('MatchId')or player:GetAttribute('ResultsSessionId')then clear()end end
 for _,key in ipairs({'MatchId','ResultsSessionId'})do table.insert(self.Connections,player:GetAttributeChangedSignal(key):Connect(reset))end
 table.insert(self.Connections,player.CharacterRemoving:Connect(clear))
 reset()
end
function Controller:Destroy()self.Stack:Clear();for _,c in ipairs(self.Connections)do c:Disconnect()end end
return Controller
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="4300">
        <Properties>
          <string name="Name">CrateOpening</string>
        </Properties>
        <Item class="ModuleScript" referent="4301">
          <Properties>
            <string name="Name">CameraLease</string>
            <string name="Source"><![CDATA[--!nonstrict
-- A lower-priority lobby camera never restores over a match or EndCinematic.
local Lease={}
function Lease.Acquire(camera,id,character)
 if not camera or camera.CameraType==Enum.CameraType.Scriptable or camera:GetAttribute("CrateCameraOwner")then return nil end
 local row={Camera=camera,Id=id,Character=character,Type=camera.CameraType,Subject=camera.CameraSubject,
  FieldOfView=camera.FieldOfView,CFrame=camera.CFrame}
 camera:SetAttribute("CrateCameraOwner",id);return row
end
function Lease.Owns(row)return row and row.Camera:GetAttribute("CrateCameraOwner")==row.Id end
function Lease.Restore(row,character,higherPriority)
 if not Lease.Owns(row)then return false end
 local camera=row.Camera;camera:SetAttribute("CrateCameraOwner",nil)
 if higherPriority then return false end
 if character==row.Character then
  camera.CameraType=row.Type;camera.FieldOfView=row.FieldOfView;camera.CFrame=row.CFrame
  camera.CameraSubject=if row.Subject and row.Subject.Parent then row.Subject else character and character:FindFirstChildOfClass("Humanoid")
 else
  camera.CameraType=Enum.CameraType.Custom
  camera.CameraSubject=character and character:FindFirstChildOfClass("Humanoid")
  -- Do not apply the old life's FOV or position to a new Character.
 end
 return true
end
return Lease
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="4302">
          <Properties>
            <string name="Name">CharacterVisibility</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Client-only lease. Only descendants of Players' Characters are eligible.
local Visibility={}
local active
local function disconnect(list)
 for _,connection in ipairs(list)do connection:Disconnect()end
 table.clear(list)
end
local function propertyFor(object)
 if object:IsA("BasePart")then return "LocalTransparencyModifier",1 end
 if object:IsA("Decal")then return "Transparency",1 end
 if object:IsA("ForceField")then return "Visible",false end
 if object:IsA("ParticleEmitter")or object:IsA("Trail")or object:IsA("Beam")
  or object:IsA("BillboardGui")or object:IsA("SurfaceGui")or object:IsA("Highlight")
  or object:IsA("Light")or object:IsA("Fire")or object:IsA("Smoke")or object:IsA("Sparkles")then return "Enabled",false end
 if object:IsA("Humanoid")then return "DisplayDistanceType",Enum.HumanoidDisplayDistanceType.None end
end
local function restore(lease,object)
 local row=lease.Saved[object];if not row then return end
 lease.Saved[object]=nil;row.Connection:Disconnect()
 -- Don't overwrite a newer value if a deferred external write already won.
 pcall(function()if object[row.Property]==row.Applied then object[row.Property]=row.Previous end end)
end
local function hide(lease,character,object)
 if lease.Released or lease.Saved[object]or not object:IsDescendantOf(character)then return end
 local property,value=propertyFor(object);if not property then return end
 local row={Property=property,Applied=value,Previous=object[property],Writing=false,Character=character}
 lease.Saved[object]=row
 row.Connection=object:GetPropertyChangedSignal(property):Connect(function()
  if lease.Released or row.Writing or lease.Saved[object]~=row then return end
  local current=object[property]
  if current~=value then
   row.Previous=current -- Latest observable external intent, including camera transparency.
   row.Writing=true;object[property]=value;row.Writing=false
  end
 end)
 row.Writing=true;object[property]=value;row.Writing=false
 -- Stop already-emitted geometry too; never touch emitters outside Characters.
 if object:IsA("ParticleEmitter")or object:IsA("Trail")then object:Clear()end
end
local function unwatchCharacter(lease,character)
 local connections=lease.Characters[character];if not connections then return end
 lease.Characters[character]=nil;disconnect(connections)
 local objects={};for object,row in pairs(lease.Saved)do if row.Character==character then table.insert(objects,object)end end
 for _,object in ipairs(objects)do restore(lease,object)end
end
local function watchCharacter(lease,character)
 if lease.Released or lease.Characters[character]then return end
 local connections={};lease.Characters[character]=connections
 table.insert(connections,character.DescendantAdded:Connect(function(object)hide(lease,character,object)end))
 table.insert(connections,character.DescendantRemoving:Connect(function(object)restore(lease,object)end))
 for _,object in ipairs(character:GetDescendants())do hide(lease,character,object)end
end
local function unwatchPlayer(lease,player)
 local connections=lease.Players[player];if not connections then return end
 lease.Players[player]=nil;disconnect(connections)
 local characters={};for character,owner in pairs(lease.Owners)do if owner==player then table.insert(characters,character)end end
 for _,character in ipairs(characters)do lease.Owners[character]=nil;unwatchCharacter(lease,character)end
end
local function watchPlayer(lease,player)
 if lease.Released or lease.Players[player]then return end
 local function added(character)
  if lease.Released then return end
  lease.Owners[character]=player;watchCharacter(lease,character)
 end
 lease.Players[player]={player.CharacterAdded:Connect(added),player.CharacterRemoving:Connect(function(character)
  lease.Owners[character]=nil;unwatchCharacter(lease,character)
 end)}
 if player.Character then added(player.Character)end
end
function Visibility.Release(lease)
 if not lease or lease.Released then return end
 lease.Released=true;disconnect(lease.Connections)
 for _,connections in pairs(lease.Players)do disconnect(connections)end
 for _,connections in pairs(lease.Characters)do disconnect(connections)end
 local objects={};for object in pairs(lease.Saved)do table.insert(objects,object)end
 for _,object in ipairs(objects)do restore(lease,object)end
 table.clear(lease.Players);table.clear(lease.Characters);table.clear(lease.Owners)
 if active==lease then active=nil end
end
function Visibility.Acquire(players,id)
 assert(type(id)=="string","OpeningId required")
 if active and active.Id==id then return active end
 Visibility.Release(active)
 local lease={Id=id,Saved={},Players={},Characters={},Owners={},Connections={},Released=false}
 active=lease
 local ok,failure=pcall(function()
  table.insert(lease.Connections,players.PlayerAdded:Connect(function(player)watchPlayer(lease,player)end))
  table.insert(lease.Connections,players.PlayerRemoving:Connect(function(player)unwatchPlayer(lease,player)end))
  for _,player in ipairs(players:GetPlayers())do watchPlayer(lease,player)end
 end)
 if not ok then Visibility.Release(lease);error(failure)end
 return lease
end
return Visibility
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="4303">
          <Properties>
            <string name="Name">CinematicConfig</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Presentation only. Stage durations remain in Shared.SlapCrates.OpeningConfig.
return {
 HideStandPrompt=true,
 RewardOverlayByMode={StandCinematic=false,Spin=true},
 Transition={Letterbox=.075,ClosePower=3,OpenPower=4,OutroHandoff=.5},
 Camera={IntroDuration=1.8,IntroHeight=7,IntroBack=2,IntroLookHeight=12,
  IntroFov=9,Bounce=.045,TensionPosition=.035,TensionDegrees=.18,
  ImpactPosition=.16,ImpactDegrees=.65,ImpactDuration=.85,ImpactFrequency=19,
  FocusResponse=8,PushIn=.035,MaxPositionShake=.2,MaxDegreesShake=.8},
 Audio={Close="WhooshClose",Open="WhooshOpen",Volume=.65},
 Gallery={Columns=5,PortraitColumns=3,Spacing=3.2,RowSpacing=3.3,MaxModelExtent=1.7,
  Stagger=.08,EnterDuration=.24,FrameMargin=1.2,MaxRevealParticles=40},
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="4304">
          <Properties>
            <string name="Name">CinematicMotion</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Deterministic scalar choreography; no ownership, economy or gameplay writes.
local Motion={}
local function ease(p)return p*p*(3-2*p)end
function Motion.Cover(stage,p,c)
 p=math.clamp(p,0,1)
 if stage=="Intro"then return .5*(1-(1-p)^c.ClosePower)end
 if stage=="CameraReveal"then return c.Letterbox+(.5-c.Letterbox)*(1-p)^c.OpenPower end
 if stage=="Outro"then
  if p<c.OutroHandoff then return c.Letterbox+(.5-c.Letterbox)*(1-(1-p/c.OutroHandoff)^c.ClosePower)end
  return .5*(1-(p-c.OutroHandoff)/(1-c.OutroHandoff))^c.OpenPower
 end
 if stage=="Done"then return 0 end
 return c.Letterbox
end
function Motion.Sample(plan,elapsed,stage,p,c)
 local entry=plan.Stages[2].Start
 local q=math.clamp((elapsed-entry)/c.IntroDuration,0,1)
 local drop=(1-q)^3-c.Bounce*math.sin(q*math.pi)^2
 local tension=if stage=="Growth"then ease(p)*.35 elseif stage=="Shake"then .35+.65*ease(p)else 0
 local flash=plan.Stages[7].Start
 local impactAge=elapsed-flash
 local impact=if impactAge>=0 and impactAge<c.ImpactDuration then (1-impactAge/c.ImpactDuration)^3 else 0
 local position=math.min(c.MaxPositionShake,c.TensionPosition*tension+c.ImpactPosition*impact)
 local degrees=math.min(c.MaxDegreesShake,c.TensionDegrees*tension+c.ImpactDegrees*impact)
 local frequency=c.ImpactFrequency
 return {Drop=drop,Fov=c.IntroFov*(1-q)^2,
  X=math.sin(elapsed*frequency)*position,Y=math.sin(elapsed*frequency*.79+1)*position*.65,
  Pitch=math.rad(math.sin(elapsed*frequency*.87)*degrees),
  Roll=math.rad(math.sin(elapsed*frequency*.61)*degrees*.5),Impact=impact}
end
return Motion
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="4305">
          <Properties>
            <string name="Name">CinematicTransition</string>
            <string name="Source"><![CDATA[--!nonstrict
local Transition={}
function Transition.Update(hud,cover)
 -- Physical editable Frames, never a second ScreenGui.
 local top=hud:FindFirstChild("ShutterTop");local bottom=hud:FindFirstChild("ShutterBottom")
 assert(top and bottom,"Missing V2.3 Edit shutter resources")
 cover=math.clamp(cover,0,.5)
 top.Visible=cover>0;bottom.Visible=cover>0
 top.Size=UDim2.fromScale(1,cover);bottom.Size=UDim2.fromScale(1,cover)
end
function Transition.Reset(hud)
 if not hud then return end
 for _,name in ipairs({"ShutterTop","ShutterBottom"})do
  local frame=hud:FindFirstChild(name);if frame then frame.Visible=false;frame.Size=UDim2.fromScale(1,0)end
 end
end
return Transition
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="4306">
          <Properties>
            <string name="Name">CrateOddsLabels</string>
            <string name="Source"><![CDATA[--!strict
local Labels={}
function Labels.Percent(value: number): string
 if math.abs(value-math.round(value))<1e-7 then return string.format('%d %%',math.round(value))end
 if value<1 then return '<1 %'end
 return string.format('≈ %d %%',math.round(value))
end
function Labels.Chance(value: number): string
 return if value>=15 then 'Probabilidad alta'elseif value>=5 then 'Probabilidad media'elseif value>=1 then 'Probabilidad baja'else 'Probabilidad muy baja'
end
return Labels
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="4307">
          <Properties>
            <string name="Name">CrateRewardGallery</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Real local Workspace rendering: particles and Highlights are not emulated in ViewportFrames.
local RS=game:GetService('ReplicatedStorage')
local Labels=require(script.Parent.CrateOddsLabels)
local Gallery={};Gallery.__index=Gallery
function Gallery.new(panel)return setmetatable({Panel=panel,Rows={},Angle=0},Gallery)end
function Gallery:Release(row)
 if row.Model then for _,o in ipairs(row.Model:GetDescendants())do if o:IsA('ParticleEmitter')then o:Clear()end end;row.Model:Destroy();row.Model=nil end
 if row.Back then row.Back:Destroy();row.Back=nil end
end
function Gallery:Clear()
 for _,r in ipairs(self.Rows)do self:Release(r);r.Card:Destroy()end
 table.clear(self.Rows)
end
function Gallery:Set(result)
 self:Clear();self.Panel.RewardScroll.CanvasPosition=Vector2.zero
 if not result.Ok then return end
 for i,outcome in ipairs(result.Outcomes or {})do
  local card=self.Panel.RewardCard:Clone();card.Name='Reward_'..i;card.LayoutOrder=i;card.Visible=true
  card.ItemName.Text=outcome.SlapName or outcome.DisplayName;card.Rarity.Text=outcome.VariationName
  card.Rarity.TextColor3=outcome.Color;card.Stroke.Color=outcome.Color
  card.Chance.Text=Labels.Percent(outcome.Percent)..' · '..Labels.Chance(outcome.Percent)
  card.Detail.Text=Labels.Percent(outcome.Percent)..' · '..Labels.Chance(outcome.Percent)
  card.Detail.Visible=false
  card.MouseEnter:Connect(function()card.Detail.Visible=true end)
  card.MouseLeave:Connect(function()card.Detail.Visible=false end)
  card.InputBegan:Connect(function(input)if input.UserInputType==Enum.UserInputType.Touch then card.Detail.Visible=true end end)
  card.InputEnded:Connect(function(input)if input.UserInputType==Enum.UserInputType.Touch then card.Detail.Visible=false end end)
  card.Parent=self.Panel.RewardScroll
  table.insert(self.Rows,{Card=card,Outcome=outcome})
 end
end
function Gallery:HideModels()
 for _,r in ipairs(self.Rows)do self:Release(r)end
end
function Gallery:Create(row)
 local previews=RS:FindFirstChild('SlapVariationPreviews');local base=previews and previews:FindFirstChild(row.Outcome.SlapId)
 local source=base and base:FindFirstChild(row.Outcome.VariationId);if not source then return end
 local model=source:Clone();model.Name='LocalCratePreview';row.Bursts={};row.LastBurst=-math.huge
 for _,o in ipairs(model:GetDescendants())do
  if o:IsA('LuaSourceContainer')then o:Destroy()
  elseif o:IsA('BasePart')then o.Anchored=true;o.CanCollide=false;o.CanTouch=false;o.CanQuery=false;o.CastShadow=false
  elseif o:IsA('Sound')then o:Stop() -- No overlapping audio from nine previews.
  elseif o:IsA('ParticleEmitter')then
   o.Rate=math.min(o.Rate,12)
   if o:GetAttribute('PreviewEnabled')~=false then
    o.Enabled=o.Rate>0
    if o.Rate==0 and #row.Bursts<4 then table.insert(row.Bursts,{Emitter=o,Count=math.clamp(tonumber(o:GetAttribute('PreviewEmitCount')or o:GetAttribute('EmitCount')or o:GetAttribute('RevealBurstCount'))or 4,1,8)})end
   end
  end
 end
 row.Model=model;row.BaseScale=model:GetScale();row.Extent=model:GetExtentsSize().Magnitude;row.Rotation=model:GetPivot().Rotation
 local back=Instance.new('Part');back.Name='LocalCrateRarityBackdrop';back.Anchored=true;back.CanCollide=false;back.CanTouch=false;back.CanQuery=false
 back.CastShadow=false;back.Material=Enum.Material.Neon;back.Color=row.Outcome.Color:Lerp(Color3.fromRGB(8,12,23),.82);row.Back=back
end
function Gallery:Step(dt)
 local ancestor=self.Panel
 while ancestor do
  if (ancestor:IsA('GuiObject')and not ancestor.Visible)or(ancestor:IsA('LayerCollector')and not ancestor.Enabled)then self:HideModels();return end
  ancestor=ancestor.Parent
 end
 local camera=workspace.CurrentCamera;if not camera then return end
 self.Angle+=dt*.55;self.Time=(self.Time or 0)+dt
 local scroll=self.Panel.RewardScroll;local pos,size=scroll.AbsolutePosition,scroll.AbsoluteSize;local active=0
 for _,row in ipairs(self.Rows)do
  local a,b=row.Card.AbsolutePosition,row.Card.AbsoluteSize
  local visible=a.X>=pos.X and a.X+b.X<=pos.X+size.X and active<6
  local parent=scroll.Parent
  while visible and parent do
   if parent:IsA('GuiObject')and parent.ClipsDescendants then
    local p,s=parent.AbsolutePosition,parent.AbsoluteSize
    visible=a.X>=p.X and a.X+b.X<=p.X+s.X and a.Y>=p.Y and a.Y+b.Y<=p.Y+s.Y
   end
   parent=parent.Parent
  end
  if visible then
   active+=1;if not row.Model then self:Create(row)end
   if row.Model then
    local center=a+Vector2.new(b.X/2,b.Y*.33)
    local ray=camera:ScreenPointToRay(center.X,center.Y)
    local distance=1.5;local worldHeight=2*distance*math.tan(math.rad(camera.FieldOfView/2))*b.Y*.51/math.max(1,camera.ViewportSize.Y)
    row.Model:ScaleTo(row.BaseScale*worldHeight/math.max(row.Extent,.01)*.77)
    row.Model:PivotTo(CFrame.new(ray.Origin+ray.Direction*distance)*camera.CFrame.Rotation*CFrame.Angles(0,self.Angle,0)*row.Rotation)
    local plateRay=camera:ScreenPointToRay(center.X,center.Y)
    row.Back.Size=Vector3.new(worldHeight*b.X/(b.Y*.51),worldHeight*.66/.51,.01)
    row.Back.CFrame=CFrame.new(plateRay.Origin+plateRay.Direction*(distance+.12))*camera.CFrame.Rotation
    row.Back.Parent=workspace;row.Model.Parent=workspace;row.Card.BackgroundTransparency=1
    if self.Time-row.LastBurst>=2.5 then
     local budget=8;for _,burst in ipairs(row.Bursts)do local amount=math.min(budget,burst.Count);if amount>0 then burst.Emitter:Emit(amount);budget-=amount end end
     row.LastBurst=self.Time
    end
   end
  else
   row.Card.BackgroundTransparency=0;row.Card.BackgroundColor3=row.Outcome.Color:Lerp(Color3.fromRGB(8,12,23),.85)
   self:Release(row)
  end
 end
end
function Gallery:Destroy()self:Clear()end
return Gallery
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="4308">
          <Properties>
            <string name="Name">RewardGallery</string>
            <string name="Source"><![CDATA[--!nonstrict
local RS=game:GetService("ReplicatedStorage")
local Catalog=require(RS.Shared.SlapCrates.Catalog)
local Appearance=require(RS.Shared.SlapCrates.Appearance)
local Config=require(script.Parent.CinematicConfig)
local Layout=require(script.Parent.RewardGalleryLayout)
local RewardVFX=require(script.Parent.RewardVFX)
local Gallery={}
function Gallery.Create(run,rewards,safeVisual)
 local template=assert(RS.UIAssets:FindFirstChild("CrateBatchRewardSlot"),"Missing editable batch slot")
 local gallery={Rows={},Count=#rewards,Emitted=0}
 for _,unit in ipairs(rewards)do
  local reward=assert(Catalog.Rewards[unit.RewardId],"Unknown batch reward")
  local variation=Catalog.Variations.ById[reward.VariationId]
  local slot=template:Clone();slot.Name="RewardSlot_"..(#gallery.Rows+1);slot.Parent=run.Scene
  table.insert(run.Objects,slot)
  local label=slot.Anchor.BillboardGui;label.Enabled=false
  label.Slap.Text=Catalog.Slaps.ById[reward.SlapId].DisplayName
  label.Variation.Text=variation.DisplayName;label.Variation.TextColor3=variation.Color
  local previews=RS:FindFirstChild("SlapVariationPreviews")
  local slap=previews and previews:FindFirstChild(reward.SlapId)
  local source=(slap and slap:FindFirstChild(reward.VariationId))or RS.CrateRewardPreviews:FindFirstChild(reward.SlapId)
  local model=assert(source,"Missing batch reward preview"):Clone();table.insert(run.Objects,model);safeVisual(model)
  local part=model:FindFirstChildWhichIsA("BasePart",true)
  local profile=RS.SlapVariationEffects:FindFirstChild(variation.VisualProfile)
  if part then Appearance.Apply(part,profile)end
  safeVisual(model) -- Applied profiles must obey the same local presentation bounds.
  local size=model:GetExtentsSize();local extent=math.max(size.X,size.Y,size.Z)
  local primary=run.GlobalFX and run.GlobalFX.Index==#gallery.Rows+1
  local visual=RewardVFX.Attach(run,model,variation,unit.EffectivePercent,primary)
  table.insert(gallery.Rows,{Slot=slot,Model=model,Label=label,Variation=variation,
   VFX=visual,Primary=primary,Scale=model:GetScale()*math.min(1,Config.Gallery.MaxModelExtent/math.max(extent,.01))})
 end
 return gallery
end
function Gallery.Update(run,elapsed,camera)
 local gallery=run.Gallery
 local aspect=camera.ViewportSize.X/math.max(1,camera.ViewportSize.Y)
 local layout=Layout.Build(gallery.Count,aspect,math.clamp(camera.FieldOfView or 70,35,100),Config.Gallery)
 gallery.Layout=layout
 local since=elapsed-run.Plan.Stages[8].Start
 for index,row in ipairs(gallery.Rows)do
  local age=since-(index-1)*Config.Gallery.Stagger
  if age<0 then continue end
  local p=math.clamp(age/Config.Gallery.EnterDuration,0,1);local eased=1-(1-p)^3
  local point=layout.Positions[index];local cameraPoint=run.Stand.CameraPoint
  local position=run.Stand.RewardPoint.Position+cameraPoint.CFrame.RightVector*point.X
   +cameraPoint.CFrame.UpVector*(point.Y-(1-eased)*.6)
  row.Slot.Anchor.CFrame=CFrame.new(position)
  row.Label.Adornee=row.Slot.Anchor;row.Label.Enabled=true
  row.Model.Parent=row.Slot;row.Model:ScaleTo(row.Scale*math.max(.01,eased))
  row.Model:PivotTo(CFrame.new(position+Vector3.new(0,math.sin(elapsed*2+index)*.07,0))
   *run.Stand.RewardPoint.CFrame.Rotation*CFrame.Angles(0,elapsed*.5,0))
  if not row.Revealed then
   row.Revealed=true
   RewardVFX.Reveal(run,row.VFX,elapsed)
   if row.Primary then run.PrimaryRewardRevealed=true end
   local rowBudget=if row.Variation.SortOrder>=5 then 4 else 2
   local mobile=run.VisualBudget and run.VisualBudget.Mobile
   if mobile then rowBudget=math.max(1,math.floor(rowBudget*.5))end
   for _,effect in ipairs(row.Model:GetDescendants())do
    local maximum=if mobile then math.min(12,Config.Gallery.MaxRevealParticles)else Config.Gallery.MaxRevealParticles
    if effect:IsA("ParticleEmitter")and(not row.VFX.FX or not effect:IsDescendantOf(row.VFX.FX))and rowBudget>0 and gallery.Emitted<maximum then
     local n=math.min(rowBudget,maximum-gallery.Emitted)
     effect:Emit(n);gallery.Emitted+=n;rowBudget-=n
    end
   end
  end
  RewardVFX.Update(row.VFX,elapsed)
  RewardVFX.Label(row.VFX,row.Label,elapsed)
 end
end
function Gallery.CameraPosition(run,position)
 if not run.Gallery.Layout then return position end
 local focus=run.Stand.RewardPoint.Position;local direction=position-focus
 if direction.Magnitude<.01 then return position end
 return focus+direction.Unit*math.max(direction.Magnitude,run.Gallery.Layout.Distance)
end
return Gallery
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="4309">
          <Properties>
            <string name="Name">RewardGalleryLayout</string>
            <string name="Source"><![CDATA[--!nonstrict
local Layout={}
function Layout.Build(count,aspect,fov,config)
 assert(count==5 or count==10,"Gallery requires five or ten rewards")
 aspect=math.clamp(aspect,.4,3)
 local columns=if aspect<.9 then config.PortraitColumns else config.Columns
 local rows=math.ceil(count/columns);local positions={}
 for index=1,count do
  local row=math.floor((index-1)/columns);local inRow=math.min(columns,count-row*columns)
  positions[index]={X=((index-1)%columns-(inRow-1)/2)*config.Spacing,Y=((rows-1)/2-row)*config.RowSpacing}
 end
 local width=math.min(columns,count)*config.Spacing
 local height=rows*config.RowSpacing
 local tangent=math.tan(math.rad(fov)/2)
 return {Positions=positions,Width=width,Height=height,
  Distance=math.max(width/(2*tangent*aspect),height/(2*tangent))*config.FrameMargin}
end
return Layout
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="4310">
          <Properties>
            <string name="Name">RewardOverlayPresenter</string>
            <string name="Source"><![CDATA[--!nonstrict
local TweenService=game:GetService("TweenService")
local Presenter={};Presenter.__index=Presenter
function Presenter.new(root)
 if not root then return nil end
 local self=setmetatable({Root=root,Position=root.Position,Entries={}},Presenter)
 for _,obj in ipairs(root:GetDescendants())do
  local props={}
  if obj:IsA("GuiObject")then props.BackgroundTransparency=obj.BackgroundTransparency end
  if obj:IsA("TextLabel")then props.TextTransparency=obj.TextTransparency end
  if obj:IsA("UIStroke")then props.Transparency=obj.Transparency end
  if next(props)then table.insert(self.Entries,{Object=obj,Properties=props})end
 end
 table.insert(self.Entries,{Object=root,Properties={BackgroundTransparency=root.BackgroundTransparency}})
 self.Scale=root:FindFirstChild("RevealScale");root.Visible=false
 return self
end
function Presenter:_tween(run,obj,duration,props)
 local t=TweenService:Create(obj,TweenInfo.new(duration,Enum.EasingStyle.Sine,Enum.EasingDirection.InOut),props)
 table.insert(run.Tweens,t);t:Play()
end
function Presenter:Show(run,slap,variation)
 if not run.Private or self.Owner==run.Id then return end
 self.Owner=run.Id;local root=self.Root
 root.Title.Text="¡RECOMPENSA OBTENIDA!";root.SlapName.Text=slap.DisplayName
 root.VariationName.Text=variation.DisplayName;root.VariationName.TextColor3=variation.Color
 local stroke=root:FindFirstChild("AccentStroke");if stroke then stroke.Color=variation.Color end
 root.Position=self.Position+UDim2.fromScale(0,.025);root.Visible=true
 if self.Scale then self.Scale.Scale=.94;self:_tween(run,self.Scale,.35,{Scale=1})end
 for _,entry in ipairs(self.Entries)do
  for key in pairs(entry.Properties)do entry.Object[key]=1 end
  self:_tween(run,entry.Object,.35,entry.Properties)
 end
 self:_tween(run,root,.35,{Position=self.Position})
end
function Presenter:Exit(run)
 if self.Owner~=run.Id then return end
 for _,entry in ipairs(self.Entries)do local p={};for key in pairs(entry.Properties)do p[key]=1 end;self:_tween(run,entry.Object,.25,p)end
 self:_tween(run,self.Root,.25,{Position=self.Position+UDim2.fromScale(0,.015)})
end
function Presenter:Reset(id)
 if self.Owner and self.Owner~=id then return end
 self.Owner=nil;self.Root.Visible=false;self.Root.Position=self.Position
 if self.Scale then self.Scale.Scale=1 end
 for _,entry in ipairs(self.Entries)do for key,value in pairs(entry.Properties)do entry.Object[key]=value end end
end
return Presenter
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="4311">
          <Properties>
            <string name="Name">RewardRevealConfig</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Percent thresholds are visual only; no weights, purchases or outcomes live here.
return {
 Thresholds={NormalAbove=5,FeaturedAtLeast=1,RareAtLeast=.1,UltraAtLeast=.01},
 Profiles={
  {Name="Normal",Burst=2,Fill=.94,Outline=.35,Reaction=0,Duration=.4},
  {Name="Destacado",Burst=5,Fill=.91,Outline=.27,Reaction=0,Duration=.6},
  {Name="Raro",Burst=9,Fill=.88,Outline=.2,Reaction=.025,Duration=.7},
  {Name="Ultra raro",Burst=16,Fill=.85,Outline=.14,Reaction=.06,Duration=1},
  {Name="Jackpot",Burst=28,Fill=.81,Outline=.08,Reaction=.1,Duration=1.3},
 },
 Chest={ColorSpeed=1.8,LockFraction=.65,Fill=.93,Outline=.25},
 MaxParticles=64,MobileParticleScale=.4,MaxMobileParticles=24,
 RingSegments=12,ReactionDuration=.65,MaxReactionDegrees=.35,
 HighlightPulse=.06,WinnerEnterDuration=.35,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="4312">
          <Properties>
            <string name="Name">RewardRevealProfile</string>
            <string name="Source"><![CDATA[--!nonstrict
local Config=require(script.Parent.RewardRevealConfig)
local Existing=require(script.Parent.VisualProfile)
local Profiles={}
function Profiles.ValidPercent(p)return type(p)=="number"and p==p and p>0 and p<=100 end
function Profiles.For(percent,variation)
 local rank;local thresholds=Config.Thresholds
 if Profiles.ValidPercent(percent)then
  rank=if percent>thresholds.NormalAbove then 1 elseif percent>=thresholds.FeaturedAtLeast then 2
   elseif percent>=thresholds.RareAtLeast then 3 elseif percent>=thresholds.UltraAtLeast then 4 else 5
 else rank=math.clamp(Existing.For(variation).Tier-1,1,#Config.Profiles)end
 local result=table.clone(Config.Profiles[rank]);result.Rank=rank
 result.Percent=if Profiles.ValidPercent(percent)then percent else nil
 result.Color=variation.Color;return result
end
function Profiles.Best(units,catalog)
 local best,index
 for i,unit in ipairs(units)do
  local reward=catalog.Rewards[unit.RewardId];local variation=reward and catalog.Variations.ById[reward.VariationId]
  if variation then
   local p=Profiles.For(unit.EffectivePercent,variation)
   if not best or(p.Percent and(not best.Percent or p.Percent<best.Percent))or(not p.Percent and not best.Percent and p.Rank>best.Rank)then best=p;index=i end
  end
 end
 return best,index
end
return Profiles
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="4313">
          <Properties>
            <string name="Name">RewardSpin3D</string>
            <string name="Source"><![CDATA[--!nonstrict
local RS=game:GetService("ReplicatedStorage")
local Config=require(RS.Shared.SlapCrates.OpeningConfig).RewardSpin
local Catalog=require(RS.Shared.SlapCrates.Catalog)
local Appearance=require(RS.Shared.SlapCrates.Appearance)
local Motion=require(script.Parent.RewardSpinMotion)
local Spin={}
local function sourceFor(reward)
 local previews=RS:FindFirstChild("SlapVariationPreviews");local slap=previews and previews:FindFirstChild(reward.SlapId)
 return(slap and slap:FindFirstChild(reward.VariationId))or RS.CrateRewardPreviews:FindFirstChild(reward.SlapId)
end
function Spin.Create(run,eligibleIds,safeVisual)
 local eligible={};local seen={}
 for _,id in ipairs(eligibleIds or {})do
  local reward=Catalog.Rewards[id]
  if reward and not seen[id]and sourceFor(reward)then seen[id]=true;table.insert(eligible,reward)end
 end
 if #eligible==0 then return nil end -- Legacy receipt: never invent an eligible pool.
 local count=math.clamp(math.floor(Config.VisiblePreviewCount),3,7);if count%2==0 then count-=1 end
 local record={Pool={},Count=count,WinnerScale=run.Reward:GetScale(),Finished=false,Fit=0}
 for index=1,count do
  local reward=eligible[(index-1)%#eligible+1];local model=sourceFor(reward):Clone();table.insert(run.Objects,model);safeVisual(model)
  local variation=Catalog.Variations.ById[reward.VariationId]
  local part=model:FindFirstChildWhichIsA("BasePart",true)
  if part then Appearance.Apply(part,RS.SlapVariationEffects:FindFirstChild(variation.VisualProfile))end
  safeVisual(model)
  local extent=model:GetExtentsSize();local size=math.max(extent.X,extent.Y,extent.Z,.01)
  record.Pool[index]={Model=model,Scale=model:GetScale()*math.min(1,Config.MaxPreviewExtent/size),RewardId=reward.RewardId}
 end
 local t=RS.UIAssets:FindFirstChild("CrateRevealV25");local sound=t and t:FindFirstChild("SpinTick")
 if sound then record.Tick=sound:Clone();record.Tick.Parent=run.Scene;table.insert(run.Objects,record.Tick)end
 return record
end
function Spin.Update(run,elapsed,camera)
 local spin=run.Spin3D;local age=elapsed-run.Plan.Stages[8].Start
 local aspect=camera.ViewportSize.X/math.max(1,camera.ViewportSize.Y)
 local count=if aspect<.9 then 3 else spin.Count
 spin.Fit=count*Config.ItemSpacing/(2*math.tan(math.rad(math.clamp(camera.FieldOfView,35,100))/2)*math.max(.4,aspect))*1.12
 spin.Age=age;if age<0 then return false end
 local remaining=Motion.Remaining(age,Config);local used={};local winner=false
 if age<Config.SpinDuration then
  for _,slot in ipairs(Motion.Slots(remaining,count))do
   local row=spin.Pool[slot.Pool];local model=if slot.Winner then run.Reward else row.Model
   if not slot.Winner then used[slot.Pool]=true else winner=true end
   local fade=if slot.Winner then 1 else math.clamp(remaining/.8,0,1)
   model.Parent=run.Scene
   model:ScaleTo(if slot.Winner then spin.WinnerScale*Config.WinningItemScale else row.Scale*math.max(.01,fade))
   local center=run.Stand.RewardPoint.Position+run.Stand.CameraPoint.CFrame.RightVector*(slot.X*Config.ItemSpacing)
   model:PivotTo(CFrame.new(center)*run.Stand.RewardPoint.CFrame.Rotation*CFrame.Angles(0,elapsed*.35,0))
  end
  local center=math.floor(remaining+.5)
  if spin.Tick and spin.Tick.SoundId~=""and spin.LastIndex~=center and elapsed-(spin.LastTick or -100)>.045 then spin.Tick:Play();spin.LastTick=elapsed end
  spin.LastIndex=center
 end
 for index,row in ipairs(spin.Pool)do if not used[index]then row.Model.Parent=nil end end
 if age>=Config.SpinDuration then
  run.Reward.Parent=run.Scene;run.Reward:ScaleTo(spin.WinnerScale*Config.WinningItemScale)
  local bob=math.sin(age*2)*.1*math.clamp((age-Config.SpinDuration)/.35,0,1)
  run.Reward:PivotTo(run.Stand.RewardPoint.CFrame*CFrame.new(0,bob,0)*CFrame.Angles(0,elapsed*.35,0))
  spin.Finished=true;return true
 end
 if not winner then run.Reward.Parent=nil end
 return false
end
function Spin.CameraPosition(run,position)
 local spin=run.Spin3D;local focus=run.Stand.RewardPoint.Position;local direction=position-focus
 if direction.Magnitude<.01 then return position end
 local settle=math.clamp(((spin.Age or 0)-Config.SpinDuration)/.6,0,1)
 local extra=1.2*math.clamp(1-(spin.Age or 0)/Config.SpinDuration,0,1)
 local distance=math.max(direction.Magnitude,spin.Fit+extra)
 return focus+direction.Unit*(distance+(direction.Magnitude-distance)*(settle*settle*(3-2*settle)))
end
return Spin
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="4314">
          <Properties>
            <string name="Name">RewardSpinMotion</string>
            <string name="Source"><![CDATA[--!nonstrict
local Motion={}
-- Integral of constant velocity followed by a cubic velocity decay: continuous speed, zero at end.
function Motion.Remaining(age,config)
 local duration=config.SpinDuration;local decel=math.min(config.DecelerationDuration,duration)
 local steady=duration-decel;local t=math.clamp(age,0,duration)
 local total=config.InitialSpeed*(steady+decel/4)
 local travelled
 if t<=steady then travelled=config.InitialSpeed*t else
  local q=(t-steady)/decel;travelled=config.InitialSpeed*steady+config.InitialSpeed*decel*(1-(1-q)^4)/4
 end
 return math.max(0,total-travelled)
end
function Motion.Slots(remaining,count)
 local rows={};local center=math.floor(remaining+.5);local half=math.floor(count/2)
 for offset=-half,half do local logical=center+offset
  table.insert(rows,{Logical=logical,Pool=(logical%count)+1,X=logical-remaining,Winner=logical==0})
 end
 return rows
end
return Motion
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="4315">
          <Properties>
            <string name="Name">RewardVFX</string>
            <string name="Source"><![CDATA[--!nonstrict
local RS=game:GetService("ReplicatedStorage")
local Config=require(script.Parent.RewardRevealConfig)
local Profiles=require(script.Parent.RewardRevealProfile)
local VFX={}
local function templates()return assert(RS.UIAssets:FindFirstChild("CrateRevealV25"),"Missing Edit reward effects")end
function VFX.Budget(mobile,quantity)
 local total=if mobile then Config.MaxMobileParticles else Config.MaxParticles
 return {Remaining=total,PerReward=math.max(1,math.floor(total/(quantity or 1))),Mobile=mobile,Beams=0}
end
function VFX.Attach(run,model,variation,percent,primary)
 local profile=Profiles.For(percent,variation);local source=templates()
 local highlight=source.RewardHighlight:Clone();highlight.Adornee=model;highlight.Enabled=false;highlight.Parent=model
 local fx=source.RewardEffects:Clone();fx:PivotTo(model:GetPivot());fx.Parent=model
 local budget=run.VisualBudget;local limit=if budget.Mobile then 1 else 2
 local beamAllowed=profile.Rank>=4 and budget.Beams<limit-(if primary then 0 else 1)
 if beamAllowed then budget.Beams+=1 end
 local record={Highlight=highlight,FX=fx,Profile=profile,Emitters={},Beams={},Lights={},Started=nil,Primary=primary}
 for _,obj in ipairs(fx:GetDescendants())do
  if obj:IsA("ParticleEmitter")then
   obj.Enabled=false;obj.Rate=0;obj.Color=ColorSequence.new(variation.Color);table.insert(record.Emitters,obj)
  elseif obj:IsA("Beam")then
   if beamAllowed then obj.Enabled=false;obj.Color=ColorSequence.new(variation.Color);table.insert(record.Beams,obj)else obj:Destroy()end
  elseif obj:IsA("PointLight")then obj.Color=variation.Color;obj.Enabled=false;table.insert(record.Lights,obj)end
 end
 highlight.FillColor=variation.Color;highlight.OutlineColor=variation.Color
 highlight.FillTransparency=profile.Fill;highlight.OutlineTransparency=profile.Outline
 return record
end
function VFX.Reveal(run,record,now)
 if record.Started then return false end;record.Started=now;record.Highlight.Enabled=true
 local eligible={}
 for _,emitter in ipairs(record.Emitters)do
  local rank=emitter:GetAttribute("MinimumVisualRank")or 1
  if record.Profile.Rank>=rank then table.insert(eligible,emitter)end
 end
 local total=math.min(run.VisualBudget.Remaining,run.VisualBudget.PerReward,math.floor(record.Profile.Burst*(if run.VisualBudget.Mobile then Config.MobileParticleScale else 1)))
 for i,emitter in ipairs(eligible)do
  local count=math.ceil(total/(#eligible-i+1));if count>0 then emitter:Emit(count);total-=count;run.VisualBudget.Remaining-=count end
 end
 local sound=record.FX:FindFirstChild("JackpotReveal",true)
 if record.Profile.Rank==5 and sound and sound.SoundId~=""then sound:Play()end
 return true
end
function VFX.Update(record,now)
 if not record.Started then return end
 local age=math.max(0,now-record.Started);local p=record.Profile
 record.Highlight.FillTransparency=math.clamp(p.Fill+math.sin(age*3)*.015,0,1)
 record.Highlight.OutlineTransparency=math.clamp(p.Outline+math.sin(age*4)*Config.HighlightPulse*p.Rank/5,0,1)
 for _,beam in ipairs(record.Beams)do
  beam.Enabled=age<p.Duration and (beam:GetAttribute("IsHalo")==true or p.Rank==5)
  if beam.Enabled then beam.Transparency=NumberSequence.new(math.clamp(.25+age/p.Duration*.75,0,1))end
 end
 for _,light in ipairs(record.Lights)do
  light.Enabled=age<p.Duration;light.Brightness=(.2+p.Rank*.12)*math.max(0,1-age/p.Duration)
 end
end
function VFX.Label(record,label,now)
 if not record.Started or record.Profile.Rank<4 or not label.Size then return end
 record.LabelSize=record.LabelSize or label.Size
 local s=record.LabelSize;local pulse=1+.025*math.sin((now-record.Started)*3)^2
 label.Size=UDim2.new(s.X.Scale*pulse,s.X.Offset*pulse,s.Y.Scale*pulse,s.Y.Offset*pulse)
end
function VFX.Chest(run,model,palette,variation)
 local highlight=templates().ChestHighlight:Clone();highlight.Adornee=model;highlight.Enabled=false;highlight.Parent=model
 return {Highlight=highlight,Palette=palette,Variation=variation,LastColor=variation.Color}
end
function VFX.UpdateChest(record,stage,p,elapsed)
 local h=record.Highlight;h.Enabled=stage=="Appear"or stage=="Rise"or stage=="Growth"or stage=="Shake"or stage=="Flash"
 if not h.Enabled then return end
 local color=record.Variation.Color;local palette=record.Palette
 if stage=="Shake"or stage=="Flash"then
  record.LockFrom=record.LockFrom or record.LastColor
  local t=if stage=="Flash"then 1 else math.clamp(p/Config.Chest.LockFraction,0,1)
  color=record.LockFrom:Lerp(color,t*t*(3-2*t))
 elseif #palette>0 then
  local phase=elapsed*Config.Chest.ColorSpeed;local index=math.floor(phase)
  color=palette[index%#palette+1]:Lerp(palette[(index+1)%#palette+1],phase-index)
 end
 record.LastColor=color;h.FillColor=color;h.OutlineColor=color
 h.FillTransparency=Config.Chest.Fill;h.OutlineTransparency=if stage=="Shake"or stage=="Flash"then .12 else Config.Chest.Outline
end
function VFX.Reaction(profile,age,mobile)
 if not profile or age<0 or age>Config.ReactionDuration then return 0,0,0 end
 local strength=profile.Reaction*(1-age/Config.ReactionDuration)^3*(if mobile then .5 else 1)
 return math.sin(age*29)*strength,math.sin(age*23)*strength*.6,
  math.rad(math.sin(age*19)*Config.MaxReactionDegrees*(strength/.1))
end
return VFX
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="4316">
          <Properties>
            <string name="Name">StandPromptVisibility</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Local prompt lease, scoped to the selected stand and private opening.
local Prompts={}
function Prompts.Release(lease)
 if not lease or lease.Released then return end;lease.Released=true
 if lease.Connection then lease.Connection:Disconnect();lease.Connection=nil end
 for object,row in pairs(lease.Saved)do
  row.Connection:Disconnect()
  pcall(function()if object.Enabled==false then object.Enabled=row.Previous end end)
 end
 table.clear(lease.Saved)
end
function Prompts.Acquire(stand,id)
 local lease={Id=id,Saved={},Released=false}
 local function hide(obj)
  if lease.Released or not obj:IsA("ProximityPrompt")or lease.Saved[obj]then return end
  local row={Previous=obj.Enabled,Writing=false};lease.Saved[obj]=row
  row.Connection=obj:GetPropertyChangedSignal("Enabled"):Connect(function()
   if lease.Released or row.Writing then return end
   if obj.Enabled then row.Previous=true;row.Writing=true;obj.Enabled=false;row.Writing=false end
  end)
  row.Writing=true;obj.Enabled=false;row.Writing=false
 end
 local ok,failure=pcall(function()
  lease.Connection=stand.DescendantAdded:Connect(hide)
  for _,obj in ipairs(stand:GetDescendants())do hide(obj)end
 end)
 if not ok then Prompts.Release(lease);error(failure)end
 return lease
end
return Prompts
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="4317">
          <Properties>
            <string name="Name">VisualProfile</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Presentation only. Every color comes from the registered variation, never an economy tier.
local Profiles={}
local tiers={Basic=1,Common=1,Uncommon=2,Rare=2,Gold=3,Arcoiris=3,Emote=4,Wings=4,Epic=5,Legendary=5,Blood=6,Galaxy=6}
local stageMap={FlashSparks="Flash",SoftGlow="Appear,Growth,Reward",RiseStreaks="Rise",Soft="Appear"}
function Profiles.For(variation)
 local tier=tiers[variation.Id]or 1
 return {Tier=tier,Color=variation.Color,Particles=.65+tier*.15,Light=.65+tier*.18,
  Bob=.1+tier*.012,Spin=.35+tier*.035,Zoom=3+tier*.35,Special=tier>=5}
end
function Profiles.Count(emitter,stage,profile)
 local stages=emitter:GetAttribute("OpeningStages")or stageMap[emitter.Name]or "Flash"
 if not (","..stages..","):find(","..stage..",",1,true)then return 0 end
 local count=emitter:GetAttribute("BurstCount")or 5
 if type(count)~="number"or count~=count or count==math.huge then return 0 end
 return math.clamp(math.floor(count*(profile and profile.Particles or 1)),0,32)
end
function Profiles.Emit(effects,stage,profile)
 local remaining=64
 for _,item in ipairs(effects:GetDescendants())do if item:IsA("ParticleEmitter")then
  local count=math.min(remaining,Profiles.Count(item,stage,profile))
  if count>0 then item:Emit(count);remaining-=count end
 end end
end
function Profiles.Pose(stage,p)
 local eased=p*p*(3-2*p)
 if stage=="Appear"then return eased*.5,.15+eased*.65
 elseif stage=="Rise"then return .5+eased*2,.8
 elseif stage=="Growth"then return 2.5,.8+eased*.45
 elseif stage=="Shake"or stage=="Flash"then return 2.5,1.25 end
 return 0,.15
end
function Profiles.Rotation(plan,elapsed)
 local speeds={Intro=.15,CameraReveal=.15,Appear=.4,Rise=1,Growth=2,Shake=3,Flash=3,Reward=.4,Outro=.2}
 local angle,prior=0,.15
 for _,stage in ipairs(plan.Stages)do
  local t=math.clamp(elapsed-stage.Start,0,stage.Duration);local target=speeds[stage.Name]
  angle+=prior*t+(target-prior)*t*t/(2*stage.Duration)
  if t<stage.Duration then break end;prior=target
 end
 return angle
end
return Profiles
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="4318">
        <Properties>
          <string name="Name">DeathFeedback</string>
        </Properties>
        <Item class="ModuleScript" referent="4319">
          <Properties>
            <string name="Name">DeathEffectPlayer</string>
            <string name="Source"><![CDATA[--!nonstrict
local Config=require(game.ReplicatedStorage.Shared.DeathFeedbackConfig)
local Catalog=require(game.ReplicatedStorage.Shared.DeathEffectDefinitions)
local Scope=require(script.Parent.Scope)
local Player={}
local function number(object,key,fallback,max)
 local value=object:GetAttribute(key)
 if type(value)~="number" or value~=value then value=fallback end
 return math.clamp(value,0,max)
end
function Player.Play(payload)
 local scope=Scope.new()
 if not Config.DeathEffects.Enabled then scope:Destroy();return scope end
 local definition=Catalog[payload.EffectId]
 local assets=game.ReplicatedStorage:FindFirstChild("DeathEffectAssets")
 local source=definition and assets and assets:FindFirstChild(definition.ModelName)
 if not source or not source:IsA("Model") then
  warn("[DeathFeedback] Physical effect missing: "..tostring(payload.EffectId));scope:Destroy();return scope
 end
 local model=scope:Add(source:Clone())
 model.Name="DeathFeedback_"..payload.EliminationId
 local origin=model:FindFirstChild("Origin")
 if not origin or not origin:IsA("BasePart") then scope:Destroy();return scope end
 -- Origin is the editable physical origin, independently of the template's artistic pivot.
 model:PivotTo(payload.ImpactCFrame*origin.CFrame:Inverse()*model:GetPivot())
 local duration=number(model,"Duration",definition.Duration,Config.DeathEffects.MaxDuration)
 for _,object in ipairs(model:GetDescendants()) do
  if object:IsA("ParticleEmitter") then object.Enabled=false
  elseif object:IsA("Sound") then object.Looped=false;object:Stop()
  elseif object:IsA("PointLight") then object.Brightness=0 end
 end
 model.Parent=workspace -- LOCAL clone only, never replicated from the server into Workspace.
 for _,object in ipairs(model:GetDescendants()) do
  if object:IsA("ParticleEmitter") and Config.DeathEffects.ParticlesEnabled then
   scope:Delay(number(object,"EmitDelay",definition.EmitDelay,duration),function()
    if object.Parent then object:Emit(math.floor(number(object,"EmitCount",definition.EmitCount,80))) end
   end)
  elseif object:IsA("Sound") and Config.DeathEffects.SoundsEnabled and object.SoundId~="" then
   scope:Delay(number(object,"PlayDelay",definition.PlayDelay,duration),function()if object.Parent then object:Play() end end)
  elseif object:IsA("PointLight") and Config.DeathEffects.ParticlesEnabled then
   object.Brightness=number(object,"LightPeak",3,8)
   scope:Tween(object,.25,{Brightness=0})
  end
 end
 scope:Delay(duration,function() scope:Destroy() end)
 return scope
end
return Player
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="4320">
          <Properties>
            <string name="Name">DeathNotifications</string>
            <string name="Source"><![CDATA[--!nonstrict
local Config=require(game.ReplicatedStorage.Shared.DeathFeedbackConfig).Notifications
local Scope=require(script.Parent.Scope)
local Notifications={Active={},Serial=0}
function Notifications.Clear()
 for _,scope in ipairs(Notifications.Active) do scope:Destroy() end
 table.clear(Notifications.Active)
end
function Notifications.Play(payload)
 if not Config.Enabled then return end
 for i=#Notifications.Active,1,-1 do if Notifications.Active[i].Dead then table.remove(Notifications.Active,i) end end
 while #Notifications.Active>=math.max(1,Config.MaxVisible) do table.remove(Notifications.Active,1):Destroy() end
 local playerGui=game.Players.LocalPlayer:FindFirstChild("PlayerGui")
 local hud=playerGui and playerGui:FindFirstChild("DeathFeedbackHUD")
 local container=hud and hud:FindFirstChild("NotificationContainer")
 local template=container and container:FindFirstChild("NotificationTemplate")
 if not template or not template:IsA("CanvasGroup") then warn("[DeathFeedback] DeathFeedbackHUD template missing");return end
 local scope=Scope.new()
 table.insert(Notifications.Active,scope)
 Notifications.Serial+=1
 local row=scope:Add(template:Clone())
 row.Name="Notification_"..payload.EliminationId
 row.LayoutOrder=Notifications.Serial;row.Visible=true;row.GroupTransparency=1
 local message=row:FindFirstChild("MessageLabel")
 local icon=row:FindFirstChild("Icon")
 if not message or not icon then scope:Destroy();warn("[DeathFeedback] Invalid notification template");return end
 message.RichText=false
 local victim=string.sub(tostring(payload.VictimName),1,64)
 local killer=string.sub(tostring(payload.KillerName or ""),1,64)
 message.Text=payload.Kind=="CreditedKill" and (killer.." tiró a "..victim) or (victim.." se cayó")
 local credited=payload.Kind=="CreditedKill"
 icon.Text=credited and "✦" or "↓"
 icon.TextColor3=credited and (row:GetAttribute("KillColor") or Color3.fromRGB(255,174,64))
  or (row:GetAttribute("FallColor") or Color3.fromRGB(135,179,255))
 row.Parent=container -- UIListLayout stacks clones; authored container Position is untouched.
 local scale=row:FindFirstChildOfClass("UIScale")
 if scale then local original=scale.Scale;scale.Scale=original*.9;scope:Tween(scale,Config.FadeInDuration,{Scale=original}) end
 scope:Tween(row,Config.FadeInDuration,{GroupTransparency=0})
 local sound=row:FindFirstChild("NotificationSound")
 if sound and sound:IsA("Sound") then
  if Config.LocalSoundId~="" then sound.SoundId=Config.LocalSoundId end
  sound.Volume=Config.LocalSoundVolume
  if sound.SoundId~="" then sound:Play() end
 end
 scope:Delay(Config.FadeInDuration+Config.DisplayDuration,function()
  scope:Tween(row,Config.FadeOutDuration,{GroupTransparency=1})
  scope:Delay(Config.FadeOutDuration,function()scope:Destroy()end)
 end)
end
return Notifications
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="4321">
          <Properties>
            <string name="Name">Scope</string>
            <string name="Source"><![CDATA[--!nonstrict
local TweenService=game:GetService("TweenService")
local Scope={}
Scope.__index=Scope
function Scope.new() return setmetatable({Dead=false,Objects={},Threads={},Tweens={}},Scope) end
function Scope:Add(object) table.insert(self.Objects,object);return object end
function Scope:Delay(seconds,callback)
 local thread
 thread=task.delay(math.max(0,seconds),function()
  self.Threads[thread]=nil
  if not self.Dead then
   local ok,failure=pcall(callback)
   if not ok then warn("[DeathFeedback] "..tostring(failure));self:Destroy() end
  end
 end)
 self.Threads[thread]=true
 return thread
end
function Scope:Tween(object,duration,properties)
 if self.Dead then return end
 local tween=TweenService:Create(object,TweenInfo.new(math.max(.001,duration),Enum.EasingStyle.Sine),properties)
 table.insert(self.Tweens,tween);tween:Play()
 return tween
end
function Scope:Destroy()
 if self.Dead then return end
 self.Dead=true
 for thread in pairs(self.Threads) do pcall(task.cancel,thread) end
 for _,tween in ipairs(self.Tweens) do tween:Cancel();tween:Destroy() end
 for _,object in ipairs(self.Objects) do object:Destroy() end
 table.clear(self.Threads);table.clear(self.Objects);table.clear(self.Tweens)
end
return Scope
]]></string>
          </Properties>
        </Item>
