        <BinaryString name="AttributesSerialize">AQAAABEAAABVSVBsdXNab29tRW5hYmxlZAMA</BinaryString>
        <bool name="AutoLocalize">true</bool>
        <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
