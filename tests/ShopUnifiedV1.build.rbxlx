        <Item class="ModuleScript" referent="4281">
          <Properties>
            <string name="Name">EndCinematicController</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Session-authorized presentation and independent Studio preview orchestrator.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Config = require(game.ReplicatedStorage.Shared.EndCinematicConfig)
local modules = script.Parent.Parent.EndCinematic.Modules
local Camera = require(modules.EndCinematicCamera)
local Transition = require(modules.EndCinematicTransition)
local Avatars = require(modules.EndCinematicAvatars)
local Animations = require(modules.EndCinematicAnimations)
local Particles = require(modules.EndCinematicParticles)
local Audio = require(modules.EndCinematicAudio)
local HUD = require(modules.EndCinematicHUD)
local Ranking = require(modules.EndCinematicRanking)
local Billboards = require(modules.EndCinematicBillboards)
local Controller = { Name = "EndCinematicController", _serial = 0 }

function Controller:Initialize()
 if self._initialized then return end
 self._initialized = true
end

function Controller:_getMusicController()
 if self._context and typeof(self._context.GetController) == "function" then
  return self._context:GetController("MusicController")
 end
 local controllers = script.Parent
 local musicScript = controllers and controllers:FindFirstChild("MusicController")
 if musicScript and musicScript:IsA("ModuleScript") then
  local ok, mod = pcall(require, musicScript)
  if ok then return mod end
 end
 return nil
end

function Controller:IsPlaying() return self._run ~= nil end

function Controller:SetPreviewOptions(floatingEnabled,billboardsEnabled)
 local run=self._run
 if not RunService:IsStudio() or not run or (run.Context and run.Context.IsMatch) then return false end
 run.FloatingEnabled=floatingEnabled
 run.BillboardsEnabled=billboardsEnabled
 if floatingEnabled then
  if run.CameraDone then Camera.StartFloating(run,run.Destination) end
 else Camera.StopFloating(run) end
 if not billboardsEnabled then Billboards.Cleanup(run)
 elseif run.CameraDone and run.WalksDone>=#run.Rigs then
  task.spawn(function()
   local ok,failure=pcall(Billboards.Play,run)
   if not ok and run:IsAlive() then warn(failure); self:Stop() end
  end)
 end
 return true
end

function Controller:Stop()
 local run = self._run
 if not run then return end
 self._run = nil
 self._serial += 1
 for _, connection in ipairs(run.Connections) do connection:Disconnect() end
 for _, tween in ipairs(run.Tweens) do tween:Cancel(); tween:Destroy() end
 -- Each subsystem cleans only its own resources; invalidation happens first.
 for _, subsystem in ipairs({ Animations, Audio, Particles, Billboards, Avatars, Transition, HUD, Camera }) do
  if subsystem.Cleanup then
   local ok, err = pcall(subsystem.Cleanup, run)
   if not ok then warn("[EndCinematic] Cleanup: " .. tostring(err)) end
  end
 end
 for _, object in ipairs(run.Resources) do object:Destroy() end
 if run.MusicReason then
  local musicController = self:_getMusicController()
  if musicController and typeof(musicController.Resume) == "function" then
   local fadeIn = (Config.Music and Config.Music.FadeInDuration) or 0.6
   musicController:Resume(run.MusicReason, run.MusicToken, fadeIn)
  end
  run.MusicReason = nil
  run.MusicToken = nil
 end
 if run.Context and run.Context.OnStopped then run.Context.OnStopped() end
end

function Controller:Destroy()
 self:Stop()
 self._initialized = false
end

local function finite(value)
 return type(value) == "number" and value == value and math.abs(value) < math.huge
end

function Controller:Play(data, sceneContext)
 self:Initialize()
 local isMatch = sceneContext and sceneContext.IsMatch == true
 if isMatch then
  if self._serverPlayback ~= sceneContext or sceneContext.Payload ~= data then return false, "UnauthorizedContext" end
 else
  if not RunService:IsStudio() then return false, "PreviewOnly" end
  if Players.LocalPlayer:GetAttribute("MatchId") ~= nil then return false, "MatchActive" end
 end
 if self:IsPlaying() then return false, "AlreadyPlaying" end
 local stage = sceneContext and sceneContext.Scene
 if not stage then return false, "SceneContextRequired" end
 if type(data) ~= "table" or type(data.Winners) ~= "table" or (#data.Winners < 1 and data.WinningTeam ~= "Draw") or #data.Winners > Config.Winners.MaxVisible then return false, "InvalidWinners" end
 if type(data.MatchId) ~= "string" or (data.WinningTeam ~= "Red" and data.WinningTeam ~= "Blue" and data.WinningTeam ~= "Draw") or type(data.Score) ~= "table" or not finite(data.Score.Red) or not finite(data.Score.Blue) then return false, "InvalidPayload" end
 if data.EligibleParticipantCount ~= nil and (not finite(data.EligibleParticipantCount) or data.EligibleParticipantCount < 1 or data.EligibleParticipantCount % 1 ~= 0) then return false, "InvalidParticipantCount" end
 local winners = {}
 for _, w in ipairs(data.Winners) do
  if type(w) ~= "table" or not finite(w.UserId) or w.UserId == 0 or type(w.DisplayName) ~= "string" or not finite(w.Slot) then return false, "InvalidWinner" end
  table.insert(winners, table.clone(w))
 end
 table.sort(winners, function(a,b) return a.Slot == b.Slot and a.UserId < b.UserId or a.Slot < b.Slot end)
 -- Explicit Mode always wins, including XvX with only one connected winner.
 -- Legacy no-Mode previews: one winner uses 1v1; multiple winners use XvX.
 local mode = data.Mode
 if mode == nil then mode = #winners == 1 and "1v1" or "XvX" end
 if type(mode) ~= "string" or mode == "" then return false, "InvalidMode" end
 local ranking,rankingError=Ranking.Resolve(data,isMatch)
 if not ranking then return false,rankingError end
 local visible=ranking.VisibleParticipants
 local from, target, cameraError = Camera.Resolve(stage, mode)
 if not from then return false, cameraError end
 local slots = stage:FindFirstChild("Players")
 for index = 1,#visible do
  local slot = slots and slots:FindFirstChild("SlotPlayer_" .. index)
  if not slot or not slot:IsA("BasePart") then return false, "InsufficientSlots" end
 end
 if not workspace.CurrentCamera then return false, "CameraMissing" end
 local gui, hudError = HUD.Resolve()
 if not gui then return false, hudError end
 self._serial += 1
 local run = { Id = self._serial, PlaybackId = self._serial, Mode = mode, Resources = {}, Connections = {}, Tweens = {}, Tracks = {}, Rigs = {}, WalksDone = 0, Destination = target }
 self._run = run
 run.Context = sceneContext
 run.Scene = stage
 run.Ranking=ranking
 run.WinningTeam=data.WinningTeam
 run.FloatingEnabled=not sceneContext or sceneContext.FloatingEnabled~=false
 run.BillboardsEnabled=not sceneContext or sceneContext.BillboardsEnabled~=false
 if not Config.Music or Config.Music.SuspendDuringCinematic ~= false then
  local musicController = self:_getMusicController()
  if musicController and typeof(musicController.Suspend) == "function" then
   local fadeOut = (Config.Music and Config.Music.FadeOutDuration) or 0.4
   local reason = if isMatch then "EndCinematic" else "EndCinematicPreview"
   run.MusicReason = reason
   run.MusicToken = musicController:Suspend(reason, fadeOut)
  end
 end
 function run:IsAlive() return Controller._run == self and Controller._serial == self.Id end
 function run:Tween(object, duration, properties)
  if not self:IsAlive() then return false end
  local tween = TweenService:Create(object, TweenInfo.new(math.max(duration,0.001), Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), properties)
  table.insert(self.Tweens,tween)
  tween:Play()
  local result = tween.Completed:Wait()
  return self:IsAlive() and result == Enum.PlaybackState.Completed
 end
 run.Container = Instance.new("Folder")
 run.Container.Name = "EndCinematicLocal_" .. run.Id
 run.Container.Parent = workspace
 table.insert(run.Resources,run.Container)
 local function stop() if run:IsAlive() then self:Stop() end end
 run.OnRigRemoved=stop
 local function guarded(callback)
  task.spawn(function()
   local ok,err = xpcall(callback,debug.traceback)
   if not ok and run:IsAlive() then warn("[EndCinematic] " .. tostring(err)); stop() end
  end)
 end
 table.insert(run.Connections,workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(stop))
 table.insert(run.Connections,stage.Destroying:Connect(stop))
 table.insert(run.Connections,Players.LocalPlayer.CharacterAdded:Connect(stop))
 table.insert(run.Connections,Players.LocalPlayer:GetAttributeChangedSignal("MatchId"):Connect(function()
  local id = Players.LocalPlayer:GetAttribute("MatchId")
  if (isMatch and id ~= data.MatchId) or (not isMatch and id ~= nil) then stop() end
 end))
 guarded(function()
  HUD.Prepare(run,gui,sceneContext and sceneContext.OnReturn or stop)
  run.Panels = Transition.Prepare(run)
  Audio.PlayTransition(run, true)
  if not Transition.Play(run,run.Panels,true) then return end
  Camera.Prepare(run,from)
  for index,winner in ipairs(visible) do
   if not run:IsAlive() then return end
   Avatars.Prepare(run,winner,slots["SlotPlayer_" .. index],stage,target)
  end
  if not run:IsAlive() then return end
  Billboards.Prepare(run)
  Particles.Prepare(run,stage)
  Audio.Prepare(run,stage)
  task.wait(Config.Transition.ClosedHoldDuration)
  if not run:IsAlive() then return end
  if isMatch then
   sceneContext.OnPrepared()
   local deadline = os.clock() + Config.Results.PreparationTimeout
   while run:IsAlive() and not sceneContext.StartAt and os.clock() < deadline do task.wait() end
   if not run:IsAlive() then return end
   if not sceneContext.StartAt then stop(); return end
   while run:IsAlive() and workspace:GetServerTimeNow() < sceneContext.StartAt do task.wait() end
   if not run:IsAlive() then return end
  end
  Particles.Play(run); Audio.Play(run)
  guarded(function()
   Camera.Play(run,from,target)
   if run:IsAlive() then Particles.Stop(run) end
  end)
  for index,entry in ipairs(run.Rigs) do guarded(function() Animations.Play(run,entry,index) end) end
  Audio.PlayTransition(run, false)
  if not Transition.Play(run,run.Panels,false) then return end
  while run:IsAlive() and (not run.CameraDone or run.WalksDone < #run.Rigs) do task.wait() end
  task.wait(Config.HUD.ShowDelay)
  if run:IsAlive() then
   Billboards.Play(run)
   HUD.Play(run,data,winners)
  end
 end)
 return true
end
function Controller:Init(context)
 self._context = context
 self:Initialize()
 self._closedResults = self._closedResults or {}
end

function Controller:Start()
 if self._remoteConnection then return end
 local match = game.ReplicatedStorage:WaitForChild("Remotes", 10)
 match = match and match:WaitForChild("Match", 10)
 local remote = match and match:WaitForChild("EndCinematic", 10)
 local actions = match and match:WaitForChild("EndCinematicAction", 10)
 if not remote or not actions then warn("[EndCinematic] Match remotes missing"); return end
 self._closedResults = self._closedResults or {}
 self._remoteConnection = remote.OnClientEvent:Connect(function(phase, payload)
  if type(payload) ~= "table" or type(payload.SessionId) ~= "string"
   or payload.MatchId ~= payload.SessionId or type(payload.Token) ~= "string"
   or not finite(payload.StateVersion) then return end
  local id = payload.SessionId
  local pending = self._serverPlayback
  if phase == "Returned" then
   if pending and pending.Payload.SessionId == id and pending.Payload.Token == payload.Token
    and pending.Payload.StateVersion == payload.StateVersion then
    pending.Exited = true
    self._closedResults[id] = true
    self:Stop()
    self._serverPlayback = nil
   end
   return
  end
  if phase == "Start" then
   if pending and pending.Payload.SessionId == id and pending.Payload.Token == payload.Token
    and pending.Payload.StateVersion == payload.StateVersion and not pending.Exited and finite(payload.StartAt) then
    pending.StartAt = pending.StartAt or payload.StartAt
   end
   return
  end
  if phase ~= "Prepare" or self._closedResults[id] or pending then return end
  if type(payload.EligibleParticipantUserIds) ~= "table"
   or not table.find(payload.EligibleParticipantUserIds, Players.LocalPlayer.UserId)
   or payload.SceneContainer ~= "Match_" .. id or payload.SceneName ~= "ScenarioFinal" then return end
  if Players.LocalPlayer:GetAttribute("MatchId") ~= id then return end
  self:Stop() -- Stop a development preview before claiming the real presentation.
  pending = { IsMatch = true, Payload = payload, Exited = false }
  self._serverPlayback = pending
  local function send(action)
   if pending.Exited or self._serverPlayback ~= pending then return end
   actions:FireServer(action, id, payload.StateVersion, payload.Token)
  end
  pending.OnReturn = function() send("Return") end
  pending.OnPrepared = function() send("Prepared") end
  pending.OnStopped = function()
   if not pending.Exited and self._serverPlayback == pending then
    send("Failed")
    pending.Exited = true
    self._closedResults[id] = true
    self._serverPlayback = nil
   end
  end
  task.spawn(function()
   local deadline = os.clock() + Config.Results.SceneWaitTimeout
   if typeof(payload.SceneOrigin) == "Vector3" then
    task.spawn(function() pcall(function() Players.LocalPlayer:RequestStreamAroundAsync(payload.SceneOrigin, Config.Results.SceneWaitTimeout) end) end)
   end
   local scene
   while self._serverPlayback == pending and not pending.Exited and os.clock() < deadline do
    local active = workspace:FindFirstChild("ActiveMatches")
    local container = active and active:FindFirstChild(payload.SceneContainer)
    local candidate = container and container:FindFirstChild(payload.SceneName)
    if candidate and candidate:IsA("Model") and candidate:GetAttribute("SessionId") == id
     and container:GetAttribute("SessionId") == id then
     local from = Camera.Resolve(candidate, payload.Mode)
     local slots = candidate:FindFirstChild("Players")
     local descriptions = candidate:FindFirstChild("WinnerDescriptions")
     local complete = from ~= nil and slots ~= nil and descriptions ~= nil
     local visible=payload.ResultSnapshot and payload.ResultSnapshot.VisibleParticipants or payload.Winners or {}
     for index, winner in ipairs(visible) do
      complete = complete and slots:FindFirstChild("SlotPlayer_" .. index) ~= nil
       and (not winner.DescriptionKey or descriptions:FindFirstChild(winner.DescriptionKey) ~= nil)
     end
     if complete then scene = candidate; break end
    end
    task.wait(.05)
   end
   if self._serverPlayback ~= pending or pending.Exited then return end
   if not scene or Players.LocalPlayer:GetAttribute("MatchId") ~= id then
    pending.OnStopped(); return
   end
   pending.Scene = scene
   local ok, reason = self:Play(payload, pending)
   if not ok then warn("[EndCinematic] Match presentation rejected: " .. tostring(reason)); pending.OnStopped() end
  end)
 end)
end
return Controller
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="4282">
          <Properties>
            <string name="Name">InventoryController</string>
            <string name="Source"><![CDATA[--!nonstrict
local Players=game:GetService('Players')
local RS=game:GetService('ReplicatedStorage')
local RunService=game:GetService('RunService')
local Tween=game:GetService('TweenService')
local View=require(script.Parent.Parent.UI.InventoryView)
local Pool=require(script.Parent.Parent.Social.ViewportPool)
local Catalog=require(RS.Shared.SlapCrates.Catalog)
local player=Players.LocalPlayer
local Controller={Name='InventoryController'}
local C=Color3.fromRGB
local errors={RateLimited='Esperá un momento y reintentá.',NotOwned='Este objeto ya no está en tu inventario.',PlayerUnavailable='El inventario está disponible en el lobby.',PlayerBusy='Terminá el intercambio antes de equipar.',ProductUnavailable='Este recurso no está disponible.',DataNotLoaded='Tus datos todavía están cargando.',PersistencePending='La selección sigue pendiente de confirmación.',NoResponse='No se pudo confirmar la operación. Actualizá antes de reintentar.'}
local function reason(r)return errors[r]or 'No se pudo completar la solicitud. Reintentá en un momento.'end
local function color(item)
 local v=Catalog.Variations.ById[item.Rarity or item.VariationId]
 return v and v.Color or ({Rare=C(76,169,255),Epic=C(183,116,255),Legendary=C(255,198,69)})[item.Rarity]or C(89,240,123)
end
function Controller:Blocked()
 if player:GetAttribute('MatchId')or player:GetAttribute('ResultsSessionId')then return true end
 local gui=player.PlayerGui
 for _,name in ipairs({'TradeHUD','TradeRequestHUD','CrateOpeningHUD'})do local h=gui:FindFirstChild(name);if h and h.Enabled then return true end end
 local cinematic=self.Context:GetController('CrateStandCinematicController')
 return cinematic and cinematic.IsPlaying and cinematic:IsPlaying()or false
end
function Controller:Status(t)self.Main.Content.Footer.Status.Text=t end
function Controller:Clear()
 for _,row in ipairs(self.Rows)do row.Connection:Disconnect();row.Card:Destroy()end
 self.Rows={};self.Pool:Clear()
end
function Controller:Close()
 if not self.Hud then return end
 self.Generation+=1;self.Loading=false
 local nav=self.Context:GetController('WindowNavigationController');if nav then nav:Forget('InventoryHUD')end
 self.Hud.Enabled=false;self.Pool:Clear()
end
function Controller:Open(category)
 if not self.Hud or self:Blocked()then return end
 if category and View.Icons[category]then self.Category=category end
 self.Hud.Enabled=true;self.Main.OpenScale.Scale=.96
 Tween:Create(self.Main.OpenScale,TweenInfo.new(.18,Enum.EasingStyle.Quad),{Scale=1}):Play()
 self:Load(1)
end
function Controller:Preview(view,icon,item)
 local success=false
 if item.Category=='Slaps'then success=self.Pool:Slap(view,item)
 elseif item.Category=='Crates'then
  local root=RS:FindFirstChild('CrateEffects');local definition=Catalog.Crates.ById[item.ProductId]
  success=self.Pool:Add(view,root and root:FindFirstChild(definition and definition.Model or item.ProductId),false)
 end
 view.Visible=success;icon.Visible=not success
 icon.Image=type(item.Icon)=='string'and item.Icon~=''and item.Icon or View.Icons[item.Category]
end
function Controller:Select(item)
 self.Selected=item;local d=self.Main.Content.Detail
 self.Pool:Remove(d.Preview)
 d.Title.Text=item and item.DisplayName or 'Seleccioná un objeto'
 d.Rarity.Text=item and (item.VariationName or item.Rarity or (item.Category=='Crates'and 'CAJA CERRADA')or '')or ''
 d.Quantity.Text=item and (item.Category=='Crates'and ('Tenés '..item.Quantity..' caja'..(item.Quantity==1 and ''or 's'))or item.Quantity and item.Quantity>1 and ('Tenés '..item.Quantity..' unidades')or 'EN TU INVENTARIO')or ''
 d.Description.Text=item and (item.Category=='Crates'and 'Consultá sus premios y abrila con el sistema de cajas.'or item.Equipped and 'Lo estás usando actualmente.'or 'Equipalo para tu próxima partida.')or 'Acá aparecerán los detalles de tu selección.'
 d.Preview.Visible=false;d.Icon.Visible=false
 if item then local tint=color(item);d.Rarity.TextColor3=tint;d.Aura.BackgroundColor3=tint;self:Preview(d.Preview,d.Icon,item)end
 local allowed=item~=nil and not self.PendingEquip and not self.Loading and not item.Equipped and item.Available~=false
 if item and item.Category=='Crates'then allowed=not self.Loading and not self.PendingEquip end
 d.Action.Active=allowed;d.Action.Selectable=allowed
 d.Action.Text=not item and 'SELECCIONÁ UN OBJETO'or self.PendingEquip and 'GUARDANDO…'or item.Category=='Crates'and 'VER CAJA / ABRIR'or item.Equipped and '✓ EQUIPADO'or item.Available==false and 'NO DISPONIBLE'or 'EQUIPAR'
 d.Action.BackgroundColor3=allowed and C(35,220,79)or C(53,78,70)
 for _,row in ipairs(self.Rows)do row.Card.Stroke.Color=row.Item==item and C(222,255,233)or C(63,89,88);row.Card.Stroke.Thickness=row.Item==item and 2 or 1 end
end
function Controller:Render(data)
 local selected=self.Selected and self.Selected.ProductId;self:Clear();self.Data=data
 local content=self.Main.Content
 for i,item in ipairs(data.Items)do
  local card=self.Hud.CardTemplate:Clone();card.Name='Item_'..i;card.Visible=true;card.LayoutOrder=i
  card.ItemName.Text=item.DisplayName;card.ItemName.TextColor3=color(item);card.Aura.BackgroundColor3=color(item)
  card.Equipped.Visible=item.Equipped==true;card.Count.Text=item.Quantity and item.Quantity>1 and 'x'..item.Quantity or ''
  card.Parent=content.Grid
  local connection=card.Activated:Connect(function()if not self.Loading then self:Select(item)end end)
  table.insert(self.Rows,{Card=card,Item=item,Connection=connection})
 end
 self.Page=data.Page;content.Footer.Page.Text=data.Page..' / '..data.Pages
 content.Footer.Previous.Active=data.Page>1;content.Footer.Next.Active=data.HasNext
 content.Footer.Previous.TextTransparency=data.Page>1 and 0 or .6;content.Footer.Next.TextTransparency=data.HasNext and 0 or .6
 content.Empty.Visible=#data.Items==0
 content.Empty.Text=data.FilteredTotal==0 and data.Total>0 and 'No encontramos objetos con ese nombre.'or self.Category=='Crates'and 'Todavía no tenés cajas.\nCompralas en la tienda de cajas del lobby.'or 'Todavía no tenés objetos en esta categoría.'
 content.Footer.More.Text=self.Category=='Crates'and '¿DÓNDE COMPRAR?'or 'VER MIS CAJAS'
 local pick=data.Items[1];for _,item in ipairs(data.Items)do if item.ProductId==selected then pick=item;break end end
 self:Select(pick);self:Layout();self:RefreshPreviews();self:Status(data.FilteredTotal..' tipos de objetos')
end
function Controller:Load(page)
 if not self.Hud.Enabled or self:Blocked()then return end
 self.Generation+=1;local token=self.Generation;local category=self.Category
 self.Loading=true;self.Main.Content.Detail.Action.Active=false;self:Status('Cargando…')
 for key in pairs(View.Icons)do self.Main.Tabs[key].BackgroundColor3=key==category and C(31,105,73)or C(28,43,53)end
 local query=string.sub(self.Main.Header.Search.Text,1,80)
 task.spawn(function()
  -- Shares the Social request budget with the profile; wait before following its link.
  task.wait(.3)
  if token~=self.Generation or not self.Hud.Enabled then return end
  local ok,response=pcall(self.Remote.InvokeServer,self.Remote,category,page or 1,query)
  if ok and type(response)=='table'and response.Reason=='RateLimited'then
   task.wait(.35);if token~=self.Generation or not self.Hud.Enabled then return end
   ok,response=pcall(self.Remote.InvokeServer,self.Remote,category,page or 1,query)
  end
  if token~=self.Generation or not self.Hud.Enabled then return end
  self.Loading=false;self.LastRefresh=os.clock()
  if not ok or type(response)~='table'or not response.Ok then
   self:Clear();self:Select(nil);self.Main.Content.Empty.Visible=true
   self.Main.Content.Empty.Text=reason(type(response)=='table'and response.Reason or 'NoResponse');self:Status('Usá Actualizar para reintentar.');self.Main.Content.Footer.More.Text='ACTUALIZAR';self.Failed=true;return
  end
  local data=response.Inventory
  if type(data)~='table'or data.UserId~=player.UserId or data.Category~=category then self:Close();return end
  self.Failed=false;self:Render(data)
 end)
end
function Controller:EquipSelected()
 local item=self.Selected
 if not item or self.Loading or self.PendingEquip or self:Blocked()then return end
 if item.Category=='Crates'then
  local crates=self.Context:GetController('CrateController')
  if crates and item.Product then crates:SetCatalog({item.Product});crates:ShowCrate(item.ProductId)end
  return
 end
 if item.Equipped or item.Available==false then return end
 self.PendingEquip=true;local token=self.Generation;self:Select(item);self:Status('Guardando selección…')
 task.spawn(function()
  task.wait(.3)
  local ok,response=pcall(self.Equip.InvokeServer,self.Equip,item.Category,item.ProductId,1)
  self.PendingEquip=false
  if not self.Hud.Enabled then return end
  if ok and type(response)=='table'and response.Ok then self:Load(self.Page)
  elseif token==self.Generation then self:Select(self.Selected);self:Status(reason(type(response)=='table'and response.Reason or 'NoResponse'))end
 end)
end
function Controller:RefreshPreviews()
 if not self.Hud.Enabled then return end
 local grid=self.Main.Content.Grid;local active=0
 for _,row in ipairs(self.Rows)do
  local p=row.Card.AbsolutePosition;local s=row.Card.AbsoluteSize
  if p.Y+s.Y>grid.AbsolutePosition.Y and p.Y<grid.AbsolutePosition.Y+grid.AbsoluteSize.Y and active<8 then
   self:Preview(row.Card.Preview,row.Card.Icon,row.Item);active+=1
  else self.Pool:Remove(row.Card.Preview)end
 end
end
function Controller:Layout()
 local m=self.Main;local narrow=m.AbsoluteSize.X<760;local side=narrow and 82 or 112
 m.Tabs.Size=UDim2.new(0,side,1,0)
 m.Header.Position=UDim2.fromOffset(side+18,12);m.Header.Size=UDim2.new(1,-side-34,0,54)
 m.Header.Title.Visible=not narrow;m.Header.Subtitle.Visible=not narrow
 m.Header.Search.Position=UDim2.fromOffset(narrow and 0 or 196,3);m.Header.Search.Size=UDim2.new(1,narrow and -58 or -254,0,44)
 m.Content.Position=UDim2.fromOffset(side+18,80);m.Content.Size=UDim2.new(1,-side-34,1,-96)
 local height=math.min(112,(m.AbsoluteSize.Y-24)/4)
 for i,key in ipairs({'Slaps','DeathEffects','PointEffects','Crates'})do m.Tabs[key].Position=UDim2.fromOffset(8,12+(i-1)*height);m.Tabs[key].Size=UDim2.new(1,-16,0,height-8)end
 local width=m.Content.Grid.AbsoluteSize.X;local columns=width>=520 and 3 or width>=305 and 2 or 1
 m.Content.Grid.Layout.CellSize=UDim2.new(1/columns,-9,0,math.clamp(m.AbsoluteSize.Y*.32,150,195))
 for _,label in ipairs({m.Content.Detail.Title,m.Content.Detail.Rarity,m.Content.Detail.Action})do label.TextScaled=true end
end
function Controller:Init(context)
 self.Context=context;self.Connections={};self.Rows={};self.Generation=0;self.Category='Slaps';self.Page=1;self.Pool=Pool.new(10)
 local gui=player:WaitForChild('PlayerGui');self.Hud=View.Build(gui);self.Main=self.Hud.MainFrame;self.Hud.Enabled=false
 self.Button=View.Button(gui:WaitForChild('PlayerHUD'));self:Select(nil)
end
function Controller:Start()
 local remotes=RS:WaitForChild('Remotes');local social=remotes:WaitForChild('Social')
 self.Remote=social:WaitForChild('Inventory',20);self.Equip=social:WaitForChild('Equip',20)
 if not self.Remote or not self.Equip then warn('[Inventory] Remotes unavailable');return end
 local function connect(signal,fn)table.insert(self.Connections,signal:Connect(fn))end
 local nav=self.Context:GetController('WindowNavigationController');if nav then nav:Watch('InventoryHUD',self.Hud,'Enabled')end
 connect(self.Button.Activated,function()if self.Hud.Enabled then self:Close()else self:Open()end end)
 connect(self.Main.Header.Close.Activated,function()self:Close()end)
 for key in pairs(View.Icons)do connect(self.Main.Tabs[key].Activated,function()self.Category=key;self.Selected=nil;self:Clear();self.Main.Header.Search.Text='';self:Load(1)end)end
 connect(self.Main.Header.Search:GetPropertyChangedSignal('Text'),function()self:Load(1)end)
 connect(self.Main.Content.Footer.Previous.Activated,function()if not self.Loading and self.Page>1 then self:Load(self.Page-1)end end)
 connect(self.Main.Content.Footer.Next.Activated,function()if not self.Loading and self.Data and self.Data.HasNext then self:Load(self.Page+1)end end)
 connect(self.Main.Content.Footer.More.Activated,function()
  if self.Failed then self:Load(1)
  elseif self.Category~='Crates'then self.Category='Crates';self.Selected=nil;self.Main.Header.Search.Text='';self:Load(1)
  else self:Status('Comprá cajas en la tienda de cajas del lobby.')end
 end)
 connect(self.Main.Content.Detail.Action.Activated,function()self:EquipSelected()end)
 connect(self.Main:GetPropertyChangedSignal('AbsoluteSize'),function()self:Layout()end)
 connect(self.Hud:GetPropertyChangedSignal('Enabled'),function()
  if not self.Hud.Enabled then self.Pool:Clear();self.Generation+=1;self.Loading=false
  elseif os.clock()-(self.LastRefresh or 0)>1 then self:Load(self.Page)end
 end)
 connect(remotes.Player.DataUpdated.OnClientEvent,function()
  self.LastRefresh=0
  if self.Hud.Enabled and not self.PendingEquip then self:Load(self.Page)end
 end)
 for _,key in ipairs({'MatchId','ResultsSessionId'})do connect(player:GetAttributeChangedSignal(key),function()if self:Blocked()then self:Close()end end)end
 connect(player.CharacterRemoving,function()self:Close()end)
 local elapsed=0;connect(RunService.RenderStepped,function(dt)
  if not self.Hud.Enabled then return end
  self.Pool:Step(dt);elapsed+=dt
  if elapsed>.2 then elapsed=0;self:RefreshPreviews()end
 end)
 for _,b in ipairs(self.Main:GetDescendants())do if b:IsA('GuiButton')then
  connect(b.MouseEnter,function()if b.Active then local st=b:FindFirstChild('Stroke');if st then Tween:Create(st,TweenInfo.new(.12),{Thickness=2}):Play()end end end)
  connect(b.MouseLeave,function()local st=b:FindFirstChild('Stroke');if st then Tween:Create(st,TweenInfo.new(.12),{Thickness=1}):Play()end end)
 end end
 self:Layout()
end
function Controller:Destroy()
 self:Close();self:Clear();for _,c in ipairs(self.Connections)do c:Disconnect()end;self.Connections={}
end
return Controller
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="4283">
          <Properties>
            <string name="Name">KillRewardController</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Displays receipts only. Never modifies Coins or the authoritative PlayerHUD counter.
local Config=require(game.ReplicatedStorage.Shared.DeathFeedbackConfig).CoinRewardAnimation
local Scope=require(script.Parent.Parent.DeathFeedback.Scope)
local RunService=game:GetService("RunService")
local Controller={Name="KillRewardController"}
function Controller:Init() self._active={};self._seen={} end
function Controller:Cleanup()
 for _,scope in ipairs(self._active or {}) do scope:Destroy() end
 self._active={}
end
function Controller:ResetSession() self:Cleanup();self._seen={} end
function Controller:PlayGoalReceipt(receipt)
 local player=game.Players.LocalPlayer
 if type(receipt)~="table" or receipt.Kind~="CreditedGoal" or receipt.RecipientUserId~=player.UserId
  or type(receipt.EventId)~="string" or type(receipt.SessionId)~="string"
  or type(receipt.RewardCoins)~="number" or receipt.RewardCoins~=receipt.RewardCoins
  or receipt.RewardCoins<=0 or receipt.RewardCoins==math.huge then return end
 self:_playAward({SessionId=receipt.SessionId,EliminationId=receipt.EventId,RewardCoins=receipt.RewardCoins})
end
function Controller:Start()
 local playerRemotes=game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("Player")
 self._goalConnection=playerRemotes:WaitForChild("DataUpdated").OnClientEvent:Connect(function(_,receipt)
  self:PlayGoalReceipt(receipt)
 end)
end
function Controller:PlayReceipt(payload)
 local player=game.Players.LocalPlayer
 if not Config.Enabled or payload.KillerUserId~=player.UserId or payload.RewardCoins<=0
  or payload.Kind~="CreditedKill" or player:GetAttribute("MatchId")~=payload.SessionId then return end
 self:_playAward(payload)
end
function Controller:_playAward(payload)
 local player=game.Players.LocalPlayer
 if not Config.Enabled or player:GetAttribute("MatchId")~=payload.SessionId then return end
 local key=payload.SessionId..":"..payload.EliminationId
 if self._seen[key] then return end
 self._seen[key]=true
 local hud=player.PlayerGui:FindFirstChild("KillRewardHUD")
 if not hud then warn("[KillReward] Physical HUD missing");return end
 local target=hud:FindFirstChild("CoinTarget")
 local template=hud:FindFirstChild("CoinTemplate")
 local effects=hud:FindFirstChild("EffectsContainer")
 if not target or not template or not effects then warn("[KillReward] Incomplete physical HUD");return end
 for i=#self._active,1,-1 do if self._active[i].Dead then table.remove(self._active,i) end end
 while #self._active>=4 do table.remove(self._active,1):Destroy() end
 local scope=Scope.new();table.insert(self._active,scope)
 local rewardTemplate=hud:FindFirstChild("RewardAmountTemplate")
 if rewardTemplate then
  local label=scope:Add(rewardTemplate:Clone())
  label.Name="Reward_"..payload.EliminationId;label.RichText=false
  label.Text="+"..tostring(payload.RewardCoins).." Coins";label.Visible=true;label.Parent=effects
 end
 local sound=hud:FindFirstChild("RewardSound")
 if sound then
  sound=scope:Add(sound:Clone())
  if Config.SoundId~="" then sound.SoundId=Config.SoundId end
  sound.Volume=Config.SoundVolume;sound.Parent=hud
  if sound.SoundId~="" then sound:Play() end
 end
 local flights={}
 local count=math.clamp(math.floor(Config.CoinCount),1,16)
 for i=1,count do
  scope:Delay((i-1)*Config.Stagger,function()
   local coin=scope:Add(template:Clone())
   coin.Visible=true;coin.Name="Coin_"..i;coin.Parent=effects
   local start=template.AbsolutePosition+template.AbsoluteSize*.5-effects.AbsolutePosition
   local coinScale=coin:FindFirstChildOfClass("UIScale")
   if coinScale then coinScale.Scale*=.8+(i%3)*.15 end
   coin.AnchorPoint=Vector2.new(.5,.5)
   table.insert(flights,{Coin=coin,Start=start,At=os.clock(),Side=(i%2==0 and 1 or -1)*(15+i*5)})
  end)
 end
 local connection
 connection=RunService.RenderStepped:Connect(function()
  if scope.Dead then return end
  -- Read actual screen geometry each frame; never overwrite CoinTarget.Position.
  local finish=target.AbsolutePosition+target.AbsoluteSize*.5-effects.AbsolutePosition
  for i=#flights,1,-1 do
   local flight=flights[i]
   local progress=math.clamp((os.clock()-flight.At)/math.max(.001,Config.FlightDuration),0,1)
   local t=progress*progress*(3-2*progress)
   local control=(flight.Start+finish)*.5+Vector2.new(flight.Side,-Config.ArcHeight)
   local point=(1-t)^2*flight.Start+2*(1-t)*t*control+t^2*finish
   flight.Coin.Position=UDim2.fromOffset(point.X,point.Y)
   flight.Coin.Rotation=t*240
   if t>=1 then flight.Coin:Destroy();table.remove(flights,i) end
  end
 end)
 -- Scope also owns the single per-animation render connection.
 scope:Add({Destroy=function()connection:Disconnect()end})
 local arrivalTemplate=target:FindFirstChild("ArrivalTemplate")
 local endTime=(count-1)*Config.Stagger+Config.FlightDuration
 scope:Delay(endTime,function()
  if arrivalTemplate then
   local pulse=scope:Add(arrivalTemplate:Clone());pulse.Visible=true;pulse.Parent=target
   local scale=pulse:FindFirstChildOfClass("UIScale")
   if scale then scope:Tween(scale,.2,{Scale=scale.Scale*Config.ArrivalPulse}) end
   scope:Tween(pulse,.25,{BackgroundTransparency=1})
  end
 end)
 scope:Delay(endTime+.5,function()scope:Destroy()end)
end
return Controller
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="4284">
          <Properties>
            <string name="Name">LeaderboardScrollController</string>
            <string name="Source"><![CDATA[--!strict
-- LeaderboardScrollController
-- Controlador de cliente para hacer que el scroll en las 3 pantallas de TOPS-SCREENS
-- sea interactivo, fluido y responda a la rueda del ratón (MouseWheel), botones táctiles y cercanía.

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")

local LeaderboardScrollController = {}
LeaderboardScrollController.Name = "LeaderboardScrollController"

local localPlayer = Players.LocalPlayer
local MAX_INTERACTION_DISTANCE = 35 -- Distancia máxima en studs para interactuar con la pantalla
local SCROLL_STEP = 180 -- Cantidad de píxeles a scrollear por paso (aprox. 3 filas)

local targetScreens: { { ModelName: string, PartName: string, GuiName: string } } = {
	{ ModelName = "TopWins", PartName = "Screen_TopWins", GuiName = "SurfaceGui_TopWins" },
	{ ModelName = "TopKills", PartName = "Screen_TopKills", GuiName = "SurfaceGui_TopKills" },
	{ ModelName = "TopRachas", PartName = "Screen_TopRachas", GuiName = "SurfaceGui_TopRachas" },
}

function LeaderboardScrollController:Init(_context: any)
	-- Inicialización del controlador de scroll de leaderboards
end

function LeaderboardScrollController:Start(_context: any)
	local function getClosestScreenScroll(): ScrollingFrame?
		local character = localPlayer.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not root then return nil end

		local stands = Workspace:FindFirstChild("stands") and Workspace.stands:FindFirstChild("TOPS-SCREENS")
		if not stands then return nil end

		local closestScroll: ScrollingFrame? = nil
		local closestDist = MAX_INTERACTION_DISTANCE

		for _, cfg in ipairs(targetScreens) do
			local model = stands:FindFirstChild(cfg.ModelName)
			local part = model and model:FindFirstChild(cfg.PartName) :: BasePart?
			if part then
				local dist = (root.Position - part.Position).Magnitude
				if dist < closestDist then
					closestDist = dist
					local gui = part:FindFirstChild(cfg.GuiName)
					local main = gui and gui:FindFirstChild("MainFrame")
					local scroll = main and main:FindFirstChild("ScrollList") :: ScrollingFrame?
					if scroll then
						closestScroll = scroll
					end
				end
			end
		end

		return closestScroll
	end

	-- 1. Soporte para rueda de ratón (MouseWheel) cuando el jugador está frente a la pantalla
	UserInputService.InputChanged:Connect(function(input: InputObject, gameProcessed: boolean)
		if input.UserInputType == Enum.UserInputType.MouseWheel then
			local activeScroll = getClosestScreenScroll()
			if activeScroll then
				local delta = -input.Position.Z * SCROLL_STEP
				local maxCanvas = math.max(0, activeScroll.AbsoluteCanvasSize.Y - activeScroll.AbsoluteWindowSize.Y)
				local targetY = math.clamp(activeScroll.CanvasPosition.Y + delta, 0, maxCanvas)
				activeScroll.CanvasPosition = Vector2.new(0, targetY)
			end
		end
	end)

	-- 2. Conectar botones de navegación táctil/click (si existen en el GUI)
	task.spawn(function()
		local stands = Workspace:WaitForChild("stands", 15)
		local topScreens = stands and stands:WaitForChild("TOPS-SCREENS", 15)
		if not topScreens then return end

		for _, cfg in ipairs(targetScreens) do
			local model = topScreens:WaitForChild(cfg.ModelName, 10)
			local part = model and model:WaitForChild(cfg.PartName, 10)
			local gui = part and part:WaitForChild(cfg.GuiName, 10)
			local main = gui and gui:WaitForChild("MainFrame", 10)
			local scroll = main and main:WaitForChild("ScrollList", 10) :: ScrollingFrame?

			if scroll and main then
				-- Asegurar propiedades nativas de interactividad en el SurfaceGui y ScrollingFrame
				if gui:IsA("SurfaceGui") then
					gui.AlwaysOnTop = false
					gui.MaxDistance = 50
					gui.Active = true
				end

				scroll.Active = true
				scroll.Selectable = true
				scroll.ScrollingEnabled = true
				scroll.ScrollBarThickness = 10

				-- Conectar botón de subir
				local btnUp = main:FindFirstChild("ScrollUpBtn", true) :: TextButton?
				if btnUp then
					btnUp.Activated:Connect(function()
						local targetY = math.max(0, scroll.CanvasPosition.Y - (SCROLL_STEP * 2))
						scroll.CanvasPosition = Vector2.new(0, targetY)
					end)
				end

				-- Conectar botón de bajar
				local btnDown = main:FindFirstChild("ScrollDownBtn", true) :: TextButton?
				if btnDown then
					btnDown.Activated:Connect(function()
						local maxCanvas = math.max(0, scroll.AbsoluteCanvasSize.Y - scroll.AbsoluteWindowSize.Y)
						local targetY = math.min(maxCanvas, scroll.CanvasPosition.Y + (SCROLL_STEP * 2))
						scroll.CanvasPosition = Vector2.new(0, targetY)
					end)
				end
			end
		end
	end)

	print("[LeaderboardScrollController] Controlador de scroll físico en cliente activo.")
end

return LeaderboardScrollController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="4285">
          <Properties>
            <string name="Name">MatchController</string>
            <string name="Source"><![CDATA[--!strict
-- MatchController
-- Controlador de la interfaz de partida 1v1.
-- NO construye la UI mediante codigo; localiza y controla las instancias reales preexistentes en PlayerGui.MatchHUD.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local Constants = require(ReplicatedStorage.Shared.Constants)
local Config = require(ReplicatedStorage.Shared.Config)

local localPlayer = Players.LocalPlayer

type Palette = { Main: Color3, Shadow: Color3, Deep: Color3, Accent: Color3 }

type Pose = {
	Position: UDim2,
	Rotation: number,
	Scale: number,
	Transparency: number,
	Depth: number,
	ShineY: number,
}

type FxStack = {
	Root: Frame,
	Scale: UIScale,
	Layers: { TextLabel },
	Stroke: UIStroke?,
}

type BurstFx = {
	Container: Frame,
	Rings: { Frame },
	RingStrokes: { UIStroke },
	Sparks: { Frame },
	SparkAngles: { number },
	SparkReach: { number },
}

type CountdownFx = {
	Container: Frame,
	Extrusion: FxStack,
	Ghosts: { FxStack },
	Burst: BurstFx,
}

type CountdownRig = {
	Frame: Frame,
	Label: TextLabel,
	UIScale: UIScale,
	Stroke: UIStroke?,
	Gradient: UIGradient?,
	Fx: CountdownFx,
}

local MatchController = {}
MatchController.Name = "MatchController"

-- Referencias a instancias de PlayerGui.MatchHUD
MatchController._hud = nil :: ScreenGui?

-- StartCountdownFrame
MatchController._startCountdownFrame = nil :: Frame?
MatchController._startCountdownTitle = nil :: TextLabel?
MatchController._startCountdownLabel = nil :: TextLabel?
MatchController._startCountdownScale = nil :: UIScale?
MatchController._countdownAnimToken = 0
MatchController._countdownConn = nil :: RBXScriptConnection?
MatchController._countdownFx = nil :: CountdownFx?
MatchController._currentMatchId = nil :: string?
MatchController._lastStateVersion = 0

-- CountdownFrame
MatchController._countdownFrame = nil :: Frame?
MatchController._countdownTitle = nil :: TextLabel?
MatchController._countdownTimer = nil :: TextLabel?

-- MapSelectionFrame
MatchController._mapSelectionFrame = nil :: Frame?
MatchController._mapHeader = nil :: TextLabel?
MatchController._mapTimer = nil :: TextLabel?
MatchController._mapsContainer = nil :: Frame?
MatchController._mapButtonTemplate = nil :: TextButton?
MatchController._randomButton = nil :: TextButton?
MatchController._clonedButtons = {} :: { [string]: TextButton }

-- MatchTimerFrame
MatchController._matchTimerFrame = nil :: Frame?
MatchController._matchTimer = nil :: TextLabel?
MatchController._roundIndex = 0
MatchController._roundDeadline = nil :: number?
MatchController._clockSessionId = nil :: string?

-- ResultFrame
MatchController._resultFrame = nil :: Frame?
MatchController._resultTitle = nil :: TextLabel?
MatchController._resultSubtitle = nil :: TextLabel?

-- RedTeamFrame (Scoreboard)
MatchController._redTeamFrame = nil :: Frame?
MatchController._redScoreLabel = nil :: TextLabel?
MatchController._redPlayersContainer = nil :: Frame?

-- BlueTeamFrame (Scoreboard)
MatchController._blueTeamFrame = nil :: Frame?
MatchController._blueScoreLabel = nil :: TextLabel?
MatchController._bluePlayersContainer = nil :: Frame?

-- PlayerSlotTemplate
MatchController._playerSlotTemplate = nil :: Frame?
MatchController._clonedSlots = {} :: { Frame }

-- LastPointFrame
MatchController._lastPointFrame = nil :: Frame?
MatchController._lastPointTitle = nil :: TextLabel?
MatchController._lastPointSubtitle = nil :: TextLabel?
MatchController._lastPointToken = 0

-- Estado local
MatchController._currentState = Constants.RoundState.Waiting
MatchController._selectedMapVote = nil :: string?
MatchController._currentRole = nil :: string? -- "Red" | "Blue" | nil
MatchController._currentSelectedMap = nil :: string?
MatchController._context = nil :: any

local function formatTime(seconds: number): string
	local m = math.floor(seconds / 60)
	local s = seconds % 60
	return string.format("%d:%02d", m, s)
end

function MatchController:Init(context)
	self._context = context
	self._currentMatchId = nil
	self._lastStateVersion = 0
	self:_bindHUD()
end

function MatchController:GetCurrentMatchId(): string?
	return self._currentMatchId
end

function MatchController:GetStartCountdownFrame(): Frame?
	return self._startCountdownFrame
end

function MatchController:GetCurrentStateVersion(): number
 return self._lastStateVersion
end

function MatchController:GetCurrentState(): string
	return self._currentState
end

function MatchController:IsParticipant(): boolean
	return self._currentRole ~= nil
end

function MatchController:GetCurrentSelectedMap(): string?
	return self._currentSelectedMap
end

function MatchController:_payloadContainsLocalPlayer(payload: any): boolean
	if type(payload) ~= "table" or type(payload.ParticipantUserIds) ~= "table" then return false end
	return table.find(payload.ParticipantUserIds, localPlayer.UserId) ~= nil
end

function MatchController:_acceptSessionPayload(payload: any, allowBind: boolean, advanceVersion: boolean?): boolean
	if type(payload) ~= "table" then return false end
	local sessionId = payload.SessionId or payload.MatchId
	if type(sessionId) ~= "string" or sessionId == "" then return false end
	if self._retiredSessionIds and self._retiredSessionIds[sessionId] then return false end
	local version = payload.StateVersion
	if version ~= nil and type(version) ~= "number" then return false end

	if self._currentMatchId == nil then
		if not allowBind
			or localPlayer:GetAttribute("MatchId") ~= sessionId
			or not self:_payloadContainsLocalPlayer(payload) then
			return false
		end
		self._currentMatchId = sessionId
		self._lastStateVersion = 0
		local teams = payload.ParticipantTeams
		if type(teams) == "table" then
			self._currentRole = teams[localPlayer.UserId]
		end
	elseif self._currentMatchId ~= sessionId then
		return false
	end

	if version ~= nil and version < self._lastStateVersion then
		return false
	end
	if advanceVersion and version ~= nil then
		self._lastStateVersion = version
	end
	return true
end

function MatchController:_clearSessionIdentity(expectedSessionId: string)
	if self._currentMatchId ~= expectedSessionId then return end
	self._retiredSessionIds=self._retiredSessionIds or {}
	self._retiredSessionIds[expectedSessionId]=true
	self._roundIndex=0;self._roundDeadline=nil;self._clockSessionId=nil
	self._currentMatchId = nil
	self._lastStateVersion = 0
end

function MatchController:Start(context)
	self._context = context
	self:_setupButtonEvents()
	self:_connectRemotes()
 game:GetService("RunService").Heartbeat:Connect(function()
  if self._roundDeadline and self._clockSessionId==self._currentMatchId and self._currentState=="Playing" and self._matchTimer then
   self._matchTimer.Text=formatTime(math.max(0,math.ceil(self._roundDeadline-workspace:GetServerTimeNow())))
  end
 end)
	print("[MatchController] Controlador iniciado y enlazado a PlayerGui.MatchHUD")
end

function MatchController:_bindHUD()
	local playerGui = localPlayer:WaitForChild("PlayerGui")
	local hud = playerGui:WaitForChild("MatchHUD", 15) :: ScreenGui?
	if not hud then
		warn("[MatchController] No se encontro MatchHUD en PlayerGui")
		return
	end
	self._hud = hud

	-- 1. CountdownFrame
	local cdFrame = hud:WaitForChild("CountdownFrame", 10) :: Frame?
	if cdFrame then
		self._countdownFrame = cdFrame
		self._countdownTitle = cdFrame:WaitForChild("Title", 10) :: TextLabel?
		self._countdownTimer = cdFrame:WaitForChild("Timer", 10) :: TextLabel?
		cdFrame.Visible = false
	end

	-- 1.5 StartCountdownFrame
	local scFrame = hud:WaitForChild("StartCountdownFrame", 10) :: Frame?
	if scFrame then
		self._startCountdownFrame = scFrame
		self._startCountdownTitle = scFrame:WaitForChild("Title", 10) :: TextLabel?
		self._startCountdownLabel = scFrame:WaitForChild("CountdownLabel", 10) :: TextLabel?
		self._startCountdownScale = (self._startCountdownLabel and self._startCountdownLabel:FindFirstChildOfClass("UIScale")) :: UIScale?
		scFrame.Visible = false
	end

	-- 2. MapSelectionFrame
	local mapFrame = hud:WaitForChild("MapSelectionFrame", 10) :: Frame?
	if mapFrame then
		self._mapSelectionFrame = mapFrame
		self._mapHeader = mapFrame:WaitForChild("Header", 10) :: TextLabel?
		self._mapTimer = mapFrame:WaitForChild("Timer", 10) :: TextLabel?
		self._randomButton = mapFrame:WaitForChild("RandomButton", 10) :: TextButton?

		local container = mapFrame:WaitForChild("MapsContainer", 10) :: Frame?
		if container then
			self._mapsContainer = container
			self._mapButtonTemplate = container:WaitForChild("MapButtonTemplate", 10) :: TextButton?
			if self._mapButtonTemplate then
				self._mapButtonTemplate.Visible = false
			end
		end
		mapFrame.Visible = false
	end

	-- 3. MatchTimerFrame
	local timerFrame = hud:WaitForChild("MatchTimerFrame", 10) :: Frame?
	if timerFrame then
		self._matchTimerFrame = timerFrame
		self._matchTimer = timerFrame:WaitForChild("Timer", 10) :: TextLabel?
		timerFrame.Visible = false
	end

	-- 4. ResultFrame
	local resFrame = hud:WaitForChild("ResultFrame", 10) :: Frame?
	if resFrame then
		self._resultFrame = resFrame
		self._resultTitle = resFrame:WaitForChild("ResultTitle", 10) :: TextLabel?
		self._resultSubtitle = resFrame:WaitForChild("ResultSubtitle", 10) :: TextLabel?
		resFrame.Visible = false
	end

	-- 5. RedTeamFrame
	local redFrame = hud:WaitForChild("RedTeamFrame", 10) :: Frame?
	if redFrame then
		self._redTeamFrame = redFrame
		self._redScoreLabel = redFrame:WaitForChild("ScoreLabel", 10) :: TextLabel?
		self._redPlayersContainer = redFrame:WaitForChild("PlayersContainer", 10) :: Frame?
		redFrame.Visible = false
	end

	-- 6. BlueTeamFrame
	local blueFrame = hud:WaitForChild("BlueTeamFrame", 10) :: Frame?
	if blueFrame then
		self._blueTeamFrame = blueFrame
		self._blueScoreLabel = blueFrame:WaitForChild("ScoreLabel", 10) :: TextLabel?
		self._bluePlayersContainer = blueFrame:WaitForChild("PlayersContainer", 10) :: Frame?
		blueFrame.Visible = false
	end

	-- 7. PlayerSlotTemplate
	local slotTemplate = hud:WaitForChild("PlayerSlotTemplate", 10) :: Frame?
	if slotTemplate then
		self._playerSlotTemplate = slotTemplate
		slotTemplate.Visible = false
	end

	-- 8. LastPointFrame
	local lpFrame = hud:WaitForChild("LastPointFrame", 10) :: Frame?
	if lpFrame then
		self._lastPointFrame = lpFrame
		self._lastPointTitle = lpFrame:WaitForChild("Title", 10) :: TextLabel?
		self._lastPointSubtitle = lpFrame:WaitForChild("Subtitle", 10) :: TextLabel?
		lpFrame.Visible = false
	end
end

function MatchController:_setupButtonEvents()
	if self._randomButton then
		self._randomButton.MouseButton1Click:Connect(function()
			self:_submitVote(Constants.SpecialMapVote.Random, self._randomButton)
		end)
	end
end

function MatchController:_connectRemotes()
	local remotesFolder = ReplicatedStorage:WaitForChild("Remotes", 10)
	if not remotesFolder then return end

	local matchFolder = remotesFolder:WaitForChild("Match", 10)
	if not matchFolder then return end

	local stateChanged = matchFolder:WaitForChild("StateChanged", 10) :: RemoteEvent?
	local countdown = matchFolder:WaitForChild("Countdown", 10) :: RemoteEvent?
	local mapSelection = matchFolder:WaitForChild("MapSelection", 10) :: RemoteEvent?
	local matchResult = matchFolder:WaitForChild("MatchResult", 10) :: RemoteEvent?
	local scoreUpdated = matchFolder:WaitForChild("ScoreUpdated", 10) :: RemoteEvent?
	local lastPoint = matchFolder:WaitForChild("LastPoint", 10) :: RemoteEvent?

	if stateChanged then
		stateChanged.OnClientEvent:Connect(function(newState: string, extraData: any)
			self:_handleStateChanged(newState, extraData)
		end)
	end

	if countdown then
		countdown.OnClientEvent:Connect(function(remaining: number, label: string, extraData: any?)
			self:_handleCountdown(remaining, label, extraData)
		end)
	end

	if mapSelection then
		mapSelection.OnClientEvent:Connect(function(data: any)
			if not self:_acceptSessionPayload(data, false, false) then return end
			if type(data) == "table" and data.Maps then
				self:_populateMapSelection(data.Maps)
			elseif type(data) == "table" and data.Voted then
				self:_highlightSelectedVote(data.Voted)
			end
		end)
	end

	if matchResult then
		matchResult.OnClientEvent:Connect(function(result: string, winnerName: string?, metadata: any)
			if not self:_acceptSessionPayload(metadata, false, false) then return end
			self:_handleMatchResult(result, winnerName)
		end)
	end

	if scoreUpdated then
		scoreUpdated.OnClientEvent:Connect(function(data: any)
			if not self:_acceptSessionPayload(data, false, false) then return end
			self:_handleScoreUpdated(data)
		end)
	end

	if lastPoint then
		lastPoint.OnClientEvent:Connect(function(data: any)
			if not self:_acceptSessionPayload(data, false, false) then return end
			self:_handleLastPoint(data)
		end)
	end

	local pointFeedback = matchFolder:WaitForChild("PointFeedback", 5) :: RemoteEvent?
	if pointFeedback then
		pointFeedback.OnClientEvent:Connect(function(data: any)
			if not self:_acceptSessionPayload(data, false, false) then return end
			self:_handlePointFeedback(data)
		end)
	end
end

function MatchController:_handlePointFeedback(data: any)
	-- Hook arquitectónico preparado para Camera Shake y efectos de pantalla
	-- Autoridad exclusiva del servidor: el cliente reacciona pero no decide
	if type(data) ~= "table" then return end
	if data.IsFinalPoint == true then
		local musicController = self._context and self._context:GetController("MusicController")
		if musicController and typeof(musicController.Suspend) == "function" then
			local endCinematicConfig = require(ReplicatedStorage.Shared.EndCinematicConfig)
			local fadeOut = (endCinematicConfig.Music and endCinematicConfig.Music.FadeOutDuration) or 0.4
			musicController:Suspend("EndCinematic", fadeOut)
		end
	end
	print(string.format("[MatchController] PointFeedback recibido del servidor: Equipo=%s, Jugador=%s, Efecto=%s, Final=%s",
		tostring(data.ScoringTeam),
		tostring(data.ScoringPlayerName),
		tostring(data.EffectId),
		tostring(data.IsFinalPoint)))
end

function MatchController:_handleStateChanged(newState: string, extraData: any)
	if not self:_acceptSessionPayload(extraData, true, true) then return end
	if extraData and extraData.PrematchCancelled == true then
		self:_stopStartCountdownAnimation()
		for _,frame in pairs({self._countdownFrame,self._startCountdownFrame,self._mapSelectionFrame,self._matchTimerFrame,self._resultFrame}) do frame.Visible=false end
		self._currentRole=nil;self._selectedMapVote=nil;self._currentSelectedMap=nil
		self:_clearClonedButtons();self:_clearPlayerSlots()
		self:_clearSessionIdentity(self._currentMatchId)
		self._currentState=Constants.RoundState.Waiting
		local queue=self._context and self._context:GetController("MatchmakingController")
		local music=self._context and self._context:GetController("MusicController")
		if music then
			if queue and queue:IsInQueue() then music:PlayMatchmaking() else music:PlayLobby() end
		end
		return
	end
	local eventSessionId = self._currentMatchId :: string
	local prevState = self._currentState
	self._currentState = newState
	print(string.format("[MatchController] Estado recibido: %s", newState))

	local isPointRestart = (newState == Constants.RoundState.PointRestartCountdown)
	if newState~=Constants.RoundState.Playing then self._roundDeadline=nil end

	-- Ocultar frames condicionalmente (durante PointRestartCountdown el HUD y timer permanecen visibles)
	if not isPointRestart then
		if self._startCountdownFrame then self._startCountdownFrame.Visible = false end
		if self._countdownFrame and newState ~= Constants.RoundState.MatchReady and newState ~= Constants.RoundState.MatchCountdown then
			self._countdownFrame.Visible = false
		end
		if self._mapSelectionFrame then self._mapSelectionFrame.Visible = false end
		if self._matchTimerFrame and newState ~= Constants.RoundState.Playing then self._matchTimerFrame.Visible = false end
		if self._resultFrame then self._resultFrame.Visible = false end
	end

	if newState == Constants.RoundState.MatchReady then
		if extraData and extraData.MatchId then
			self._currentMatchId = extraData.MatchId
		end
		if extraData and extraData.Red and extraData.Blue then
			if extraData.Red == localPlayer.Name then
				self._currentRole = "Red"
			elseif extraData.Blue == localPlayer.Name then
				self._currentRole = "Blue"
			else
				self._currentRole = nil
			end
		end
		if self._countdownFrame then
			if self._countdownTitle then
				self._countdownTitle.Text = "LA PARTIDA COMIENZA EN"
			end
			if self._countdownTimer then
				local defaultDuration = Config.Round and Config.Round.MatchCountdownTime or 5
				self._countdownTimer.Text = tostring(defaultDuration)
			end
			self._countdownFrame.Visible = true
		end

	elseif newState == Constants.RoundState.MatchCountdown then
		if self._countdownFrame then
			if self._countdownTitle then
				self._countdownTitle.Text = "LA PARTIDA COMIENZA EN"
			end
			if extraData and extraData.Duration and self._countdownTimer then
				self._countdownTimer.Text = tostring(extraData.Duration)
			end
			self._countdownFrame.Visible = true
		end

	elseif newState == Constants.RoundState.MapSelection then
		if self._mapSelectionFrame then
			self._selectedMapVote = nil
			self:_resetButtonHighlights()
			self._mapSelectionFrame.Visible = true
		end

	elseif newState == Constants.RoundState.MapLoading then
		self._currentSelectedMap = extraData and extraData.SelectedMap
		if self._countdownFrame and self._countdownTitle and self._countdownTimer then
			self._countdownTitle.Text = "CARGANDO MAPA"
			self._countdownTimer.Text = extraData and extraData.SelectedMap or "..."
			self._countdownFrame.Visible = true
		end
		if self:IsParticipant() then
			local musicController = self._context and self._context:GetController("MusicController")
			if musicController then
				musicController:PlayArena(self._currentSelectedMap or "Default")
			end
		end

	elseif newState == Constants.RoundState.StartCountdown then
		if extraData and extraData.MatchId then
			self._currentMatchId = extraData.MatchId
		end
		if extraData and extraData.SelectedMap and not self._currentSelectedMap then
			self._currentSelectedMap = extraData.SelectedMap
		end
		if self:IsParticipant() then
			local musicController = self._context and self._context:GetController("MusicController")
			if musicController and musicController:GetCurrentState() ~= "Arena" then
				musicController:PlayArena(self._currentSelectedMap or "Default")
			end
		end
		if self._startCountdownFrame then
			if self._startCountdownTitle then
				self._startCountdownTitle.Text = "LA PARTIDA COMIENZA"
			end
			if self._startCountdownLabel then
				local duration = (extraData and extraData.Duration) or 5
				self._startCountdownLabel.Text = tostring(duration)
			end
			self._startCountdownFrame.Visible = true
		end

	elseif newState == Constants.RoundState.PointRestartCountdown then
		if extraData and extraData.MatchId then
			self._currentMatchId = extraData.MatchId
		end
		if self._startCountdownFrame then
			if self._startCountdownTitle then
				self._startCountdownTitle.Text = "SIGUIENTE PUNTO EN"
			end
			if self._startCountdownLabel then
				local duration = (extraData and extraData.Duration) or 3
				self._startCountdownLabel.Text = tostring(duration)
			end
			self._startCountdownFrame.Visible = true
		end
		if self._matchTimerFrame then self._matchTimerFrame.Visible = true end
		if self._redTeamFrame then self._redTeamFrame.Visible = true end
		if self._blueTeamFrame then self._blueTeamFrame.Visible = true end

	elseif newState == Constants.RoundState.Playing then
		if self._matchTimer then self._matchTimer.Text=formatTime(Config.Round.RoundDuration) end
		if extraData and extraData.MatchId then
			self._currentMatchId = extraData.MatchId
		end
		if self._startCountdownFrame then
			self._startCountdownFrame.Visible = false
		end
		if self._matchTimerFrame then
			self._matchTimerFrame.Visible = true
		end
		if self._redTeamFrame then
			self._redTeamFrame.Visible = true
		end
		if self._blueTeamFrame then
			self._blueTeamFrame.Visible = true
		end

		-- Solo inicializar score a 0 al inicio formal de la partida (no tras un punto anotado)
		if prevState == Constants.RoundState.StartCountdown or prevState == Constants.RoundState.MapLoading then
			if self._redScoreLabel then
				self._redScoreLabel.Text = "0"
			end
			if self._blueScoreLabel then
				self._blueScoreLabel.Text = "0"
			end
		end

		self:_populatePlayers(
			extraData and extraData.RedTeam,
			extraData and extraData.BlueTeam,
			extraData and extraData.Red,
			extraData and extraData.Blue
		)

	elseif newState == Constants.RoundState.Ending then
		if self._resultFrame then
			self._resultFrame.Visible = not (extraData and extraData.Cinematic == true)
		end
		if self._lastPointFrame then
			self._lastPointFrame.Visible = false
		end
		local musicController = self._context and self._context:GetController("MusicController")
		if musicController and typeof(musicController.Suspend) == "function" then
			local endCinematicConfig = require(ReplicatedStorage.Shared.EndCinematicConfig)
			local fadeOut = (endCinematicConfig.Music and endCinematicConfig.Music.FadeOutDuration) or 0.4
			musicController:Suspend("EndCinematic", fadeOut)
		end

	elseif newState == Constants.RoundState.ReturningToLobby or newState == Constants.RoundState.Waiting then
		local wasParticipant = self:IsParticipant()
		self._currentRole = nil
		self._selectedMapVote = nil
		self._currentSelectedMap = nil
		if self._countdownFrame then self._countdownFrame.Visible = false end
		if self._startCountdownFrame then self._startCountdownFrame.Visible = false end
		if self._redTeamFrame then self._redTeamFrame.Visible = false end
		if self._blueTeamFrame then self._blueTeamFrame.Visible = false end
		if self._lastPointFrame then self._lastPointFrame.Visible = false end
		self:_clearClonedButtons()
		self:_clearPlayerSlots()

		local musicController = self._context and self._context:GetController("MusicController")
		local endCinematic = self._context and self._context:GetController("EndCinematicController")
		if (not endCinematic or not endCinematic:IsPlaying()) and musicController and typeof(musicController.Resume) == "function" then
			musicController:Resume("EndCinematic")
		end

		if wasParticipant or newState == Constants.RoundState.ReturningToLobby then
			if musicController then
				musicController:PlayLobby()
			end
		end
		self:_clearSessionIdentity(eventSessionId)
		self._currentState = Constants.RoundState.Waiting
	end
end

function MatchController:_handleScoreUpdated(data: any)
	if type(data) ~= "table" then return end
	if self._redScoreLabel and data.Red ~= nil then
		self._redScoreLabel.Text = tostring(data.Red)
	end
	if self._blueScoreLabel and data.Blue ~= nil then
		self._blueScoreLabel.Text = tostring(data.Blue)
	end
	print(string.format("[MatchController] Score actualizado en HUD: Red=%s, Blue=%s",
		tostring(data.Red), tostring(data.Blue)))
end

function MatchController:_handleLastPoint(data: any)
	if not self._lastPointFrame or not self._lastPointTitle then return end
	local team = data and data.Team
	local message = data and data.Message or "ÚLTIMO PUNTO PARA GANAR LA PARTIDA"

	self._lastPointTitle.Text = message

	if self._lastPointSubtitle then
		if team == "Red" then
			self._lastPointSubtitle.Text = "¡EQUIPO ROJO A 1 PUNTO DE LA VICTORIA!"
			self._lastPointSubtitle.TextColor3 = Color3.fromRGB(255, 120, 120)
		elseif team == "Blue" then
			self._lastPointSubtitle.Text = "¡EQUIPO AZUL A 1 PUNTO DE LA VICTORIA!"
			self._lastPointSubtitle.TextColor3 = Color3.fromRGB(120, 180, 255)
		else
			self._lastPointSubtitle.Text = "¡A 1 punto de la victoria!"
			self._lastPointSubtitle.TextColor3 = Color3.fromRGB(255, 255, 255)
		end
	end

	self._lastPointFrame.Visible = true

	local token = os.clock()
	self._lastPointToken = token
	task.delay(4, function()
		if self._lastPointToken == token and self._lastPointFrame then
			self._lastPointFrame.Visible = false
		end
	end)
end

function MatchController:_clearPlayerSlots()
	for _, slot in ipairs(self._clonedSlots) do
		slot:Destroy()
	end
	self._clonedSlots = {}
end

function MatchController:_populatePlayers(redData: any, blueData: any, redFallback: string?, blueFallback: string?)
	self:_clearPlayerSlots()
	if not self._playerSlotTemplate then return end

	local createSlot = function(playerInfo: any, fallbackName: string?, container: Frame?, teamColor: Color3)
		if not container then return end
		local slot = self._playerSlotTemplate:Clone()
		local name = if type(playerInfo) == "table" and playerInfo.Name then playerInfo.Name else fallbackName or "Jugador"
		local displayName = if type(playerInfo) == "table" and playerInfo.DisplayName then playerInfo.DisplayName else name
		local userId = if type(playerInfo) == "table" and playerInfo.UserId then playerInfo.UserId else 0

		slot.Name = "Slot_" .. name
		local nameLabel = slot:FindFirstChild("DisplayName") :: TextLabel?
		if nameLabel then
			nameLabel.Text = displayName
		end

		local userLabel = slot:FindFirstChild("Username") :: TextLabel?
		if userLabel then
			userLabel.Text = "@" .. name
		end

		local avatarImg = slot:FindFirstChild("Avatar") :: ImageLabel?
		if avatarImg and userId > 0 then
			avatarImg.Image = string.format("rbxthumb://type=AvatarHeadShot&id=%d&w=100&h=100", userId)
		end

		local stroke = slot:FindFirstChildOfClass("UIStroke")
		if stroke then
			stroke.Color = teamColor
		end

		slot.Visible = true
		slot.Parent = container
		table.insert(self._clonedSlots, slot)
	end

	-- Red team
	if type(redData) == "table" and #redData > 0 then
		for _, pInfo in ipairs(redData) do
			createSlot(pInfo, redFallback, self._redPlayersContainer, Color3.fromRGB(150, 40, 40))
		end
	else
		createSlot(nil, redFallback, self._redPlayersContainer, Color3.fromRGB(150, 40, 40))
	end

	-- Blue team
	if type(blueData) == "table" and #blueData > 0 then
		for _, pInfo in ipairs(blueData) do
			createSlot(pInfo, blueFallback, self._bluePlayersContainer, Color3.fromRGB(40, 90, 160))
		end
	else
		createSlot(nil, blueFallback, self._bluePlayersContainer, Color3.fromRGB(40, 90, 160))
	end
end

function MatchController:_handleCountdown(remaining: number, label: string, extraData: any?)
	if not self:_acceptSessionPayload(extraData, false, false) then return end

	if label=="PLAYING" and type(extraData)=="table" and type(extraData.RoundIndex)=="number" then
  if self._clockSessionId~=self._currentMatchId then self._roundIndex=0 end
  if extraData.RoundIndex<self._roundIndex then return end
  self._roundIndex=extraData.RoundIndex;self._clockSessionId=self._currentMatchId
  self._roundDeadline=if extraData.Resolved then nil else extraData.Deadline
  if self._matchTimer then self._matchTimer.Text=formatTime(remaining) end
  return
 end

	if extraData and extraData.Cancelled then
		if self._countdownFrame then
			self._countdownFrame.Visible = false
		end
		return
	end

	if self._currentState == Constants.RoundState.MatchCountdown then
		if self._countdownTimer then
			self._countdownTimer.Text = tostring(remaining)
		end
	elseif self._currentState == Constants.RoundState.MapSelection then
		if self._mapTimer then
			self._mapTimer.Text = tostring(remaining)
		end
	elseif self._currentState == Constants.RoundState.StartCountdown
		or self._currentState == Constants.RoundState.PointRestartCountdown
		or label == "START_COUNTDOWN" then
		self:_updateStartCountdown(remaining, extraData)
	elseif self._currentState == Constants.RoundState.Playing then
		if self._matchTimer then
			self._matchTimer.Text = formatTime(remaining)
		end
	end
end

local COUNTDOWN = {
	-- Cadencia (suma 0.92 s, deja 0.08 s de margen de red dentro del segundo)
	EnterTime = 0.24,
	SettleTime = 0.18,
	HoldTime = 0.35,
	ExitTime = 0.15,

	-- Trayectoria cubica en "C" (coordenadas Scale de pantalla)
	StartPoint = Vector2.new(0.88, 0.05),
	ControlA = Vector2.new(0.14, -0.05),
	ControlB = Vector2.new(0.06, 0.66),
	EndPoint = Vector2.new(0.5, 0.5),
	ExitOffset = Vector2.new(-0.20, 0.22),

	-- Vuelo
	EnterEase = 1.6,          -- >1: acelera hacia el impacto
	FadeInPortion = 0.30,
	FlightStartScale = 0.40,
	FlightTilt = 16,          -- grados de inclinacion segun la velocidad
	StretchDepth = 0.9,       -- extrusion extra durante el vuelo (estiramiento)

	-- Impacto (resorte subamortiguado)
	ImpactScale = 0.25,
	ImpactSink = 0.016,
	SquashDepth = 0.75,       -- cuanto se comprime la extrusion al impactar
	SpringFreq = 24,
	SpringDamping = 0.42,
	ShineTime = 0.35,
	ShineStart = -0.6,

	-- Salida
	ExitRotation = -24,
	ExitScale = 0.5,

	-- Estela
	GhostCount = 3,
	GhostLag = 0.07,
	GhostTransparency = 0.55,

	-- Extrusion 3D
	DepthLayers = 8,
	DepthStep = 0.011,        -- fraccion de la altura del label por capa

	-- Climax
	StartTotal = 0.90,
	StartPunchTime = 0.14,
	StartExitTime = 0.16,
	StartPeakScale = 1.55,
	StartRestScale = 1.18,
	StartPushScale = 1.30,
	SparkCount = 14,
}

local NUMBER_TOTAL = COUNTDOWN.EnterTime + COUNTDOWN.SettleTime + COUNTDOWN.HoldTime + COUNTDOWN.ExitTime

local START_PALETTE: Palette = {
	Main = Color3.fromRGB(60, 235, 130),
	Shadow = Color3.fromRGB(10, 95, 50),
	Deep = Color3.fromRGB(4, 42, 22),
	Accent = Color3.fromRGB(200, 255, 220),
}

-- ===== Utilidades matematicas =====

local function lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end

local function clamp01(x: number): number
	return math.clamp(x, 0, 1)
end

local function easeOutCubic(x: number): number
	return 1 - (1 - x) ^ 3
end

-- Bezier cubica y su derivada (tangente)
local function bezier3(p0: Vector2, p1: Vector2, p2: Vector2, p3: Vector2, t: number): Vector2
	local u = 1 - t
	return p0 * (u * u * u) + p1 * (3 * u * u * t) + p2 * (3 * u * t * t) + p3 * (t * t * t)
end

local function bezier3Tangent(p0: Vector2, p1: Vector2, p2: Vector2, p3: Vector2, t: number): Vector2
	local u = 1 - t
	return (p1 - p0) * (3 * u * u) + (p2 - p1) * (6 * u * t) + (p3 - p2) * (3 * t * t)
end

-- Resorte subamortiguado: vale 1 en t = 0 y decae a 0 oscilando (pasa por valores negativos = rebote)
local function springKick(t: number, freq: number, damping: number): number
	if t <= 0 then
		return 1
	end
	local wd = freq * math.sqrt(1 - damping * damping)
	local decay = math.exp(-damping * freq * t)
	return decay * (math.cos(wd * t) + (damping * freq / wd) * math.sin(wd * t))
end

local function flightPoint(s: number): Vector2
	local c = COUNTDOWN
	return bezier3(c.StartPoint, c.ControlA, c.ControlB, c.EndPoint, s)
end

local function flightTilt(s: number): number
	local c = COUNTDOWN
	local tan = bezier3Tangent(c.StartPoint, c.ControlA, c.ControlB, c.EndPoint, s)
	return -tan.Unit.X * c.FlightTilt
end

local END_TILT = flightTilt(1)

-- ===== Poses (funciones puras del tiempo) =====

local function numberPose(t: number): Pose
	local c = COUNTDOWN
	local exitStart = c.EnterTime + c.SettleTime + c.HoldTime

	if t < c.EnterTime then
		local u = t / c.EnterTime
		local s = u ^ c.EnterEase
		local p = flightPoint(s)
		return {
			Position = UDim2.fromScale(p.X, p.Y),
			Rotation = flightTilt(s),
			Scale = lerp(c.FlightStartScale, 1 + c.ImpactScale, 1 - (1 - u) ^ 2),
			Transparency = 1 - clamp01(u / c.FadeInPortion),
			Depth = 1 + c.StretchDepth * u ^ 0.6,
			ShineY = 0,
		}
	end

	local ti = t - c.EnterTime
	local k = springKick(ti, c.SpringFreq, c.SpringDamping)
	local center = c.EndPoint
	local y = center.Y + c.ImpactSink * k
	local rot = END_TILT * k
	local scale = 1 + c.ImpactScale * k
	local depth = 1 - c.SquashDepth * k
	local shine = lerp(c.ShineStart, 0, easeOutCubic(clamp01(ti / c.ShineTime)))

	if t < exitStart then
		return {
			Position = UDim2.fromScale(center.X, y),
			Rotation = rot,
			Scale = scale,
			Transparency = 0,
			Depth = depth,
			ShineY = shine,
		}
	end

	local v = clamp01((t - exitStart) / c.ExitTime)
	local e = v * v
	return {
		Position = UDim2.fromScale(center.X + c.ExitOffset.X * e, y + c.ExitOffset.Y * e),
		Rotation = lerp(rot, c.ExitRotation, e),
		Scale = lerp(scale, c.ExitScale, e),
		Transparency = e,
		Depth = lerp(depth, 1.5, e),
		ShineY = 0,
	}
end

local function startPose(t: number): Pose
	local c = COUNTDOWN
	local center = c.EndPoint

	if t < c.StartPunchTime then
		local u = t / c.StartPunchTime
		local e = easeOutCubic(u)
		return {
			Position = UDim2.fromScale(center.X, center.Y),
			Rotation = -8 * (1 - e),
			Scale = lerp(0.15, c.StartPeakScale, e),
			Transparency = 1 - clamp01(u / 0.4),
			Depth = lerp(2.0, 1.6, u),
			ShineY = c.ShineStart,
		}
	end

	local ti = t - c.StartPunchTime
	local k = springKick(ti, 18, 0.36)
	local push = lerp(c.StartRestScale, c.StartPushScale, clamp01(ti / 0.6))
	local scale = push + (c.StartPeakScale - c.StartRestScale) * k
	local shake = 0.006 * k
	local transparency = 0

	local exitStart = c.StartTotal - c.StartExitTime
	if t >= exitStart then
		local v = clamp01((t - exitStart) / c.StartExitTime)
		local e = v * v
		scale *= lerp(1, 1.4, e)
		transparency = e
	end

	return {
		Position = UDim2.fromScale(center.X + shake * math.sin(ti * 95), center.Y + shake * math.cos(ti * 83)),
		Rotation = 3 * k * math.sin(ti * 60),
		Scale = scale,
		Transparency = transparency,
		Depth = 1.25 - 0.95 * k,
		ShineY = lerp(c.ShineStart, 0, easeOutCubic(clamp01(ti / c.ShineTime))),
	}
end

local function paletteForNumber(remaining: number): Palette
	local main: Color3
	local shadow: Color3
	if remaining <= 2 then
		main = Color3.fromRGB(255, 95, 95)
		shadow = Color3.fromRGB(130, 25, 25)
	else
		main = Color3.fromRGB(255, 215, 60)
		shadow = Color3.fromRGB(130, 65, 10)
	end
	return {
		Main = main,
		Shadow = shadow,
		Deep = shadow:Lerp(Color3.new(0, 0, 0), 0.55),
		Accent = main:Lerp(Color3.new(1, 1, 1), 0.65),
	}
end

-- ===== Construccion de capas (se crean UNA vez y se reutilizan) =====

local function copyTextStyle(target: TextLabel, source: TextLabel)
	target.FontFace = source.FontFace
	target.TextSize = source.TextSize
	target.TextScaled = source.TextScaled
	target.TextWrapped = source.TextWrapped
	target.LineHeight = source.LineHeight
	target.TextXAlignment = source.TextXAlignment
	target.TextYAlignment = source.TextYAlignment
	target.RichText = false
end

local function newStack(name: string, container: Frame, source: TextLabel, layerCount: number, baseZ: number, outlined: boolean): FxStack
	local root = Instance.new("Frame")
	root.Name = name
	root.BackgroundTransparency = 1
	root.BorderSizePixel = 0
	root.AnchorPoint = source.AnchorPoint
	root.Size = source.Size
	root.Position = source.Position
	root.ZIndex = baseZ
	root.Visible = false

	local scale = Instance.new("UIScale")
	scale.Name = "UIScale"
	scale.Parent = root

	local layers: { TextLabel } = {}
	local stroke: UIStroke? = nil
	for i = 1, layerCount do
		local layer = Instance.new("TextLabel")
		layer.Name = "Layer" .. i
		layer.BackgroundTransparency = 1
		layer.BorderSizePixel = 0
		layer.Size = UDim2.fromScale(1, 1)
		layer.Position = UDim2.fromScale(0, 0)
		layer.ZIndex = baseZ + (layerCount - i) -- la capa 1 (pegada a la cara) queda arriba
		layer.Text = ""
		copyTextStyle(layer, source)
		if outlined and i == layerCount then
			local s = Instance.new("UIStroke")
			s.Name = "DeepStroke"
			s.Thickness = 4
			s.Color = Color3.fromRGB(10, 6, 3)
			s.Parent = layer
			stroke = s
		end
		layer.Parent = root
		table.insert(layers, layer)
	end

	root.Parent = container
	return { Root = root, Scale = scale, Layers = layers, Stroke = stroke }
end

local function newBurst(container: Frame): BurstFx
	local burst = Instance.new("Frame")
	burst.Name = "Burst"
	burst.BackgroundTransparency = 1
	burst.BorderSizePixel = 0
	burst.Size = UDim2.fromScale(1, 1)
	burst.ZIndex = 3
	burst.Visible = false
	burst.Parent = container

	local rings: { Frame } = {}
	local ringStrokes: { UIStroke } = {}
	for i = 1, 2 do
		local ring = Instance.new("Frame")
		ring.Name = "Ring" .. i
		ring.BackgroundTransparency = 1
		ring.BorderSizePixel = 0
		ring.AnchorPoint = Vector2.new(0.5, 0.5)
		ring.Position = UDim2.fromScale(0.5, 0.5)
		ring.SizeConstraint = Enum.SizeConstraint.RelativeYY -- circulo perfecto en cualquier resolucion
		ring.Size = UDim2.fromScale(0.1, 0.1)
		ring.ZIndex = 4
		ring.Visible = false

		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.5, 0)
		corner.Parent = ring

		local stroke = Instance.new("UIStroke")
		stroke.Thickness = 8
		stroke.Parent = ring

		ring.Parent = burst
		table.insert(rings, ring)
		table.insert(ringStrokes, stroke)
	end

	local rng = Random.new(1337)
	local sparks: { Frame } = {}
	local angles: { number } = {}
	local reach: { number } = {}
	for i = 1, COUNTDOWN.SparkCount do
		local spark = Instance.new("Frame")
		spark.Name = "Spark" .. i
		spark.BorderSizePixel = 0
		spark.AnchorPoint = Vector2.new(0.5, 0.5)
		spark.SizeConstraint = Enum.SizeConstraint.RelativeYY
		spark.Size = UDim2.fromScale(0.06, 0.012)
		spark.ZIndex = 5
		spark.Visible = false

		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.5, 0)
		corner.Parent = spark

		spark.Parent = burst
		table.insert(sparks, spark)
		table.insert(angles, (i - 1) / COUNTDOWN.SparkCount * math.pi * 2 + rng:NextNumber(-0.12, 0.12))
		table.insert(reach, rng:NextNumber(0.26, 0.48))
	end

	return { Container = burst, Rings = rings, RingStrokes = ringStrokes, Sparks = sparks, SparkAngles = angles, SparkReach = reach }
end

local function buildCountdownFx(frame: Frame, label: TextLabel): CountdownFx
	-- Limpieza de restos (evita duplicados si el controlador se reinicia)
	local staleFx = frame:FindFirstChild("CountdownFx")
	if staleFx then
		staleFx:Destroy()
	end
	local staleShadow = label:FindFirstChild("Shadow3D")
	if staleShadow then
		staleShadow:Destroy()
	end

	-- El label siempre por encima de las capas FX (vale para ZIndexBehavior Sibling y Global)
	label.AnchorPoint = Vector2.new(0.5, 0.5)
	label.ZIndex = math.max(label.ZIndex, 50)

	local container = Instance.new("Frame")
	container.Name = "CountdownFx"
	container.BackgroundTransparency = 1
	container.BorderSizePixel = 0
	container.Size = UDim2.fromScale(1, 1)
	container.Position = UDim2.fromScale(0, 0)
	container.ZIndex = 2
	container.Parent = frame

	local burst = newBurst(container)
	local extrusion = newStack("Extrusion", container, label, COUNTDOWN.DepthLayers, 10, true)
	local ghosts: { FxStack } = {}
	for g = 1, COUNTDOWN.GhostCount do
		table.insert(ghosts, newStack("Ghost" .. g, container, label, 1, 30 + g, false))
	end

	return { Container = container, Extrusion = extrusion, Ghosts = ghosts, Burst = burst }
end

-- ===== Sincronizacion label <-> capas =====

local function paintRig(rig: CountdownRig, text: string, palette: Palette)
	local label = rig.Label
	label.Text = text
	label.TextColor3 = palette.Main

	local layers = rig.Fx.Extrusion.Layers
	local n = #layers
	for i, layer in ipairs(layers) do
		copyTextStyle(layer, label)
		layer.Text = text
		layer.TextColor3 = palette.Shadow:Lerp(palette.Deep, if n > 1 then (i - 1) / (n - 1) else 0)
	end

	for _, ghost in ipairs(rig.Fx.Ghosts) do
		for _, layer in ipairs(ghost.Layers) do
			copyTextStyle(layer, label)
			layer.Text = text
			layer.TextColor3 = palette.Main
		end
	end

	local burst = rig.Fx.Burst
	burst.RingStrokes[1].Color = palette.Accent
	burst.RingStrokes[2].Color = palette.Main
	for i, spark in ipairs(burst.Sparks) do
		spark.BackgroundColor3 = if i % 2 == 0 then palette.Accent else palette.Main
	end
end

local function applyPose(rig: CountdownRig, pose: Pose)
	local label = rig.Label
	label.Position = pose.Position
	label.Rotation = pose.Rotation
	rig.UIScale.Scale = pose.Scale
	label.TextTransparency = pose.Transparency
	if rig.Stroke then
		rig.Stroke.Transparency = pose.Transparency
	end
	if rig.Gradient then
		rig.Gradient.Offset = Vector2.new(0, pose.ShineY)
	end

	local ext = rig.Fx.Extrusion
	ext.Root.Visible = pose.Transparency < 0.999
	ext.Root.Position = pose.Position
	ext.Root.Rotation = pose.Rotation
	ext.Scale.Scale = pose.Scale
	for i, layer in ipairs(ext.Layers) do
		layer.Position = UDim2.fromScale(0, COUNTDOWN.DepthStep * i * pose.Depth)
		layer.TextTransparency = pose.Transparency
	end
	if ext.Stroke then
		ext.Stroke.Transparency = pose.Transparency
	end
end

local function updateGhosts(rig: CountdownRig, t: number)
	local c = COUNTDOWN
	for g, ghost in ipairs(rig.Fx.Ghosts) do
		local u = t / c.EnterTime - c.GhostLag * g
		local visible = t < c.EnterTime and u > 0
		ghost.Root.Visible = visible
		if visible then
			local s = u ^ c.EnterEase
			local p = flightPoint(s)
			ghost.Root.Position = UDim2.fromScale(p.X, p.Y)
			ghost.Root.Rotation = flightTilt(s)
			ghost.Scale.Scale = lerp(c.FlightStartScale, 1 + c.ImpactScale, 1 - (1 - u) ^ 2)
			local transparency = math.max(c.GhostTransparency + (g - 1) * 0.12, 1 - clamp01(u / c.FadeInPortion))
			for _, layer in ipairs(ghost.Layers) do
				layer.TextTransparency = transparency
			end
		end
	end
end

local function hideGhosts(rig: CountdownRig)
	for _, ghost in ipairs(rig.Fx.Ghosts) do
		ghost.Root.Visible = false
	end
end

local RING_TIMING = {
	{ delay = 0, duration = 0.45, size = 2.2 },
	{ delay = 0.07, duration = 0.50, size = 1.5 },
}

local function updateBurst(rig: CountdownRig, t: number)
	local burst = rig.Fx.Burst
	burst.Container.Visible = true

	for i, ring in ipairs(burst.Rings) do
		local timing = RING_TIMING[i]
		local w = clamp01((t - timing.delay) / timing.duration)
		ring.Visible = t >= timing.delay and w < 1
		if ring.Visible then
			local e = easeOutCubic(w)
			local d = lerp(0.18, timing.size, e)
			ring.Size = UDim2.fromScale(d, d)
			burst.RingStrokes[i].Thickness = lerp(14, 1, w)
			burst.RingStrokes[i].Transparency = lerp(0.1, 1, w)
		end
	end

	local abs = rig.Frame.AbsoluteSize
	local aspect = if abs.X > 0 then abs.Y / abs.X else 1
	local w = clamp01((t - 0.02) / 0.5)
	local e = easeOutCubic(w)
	for i, spark in ipairs(burst.Sparks) do
		spark.Visible = t > 0.02 and w < 1
		if spark.Visible then
			local angle = burst.SparkAngles[i]
			local dist = burst.SparkReach[i] * e
			spark.Position = UDim2.fromScale(0.5 + math.cos(angle) * dist * aspect, 0.5 + math.sin(angle) * dist)
			spark.Rotation = math.deg(angle)
			spark.Size = UDim2.fromScale(0.06 * (1 - 0.7 * w), 0.012)
			spark.BackgroundTransparency = w * w
		end
	end
end

local function hideBurst(rig: CountdownRig)
	local burst = rig.Fx.Burst
	burst.Container.Visible = false
	for _, ring in ipairs(burst.Rings) do
		ring.Visible = false
	end
	for _, spark in ipairs(burst.Sparks) do
		spark.Visible = false
	end
end

-- ===== API del controlador =====

function MatchController:_getCountdownRig(): CountdownRig?
	local frame = self._startCountdownFrame
	local label = self._startCountdownLabel
	if not frame or not label then
		return nil
	end

	local fx = self._countdownFx
	if not fx or fx.Container.Parent ~= frame then
		fx = buildCountdownFx(frame, label)
		self._countdownFx = fx
	end

	local uiScale = label:FindFirstChildOfClass("UIScale")
	if not uiScale then
		uiScale = Instance.new("UIScale")
		uiScale.Parent = label
	end

	return {
		Frame = frame,
		Label = label,
		UIScale = uiScale :: UIScale,
		Stroke = label:FindFirstChildOfClass("UIStroke"),
		Gradient = label:FindFirstChildOfClass("UIGradient"),
		Fx = fx :: CountdownFx,
	}
end

function MatchController:_stopStartCountdownAnimation()
	self._countdownAnimToken += 1
	local conn = self._countdownConn
	if conn then
		conn:Disconnect()
		self._countdownConn = nil
	end
end

function MatchController:_updateStartCountdown(remaining: number, extraData: any?)
	local frame = self._startCountdownFrame
	if not frame or not self._startCountdownLabel then
		return
	end

	local isStarted = (remaining == 0) or (extraData and extraData.Started == true)
	local isPointRestart = (extraData and extraData.Phase == "PointRestart")
		or (self._currentState == Constants.RoundState.PointRestartCountdown)

	frame.Visible = true

	if self._startCountdownTitle then
		self._startCountdownTitle.Text = if isPointRestart then "SIGUIENTE PUNTO EN" else "LA PARTIDA COMIENZA"
	end

	local rig = self:_getCountdownRig()
	if not rig then
		return
	end

	-- Cancela cualquier animacion previa y reclama un token nuevo
	self:_stopStartCountdownAnimation()
	local myToken = self._countdownAnimToken

	local palette = if isStarted then START_PALETTE else paletteForNumber(remaining)
	paintRig(rig, if isStarted then "¡COMIENZA!" else tostring(remaining), palette)
	rig.Fx.Extrusion.Root.Visible = false
	hideGhosts(rig)
	hideBurst(rig)

	local startClock = os.clock()

	-- Un fotograma: devuelve true cuando la animacion termino
	local function step(): boolean
		local t = os.clock() - startClock
		if isStarted then
			applyPose(rig, startPose(t))
			updateBurst(rig, t)
			return t >= COUNTDOWN.StartTotal
		end
		applyPose(rig, numberPose(t))
		updateGhosts(rig, t)
		return t >= NUMBER_TOTAL
	end

	local function finish()
		hideGhosts(rig)
		hideBurst(rig)
		if isStarted
			and (self._currentState == Constants.RoundState.Playing or self._currentState == Constants.RoundState.Waiting)
		then
			frame.Visible = false
			rig.UIScale.Scale = 1
		end
	end

	-- Primer fotograma inmediato: el label nunca se ve un frame en la pose anterior
	if step() then
		finish()
		return
	end

	local conn: RBXScriptConnection? = nil
	conn = RunService.RenderStepped:Connect(function()
		if self._countdownAnimToken ~= myToken then
			if conn then
				conn:Disconnect()
			end
			return
		end
		if step() then
			if conn then
				conn:Disconnect()
			end
			if self._countdownConn == conn then
				self._countdownConn = nil
			end
			finish()
		end
	end)
	self._countdownConn = conn
end

function MatchController:_clearClonedButtons()
	for _, btn in pairs(self._clonedButtons) do
		btn:Destroy()
	end
	self._clonedButtons = {}
end

function MatchController:_populateMapSelection(maps: { string })
	if not self._mapsContainer or not self._mapButtonTemplate then return end

	self:_clearClonedButtons()

	for _, mapName in ipairs(maps) do
		local btn = self._mapButtonTemplate:Clone()
		btn.Name = "Btn_" .. mapName

		local mapNameLabel = btn:FindFirstChild("MapName") :: TextLabel?
		if mapNameLabel then
			mapNameLabel.Text = mapName
		end

		btn.Visible = true
		btn.MouseButton1Click:Connect(function()
			self:_submitVote(mapName, btn)
		end)

		btn.Parent = self._mapsContainer
		self._clonedButtons[mapName] = btn
	end
end

function MatchController:_submitVote(votePayload: string, clickedButton: TextButton?)
	local remotesFolder = ReplicatedStorage:FindFirstChild("Remotes")
	local matchFolder = remotesFolder and remotesFolder:FindFirstChild("Match")
	local mapSelection = matchFolder and matchFolder:FindFirstChild("MapSelection") :: RemoteEvent?

	if mapSelection and self._currentMatchId then
		mapSelection:FireServer(votePayload, self._currentMatchId)
	else
		return
	end

	self:_highlightSelectedVote(votePayload)
end

function MatchController:_resetButtonHighlights()
	if self._randomButton then
		local stroke = self._randomButton:FindFirstChildOfClass("UIStroke")
		self._randomButton.BackgroundColor3 = Color3.fromRGB(45, 55, 80)
		if stroke then stroke.Color = Color3.fromRGB(90, 120, 180); stroke.Thickness = 1.5 end
	end

	for _, btn in pairs(self._clonedButtons) do
		local stroke = btn:FindFirstChildOfClass("UIStroke")
		btn.BackgroundColor3 = Color3.fromRGB(30, 38, 55)
		if stroke then stroke.Color = Color3.fromRGB(60, 80, 120); stroke.Thickness = 1 end
	end
end

function MatchController:_highlightSelectedVote(votePayload: string)
	self._selectedMapVote = votePayload
	self:_resetButtonHighlights()

	if votePayload == Constants.SpecialMapVote.Random or votePayload == "Aleatorio" then
		if self._randomButton then
			local stroke = self._randomButton:FindFirstChildOfClass("UIStroke")
			self._randomButton.BackgroundColor3 = Color3.fromRGB(50, 100, 180)
			if stroke then stroke.Color = Color3.fromRGB(120, 200, 255); stroke.Thickness = 2 end
		end
	else
		local btn = self._clonedButtons[votePayload]
		if btn then
			local stroke = btn:FindFirstChildOfClass("UIStroke")
			btn.BackgroundColor3 = Color3.fromRGB(40, 90, 160)
			if stroke then stroke.Color = Color3.fromRGB(100, 180, 255); stroke.Thickness = 2 end
		end
	end
end

function MatchController:_handleMatchResult(result: string, winnerName: string?)
	if not self._resultFrame or not self._resultTitle or not self._resultSubtitle then return end

	local stroke = self._resultFrame:FindFirstChildOfClass("UIStroke")

	if result == Constants.MatchResult.Draw then
		self._resultTitle.Text = "EMPATE"
		self._resultTitle.TextColor3 = Color3.fromRGB(200, 205, 215)
		self._resultSubtitle.Text = "Se agoto el tiempo de la partida"
		if stroke then stroke.Color = Color3.fromRGB(150, 160, 180) end

	elseif result == Constants.MatchResult.Cancelled then
		self._resultTitle.Text = "CANCELADO"
		self._resultTitle.TextColor3 = Color3.fromRGB(230, 100, 100)
		self._resultSubtitle.Text = "Un jugador abandono la partida"
		if stroke then stroke.Color = Color3.fromRGB(200, 60, 60) end

	else
		local myRole = self._currentRole
		local isWinner = false

		if myRole and result == myRole then
			isWinner = true
		end

		if isWinner then
			self._resultTitle.Text = "VICTORIA"
			self._resultTitle.TextColor3 = Color3.fromRGB(255, 215, 0)
			self._resultSubtitle.Text = string.format("¡Has ganado la partida contra %s!", winnerName == localPlayer.Name and "tu oponente" or (winnerName or ""))
			if stroke then stroke.Color = Color3.fromRGB(255, 215, 0) end
		else
			self._resultTitle.Text = "DERROTA"
			self._resultTitle.TextColor3 = Color3.fromRGB(230, 70, 70)
			self._resultSubtitle.Text = string.format("Ganador: %s", winnerName or result)
			if stroke then stroke.Color = Color3.fromRGB(220, 50, 50) end
		end
	end

	self._resultFrame.Visible = true
end

return MatchController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="4286">
          <Properties>
            <string name="Name">MatchStartEffectsController</string>
            <string name="Source"><![CDATA[--!strict
-- MatchStartEffectsController
-- Controlador cliente dedicado a la presentación y Game Feel del StartCountdown.
-- Responsabilidad exclusiva de PRESENTACIÓN:
-- - Camera Shake local acumulativo y seguro (RenderPriority.Camera + 1) sin alterar la base de la cámara.
-- - Destellos de pantalla (FlashOverlay) con intensidad creciente 5..1 y clímax en ¡COMIENZA!.
-- - Blur dinámico y efímero (Lighting.MatchStartBlur).
-- - Expansión de ondas (PulseFrame y ShockwaveFrame).
-- - Audio direccional/SFX (SoundService.MatchStartSFX).
-- - Aislamiento estricto por MatchId para partidas simultáneas.
-- - Cleanup defensivo ante desconexiones, cancelaciones o transición a Playing.
-- NO altera lógica de gameplay, scoring ni la autoridad del servidor.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")
local SoundService = game:GetService("SoundService")

local Config = require(ReplicatedStorage.Shared.Config)
local Constants = require(ReplicatedStorage.Shared.Constants)

local localPlayer = Players.LocalPlayer
local camera = workspace.CurrentCamera :: Camera

local MatchStartEffectsController = {}
MatchStartEffectsController.Name = "MatchStartEffectsController"

-- Referencias internas
MatchStartEffectsController._context = nil :: any
MatchStartEffectsController._activeMatchId = nil :: string?
MatchStartEffectsController._lastStateVersion = 0
MatchStartEffectsController._activeConnections = {} :: { RBXScriptConnection }
MatchStartEffectsController._activeTweens = {} :: { Tween }
MatchStartEffectsController._activeThreads = {} :: { thread }

-- Instancias de presentación en Lighting, UI y Audio
MatchStartEffectsController._blurEffect = nil :: BlurEffect?
MatchStartEffectsController._flashOverlay = nil :: Frame?
MatchStartEffectsController._pulseFrame = nil :: Frame?
MatchStartEffectsController._shockwaveFrame = nil :: Frame?
MatchStartEffectsController._pulseScale = nil :: UIScale?
MatchStartEffectsController._shockwaveScale = nil :: UIScale?
MatchStartEffectsController._effectsScale = nil :: UIScale?
MatchStartEffectsController._sfxFolder = nil :: Folder?

-- Estado de Camera Shake
MatchStartEffectsController._shakeTrauma = 0
MatchStartEffectsController._shakeDecay = 2.0
MatchStartEffectsController._shakeMoveStuds = 0.5
MatchStartEffectsController._shakeRollDeg = 1.5
MatchStartEffectsController._shakeSeed = math.random() * 1000

local RENDER_STEP_NAME = "MatchStartCameraShake"

-- Accesibilidad: reduce intensidad si el jugador tiene el atributo activado
local function getAccessibilityScale(): number
	if localPlayer and localPlayer:GetAttribute("ReduceScreenEffects") == true then
		return 0.3
	end
	return 1.0
end

function MatchStartEffectsController:Init(context)
	self._context = context
	self._activeMatchId = nil
	self._lastStateVersion = 0
	self._activeConnections = {}
	self._activeTweens = {}
	self._activeThreads = {}

	self:_bindInstances()
	self:_setupCameraShake()
end

function MatchStartEffectsController:Start(context)
	self._context = context
	self:_connectRemotes()
	print("[MatchStartEffectsController] Controlador de Game Feel de inicio de partida iniciado y listo")
end

-- Localiza las instancias visuales y auditivas en Lighting, PlayerGui y SoundService
function MatchStartEffectsController:_bindInstances()
	-- 1. Lighting.MatchStartBlur
	local blur = Lighting:FindFirstChild("MatchStartBlur") :: BlurEffect?
	if not blur then
		blur = Instance.new("BlurEffect")
		blur.Name = "MatchStartBlur"
		blur.Enabled = false
		blur.Size = 0
		blur.Parent = Lighting
	end
	self._blurEffect = blur
	blur.Enabled = false
	blur.Size = 0

	-- 2. StarterGui / PlayerGui.MatchHUD.StartEffects
	task.spawn(function()
		local playerGui = localPlayer:WaitForChild("PlayerGui", 10)
		if not playerGui then return end

		local hud = playerGui:WaitForChild("MatchHUD", 15)
		if not hud then return end

		local effects = hud:WaitForChild("StartEffects", 10)
		if not effects then return end

		self._effectsScale = effects:FindFirstChild("UIScale") :: UIScale?
		self._flashOverlay = effects:FindFirstChild("FlashOverlay") :: Frame?
		self._pulseFrame = effects:FindFirstChild("PulseFrame") :: Frame?
		self._shockwaveFrame = effects:FindFirstChild("ShockwaveFrame") :: Frame?

		if self._pulseFrame then
			self._pulseScale = self._pulseFrame:FindFirstChild("UIScale") :: UIScale?
		end
		if self._shockwaveFrame then
			self._shockwaveScale = self._shockwaveFrame:FindFirstChild("UIScale") :: UIScale?
		end

		if self._flashOverlay then self._flashOverlay.BackgroundTransparency = 1 end
		if self._pulseFrame then self._pulseFrame.Visible = false end
		if self._shockwaveFrame then self._shockwaveFrame.Visible = false end
	end)

	-- 3. SoundService.MatchStartSFX
	self._sfxFolder = SoundService:FindFirstChild("MatchStartSFX") :: Folder?
end

-- Configura el enlace de RunService para la sacudida de cámara local sin modificar CFrame de forma permanente
function MatchStartEffectsController:_setupCameraShake()
	RunService:UnbindFromRenderStep(RENDER_STEP_NAME)

	RunService:BindToRenderStep(RENDER_STEP_NAME, Enum.RenderPriority.Camera.Value + 1, function(dt: number)
		if localPlayer:GetAttribute("ResultsSessionId") ~= nil then self._shakeTrauma = 0; return end
		if self._shakeTrauma <= 0 then return end

		self._shakeTrauma = math.max(0, self._shakeTrauma - dt * self._shakeDecay)
		local traumaSq = self._shakeTrauma * self._shakeTrauma
		local scale = getAccessibilityScale()

		local t = os.clock() * 32
		local nx = math.noise(self._shakeSeed, t, 0) * 2
		local ny = math.noise(self._shakeSeed, t, 15) * 2
		local nr = math.noise(self._shakeSeed, t, 30) * 2

		local cam = workspace.CurrentCamera
		if cam then
			local move = (self._shakeMoveStuds * traumaSq) * scale
			local roll = math.rad(self._shakeRollDeg * traumaSq) * scale
			cam.CFrame = cam.CFrame * CFrame.new(nx * move, ny * move, 0) * CFrame.Angles(0, 0, nr * roll)
		end
	end)
end

-- Conexión reactiva a los RemoteEvents existentes
function MatchStartEffectsController:_connectRemotes()
	local remotesFolder = ReplicatedStorage:WaitForChild("Remotes", 10)
	if not remotesFolder then return end

	local matchFolder = remotesFolder:WaitForChild("Match", 10)
	if not matchFolder then return end

	local stateChanged = matchFolder:WaitForChild("StateChanged", 10) :: RemoteEvent?
	local countdown = matchFolder:WaitForChild("Countdown", 10) :: RemoteEvent?

	if stateChanged then
		table.insert(self._activeConnections, stateChanged.OnClientEvent:Connect(function(newState: string, extraData: any)
			self:_handleStateChanged(newState, extraData)
		end))
	end

	if countdown then
		table.insert(self._activeConnections, countdown.OnClientEvent:Connect(function(remaining: number, label: string, extraData: any?)
			self:_handleCountdown(remaining, label, extraData)
		end))
	end
end

-- Determina si el jugador local pertenece al match según los datos del servidor
local function isLocalPlayerInMatch(extraData: any): boolean
	return type(extraData) == "table"
		and type(extraData.ParticipantUserIds) == "table"
		and table.find(extraData.ParticipantUserIds, localPlayer.UserId) ~= nil
end

function MatchStartEffectsController:_acceptSessionPayload(extraData: any, allowBind: boolean, advanceVersion: boolean?): boolean
	if type(extraData) ~= "table" then return false end
	local sessionId = extraData.SessionId or extraData.MatchId
	if type(sessionId) ~= "string" or sessionId == "" then return false end
	local version = extraData.StateVersion
	if version ~= nil and type(version) ~= "number" then return false end
	if self._activeMatchId == nil then
		if not allowBind or localPlayer:GetAttribute("MatchId") ~= sessionId or not isLocalPlayerInMatch(extraData) then
			return false
		end
		self._activeMatchId = sessionId
		self._lastStateVersion = 0
	elseif self._activeMatchId ~= sessionId then
		return false
	end
	if version ~= nil and version < self._lastStateVersion then return false end
	if advanceVersion and version ~= nil then self._lastStateVersion = version end
	return true
end

function MatchStartEffectsController:_handleStateChanged(newState: string, extraData: any)
	if not self:_acceptSessionPayload(extraData, true, true) then return end
	local eventSessionId = self._activeMatchId
	if newState == Constants.RoundState.StartCountdown
		or newState == Constants.RoundState.PointRestartCountdown
		or newState == Constants.RoundState.MatchReady then
	elseif newState == Constants.RoundState.Playing then
		-- Al entrar a Playing, programar cleanup tras un breve respiro para que concluya la secuencia de ¡COMIENZA!
		task.delay(0.75, function()
			if self._activeMatchId == eventSessionId then self:Cleanup() end
		end)
	elseif newState == Constants.RoundState.Ending
		or newState == Constants.RoundState.ReturningToLobby
		or newState == Constants.RoundState.Waiting then
		self:Cleanup()
		if newState == Constants.RoundState.ReturningToLobby or newState == Constants.RoundState.Waiting then
			self._activeMatchId = nil
			self._lastStateVersion = 0
		end
	end
end

function MatchStartEffectsController:_handleCountdown(remaining: number, label: string, extraData: any?)
	-- Solo procesar conteos correspondientes a START_COUNTDOWN
	if label ~= "START_COUNTDOWN" and (extraData == nil or extraData.Started == nil) then
		return
	end

	if not self:_acceptSessionPayload(extraData, false, false) then return end

	if remaining > 0 then
		self:PlayCountdown(remaining, extraData)
	elseif remaining == 0 or (extraData and extraData.Started == true) then
		self:PlayStart(extraData)
	end
end

-- ==================================================
-- EJECUCIÓN MODULAR DE EFECTOS
-- ==================================================

-- Impacto audiovisual correspondiente a un número (5..1 o 3..1)
function MatchStartEffectsController:PlayCountdown(value: number, extraData: any?)
	local isPointRestart = (extraData and extraData.Phase == "PointRestart")
	local key = tostring(value)
	local cfgTable = if isPointRestart
		then (Config.PointRestartCountdownEffects or Config.StartCountdownEffects)
		else Config.StartCountdownEffects

	local cfg = (cfgTable and cfgTable[key]) or {
		ShakeStuds = 0.20,
		ShakeRotationDeg = 1.0,
		ShakeDuration = 0.35,
		FlashTransparency = 0.85,
		FlashFadeDuration = 0.25,
		BlurSize = 3,
		BlurDuration = 0.30,
		PulseScale = 1.6,
		PulseDuration = 0.30,
		SoundName = "CountdownTick",
		SoundVolume = 0.70,
		SoundPlaybackSpeed = 1.0,
	}

	-- 1. Camera Shake
	self:Shake(cfg.ShakeStuds, cfg.ShakeRotationDeg, cfg.ShakeDuration)

	-- 2. Screen Flash
	self:Flash(cfg.FlashTransparency, cfg.FlashFadeDuration)

	-- 3. Blur
	self:Blur(cfg.BlurSize, cfg.BlurDuration)

	-- 4. Pulse de expansión (manteniendo color editable en Studio)
	self:Pulse(cfg.PulseScale, cfg.PulseDuration)

	-- 5. Audio
	if cfg.SoundName then
		self:PlaySound(cfg.SoundName, cfg.SoundVolume, cfg.SoundPlaybackSpeed)
	end
end

-- Clímax cinematográfico correspondiente a ¡COMIENZA!
function MatchStartEffectsController:PlayStart(extraData: any?)
	local isPointRestart = (extraData and extraData.Phase == "PointRestart")
	local cfgTable = if isPointRestart
		then (Config.PointRestartCountdownEffects or Config.StartCountdownEffects)
		else Config.StartCountdownEffects

	local cfg = (cfgTable and cfgTable["GO"]) or {
		ShakeStuds = 0.90,
		ShakeRotationDeg = 3.0,
		ShakeDuration = 0.70,
		FlashTransparency = 0.18,
		FlashFadeDuration = 0.50,
		BlurSize = 10.0,
		BlurDuration = 0.60,
		PulseScale = 2.8,
		PulseDuration = 0.50,
		ShockwaveScale = 3.5,
		ShockwaveDuration = 0.55,
		WhooshSoundName = "StartWhoosh",
		ImpactSoundName = "StartImpact",
		SoundVolume = 1.25,
	}

	-- T+0.00: Gran flash, fuerte sacudida, blur y sonido whoosh
	self:Flash(cfg.FlashTransparency, cfg.FlashFadeDuration)
	self:Shake(cfg.ShakeStuds * 0.7, cfg.ShakeRotationDeg * 0.7, 0.35)
	self:Blur(cfg.BlurSize, cfg.BlurDuration)
	if cfg.WhooshSoundName then
		self:PlaySound(cfg.WhooshSoundName, 0.9, 1.0)
	end

	-- T+0.12 (o T+0.08 en PointRestart más rápido): Shockwave grande, impacto de cámara máximo y sonido explosivo
	local delayTime = if isPointRestart then 0.08 else 0.12
	local th = task.delay(delayTime, function()
		self:Shake(cfg.ShakeStuds, cfg.ShakeRotationDeg, cfg.ShakeDuration)
		self:Shockwave(cfg.ShockwaveScale or 3.5, cfg.ShockwaveDuration or 0.55)
		if cfg.ImpactSoundName then
			self:PlaySound(cfg.ImpactSoundName, cfg.SoundVolume or 1.25, 1.0)
		end
	end)
	table.insert(self._activeThreads, th)
end

-- Aplica impulso de sacudida a la cámara con trauma decreciente
function MatchStartEffectsController:Shake(studs: number, rotDeg: number, duration: number)
	self._shakeMoveStuds = studs
	self._shakeRollDeg = rotDeg
	self._shakeDecay = 1.0 / math.max(0.1, duration)
	self._shakeTrauma = 1.0
end

-- Destello de pantalla (FlashOverlay)
function MatchStartEffectsController:Flash(peakTransparency: number, fadeTime: number)
	local overlay = self._flashOverlay
	if not overlay then return end

	local accScale = getAccessibilityScale()
	local effectiveTransparency = 1 - ((1 - peakTransparency) * accScale)

	overlay.BackgroundTransparency = effectiveTransparency
	overlay.Visible = true

	local tw = TweenService:Create(overlay, TweenInfo.new(fadeTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		BackgroundTransparency = 1,
	})
	table.insert(self._activeTweens, tw)
	tw.Completed:Once(function()
		if overlay.BackgroundTransparency >= 0.99 then
			overlay.BackgroundTransparency = 1
		end
	end)
	tw:Play()
end

-- Blur efímero en Lighting
function MatchStartEffectsController:Blur(targetSize: number, duration: number)
	local blur = self._blurEffect
	if not blur then return end

	local accScale = getAccessibilityScale()
	local effectiveSize = targetSize * accScale

	blur.Enabled = true
	blur.Size = effectiveSize

	local holdTime = duration * 0.25
	local fadeTime = duration * 0.75

	local th = task.delay(holdTime, function()
		if not blur or not blur.Parent then return end
		local tw = TweenService:Create(blur, TweenInfo.new(fadeTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = 0,
		})
		table.insert(self._activeTweens, tw)
		tw.Completed:Once(function()
			if blur and blur.Size <= 0.2 then
				blur.Size = 0
				blur.Enabled = false
			end
		end)
		tw:Play()
	end)
	table.insert(self._activeThreads, th)
end

-- Onda expansiva sutil (PulseFrame) alrededor del centro del HUD
function MatchStartEffectsController:Pulse(targetScale: number, duration: number, strokeColor: Color3?)
	local frame = self._pulseFrame
	if not frame then return end

	local stroke = frame:FindFirstChildOfClass("UIStroke")
	if not stroke then return end

	local uiScale = self._pulseScale or frame:FindFirstChildOfClass("UIScale")

	frame.Visible = true
	if strokeColor then
		stroke.Color = strokeColor
	end
	stroke.Transparency = 0.1

	if uiScale then
		uiScale.Scale = 0.3
		local twScale = TweenService:Create(uiScale, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Scale = targetScale,
		})
		local twStroke = TweenService:Create(stroke, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Transparency = 1,
		})

		table.insert(self._activeTweens, twScale)
		table.insert(self._activeTweens, twStroke)

		twScale.Completed:Once(function()
			frame.Visible = false
			uiScale.Scale = 1.0
		end)

		twScale:Play()
		twStroke:Play()
	else
		local baseSize = UDim2.fromOffset(120, 120)
		frame.Size = baseSize
		local targetSize = UDim2.fromOffset(120 * targetScale, 120 * targetScale)

		local twSize = TweenService:Create(frame, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = targetSize,
		})
		local twStroke = TweenService:Create(stroke, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Transparency = 1,
		})

		table.insert(self._activeTweens, twSize)
		table.insert(self._activeTweens, twStroke)

		twSize.Completed:Once(function()
			frame.Visible = false
		end)

		twSize:Play()
		twStroke:Play()
	end
end

-- Onda expansiva prominente (ShockwaveFrame) para ¡COMIENZA!
function MatchStartEffectsController:Shockwave(targetScale: number, duration: number)
	local frame = self._shockwaveFrame
	if not frame then return end

	local stroke = frame:FindFirstChildOfClass("UIStroke")
	if not stroke then return end

	local uiScale = self._shockwaveScale or frame:FindFirstChildOfClass("UIScale")

	frame.Visible = true
	stroke.Transparency = 0

	if uiScale then
		uiScale.Scale = 0.2
		local twScale = TweenService:Create(uiScale, TweenInfo.new(duration, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), {
			Scale = targetScale,
		})
		local twStroke = TweenService:Create(stroke, TweenInfo.new(duration, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), {
			Transparency = 1,
		})

		table.insert(self._activeTweens, twScale)
		table.insert(self._activeTweens, twStroke)

		twScale.Completed:Once(function()
			frame.Visible = false
			uiScale.Scale = 1.0
		end)

		twScale:Play()
		twStroke:Play()
	else
		local baseSize = UDim2.fromOffset(140, 140)
		frame.Size = baseSize
		local targetSize = UDim2.fromOffset(140 * targetScale, 140 * targetScale)

		local twSize = TweenService:Create(frame, TweenInfo.new(duration, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), {
			Size = targetSize,
		})
		local twStroke = TweenService:Create(stroke, TweenInfo.new(duration, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), {
			Transparency = 1,
		})

		table.insert(self._activeTweens, twSize)
		table.insert(self._activeTweens, twStroke)

		twSize.Completed:Once(function()
			frame.Visible = false
		end)

		twSize:Play()
		twStroke:Play()
	end
end

-- Reproduce un sonido localizado en SoundService.MatchStartSFX
function MatchStartEffectsController:PlaySound(soundName: string, volume: number?, speed: number?)
	local folder = self._sfxFolder or SoundService:FindFirstChild("MatchStartSFX")
	if not folder then return end

	local sfx = folder:FindFirstChild(soundName) :: Sound?
	if sfx and sfx:IsA("Sound") then
		local clone = sfx:Clone()
		if volume then clone.Volume = volume end
		if speed then clone.PlaybackSpeed = speed end
		clone.Parent = SoundService
		clone.Ended:Once(function()
			clone:Destroy()
		end)
		clone:Play()
		-- Limpieza de seguridad por si el audio se interrumpe
		task.delay(3, function()
			if clone and clone.Parent then
				clone:Destroy()
			end
		end)
	end
end

-- Limpieza exhaustiva de todos los efectos visuales y auditivos
function MatchStartEffectsController:Cleanup()
	-- 1. Reset Camera Shake
	self._shakeTrauma = 0

	-- 2. Cancelar tweens activos
	for _, tw in ipairs(self._activeTweens) do
		pcall(function()
			tw:Cancel()
		end)
	end
	self._activeTweens = {}

	-- 3. Cancelar hilos activos
	for _, th in ipairs(self._activeThreads) do
		pcall(task.cancel, th)
	end
	self._activeThreads = {}

	-- 4. Reset Blur
	if self._blurEffect then
		self._blurEffect.Size = 0
		self._blurEffect.Enabled = false
	end

	-- 5. Reset Overlays y Frames
	if self._flashOverlay then
		self._flashOverlay.BackgroundTransparency = 1
	end
	if self._pulseFrame then
		self._pulseFrame.Visible = false
		local s = self._pulseFrame:FindFirstChildOfClass("UIStroke")
		if s then s.Transparency = 1 end
		local sc = self._pulseScale or self._pulseFrame:FindFirstChildOfClass("UIScale")
		if sc then sc.Scale = 1.0 end
	end
	if self._shockwaveFrame then
		self._shockwaveFrame.Visible = false
		local s = self._shockwaveFrame:FindFirstChildOfClass("UIStroke")
		if s then s.Transparency = 1 end
		local sc = self._shockwaveScale or self._shockwaveFrame:FindFirstChildOfClass("UIScale")
		if sc then sc.Scale = 1.0 end
	end
end

return MatchStartEffectsController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="4287">
          <Properties>
            <string name="Name">MatchmakingController</string>
            <string name="Source"><![CDATA[--!strict
-- MatchmakingController
-- Controlador del HUD de matchmaking genérico (1v1, 2v2, 3v3).
-- Controla la visualización de PlayerGui.MatchmakingHUD basándose en los QueueSnapshots
-- emitidos autoritativamente por el servidor. NO crea la interfaz mediante código.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Constants = require(ReplicatedStorage.Shared.Constants)
local Types = require(ReplicatedStorage.Shared.Types)

type QueueSnapshot = Types.QueueSnapshot

local localPlayer = Players.LocalPlayer

local MatchmakingController = {}
MatchmakingController.Name = "MatchmakingController"

-- Referencias a instancias de PlayerGui.MatchmakingHUD
MatchmakingController._hud = nil :: ScreenGui?
MatchmakingController._queueFrame = nil :: Frame?
MatchmakingController._title = nil :: TextLabel?
MatchmakingController._statusBadge = nil :: TextLabel?
MatchmakingController._redTeamHeader = nil :: TextLabel?
MatchmakingController._blueTeamHeader = nil :: TextLabel?
MatchmakingController._redSlotsContainer = nil :: Frame?
MatchmakingController._blueSlotsContainer = nil :: Frame?
MatchmakingController._slotTemplate = nil :: Frame?

MatchmakingController._redSlotClones = {} :: { Frame }
MatchmakingController._blueSlotClones = {} :: { Frame }
MatchmakingController._currentZone = nil :: string?
MatchmakingController._context = nil :: any
MatchmakingController._isInQueue = false

function MatchmakingController:Init(context)
	self._context = context
	self:_cleanupLegacyPadMusic()
	self:_bindHUD()
end

function MatchmakingController:IsInQueue(): boolean
	return self._isInQueue
end

function MatchmakingController:Start(context)
	self._context = context
	self:_connectRemotes()
	print("[MatchmakingController] Controlador de matchmaking iniciado y enlazado a PlayerGui.MatchmakingHUD")
end

function MatchmakingController:_bindHUD()
	local playerGui = localPlayer:WaitForChild("PlayerGui")
	local hud = playerGui:WaitForChild("MatchmakingHUD", 15) :: ScreenGui?
	if not hud then
		warn("[MatchmakingController] No se encontro MatchmakingHUD en PlayerGui")
		return
	end
	self._hud = hud

	local queueFrame = hud:WaitForChild("QueueFrame", 10) :: Frame?
	if not queueFrame then
		warn("[MatchmakingController] No se encontro QueueFrame en MatchmakingHUD")
		return
	end
	self._queueFrame = queueFrame
	queueFrame.Visible = false

	local header = queueFrame:FindFirstChild("Header") :: Frame?
	if header then
		self._title = header:FindFirstChild("Title") :: TextLabel?
		self._statusBadge = header:FindFirstChild("StatusBadge") :: TextLabel?
	end

	local content = queueFrame:FindFirstChild("Content") or queueFrame
	local redSide = content:FindFirstChild("RedTeam") or content:FindFirstChild("LocalTeam")
	local blueSide = content:FindFirstChild("BlueTeam") or content:FindFirstChild("OpponentTeam")

	if redSide then
		local header = redSide:FindFirstChild("TeamLabel") or redSide:FindFirstChild("TeamHeader")
		if header and header:IsA("TextLabel") then
			header.Visible = true
			header.Position = UDim2.new(header.Position.X.Scale, header.Position.X.Offset, 0, -36)
			self._redTeamHeader = header
		end
		self._redSlotsContainer = redSide:FindFirstChild("SlotsContainer") :: Frame?
	end

	if blueSide then
		local header = blueSide:FindFirstChild("TeamLabel") or blueSide:FindFirstChild("TeamHeader")
		if header and header:IsA("TextLabel") then
			header.Visible = true
			header.Position = UDim2.new(header.Position.X.Scale, header.Position.X.Offset, 0, -36)
			self._blueTeamHeader = header
		end
		self._blueSlotsContainer = blueSide:FindFirstChild("SlotsContainer") :: Frame?
	end

	local template = queueFrame:FindFirstChild("PlayerSlotTemplate", true) :: Frame?
	if template then
		self._slotTemplate = template
		template.Visible = false
	end
	-- Reuse the authored center label when this HUD has no separate status header.
	if not self._statusBadge then
		local versus = content:FindFirstChild("Versus")
		self._statusBadge = versus and versus:FindFirstChildOfClass("TextLabel")
	end
	local scale = queueFrame:FindFirstChild("CardScale")
	if scale and scale:IsA("UIScale") then
		self._queueScale = scale
		self._authoredQueueScale = scale.Scale
	end
	if self._queueSizeConnection then self._queueSizeConnection:Disconnect() end
	if self._viewportSizeConnection then self._viewportSizeConnection:Disconnect() end
	self._queueSizeConnection = queueFrame:GetPropertyChangedSignal("AbsoluteSize"):Connect(function() self:_fitQueue() end)
	self._viewportSizeConnection = hud:GetPropertyChangedSignal("AbsoluteSize"):Connect(function() self:_fitQueue() end)
end

-- Bound the existing card to the viewport; preserve its authored scale whenever it fits.
function MatchmakingController:_fitQueue()
	local frame, scale, hud = self._queueFrame, self._queueScale, self._hud
	if not frame or not scale or not hud or scale.Scale <= 0 then return end
	local width = frame.AbsoluteSize.X / scale.Scale
	if width <= 0 or hud.AbsoluteSize.X <= 0 then return end
	local fitted = math.min(self._authoredQueueScale or 1, hud.AbsoluteSize.X * 0.92 / width)
	if math.abs(scale.Scale - fitted) > 0.001 then scale.Scale = fitted end
end

function MatchmakingController:_connectRemotes()
	local remotes = ReplicatedStorage:WaitForChild("Remotes", 10)
	if not remotes then return end

	local mmFolder = remotes:WaitForChild("Matchmaking", 10)
	if mmFolder then
		local queueRemote = mmFolder:WaitForChild("QueueStatus", 10) :: RemoteEvent?
		if queueRemote then
			queueRemote.OnClientEvent:Connect(function(snapshot: QueueSnapshot)
				self:_handleQueueStatus(snapshot)
			end)
		end
	end

	-- Ocultar el HUD de matchmaking únicamente cuando la partida pasa a fases comprometidas (supera la preparación)
	local matchFolder = remotes:WaitForChild("Match", 10)
	if matchFolder then
		local stateChanged = matchFolder:WaitForChild("StateChanged", 10) :: RemoteEvent?
		if stateChanged then
			stateChanged.OnClientEvent:Connect(function(newState: string, payload: any)
				local sessionId = type(payload) == "table" and (payload.SessionId or payload.MatchId) or nil
				if type(sessionId) ~= "string" or localPlayer:GetAttribute("MatchId") ~= sessionId then return end
				local isPreparationState = (newState == Constants.RoundState.Waiting
					or newState == Constants.RoundState.MatchReady
					or newState == Constants.RoundState.MatchCountdown)

				if not isPreparationState then
					if self._queueFrame then
						self._queueFrame.Visible = false
					end
					self._isInQueue = false
				end
			end)
		end
	end
end

-- Limpia los slots clonados previos
function MatchmakingController:_clearSlots()
	for _, slot in ipairs(self._redSlotClones) do
		slot:Destroy()
	end
	self._redSlotClones = {}

	for _, slot in ipairs(self._blueSlotClones) do
		slot:Destroy()
	end
	self._blueSlotClones = {}
end

-- Limpieza defensiva de cualquier audio de pad residual en SoundService
function MatchmakingController:_cleanupLegacyPadMusic()
	local SoundService = game:GetService("SoundService")
	local old = SoundService:FindFirstChild("LocalMatchmakingPadMusic")
	if old then
		if old:IsA("Sound") and old.IsPlaying then
			old:Stop()
		end
		old:Destroy()
	end
end

-- Determina si el jugador local forma parte de la lista de un equipo
local function isPlayerInList(player: Player, list: { Player }): boolean
	for _, p in ipairs(list) do
		if p == player then return true end
	end
	return false
end

function MatchmakingController:_handleQueueStatus(snapshot: QueueSnapshot)
	if not self._queueFrame or not self._slotTemplate then
		self:_bindHUD()
		if not self._queueFrame or not self._slotTemplate then return end
	end

	local inRed = isPlayerInList(localPlayer, snapshot.Red)
	local inBlue = isPlayerInList(localPlayer, snapshot.Blue)
	local isParticipant = inRed or inBlue
	local snapshotZoneId = snapshot.ZoneId or snapshot.ZoneName

	if isParticipant then
		self._currentZone = snapshotZoneId
		self._queueFrame.Visible = true

		if not self._isInQueue then
			self._isInQueue = true
			local musicController = self._context and self._context:GetController("MusicController")
			if musicController then
				musicController:PlayMatchmaking()
			end
		end
	else
		-- El jugador no es participante de este snapshot recibido.
		-- ÚNICAMENTE cerramos el HUD si el snapshot proviene de la zona que el jugador estaba siguiendo actualmente.
		if self._currentZone ~= nil and self._currentZone == snapshotZoneId then
			self._queueFrame.Visible = false
			self:_clearSlots()
			self._currentZone = nil

			if self._isInQueue then
				self._isInQueue = false
				local matchController = self._context and self._context:GetController("MatchController")
				local inMatch = matchController and typeof(matchController.IsParticipant) == "function" and matchController:IsParticipant()
				if not inMatch then
					local musicController = self._context and self._context:GetController("MusicController")
					if musicController then
						musicController:PlayLobby()
					end
				end
			end
		end
		-- Si el snapshot pertenece a otra zona diferente donde el jugador no está, se ignora completamente
		return
	end

	-- 1. Actualizar Título y Estado
	if self._redTeamHeader then
		self._redTeamHeader.Text = string.format("RED %d/%d", #snapshot.Red, snapshot.TeamSize)
	end
	if self._blueTeamHeader then
		self._blueTeamHeader.Text = string.format("BLUE %d/%d", #snapshot.Blue, snapshot.TeamSize)
	end
	if self._title then
		self._title.Text = string.format("COLA %s", string.upper(snapshot.Mode))
	end

	if self._statusBadge then
		if snapshot.State == "READY" then
			self._statusBadge.Text = "¡PARTIDA LISTA!"
			self._statusBadge.TextColor3 = Color3.fromRGB(120, 255, 160)
			self._statusBadge.BackgroundColor3 = Color3.fromRGB(20, 50, 30)
		else
			local currentTotal = #snapshot.Red + #snapshot.Blue
			self._statusBadge.Text = string.format("ESPERANDO (%d/%d)", currentTotal, snapshot.TotalPlayers)
			self._statusBadge.TextColor3 = Color3.fromRGB(180, 205, 255)
			self._statusBadge.BackgroundColor3 = Color3.fromRGB(30, 40, 60)
		end
	end

	-- 2. Renderizar Slots de cada lado (Lado Izquierdo = Red, Lado Derecho = Blue)
	self:_clearSlots()

	if self._redSlotsContainer then
		for i = 1, snapshot.TeamSize do
			local player = snapshot.Red[i]
			local slot = self:_createSlotInstance(player, "Red")
			slot.Parent = self._redSlotsContainer
			table.insert(self._redSlotClones, slot)
		end
	end

	if self._blueSlotsContainer then
		for i = 1, snapshot.TeamSize do
			local player = snapshot.Blue[i]
			local slot = self:_createSlotInstance(player, "Blue")
			slot.Parent = self._blueSlotsContainer
			table.insert(self._blueSlotClones, slot)
		end
	end
	self:_fitQueue()
end

-- Clona y configura una instancia del template de slot de jugador
function MatchmakingController:_createSlotInstance(player: Player?, teamName: string): Frame
	local slot = self._slotTemplate:Clone() :: Frame
	slot.Name = "Slot_" .. (player and player.Name or "Empty")

	local nameLabel = slot:FindFirstChild("NameLabel", true) :: TextLabel?
	local body = slot:FindFirstChild("Body") or slot
	local occupied = body:FindFirstChild("Occupied") :: Frame?
	local empty = body:FindFirstChild("Empty") :: Frame?

	local avatarImg = (occupied and occupied:FindFirstChild("Avatar", true)) :: ImageLabel?
		or (slot:FindFirstChild("Avatar", true) :: ImageLabel?)
	local displayName = (occupied and occupied:FindFirstChild("DisplayName", true)) :: TextLabel?
		or (slot:FindFirstChild("DisplayName", true) :: TextLabel?)
	local username = (occupied and occupied:FindFirstChild("Username", true)) :: TextLabel?
		or (slot:FindFirstChild("Username", true) :: TextLabel?)
	local occupiedStroke = (occupied and occupied:FindFirstChildOfClass("UIStroke"))
		or slot:FindFirstChildOfClass("UIStroke")
	local emptyStroke = empty and empty:FindFirstChildOfClass("UIStroke")
	local questionMark = empty and empty:FindFirstChild("QuestionMark", true) :: TextLabel?

	local teamColor = if teamName == "Red"
		then Color3.fromRGB(235, 65, 80)
		else Color3.fromRGB(65, 140, 245)

	-- Creación defensiva de NameLabel si no existe en el template
	if not nameLabel then
		local newLabel = Instance.new("TextLabel")
		newLabel.Name = "NameLabel"
		newLabel.Size = UDim2.new(1.3, 0, 0, 16)
		newLabel.Position = UDim2.new(0.5, 0, 0, -4)
		newLabel.AnchorPoint = Vector2.new(0.5, 1)
		newLabel.BackgroundTransparency = 1
		newLabel.Font = Enum.Font.GothamBold
		newLabel.TextScaled = true
		newLabel.ZIndex = 5

		local tc = Instance.new("UITextSizeConstraint")
		tc.MaxTextSize = 14
		tc.MinTextSize = 9
		tc.Parent = newLabel

		local st = Instance.new("UIStroke")
		st.Color = Color3.fromRGB(0, 0, 0)
		st.Thickness = 1.2
		st.Transparency = 0.2
		st.Parent = newLabel

		newLabel.Parent = slot
		nameLabel = newLabel
	end

	-- Creación defensiva de QuestionMark en Empty si no existe
	if empty and not questionMark then
		local qm = Instance.new("TextLabel")
		qm.Name = "QuestionMark"
		qm.Size = UDim2.new(0.6, 0, 0.6, 0)
		qm.Position = UDim2.new(0.5, 0, 0.5, 0)
		qm.AnchorPoint = Vector2.new(0.5, 0.5)
		qm.BackgroundTransparency = 1
		qm.Font = Enum.Font.GothamBold
		qm.Text = "?"
		qm.TextColor3 = Color3.fromRGB(80, 95, 125)
		qm.TextScaled = true
		qm.ZIndex = 3
		qm.Parent = empty
		questionMark = qm
	end

	if player then
		if occupied then occupied.Visible = true end
		if empty then empty.Visible = false end

		local pDisplayName = if player.DisplayName and player.DisplayName ~= "" then player.DisplayName else player.Name
		local pUsername = "@" .. player.Name

		-- Nombre visible encima del recuadro
		if nameLabel then
			nameLabel.Text = pDisplayName
			nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
			nameLabel.Visible = true
		end

		if displayName then
			displayName.Text = pDisplayName
			displayName.Visible = false -- Nombre principal está arriba del recuadro
		end

		if username then
			username.Text = pUsername
			username.Visible = false
		end

		if avatarImg then
			-- Avatar real del jugador mediante thumbnail oficial de Roblox
			avatarImg.Image = string.format("rbxthumb://type=AvatarBust&id=%d&w=150&h=150", player.UserId)
			avatarImg.Visible = true
		end

		if occupiedStroke then
			occupiedStroke.Color = teamColor
			occupiedStroke.Thickness = 1.5
		end
	else
		-- Estado cuando todavía no hay rival o slot vacío
		if occupied then occupied.Visible = false end
		if empty then empty.Visible = true end

		if nameLabel then
			nameLabel.Text = "ESPERANDO..."
			nameLabel.TextColor3 = Color3.fromRGB(130, 145, 175)
			nameLabel.Visible = true
		end

		if displayName then
			displayName.Text = "ESPERANDO..."
			displayName.TextColor3 = Color3.fromRGB(130, 145, 175)
			displayName.Visible = false
		end

		if username then
			username.Visible = false
		end

		if avatarImg then
			avatarImg.Visible = false
		end

		if questionMark then
			questionMark.Text = "?"
			questionMark.Visible = true
		end

		local spinner = empty and empty:FindFirstChild("Spinner")
		if spinner then
			spinner.Visible = false
		end

		if emptyStroke then
			emptyStroke.Color = Color3.fromRGB(45, 55, 75)
			emptyStroke.Thickness = 1
		end
	end

	slot.Visible = true
	return slot
end

return MatchmakingController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="4288">
          <Properties>
            <string name="Name">MusicController</string>
            <string name="Source"><![CDATA[--!strict
-- MusicController
-- Controlador centralizado y exclusivo de la música de fondo LOCAL del jugador.
-- La música es 100% cliente, no replicada, y completamente independiente de los SFX, UI y Combat Sounds.

local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local Config = require(game.ReplicatedStorage.Shared.Config)
local Players = game:GetService("Players")

export type MusicState = "None" | "Lobby" | "Matchmaking" | "Arena" | "SuddenDeath" | "Victory" | "Defeat" | "Draw"

local MusicController = {}
MusicController.Name = "MusicController"

-- Configuración de Usuario (Local)
MusicController._musicEnabled = true
MusicController._userMusicVolume = 1.0

-- Estado de Reproducción
MusicController._suddenDeathActive = false
MusicController._currentState = "None" :: MusicState
MusicController._currentMapName = nil :: string?
MusicController._currentSound = nil :: Sound?
MusicController._baseVolumes = {} :: { [Sound]: number }
MusicController._activeTweens = {} :: { [Sound]: Tween }
MusicController._transitionToken = 0
MusicController._context = nil :: any

-- Suspensiones Locales de Música
MusicController._suspensions = {} :: { [string]: { Token: number, PreviousState: MusicState, PreviousMap: string?, PreviousSound: Sound? } }
MusicController._suspensionTokenCounter = 0
MusicController._pendingMusicState = nil :: { State: MusicState, MapName: string?, FadeDuration: number? }?

-- Parámetros de Fade
local DEFAULT_FADE_DURATION = 0.8
local FADE_EASING_STYLE = Enum.EasingStyle.Quad
local FADE_EASING_DIR = Enum.EasingDirection.Out

--------------------------------------------------------------------------------
-- Helpers Internos de Jerarquía en SoundService
--------------------------------------------------------------------------------

function MusicController:_getMusicFolder(): Folder?
	local musicFolder = SoundService:FindFirstChild("Music")
	if musicFolder and musicFolder:IsA("Folder") then
		return musicFolder
	end
	return nil
end

function MusicController:_getArenasFolder(): Folder?
	local musicFolder = self:_getMusicFolder()
	if not musicFolder then return nil end
	local arenasFolder = musicFolder:FindFirstChild("Arenas")
	if arenasFolder and arenasFolder:IsA("Folder") then
		return arenasFolder
	end
	return nil
end

function MusicController:_registerSound(sound: Instance)
	if sound:IsA("Sound") then
		if self._baseVolumes[sound] == nil then
			-- Almacenar el volumen original de Studio como referencia inmutable
			local baseVol = sound.Volume
			if baseVol <= 0 then
				baseVol = 0.35
			end
			self._baseVolumes[sound] = baseVol
		end
	end
end

function MusicController:_cacheAllSounds()
	local musicFolder = self:_getMusicFolder()
	if not musicFolder then return end

	for _, desc in ipairs(musicFolder:GetDescendants()) do
		self:_registerSound(desc)
	end

	musicFolder.DescendantAdded:Connect(function(desc)
		self:_registerSound(desc)
	end)
end

function MusicController:_getSoundInstance(name: string): Sound?
	local musicFolder = self:_getMusicFolder()
	if not musicFolder then return nil end
	local sound = musicFolder:FindFirstChild(name)
	if sound and sound:IsA("Sound") then
		self:_registerSound(sound)
		return sound
	end
	return nil
end

function MusicController:_getArenaSound(mapName: string): Sound?
	local arenasFolder = self:_getArenasFolder()
	if not arenasFolder then return nil end

	-- 1. Coincidencia exacta con el nombre del mapa
	local sound = arenasFolder:FindFirstChild(mapName)
	if sound and sound:IsA("Sound") then
		self:_registerSound(sound)
		return sound
	end

	-- 2. Fallback opcional a "ArenaDefault" o "Default"
	local fallback = arenasFolder:FindFirstChild("ArenaDefault") or arenasFolder:FindFirstChild("Default")
	if fallback and fallback:IsA("Sound") then
		self:_registerSound(fallback)
		return fallback
	end

	return nil
end

--------------------------------------------------------------------------------
-- Cálculo de Volumen
--------------------------------------------------------------------------------

function MusicController:_getTargetVolume(sound: Sound): number
	if not self._musicEnabled then
		return 0
	end

	local baseVolume = self._baseVolumes[sound] or sound.Volume
	local userVol = math.clamp(self._userMusicVolume, 0, 1)
	return baseVolume * userVol
end

--------------------------------------------------------------------------------
-- Transiciones y Cross-Fade
--------------------------------------------------------------------------------

function MusicController:_cancelTweenForSound(sound: Sound)
	local active = self._activeTweens[sound]
	if active then
		active:Cancel()
		active:Destroy()
		self._activeTweens[sound] = nil
	end
end

function MusicController:_getAllManagedSounds(): { Sound }
	local sounds: { Sound } = {}
	local musicFolder = self:_getMusicFolder()
	if musicFolder then
		for _, desc in ipairs(musicFolder:GetDescendants()) do
			if desc:IsA("Sound") then
				table.insert(sounds, desc)
			end
		end
	end
	return sounds
end

function MusicController:_transitionTo(newSound: Sound?, newState: MusicState, fadeDuration: number?)
	local duration = fadeDuration or DEFAULT_FADE_DURATION

	self._transitionToken += 1
	local thisToken = self._transitionToken

	self._currentState = newState
	self._currentSound = newSound

	-- 1. Fade Out de todos los sonidos activos que NO sean el nuevo sonido
	for _, sound in ipairs(self:_getAllManagedSounds()) do
		if sound ~= newSound then
			self:_cancelTweenForSound(sound)

			if sound.IsPlaying or sound.Volume > 0 then
				if duration > 0 then
					local tweenInfo = TweenInfo.new(duration, FADE_EASING_STYLE, FADE_EASING_DIR)
					local fadeOutTween = TweenService:Create(sound, tweenInfo, { Volume = 0 })
					self._activeTweens[sound] = fadeOutTween

					fadeOutTween.Completed:Connect(function()
						if self._activeTweens[sound] == fadeOutTween then
							self._activeTweens[sound] = nil
						end
						if self._transitionToken == thisToken and sound ~= self._currentSound then
							pcall(function()
								sound:Stop()
							end)
						end
						fadeOutTween:Destroy()
					end)

					fadeOutTween:Play()
				else
					sound.Volume = 0
					pcall(function()
						sound:Stop()
					end)
				end
			end
		end
	end

	-- 2. Fade In del nuevo sonido si existe
	if newSound then
		self:_cancelTweenForSound(newSound)

		local targetVol = self:_getTargetVolume(newSound)

		if self._musicEnabled and targetVol > 0 then
			newSound.Looped = true
			if not newSound.IsPlaying then
				newSound.Volume = 0
				pcall(function()
					newSound:Play()
				end)
			end

			if duration > 0 then
				local tweenInfo = TweenInfo.new(duration, FADE_EASING_STYLE, FADE_EASING_DIR)
				local fadeInTween = TweenService:Create(newSound, tweenInfo, { Volume = targetVol })
				self._activeTweens[newSound] = fadeInTween

				fadeInTween.Completed:Connect(function()
					if self._activeTweens[newSound] == fadeInTween then
						self._activeTweens[newSound] = nil
					end
					fadeInTween:Destroy()
				end)

				fadeInTween:Play()
			else
				newSound.Volume = targetVol
			end
		else
			-- Música deshabilitada o target volume = 0
			newSound.Volume = 0
			if newSound.IsPlaying then
				pcall(function()
					newSound:Stop()
				end)
			end
		end
	end
end

--------------------------------------------------------------------------------
-- API Pública
--------------------------------------------------------------------------------
-- API Pública y Gestión de Suspensión
--------------------------------------------------------------------------------

function MusicController:_getMatchController()
	if self._context and typeof(self._context.GetController) == "function" then
		return self._context:GetController("MatchController")
	end
	local controllers = script.Parent
	local matchScript = controllers and controllers:FindFirstChild("MatchController")
	if matchScript and matchScript:IsA("ModuleScript") then
		local ok, mod = pcall(require, matchScript)
		if ok then return mod end
	end
	return nil
end

function MusicController:_getMatchmakingController()
	if self._context and typeof(self._context.GetController) == "function" then
		return self._context:GetController("MatchmakingController")
	end
	local controllers = script.Parent
	local mmScript = controllers and controllers:FindFirstChild("MatchmakingController")
	if mmScript and mmScript:IsA("ModuleScript") then
		local ok, mod = pcall(require, mmScript)
		if ok then return mod end
	end
	return nil
end

function MusicController:IsSuspended(reason: string?): boolean
	if reason then
		return self._suspensions[reason] ~= nil
	end
	for _ in pairs(self._suspensions) do
		return true
	end
	return false
end

function MusicController:Suspend(reason: string?, fadeDuration: number?): number
	local r = reason or "Default"
	self._suspensionTokenCounter += 1
	local token = self._suspensionTokenCounter

	local record = self._suspensions[r]
	if not record then
		self._suspensions[r] = {
			Token = token,
			PreviousState = self._currentState,
			PreviousMap = self._currentMapName,
			PreviousSound = self._currentSound,
		}
	else
		record.Token = token
	end

	local duration = if fadeDuration ~= nil then fadeDuration else 0.4
	self:_transitionTo(nil, "None", duration)
	print(string.format("[MusicController] Música suspendida por '%s' (Token=%d, Fade=%.2fs)", r, token, duration))
	return token
end

function MusicController:Resume(reason: string?, token: number?, restoreFadeDuration: number?): boolean
	local r = reason or "Default"
	local record = self._suspensions[r]
	if not record then
		return false
	end

	if token ~= nil and record.Token ~= token then
		-- Token desactualizado: pertenece a una ejecución anterior ya superada
		return false
	end

	local previousState = record.PreviousState
	local previousMap = record.PreviousMap
	self._suspensions[r] = nil
	print(string.format("[MusicController] Suspensión '%s' liberada", r))

	if self:IsSuspended() then
		return true
	end

	local duration = if restoreFadeDuration ~= nil then restoreFadeDuration else 0.6
	local pending = self._pendingMusicState
	self._pendingMusicState = nil

	if pending and pending.State ~= "None" then
		local pDuration = pending.FadeDuration or duration
		if pending.State == "Lobby" then
			self:PlayLobby(pDuration)
		elseif pending.State == "Matchmaking" then
			self:PlayMatchmaking(pDuration)
		elseif pending.State == "Arena" and pending.MapName then
			self:PlayArena(pending.MapName, pDuration)
		end
	elseif r == "EndCinematicPreview" then
		if previousState == "Lobby" then
			self:PlayLobby(duration)
		elseif previousState == "Matchmaking" then
			self:PlayMatchmaking(duration)
		elseif (previousState == "Arena" or previousState == "SuddenDeath") and previousMap then
			self:PlayArena(previousMap, duration)
		else
			self:Stop(duration)
		end
	else
		local inMatch = false
		local matchController = self:_getMatchController()
		if matchController and typeof(matchController.IsParticipant) == "function" then
			inMatch = matchController:IsParticipant()
		end
		if Players.LocalPlayer and Players.LocalPlayer:GetAttribute("MatchId") ~= nil then
			inMatch = true
		end

		local mmController = self:_getMatchmakingController()
		local inQueue = mmController and typeof(mmController.IsInQueue) == "function" and mmController:IsInQueue()

		if inMatch then
			local selectedMap = matchController and matchController:GetCurrentSelectedMap() or "Default"
			self:PlayArena(selectedMap, duration)
		elseif inQueue then
			self:PlayMatchmaking(duration)
		else
			self:PlayLobby(duration)
		end
	end

	return true
end

-- Shares the existing music mixer, preferences and cinematic suspension priority.
function MusicController:_playSuddenDeath(fadeDuration: number?): boolean
 if self:IsSuspended() then return false end
 local sound=self:_getSoundInstance(Config.SuddenDeathPresentation.MusicSoundName)
 if not sound or sound.SoundId=="" then
  if not self._suddenAudioWarning then warn("[MusicController] Authorized SuddenDeath SoundId missing; arena music retained");self._suddenAudioWarning=true end
  return false
 end
 if self._currentState~="SuddenDeath" or self._currentSound~=sound or not sound.IsPlaying then
  self:_transitionTo(sound,"SuddenDeath",fadeDuration)
 end
 return true
end
function MusicController:SetSuddenDeath(active: boolean,mapName: string?,restoreArena: boolean?)
 self._suddenDeathActive=active
 if mapName then self._currentMapName=mapName end
 if self:IsSuspended() then return end
 if active then
  self:_playSuddenDeath(Config.SuddenDeathPresentation.TransitionDuration)
 elseif restoreArena and self._currentMapName then
  self:PlayArena(self._currentMapName,Config.SuddenDeathPresentation.TransitionDuration)
 end
end

function MusicController:PlayLobby(fadeDuration: number?)
	self._suddenDeathActive=false
	if self:IsSuspended() then
		self._pendingMusicState = { State = "Lobby", MapName = nil, FadeDuration = fadeDuration }
		print("[MusicController] PlayLobby recibido durante suspensión; encolado")
		return
	end

	local lobbySound = self:_getSoundInstance("Lobby")
	if self._currentState == "Lobby" and self._currentSound == lobbySound and lobbySound and lobbySound.IsPlaying then
		return
	end

	self._currentMapName = nil
	self:_transitionTo(lobbySound, "Lobby", fadeDuration)
	print("[MusicController] Reproduciendo música de Lobby")
end

function MusicController:PlayMatchmaking(fadeDuration: number?)
	self._suddenDeathActive=false
	if self:IsSuspended() then
		self._pendingMusicState = { State = "Matchmaking", MapName = nil, FadeDuration = fadeDuration }
		print("[MusicController] PlayMatchmaking recibido durante suspensión; encolado")
		return
	end

	local mmSound = self:_getSoundInstance("Matchmaking")
	if self._currentState == "Matchmaking" and self._currentSound == mmSound and mmSound and mmSound.IsPlaying then
		return
	end

	self._currentMapName = nil
	self:_transitionTo(mmSound, "Matchmaking", fadeDuration)
	print("[MusicController] Reproduciendo música de Matchmaking")
end

function MusicController:PlayArena(mapName: string, fadeDuration: number?)
	if self:IsSuspended() then
		self._pendingMusicState = { State = "Arena", MapName = mapName, FadeDuration = fadeDuration }
		print(string.format("[MusicController] PlayArena(%s) recibido durante suspensión; encolado", mapName))
		return
	end

	self._currentMapName=mapName
	if self._suddenDeathActive and self:_playSuddenDeath(fadeDuration) then return end
	local arenaSound = self:_getArenaSound(mapName)
	if self._currentState == "Arena" and self._currentMapName == mapName and self._currentSound == arenaSound and arenaSound and arenaSound.IsPlaying then
		return
	end

	self._currentMapName = mapName
	if not arenaSound then
		warn(string.format("[MusicController] No se encontro musica para la arena '%s'. Permaneciendo en silencio.", mapName))
		self:_transitionTo(nil, "Arena", fadeDuration)
		return
	end

	self:_transitionTo(arenaSound, "Arena", fadeDuration)
	print(string.format("[MusicController] Reproduciendo música de Arena: %s", mapName))
end

function MusicController:Stop(fadeDuration: number?)
	if self:IsSuspended() then
		self._pendingMusicState = { State = "None", MapName = nil, FadeDuration = fadeDuration }
		return
	end

	self._currentMapName = nil
	self:_transitionTo(nil, "None", fadeDuration)
	print("[MusicController] Música detenida")
end

function MusicController:SetMusicEnabled(enabled: boolean, fadeDuration: number?)
	if self._musicEnabled == enabled then return end
	self._musicEnabled = enabled
	print(string.format("[MusicController] MusicEnabled establecido en %s", tostring(enabled)))

	if self:IsSuspended() then
		return
	end

	local duration = if fadeDuration ~= nil then fadeDuration else 0.4

	if not enabled then
		-- Desvanecer suavemente la pista actual a 0 y pausar
		if self._currentSound and self._currentSound.IsPlaying then
			self:_cancelTweenForSound(self._currentSound)
			if duration > 0 then
				local tweenInfo = TweenInfo.new(duration, FADE_EASING_STYLE, FADE_EASING_DIR)
				local muteTween = TweenService:Create(self._currentSound, tweenInfo, { Volume = 0 })
				self._activeTweens[self._currentSound] = muteTween
				local soundRef = self._currentSound
				muteTween.Completed:Connect(function()
					if self._activeTweens[soundRef] == muteTween then
						self._activeTweens[soundRef] = nil
					end
					if not self._musicEnabled and soundRef then
						soundRef:Stop()
					end
					muteTween:Destroy()
				end)
				muteTween:Play()
			else
				self._currentSound.Volume = 0
				self._currentSound:Stop()
			end
		end
	else
		-- Reanudar o fade in hacia el volumen objetivo
		if self._currentSound then
			local targetVol = self:_getTargetVolume(self._currentSound)
			if targetVol > 0 then
				if not self._currentSound.IsPlaying then
					self._currentSound.Volume = 0
					self._currentSound:Play()
				end
				self:_cancelTweenForSound(self._currentSound)
				if duration > 0 then
					local tweenInfo = TweenInfo.new(duration, FADE_EASING_STYLE, FADE_EASING_DIR)
					local resumeTween = TweenService:Create(self._currentSound, tweenInfo, { Volume = targetVol })
					self._activeTweens[self._currentSound] = resumeTween
					local soundRef = self._currentSound
					resumeTween.Completed:Connect(function()
						if self._activeTweens[soundRef] == resumeTween then
							self._activeTweens[soundRef] = nil
						end
						resumeTween:Destroy()
					end)
					resumeTween:Play()
				else
					self._currentSound.Volume = targetVol
				end
			end
		else
			-- Si no había un track reproduciendo, volver al estado actual
			if self._currentState == "Lobby" then
				self:PlayLobby(duration)
			elseif self._currentState == "Matchmaking" then
				self:PlayMatchmaking(duration)
			elseif self._currentState == "SuddenDeath" then
				self:_playSuddenDeath(duration)
			elseif self._currentState == "Arena" and self._currentMapName then
				self:PlayArena(self._currentMapName, duration)
			end
		end
	end
end

function MusicController:SetMusicVolume(volume: number, fadeDuration: number?)
	local clamped = math.clamp(volume, 0, 1)
	self._userMusicVolume = clamped
	print(string.format("[MusicController] MusicVolume establecido en %.2f", clamped))

	local duration = if fadeDuration ~= nil then fadeDuration else 0.2

	if self._currentSound and self._currentSound.IsPlaying and self._musicEnabled then
		local targetVol = self:_getTargetVolume(self._currentSound)
		self:_cancelTweenForSound(self._currentSound)
		if duration > 0 then
			local tweenInfo = TweenInfo.new(duration, FADE_EASING_STYLE, FADE_EASING_DIR)
			local volTween = TweenService:Create(self._currentSound, tweenInfo, { Volume = targetVol })
			self._activeTweens[self._currentSound] = volTween
			local soundRef = self._currentSound
			volTween.Completed:Connect(function()
				if self._activeTweens[soundRef] == volTween then
					self._activeTweens[soundRef] = nil
				end
				volTween:Destroy()
			end)
			volTween:Play()
		else
			self._currentSound.Volume = targetVol
		end
	end
end

function MusicController:GetCurrentState(): string
	return self._currentState
end

function MusicController:GetCurrentMapName(): string?
	return self._currentMapName
end

function MusicController:IsMusicEnabled(): boolean
	return self._musicEnabled
end

function MusicController:GetMusicVolume(): number
	return self._userMusicVolume
end

function MusicController:GetCurrentSound(): Sound?
	return self._currentSound
end

--------------------------------------------------------------------------------
-- Ciclo de Vida Bootstrap
--------------------------------------------------------------------------------

function MusicController:Init(context: any)
	self._context = context
	self._suspensions = {}
	self._suspensionTokenCounter = 0
	self._pendingMusicState = nil
	self:_cacheAllSounds()
	print("[MusicController] Inicializado exitosamente")
end

function MusicController:Start(context: any)
	self._context = context

	-- Sincronización inicial segura
	local matchController = context and context:GetController("MatchController")
	local mmController = context and context:GetController("MatchmakingController")

	local inMatch = matchController and typeof(matchController.IsParticipant) == "function" and matchController:IsParticipant()
	local inQueue = mmController and typeof(mmController.IsInQueue) == "function" and mmController:IsInQueue()

	if inMatch then
		local selectedMap = matchController:GetCurrentSelectedMap() or "Default"
		self:PlayArena(selectedMap)
	elseif inQueue then
		self:PlayMatchmaking()
	else
		-- Estado predeterminado al entrar al juego
		self:PlayLobby()
	end

	print(string.format("[MusicController] Iniciado en estado: %s", self._currentState))
end

return MusicController
