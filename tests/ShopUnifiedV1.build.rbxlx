        <Properties>
          <string name="Name">ProgressionService</string>
          <string name="Source"><![CDATA[--!nonstrict
local Players=game:GetService('Players')
local RS=game:GetService('ReplicatedStorage')
local Run=game:GetService('RunService')
local Http=game:GetService('HttpService')
local M=require(RS.Shared.Progression.Model)
local Config=require(RS.Shared.Progression.Config)
local Catalog=require(RS.Shared.Progression.PassCatalog)
local Slaps=require(RS.Shared.SlapCrates.Catalog)
local SeasonState=require(script.Parent.Gameplay.SeasonState)
local Service={Name='ProgressionService'}
local KEY='Progression:Season:Studio:v1'
local function ensure(parent,name,class)
 local o=parent:FindFirstChild(name);if o then assert(o:IsA(class),'Progression class conflict');return o end
 o=Instance.new(class);o.Name=name;o.Parent=parent;return o
end
function Service:Init(context)
 self.Context=context;self.Sessions={};self.Connections={};self.Rate={};self.Challenges={};self.Season={Revision=0};self.SeasonAvailable=false
 local info=context.PersistenceInfo
 self.Enabled=Run:IsStudio()and info and info.Environment=='Studio'and info.ProviderName=='InMemory'and info.WritesToCloud==false
 self.Production=not Run:IsStudio()and Config.ProductionEnabled==true and info and info.Environment=='Production'and info.ProviderName=='RobloxDataStore'and info.WritesToCloud==true and info.GameId==10769217377
 self.Enabled=self.Enabled or self.Production
 self.SeasonKey=self.Production and 'Progression:Season:Production:v1'or KEY
 self.Store=self.Enabled and context.PersistenceProvider or nil
 local folder=ensure(ensure(RS,'Remotes','Folder'),'Progression','Folder')
 self.Remote=ensure(folder,'Request','RemoteFunction');self.Changed=ensure(folder,'Changed','RemoteEvent')
end
function Service:ReadSeason()
 if not self.Enabled then return false end
 local ok,row=pcall(self.Store.GetAsync,self.Store,self.SeasonKey or KEY,true)
 if not ok or row~=nil and not SeasonState.Valid(row)then self.SeasonAvailable=false;return false end
 self.Season=row or {Revision=0};self.SeasonAvailable=true;return true
end
function Service:Snapshot(player)
 local ps=self.Context:GetService('PlayerService');local data=ps:GetPlayerData(player);local p=M.Normalize(data.Progression)
 local level,current,cost=M.Level(p.TotalXP)
 local season=self.SeasonAvailable and self.Season.Active or nil;local active=M.Active(season,os.time())
 local edition=season and p.Edition and p.Edition.Id==season.Id and p.Edition or nil
 return {Ok=true,Enabled=self.Enabled==true,Reason=not self.Enabled and 'StudioOnlyPendingProductionValidation'or not self.SeasonAvailable and 'SeasonUnavailable'or nil,
  TotalXP=p.TotalXP,Level=level,LevelXP=current,LevelCost=cost,Season=M.Copy(season),Revision=self.Season.Revision,
  Active=active,PassXP=edition and edition.XP or 0,Stage=season and M.Stage(p,season)or 0,Claimed=edition and M.Copy(edition.Claimed)or {},ServerTime=workspace:GetServerTimeNow(),PremiumEnabled=false}
end
function Service:Push(player,receipt)
 if player.Parent==Players then self.Changed:FireClient(player,self:Snapshot(player),receipt)end
end
function Service:StateChanged(session,old,new)
 if not self.Enabled then return end
 local track=self.Sessions[session.Id]
 if not track and new=='Playing'then
  local active=self.SeasonAvailable and self.Season.Active
  track={StartedAt=os.time(),EditionId=M.Active(active,os.time())and active.Id or nil,Playing=0,Attacks={}}
  self.Sessions[session.Id]=track
 end
 if not track then return end
 if old=='Playing'and track.Since then track.Playing+=math.max(0,os.clock()-track.Since);track.Since=nil end
 if new=='Playing'then track.Since=os.clock()end
end
function Service:AcceptedAttack(session,player)
 if not self.Enabled or session.State~='Playing'then return end
 local t=self.Sessions[session.Id];if not t then return end
 local a=t.Attacks[player.UserId]or {};t.Attacks[player.UserId]=a
 a.First=a.First or os.clock();a.Last=os.clock()
end
function Service:Settle(session,result)
 local t=self.Sessions[session.Id];if not self.Enabled or not t then return end
 if t.Since then t.Playing+=math.max(0,os.clock()-t.Since);t.Since=nil end
 if not self:ReadSeason()then error('ProgressionSeasonUnavailable')end
 local season=self.SeasonAvailable and self.Season.Active or nil
 local ps=self.Context:GetService('PlayerService')
 for _,part in ipairs(session.Participants)do
  local player=part.Player
  if player.Parent==Players and ps:IsShopDataReady(player)then
   local stats=part.MatchStats or {};local a=t.Attacks[part.UserId]or {}
   local match={Id=session.Id,StartedAt=t.StartedAt,EditionId=t.EditionId,Playing=t.Playing,FirstAttack=a.First,LastAttack=a.Last,
    Goals=stats.Goals or 0,Kills=stats.Kills or 0,Connected=true,Left=part.State=='Left'or part.State=='Released',Cancelled=session.Cancelled or result=='Cancelled',Won=part.Team==result}
   local current=ps._data[player];local nextP,receipt,applied=M.Award(current.Progression,match,season,os.time())
   if applied then
    local nextData=M.Copy(current);nextData.Progression=nextP
    if ps:CommitProgression(player,current,nextData)then self:Push(player,receipt)end
   elseif receipt.Code=='Ineligible'and not match.Left then
    self:Push(player,receipt)
   end
  end
 end
 self.Sessions[session.Id]=nil
end
function Service:Forget(sessionId)self.Sessions[sessionId]=nil end
function Service:HasReward(reward)
 if not reward then return false end
 if reward.Kind=='Coins'then return M.Integer(reward.Amount)and reward.Amount>0 end
 if reward.Kind=='Slap'then local definition=Slaps.Rewards[reward.Id];return definition~=nil and self.Context:GetService('CrateService'):GetRewardTemplate(definition)~=nil end
 if reward.Kind=='Effect'then
  if reward.Category~='PointEffects'and reward.Category~='DeathEffects'then return false end
  local root=game.ServerStorage:FindFirstChild(reward.Category);return root~=nil and root:FindFirstChild(reward.Id)~=nil
 end
 return false
end
function Service:Claim(player,stage,all)
 if not self:ReadSeason()then return {Ok=false,Reason='SeasonUnavailable'}end
 local ps=self.Context:GetService('PlayerService');local shop=self.Context:GetService('ShopService')
 local response
 local locked,reason=shop:_withShopLock(player,function()
  if not ps:IsShopDataReady(player)or player:GetAttribute('MatchId')or player:GetAttribute('ResultsSessionId')then return false,'LobbyOnly'end
  local season=self.Season.Active;local now=os.time()
  if not M.Active(season,now)then return false,'SeasonExpired'end
  local current=ps._data[player];local nextData=M.Copy(current);local granted={}
  local first,last=if all then 1 else stage,if all then season.Stages else stage
  if not M.Integer(first)or first<1 or first>season.Stages then return false,'InvalidStage'end
  for i=first,last do
   local reward=season.Rewards[i]
   if not self:HasReward(reward)then return false,'RewardMissing'end
   local staged,delivery=M.Claim(nextData,season,now,i,player.UserId,Slaps)
   if staged then nextData=staged;table.insert(granted,{Stage=i,Reward=delivery})
   elseif not all or(delivery~='AlreadyClaimed'and delivery~='StageLocked')then return false,delivery end
  end
  if #granted==0 then return false,'NothingToClaim'end
  local committed,why=ps:CommitProgression(player,current,nextData)
  if not committed then return false,why or 'ProfileChanged'end
  response={Ok=true,Granted=granted};return true
 end)
 if not locked then return {Ok=false,Reason=reason}end
 self:Push(player);return response
end
function Service:Admin(player,action,args)
 local admin=self.Context:GetService('AdminService')
 if not admin or not admin:IsAdmin(player)then return {Ok=false,Reason='Forbidden'}end
 if not self:ReadSeason()then return {Ok=false,Reason='SeasonUnavailable'}end
 if action=='AdminInfo'then
  local rows={};for _,id in ipairs(Catalog.Order)do local d=Catalog.ById[id];if not self.Production or not d.StudioOnly then table.insert(rows,{Id=id,DisplayName=d.DisplayName})end end
  return {Ok=true,Presets=rows,Revision=self.Season.Revision,Season=self.Season.Active}
 end
 if action=='Prepare'then
  local command=args.Command;local definition=Catalog.ById[args.PresetId]
  if self.Production and command~='End'and definition and definition.StudioOnly then return {Ok=false,Reason='StudioCatalogOnly'}end
  if command~='Start'and command~='Restart'and command~='End'then return {Ok=false,Reason='InvalidCommand'}end
  if command~='End'and(not definition or not M.Integer(args.Days)or args.Days<1 or args.Days>365)then return {Ok=false,Reason='InvalidDuration'}end
  if command~='End'then for i=1,definition.Stages do if not self:HasReward(definition.Rewards[i])then return {Ok=false,Reason='RewardMissing',Stage=i}end end end
  if command=='Start'and M.Active(self.Season.Active,os.time())then return {Ok=false,Reason='SeasonAlreadyActive'}end
  local token=Http:GenerateGUID(false)
  self.Challenges[player]={Token=token,Command=command,PresetId=args.PresetId,Days=args.Days,Revision=self.Season.Revision,Until=os.clock()+30,Operation=Http:GenerateGUID(false),Edition=Http:GenerateGUID(false)}
  return {Ok=true,Token=token,Warning=command=='Start'and(self.Production and 'Iniciar temporada global persistente en esta experiencia.'or 'Iniciar temporada para todos los jugadores del entorno de prueba.')or 'Se perderán EXP del pase y premios pendientes. Se conservan nivel y premios entregados.'}
 end
 local c=self.Challenges[player]
 if action~='Apply'or not c or c.Token~=args.Token or os.clock()>c.Until then return {Ok=false,Reason='ConfirmationExpired'}end
 local row,why;local ok,err=pcall(function()
  row=self.Store:UpdateAsync(self.SeasonKey or KEY,function(old)
   local nextRow,reason=SeasonState.Apply(old,c.Revision,c.Command,Catalog.ById[c.PresetId],c.Days,c.Edition,c.Operation,os.time(),player.UserId);why=reason;return nextRow
  end)
 end)
 if not ok or not row then return {Ok=false,Reason=ok and why or 'SeasonWriteUnconfirmed'}end
 if row.LastOperation~=c.Operation then return {Ok=false,Reason='SeasonChanged'}end
 self.Season=row;self.SeasonAvailable=true
 print('[ProgressionAdmin] '..Http:JSONEncode({Actor=player.UserId,Command=c.Command,Revision=row.Revision,Edition=row.Active and row.Active.Id,Environment=self.Production and 'Production'or 'Studio'}))
 for _,p in ipairs(Players:GetPlayers())do self:Push(p)end
 return {Ok=true,Reason='SeasonUpdated',Revision=row.Revision}
end
function Service:Request(player,action,args)
 if not self.Enabled then return {Ok=false,Reason='StudioOnlyPendingProductionValidation'}end
 if type(action)~='string'or type(args)~='table'then return {Ok=false,Reason='InvalidRequest'}end
 local now=os.clock();if now-(self.Rate[player]or -math.huge)<.3 then return {Ok=false,Reason='RateLimited'}end;self.Rate[player]=now
 if action=='Snapshot'then return self:Snapshot(player)end
 if action=='Claim'or action=='ClaimAll'then return self:Claim(player,args.Stage,action=='ClaimAll')end
 return self:Admin(player,action,args)
end
function Service:StartStudioSeason()
 local info=self.Context.PersistenceInfo;local setting=Config.StudioAutoSeason
 if not Run:IsStudio()or not self.Enabled or not info or info.Environment~='Studio'or info.ProviderName~='InMemory'or info.WritesToCloud~=false then return false,'EnvironmentBlocked'end
 if not setting or setting.Enabled~=true then return false,'Disabled'end
 if not self:ReadSeason()then return false,'SeasonUnavailable'end
 -- Seed only a fresh store. Never undo an admin end/reset or replace an edition.
 if self.Season.Revision~=0 or self.Season.Active~=nil then return false,'ExistingSeasonState'end
 local definition=Catalog.ById[setting.PresetId]
 if not definition or definition.StudioOnly~=true or not M.Integer(setting.Days)or setting.Days<1 or setting.Days>365 then return false,'InvalidStudioSeasonConfig'end
 for i=1,definition.Stages do if not self:HasReward(definition.Rewards[i])then return false,'RewardMissing'end end
 local edition='Studio:'..Http:GenerateGUID(false);local operation=Http:GenerateGUID(false)
 local ok,row=pcall(self.Store.UpdateAsync,self.Store,KEY,function(old)
  if old~=nil and(not SeasonState.Valid(old)or old.Revision~=0 or old.Active~=nil)then return nil end
  return SeasonState.Apply(old,0,'Start',definition,setting.Days,edition,operation,os.time(),0)
 end)
 if not ok or not row or row.LastOperation~=operation then return false,'StudioSeasonUnconfirmed'end
 self.Season=row;self.SeasonAvailable=true
 print('[Progression] Studio season auto-started: '..definition.Id..' / InMemory / WritesToCloud=false')
 return true,'Started'
end
function Service:Start()
 self.Remote.OnServerInvoke=function(p,a,args)
  local ok,result=pcall(self.Request,self,p,a,args);if not ok then warn('[Progression] '..tostring(result));return {Ok=false,Reason='RequestFailed'}end;return result
 end
 if not self.Enabled then print('[Progression] Disabled in unapproved environment');return end
 local _,reason=self:StartStudioSeason()
 if not self.Production and reason~='Started'and reason~='Disabled'and reason~='ExistingSeasonState'then warn('[Progression] Studio auto-season: '..reason)end
 self:ReadSeason()
 table.insert(self.Connections,Players.PlayerRemoving:Connect(function(p)self.Rate[p]=nil;self.Challenges[p]=nil end))
 task.spawn(function()while self.Enabled do task.wait(self.Production and(15+math.random()*5)or 5);if self:ReadSeason()then for _,p in ipairs(Players:GetPlayers())do self:Push(p)end end end end)
 print(self.Production and '[Progression] Ready: Production / RobloxDataStore / WritesToCloud=true; activation by admin only; Premium disabled'or '[Progression] Ready: Studio / InMemory / WritesToCloud=false; Premium disabled')
end
return Service
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="991">
        <Properties>
          <string name="Name">RagdollService</string>
          <string name="Source"><![CDATA[--!strict
-- RagdollService
-- Servicio central para el ciclo de vida de Ragdoll y física de impacto/lanzamiento.
-- Coordina ReplicatedStorage.StateEvent y StarterCharacterScripts.RagdollStatesHandler.
-- Soporta avatares R15 modernos (AnimationConstraint + BallSocketConstraint) y R6 clásicos (Motor6D).
-- Diseñado para la onda expansiva del Point Effect y para el futuro sistema de combate/slap.

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)

local RagdollService = {}
RagdollService.Name = "RagdollService"

RagdollService._context = nil :: any
RagdollService._activeTimers = {} :: { [Model]: thread }
RagdollService._r6Instances = {} :: { [Model]: { Instance } }
RagdollService._rootCollisions = setmetatable({}, { __mode = "k" }) :: { [Model]: boolean }

function RagdollService:_getStateEvent(): UnreliableRemoteEvent?
	local evt = ReplicatedStorage:FindFirstChild("StateEvent")
	if evt and evt:IsA("UnreliableRemoteEvent") then
		return evt
	elseif evt and evt:IsA("RemoteEvent") then
		return evt :: any
	end
	return nil
end

-- Retorna true si el personaje se encuentra actualmente en estado Ragdoll
function RagdollService:IsRagdolled(character: Model): boolean
	if not character then return false end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then return false end
	return humanoid.PlatformStand == true or self._activeTimers[character] ~= nil
end

-- Pasa el personaje a estado Ragdoll físico y notifica a RagdollStatesHandler
function RagdollService:ApplyRagdoll(character: Model, duration: number?, launchVelocity: Vector3?): boolean
	if not character or not character:IsDescendantOf(Workspace) then return false end
	if character:GetAttribute("ArenaRespawnPending") then return false end
	local owner = Players:GetPlayerFromCharacter(character)
	if owner and owner:GetAttribute("ResultsSessionId") ~= nil then return false end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then return false end

	local rootPart = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not rootPart then return false end
	-- Release ability movement ownership BEFORE ragdoll takes ownership/velocity.
	local abilities = self._context and self._context:GetService("AbilityService")
	if owner and abilities then abilities:CancelPlayer(owner, "Ragdoll") end
	if self._rootCollisions[character] == nil then self._rootCollisions[character] = rootPart.CanCollide end

	-- Cancelar timer previo si ya estaba en ragdoll
	local prevTimer = self._activeTimers[character]
	if prevTimer then
		pcall(task.cancel, prevTimer)
		self._activeTimers[character] = nil
	end

	local hasAnimationConstraints = false
	for _, desc in ipairs(character:GetDescendants()) do
		if desc:IsA("AnimationConstraint") and desc.Name ~= "Root" then
			hasAnimationConstraints = true
			desc.Enabled = false
		end
	end

	-- Si es R6 clásico (no usa AnimationConstraint sino Motor6D)
	-- Repeated hits refresh velocity/timer, not the physical rig. Replacing this
	-- list leaked the first hit's constraints/colliders beyond ResetRagdollImmediate.
	if not hasAnimationConstraints and not self._r6Instances[character] then
		local torso = character:FindFirstChild("Torso") :: BasePart?
		local rootJoint = rootPart:FindFirstChild("RootJoint") :: Motor6D?
		if torso and rootJoint then
			rootPart.Massless = true
			local instances = {}

			if not rootPart:FindFirstChild("TorsoWeld") then
				local torsoWeld = Instance.new("WeldConstraint")
				torsoWeld.Part0 = rootPart
				torsoWeld.Part1 = torso
				torsoWeld.Name = "TorsoWeld"
				torsoWeld.Parent = rootPart
				table.insert(instances, torsoWeld)
			end
			rootJoint.Enabled = false

			for _, v in ipairs(character:GetDescendants()) do
				if v:IsA("Motor6D") and v ~= rootJoint then
					local part0, part1 = v.Part0, v.Part1
					if part0 and part1 then
						local collider = Instance.new("Part")
						collider.Size = part1.Size / 1.7
						collider.CFrame = part1.CFrame
						collider.Massless = true
						collider.CanQuery = false
						collider.CollisionGroup = part1.CollisionGroup
						collider.CanTouch = false
						collider.Transparency = 1
						collider.Name = "Collider"
						collider.Parent = part1
						table.insert(instances, collider)

						local colliderWeld = Instance.new("WeldConstraint")
						colliderWeld.Part0 = collider
						colliderWeld.Part1 = part1
						colliderWeld.Parent = collider
						table.insert(instances, colliderWeld)

						local attachment0 = Instance.new("Attachment")
						attachment0.CFrame = v.C0
						attachment0.Name = part1.Name .. "_RagdollAttachment0"
						attachment0.Parent = part0
						table.insert(instances, attachment0)

						local attachment1 = Instance.new("Attachment")
						attachment1.CFrame = v.C1
						attachment1.Name = "RagdollAttachment1"
						attachment1.Parent = part1
						table.insert(instances, attachment1)

						local ballSocket = Instance.new("BallSocketConstraint")
						ballSocket.Attachment0 = attachment0
						ballSocket.Attachment1 = attachment1
						ballSocket.LimitsEnabled = true
						ballSocket.TwistLimitsEnabled = true
						ballSocket.Name = "RagdollConstraint"
						ballSocket.Parent = part1
						table.insert(instances, ballSocket)

						v.Enabled = false
					end
				end
			end
			self._r6Instances[character] = instances
		end
	end

	-- Configuración del Humanoid
	humanoid.PlatformStand = true
	humanoid.AutoRotate = false
	rootPart.CanCollide = false

	-- Aplicar velocidad en el servidor si se provee a todas las partes
	if launchVelocity then
		for _, part in ipairs(character:GetDescendants()) do
			if part:IsA("BasePart") then
				part.AssemblyLinearVelocity = launchVelocity
				part.AssemblyAngularVelocity = Vector3.new(
					math.random(-6, 6),
					math.random(-6, 6),
					math.random(-6, 6)
				)
			end
		end
	end

	-- Notificar al cliente mediante StateEvent para activar RagdollStatesHandler
	local player = Players:GetPlayerFromCharacter(character)
	local stateEvent = self:_getStateEvent()
	if player and stateEvent then
		stateEvent:FireClient(player, false, launchVelocity, player:GetAttribute("MatchId"), character:GetAttribute("ArenaPhysicsGeneration") or 0, character)
	else
		pcall(function()
			humanoid:SetStateEnabled(Enum.HumanoidStateType.GettingUp, false)
			humanoid:ChangeState(Enum.HumanoidStateType.Physics)
		end)
	end

	-- Programar recuperación automática
	local ragDuration = duration or (Config.Ragdoll and Config.Ragdoll.DefaultDuration) or 2.0
	if ragDuration > 0 then
		local generation = character:GetAttribute("ArenaPhysicsGeneration") or 0
		local sessionId = player and player:GetAttribute("MatchId")
		local rounds = self._context and self._context:GetService("RoundService")
		local session = player and rounds and rounds:GetSessionForPlayer(player)
		local stateVersion = session and session.StateVersion
		local deadline=os.clock()+ragDuration
		character:SetAttribute("RagdollRecoveryDeadline",deadline)
		local recovery: thread
		recovery = task.delay(math.max(0,deadline-os.clock()), function()
			local stale = self._activeTimers[character] ~= recovery or not character:IsDescendantOf(Workspace)
				or (character:GetAttribute("ArenaPhysicsGeneration") or 0) ~= generation
				or character:GetAttribute("ArenaRespawnPending") == true
				or (player ~= nil and (player.Parent ~= Players or player.Character ~= character
					or player:GetAttribute("MatchId") ~= sessionId or player:GetAttribute("ResultsSessionId") ~= nil))
				or (session ~= nil and (rounds:GetSessionForPlayer(player) ~= session
					or session.StateVersion ~= stateVersion or not rounds:IsSessionActive(session.Id)
					or session.Closing or session.Closed or session.Cancelled or session.GameplayFrozen))
			if stale then
				if self._activeTimers[character] == recovery then self._activeTimers[character] = nil end
				if Config.Respawn.Debug then warn("[RespawnDebug] StaleRagdollRecovery", player and player.UserId, generation, character:GetAttribute("ArenaEliminationId")) end
				return
			end
			self._activeTimers[character] = nil
			character:SetAttribute("RagdollRecoveryDeadline",nil)
			self:RemoveRagdoll(character)
		end)
		self._activeTimers[character] = recovery
	end

	return true
end

-- Restaura el personaje a su estado normal de locomoción notificando a RagdollStatesHandler
function RagdollService:CancelRecovery(character: Model)
 local timer=self._activeTimers[character]
 if timer then pcall(task.cancel,timer);self._activeTimers[character]=nil end
 character:SetAttribute("RagdollRecoveryDeadline",nil)
end

function RagdollService:RemoveRagdoll(character: Model): boolean
	if character then character:SetAttribute("RagdollRecoveryDeadline",nil) end
	if character and character:GetAttribute("ArenaRespawnPending") then return false end
	local timer = self._activeTimers[character]
	if timer then
		pcall(task.cancel, timer)
		self._activeTimers[character] = nil
	end

	if not character or not character.Parent then return false end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local rootPart = character:FindFirstChild("HumanoidRootPart") :: BasePart?

	-- 1. Reactivar AnimationConstraints si es R15
	for _, desc in ipairs(character:GetDescendants()) do
		if desc:IsA("AnimationConstraint") then
			desc.Enabled = true
		end
	end

	-- 2. Limpiar R6 si correspondía
	local r6Instances = self._r6Instances[character]
	if r6Instances then
		if rootPart then rootPart.Massless = false end
		for _, v in ipairs(character:GetDescendants()) do
			if v:IsA("Motor6D") then
				v.Enabled = true
			end
		end
		for _, inst in ipairs(r6Instances) do
			if inst and inst.Parent then
				inst:Destroy()
			end
		end
		self._r6Instances[character] = nil
	end

	-- 3. Restaurar Humanoid y colisión del RootPart
	if rootPart then
		local original = self._rootCollisions[character]
		if original ~= nil then rootPart.CanCollide = original end
		self._rootCollisions[character] = nil
	end

	if humanoid and humanoid.Health > 0 then
		humanoid.PlatformStand = false
		humanoid.AutoRotate = true

		local player = Players:GetPlayerFromCharacter(character)
		local stateEvent = self:_getStateEvent()
		if player and stateEvent then
			stateEvent:FireClient(player, true, nil, player:GetAttribute("MatchId"), character:GetAttribute("ArenaPhysicsGeneration") or 0, character)
		else
			pcall(function()
				humanoid:SetStateEnabled(Enum.HumanoidStateType.GettingUp, true)
				humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
			end)
		end
	end

	return true
end

-- Reseteo forzado e inmediato de ragdoll para reposicionamiento en arena (Zero-Death)
-- Idempotente, síncrono, cancela timers/callbacks y restaura articulaciones, colisiones y estado físico.
function RagdollService:ResetRagdollImmediate(character: Model, quietRespawn: boolean?): boolean
	if character then character:SetAttribute("RagdollRecoveryDeadline",nil) end
	if not character or not character.Parent then return false end

	-- 1. Cancelar cualquier timer pendiente para evitar callbacks diferidos
	local timer = self._activeTimers[character]
	if timer then
		pcall(task.cancel, timer)
		self._activeTimers[character] = nil
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local rootPart = character:FindFirstChild("HumanoidRootPart") :: BasePart?

	-- 2. Reactivar AnimationConstraints si es R15
	for _, desc in ipairs(character:GetDescendants()) do
		if desc:IsA("AnimationConstraint") then
			desc.Enabled = true
		end
	end

	-- 3. Limpiar instancias R6 si correspondía
	local r6Instances = self._r6Instances[character]
	if r6Instances then
		if rootPart then rootPart.Massless = false end
		for _, v in ipairs(character:GetDescendants()) do
			if v:IsA("Motor6D") then
				v.Enabled = true
			end
		end
		for _, inst in ipairs(r6Instances) do
			if inst and inst.Parent then
				inst:Destroy()
			end
		end
		self._r6Instances[character] = nil
	end

	-- 4. Anular colapso de RootJoint / TorsoWeld residuales si existieran
	if rootPart then
		rootPart.Massless = false
		local original = self._rootCollisions[character]
		if original ~= nil then rootPart.CanCollide = original end
		self._rootCollisions[character] = nil
		local rootJoint = rootPart:FindFirstChild("RootJoint") :: Motor6D?
		if rootJoint then
			rootJoint.Enabled = true
		end
		local torsoWeld = rootPart:FindFirstChild("TorsoWeld")
		if torsoWeld then
			torsoWeld:Destroy()
		end
	end

	-- Quiet Zero-Death recovery runs with the root anchored by ArenaRespawn.
	-- Reassemble R6 at rest BEFORE teleport/collision restoration; enabling motors
	-- alone leaves ragdoll limb poses for the next solver step to correct.
	if quietRespawn and r6Instances and rootPart and rootPart.Anchored then
		local motors: { Motor6D } = {}
		for _, joint in ipairs(character:GetDescendants()) do
			if joint:IsA("Motor6D") and joint.Part0 and joint.Part1 then
				joint.Transform = CFrame.identity
				table.insert(motors, joint)
			end
		end
		local positioned: { [BasePart]: boolean } = { [rootPart] = true }
		for _ = 1, #motors do
			local progressed = false
			for _, joint in ipairs(motors) do
				local a, b = joint.Part0, joint.Part1
				if a and b and positioned[a] and not positioned[b] then
					b.CFrame = a.CFrame * joint.C0 * joint.C1:Inverse()
					positioned[b] = true
					progressed = true
				end
			end
			if not progressed then break end
		end
	end

	-- 5. Restaurar estado de locomoción en Humanoid sin alterar Health
	if humanoid and humanoid.Health > 0 then
		humanoid.PlatformStand = false
		humanoid.AutoRotate = true

		local player = Players:GetPlayerFromCharacter(character)
		local stateEvent = self:_getStateEvent()
		if player and stateEvent and not quietRespawn then
			stateEvent:FireClient(player, true, nil, player:GetAttribute("MatchId"), character:GetAttribute("ArenaPhysicsGeneration") or 0, character)
		end

		pcall(function()
			humanoid:SetStateEnabled(Enum.HumanoidStateType.GettingUp, true)
			if quietRespawn then humanoid.Jump = false end
			humanoid:ChangeState(if quietRespawn then Enum.HumanoidStateType.Running else Enum.HumanoidStateType.GettingUp)
		end)
	end

	-- 6. Anular cualquier inercia o impulso en todas las partes del modelo
	for _, desc in ipairs(character:GetDescendants()) do
		if desc:IsA("BasePart") then
			desc.AssemblyLinearVelocity = Vector3.zero
			desc.AssemblyAngularVelocity = Vector3.zero
		end
	end

	return true
end

-- Calcula el vector tridimensional de impulso de lanzamiento a partir de un punto de origen
function RagdollService:ComputeLaunchVelocity(
	originPos: Vector3,
	targetPos: Vector3,
	forceMagnitude: number?,
	upwardRatio: number?
): Vector3
	local force = forceMagnitude or (Config.Ragdoll and Config.Ragdoll.BlastForce) or 110
	local upRatio = upwardRatio or (Config.Ragdoll and Config.Ragdoll.UpwardRatio) or 0.65
	upRatio = math.clamp(upRatio, 0.2, 0.9)

	local diff = targetPos - originPos
	local horizontal = Vector3.new(diff.X, 0, diff.Z)
	local horizDist = horizontal.Magnitude

	local horizDir: Vector3
	if horizDist > 0.5 then
		horizDir = horizontal.Unit
	else
		-- Directamente en el epicentro: dispersar en dirección horizontal aleatoria
		local angle = math.random() * math.pi * 2
		horizDir = Vector3.new(math.cos(angle), 0, math.sin(angle))
	end

	-- Componente vertical fuerte y garantizado para elevar al personaje por los aires (vence gravedad 196.2)
	local vertSpeed = math.max(force * upRatio * 1.3, 85)
	local horizSpeed = force * (1 - upRatio * 0.4)

	return horizDir * horizSpeed + Vector3.new(0, vertSpeed, 0)
end

-- Aplica un impulso físico de lanzamiento al personaje alejándolo de un punto de origen
function RagdollService:LaunchCharacter(character: Model, originPos: Vector3, forceMagnitude: number?, upwardRatio: number?)
	if not character or not character:IsDescendantOf(Workspace) then return end
	if character:GetAttribute("ArenaRespawnPending") then return end
	local owner = Players:GetPlayerFromCharacter(character)
	if owner and owner:GetAttribute("ResultsSessionId") ~= nil then return end

	local rootPart = character:FindFirstChild("HumanoidRootPart") :: BasePart? or character.PrimaryPart
	if not rootPart then return end

	local launchVel = self:ComputeLaunchVelocity(originPos, rootPart.Position, forceMagnitude, upwardRatio)

	-- Asignar velocidad lineal y rotacional en el servidor a todas las partes del cuerpo
	for _, part in ipairs(character:GetDescendants()) do
		if part:IsA("BasePart") then
			part.AssemblyLinearVelocity = launchVel
			part.AssemblyAngularVelocity = Vector3.new(
				math.random(-6, 6),
				math.random(-6, 6),
				math.random(-6, 6)
			)
		end
	end

	-- Notificar al cliente para que su simulación local replique el lanzamiento
	local player = Players:GetPlayerFromCharacter(character)
	local stateEvent = self:_getStateEvent()
	if player and stateEvent then
		stateEvent:FireClient(player, false, launchVel, player:GetAttribute("MatchId"), character:GetAttribute("ArenaPhysicsGeneration") or 0, character)
	end
end

-- Detona una onda expansiva en originPos, enviando en ragdoll y por los aires a todos los personajes dentro del radio
function RagdollService:BlastZone(
	originPos: Vector3,
	radius: number?,
	forceMagnitude: number?,
	upwardRatio: number?,
	duration: number?,
	filterFunc: ((Player?, Model) -> boolean)?
): number
	local blastRadius = radius or (Config.Ragdoll and Config.Ragdoll.BlastRadius) or 25
	local blastForce = forceMagnitude or (Config.Ragdoll and Config.Ragdoll.BlastForce) or 110
	local upRatio = upwardRatio or (Config.Ragdoll and Config.Ragdoll.UpwardRatio) or 0.65
	local ragDuration = duration or (Config.Ragdoll and Config.Ragdoll.DefaultDuration) or 2.0

	local affectedCount = 0

	for _, player in ipairs(Players:GetPlayers()) do
		local char = player.Character
		if char and char:IsDescendantOf(Workspace) then
			local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root then
				local dist = (root.Position - originPos).Magnitude
				if dist <= blastRadius then
					local allowed = true
					if filterFunc then
						allowed = filterFunc(player, char)
					end
					if allowed then
						local falloff = math.clamp(1 - (dist / blastRadius) * 0.35, 0.65, 1.0)
						local force = blastForce * falloff
						local launchVel = self:ComputeLaunchVelocity(originPos, root.Position, force, upRatio)

						self:ApplyRagdoll(char, ragDuration, launchVel)
						affectedCount += 1
					end
				end
			end
		end
	end

	return affectedCount
end

function RagdollService:Init(context)
	self._context = context
	self._activeTimers = {}
	self._r6Instances = {}
	self._rootCollisions = setmetatable({}, { __mode = "k" })
end

function RagdollService:Start(context)
	self._context = context
	print("[RagdollService] Servicio de Ragdoll activo, integrado con ReplicatedStorage.StateEvent y RagdollStatesHandler")
end

return RagdollService
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="992">
        <Properties>
          <string name="Name">Respawn</string>
        </Properties>
        <Item class="ModuleScript" referent="993">
          <Properties>
            <string name="Name">ArenaRespawn</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Zero-Death lifecycle owned by SpawnService. Keeps the same Character and independent VFX alive.
local Players=game:GetService("Players")
local Config=require(game.ReplicatedStorage.Shared.Config)
local Policy=require(game.ReplicatedStorage.Shared.ArenaRespawnPolicy)
local CharacterPhysics=require(script.Parent.CharacterPhysics)
local Lifecycle={}
Lifecycle.__index=Lifecycle
function Lifecycle.new(spawn) return setmetatable({Spawn=spawn,Pending={}},Lifecycle) end
function Lifecycle:Trace(record,phase)
 if not Config.Respawn.Debug then return end
 print("[RespawnDebug]",phase,"EliminationId",record.EliminationId,"UserId",record.Player.UserId,
  "Generation",record.Character:GetAttribute("ArenaPhysicsGeneration"),"Kind",record.Kind,
  "Session",record.Session.Id,"RoundState",record.Session.State,"State",record.Humanoid:GetState().Name,"Jump",record.Humanoid.Jump,
  "Linear",record.Root.AssemblyLinearVelocity,"Angular",record.Root.AssemblyAngularVelocity)
end
local function zero(character)
 for _,part in ipairs(character:GetDescendants()) do
  if part:IsA("BasePart") then part.AssemblyLinearVelocity=Vector3.zero;part.AssemblyAngularVelocity=Vector3.zero end
 end
end
function Lifecycle:Take(player)
 local record=self.Pending[player]
 if not record then return nil end
 self.Pending[player]=nil
 if record.Thread and record.Thread~=coroutine.running() then pcall(task.cancel,record.Thread) end
 if record.Connection then record.Connection:Disconnect() end
 return record
end
function Lifecycle:Restore(record)
 local character=record.Character
 if not character.Parent then return end
 for object,properties in pairs(record.Properties) do
  if object.Parent then for key,value in pairs(properties) do object[key]=value end end
 end
 -- Never adopt transient Physics/ragdoll collision values as the normal avatar contract.
 CharacterPhysics.Restore(character)
 local humanoid=record.Humanoid
 if humanoid.Parent then
  humanoid.Jump=false
  humanoid.AutoRotate=not humanoid:GetAttribute("MovementLocked") and record.AutoRotate
  humanoid.PlatformStand=record.PlatformStand
  humanoid.DisplayDistanceType=record.DisplayDistanceType
  humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping,record.JumpingEnabled)
 end
 zero(character)
 record.Root.Anchored=record.Anchored
 character:SetAttribute("ArenaRespawnPending",nil)
 character:SetAttribute("ArenaPhysicsPhase","Playing")
 self:Trace(record,"ServerRestored")
 if record.Root.Parent and not record.Root.Anchored then
  pcall(function()
   if record.OwnerAuto then record.Root:SetNetworkOwnershipAuto()
   else record.Root:SetNetworkOwner(record.Owner and record.Owner.Parent==Players and record.Owner or nil) end
  end)
 end
end
function Lifecycle:Cancel(player,reason,recover)
 local record=self.Pending[player]
 if not record then return end
 print("[ArenaRespawn] Cancelled",record.Session.Id,record.EliminationId,reason)
 self:Trace(record,"Cancelled:"..reason)
 if recover and player.Parent==Players and player.Character==record.Character then
  if self.Spawn:ResetCharacterInArena(player,record.Session.Id) then return end
 end
 record=self:Take(player)
 if record then self:Restore(record) end
end
function Lifecycle:CancelSession(id,reason,recover)
 local players={}
 for player,record in pairs(self.Pending) do if record.Session.Id==id then table.insert(players,player) end end
 for _,player in ipairs(players) do self:Cancel(player,reason,recover) end
end
function Lifecycle:Begin(player,session,eliminationId,kind)
 if self.Pending[player] then return false end
 local character=player.Character
 local humanoid=character and character:FindFirstChildOfClass("Humanoid")
 local root=character and character:FindFirstChild("HumanoidRootPart")
 if not character or not humanoid or not root or humanoid.Health<=0 then return false end
 local delayMs,valid=Policy.NormalizeDelayMs(Config.Respawn.KillPartDelayMs,Config.Respawn.MaxKillPartDelayMs)
 if not valid then warn("[ArenaRespawn] Invalid/out-of-range KillPartDelayMs normalized to",delayMs) end
 local ownerAuto,owner=true,nil
 pcall(function()ownerAuto=root:GetNetworkOwnershipAuto();owner=root:GetNetworkOwner();root:SetNetworkOwner(nil)end)
 local generation=(character:GetAttribute("ArenaPhysicsGeneration") or 0)+1
 local ragdoll=self.Spawn:_getRagdollService()
 local hadRagdoll=ragdoll and ragdoll:IsRagdolled(character) or false
 local record={Player=player,Character=character,Humanoid=humanoid,Root=root,Session=session,
  StateVersion=session.StateVersion,Generation=generation,EliminationId=eliminationId,Kind=kind or "KillPart",
  Anchored=root.Anchored,OwnerAuto=ownerAuto,Owner=owner,Properties={},Started=os.clock(),
  AutoRotate=humanoid.AutoRotate,PlatformStand=false,JumpingEnabled=humanoid:GetStateEnabled(Enum.HumanoidStateType.Jumping),
  DisplayDistanceType=humanoid.DisplayDistanceType}
 self.Pending[player]=record
 character:SetAttribute("ArenaPhysicsPhase","Retired")
 character:SetAttribute("ArenaRespawnDebug",Config.Respawn.Debug==true)
 character:SetAttribute("ArenaEliminationId",eliminationId)
 character:SetAttribute("ArenaPhysicsGeneration",generation)
 character:SetAttribute("ArenaRespawnPending",true)
 character:SetAttribute("ArenaRespawnRevision",(character:GetAttribute("ArenaRespawnRevision") or 0)+1)
 root.Anchored=true
 -- Cancel old ragdoll callbacks/constraints without a GettingUp impulse or a new launch.
 if ragdoll then ragdoll:ResetRagdollImmediate(character,true) end
 record.AutoRotate=humanoid.AutoRotate
 local function hide(object)
  if record.Properties[object] then return end
  if object:IsA("BasePart") then
   record.Properties[object]={Transparency=object.Transparency,CanCollide=object.CanCollide,
    CanTouch=object.CanTouch,CanQuery=object.CanQuery,CastShadow=object.CastShadow}
   object.Transparency=1;object.CanCollide=false;object.CanTouch=false;object.CanQuery=false;object.CastShadow=false
  elseif object:IsA("Decal") then record.Properties[object]={Transparency=object.Transparency};object.Transparency=1
  elseif object:IsA("ParticleEmitter") or object:IsA("Trail") or object:IsA("Beam") then
   record.Properties[object]={Enabled=object.Enabled};object.Enabled=false
  elseif object:IsA("BillboardGui") then record.Properties[object]={Enabled=object.Enabled};object.Enabled=false end
 end
 for _,object in ipairs(character:GetDescendants()) do hide(object) end
 record.Connection=character.DescendantAdded:Connect(hide)
 humanoid.Jump=false;humanoid.AutoRotate=false;humanoid.PlatformStand=true
 humanoid.DisplayDistanceType=Enum.HumanoidDisplayDistanceType.None
 humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping,false)
 zero(character)
 self:Trace(record,if hadRagdoll then "RetiredAfterRagdoll" else "RetiredWithoutRagdoll")
 print("[ArenaRespawn] Retired",session.Id,eliminationId,"Generation",generation,"DelayMs",delayMs)
 record.Thread=task.delay(math.max(0,delayMs/1000-(os.clock()-record.Started)),function()
  record.Thread=nil
  if self.Pending[player]~=record then return end
  local rounds=self.Spawn:_getRoundService()
  local current=rounds:GetSessionForPlayer(player)
  if player.Parent~=Players or not Policy.IsCurrent(record,current,player.Character,character:GetAttribute("ArenaPhysicsGeneration"))
   or rounds:GetSessionParticipant(session.Id,player)==nil then
   -- Obsolete timers only release their own resources; never reposition any Character.
   self:Cancel(player,"StaleTimer",false)
   return
  end
  local ok,failure=pcall(self.Spawn.ResetCharacterInArena,self.Spawn,player,session.Id)
  if not ok or not failure then
   warn("[ArenaRespawn] Respawn failed",session.Id,eliminationId,tostring(failure))
   self:Cancel(player,"PlacementFailed",false)
   if rounds._cancelSession then rounds:_cancelSession("KillPartRespawnFailed",session.Id) end
   return
  end
  print("[ArenaRespawn] Restored",session.Id,eliminationId,"ElapsedMs",math.floor((os.clock()-record.Started)*1000))
 end)
 return true
end
return Lifecycle
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="994">
          <Properties>
            <string name="Name">CharacterPhysics</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Spawn-owned physical contract, captured before competitive mutations, per exact Character.
local PhysicsService=game:GetService("PhysicsService")
local Config=require(game.ReplicatedStorage.Shared.Config)
local Physics={Group="SlapDuelsCharacters",Records=setmetatable({},{__mode="k"})}
function Physics.Configure()
 if not PhysicsService:IsCollisionGroupRegistered(Physics.Group) then PhysicsService:RegisterCollisionGroup(Physics.Group) end
 -- Preserve the authored Default/Default matrix; player exclusion belongs to a separate group.
 PhysicsService:CollisionGroupSetCollidable(Physics.Group,Physics.Group,false)
 PhysicsService:CollisionGroupSetCollidable(Physics.Group,"Default",true)
end
function Physics.Track(character)
 if Physics.Records[character] then return end
 local record={Parts={}}
 Physics.Records[character]=record
 local function capture(part)
  if not part:IsA("BasePart") then return end
  part.CollisionGroup=Physics.Group
  -- These are owned temporary R6 colliders, not a normal avatar collision baseline.
  if part.Name=="Collider" or character:GetAttribute("ArenaRespawnPending") then return end
  record.Parts[part]={CanCollide=part.CanCollide,CanTouch=part.CanTouch,CanQuery=part.CanQuery}
 end
 for _,part in ipairs(character:GetDescendants()) do capture(part) end
 record.Connection=character.DescendantAdded:Connect(capture)
end
function Physics.Forget(character)
 local record=Physics.Records[character]
 if record and record.Connection then record.Connection:Disconnect() end
 Physics.Records[character]=nil
end
function Physics.Restore(character)
 local record=Physics.Records[character]
 if not record then return false end
 for part,properties in pairs(record.Parts) do
  if part:IsDescendantOf(character) then
   part.CollisionGroup=Physics.Group
   part.CanCollide=properties.CanCollide
   part.CanTouch=properties.CanTouch
   part.CanQuery=properties.CanQuery
  end
 end
 return true
end
function Physics.Trace(player,phase,spawn,roundState)
 if not Config.Respawn.Debug then return end
 local character=player.Character
 local root=character and character:FindFirstChild("HumanoidRootPart")
 local hum=character and character:FindFirstChildOfClass("Humanoid")
 if not root or not hum then return end
 local support=character:FindFirstChild("Torso") or character:FindFirstChild("LowerTorso") or root
 print("[RespawnDebug]",phase,"UserId",player.UserId,"Session",player:GetAttribute("MatchId"),
  "EliminationId",character:GetAttribute("ArenaEliminationId"),"Generation",character:GetAttribute("ArenaPhysicsGeneration"),
  "RoundState",roundState,"State",hum:GetState().Name,"Jump",hum.Jump,"PlatformStand",hum.PlatformStand,"Anchored",root.Anchored,
  "Linear",root.AssemblyLinearVelocity,"Angular",root.AssemblyAngularVelocity,
  "BodyGroup",support.CollisionGroup,"BodyCanCollide",support.CanCollide,"RootCanCollide",root.CanCollide,
  "SpawnGroup",spawn and spawn.CollisionGroup,"GroupPair",spawn and PhysicsService:CollisionGroupsAreCollidable(support.CollisionGroup,spawn.CollisionGroup))
end
return Physics
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="995">
          <Properties>
            <string name="Name">CompetitiveTransit</string>
            <string name="Source"><![CDATA[--!strict
-- One authoritative outcome per exact Character generation, scoped to session and UserId.
-- Pure registry: no timers, rewards, physics, replication or gameplay side effects.
local Transit = {}
Transit.__index = Transit
function Transit.new()
 return setmetatable({_sessions = {} :: {[string]: {[number]: any}}},Transit)
end
function Transit:Get(session: any, player: any, character: any, generation: any): any?
 local entries = self._sessions[session.Id]
 local record = entries and entries[player.UserId]
 if not record then return nil end
 -- The existing point teleport advances the physics generation on the SAME Character.
 -- Keep that goal protected through its countdown; ResumeScoring explicitly releases it.
 local pointHandoff = record.Kind=="Goal" and session.PointInProgress==true
 if record.Session ~= session or record.Player ~= player or record.Character ~= character
  or (record.Generation ~= generation and not pointHandoff) then
  entries[player.UserId] = nil
  if next(entries)==nil then self._sessions[session.Id]=nil end
  return nil
 end
 return record
end
function Transit:Claim(session: any, player: any, character: any, generation: any, kind: string, eventId: string): boolean
 if self:Get(session,player,character,generation) then return false end
 local entries = self._sessions[session.Id]
 if not entries then entries={};self._sessions[session.Id]=entries end
 entries[player.UserId]={Session=session,SessionId=session.Id,Player=player,UserId=player.UserId,
  Character=character,Generation=generation,Kind=kind,EventId=eventId}
 return true
end
function Transit:ForgetPlayer(sessionId: string, player: any)
 local entries=self._sessions[sessionId]
 local record=entries and entries[player.UserId]
 if record and record.Player==player then entries[player.UserId]=nil end
 if entries and next(entries)==nil then self._sessions[sessionId]=nil end
end
function Transit:ReleaseGoals(sessionId: string)
 local entries=self._sessions[sessionId]
 if not entries then return end
 for id,record in pairs(entries) do if record.Kind=="Goal" then entries[id]=nil end end
 if next(entries)==nil then self._sessions[sessionId]=nil end
end
function Transit:ClearSession(sessionId: string)
 self._sessions[sessionId]=nil
end
return Transit
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="996">
          <Properties>
            <string name="Name">MovementSpeed</string>
            <string name="Source"><![CDATA[--!nonstrict
-- SpawnService owns lifecycle; this helper composes base speed and temporary modifiers.
local Config = require(game.ReplicatedStorage.Shared.Config)
local Movement = {}
local modifiers = setmetatable({}, {__mode = "k"})
function Movement.ResolveBase(session, matchId)
 local state = session and session.State
 if not session or session.Closed or matchId ~= session.Id
  or state == "Waiting" or state == "MatchReady" or state == "MatchCountdown" then
  return Config.Character.LobbyWalkSpeed
 end
 return Config.Character.MatchWalkSpeed
end
function Movement.Base(humanoid)
 return humanoid:GetAttribute("BaseWalkSpeed") or Config.Character.MatchWalkSpeed
end
function Movement.Apply(humanoid, release)
 if not humanoid.Parent or humanoid.Health <= 0 then return false end
 if humanoid:GetAttribute("MovementLocked") or humanoid.PlatformStand
  or humanoid.Parent:GetAttribute("ArenaRespawnPending") then return false end
 -- An unowned zero can belong to another freeze. Only its explicit unlock may release it.
 if humanoid.WalkSpeed <= 0 and not release and not humanoid:GetAttribute("MovementSpeedUnlockPending") then return false end
 local modifier = modifiers[humanoid]
 humanoid.WalkSpeed = Movement.Base(humanoid) + (modifier and modifier.Extra or 0)
 humanoid:SetAttribute("MovementSpeedUnlockPending", nil)
 return true
end
function Movement.SetBase(humanoid, base)
 humanoid:SetAttribute("BaseWalkSpeed", base)
 return Movement.Apply(humanoid)
end
function Movement.SetModifier(humanoid, owner, extra)
 if not humanoid.Parent or humanoid:GetAttribute("MovementLocked") or humanoid.PlatformStand
  or humanoid.Parent:GetAttribute("ArenaRespawnPending") or humanoid.WalkSpeed <= 0 then return false end
 local current = modifiers[humanoid]
 if current and current.Owner ~= owner then return false end
 modifiers[humanoid] = {Owner = owner, Extra = extra}
 return Movement.Apply(humanoid)
end
function Movement.RemoveModifier(humanoid, owner)
 local current = modifiers[humanoid]
 if current and current.Owner == owner then
  local owned = math.abs(humanoid.WalkSpeed - (Movement.Base(humanoid) + current.Extra)) < 0.001
  modifiers[humanoid] = nil
  if owned then Movement.Apply(humanoid) end
 end
end
return Movement
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="997">
        <Properties>
          <string name="Name">RoundService</string>
          <string name="Source"><![CDATA[--!strict
-- RoundService
-- Maquina de estados del flujo de partida 1v1.
-- Controla el ciclo completo: Waiting -> MatchReady -> MatchCountdown -> MapSelection -> MapLoading -> Playing -> Ending -> ReturningToLobby -> Waiting.
-- NO implementa logica fisica de spawn ni mapas (delegado a SpawnService en fases posteriores).

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local HttpService = game:GetService("HttpService")

local Config = require(ReplicatedStorage.Shared.Config)
local Constants = require(ReplicatedStorage.Shared.Constants)
local RoundClock = require(script.Parent.Gameplay.RoundClock)
local Types = require(ReplicatedStorage.Shared.Types)
local CinematicConfig = require(ReplicatedStorage.Shared.EndCinematicConfig)
local CinematicRanking = require(ReplicatedStorage.Shared.EndCinematicRanking)

type RoundStateName = Types.RoundStateName
type MatchSession = Types.MatchSession
type MatchResultName = Types.MatchResultName
type SessionId = Types.SessionId
type SessionParticipant = Types.SessionParticipant

local RoundService = {}
RoundService.Name = "RoundService"

-- Evento / señal para que servicios externos (ej. SpawnService) se suscriban al retorno al lobby
local returnLobbyBindable = Instance.new("BindableEvent")
RoundService.ReturnPlayersToLobby = returnLobbyBindable.Event

-- Estado interno
RoundService._context = nil :: any
-- Adaptadores temporales para consumidores 1v1. El estado autoritativo vive en MatchSession.
RoundService._state = Constants.RoundState.Waiting :: RoundStateName
RoundService._currentSession = nil :: MatchSession?
RoundService._sessionsById = {} :: { [SessionId]: MatchSession }
RoundService._sessionIdByUserId = {} :: { [number]: SessionId }
RoundService._participantByPlayer = {} :: { [Player]: SessionParticipant }
RoundService._closedSessionIds = {} :: { [SessionId]: boolean }
RoundService._maxConcurrentSessions = 1
RoundService._connections = {} :: { RBXScriptConnection }

-- Utilidad para garantizar existencia de Remotes
local function ensureRemoteFolder(parent: Instance, name: string): Folder
	local folder = parent:FindFirstChild(name)
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = name
		folder.Parent = parent
	end
	return folder :: Folder
end

local function ensureRemoteEvent(parent: Instance, name: string): RemoteEvent
	local event = parent:FindFirstChild(name)
	if not event then
		event = Instance.new("RemoteEvent")
		event.Name = name
		event.Parent = parent
	end
	return event :: RemoteEvent
end

local function runCleanupStep(label: string, callback: () -> ())
	local ok, err = pcall(callback)
	if not ok then
		warn(string.format("[RoundService] Falló limpieza '%s': %s", label, tostring(err)))
	end
end

function RoundService:_ensureRemotes()
	local remotesFolder = ensureRemoteFolder(ReplicatedStorage, "Remotes")
	local matchFolder = ensureRemoteFolder(remotesFolder, "Match")
	local matchmakingFolder = ensureRemoteFolder(remotesFolder, "Matchmaking")

	ensureRemoteEvent(matchFolder, "StateChanged")
	ensureRemoteEvent(matchFolder, "Countdown")
	ensureRemoteEvent(matchFolder, "MapSelection")
	ensureRemoteEvent(matchFolder, "MatchResult")
	ensureRemoteEvent(matchFolder, "EndCinematic")
	ensureRemoteEvent(matchFolder, "EndCinematicAction")
	ensureRemoteEvent(matchmakingFolder, "QueueStatus")
end

function RoundService:_getRemote(folderName: string, eventName: string): RemoteEvent?
	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	if not remotes then return nil end
	local folder = remotes:FindFirstChild(folderName)
	if not folder then return nil end
	local event = folder:FindFirstChild(eventName)
	if event and event:IsA("RemoteEvent") then
		return event
	end
	return nil
end

function RoundService:Init(context)
	self._context = context
	self._state = Constants.RoundState.Waiting
	self._currentSession = nil
	self._sessionsById = {}
	self._sessionIdByUserId = {}
	self._participantByPlayer = {}
	self._maxConcurrentSessions = 1
	self._connections = {}
	self._rewardedMatches = {}

	-- Validar existencia de Workspace.Lobby.SpawnLocation
	local lobby = workspace:FindFirstChild("Lobby")
	local spawnLocation = lobby and lobby:FindFirstChild("SpawnLocation")
	if not spawnLocation then
		warn("[RoundService] Lobby SpawnLocation not found")
	end

	-- Garantizar Remotes requeridos
	self:_ensureRemotes()

	-- Manejar votos de mapa desde clientes
	local mapSelectionRemote = self:_getRemote("Match", "MapSelection")
	if mapSelectionRemote then
		table.insert(self._connections, mapSelectionRemote.OnServerEvent:Connect(function(player: Player, mapName: string, sessionId: SessionId?)
			self:SubmitMapVote(player, mapName, sessionId)
		end))
	end

	-- Manejar desconexiones de jugadores durante la partida
	local cinematicAction = self:_getRemote("Match", "EndCinematicAction")
	if cinematicAction then
		table.insert(self._connections, cinematicAction.OnServerEvent:Connect(function(player, action, sessionId, version, token)
			self:HandleCinematicAction(player, action, sessionId, version, token)
		end))
	end

	table.insert(self._connections, Players.PlayerRemoving:Connect(function(player: Player)
		self:_handlePlayerLeaving(player)
	end))
end

function RoundService:Start(context)
	self._context = context
	print("[RoundService] Servicio iniciado. Estado: Waiting")
end

function RoundService:_getMatchInstanceService()
	if self._context and self._context.GetService then
		local s = self._context:GetService("MatchInstanceService")
		if s then return s end
	end

	local servicesFolder = game:GetService("ServerScriptService"):FindFirstChild("Services")
	local mod = servicesFolder and servicesFolder:FindFirstChild("MatchInstanceService")
	if mod and mod:IsA("ModuleScript") then
		local ok, result = pcall(require, mod)
		if ok then return result end
	end
	return nil
end

