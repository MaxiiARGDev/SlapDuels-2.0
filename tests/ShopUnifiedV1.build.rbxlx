        <Item class="ModuleScript" referent="4278">
          <Properties>
            <string name="Name">CrateController</string>
            <string name="Source"><![CDATA[--!nonstrict
local Players=game:GetService("Players")
local RS=game:GetService("ReplicatedStorage")
local TweenService=game:GetService("TweenService")
local Http=game:GetService("HttpService")
local Chat=game:GetService("TextChatService")
local Catalog=require(RS.Shared.SlapCrates.Catalog)
local Appearance=require(RS.Shared.SlapCrates.Appearance)
local View=require(RS.Shared.SlapCrates.CrateShopView)
local OddsPresentation=require(RS.Shared.SlapCrates.OddsPresentation)
local OpeningConfig=require(RS.Shared.SlapCrates.OpeningConfig)
local Batch=require(RS.Shared.SlapCrates.BatchOpening)
local Gallery=require(script.Parent.Parent.CrateOpening.CrateRewardGallery)
local ShopLayout=require(script.Parent.Parent.UI.ShopLayout)
local RunService=game:GetService("RunService")
local Controller={}
local ERRORS={CommercialApprovalPending="Precio y probabilidades pendientes de aprobación.",ProductionBackendBlocked="Ventas bloqueadas: backend productivo pendiente.",
 PaidRandomItemsRestricted="Esta apertura no está habilitada por las políticas de Roblox o no se pudo verificar elegibilidad.",
 OddsChanged="Cambió el stock o la probabilidad. Volvé a consultar antes de continuar.",ViewOddsFirst="Consultá las probabilidades actuales primero.",
 LobbyOnly="Solo podés abrir cajas en el lobby.",InsufficientFunds="Coins insuficientes.",NoCrate="No tenés cajas cerradas.",
 NoEligibleResults="No quedan premios elegibles para vos.",RateLimited="Esperá un momento y reintentá.",DataNotLoaded="Esperá a que cargue tu perfil."}
function Controller:Init(context)
 self._context=context;self._connections={};self._seen={};self._worldSeen={};self._chatSeen={};self._worldModels={};self._pending={};self._busy=false
 self._products={};self._quoteCache={};self._snapshotVersion=0;self._selectionVersion=0;self._quoteVersion=0
 self._openQuantity=1
end
function Controller:SetCatalog(products)
 for _,product in ipairs(products)do if product.Category=="Crates"then self._products[product.Id]=product end end
end
function Controller:SetSnapshot(data,fromEvent)
 if type(data)~="table"then return end
 self._data=data;self._inventory=data.Inventory;self._snapshotVersion+=1
 self:_renderPanel()
 if not fromEvent and self._context and self._context.GetController then
  local shop=self._context:GetController("ShopController")
  if shop then
   local merged=table.clone(shop._playerData or {});for k,v in pairs(data)do merged[k]=v end;shop._playerData=merged
   if shop._refreshStates then shop:_refreshStates()end
  end
 end
end
function Controller:GetView(product,snapshot)
 local state=View.State(product,snapshot or self._data,self._quoteCache[product.Id],workspace:GetServerTimeNow(),self._busy or self._quoting)
 local quantity=self._openQuantity or 1
 if quantity>state.Quantity then state.OpenEnabled=false end
 local cinematic=self._context and self._context.GetController and self._context:GetController("CrateStandCinematicController")
 if cinematic and cinematic.IsPlaying and cinematic:IsPlaying()then state.OpenEnabled=false end
 return state
end
function Controller:_renderPanel()
 if not self._panel or not self._crateId then return end
 local product=self._products[self._crateId];if not product then return end
 local state=View.State(product,self._data,self._quoteCache[product.Id],workspace:GetServerTimeNow(),self._busy or self._quoting)
 self._panel.Count.Text=state.Quantity.." cajas · "..state.CoinsText
 self._panel.Price.Text=state.PriceText
 local quote=self._quoteCache[product.Id]
 local unavailable=quote and not quote.Ok and(View.Errors[quote.Code]or 'Esta caja no está disponible.')
 self._panel.Status.Text=self._quoting and "Cargando premios…"or(self._pendingAction and "Sin confirmar: reintentá la misma acción."or unavailable or(state.NeedQuote and "Actualizando disponibilidad…"or "Elegí cuántas cajas abrir."))
 self._panel.Buy.Text="COMPRAR";self._panel.Buy.Active=state.BuyEnabled and not self._pendingAction
 self._panel.Open.Visible=false;self._panel.ViewOdds.Visible=false;self._panel.Receipt.Visible=false
 local old=self._panel:FindFirstChild("OpenQuantities");if old then old.Visible=false end
 for _,quantity in ipairs({1,5,10})do
  local button=self._panel.OpenActions["X"..quantity];button.Text="ABRIR x"..quantity
  button.Active=state.OpenEnabled and state.Quantity>=quantity and not self._pendingAction
  if self._pendingAction then
   local pending=self._pendingAction
   if not self._busy and pending.CrateId==self._crateId then
    if pending.Kind=="Open"and pending.Args.Quantity==quantity then button.Active=true
    elseif pending.Kind=="Purchase"then self._panel.Buy.Active=true end
   end
  end
  button.AutoButtonColor=button.Active;button.TextTransparency=button.Active and 0 or .5
 end
 self._panel.Buy.AutoButtonColor=self._panel.Buy.Active
end
function Controller:_call(action,args)
 local ok,result=pcall(self._request.InvokeServer,self._request,action,args or {})
 return if ok and type(result)=="table" then result else {Ok=false,Code="NoResponse"}
end
function Controller:_status(result)
 self._panel.Status.Text=if result.Ok then "Operación confirmada." else (View.Errors[result.Code]or ERRORS[result.Code] or tostring(result.Code))
end
function Controller:ShowCrate(id,embedded)
 if self._busy or not self._panel or not self._request or not self._products[id] then return end
 if self._pendingAction and self._pendingAction.CrateId~=id then return end
 local shop=self._context:GetController("ShopController")
 if not embedded and shop and shop._ui then
  shop._category="Crates";shop._selectedId=id;shop._detailFocused=true
  if not shop._isOpen then shop:Open()else shop._ui.Main.Visible=true;shop:_renderTabs();shop:_renderCatalog()end
 end
 if self._crateId==id and self._panel.Visible then return end
 self._selectionVersion+=1;local selection=self._selectionVersion
 self._crateId=id;self._openQuantity=if self._pendingAction then(self._pendingAction.Args.Quantity or 1)else 1
 self._quote=nil;self._quoteCache[id]=nil;self._quoting=true;self._panel.Visible=true
 self._panel.Title.Text=self._products[id].DisplayName
 self._panel.Buy.Active=false;self._panel.Open.Active=false
 self._panel.Outcomes.Text="Consultando resultados y elegibilidad…"
 local oddsList=self._panel:FindFirstChild("OddsList")
 if oddsList then oddsList.Visible=false end
 self._panel.Outcomes.Visible=false
 if self._gallery then self._gallery:Clear()end
 task.spawn(function()
  local revision=self._snapshotVersion
  local inventory=self:_call("Inventory",{})
  if self._crateId~=id or self._selectionVersion~=selection then return end
  if inventory.Ok and revision==self._snapshotVersion then self:SetSnapshot(inventory.Snapshot) end
  task.wait(.3)
  if self._selectionVersion==selection then self:_quoteCurrent(id)end
 end)
end
function Controller:_renderOdds(result)
 if self._gallery then self._gallery:Set(result)end
 local legacy=self._panel:FindFirstChild("OddsList");if legacy then legacy.Visible=false end
 self._panel.Outcomes.Visible=false
 if not result.Ok then self:_status(result)end
end
function Controller:_quoteCurrent(id)
 if id~=self._crateId or self._busy then return end
 self._quoteVersion+=1;local query=self._quoteVersion;local selection=self._selectionVersion
 local revision=self._snapshotVersion;self._quoting=true;self:_renderPanel()
 local result=self:_call("Quote",{CrateId=id})
 if id~=self._crateId or query~=self._quoteVersion or selection~=self._selectionVersion then return end
 self._quoting=false;self._quoteCache[id]=result;self._quote=if result.Ok then result else nil
 if result.Ok and revision==self._snapshotVersion then self:SetSnapshot(result.Snapshot)end
 self:_renderOdds(result)
 self:_renderPanel()
 local shop=self._context and self._context.GetController and self._context:GetController("ShopController")
 if shop and shop._refreshStates then shop:_refreshStates()end
 if result.Ok then task.delay(25,function()if self._quoteCache[id]==result then self:_renderPanel();if self._crateId==id and self._panel.Visible and not self._busy then self:_quoteCurrent(id)end;if shop and shop._refreshStates then shop:_refreshStates()end end end)end
 if not result.Ok and({NoResponse=true,InternalError=true,RateLimited=true,DataNotLoaded=true})[result.Code]then
  task.delay(2,function()if self._quoteCache[id]==result and self._crateId==id and self._panel.Visible and not self._busy and not self._pendingAction then self:_quoteCurrent(id)end end)
 end
end
function Controller:_mutate(action)
 if self._busy or self._quoting or not self._crateId or(action~="Purchase"and action~="Open")then return end
 local id=self._crateId;local key=id..":"..action;local pending=self._pendingAction
 if pending and pending.Key~=key then return end
 if not pending then
  local state=self:GetView(self._products[id]);local allowed=if action=="Purchase"then state.BuyEnabled else state.OpenEnabled
  if not allowed or not self._quote then self:_renderPanel();return end
  pending={Key=key,CrateId=id,Kind=action,Args={CrateId=id,QuoteToken=self._quote.Token,OperationId=Http:GenerateGUID(false),StandId=self._standId,Quantity=if action=="Open"then(self._openQuantity or 1)else nil}}
  self._pendingAction=pending
 end
 self._busy=true;self:_renderPanel()
 task.spawn(function()
  local revision=self._snapshotVersion
  local result=self:_call(action,pending.Args)
  self._busy=false
  if result.Ok then
   self._pendingAction=nil
   if revision==self._snapshotVersion then self:SetSnapshot(result.Snapshot)end
   if action=="Open"then
    if not result.Presentation or result.Presentation.Mode=="Spin"then
     self:_spin({OpeningId=result.Operation.UnitId,Operation=result.Operation,Duration=Catalog.Crates.ById[id].RollDuration})
    end
    self._quote=nil;self._quoteCache[id]=nil
    self:_renderOdds({Ok=false,Code="ViewOddsFirst"})
   end
  elseif result.Code~="NoResponse" and result.Code~="InternalError"and result.Code~="RateLimited"and result.Code~="DataNotLoaded"and result.Code~="TransactionInProgress"and result.Code~="StockCommitPending"then
   self._pendingAction=nil;self._quote=nil;self._quoteCache[id]={Ok=false,Code=result.Code}
  end
  self:_renderPanel();if not result.Ok then self:_renderOdds(result);self:_status(result)end
  if not self._pendingAction then task.delay(.35,function()if self._crateId==id and self._panel.Visible then self:_quoteCurrent(id)end end)end
 end)
end
function Controller:_spin(packet)
 if type(packet)~="table" or not packet.OpeningId or self._seen[packet.OpeningId]then return end
 local reward=packet.Operation and Catalog.Rewards[packet.Operation.RewardId]
 if not reward then return end
 self._seen[packet.OpeningId]=true
 if self._tween then self._tween:Cancel()end
 if self._tickConnection then self._tickConnection:Disconnect()end
 local spin=self._spinPanel;spin.Visible=true;spin.Close.Visible=false
 spin.Result.Text="Abriendo…";local strip=spin.Window.RollingStrip
 for _,c in ipairs(strip:GetChildren())do if c:IsA("GuiObject") and c.Name~="RewardTemplate" then c:Destroy()end end
 local ids={}for id in pairs(Catalog.Rewards)do table.insert(ids,id)end;table.sort(ids)
 local winnerIndex=41;local stride=140
 for i=1,45 do
  local r=if i==winnerIndex then reward else Catalog.Rewards[ids[((i*7)%#ids)+1]]
  local card=strip.RewardTemplate:Clone();card.Name="Reward_"..i;card.Visible=true
  card.Position=UDim2.fromOffset((i-1)*stride,0);card.Title.Text=r.DisplayName
  card.BackgroundColor3=Catalog.Variations.ById[r.VariationId].Color;card.Parent=strip
 end
 strip.Position=UDim2.fromOffset(0,0)
 local target=spin.Window.AbsoluteSize.X/2-((winnerIndex-1)*stride+66)
 local lastIndex=0
 self._tickConnection=strip:GetPropertyChangedSignal("Position"):Connect(function()
  local index=math.floor(-strip.Position.X.Offset/stride)
  if index~=lastIndex then lastIndex=index;if spin.Tick.SoundId~="" then spin.Tick:Play()end end
 end)
 local duration=math.clamp(tonumber(packet.Duration) or 5,1,30)
 self._tween=TweenService:Create(strip,TweenInfo.new(duration,Enum.EasingStyle.Quint,Enum.EasingDirection.Out),{Position=UDim2.fromOffset(target,0)})
 local openingId=packet.OpeningId;self._currentSpin=openingId
 self._tween.Completed:Once(function(state)
  if self._currentSpin~=openingId or state~=Enum.PlaybackState.Completed then return end
  if self._tickConnection then self._tickConnection:Disconnect();self._tickConnection=nil end
  spin.Result.Text="Obtuviste "..reward.DisplayName;spin.Close.Visible=true
  if spin.Reveal.SoundId~=""then spin.Reveal:Play()end
 end)
 self._tween:Play()
end
function Controller:_world(packet)
 if not packet.OpeningId or self._worldSeen[packet.OpeningId] or typeof(packet.Position)~="Vector3"then return end
 if Players.LocalPlayer:GetAttribute("MatchId") or Players.LocalPlayer:GetAttribute("ResultsSessionId")then return end
 local root=Players.LocalPlayer.Character and Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
 if not root or (root.Position-packet.Position).Magnitude>80 then return end
 local age=workspace:GetServerTimeNow()-(packet.StartedAt or 0)
 local duration=math.clamp(packet.Duration or 5,1,30);if age>duration+2 then return end
 local model=RS.CrateEffects:FindFirstChild(packet.Model)
 if not model then return end
 self._worldSeen[packet.OpeningId]=true
 local clone=model:Clone();clone.Name="CrateOpening_"..packet.OpeningId
 local vfxTemplate=RS.CrateEffects:FindFirstChild(packet.VFX or packet.Model)
 if vfxTemplate and vfxTemplate~=model then
  local emitter=vfxTemplate:FindFirstChildWhichIsA("ParticleEmitter",true)
  local body=clone:FindFirstChild("Body")
  if emitter and body then emitter:Clone().Parent=body end
 end
 clone:PivotTo(CFrame.new(packet.Position));clone.Parent=workspace;self._worldModels[clone]=true
 local reward=Catalog.Rewards[packet.Operation.RewardId]
 local previews=RS:FindFirstChild("SlapVariationPreviews")
 local slapPreviews=previews and previews:FindFirstChild(reward.SlapId)
 local rewardModel=(slapPreviews and slapPreviews:FindFirstChild(reward.VariationId)) or RS.CrateRewardPreviews:FindFirstChild(reward.SlapId)
 local visual=rewardModel and rewardModel:Clone()
 local stopped=false;local pulse=clone:FindFirstChild("Body")
 if pulse then TweenService:Create(pulse,TweenInfo.new(math.max(.1,duration-age),Enum.EasingStyle.Sine,Enum.EasingDirection.InOut),{Orientation=Vector3.new(0,540,0)}):Play()end
 task.delay(math.max(0,duration-age-.7),function()
  if not clone.Parent then return end
  local lid=clone:FindFirstChild("Lid")
  if lid then TweenService:Create(lid,TweenInfo.new(.5),{Position=packet.Position+Vector3.new(0,3,0),Transparency=1}):Play()end
  if visual then
   visual:PivotTo(CFrame.new(packet.Position+Vector3.new(0,1,0)));visual.Parent=clone
   local v=Catalog.Variations.ById[reward.VariationId]
   local effect=RS.SlapVariationEffects:FindFirstChild(v.VisualProfile)
   local part=visual:FindFirstChildWhichIsA("BasePart",true)
   if part and effect then
    Appearance.Apply(part,effect)
    for _,child in ipairs(effect:GetChildren())do
     if child:IsA("Sound") and child.Name==v.SFX and child.SoundId~=""then local sound=child:Clone();sound.Name="VariationReveal";sound.Parent=part;sound:Play()end
    end
   end
  end
  for _,item in ipairs(clone:GetDescendants())do
   if item:IsA("ParticleEmitter")then
    local burst=item:GetAttribute("RevealBurstCount")
    if type(burst)=="number"then item:Emit(math.clamp(math.floor(burst),0,12))
    elseif item:GetAttribute("SlapVariationEmitter")~=true then item:Emit(18)end
   elseif item:IsA("Sound") and item.Name==packet.SFX and item.SoundId~=""then item:Play()end
  end
 end)
 task.delay(math.max(0,duration-age)+2,function()if not stopped then stopped=true;clone:Destroy();self._worldModels[clone]=nil end end)
end
function Controller:Start()
 task.spawn(function()
  local hud=Players.LocalPlayer:WaitForChild("PlayerGui"):WaitForChild("ShopHUD",15)
  local remotes=RS:WaitForChild("Remotes"):WaitForChild("Crates",15)
  if not hud or not remotes then return end
  local _,_,panel=ShopLayout.Prepare(hud)
  self._request=remotes:WaitForChild("Request",10);self._panel=panel;self._spinPanel=hud:WaitForChild("CrateSpinPanel",10)
  if not self._panel or not self._spinPanel or not self._request then warn("[Crates] Missing editable UI");return end
  self._panel.Visible=false;self._spinPanel.Visible=false
  self._gallery=Gallery.new(self._panel)
  local function on(signal,fn)table.insert(self._connections,signal:Connect(fn))end
  local playerRemotes=RS.Remotes:WaitForChild("Player",10)
  local updated=playerRemotes and playerRemotes:WaitForChild("DataUpdated",10)
  if updated then on(updated.OnClientEvent,function(data)self:SetSnapshot(data,true)end)end
  on(self._panel.Close.Activated,function()self._panel.Visible=false end)
  on(self._panel.Buy.Activated,function()self:_mutate("Purchase")end)
  for _,quantity in ipairs({1,5,10})do
   local q=quantity;on(self._panel.OpenActions["X"..q].Activated,function()
    if self._busy then return end
    if self._pendingAction and(self._pendingAction.Kind~="Open"or self._pendingAction.Args.Quantity~=q)then return end
    self._openQuantity=q;self:_mutate("Open")
   end)
  end
  on(RunService.RenderStepped,function(dt)if self._gallery then self._gallery:Step(dt)end end)
  on(self._panel:GetPropertyChangedSignal("Visible"),function()
   if not self._panel.Visible then if self._gallery then self._gallery:HideModels()end
   elseif self._crateId and not self._busy and not self._quoting and not self._pendingAction then
    local quote=self._quoteCache[self._crateId]
    if not quote or not quote.ExpiresAt or workspace:GetServerTimeNow()>=quote.ExpiresAt then task.spawn(function()self:_quoteCurrent(self._crateId)end)end
   end
  end)
  local selector=self._panel:FindFirstChild("OpenQuantities")
  if selector then for _,quantity in ipairs(OpeningConfig.AllowedOpenQuantities)do
   local button=selector:FindFirstChild("X"..quantity)
   if button then
    on(button.Activated,function()
     if self._busy or self._pendingAction or not button.Active then return end
     self._openQuantity=quantity;self:_renderPanel()
    end)
    on(button.MouseEnter,function()if button.Active then button.TextStrokeTransparency=.35 end end)
    on(button.MouseLeave,function()button.TextStrokeTransparency=1 end)
   end
  end end
  on(self._panel.ViewOdds.Activated,function()if not self._busy then self:_quoteCurrent(self._crateId)end end)
  on(self._panel.Receipt.Activated,function()
   task.spawn(function()
    local result=self:_call("Inventory",{});if not result.Ok then self:_status(result);return end
    local last
    for _,op in pairs(result.Inventory.CrateOperations)do
     if op.Kind=="Open" and (not last or (op.CreatedAt or 0)>(last.CreatedAt or 0))then last=op end
    end
    if last then self._panel.Status.Text=if last.Quantity and last.Quantity>1 then "Lote conservado: "..last.Quantity.." premios · "..last.State else "Premio conservado: "..(Catalog.Rewards[last.RewardId] and Catalog.Rewards[last.RewardId].DisplayName or last.RewardId)
    else self._panel.Status.Text="Todavía no abriste cajas."end
   end)
  end)
  on(self._spinPanel.Close.Activated,function()self._spinPanel.Visible=false end)
  on(remotes.Reveal.OnClientEvent,function(p)self:_spin(p)end)
  on(remotes.World.OnClientEvent,function(p)self:_world(p)end)
  on(remotes.Announce.OnClientEvent,function(p)
   if self._chatSeen[p.OpeningId]then return end
   local reward=Catalog.Rewards[p.RewardId];local crate=Catalog.Crates.ById[p.CrateId]
   if not reward or not crate then return end
   self._chatSeen[p.OpeningId]=true
   local channels=Chat:FindFirstChild("TextChannels");local channel=channels and channels:FindFirstChild("RBXGeneral")
   local name=if type(p.PlayerName)=="string" and p.PlayerName:match("^[%w_]+$")then p.PlayerName else "Jugador "..tostring(p.UserId)
   if channel then channel:DisplaySystemMessage("¡"..name.." obtuvo "..reward.DisplayName.." al abrir "..crate.DisplayName.."!")end
  end)
  on(Players.LocalPlayer:GetAttributeChangedSignal("MatchId"),function()
   if Players.LocalPlayer:GetAttribute("MatchId")then
    self._panel.Visible=false;self._spinPanel.Visible=false
    if self._tween then self._tween:Cancel()end
    for model in pairs(self._worldModels)do model:Destroy()end;table.clear(self._worldModels)
   end
  end)
  local shop=self._context:GetController("ShopController")
  if shop and shop._ui and shop._isOpen then shop:_refreshStates()end
 end)
end
function Controller:Destroy()
 if self._gallery then self._gallery:Destroy()end
 for _,c in ipairs(self._connections)do c:Disconnect()end
 if self._tickConnection then self._tickConnection:Disconnect()end
 if self._tween then self._tween:Cancel()end
 for model in pairs(self._worldModels)do model:Destroy()end
end
return Controller
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="4279">
          <Properties>
            <string name="Name">CrateStandCinematicController</string>
            <string name="Source"><![CDATA[--!nonstrict
local Players=game:GetService("Players")
local RS=game:GetService("ReplicatedStorage")
local Run=game:GetService("RunService")
local Tween=game:GetService("TweenService")
local CAS=game:GetService("ContextActionService")
local Config=require(RS.Shared.SlapCrates.OpeningConfig)
local Timeline=require(RS.Shared.SlapCrates.OpeningTimeline)
local Catalog=require(RS.Shared.SlapCrates.Catalog)
local Appearance=require(RS.Shared.SlapCrates.Appearance)
local CameraLease=require(script.Parent.Parent.CrateOpening.CameraLease)
local CharacterVisibility=require(script.Parent.Parent.CrateOpening.CharacterVisibility)
local CinematicConfig=require(script.Parent.Parent.CrateOpening.CinematicConfig)
local CinematicMotion=require(script.Parent.Parent.CrateOpening.CinematicMotion)
local CinematicTransition=require(script.Parent.Parent.CrateOpening.CinematicTransition)
local StandPromptVisibility=require(script.Parent.Parent.CrateOpening.StandPromptVisibility)
local RewardGallery=require(script.Parent.Parent.CrateOpening.RewardGallery)
local RewardSpin3D=require(script.Parent.Parent.CrateOpening.RewardSpin3D)
local RewardVFX=require(script.Parent.Parent.CrateOpening.RewardVFX)
local RewardRevealProfile=require(script.Parent.Parent.CrateOpening.RewardRevealProfile)
local Batch=require(RS.Shared.SlapCrates.BatchOpening)
local VisualProfile=require(script.Parent.Parent.CrateOpening.VisualProfile)
local OverlayPresenter=require(script.Parent.Parent.CrateOpening.RewardOverlayPresenter)
local Controller={Name="CrateStandCinematicController"}
local player=Players.LocalPlayer
local function safeVisual(model)
 for _,obj in ipairs(model:GetDescendants())do
  if obj:IsA("LuaSourceContainer")then obj:Destroy()
  elseif obj:IsA("BasePart")then obj.Anchored=true;obj.CanCollide=false;obj.CanTouch=false;obj.CanQuery=false
  elseif obj:IsA("ParticleEmitter")then obj.Enabled=false;obj.Rate=math.min(obj.Rate,8)end
 end
end
local function standById(id)
 local folder=workspace:FindFirstChild("CrateStands");local result
 for _,stand in ipairs(folder and folder:GetChildren()or {})do if stand:GetAttribute("StandId")==id then if result then return nil end;result=stand end end
 return result
end
function Controller:Init(context)
 self._context=context;self._runs={};self._seen={};self._idle={};self._connections={};self._cooldowns={}
 self._plan=Timeline.Build(Config)
end
function Controller:IsPlaying()return self._private~=nil end
function Controller:_priority()
 local ending=self._context:GetController("EndCinematicController")
 return player:GetAttribute("MatchId")~=nil or player:GetAttribute("ResultsSessionId")~=nil or(ending and ending:IsPlaying())
end
function Controller:_restore(run)
 if run.Restored then return end;run.Restored=true
 if run.Action then CAS:UnbindAction(run.Action)end
 local character=player.Character;local humanoid=character and character:FindFirstChildOfClass("Humanoid")
 if humanoid and humanoid.Health<=0 then character=nil end
 if run.Lease then CameraLease.Restore(run.Lease,character,self:_priority()or workspace.CurrentCamera~=run.Lease.Camera)end
 CharacterVisibility.Release(run.Visibility);run.Visibility=nil
 if run.MusicToken then
  local music=self._context:GetController("MusicController")
  if music then music:Resume("CrateStand:"..run.Id,run.MusicToken,.3)end
 end
end
function Controller:_stop(id,reason)
 local run=self._runs[id];if not run then return end
 self._runs[id]=nil
 local restored,failure=pcall(self._restore,self,run)
 if not restored then warn("[CrateStand] Restore failure: "..tostring(failure))end
 CharacterVisibility.Release(run.Visibility);run.Visibility=nil
 StandPromptVisibility.Release(run.PromptVisibility);run.PromptVisibility=nil
 if self._private==run then self._private=nil end
 if run.Private and reason~="ServerRelease"and self._request then
  -- A late cleanup can only release its own authoritative OpeningId.
  local request=self._request;local openingId=run.Id
  task.spawn(function()pcall(request.InvokeServer,request,"CancelOpening",{OpeningId=openingId})end)
 end
 for _,t in ipairs(run.Tweens)do pcall(function()t:Cancel();t:Destroy()end)end
 for _,obj in ipairs(run.Objects)do pcall(function()obj:Destroy()end)end
 if run.Private and self._overlay then self._overlay:Reset(run.Id)end
 if run.Private and self._hud then
  CinematicTransition.Reset(self._hud)
  self._hud.Enabled=false;self._hud.Transition.BackgroundTransparency=1;self._hud.Flash.BackgroundTransparency=1
  self._hud.Transition.Visible=false;self._hud.Flash.Visible=false
 end
end
function Controller:_sound(run,name)
 local sound=run.Effects:FindFirstChild(name,true)
 if sound and sound:IsA("Sound")and sound.SoundId~=""then sound:Play()end
end
function Controller:_whoosh(run,name)
 if not run.Private then return end
 local source=run.Effects:FindFirstChild(name,true)
 if source and source:IsA("Sound")and source.SoundId~=""then
  local sound=source:Clone();sound.Volume=CinematicConfig.Audio.Volume
  sound.Parent=game:GetService("SoundService");table.insert(run.Objects,sound);sound:Play()
 end
end
function Controller:_phase(run,stage)
 if stage==run.Stage then return end;run.Stage=stage
 self:_sound(run,stage)
 VisualProfile.Emit(run.Effects,stage,run.Profile)
 if run.CrateDefinition and run.CrateDefinition.PremiumOnly and run.Chest then VisualProfile.Emit(run.Chest,stage,run.Profile)end
 if stage=="Intro"then self:_whoosh(run,CinematicConfig.Audio.Close)
 elseif stage=="CameraReveal"and run.Private then
  run.Visibility=CharacterVisibility.Acquire(Players,run.Id)
  run.Lease.Camera.CameraType=Enum.CameraType.Scriptable
  self:_whoosh(run,CinematicConfig.Audio.Open)
 elseif stage=="Outro"then
  self:_whoosh(run,CinematicConfig.Audio.Close)
 end
 if stage=="Flash"then
  if run.Private then
   self._hud.Flash.BackgroundTransparency=.25
   local t=Tween:Create(self._hud.Flash,TweenInfo.new(Config.Cinematic.FlashDuration),{BackgroundTransparency=1})
   table.insert(run.Tweens,t);t:Play()
  end
 elseif stage=="Reward"then
  if not run.Gallery and not run.Spin3D then self:_revealWinner(run,run.Plan and run.Plan.Stages[8].Start or 0)end
 end
end
function Controller:_revealWinner(run,elapsed)
 if run.Revealed then return end;run.Revealed=true
 run.Reward.Parent=run.Scene;run.Label.Enabled=true;self:_showReward(run)
 if run.RewardSound and run.RewardSound.SoundId~=""then run.RewardSound:Play()end
 if run.RewardVFX then RewardVFX.Reveal(run,run.RewardVFX,elapsed)else
  for _,item in ipairs(run.Reward:GetDescendants())do if item:IsA("ParticleEmitter")then item:Emit(math.min(item:GetAttribute("RevealBurstCount")or 6,12))end end
 end
end
function Controller:_showReward(run)
 if not run.RewardDefinition then return end
 if run.Private and self._overlay and CinematicConfig.RewardOverlayByMode.StandCinematic then
  self._overlay:Show(run,Catalog.Slaps.ById[run.RewardDefinition.SlapId],run.RewardVariation)
 end
 local special=if run.GlobalFX then run.GlobalFX.Profile and run.GlobalFX.Profile.Rank>=4 else run.Profile and run.Profile.Special
 if special and not run.SpecialPlayed then run.SpecialPlayed=true;self:_sound(run,"Special")end
end
function Controller:Play(packet)
 if not self._plan or packet.Mode~="StandCinematic"or type(packet.OpeningId)~="string"or self._seen[packet.OpeningId]
  or type(packet.StartedAt)~="number"or packet.StartedAt~=packet.StartedAt or type(packet.Operation)~="table"then return end
 local age=workspace:GetServerTimeNow()-packet.StartedAt
 local quantity=Batch.Quantity(packet.Operation.Quantity);if not quantity then return end
 local plan=Timeline.Build(Config,quantity);if not plan then return end
 if age< -1 or age>=plan.Duration or self:_priority()then return end
 if quantity>1 then
  if type(packet.Operation.Rewards)~="table"or #packet.Operation.Rewards~=quantity then return end
  for _,unit in ipairs(packet.Operation.Rewards)do if type(unit)~="table"or not Catalog.Rewards[unit.RewardId]then return end end
 end
 local stand=standById(packet.StandId);local reward=Catalog.Rewards[packet.Operation.RewardId]
 local crate=Catalog.Crates.ById[packet.Operation.CrateId]
 if not stand or not reward or not crate then return end
 local private=packet.BuyerUserId==player.UserId
 if not private and packet.Exclusive~=true then return end
 if private and self._private then
  local old=self._private
  if workspace:GetServerTimeNow()-old.Packet.StartedAt>=(old.Plan or self._plan).Duration then self:_stop(old.Id,"Completed")else return end
 end
 local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
 local radius=if private then Config.Stand.MaxActivationDistance else Config.Stand.SpectatorRadius
 if not root or(root.Position-stand.InteractionPart.Position).Magnitude>radius then return end
 local count=0;for _ in pairs(self._runs)do count+=1 end;if count>=6 then return end
 local run={Id=packet.OpeningId,Packet=packet,Stand=stand,Plan=plan,Private=private,Objects={},Tweens={},Character=player.Character}
 run.CrateDefinition=crate
 local input=game:GetService("UserInputService")
 run.VisualBudget=RewardVFX.Budget(input and input.TouchEnabled==true,quantity)
 local best,index=RewardRevealProfile.Best(Batch.Rewards(packet.Operation),Catalog)
 run.GlobalFX={Profile=best,Index=index,At=plan.Stages[8].Start+(if quantity>1 then ((index or 1)-1)*CinematicConfig.Gallery.Stagger else 0)}
 self._seen[run.Id]=packet.StartedAt;self._runs[run.Id]=run
 local ok,err=pcall(function()
  if private then
   local navigation=self._context:GetController('WindowNavigationController')
   local premium=self._context:GetController("PremiumShopController");if premium and not navigation then premium:Close()end
   run.Lease=CameraLease.Acquire(workspace.CurrentCamera,run.Id,player.Character);assert(run.Lease,"CameraBusy")
   self._private=run
   if CinematicConfig.HideStandPrompt then run.PromptVisibility=StandPromptVisibility.Acquire(stand,run.Id)end
   local shop=self._context:GetController("ShopController");if shop and not navigation then shop:Close()end
   local crates=self._context:GetController("CrateController");if crates and crates._panel and not navigation then crates._panel.Visible=false end
   self._hud.Enabled=true;self._hud.Transition.BackgroundTransparency=1;self._hud.Flash.BackgroundTransparency=1
   self._hud.Transition.Visible=true;self._hud.Flash.Visible=true
   if self._overlay then self._overlay:Reset()end
   local overlay=self._hud:FindFirstChild("RewardOverlay");if overlay then overlay.Visible=false end
   CinematicTransition.Reset(self._hud)
   run.Action="CrateStand:"..run.Id
   CAS:BindActionAtPriority(run.Action,function()return Enum.ContextActionResult.Sink end,false,3000,table.unpack(Enum.PlayerActions:GetEnumItems()))
   local music=self._context:GetController("MusicController");if music then run.MusicToken=music:Suspend("CrateStand:"..run.Id,.3)end
  end
  local scene=stand.PresentationTemplate:Clone();scene.Name="CratePresentation_"..run.Id;scene.Parent=workspace
  table.insert(run.Objects,scene);run.Scene=scene;run.Effects=scene.Effects
  run.Effects:PivotTo(stand.SpawnPoint.CFrame);safeVisual(scene)
  local fx=run.Effects.FXAnchor;fx.EnergyBeam.Attachment0=fx.EnergyFrom;fx.EnergyBeam.Attachment1=fx.EnergyTo
  run.Chest=assert(RS.CrateEffects:FindFirstChild(crate.Model)):Clone();safeVisual(run.Chest)
  run.Chest.Parent=scene;table.insert(run.Objects,run.Chest);run.BaseScale=run.Chest:GetScale()
  local palette={};local paletteSeen={}
  for _,id in ipairs(packet.Operation.PreviewRewardIds or {})do
   local d=Catalog.Rewards[id];local v=d and Catalog.Variations.ById[d.VariationId]
   if v and not paletteSeen[v.Id]then paletteSeen[v.Id]=true;table.insert(palette,v.Color)end
  end
  local bestUnit=Batch.Rewards(packet.Operation)[index or 1]
  local bestReward=Catalog.Rewards[bestUnit.RewardId]
  run.ChestVFX=RewardVFX.Chest(run,run.Chest,palette,Catalog.Variations.ById[bestReward.VariationId])
  local previews=RS:FindFirstChild("SlapVariationPreviews");local slap=previews and previews:FindFirstChild(reward.SlapId)
  local source=slap and slap:FindFirstChild(reward.VariationId)
  source=source or RS.CrateRewardPreviews:FindFirstChild(reward.SlapId);assert(source,"RewardPreviewMissing")
  run.Reward=source:Clone();table.insert(run.Objects,run.Reward);safeVisual(run.Reward)
  local variation=Catalog.Variations.ById[reward.VariationId]
  run.Profile=VisualProfile.For(variation);run.RewardDefinition=reward
  local part=run.Reward:FindFirstChildWhichIsA("BasePart",true)
  if part then
   local profile=RS.SlapVariationEffects:FindFirstChild(variation.VisualProfile)
   Appearance.Apply(part,profile)
   local sound=profile and profile:FindFirstChild(variation.SFX,true)
   if sound and sound:IsA("Sound")then run.RewardSound=sound:Clone();run.RewardSound.Parent=part end
  end
  run.Label=scene.RewardBillboard;run.Label.Adornee=scene.RewardAnchor
  run.Label.Title.Text="¡RECOMPENSA OBTENIDA!";run.Label.Slap.Text=Catalog.Slaps.ById[reward.SlapId].DisplayName
  run.Label.Variation.Text=variation.DisplayName;run.Label.Variation.TextColor3=variation.Color
  run.RewardVariation=variation
  local beam=fx.EnergyBeam;run.BeamWidth=beam.Width0;beam.Color=ColorSequence.new(variation.Color)
  for _,item in ipairs(run.Effects:GetDescendants())do if item:IsA("PointLight")then item.Color=variation.Color end end
  if quantity>1 then run.Label.Enabled=false;run.Gallery=RewardGallery.Create(run,packet.Operation.Rewards,safeVisual)end
  if quantity==1 then
   run.RewardVFX=RewardVFX.Attach(run,run.Reward,variation,packet.Operation.EffectivePercent,true)
   run.Spin3D=RewardSpin3D.Create(run,packet.Operation.PreviewRewardIds,safeVisual)
   if run.Spin3D then run.Label.Enabled=false;run.GlobalFX.At=plan.Stages[8].Start+Config.RewardSpin.SpinDuration end
  end
  if age>=plan.Stages[8].Start then
   if not run.Gallery and not run.Spin3D then self:_revealWinner(run,age)end
  end
  self:_sound(run,"Start")
 end)
 if not ok then warn("[CrateStand] Presentation failed; reward retained: "..tostring(err));self:_stop(run.Id,"Error")end
end
function Controller:_update(run,now)
 if not run.Stand.Parent or player.Character~=run.Character or self:_priority()then self:_stop(run.Id,"ContextChanged");return end
 local hum=run.Character and run.Character:FindFirstChildOfClass("Humanoid")
 if not hum or hum.Health<=0 then self:_stop(run.Id,"CharacterLost");return end
 if run.Private and not run.Restored and(not CameraLease.Owns(run.Lease)or workspace.CurrentCamera~=run.Lease.Camera)then self:_stop(run.Id,"CameraLost");return end
 local plan=run.Plan or self._plan
 local elapsed=now-run.Packet.StartedAt;local stage,p=Timeline.At(plan,elapsed)
 if stage=="Done"then self:_stop(run.Id,"Completed");return end
 self:_phase(run,stage)
 if run.Private then CinematicTransition.Update(self._hud,CinematicMotion.Cover(stage,p,CinematicConfig.Transition))end
 local profile=run.Profile or {Light=1,Bob=.15,Spin=.65,Zoom=4}
 local height,scale=VisualProfile.Pose(stage,p)
 local pose=run.Stand.SpawnPoint.CFrame*CFrame.new(0,height,0)*CFrame.Angles(0,VisualProfile.Rotation(plan,elapsed),0)
 if stage=="Shake"then local strength=.025+.065*p;pose*=CFrame.new(math.sin(elapsed*55)*strength,math.cos(elapsed*47)*strength*.7,0)end
 if stage~="Reward"and stage~="Outro"and(stage~="Flash"or p<.25)then
  run.Chest:PivotTo(pose);run.Chest:ScaleTo(run.BaseScale*scale)
 else run.Chest.Parent=nil end
 run.Scene.RewardAnchor.CFrame=run.Stand.RewardPoint.CFrame
 if run.Reward.Parent and not run.Spin3D then run.Reward:PivotTo(run.Stand.RewardPoint.CFrame*CFrame.new(0,math.sin(elapsed*2)*profile.Bob,0)*CFrame.Angles(0,elapsed*profile.Spin,0))end
 if run.Spin3D and RewardSpin3D.Update(run,elapsed,workspace.CurrentCamera)then self:_revealWinner(run,elapsed)end
 if run.RewardVFX then RewardVFX.Update(run.RewardVFX,elapsed);RewardVFX.Label(run.RewardVFX,run.Label,elapsed)end
 if run.ChestVFX then RewardVFX.UpdateChest(run.ChestVFX,stage,p,elapsed)end
 if run.Gallery then RewardGallery.Update(run,elapsed,workspace.CurrentCamera)end
 if run.PrimaryRewardRevealed then self:_showReward(run)end
 local light=run.Effects:FindFirstChildWhichIsA("PointLight",true)
 if light then light.Brightness=(if stage=="Flash"then (1-p)*3 elseif stage=="Growth"or stage=="Shake"then .8+p else .3)*profile.Light end
 run.Effects.FXAnchor.EnergyBeam.Enabled=stage=="Growth"or stage=="Shake"
 if run.BeamWidth then run.Effects.FXAnchor.EnergyBeam.Width0=run.BeamWidth*(.92+.08*math.sin(elapsed*4))end
 if run.Private then
  if stage=="Outro"and p>=CinematicConfig.Transition.OutroHandoff then
   if not run.Restored then
    CinematicTransition.Update(self._hud,.5)
    self:_restore(run);self:_whoosh(run,CinematicConfig.Audio.Open)
   end
  elseif stage~="Intro"and not run.Restored then
   local camera=run.Lease.Camera;local cameraPoint=run.Stand.CameraPoint
   -- Late packets can skip CameraReveal; acquire before the first camera write.
   if not run.Visibility then run.Visibility=CharacterVisibility.Acquire(Players,run.Id)end
   camera.CameraType=Enum.CameraType.Scriptable
   local focus=if stage=="Reward"or stage=="Outro"then run.Stand.RewardPoint.Position else pose.Position
   local dt=math.clamp(now-(run.LastCameraAt or now),0,.1);run.LastCameraAt=now
   local c=CinematicConfig.Camera
   run.CameraFocus=if run.CameraFocus then run.CameraFocus:Lerp(focus,1-math.exp(-c.FocusResponse*dt))else focus
   local motion=CinematicMotion.Sample(plan,elapsed,stage,p,c)
   local position=cameraPoint.Position:Lerp(focus,c.PushIn*math.sin(math.min(elapsed,8)*.2))
    +cameraPoint.CFrame.UpVector*c.IntroHeight*motion.Drop
    -cameraPoint.CFrame.LookVector*c.IntroBack*motion.Drop
   local target=run.CameraFocus+cameraPoint.CFrame.UpVector*c.IntroLookHeight*motion.Drop
   if run.Gallery and(stage=="Flash"or stage=="Reward"or stage=="Outro")then
    local desired=RewardGallery.CameraPosition(run,position)
    local blend=if stage=="Flash"then p*p*(3-2*p)else 1
    position=position:Lerp(desired,blend)
   elseif run.Spin3D and(stage=="Flash"or stage=="Reward"or stage=="Outro")then
    local desired=RewardSpin3D.CameraPosition(run,position)
    position=position:Lerp(desired,if stage=="Flash"then p*p*(3-2*p)else 1)
   end
   if run.GlobalFX then
    local x,y,angle=RewardVFX.Reaction(run.GlobalFX.Profile,elapsed-run.GlobalFX.At,run.VisualBudget.Mobile)
    motion.X=math.clamp(motion.X+x,-c.MaxPositionShake,c.MaxPositionShake)
    motion.Y=math.clamp(motion.Y+y,-c.MaxPositionShake,c.MaxPositionShake)
    motion.Pitch=math.clamp(motion.Pitch+angle,-math.rad(c.MaxDegreesShake),math.rad(c.MaxDegreesShake))
   end
   camera.CFrame=CFrame.lookAt(position,target,cameraPoint.CFrame.UpVector)
    *CFrame.new(motion.X,motion.Y,0)*CFrame.Angles(motion.Pitch,0,motion.Roll)
   camera.FieldOfView=math.clamp(run.Lease.FieldOfView-profile.Zoom*math.clamp(elapsed/plan.Duration,0,1)+motion.Fov,35,100)
  end
 end
end
function Controller:_idleUpdate(now)
 if now-(self._idleAt or -math.huge)<1/30 then return end;self._idleAt=now
 local updateLabels=now>=(self._labelsAt or 0);if updateLabels then self._labelsAt=now+.25 end
 local folder=workspace:FindFirstChild("CrateStands")
 for _,stand in ipairs(folder and folder:GetChildren()or {})do
  local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
  local base=stand:FindFirstChild("Base")
  if root and base and(root.Position-base.Position).Magnitude>math.max(60,Config.Stand.SpectatorRadius*2)then continue end
  local cache=self._idle[stand]
  if not cache then
   cache={Parts={},Lights={},Previews={}};self._idle[stand]=cache
   local decor=stand:FindFirstChild("VisualDecor")
   for _,item in ipairs(decor and decor:GetDescendants()or {})do
    if item:IsA("BasePart")and(item:GetAttribute("IdleMotion")or item.Parent.Name=="Shards"or item.Name=="Ring")then
     table.insert(cache.Parts,{Object=item,Pose=stand:GetPivot():ToObjectSpace(item.CFrame),Kind=item:GetAttribute("IdleMotion")or(if item.Name=="Ring"then "Rotate"else "Float")})
    elseif item:IsA("PointLight")then table.insert(cache.Lights,{Object=item,Brightness=item.Brightness})end
   end
  end
  for i,row in ipairs(cache.Parts)do if row.Object.Parent then
   local offset=if row.Kind=="Rotate"then CFrame.Angles(0,now*.16,0)else CFrame.new(0,math.sin(now*.9+i)*.12,0)*CFrame.Angles(0,math.sin(now*.5+i)*.06,0)
   row.Object.CFrame=stand:GetPivot()*row.Pose*offset
  end end
  for i,row in ipairs(cache.Lights)do if row.Object.Parent then row.Object.Brightness=row.Brightness*(.9+.1*math.sin(now*1.1+i))end end
  local anchors=stand:FindFirstChild("PreviewAnchors");local index=0
  for _,anchor in ipairs(anchors and anchors:GetChildren()or {})do
   if not anchor:IsA("BasePart")then continue end;index+=1
   local model=anchor:FindFirstChild("Decoration");local gui=anchor:FindFirstChildWhichIsA("BillboardGui")
   local visible=index<=Config.Stand.MaxIdleCrates and stand:GetAttribute("OpeningState")=="Idle"
    and not(self._private and self._private.Stand==stand)
   if model then
    local authored=cache.Previews[anchor]
    if not authored or authored.Model~=model then
     authored={Model=model,Pose=anchor.CFrame:ToObjectSpace(model:GetPivot())};cache.Previews[anchor]=authored
    end
    for _,part in ipairs(model:GetDescendants())do if part:IsA("BasePart")then part.LocalTransparencyModifier=if visible then 0 else 1 end end
    if visible then model:PivotTo(anchor.CFrame*CFrame.new(0,math.sin(now*1.2+index)*.15,0)*CFrame.Angles(0,now*.2,0)*authored.Pose)end
   end
   if gui then
    gui.Enabled=visible
    local crate=Catalog.Crates.ById[anchor:GetAttribute("CrateId")]
    if crate and updateLabels then
     gui.Title.Text=crate.DisplayName
     gui.Price.Text=if crate.PriceApproved then tostring(crate.PriceCoins).." Coins"else "Precio pendiente"
     gui.Status.Text=if not crate.OddsApproved then "Probabilidades pendientes"elseif not crate.Enabled then "No disponible"else "Ver probabilidades"
     local variation=Catalog.Variations.ById[crate.CrateId];if variation then gui.Title.TextColor3=variation.Color end
    end
   end
  end
 end
 for stand in pairs(self._idle)do if not stand.Parent then self._idle[stand]=nil end end
end
function Controller:_cooldownUpdate(now)
 local label=self._hud and self._hud:FindFirstChild("CooldownLabel");if not label then return end
 if Config.Stand.ReopenCooldown==0 then
  table.clear(self._cooldowns);label.Visible=false;if not self._private then self._hud.Enabled=false end;return
 end
 for id,at in pairs(self._cooldowns)do if at<=now then self._cooldowns[id]=nil end end
 local crates=self._context:GetController("CrateController");local standId=crates and crates._standId
 local deadline=standId and self._cooldowns[standId]or 0
 local show=deadline>now and not self._private and not self:_priority()
 label.Visible=show
 if show then label.Text="ESPERA PERSONAL · "..tostring(standId).." · "..string.format("%.1f",deadline-now).." s";self._hud.Enabled=true
 elseif not self._private then self._hud.Enabled=false end
end
function Controller:Start()
 task.spawn(function()
  self._hud=player:WaitForChild("PlayerGui"):WaitForChild("CrateOpeningHUD",15)
  local remotes=RS:WaitForChild("Remotes"):WaitForChild("Crates",15)
  if not self._hud or not remotes then warn("[CrateStand] Missing Edit resources");return end
  self._request=remotes:WaitForChild("Request",15)
  self._hud.Enabled=false
  local cooldownLabel=self._hud:FindFirstChild("CooldownLabel")
  if cooldownLabel and Config.Stand.ReopenCooldown==0 then cooldownLabel.Visible=false end
  self._overlay=OverlayPresenter.new(self._hud:FindFirstChild("RewardOverlay"))
  table.insert(self._connections,remotes:WaitForChild("StandPresentation").OnClientEvent:Connect(function(packet)
   if type(packet)~="table"then return end
   if packet.Kind=="Access"then
    local crates=self._context:GetController("CrateController");if crates then crates._standId=packet.StandId end
    local shop=self._context:GetController("ShopController");if shop and not self:_priority()and not self:IsPlaying()then shop:OpenCategory("Crates")end
   elseif packet.Kind=="Cancel"then
    self:_stop(packet.OpeningId,"ServerRelease")
    if type(packet.StandId)=="string"and type(packet.CooldownUntil)=="number"and packet.CooldownUntil<workspace:GetServerTimeNow()+60 then self._cooldowns[packet.StandId]=packet.CooldownUntil end
   elseif packet.Kind=="Opening"then self:Play(packet)end
  end))
  table.insert(self._connections,Run.RenderStepped:Connect(function()
   local now=workspace:GetServerTimeNow()
   self:_cooldownUpdate(now)
   for id,at in pairs(self._seen)do if now-at>60 then self._seen[id]=nil end end
   for id,run in pairs(self._runs)do
    local ok,err=pcall(self._update,self,run,now)
    if not ok then warn("[CrateStand] "..tostring(err));self:_stop(id,"Error")end
   end
   if self._plan and Config.Mode=="StandCinematic"and Config.Stand.Enabled then self:_idleUpdate(now)end
  end))
 end)
end
function Controller:Destroy()
 for id in pairs(self._runs)do self:_stop(id,"Destroy")end
 for _,connection in ipairs(self._connections)do connection:Disconnect()end
 self._cooldowns={}
 for stand,cache in pairs(self._idle)do if stand.Parent then
  for anchor,row in pairs(cache.Previews)do if anchor.Parent and row.Model.Parent==anchor then row.Model:PivotTo(anchor.CFrame*row.Pose)end end
  for _,row in ipairs(cache.Parts)do if row.Object.Parent then row.Object.CFrame=stand:GetPivot()*row.Pose end end
  for _,row in ipairs(cache.Lights)do if row.Object.Parent then row.Object.Brightness=row.Brightness end end
 end end
 self._idle={}
 if self._hud then self._hud.Enabled=false end
end
return Controller
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="4280">
          <Properties>
            <string name="Name">DeathFeedbackController</string>
            <string name="Source"><![CDATA[--!nonstrict
local Players=game:GetService("Players")
local Config=require(game.ReplicatedStorage.Shared.DeathFeedbackConfig)
local Catalog=require(game.ReplicatedStorage.Shared.DeathEffectDefinitions)
local Contract=require(game.ReplicatedStorage.Shared.DeathFeedbackContract)
local EffectPlayer=require(script.Parent.Parent.DeathFeedback.DeathEffectPlayer)
local Notifications=require(script.Parent.Parent.DeathFeedback.DeathNotifications)
local Controller={Name="DeathFeedbackController"}
local function trace(payload,phase,...)
 if type(payload)=="table" and payload.Debug then print("[RespawnDebug]",phase,payload.SessionId,payload.EliminationId,Players.LocalPlayer.UserId,payload.Generation,payload.Reason,payload.EffectId,...) end
end
function Controller:Init(context)
 self._context=context;self._seen={};self._effects={};self._connections={}
 self._state=nil;self._session=nil;self._version=-1
end
function Controller:Cleanup()
 self._cutoff=workspace:GetServerTimeNow()
 for _,scope in ipairs(self._effects) do scope:Destroy() end
 self._effects={}
 Notifications.Clear()
 local reward=self._context:GetController("KillRewardController")
 if reward then reward:Cleanup() end
end
function Controller:Receive(payload)
 local player=Players.LocalPlayer
 trace(payload,"FeedbackReceived",self._session,self._version,self._state)
 if type(payload)~="table" or type(payload.SessionId)~="string" or type(payload.EliminationId)~="string"
  or payload.SessionId~=player:GetAttribute("MatchId") or payload.SessionId~=self._session
  or payload.StateVersion~=self._version or not Contract.IsFeedbackState(self._state)
  or (payload.RewardOnly~=true and typeof(payload.ImpactCFrame)~="CFrame") or not Catalog[payload.EffectId]
  or (payload.Kind~="CreditedKill" and payload.Kind~="UnattributedFall")
  or type(payload.RewardCoins)~="number" or payload.RewardCoins~=payload.RewardCoins or payload.RewardCoins<0
  or type(payload.SentAt)~="number" or payload.SentAt<(self._cutoff or 0)
  or math.abs(workspace:GetServerTimeNow()-payload.SentAt)>Config.EventLifetime then
  trace(payload,"FeedbackRejectedContract","LocalVersion",self._version,"RemoteVersion",type(payload)=="table" and payload.StateVersion,"Cutoff",self._cutoff)
  return
 end
 local key=payload.SessionId..":"..payload.EliminationId
 if self._seen[key] then trace(payload,"FeedbackDuplicate");return end
 self._seen[key]=true
 for i=#self._effects,1,-1 do if self._effects[i].Dead then table.remove(self._effects,i) end end
 while #self._effects>=math.max(1,Config.DeathEffects.MaxConcurrentEffects) do table.remove(self._effects,1):Destroy() end
 if payload.RewardOnly~=true then
  local scope=EffectPlayer.Play(payload)
  table.insert(self._effects,scope)
  trace(payload,if scope.Dead then "EffectNotStarted" else "EffectStarted")
  Notifications.Play(payload)
 end
 local reward=self._context:GetController("KillRewardController")
 if reward then reward:PlayReceipt(payload) end
end
function Controller:Start()
 if self._started then return end;self._started=true
 local player=Players.LocalPlayer
 local match=game.ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Match")
 table.insert(self._connections,match:WaitForChild("StateChanged").OnClientEvent:Connect(function(state,metadata)
  if type(metadata)~="table" or metadata.SessionId~=player:GetAttribute("MatchId")
   or type(metadata.StateVersion)~="number" then return end
  if self._session==metadata.SessionId and metadata.StateVersion<self._version then return end
  if self._session~=metadata.SessionId then self:Cleanup();self._seen={} end
  self._session=metadata.SessionId;self._version=metadata.StateVersion;self._state=state
  if not Contract.IsFeedbackState(state) then self:Cleanup() end
 end))
 table.insert(self._connections,match:WaitForChild("DeathFeedback").OnClientEvent:Connect(function(payload)
  local ok,failure=pcall(self.Receive,self,payload)
  if not ok then warn("[DeathFeedback] "..tostring(failure));self:Cleanup() end
 end))
 table.insert(self._connections,player:GetAttributeChangedSignal("MatchId"):Connect(function()
  self:Cleanup();self._seen={};self._state=nil;self._session=nil;self._version=-1
  local reward=self._context:GetController("KillRewardController")
  if reward then reward:ResetSession() end
 end))
 -- Effect scopes contain only immutable impact snapshots/local clones, not Character references.
 table.insert(self._connections,Players.PlayerRemoving:Connect(function(leaving)if leaving==player then self:Cleanup() end end))
end
function Controller:Destroy()
 self:Cleanup()
 for _,connection in ipairs(self._connections) do connection:Disconnect() end
 self._connections={}
 self._started=false
end
return Controller
]]></string>
          </Properties>
