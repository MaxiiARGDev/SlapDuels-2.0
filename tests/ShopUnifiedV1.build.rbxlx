      <Item class="ModuleScript" referent="973">
        <Properties>
          <string name="Name">LeaderboardService</string>
          <string name="Source"><![CDATA[--!strict
-- LeaderboardService
-- Servicio autoritativo para gestionar y sincronizar las 3 pantallas de Tops en el Lobby:
-- 1. Top Wins (Screen_TopWins)
-- 2. Top Kills (Screen_TopKills)
-- 3. Top Rachas (Screen_TopRachas)
-- Utiliza OrderedDataStore en producción y sincroniza estadísticas reales al entrar/salir.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local DataStoreService = game:GetService("DataStoreService")
local ServerStorage = game:GetService("ServerStorage")
local Workspace = game:GetService("Workspace")

local LeaderboardService = {}
LeaderboardService.Name = "LeaderboardService"

LeaderboardService._context = nil :: any
LeaderboardService._playerService = nil :: any
LeaderboardService._playerDataService = nil :: any
LeaderboardService._isStudio = true
LeaderboardService._usernameCache = {} :: { [number]: string }
LeaderboardService._stores = {} :: { [string]: any }
LeaderboardService._refreshInterval = 60

local ORDERED_STORE_NAMES = {
	Wins = "SlapDuels_TopWins_v1",
	Kills = "SlapDuels_TopKills_v1",
	Rachas = "SlapDuels_TopRachas_v1",
}

local SCREEN_MAPPING = {
	Wins = {
		ModelName = "TopWins",
		PartName = "Screen_TopWins",
		GuiName = "SurfaceGui_TopWins",
		IconAllName = "Top_All_Wins",
		Title = "🏆 TOP VICTORIAS",
		Subtitle = "TOP 50 GLOBAL - WINS",
		StatCol = "VICTORIAS",
		SampleBase = 2500,
	},
	Kills = {
		ModelName = "TopKills",
		PartName = "Screen_TopKills",
		GuiName = "SurfaceGui_TopKills",
		IconAllName = "Top_All_Kills",
		Title = "💀 TOP ELIMINACIONES",
		Subtitle = "TOP 50 GLOBAL - KILLS",
		StatCol = "ELIMINACIONES",
		SampleBase = 8400,
	},
	Rachas = {
		ModelName = "TopRachas",
		PartName = "Screen_TopRachas",
		GuiName = "SurfaceGui_TopRachas",
		IconAllName = "Top_All_Streak",
		Title = "🔥 TOP RACHAS",
		Subtitle = "3 VICTORIAS = 1 RACHA",
		StatCol = "RACHAS",
		SampleBase = 450,
	},
}

local MOCK_NAMES = {
	"MaxiiDJ4K", "SlapMaster_99", "Nexus_Vortex", "ShadowNinja", "GhostRecon",
	"TitanSlayer", "BlazeGamer", "CyberWolf", "FrostByte", "EchoStrike",
	"RoguePhantom", "DarkMatter", "SolarFlare", "QuantumLeap", "ViperStrike",
	"ThunderBolt", "IronClad", "VelocityX", "StormRider", "PhoenixRise"
}

-- Función para resolver nombre de usuario con cache para evitar saturar rate limits
function LeaderboardService:_getPlayerName(userId: number): string
	if self._usernameCache[userId] then
		return self._usernameCache[userId]
	end

	local localPlayer = Players:GetPlayerByUserId(userId)
	if localPlayer then
		self._usernameCache[userId] = localPlayer.Name
		return localPlayer.Name
	end

	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)

	if ok and type(name) == "string" and name ~= "" then
		self._usernameCache[userId] = name
		return name
	end

	local fallback = "Player_" .. tostring(userId)
	self._usernameCache[userId] = fallback
	return fallback
end

function LeaderboardService:_formatNumber(val: number): string
	local formatted = tostring(math.floor(val))
	while true do
		local k
		formatted, k = string.gsub(formatted, "^(-?%d+)(%d%d%d)", "%1,%2")
		if k == 0 then break end
	end
	return formatted
end

function LeaderboardService:_getIcons()
	local iconsFolder = ServerStorage:FindFirstChild("Assets") and ServerStorage.Assets:FindFirstChild("Icons")
	if not iconsFolder then return nil end
	return {
		Top_1 = iconsFolder:FindFirstChild("Top_1"),
		Top_2 = iconsFolder:FindFirstChild("Top_2"),
		Top_3 = iconsFolder:FindFirstChild("Top_3"),
		Top_All_Wins = iconsFolder:FindFirstChild("Top_All_Wins"),
		Top_All_Kills = iconsFolder:FindFirstChild("Top_All_Kills"),
		Top_All_Streak = iconsFolder:FindFirstChild("Top_All_Streak"),
	}
end

-- ==================================================
-- INICIALIZACIÓN Y CICLO DE VIDA
-- ==================================================

function LeaderboardService:Init(context: any)
	self._context = context
	self._isStudio = RunService:IsStudio()
	self._usernameCache = {}
	self._stores = {}

	-- Inicializar OrderedDataStores
	for statKey, storeName in pairs(ORDERED_STORE_NAMES) do
		local ok, store = pcall(function()
			return DataStoreService:GetOrderedDataStore(storeName)
		end)
		if ok and store then
			self._stores[statKey] = store
		else
			warn(string.format("[LeaderboardService] No se pudo inicializar OrderedDataStore '%s'", storeName))
		end
	end
end

function LeaderboardService:Start(context: any)
	self._playerService = context and context.PlayerService or nil
	self._playerDataService = context and context.PlayerDataService or nil

	-- 1. Al entrar un jugador: esperar sus datos y sincronizar su récord real
	Players.PlayerAdded:Connect(function(player)
		task.spawn(function()
			local ps = self._playerService or (self._context and self._context.PlayerService)
			local attempts = 0
			while attempts < 25 and (not ps or not ps._data or not ps._data[player]) do
				attempts += 1
				task.wait(1)
				if not self._playerService and self._context then
					self._playerService = self._context.PlayerService
				end
				ps = self._playerService
			end

			if player.Parent then
				self:UpdatePlayerRecords(player)
				task.wait(2)
				self:RefreshAllLeaderboards()
			end
		end)
	end)

	-- 2. Al salir un jugador: guardar su récord final
	Players.PlayerRemoving:Connect(function(player)
		self:UpdatePlayerRecords(player)
	end)

	-- 3. Registrar jugadores que ya estén presentes
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(function()
			self:UpdatePlayerRecords(player)
		end)
	end

	-- 4. Tarea periódica de guardado y refresco de pantallas
	task.spawn(function()
		task.wait(3)
		self:UpdateAllConnectedPlayers()
		self:RefreshAllLeaderboards()

		while true do
			task.wait(self._refreshInterval)
			self:UpdateAllConnectedPlayers()
			self:RefreshAllLeaderboards()
		end
	end)

	print("[LeaderboardService] Servicio de Leaderboards físicos activo y listo.")
end

-- Actualiza todos los jugadores conectados en el servidor
function LeaderboardService:UpdateAllConnectedPlayers()
	for _, player in ipairs(Players:GetPlayers()) do
		self:UpdatePlayerRecords(player)
	end
end

-- Actualiza los 3 puntajes del jugador en los OrderedDataStore
function LeaderboardService:UpdatePlayerRecords(player: Player)
	if not player or not player.UserId or player.UserId <= 0 then
		return
	end

	local ps = self._playerService or (self._context and self._context.PlayerService)
	if not ps then return end

	local wins = 0
	local kills = 0
	local racha = 0

	pcall(function()
		wins = ps:GetWins(player)
		kills = ps:GetKills(player)
		local data = ps._data and ps._data[player]
		racha = (data and data.WinStreak and data.WinStreak.Total) or 0
	end)

	local userIdStr = tostring(player.UserId)

	task.spawn(function()
		if self._stores.Wins then
			pcall(function() self._stores.Wins:SetAsync(userIdStr, math.max(0, wins)) end)
		end
		if self._stores.Kills then
			pcall(function() self._stores.Kills:SetAsync(userIdStr, math.max(0, kills)) end)
		end
		if self._stores.Rachas then
			pcall(function() self._stores.Rachas:SetAsync(userIdStr, math.max(0, racha)) end)
		end
	end)
end

-- Refresca las 3 pantallas
function LeaderboardService:RefreshAllLeaderboards()
	self:RefreshLeaderboard("Wins")
	self:RefreshLeaderboard("Kills")
	self:RefreshLeaderboard("Rachas")
end

-- Refresca una pantalla específica
function LeaderboardService:RefreshLeaderboard(statKey: string)
	local cfg = SCREEN_MAPPING[statKey]
	if not cfg then return end

	local stands = Workspace:FindFirstChild("stands") and Workspace.stands:FindFirstChild("TOPS-SCREENS")
	if not stands then return end

	local subModel = stands:FindFirstChild(cfg.ModelName)
	local screenPart = subModel and subModel:FindFirstChild(cfg.PartName)
	if not screenPart then return end

	local surfaceGui = screenPart:FindFirstChild(cfg.GuiName)
	if not surfaceGui then return end

	local mainFrame = surfaceGui:FindFirstChild("MainFrame")
	local scroll = mainFrame and mainFrame:FindFirstChild("ScrollList")
	if not scroll then return end

	local icons = self:_getIcons()
	local iconAll = (icons and icons[cfg.IconAllName]) or (icons and icons.Top_All_Wins)

	-- Obtener entradas ordenadas (Top 50)
	local entries: { { PlayerName: string, Value: number } } = {}
	local store = self._stores[statKey]

	if store then
		local ok, pages = pcall(function()
			return store:GetSortedAsync(false, 50, 1)
		end)

		if ok and pages then
			local current = pages:GetCurrentPage()
			for _, item in ipairs(current) do
				local uid = tonumber(item.key)
				if uid then
					local pName = self:_getPlayerName(uid)
					table.insert(entries, {
						PlayerName = pName,
						Value = item.value,
					})
				end
			end
		end
	end

	-- Si es servidor público y no hay registros en la tienda aún, incorporar jugadores activos conectados con sus datos REALES
	local existingNames = {}
	for _, entry in ipairs(entries) do
		existingNames[entry.PlayerName] = true
	end

	local activePlayers = Players:GetPlayers()
	for _, p in ipairs(activePlayers) do
		if not existingNames[p.Name] then
			local val = 0
			if self._playerService then
				if statKey == "Wins" then val = self._playerService:GetWins(p)
				elseif statKey == "Kills" then val = self._playerService:GetKills(p)
				elseif statKey == "Rachas" then
					local d = self._playerService._data and self._playerService._data[p]
					val = (d and d.WinStreak and d.WinStreak.Total) or 0
				end
			end
			table.insert(entries, { PlayerName = p.Name, Value = val })
			existingNames[p.Name] = true
		end
	end

	-- Ordenar de mayor a menor
	table.sort(entries, function(a, b)
		return a.Value > b.Value
	end)

	-- En Studio únicamente (offline): Si está completamente vacío, mostrar preview
	if self._isStudio and #entries == 0 then
		for i = 1, 50 do
			local mockName = (i <= #MOCK_NAMES and MOCK_NAMES[i]) or ("Player_" .. tostring(i))
			local statVal = math.max(1, math.floor(cfg.SampleBase * (1 - (i - 1) * 0.018)))
			table.insert(entries, { PlayerName = mockName, Value = statVal })
		end
	end

	-- Rellenar las 50 filas en el ScrollingFrame
	for rank = 1, 50 do
		local row = scroll:FindFirstChild("Rank_" .. rank)
		local data = entries[rank]
		if row then
			local nameLbl = row:FindFirstChild("PlayerName") :: TextLabel?
			local statLbl = row:FindFirstChild("StatNumber") :: TextLabel?
			local iconImg = row:FindFirstChild("IconTop") :: ImageLabel?

			if data then
				-- Fila con jugador real
				if nameLbl then
					nameLbl.Text = data.PlayerName
					nameLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
				end

				if statLbl then
					statLbl.Text = self:_formatNumber(data.Value)
					statLbl.TextColor3 = (rank == 1 and Color3.fromRGB(255, 215, 0))
						or (rank == 2 and Color3.fromRGB(240, 240, 240))
						or (rank == 3 and Color3.fromRGB(235, 145, 60))
						or Color3.fromRGB(210, 210, 210)
				end

				local targetIcon = iconAll
				if rank == 1 and icons and icons.Top_1 then targetIcon = icons.Top_1
				elseif rank == 2 and icons and icons.Top_2 then targetIcon = icons.Top_2
				elseif rank == 3 and icons and icons.Top_3 then targetIcon = icons.Top_3
				end

				if iconImg and targetIcon then
					iconImg.Visible = true
					iconImg.Image = targetIcon.Image
					iconImg.ImageColor3 = targetIcon.ImageColor3
					iconImg.ImageRectOffset = targetIcon.ImageRectOffset
					iconImg.ImageRectSize = targetIcon.ImageRectSize
				end
			else
				-- Fila vacía (sin jugador aún en este puesto)
				if nameLbl then
					nameLbl.Text = "---"
					nameLbl.TextColor3 = Color3.fromRGB(120, 130, 150)
				end

				if statLbl then
					statLbl.Text = "-"
					statLbl.TextColor3 = Color3.fromRGB(120, 130, 150)
				end

				if iconImg then
					iconImg.Visible = false
				end
			end
		end
	end
end

return LeaderboardService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="974">
        <Properties>
          <string name="Name">MatchInstanceService</string>
          <string name="Source"><![CDATA[--!strict
-- MatchInstanceService
-- Servicio encargado exclusivamente de crear, administrar y destruir las instancias fisicas de las partidas.
-- Asigna ArenaSlots fisicamente aislados para que los jugadores de distintas partidas no puedan verse ni interactuar.

local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

local Config = require(ReplicatedStorage.Shared.Config)
local Types = require(ReplicatedStorage.Shared.Types)

type MatchSession = Types.MatchSession
type MatchInstanceInfo = Types.MatchInstanceInfo

local MatchInstanceService = {}
MatchInstanceService.Name = "MatchInstanceService"

MatchInstanceService._context = nil
MatchInstanceService._activeMatchesFolder = nil :: Folder?
MatchInstanceService._allocatedSlots = {} :: { [number]: string } -- ArenaSlot -> MatchId
MatchInstanceService._instances = {} :: { [string]: MatchInstanceInfo } -- MatchId -> MatchInstanceInfo

local TEAM_NAMES: { "Red" | "Blue" } = { "Red", "Blue" }

local SpawnResolver = require(script.Parent.TeamSpawnResolver)
local function resolveTeamSpawns(map: Instance)
 return SpawnResolver.Resolve(map, 1)
end

function MatchInstanceService:Init(context)
	self._context = context
	self._allocatedSlots = {}
	self._instances = {}
	self._previewScenes = {}

	-- Localizar o crear de forma segura Workspace.ActiveMatches
	local activeMatches = workspace:FindFirstChild("ActiveMatches")
	if not activeMatches then
		activeMatches = Instance.new("Folder")
		activeMatches.Name = "ActiveMatches"
		activeMatches.Parent = workspace
	end
	self._activeMatchesFolder = activeMatches :: Folder
end

function MatchInstanceService:Start(context)
	if RunService:IsStudio() then
		local match = ReplicatedStorage.Remotes.Match
		local remote = match:FindFirstChild("EndCinematicPreview") or Instance.new("RemoteFunction")
		remote.Name = "EndCinematicPreview"
		remote.Parent = match
		remote.OnServerInvoke = function(player, action, name)
			if not RunService:IsStudio() or player.Parent ~= Players then return nil end
			if action == "Release" then
				local record = self._previewScenes[player]
				if record and type(name) == "string" and record.Scene.Name == name then self:ReleaseCinematicPreview(player) end
				return true
			end
			if action ~= "Prepare" then return nil end
			return self:PrepareCinematicPreview(player)
		end
		Players.PlayerRemoving:Connect(function(player) self:ReleaseCinematicPreview(player) end)
	end
	print("[MatchInstanceService] Servicio iniciado y listo para gestionar instancias de partida")
end

function MatchInstanceService:GetSlotOrigin(slot: number): Vector3
	local baseOrigin = (Config.Arena and Config.Arena.BaseOrigin) or Vector3.new(10000, 500, 0)
	local spacing = (Config.Arena and Config.Arena.Spacing) or Vector3.new(10000, 0, 0)
	return baseOrigin + spacing * slot
end

function MatchInstanceService:_allocateSlot(matchId: string): number?
	local maxSlots = (Config.Arena and Config.Arena.MaxSlots) or 100

	-- Buscar el menor ArenaSlot disponible (garantiza reutilización de slots liberados)
	for slot = 0, maxSlots - 1 do
		if self._allocatedSlots[slot] == nil then
			self._allocatedSlots[slot] = matchId
			return slot
		end
	end

	warn(string.format("[MatchInstanceService] No hay ArenaSlots disponibles (Capacidad: %d)", maxSlots))
	return nil
end

function MatchInstanceService:_releaseSlot(slot: number, expectedMatchId: string?): boolean
	if expectedMatchId and self._allocatedSlots[slot] ~= expectedMatchId then
		return false
	end
	self._allocatedSlots[slot] = nil
	return true
end

function MatchInstanceService:_validateMapTemplate(mapName: string, requiredTeamSize: number?): (boolean, string?, Model?)
	local mapsFolder = ServerStorage:FindFirstChild("Maps")
	if not mapsFolder then
		return false, "ServerStorage.Maps no existe", nil
	end

	local mapTemplate = mapsFolder:FindFirstChild(mapName)
	if not mapTemplate then
		return false, string.format("Mapa '%s' no encontrado en ServerStorage.Maps", mapName), nil
	end

	if not mapTemplate:IsA("Model") then
		return false, string.format("Mapa '%s' no es un Model (es %s)", mapName, mapTemplate.ClassName), nil
	end

	local geometry = mapTemplate:FindFirstChild("Geometry")
	if not geometry then
		return false, string.format("Mapa '%s' no contiene 'Geometry'", mapName), nil
	end

	local teamSpawns, capacity, spawnError = SpawnResolver.Resolve(mapTemplate, requiredTeamSize or 1)
	if not teamSpawns then
		return false, string.format("Mapa '%s': %s", mapName, tostring(spawnError)), nil
	end

	local zoneWin = mapTemplate:FindFirstChild("ZoneWin")
	if not zoneWin then
		return false, string.format("Mapa '%s' no contiene 'ZoneWin'", mapName), nil
	end

	local redWin = zoneWin:FindFirstChild("RedWin")
	if not redWin or not redWin:IsA("BasePart") then
		return false, string.format("Mapa '%s' no contiene 'ZoneWin.RedWin' valido (debe ser BasePart)", mapName), nil
	end

	local blueWin = zoneWin:FindFirstChild("BlueWin")
	if not blueWin or not blueWin:IsA("BasePart") then
		return false, string.format("Mapa '%s' no contiene 'ZoneWin.BlueWin' valido (debe ser BasePart)", mapName), nil
	end

	return true, nil, mapTemplate :: Model
end

function MatchInstanceService:CreateInstance(matchSession: MatchSession, mapName: string): MatchInstanceInfo?
	if not matchSession or type(matchSession.Id) ~= "string" or matchSession.Id == "" then
		warn("[MatchInstanceService] MatchSession invalida o sin ID")
		return nil
	end

	local matchId = matchSession.Id

	-- Evitar duplicados para una misma partida activa
	if self._instances[matchId] ~= nil then
		warn(string.format("[MatchInstanceService] La partida '%s' ya posee una instancia activa", matchId))
		return self._instances[matchId]
	end

	-- 1. Validar contrato de mapa
	local isValid, errReason, mapTemplate = self:_validateMapTemplate(mapName, matchSession.TeamSize or 1)
	if not isValid or not mapTemplate then
		warn(string.format("[MatchInstanceService] Error al validar mapa: %s", tostring(errReason)))
		return nil
	end

	-- 2. Reservar ArenaSlot libre
	local slot = self:_allocateSlot(matchId)
	if slot == nil then
		return nil
	end

	local origin = self:GetSlotOrigin(slot)

	-- 3. Clonar el mapa
	local clonedMap = mapTemplate:Clone()
	local arenaTransform = CFrame.new(origin) * mapTemplate:GetPivot():Inverse()

	-- 4. Crear contenedor de partida en Workspace.ActiveMatches
	if not self._activeMatchesFolder or not self._activeMatchesFolder.Parent then
		local activeMatches = workspace:FindFirstChild("ActiveMatches")
		if not activeMatches then
			activeMatches = Instance.new("Folder")
			activeMatches.Name = "ActiveMatches"
			activeMatches.Parent = workspace
		end
		self._activeMatchesFolder = activeMatches :: Folder
	end

	local container = Instance.new("Folder")
	container.Name = "Match_" .. matchId
	container:SetAttribute("SessionId", matchId)
	container.Parent = self._activeMatchesFolder

	-- 5. Posicionar el mapa completo mediante PivotTo en el origen del ArenaSlot
	clonedMap:PivotTo(CFrame.new(origin))
	clonedMap.Parent = container

	-- Extraer referencias cacheadas de las partes del contrato
	local geometry = clonedMap:FindFirstChild("Geometry") :: Instance
	local teamSpawns, teamCapacity = resolveTeamSpawns(clonedMap)
	local redSpawn = teamSpawns.Red[1]
	local blueSpawn = teamSpawns.Blue[1]
	local zoneWin = clonedMap:FindFirstChild("ZoneWin") :: Instance
	local redWin = zoneWin and zoneWin:FindFirstChild("RedWin") :: BasePart
	local blueWin = zoneWin and zoneWin:FindFirstChild("BlueWin") :: BasePart

	-- Extraer referencias a KillParts si existen en el mapa
	local killParts: { BasePart } = {}
	for _, desc in ipairs(clonedMap:GetDescendants()) do
		if desc:IsA("BasePart") and desc.Name == "KillPart" then
			table.insert(killParts, desc)
		end
	end

	-- Crear VoidBoundaryPart exclusivo para esta MatchInstance
	local voidBoundarySize = (Config.Arena and Config.Arena.VoidBoundarySize) or Vector3.new(500, 4, 500)
	local voidBoundaryOffset = (Config.Arena and Config.Arena.VoidBoundaryOffset) or Vector3.new(0, -50, 0)
	local voidBoundaryPosition = origin + voidBoundaryOffset

	local voidBoundaryPart = Instance.new("Part")
	voidBoundaryPart.Name = "VoidBoundaryPart"
	voidBoundaryPart.Size = voidBoundarySize
	voidBoundaryPart.CFrame = CFrame.new(voidBoundaryPosition)
	voidBoundaryPart.Anchored = true
	voidBoundaryPart.CanCollide = false
	voidBoundaryPart.CanTouch = true
	voidBoundaryPart.CanQuery = false
	voidBoundaryPart.Transparency = 1
	voidBoundaryPart.Parent = container

	local instanceInfo: MatchInstanceInfo = {
		MatchId = matchId,
		MapName = mapName,
		ArenaSlot = slot,
		Origin = origin,
		InstanceModel = clonedMap,
		Container = container,
		Geometry = geometry,
		RedSpawn = redSpawn,
		BlueSpawn = blueSpawn,
		TeamSpawns = teamSpawns,
		TeamCapacity = teamCapacity,
		ZoneWin = zoneWin,
		RedWin = redWin,
		BlueWin = blueWin,
		KillParts = killParts,
		VoidBoundaryPart = voidBoundaryPart,
		ArenaTransform = arenaTransform,
	}

	self._instances[matchId] = instanceInfo
	local ok, cinematicError = pcall(function()
		self:PrepareEndCinematic(matchId)
	end)
	if not ok or not instanceInfo.EndCinematic then
		warn("[MatchInstanceService] EndCinematic unavailable: " .. tostring(cinematicError))
		self:DestroyInstance(matchId)
		return nil
	end

	-- Platform state belongs exclusively to this validated, physically positioned clone.
	local platforms = self._context and self._context:GetService("DisappearingPlatformsService")
	if platforms then
		local bound, result = pcall(platforms.BindMap, platforms, matchSession, instanceInfo)
		if not bound or result ~= true then
			warn("[MatchInstanceService] Platform registration failed: " .. tostring(result))
			self:DestroyInstance(matchId)
			return nil
		end
	end

	print(string.format("[MatchInstanceService] Instancia creada: Match '%s' -> Mapa '%s' en ArenaSlot %d (%s)",
		matchId, mapName, slot, tostring(origin)))

	return instanceInfo
end

function MatchInstanceService:GetInstance(matchId: string): MatchInstanceInfo?
	return self._instances[matchId]
end

-- Uses exactly the map's original-pivot -> arena transform, not a cinematic pivot.
function MatchInstanceService:_populateCinematicScene(scene: Model, delta: CFrame)
	local folder = ServerStorage:FindFirstChild("EndGames-Scenario")
	local template = folder and folder:FindFirstChild("ScenarioFinal")
	assert(template and template:IsA("Model"), "ServerStorage.EndGames-Scenario.ScenarioFinal missing")
	for _, child in ipairs(template:GetChildren()) do child:Clone().Parent = scene end
	for _, object in ipairs(scene:GetDescendants()) do
		if object:IsA("LuaSourceContainer") then object:Destroy()
		elseif object:IsA("BasePart") then
			object.CFrame = delta * object.CFrame
			object.Anchored = true
			object.CanCollide = false
			object.CanTouch = false
			object.CanQuery = false
			elseif object:IsA("BillboardGui") and object.Parent and object.Parent.Name == "BillboardAnchor" then
				-- Only the authorized client enables its scene's results UI.
				object.Enabled = false
			elseif object:IsA("ParticleEmitter") then object.Enabled = false
		elseif object:IsA("Sound") then object:Stop() end
	end
	scene.WorldPivot = delta * template:GetPivot()
	local cameras = assert(scene:FindFirstChild("TransCamera"), "CinematicCamerasMissing")
	for _, name in ipairs({ "CameraCheck-v1", "CameraCheck-v2", "CameraCheck-Only1V1" }) do
		local part = cameras:FindFirstChild(name)
		assert(part and part:IsA("BasePart"), "CinematicCameraMissing:" .. name)
	end
	local slots = assert(scene:FindFirstChild("Players"), "CinematicSlotsMissing")
	for index = 1, 5 do
		local slot = slots:FindFirstChild("SlotPlayer_" .. index)
		assert(slot and slot:IsA("BasePart"), "CinematicSlotMissing:" .. index)
	end
end

function MatchInstanceService:PrepareEndCinematic(matchId: string): Model?
	local info = self._instances[matchId]
	if not info then return nil end
	if info.EndCinematic and info.EndCinematic.Parent == info.Container then return info.EndCinematic end
	local scene = Instance.new("Model")
	scene.Name = "ScenarioFinal"
	scene:SetAttribute("SessionId", matchId)
	scene:SetAttribute("ArenaSlot", info.ArenaSlot)
	scene.ModelStreamingMode = Enum.ModelStreamingMode.PersistentPerPlayer
	-- Register first so the existing rollback owns partial clones too.
	info.EndCinematic = scene
	self:_populateCinematicScene(scene, info.ArenaTransform :: CFrame)
	scene.Parent = info.Container
	return scene
end

function MatchInstanceService:ReleaseCinematicPreview(player: Player, expected: Model?)
	local record = self._previewScenes and self._previewScenes[player]
	if not record or (expected and record.Scene ~= expected) then return end
	self._previewScenes[player] = nil
	if record.Connection then record.Connection:Disconnect() end
	if record.Timer and record.Timer ~= coroutine.running() then pcall(task.cancel, record.Timer) end
	record.Scene:Destroy()
	local folder = workspace:FindFirstChild("EndCinematicPreviews")
	if folder and #folder:GetChildren() == 0 then folder:Destroy() end
end

function MatchInstanceService:PrepareCinematicPreview(player: Player): any
	if not RunService:IsStudio() or player.Parent ~= Players then return nil end
	local config = require(ReplicatedStorage.Shared.EndCinematicConfig)
	local rounds = self._context and self._context:GetService("RoundService")
	if not config.Preview.Enabled or player:GetAttribute("MatchId") ~= nil
		or (rounds and rounds:GetSessionForPlayer(player)) then return nil end
	self:ReleaseCinematicPreview(player)
	local folder = workspace:FindFirstChild("EndCinematicPreviews")
	if not folder then folder = Instance.new("Folder"); folder.Name = "EndCinematicPreviews"; folder.Parent = workspace end
	local scene = Instance.new("Model")
	scene.Name = "Preview_" .. player.UserId .. "_" .. game:GetService("HttpService"):GenerateGUID(false)
	scene.ModelStreamingMode = Enum.ModelStreamingMode.PersistentPerPlayer
	scene:SetAttribute("PreviewOwnerUserId", player.UserId)
	local ok, failure = pcall(function() self:_populateCinematicScene(scene, CFrame.identity) end)
	if not ok then scene:Destroy(); if #folder:GetChildren() == 0 then folder:Destroy() end; warn(failure); return nil end
	scene.Parent = folder
	local record = { Scene = scene }
	self._previewScenes[player] = record
	local persistentOk = pcall(function() scene:AddPersistentPlayer(player) end)
	if not persistentOk then self:ReleaseCinematicPreview(player); return nil end
	record.Connection = player:GetAttributeChangedSignal("MatchId"):Connect(function()
		if player:GetAttribute("MatchId") ~= nil then self:ReleaseCinematicPreview(player, scene) end
	end)
	record.Timer = task.delay(90, function() self:ReleaseCinematicPreview(player, scene) end)
	return { Name = scene.Name, Origin = scene:GetPivot().Position }
end

function MatchInstanceService:GetSpawnPoints(matchId: string): (BasePart?, BasePart?)
	local info = self._instances[matchId]
	if info then
		return info.TeamSpawns.Red[1], info.TeamSpawns.Blue[1]
	end
	return nil, nil
end

function MatchInstanceService:GetSpawnPoint(matchId: string, team: "Red" | "Blue", slot: number): BasePart?
	local info = self._instances[matchId]
	if not info or (team ~= "Red" and team ~= "Blue") or slot < 1 then return nil end
	return info.TeamSpawns[team][slot]
end

function MatchInstanceService:GetMapCapacity(mapName: string): number
	local ok, _, template = self:_validateMapTemplate(mapName, 1)
	if not ok or not template then return 0 end
	local _, capacity = resolveTeamSpawns(template)
	return capacity
end

function MatchInstanceService:IsMapCompatible(mapName: string, teamSize: number): (boolean, string?)
	local ok, reason = self:_validateMapTemplate(mapName, teamSize)
	self._mapValidationWarnings = self._mapValidationWarnings or {}
	local key = tostring(teamSize) .. ":" .. mapName
	if not ok and self._mapValidationWarnings[key] ~= reason then
		self._mapValidationWarnings[key] = reason
		warn(string.format("[MatchInstanceService] Mapa incompatible para %dv%d: %s", teamSize, teamSize, tostring(reason)))
	elseif ok then
		self._mapValidationWarnings[key] = nil
	end
	return ok, reason
end

function MatchInstanceService:GetZoneWin(matchId: string): (BasePart?, BasePart?)
	local info = self._instances[matchId]
	if info then
		return info.RedWin, info.BlueWin
	end
	return nil, nil
end

function MatchInstanceService:DestroyInstance(matchId: string): boolean
	local info = self._instances[matchId]
	local platforms = self._context and self._context:GetService("DisappearingPlatformsService")
	if platforms then platforms:UnbindMap(matchId, info) end
	if not info then
		-- Recuperación idempotente: elimina solamente recursos que aún pertenezcan
		-- al SessionId solicitado. Nunca libera un slot reasignado a otra sesión.
		if self._activeMatchesFolder then
			local orphan = self._activeMatchesFolder:FindFirstChild("Match_" .. matchId)
			if orphan then
				orphan:Destroy()
			end
		end
		for slot, ownerId in pairs(self._allocatedSlots) do
			if ownerId == matchId then
				self:_releaseSlot(slot, matchId)
			end
		end
		return true
	end

	-- Destruir contenedor y modelo clonado
	if info.EndCinematic then info.EndCinematic:Destroy() end
	if info.Container and info.Container.Parent then
		info.Container:Destroy()
	end

	-- Liberar ArenaSlot
	if not self:_releaseSlot(info.ArenaSlot, matchId) then
		warn(string.format("[MatchInstanceService] ArenaSlot %d ya no pertenece a Match '%s'", info.ArenaSlot, matchId))
		return false
	end

	-- Limpiar registro
	self._instances[matchId] = nil

	print(string.format("[MatchInstanceService] Instancia destruida: Match '%s', ArenaSlot %d liberado",
		matchId, info.ArenaSlot))

	return true
end

function MatchInstanceService:GetAllocatedSlots(): { [number]: string }
	return self._allocatedSlots
end

return MatchInstanceService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="975">
        <Properties>
          <string name="Name">MatchmakingFeedbackService</string>
          <string name="Source"><![CDATA[--!strict
-- MatchmakingFeedbackService
-- Responsable exclusivo del feedback audiovisual (SFX espaciales, partículas, beams y cambios de material)
-- en las plataformas de matchmaking según las directrices de GAME_SDD.md.
-- NO gestiona la lógica de emparejamiento, detección ni colas (responsabilidad de MatchmakingService).
-- La instancia física (zoneFolder) es la identidad primaria para separar estados y recursos audiovisuales.

local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local MatchmakingFeedbackService = {}
MatchmakingFeedbackService.Name = "MatchmakingFeedbackService"

local function ensureRemoteFolder(parent: Instance, name: string): Folder
	local folder = parent:FindFirstChild(name)
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = name
		folder.Parent = parent
	end
	return folder :: Folder
end

local function ensureRemoteEvent(parent: Instance, name: string): RemoteEvent
	local event = parent:FindFirstChild(name)
	if not event then
		event = Instance.new("RemoteEvent")
		event.Name = name
		event.Parent = parent
	end
	return event :: RemoteEvent
end

-- Configuración de presentación audiovisual
local EFFECT_VERTICAL_OFFSET = Vector3.new(0, 4, 0)
local OCCUPIED_MATERIAL = Enum.Material.Neon

export type TeamEffectAssets = {
	effectsFolder: Instance,
	soundJoin: Sound?,
	soundJoinMusic: Sound?,
	soundLeave: Sound?,
	activateTemplate: Part?,
	beamTemplates: { Part },
}

export type ZoneFeedbackState = {
	ZoneFolder: Folder,
	EffectsFolder: Folder?,
	Pads: { [string]: BasePart }, -- teamName ("Red", "Blue") -> BasePart
	OriginalMaterials: { [string]: Enum.Material },
	TeamEffects: { [string]: TeamEffectAssets },
	ActiveClones: { [string]: Part },
	ActiveBeamClones: { [string]: { Part } },
	ActiveMusicClones: { [string]: Sound },
	PadOccupied: { [string]: boolean },
	Occupants: { [string]: Player? },
}

MatchmakingFeedbackService._context = nil :: any
MatchmakingFeedbackService._zones = {} :: { [Folder]: ZoneFeedbackState }

-- Descubre y actualiza dinámicamente todos los ParticleEmitter descendientes
local function setEmittersEnabled(instance: Instance, enabled: boolean)
	for _, desc in ipairs(instance:GetDescendants()) do
		if desc:IsA("ParticleEmitter") then
			desc.Enabled = enabled
		end
	end
	if instance:IsA("ParticleEmitter") then
		instance.Enabled = enabled
	end
end

-- Descubre y actualiza dinámicamente todos los Beams descendientes
local function setBeamsEnabled(instance: Instance, enabled: boolean)
	for _, desc in ipairs(instance:GetDescendants()) do
		if desc:IsA("Beam") then
			desc.Enabled = enabled
		end
	end
	if instance:IsA("Beam") then
		instance.Enabled = enabled
	end
end

-- Carga y configura los templates de efectos de un contenedor dado (carpeta de equipo o carpeta raíz)
local function loadTeamEffects(folder: Instance): TeamEffectAssets
	local soundJoin = folder:FindFirstChild("SoundJoin")
	local soundJoinMusic = folder:FindFirstChild("SoundJoinMusic")
	local soundLeave = folder:FindFirstChild("SoundLeave")
	local activateTemplate = folder:FindFirstChild("ActivateParticle")

	if activateTemplate and activateTemplate:IsA("BasePart") then
		activateTemplate.Anchored = true
		activateTemplate.CanCollide = false
		setEmittersEnabled(activateTemplate, false)
	end

	local beamTemplates: { Part } = {}
	for _, child in ipairs(folder:GetChildren()) do
		if child:IsA("BasePart") and child ~= activateTemplate then
			local hasBeam = child:FindFirstChildOfClass("Beam") ~= nil
			if not hasBeam then
				for _, d in ipairs(child:GetDescendants()) do
					if d:IsA("Beam") then
						hasBeam = true
						break
					end
				end
			end

			if hasBeam then
				table.insert(beamTemplates, child :: Part)
				setBeamsEnabled(child, false)
			end
		end
	end

	return {
		effectsFolder = folder,
		soundJoin = (soundJoin and soundJoin:IsA("Sound")) and soundJoin or nil,
		soundJoinMusic = (soundJoinMusic and soundJoinMusic:IsA("Sound")) and soundJoinMusic or nil,
		soundLeave = (soundLeave and soundLeave:IsA("Sound")) and soundLeave or nil,
		activateTemplate = (activateTemplate and activateTemplate:IsA("Part")) and (activateTemplate :: Part) or nil,
		beamTemplates = beamTemplates,
	}
end

-- Limpia instancias temporales residuales en una carpeta
local function cleanupResidualInstances(container: Instance)
	for _, child in ipairs(container:GetChildren()) do
		if child.Name:find("ParticleInstance_") or child.Name:find("BeamInstance_") or child.Name:find("SpatialSound_") or child.Name:find("SpatialMusic_") then
			child:Destroy()
		end
	end
end

-- Reproduce un sonido espacializado en la posición de un BasePart (escuchado por todos los jugadores cercanos)
function MatchmakingFeedbackService:_playSpatialSound(soundTemplate: Sound?, targetPart: BasePart?)
	if not soundTemplate then return end

	if not targetPart then
		soundTemplate:Play()
		return
	end

	-- Clonar el sonido en el pad correspondiente para obtener audio 3D posicional nativo con sus propiedades de Studio
	local spatialClone = soundTemplate:Clone()
	spatialClone.Name = "SpatialSound_" .. soundTemplate.Name
	spatialClone.PlayOnRemove = false
	spatialClone.Parent = targetPart

	local cleanupConnection: RBXScriptConnection?
	cleanupConnection = spatialClone.Ended:Connect(function()
		if cleanupConnection then
			cleanupConnection:Disconnect()
		end
		spatialClone:Destroy()
	end)

	-- Timeout de seguridad para evitar fugas de instancias si el sonido se interrumpe
	task.delay(math.max(spatialClone.TimeLength + 1, 4), function()
		if spatialClone and spatialClone.Parent then
			spatialClone:Destroy()
		end
	end)

	spatialClone:Play()
end

function MatchmakingFeedbackService:_ensureRemotes()
	local remotesFolder = ensureRemoteFolder(ReplicatedStorage, "Remotes")
	local mmFolder = ensureRemoteFolder(remotesFolder, "Matchmaking")
	ensureRemoteEvent(mmFolder, "PadMusic")
end

function MatchmakingFeedbackService:_getRemote(eventName: string): RemoteEvent?
	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	local mmFolder = remotes and remotes:FindFirstChild("Matchmaking")
	local event = mmFolder and mmFolder:FindFirstChild(eventName)
	if event and event:IsA("RemoteEvent") then
		return event
	end
	return nil
end

function MatchmakingFeedbackService:Init(context)
	self._context = context
	self._zones = {}
	self:_ensureRemotes()

	-- Descubrir y registrar todas las zonas físicas existentes en Workspace.ZoneMatchmaking
	local zoneContainer = Workspace:FindFirstChild("ZoneMatchmaking")
	if not zoneContainer then
		warn("[MatchmakingFeedbackService] No se encontro Workspace.ZoneMatchmaking")
		return
	end

	for _, child in ipairs(zoneContainer:GetChildren()) do
		if child:IsA("Folder") then
			self:RegisterZone(child)
		end
	end
end

function MatchmakingFeedbackService:Start(context)
	self._context = context
	print("[MatchmakingFeedbackService] Servicio audiovisual de matchmaking iniciado y listo para múltiples zonas")
end

-- Registra una zona física específica y sus assets independientes
function MatchmakingFeedbackService:RegisterZone(zoneFolder: Folder)
	if not zoneFolder or not zoneFolder:IsA("Folder") then return end
	if self._zones[zoneFolder] then return end

	local pads: { [string]: BasePart } = {}
	local originalMaterials: { [string]: Enum.Material } = {}
	local padOccupied: { [string]: boolean } = {}

	local joinsFolder = zoneFolder:FindFirstChild("joins-parts")
	if joinsFolder then
		for _, padChild in ipairs(joinsFolder:GetChildren()) do
			if padChild:IsA("BasePart") then
				local teamAttr = padChild:GetAttribute("Team")
				local teamName = if typeof(teamAttr) == "string" and teamAttr ~= ""
					then teamAttr
					elseif padChild.Name == "Red" or padChild.Name:find("Red") then "Red"
					elseif padChild.Name == "Blue" or padChild.Name:find("Blue") then "Blue"
					else padChild.Name

				pads[teamName] = padChild
				originalMaterials[teamName] = padChild.Material
				padOccupied[teamName] = false

				-- Limpieza de sonidos residuales en el pad
				for _, c in ipairs(padChild:GetChildren()) do
					if c.Name:find("SpatialSound_") or c.Name:find("SpatialMusic_") then
						c:Destroy()
					end
				end
			end
		end
	else
		warn(string.format("[MatchmakingFeedbackService] Carpeta 'joins-parts' no encontrada en zona '%s'", zoneFolder.Name))
	end

	local teamEffects: { [string]: TeamEffectAssets } = {}
	local effectsFolder = zoneFolder:FindFirstChild("effects") :: Folder?

	if effectsFolder and (effectsFolder:IsA("Folder") or effectsFolder:IsA("Model")) then
		cleanupResidualInstances(effectsFolder)

		for teamName, _ in pairs(pads) do
			local teamFolder = effectsFolder:FindFirstChild(teamName)
			if teamFolder and (teamFolder:IsA("Folder") or teamFolder:IsA("Model")) then
				cleanupResidualInstances(teamFolder)
				teamEffects[teamName] = loadTeamEffects(teamFolder)
			else
				teamEffects[teamName] = loadTeamEffects(effectsFolder)
			end
		end
	end

	local zoneFeedbackState: ZoneFeedbackState = {
		ZoneFolder = zoneFolder,
		EffectsFolder = effectsFolder,
		Pads = pads,
		OriginalMaterials = originalMaterials,
		TeamEffects = teamEffects,
		ActiveClones = {},
		ActiveBeamClones = {},
		ActiveMusicClones = {},
		PadOccupied = padOccupied,
		Occupants = {},
	}

	self._zones[zoneFolder] = zoneFeedbackState
	print(string.format("[MatchmakingFeedbackService] Zona registrada para feedback: '%s'", zoneFolder.Name))
end

-- Desregistra una zona física y realiza cleanup completo de sus recursos
function MatchmakingFeedbackService:UnregisterZone(zoneFolder: Folder)
	local zoneState = self._zones[zoneFolder]
	if not zoneState then return end

	-- Desactivar y limpiar feedback de todos los pads de esta zona
	for teamName, isOccupied in pairs(zoneState.PadOccupied) do
		if isOccupied then
			zoneState.PadOccupied[teamName] = false
			self:_deactivateZoneFeedback(zoneState, teamName)
		end
	end

	-- Limpiar ocupantes registrados
	zoneState.Occupants = {}

	-- Detener y destruir música activa remanente
	for teamName, musicClone in pairs(zoneState.ActiveMusicClones) do
		if musicClone and musicClone.Parent then
			musicClone:Stop()
			musicClone:Destroy()
		end
	end
	zoneState.ActiveMusicClones = {}

	-- Restaurar materiales en todos los pads
	for teamName, pad in pairs(zoneState.Pads) do
		local origMat = zoneState.OriginalMaterials[teamName]
		if pad and pad.Parent and origMat then
			pad.Material = origMat
		end
	end

	self._zones[zoneFolder] = nil
	print(string.format("[MatchmakingFeedbackService] Zona desregistrada y limpiada: '%s'", zoneFolder.Name))
end

-- Actualiza el estado de ocupación de un pad en una zona física específica
function MatchmakingFeedbackService:SetPadOccupied(zoneFolder: Folder, teamName: string, isOccupied: boolean, occupant: Player?)
	if not zoneFolder then return end

	local zoneState = self._zones[zoneFolder]
	if not zoneState then
		self:RegisterZone(zoneFolder)
		zoneState = self._zones[zoneFolder]
		if not zoneState then return end
	end

	local wasOccupied = zoneState.PadOccupied[teamName] == true
	if wasOccupied == isOccupied then
		return
	end

	zoneState.PadOccupied[teamName] = isOccupied

	if isOccupied then
		self:_activateZoneFeedback(zoneState, teamName, occupant)
	else
		self:_deactivateZoneFeedback(zoneState, teamName)
	end
end

-- Activa el feedback audiovisual en una zona física y equipo específicos
function MatchmakingFeedbackService:_activateZoneFeedback(zoneState: ZoneFeedbackState, teamName: string, occupant: Player?)
	local pad = zoneState.Pads[teamName]
	if not pad then return end

	local teamAssets = zoneState.TeamEffects[teamName]
	local targetFolder = (teamAssets and teamAssets.effectsFolder) or zoneState.EffectsFolder or pad.Parent

	-- 1. Reproducir SoundJoin espacializado del color correspondiente
	if teamAssets and teamAssets.soundJoin then
		self:_playSpatialSound(teamAssets.soundJoin, pad)
	end

	-- Registrar ocupante del pad para tracking de feedback
	zoneState.Occupants[teamName] = occupant

	-- 2. Cambiar material del pad a Neon
	pad.Material = OCCUPIED_MATERIAL

	-- 3. Instanciar clon temporal de partículas correspondiente al color
	if teamAssets and teamAssets.activateTemplate then
		local previousClone = zoneState.ActiveClones[teamName]
		if previousClone and previousClone.Parent then
			previousClone:Destroy()
		end

		local clone = teamAssets.activateTemplate:Clone() :: Part
		clone.Name = "ParticleInstance_" .. teamName
		clone.CanCollide = false
		clone.CanTouch = false
		clone.CanQuery = false
		clone.Anchored = true
		clone.CastShadow = false

		-- Posicionar sobre el pad correspondiente
		local targetPosition = pad.Position + EFFECT_VERTICAL_OFFSET
		clone.CFrame = CFrame.new(targetPosition)

		-- Activar dinámicamente todos los ParticleEmitters descendientes del color
		setEmittersEnabled(clone, true)

		-- Parentar a la carpeta de efectos del color
		clone.Parent = targetFolder
		zoneState.ActiveClones[teamName] = clone
	end

	-- 4. Instanciar y activar clones de Beams correspondientes al color
	local beamClones: { Part } = {}
	if teamAssets and teamAssets.beamTemplates then
		for _, beamTemplate in ipairs(teamAssets.beamTemplates) do
			local beamClone = beamTemplate:Clone() :: Part
			beamClone.Name = "BeamInstance_" .. teamName .. "_" .. beamTemplate.Name
			beamClone.CanCollide = false
			beamClone.CanTouch = false
			beamClone.CanQuery = false
			beamClone.Anchored = true
			beamClone.CastShadow = false

			-- Posicionar relativo al pad activo
			local relCFrame = pad.CFrame:ToObjectSpace(beamTemplate.CFrame)
			beamClone.CFrame = pad.CFrame * relCFrame

			-- Activar todos los Beams dentro del clon del color
			setBeamsEnabled(beamClone, true)

			beamClone.Parent = targetFolder
			table.insert(beamClones, beamClone)
		end
	end

	zoneState.ActiveBeamClones[teamName] = beamClones

	local occupantName = occupant and occupant.Name or "Desconocido"
	print(string.format("[MatchmakingFeedbackService] Feedback activado para pad '%s' en zona '%s' (Ocupante: %s)",
		teamName, zoneState.ZoneFolder.Name, occupantName))
end

-- Desactiva el feedback audiovisual en una zona física y equipo específicos
function MatchmakingFeedbackService:_deactivateZoneFeedback(zoneState: ZoneFeedbackState, teamName: string)
	local pad = zoneState.Pads[teamName]
	local teamAssets = zoneState.TeamEffects[teamName]
	local targetFolder = (teamAssets and teamAssets.effectsFolder) or zoneState.EffectsFolder

	-- 1. Limpiar ocupante registrado del pad
	local previousOccupant = zoneState.Occupants[teamName]
	zoneState.Occupants[teamName] = nil

	-- Limpieza defensiva de cualquier clon previo en el pad
	local activeMusic = zoneState.ActiveMusicClones[teamName]
	if activeMusic then
		zoneState.ActiveMusicClones[teamName] = nil
		if activeMusic.IsPlaying then
			activeMusic:Stop()
		end
		activeMusic:Destroy()
	end

	if pad then
		local leftoverMusic = pad:FindFirstChild("SpatialMusic_" .. teamName)
		if leftoverMusic then
			if leftoverMusic:IsA("Sound") and leftoverMusic.IsPlaying then
				leftoverMusic:Stop()
			end
			leftoverMusic:Destroy()
		end
	end

	-- 1b. Reproducir SoundLeave espacializado del color correspondiente
	if pad and teamAssets and teamAssets.soundLeave then
		self:_playSpatialSound(teamAssets.soundLeave, pad)
	end

	-- 2. Restaurar exactamente el material original guardado
	local originalMaterial = zoneState.OriginalMaterials[teamName]
	if pad and originalMaterial then
		pad.Material = originalMaterial
	end

	-- 3. Limpiar la instancia temporal de partículas
	local clone = zoneState.ActiveClones[teamName]
	if clone then
		zoneState.ActiveClones[teamName] = nil
		setEmittersEnabled(clone, false)
		clone:Destroy()
	end

	-- Fallback para garantizar que no queden partículas residuales
	if targetFolder then
		local leftoverParticle = targetFolder:FindFirstChild("ParticleInstance_" .. teamName)
		if leftoverParticle then
			leftoverParticle:Destroy()
		end
	end
	if zoneState.EffectsFolder and zoneState.EffectsFolder ~= targetFolder then
		local leftoverParticle = zoneState.EffectsFolder:FindFirstChild("ParticleInstance_" .. teamName)
		if leftoverParticle then
			leftoverParticle:Destroy()
		end
	end

	-- 4. Limpiar los clones temporales de Beams
	local beamClones = zoneState.ActiveBeamClones[teamName]
	if beamClones then
		zoneState.ActiveBeamClones[teamName] = nil
		for _, bClone in ipairs(beamClones) do
			setBeamsEnabled(bClone, false)
			bClone:Destroy()
		end
	end

	-- Fallback para garantizar que no queden beams residuales
	if targetFolder then
		for _, child in ipairs(targetFolder:GetChildren()) do
			if child.Name:find("BeamInstance_" .. teamName) then
				child:Destroy()
			end
		end
	end
	if zoneState.EffectsFolder and zoneState.EffectsFolder ~= targetFolder then
		for _, child in ipairs(zoneState.EffectsFolder:GetChildren()) do
			if child.Name:find("BeamInstance_" .. teamName) then
				child:Destroy()
			end
		end
	end

	print(string.format("[MatchmakingFeedbackService] Feedback desactivado y limpiado para pad '%s' en zona '%s'",
		teamName, zoneState.ZoneFolder.Name))
end

-- Consulta de assets de equipo para una zona dada
function MatchmakingFeedbackService:GetTeamAssets(zoneFolder: Folder, teamName: string): TeamEffectAssets?
	local zoneState = self._zones[zoneFolder]
	return zoneState and zoneState.TeamEffects[teamName]
end

-- Limpieza global de todas las zonas
function MatchmakingFeedbackService:ResetAll()
	for zoneFolder, zoneState in pairs(self._zones) do
		for teamName, isOccupied in pairs(zoneState.PadOccupied) do
			if isOccupied then
				zoneState.PadOccupied[teamName] = false
				self:_deactivateZoneFeedback(zoneState, teamName)
			end
		end

		for teamName, musicClone in pairs(zoneState.ActiveMusicClones) do
			if musicClone and musicClone.Parent then
				musicClone:Stop()
				musicClone:Destroy()
			end
		end
		zoneState.ActiveMusicClones = {}
	end
end

-- Consultas de estado por zona
function MatchmakingFeedbackService:IsPadOccupied(zoneFolder: Folder, teamName: string): boolean
	local zoneState = self._zones[zoneFolder]
	return (zoneState and zoneState.PadOccupied[teamName] == true) or false
end

function MatchmakingFeedbackService:GetActiveClone(zoneFolder: Folder, teamName: string): Part?
	local zoneState = self._zones[zoneFolder]
	return zoneState and zoneState.ActiveClones[teamName]
end

function MatchmakingFeedbackService:GetActiveBeamClones(zoneFolder: Folder, teamName: string): { Part }?
	local zoneState = self._zones[zoneFolder]
	return zoneState and zoneState.ActiveBeamClones[teamName]
end

function MatchmakingFeedbackService:GetActiveMusic(zoneFolder: Folder, teamName: string): Sound?
	local zoneState = self._zones[zoneFolder]
	return zoneState and zoneState.ActiveMusicClones[teamName]
end

return MatchmakingFeedbackService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="976">
        <Properties>
          <string name="Name">MatchmakingService</string>
          <string name="Source"><![CDATA[--!strict
-- MatchmakingService
-- Gestiona la detección de jugadores en zonas de matchmaking genéricas (1v1, 2v2, 3v3),
-- construye el QueueSnapshot autoritativo, controla la capacidad por equipo y despacha
-- partidas hacia RoundService.
-- La instancia física (zoneFolder) es la identidad primaria interna de la zona.
-- NO se encarga de efectos audiovisuales (delegado a MatchmakingFeedbackService)
-- ni de la presentación visual del HUD (delegado a MatchmakingController).

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerScriptService = game:GetService("ServerScriptService")

local Config = require(ReplicatedStorage.Shared.Config)
local Types = require(ReplicatedStorage.Shared.Types)

type QueueSnapshot = Types.QueueSnapshot
type MatchmakingZoneConfig = Types.MatchmakingZoneConfig
type QueueStateName = Types.QueueStateName

export type ZoneData = {
	ZoneId: string,
	Instance: Folder,
	ZoneName: string,
	Config: MatchmakingZoneConfig,
	RedPads: { BasePart },
	BluePads: { BasePart },
	PadOccupants: { [BasePart]: { Player } },
	OccupantLastSeen: { [Player]: number },
	CandidateArrivals: { [Player]: number },
	CandidateLastSeen: { [Player]: number },
	CurrentRed: { Player },
	CurrentBlue: { Player },
	State: QueueStateName,
	ActiveReservation: Types.TeamMatchReservation?,
	LastModeNotPlayableWarn: string?,
}

local MatchmakingService = {}
MatchmakingService.Name = "MatchmakingService"

MatchmakingService._context = nil :: any
MatchmakingService._zones = {} :: { [Folder]: ZoneData }
MatchmakingService._latestSnapshots = {} :: { [string]: QueueSnapshot }
MatchmakingService._checkConnection = nil :: RBXScriptConnection?
MatchmakingService._lastCheck = 0
MatchmakingService._queueStatusRemote = nil :: RemoteEvent?
MatchmakingService._containerConnections = {} :: { RBXScriptConnection }
MatchmakingService._testCharacterMap = {} :: { [Model]: any }

-- Obtiene el Player asociado a una parte de un personaje
local function getPlayerFromPart(part: BasePart): Player?
	local current: Instance? = part
	while current and current ~= workspace do
		if current:IsA("Model") then
			local player = Players:GetPlayerFromCharacter(current)
			if player then
				return player
			end
			if MatchmakingService._testCharacterMap and MatchmakingService._testCharacterMap[current] then
				return MatchmakingService._testCharacterMap[current]
			end
		end
		current = current.Parent
	end
	return nil
end

local PAD_DETECTION_HEIGHT = 6.0
local OCCUPANT_GRACE_PERIOD = 0.8 -- Segundos de gracia para tolerar saltos y fluctuaciones espaciales

-- Valida si un jugador está conectado, con personaje instanciado en workspace y Humanoid vivo
local function isPlayerAliveAndValid(player: any): boolean
	local isRealPlayer = typeof(player) == "Instance" and player:IsA("Player") and player:IsDescendantOf(Players)
	local isSimulated = typeof(player) == "table" and player.IsSimulatedPlayer == true
	if not isRealPlayer and not isSimulated then return false end
	if isRealPlayer and player:GetAttribute('PartyQueueTicket') then return false end

	local character = player.Character
	if not character or not character:IsDescendantOf(workspace) then return false end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then return false end
	return true
end

-- Detecta los jugadores físicos dentro del volumen de un pad usando GetPartBoundsInBox
local function getPhysicallyPresentPlayersOnPad(pad: BasePart, overlapParams: OverlapParams): { Player }
	local boxCFrame = pad.CFrame * CFrame.new(0, (pad.Size.Y / 2) + (PAD_DETECTION_HEIGHT / 2), 0)
	local boxSize = Vector3.new(pad.Size.X, PAD_DETECTION_HEIGHT, pad.Size.Z)
	local touchingParts = workspace:GetPartBoundsInBox(boxCFrame, boxSize, overlapParams)

	local presentList: { Player } = {}
	local seen: { [Player]: boolean } = {}

	for _, part in ipairs(touchingParts) do
		local player = getPlayerFromPart(part)
		if player and not seen[player] then
			if isPlayerAliveAndValid(player) then
				seen[player] = true
				table.insert(presentList, player)
			end
		end
	end

	return presentList
end

-- Actualiza autoritativamente la ocupación de un conjunto de pads (equipo) aplicando
-- prioridad por orden de llegada (FIFO), reserva por plaza, grace period y prevención de doble ocupación.
local function updateTeamOccupants(
	zone: ZoneData,
	pads: { BasePart },
	maxTeamCapacity: number,
	otherTeamOccupantsSet: { [Player]: boolean },
	overlapParams: OverlapParams,
	now: number,
	service: any
): { Player }
	if #pads == 0 or maxTeamCapacity <= 0 then
		return {}
	end

	local padCapacity = math.max(1, math.ceil(maxTeamCapacity / #pads))

	-- 1. Detección física en cada pad del equipo
	local presentByPad: { [BasePart]: { [Player]: boolean } } = {}
	local allPresentOnTeam: { [Player]: boolean } = {}

	for _, pad in ipairs(pads) do
		local presentList = getPhysicallyPresentPlayersOnPad(pad, overlapParams)
		local padSet: { [Player]: boolean } = {}
		for _, p in ipairs(presentList) do
			padSet[p] = true
			allPresentOnTeam[p] = true
		end
		presentByPad[pad] = padSet
	end

	-- 2. Retención de ocupantes existentes (con grace period)
	local assignedThisTeam: { [Player]: boolean } = {}
	local teamOccupantsList: { Player } = {}

	for _, pad in ipairs(pads) do
		local currentOccupants = zone.PadOccupants[pad] or {}
		local retained: { Player } = {}
		local presentSet = presentByPad[pad] or {}

		for _, occupant in ipairs(currentOccupants) do
			if not isPlayerAliveAndValid(occupant) then
				-- Jugador muerto o desconectado: liberación inmediata sin periodo de gracia
				zone.OccupantLastSeen[occupant] = nil
				zone.CandidateArrivals[occupant] = nil
				zone.CandidateLastSeen[occupant] = nil
			elseif assignedThisTeam[occupant] or otherTeamOccupantsSet[occupant] then
				-- Conflicto: ya asignado a otra plaza o al equipo contrario
				zone.OccupantLastSeen[occupant] = nil
				zone.CandidateArrivals[occupant] = nil
				zone.CandidateLastSeen[occupant] = nil
			else
				if presentSet[occupant] then
					-- Físicamente presente: retiene plaza y actualiza marca temporal
					zone.OccupantLastSeen[occupant] = now
					assignedThisTeam[occupant] = true
					table.insert(retained, occupant)
					table.insert(teamOccupantsList, occupant)
				else
					-- Ausente físicamente en este frame: comprobar periodo de gracia (tolerancia a saltos/jitter)
					local lastSeen = zone.OccupantLastSeen[occupant] or 0
					if (now - lastSeen) <= OCCUPANT_GRACE_PERIOD then
						assignedThisTeam[occupant] = true
						table.insert(retained, occupant)
						table.insert(teamOccupantsList, occupant)
					else
						-- Gracia expirada: abandono confirmado, liberar plaza
						zone.OccupantLastSeen[occupant] = nil
						zone.CandidateArrivals[occupant] = nil
						zone.CandidateLastSeen[occupant] = nil
					end
				end
			end
		end

		zone.PadOccupants[pad] = retained
	end

	-- 3. Registro de candidatos esperando en los pads
	for _, pad in ipairs(pads) do
		local presentSet = presentByPad[pad] or {}
		for p in pairs(presentSet) do
			if not assignedThisTeam[p] and not otherTeamOccupantsSet[p] then
				if not service:_isPlayerOccupantInOtherZone(p, zone) then
					if zone.CandidateArrivals[p] == nil then
						zone.CandidateArrivals[p] = now
					end
					zone.CandidateLastSeen[p] = now
				end
			end
		end
	end

	-- 4. Asignación de plazas disponibles por orden de llegada (FIFO)
	for _, pad in ipairs(pads) do
		local retained = zone.PadOccupants[pad] or {}
		local padSlotsAvailable = padCapacity - #retained
		local teamSlotsAvailable = maxTeamCapacity - #teamOccupantsList

		if padSlotsAvailable > 0 and teamSlotsAvailable > 0 then
			local presentSet = presentByPad[pad] or {}
			local candidates: { Player } = {}

			for p in pairs(presentSet) do
				if not assignedThisTeam[p]
					and not otherTeamOccupantsSet[p]
					and not service:_isPlayerOccupantInOtherZone(p, zone)
					and not table.find(retained, p) then
					table.insert(candidates, p)
				end
			end

			-- Ordenar candidatos por orden de llegada estricto
			table.sort(candidates, function(a, b)
				local timeA = zone.CandidateArrivals[a] or math.huge
				local timeB = zone.CandidateArrivals[b] or math.huge
				if timeA == timeB then
					return a.UserId < b.UserId
				end
				return timeA < timeB
			end)

			local toAssign = math.min(padSlotsAvailable, teamSlotsAvailable, #candidates)
			for i = 1, toAssign do
				local chosen = candidates[i]
				table.insert(retained, chosen)
				table.insert(teamOccupantsList, chosen)
				assignedThisTeam[chosen] = true
				zone.OccupantLastSeen[chosen] = now
			end

			zone.PadOccupants[pad] = retained
		end
	end

	-- 5. Limpieza de candidatos que se retiraron (respetando gracia para evitar pérdida por salto)
	for candidate, lastSeen in pairs(zone.CandidateLastSeen) do
		if not allPresentOnTeam[candidate] and not assignedThisTeam[candidate] then
			if (now - lastSeen) > OCCUPANT_GRACE_PERIOD then
				zone.CandidateArrivals[candidate] = nil
				zone.CandidateLastSeen[candidate] = nil
			end
		end
	end

	return teamOccupantsList
end

-- Attributes describe an authorized mode; they never define a new mode or its capacity.
local function getZoneConfiguration(zoneFolder: Folder): (MatchmakingZoneConfig?, string?)
	local modeAttr = zoneFolder:GetAttribute("Mode")
	local teamSizeAttr = zoneFolder:GetAttribute("TeamSize")
	local maxPerTeamAttr = zoneFolder:GetAttribute("MaxPlayersPerTeam")
	local totalAttr = zoneFolder:GetAttribute("TotalPlayers")

	local modeName = if type(modeAttr) == "string" and modeAttr ~= "" then modeAttr else zoneFolder.Name
	local configDefaults = Config.Matchmaking and Config.Matchmaking.Modes and Config.Matchmaking.Modes[modeName]

	if not configDefaults then return nil, "UnknownMode" end
	for _, entry in ipairs({
		{ Value = teamSizeAttr, Expected = configDefaults.TeamSize },
		{ Value = maxPerTeamAttr, Expected = configDefaults.MaxPlayersPerTeam },
		{ Value = totalAttr, Expected = configDefaults.TotalPlayers },
	}) do
		if entry.Value ~= nil and entry.Value ~= entry.Expected then
			return nil, "ModeCapacityMismatch"
		end
	end

	return {
		Mode = modeName,
		TeamSize = configDefaults.TeamSize,
		MaxPlayersPerTeam = configDefaults.MaxPlayersPerTeam,
		TotalPlayers = configDefaults.TotalPlayers,
	}
end

-- Verifica si un ZoneId ya está tomado por otra zona activa
function MatchmakingService:_isZoneIdTaken(zoneId: string, currentFolder: Folder): boolean
	for folder, data in pairs(self._zones) do
		if folder ~= currentFolder and data.ZoneId == zoneId then
			return true
		end
	end
	return false
end

-- Verifica si un jugador ya ocupa autoritativamente un pad en otra zona diferente
function MatchmakingService:_isPlayerOccupantInOtherZone(player: Player, currentZone: ZoneData): boolean
	for _, zone in pairs(self._zones) do
		if zone ~= currentZone then
			if table.find(zone.CurrentRed, player) or table.find(zone.CurrentBlue, player) then
				return true
			end
		end
	end
	return false
end

function MatchmakingService:Init(context)
	self._context = context
	self._zones = {}
	self._latestSnapshots = {}
	self._containerConnections = {}
	_G.MatchmakingService = self

	-- Garantizar Remote de estado de cola
	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	local mmFolder = remotes and remotes:FindFirstChild("Matchmaking")
	local queueRemote = mmFolder and mmFolder:FindFirstChild("QueueStatus")
	if queueRemote and queueRemote:IsA("RemoteEvent") then
		self._queueStatusRemote = queueRemote
	end

	-- Descubrir zonas en Workspace.ZoneMatchmaking
	local zoneContainer = workspace:FindFirstChild("ZoneMatchmaking")
	if not zoneContainer then
		warn("[MatchmakingService] No se encontro Workspace.ZoneMatchmaking")
		return
	end

	-- Registrar todas las zonas existentes
	for _, child in ipairs(zoneContainer:GetChildren()) do
		if child:IsA("Folder") then
			self:_registerZone(child)
		end
	end

	-- Conectar descubrimiento dinámico en tiempo de ejecución (Runtime Add / Remove)
	table.insert(self._containerConnections, zoneContainer.ChildAdded:Connect(function(child: Instance)
		if child:IsA("Folder") then
			-- Dar un frame para asegurar inicialización de atributos y jerarquía en caso de clonación
			task.defer(function()
				if child.Parent == zoneContainer then
					self:_registerZone(child)
				end
			end)
		end
	end))

	table.insert(self._containerConnections, zoneContainer.ChildRemoved:Connect(function(child: Instance)
		if child:IsA("Folder") then
			self:_unregisterZone(child)
		end
	end))
end

function MatchmakingService:_registerZone(zoneFolder: Folder)
	if not zoneFolder or not zoneFolder:IsA("Folder") then return end
	if self._zones[zoneFolder] then return end

	local config, configError = getZoneConfiguration(zoneFolder)
	if not config then
		-- Decorative folders have no join pads and are not matchmaking zones.
		if zoneFolder:FindFirstChild("joins-parts") then
			warn(string.format("[MatchmakingService] Zona rechazada '%s': %s", zoneFolder.Name, tostring(configError)))
		end
		return
	end
	local joinsFolder = zoneFolder:FindFirstChild("joins-parts")

	local redPads: { BasePart } = {}
	local bluePads: { BasePart } = {}

	if joinsFolder then
		for _, part in ipairs(joinsFolder:GetChildren()) do
			if part:IsA("BasePart") then
				local teamAttr = part:GetAttribute("Team")
				if teamAttr == "Red" or part.Name == "Red" or part.Name:find("Red") then
					table.insert(redPads, part)
				elseif teamAttr == "Blue" or part.Name == "Blue" or part.Name:find("Blue") then
					table.insert(bluePads, part)
				end
			end
		end
	end

	if #redPads == 0 or #bluePads == 0 then
		warn(string.format("[MatchmakingService] Zona rechazada '%s': MissingTeamPads", zoneFolder.Name))
		return
	end
	table.sort(redPads, function(a, b) return a.Name < b.Name end)
	table.sort(bluePads, function(a, b) return a.Name < b.Name end)

	-- Generación de ZoneId único
	local attrId = zoneFolder:GetAttribute("ZoneId")
	local zoneId: string
	if typeof(attrId) == "string" and attrId ~= "" then
		if self:_isZoneIdTaken(attrId, zoneFolder) then
			warn(string.format("[MatchmakingService] Zona rechazada '%s': DuplicateZoneId", zoneFolder.Name))
			return
		end
		zoneId = attrId
	else
		local baseId = "Zone_" .. zoneFolder.Name
		local uniqueId = baseId
		local counter = 1
		while self:_isZoneIdTaken(uniqueId, zoneFolder) do
			counter += 1
			uniqueId = string.format("%s_%d", baseId, counter)
		end
		zoneId = uniqueId
	end

	local padOccupants: { [BasePart]: { Player } } = {}
	for _, pad in ipairs(redPads) do
		padOccupants[pad] = {}
	end
	for _, pad in ipairs(bluePads) do
		padOccupants[pad] = {}
	end

	local zoneData: ZoneData = {
		ZoneId = zoneId,
		Instance = zoneFolder,
		ZoneName = zoneFolder.Name,
		Config = config,
		RedPads = redPads,
		BluePads = bluePads,
		PadOccupants = padOccupants,
		OccupantLastSeen = {},
		CandidateArrivals = {},
		CandidateLastSeen = {},
		CurrentRed = {},
		CurrentBlue = {},
		State = "WAITING",
		ActiveReservation = nil,
		LastModeNotPlayableWarn = nil,
	}

	-- Registrar en MatchmakingFeedbackService
	local feedbackService = self:_getFeedbackService()
	if feedbackService then
		feedbackService:RegisterZone(zoneFolder)
	end

	self._zones[zoneFolder] = zoneData
	print(string.format("[MatchmakingService] Zona registrada: '%s' (ZoneId=%s, Modo=%s, TeamSize=%d, MaxTotal=%d)",
		zoneFolder.Name, zoneId, config.Mode, config.TeamSize, config.TotalPlayers))
end

function MatchmakingService:_unregisterZone(zoneFolder: Folder)
	local zoneData = self._zones[zoneFolder]
	if not zoneData then return end

	-- Cleanup en feedback audiovisual
	local feedbackService = self:_getFeedbackService()
	if feedbackService then
		feedbackService:UnregisterZone(zoneFolder)
	end

	-- Emitir snapshot vacío final a los clientes si la zona tenía jugadores
	if #zoneData.CurrentRed > 0 or #zoneData.CurrentBlue > 0 then
		if self._queueStatusRemote then
			local finalSnapshot: QueueSnapshot = {
				ZoneId = zoneData.ZoneId,
				ZoneName = zoneData.ZoneName,
				Mode = zoneData.Config.Mode,
				TeamSize = zoneData.Config.TeamSize,
				MaxPlayersPerTeam = zoneData.Config.MaxPlayersPerTeam,
				TotalPlayers = zoneData.Config.TotalPlayers,
				Red = {},
				Blue = {},
				State = "WAITING",
			}
			self._queueStatusRemote:FireAllClients(finalSnapshot)
		end
	end

	-- Limpieza de caché de snapshots
	self._latestSnapshots[zoneData.ZoneId] = nil
	self._latestSnapshots[zoneData.ZoneName] = nil

	-- Limpieza de tablas de ocupación
	table.clear(zoneData.PadOccupants)
	table.clear(zoneData.OccupantLastSeen)
	table.clear(zoneData.CandidateArrivals)
	table.clear(zoneData.CandidateLastSeen)
	table.clear(zoneData.CurrentRed)
	table.clear(zoneData.CurrentBlue)
	zoneData.ActiveReservation = nil

	self._zones[zoneFolder] = nil
	print(string.format("[MatchmakingService] Zona desregistrada y limpiada: '%s' (ZoneId=%s)",
		zoneFolder.Name, zoneData.ZoneId))
end

-- Limpia de forma inmediata reservas huérfanas al desconectarse un jugador
function MatchmakingService:_handlePlayerRemoving(player: Player)
	local needsUpdate = false
	for _, zone in pairs(self._zones) do
		zone.OccupantLastSeen[player] = nil
		zone.CandidateArrivals[player] = nil
		zone.CandidateLastSeen[player] = nil

		for pad, occupants in pairs(zone.PadOccupants) do
			local idx = table.find(occupants, player)
			if idx then
				table.remove(occupants, idx)
				needsUpdate = true
			end
		end
	end

	if needsUpdate then
		self:_updateQueue()
	end
end

function MatchmakingService:Start(context)
	self._context = context

	-- Monitoreo de ocupación cada 0.3s
	self._checkConnection = RunService.Heartbeat:Connect(function()
		local now = os.clock()
		if now - self._lastCheck < 0.3 then return end
		self._lastCheck = now
		self:_updateQueue()
	end)

	-- Limpieza inmediata cuando un jugador se desconecta del servidor
	Players.PlayerRemoving:Connect(function(player: Player)
		self:_handlePlayerRemoving(player)
	end)

	print("[MatchmakingService] Servicio de matchmaking genérico iniciado")
end

function MatchmakingService:_getRoundService()
	if self._context and self._context.GetService then
		local s = self._context:GetService("RoundService")
		if s then return s end
	end

	local servicesFolder = ServerScriptService:FindFirstChild("Services")
	local mod = servicesFolder and servicesFolder:FindFirstChild("RoundService")
	if mod and mod:IsA("ModuleScript") then
		local ok, result = pcall(require, mod)
		if ok then return result end
	end
	return nil
end

function MatchmakingService:_getFeedbackService()
	if self._context and self._context.GetService then
		local s = self._context:GetService("MatchmakingFeedbackService")
		if s then return s end
	end

	local servicesFolder = ServerScriptService:FindFirstChild("Services")
	local mod = servicesFolder and servicesFolder:FindFirstChild("MatchmakingFeedbackService")
	if mod and mod:IsA("ModuleScript") then
		local ok, result = pcall(require, mod)
		if ok then return result end
	end
	return nil
end

-- Compara si dos listas de jugadores son idénticas
local function arePlayerListsEqual(a: { Player }, b: { Player }): boolean
	if #a ~= #b then return false end
	for i = 1, #a do
		if a[i] ~= b[i] then return false end
	end
	return true
end

function MatchmakingService:_updateQueue()
	local feedbackService = self:_getFeedbackService()
	local roundService = self:_getRoundService()
	local now = os.clock()

	-- Construir lista de personajes para OverlapParams
	local overlapParams = OverlapParams.new()
	overlapParams.FilterType = Enum.RaycastFilterType.Include
	local characterList = {}
	for _, player in ipairs(Players:GetPlayers()) do
		if player.Character then
			table.insert(characterList, player.Character)
		end
	end
	if self._testCharacterMap then
		for charModel, _ in pairs(self._testCharacterMap) do
			if charModel:IsDescendantOf(workspace) then
				table.insert(characterList, charModel)
			end
		end
	end
	overlapParams.FilterDescendantsInstances = characterList

	for zoneFolder, zone in pairs(self._zones) do
		-- Si la zona fue destruida o desparentada, desregistrar y omitir
		if not zoneFolder or not zoneFolder:IsDescendantOf(workspace) then
			self:_unregisterZone(zoneFolder)
			continue
		end

		-- Conjunto de ocupantes actuales de Blue para pasárselo a Red
		local currentBlueSet: { [Player]: boolean } = {}
		for _, p in ipairs(zone.CurrentBlue) do
			currentBlueSet[p] = true
		end

		local redOccupants = updateTeamOccupants(
			zone,
			zone.RedPads,
			zone.Config.MaxPlayersPerTeam,
			currentBlueSet,
			overlapParams,
			now,
			self
		)

		-- Conjunto de ocupantes actualizados de Red para pasárselo a Blue
		local currentRedSet: { [Player]: boolean } = {}
		for _, p in ipairs(redOccupants) do
			currentRedSet[p] = true
		end

		local blueOccupants = updateTeamOccupants(
			zone,
			zone.BluePads,
			zone.Config.MaxPlayersPerTeam,
			currentRedSet,
			overlapParams,
			now,
			self
		)

		local redChanged = not arePlayerListsEqual(zone.CurrentRed, redOccupants)
		local blueChanged = not arePlayerListsEqual(zone.CurrentBlue, blueOccupants)

		zone.CurrentRed = redOccupants
		zone.CurrentBlue = blueOccupants
		if roundService and roundService.CancelPreparationIfOccupancyLost then
			roundService:CancelPreparationIfOccupancyLost(zone.ZoneId)
		end

		-- Actualizar feedback audiovisual discreto por instancia de zona
		if feedbackService then
			feedbackService:SetPadOccupied(zoneFolder, "Red", #redOccupants > 0, redOccupants[1])
			feedbackService:SetPadOccupied(zoneFolder, "Blue", #blueOccupants > 0, blueOccupants[1])
		end

		-- Determinar candidatos comprometidos según TeamSize
		local committedRed: { Player } = {}
		for i = 1, math.min(#redOccupants, zone.Config.TeamSize) do
			table.insert(committedRed, redOccupants[i])
		end
		local committedBlue: { Player } = {}
		for i = 1, math.min(#blueOccupants, zone.Config.TeamSize) do
			table.insert(committedBlue, blueOccupants[i])
		end

		-- Verificar que los equipos sean disjuntos
		local disjoint = true
		for _, r in ipairs(committedRed) do
			if table.find(committedBlue, r) then
				disjoint = false
				break
			end
		end

		-- Verificar que ninguno de los participantes esté registrado en otra partida
		local anyAlreadyInMatch = false
		if roundService and roundService.GetSessionForPlayer then
			for _, p in ipairs(committedRed) do
				if roundService:GetSessionForPlayer(p) ~= nil then
					anyAlreadyInMatch = true
					break
				end
			end
			if not anyAlreadyInMatch then
				for _, p in ipairs(committedBlue) do
					if roundService:GetSessionForPlayer(p) ~= nil then
						anyAlreadyInMatch = true
						break
					end
				end
			end
		end

		local socialPlay=self:_socialPlay()
   local groupsReady=not socialPlay or (socialPlay:CanQueueTeam(committedRed,zone.Config.TeamSize)and socialPlay:CanQueueTeam(committedBlue,zone.Config.TeamSize))
   local isReady = groupsReady and (#committedRed == zone.Config.TeamSize)
			and (#committedBlue == zone.Config.TeamSize)
			and disjoint
			and not anyAlreadyInMatch

		-- Gestionar token autoritativo de reserva
		if isReady then
			-- Comprobar si la reserva existente sigue siendo válida para la misma plantilla
			local currentRes = zone.ActiveReservation
			local needsNewRes = true
			if currentRes and (os.clock() <= currentRes.ExpiresAt) then
				if currentRes.Mode == zone.Config.Mode
					and currentRes.TeamSize == zone.Config.TeamSize
					and #currentRes.RedTeam == #committedRed
					and #currentRes.BlueTeam == #committedBlue
				then
					local matches = true
					for i = 1, #committedRed do
						if currentRes.RedTeam[i] ~= committedRed[i] then
							matches = false
							break
						end
					end
					if matches then
						for i = 1, #committedBlue do
							if currentRes.BlueTeam[i] ~= committedBlue[i] then
								matches = false
								break
							end
						end
					end
					if matches then
						needsNewRes = false
					end
				end
			end

			if needsNewRes then
				self:CreateReservation(zone.ZoneId, zone.Config.Mode, zone.Config.TeamSize, committedRed, committedBlue)
			end
		else
			-- Si no está listo, invalidar cualquier reserva previa
			zone.ActiveReservation = nil
		end

		local newState: QueueStateName = if isReady then "READY" else "WAITING"
		local stateChanged = zone.State ~= newState
		zone.State = newState

		-- Emitir QueueSnapshot cuando hay cambios o para sincronización
		if redChanged or blueChanged or stateChanged or (zone :: any).ForceSnapshot then
			(zone :: any).ForceSnapshot = nil
			local snapshot: QueueSnapshot = {
				ZoneId = zone.ZoneId,
				ZoneName = zone.ZoneName,
				Mode = zone.Config.Mode,
				TeamSize = zone.Config.TeamSize,
				MaxPlayersPerTeam = zone.Config.MaxPlayersPerTeam,
				TotalPlayers = zone.Config.TotalPlayers,
				Red = redOccupants,
				Blue = blueOccupants,
				State = newState,
			}

			self._latestSnapshots[zone.ZoneId] = snapshot
			self._latestSnapshots[zone.ZoneName] = snapshot

			if self._queueStatusRemote then
				self._queueStatusRemote:FireAllClients(snapshot)
			end
		end

		-- Disparar inicio de partida cuando la cola está lista y RoundService disponible
		if isReady and roundService and roundService:IsAvailable() then
			local token = if zone.ActiveReservation then zone.ActiveReservation.Token else nil
			local admissionRequest: Types.TeamMatchAdmissionRequest = {
				ZoneId = zone.ZoneId,
				Mode = zone.Config.Mode,
				TeamSize = zone.Config.TeamSize,
				RedTeam = committedRed,
				BlueTeam = committedBlue,
				ReservationToken = token,
			}

			local ok, reason = roundService:StartTeamMatch(admissionRequest)
			if not ok then
				if reason == "ModeNotPlayable" then
					if zone.LastModeNotPlayableWarn ~= zone.Config.Mode then
						zone.LastModeNotPlayableWarn = zone.Config.Mode
						print(string.format("[MatchmakingService] Modalidad '%s' en zona '%s' admitida estructuralmente pero bloqueada para juego real (ModeNotPlayable)",
							zone.Config.Mode, zone.ZoneId))
					end
				else
					-- No silenciar otros errores
				end
			else
				zone.LastModeNotPlayableWarn = nil
			end
		end
	end
end

-- A party remains a complete cohort on the same physical team; no remote teleports.
function MatchmakingService:IsPlayerOnPhysicalQueue(player: Player): boolean
 for _,zone in pairs(self._zones)do
  if table.find(zone.CurrentRed,player)or table.find(zone.CurrentBlue,player)then return true end
 end
 return false
end
function MatchmakingService:IsPlayerQueued(player: Player): boolean
 return (typeof(player)=='Instance'and player:GetAttribute('PartyQueueTicket')~=nil)or self:IsPlayerOnPhysicalQueue(player)
end
function MatchmakingService:_socialPlay(): any
 return self._context and self._context:GetService('SocialPlayService')
end

-- Consulta de snapshot público (por Folder, ZoneId o ZoneName)
function MatchmakingService:GetQueueSnapshot(identifier: any): QueueSnapshot?
	if typeof(identifier) == "Instance" and identifier:IsA("Folder") then
		local data = self._zones[identifier]
		return data and self._latestSnapshots[data.ZoneId]
	elseif typeof(identifier) == "string" then
		return self._latestSnapshots[identifier]
	end
	return self._latestSnapshots["1v1"] or next(self._latestSnapshots)
end

-- Consulta de configuración de zona
function MatchmakingService:GetZoneConfig(identifier: any): MatchmakingZoneConfig?
	if typeof(identifier) == "Instance" and identifier:IsA("Folder") then
		local data = self._zones[identifier]
		return data and data.Config
	elseif typeof(identifier) == "string" then
		for _, data in pairs(self._zones) do
			if data.ZoneId == identifier or data.ZoneName == identifier then
				return data.Config
			end
		end
	end
	return nil
end

-- Obtiene la tabla completa de zonas registradas
function MatchmakingService:GetAllZones(): { [Folder]: ZoneData }
	return self._zones
end

-- Crea una reserva autoritativa para una plantilla lista
function MatchmakingService:CreateReservation(
	zoneId: string,
	mode: string,
	teamSize: number,
	redTeam: { Player },
	blueTeam: { Player },
	ttlSeconds: number?
): Types.TeamMatchReservation?
	local targetZone: ZoneData? = nil
	for _, z in pairs(self._zones) do
		if z.ZoneId == zoneId then
			targetZone = z
			break
		end
	end
	if not targetZone then return nil end

	local ttl = ttlSeconds or (Config.Matchmaking and Config.Matchmaking.ReservationTTL) or 15
	local now = os.clock()
	local token = HttpService:GenerateGUID(false)

	local redCopy: { Player } = {}
	for _, p in ipairs(redTeam) do table.insert(redCopy, p) end
	local blueCopy: { Player } = {}
	for _, p in ipairs(blueTeam) do table.insert(blueCopy, p) end

	local reservation: Types.TeamMatchReservation = {
		Token = token,
		ZoneId = zoneId,
		Mode = mode,
		TeamSize = teamSize,
		RedTeam = redCopy,
		BlueTeam = blueCopy,
		CreatedAt = now,
		ExpiresAt = now + ttl,
	}

	targetZone.ActiveReservation = reservation
	return reservation
end

-- Obtiene la reserva autoritativa activa de una zona
function MatchmakingService:GetActiveReservation(zoneId: string): Types.TeamMatchReservation?
	for _, z in pairs(self._zones) do
		if z.ZoneId == zoneId then
			return z.ActiveReservation
		end
	end
	return nil
end

-- Valida que un token corresponda exactamente a la plantilla y zona activa sin haber expirado
function MatchmakingService:ValidateReservation(
	token: string,
	request: Types.TeamMatchAdmissionRequest
): (boolean, string?)
 if type(request.ZoneId)=='string'and request.ZoneId:sub(1,5)=='Menu:'then
  local menu=self._context:GetService('PartyMatchService');return menu and menu:ValidateReservation(token,request)or false,'InvalidMenuReservation'
 end
 if type(request.ZoneId)=='string'and request.ZoneId:sub(1,5)=='Duel:'then
  local play=self:_socialPlay();if not play then return false,'SocialPlayUnavailable'end
  return play:ValidateDuel(token,request)
 end

	if not token or token == "" then
		return false, "MissingReservationToken"
	end

	local foundZone: ZoneData? = nil
	for _, z in pairs(self._zones) do
		if z.ActiveReservation and z.ActiveReservation.Token == token then
			foundZone = z
			break
		end
	end

	if not foundZone or not foundZone.ActiveReservation then
		return false, "ReservationNotFound"
	end

	local res = foundZone.ActiveReservation
	local now = os.clock()
	if now > res.ExpiresAt then
		foundZone.ActiveReservation = nil
		return false, "ReservationExpired"
	end

	if res.ZoneId ~= request.ZoneId then
		return false, "ReservationZoneMismatch"
	end

	if res.Mode ~= request.Mode then
		return false, "ReservationModeMismatch"
	end

	if res.TeamSize ~= request.TeamSize then
		return false, "ReservationTeamSizeMismatch"
	end

	if #res.RedTeam ~= #request.RedTeam or #res.BlueTeam ~= #request.BlueTeam then
		return false, "ReservationRosterMismatch"
	end

	for i = 1, #res.RedTeam do
		if res.RedTeam[i] ~= request.RedTeam[i] then
			return false, "ReservationRosterMismatch"
		end
	end

	for i = 1, #res.BlueTeam do
		if res.BlueTeam[i] ~= request.BlueTeam[i] then
			return false, "ReservationRosterMismatch"
		end
	end

	return true, nil
end

-- Consume de forma atómica una reserva al ser admitida la partida
function MatchmakingService:ConsumeReservation(token: string): boolean
 local menu=self._context and self._context:GetService('PartyMatchService');if menu and menu:ConsumeReservation(token)then return true end
 local play=self:_socialPlay();if play and play:ConsumeDuel(token)then return true end
	for _, z in pairs(self._zones) do
		if z.ActiveReservation and z.ActiveReservation.Token == token then
			z.ActiveReservation = nil
			return true
		end
	end
	return false
end

-- Invalida de forma explícita la reserva de una zona
-- Preserve physical occupancy/FIFO; only invalidate this preparation's reservation.
function MatchmakingService:ReleasePreparation(zoneId: string, token: string?)
 if zoneId:sub(1,5)=='Menu:'then local menu=self._context:GetService('PartyMatchService');if menu then menu:Release(zoneId,token)end;return end
 if zoneId:sub(1,5)=='Duel:'then local play=self:_socialPlay();if play then play:ReleaseDuel(zoneId,token)end;return end
	for _,zone in pairs(self._zones) do
		if zone.ZoneId == zoneId then
			if zone.ActiveReservation and zone.ActiveReservation.Token == token then zone.ActiveReservation = nil end
			(zone :: any).ForceSnapshot = true
			return
		end
	end
end

function MatchmakingService:InvalidateReservation(zoneId: string)
	for _, z in pairs(self._zones) do
		if z.ZoneId == zoneId then
			z.ActiveReservation = nil
			break
		end
	end
end

-- Verifica de manera server-authoritative si los jugadores siguen siendo los ocupantes registrados de su zona
function MatchmakingService:ArePlayersInZone(
	zoneId: string,
	redPlayerOrTeam: Player | { Player },
	bluePlayerOrTeam: Player | { Player },
	requirePhysical: boolean?
): boolean
	if not zoneId or not redPlayerOrTeam or not bluePlayerOrTeam then
		return false
	end

	local redList: { Player } = if typeof(redPlayerOrTeam) == "table" and not (redPlayerOrTeam :: any).IsSimulatedPlayer then (redPlayerOrTeam :: { Player }) else { redPlayerOrTeam :: Player }
	local blueList: { Player } = if typeof(bluePlayerOrTeam) == "table" and not (bluePlayerOrTeam :: any).IsSimulatedPlayer then (bluePlayerOrTeam :: { Player }) else { bluePlayerOrTeam :: Player }

	if #redList == 0 or #blueList == 0 then
		return false
	end
	if zoneId:sub(1,5)=='Menu:'then local menu=self._context:GetService('PartyMatchService');return menu~=nil and menu:Prepared(zoneId,redList,blueList)end

	for _, p in ipairs(redList) do
		if not isPlayerAliveAndValid(p) then return false end
	end
	for _, p in ipairs(blueList) do
		if not isPlayerAliveAndValid(p) then return false end
	end

 if zoneId:sub(1,5)=='Duel:'then
  local play=self:_socialPlay();return play~=nil and play:DuelPrepared(zoneId,redList,blueList)
 end

	-- 1. Resolver la zona mediante ZoneId
	local targetZone: ZoneData? = nil
	for _, zone in pairs(self._zones) do
		if zone.ZoneId == zoneId then
			targetZone = zone
			break
		end
	end

	if not targetZone then
		return false
	end

	-- Verificar existencia de la instancia física
	if not targetZone.Instance or not targetZone.Instance:IsDescendantOf(workspace) then
		return false
	end

	-- 2. Verificar que todos los jugadores de cada equipo están registrados en la zona
	for _, p in ipairs(redList) do
		if not table.find(targetZone.CurrentRed, p) then
			return false
		end
	end
	for _, p in ipairs(blueList) do
		if not table.find(targetZone.CurrentBlue, p) then
			return false
		end
	end

	if requirePhysical then
		local params=OverlapParams.new()
		params.FilterType=Enum.RaycastFilterType.Include
		local characters={}
		for _,list in ipairs({redList,blueList}) do for _,p in ipairs(list) do table.insert(characters,p.Character) end end
		params.FilterDescendantsInstances=characters
		for _,entry in ipairs({{Pads=targetZone.RedPads,Players=redList},{Pads=targetZone.BluePads,Players=blueList}}) do
			local present={}
			for _,pad in ipairs(entry.Pads) do for _,p in ipairs(getPhysicallyPresentPlayersOnPad(pad,params)) do present[p]=true end end
			for _,p in ipairs(entry.Players) do if not present[p] then return false end end
		end
	end
	return true
end

return MatchmakingService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="977">
        <Properties>
          <string name="Name">PartyMatchService</string>
          <string name="Source"><![CDATA[--!nonstrict
local Players=game:GetService('Players')
local RS=game:GetService('ReplicatedStorage')
local Run=game:GetService('RunService')
local Http=game:GetService('HttpService')
local Config=require(RS.Shared.PartyMatchConfig)
local Model=require(script.Parent.Gameplay.PartyQueueModel)
local Store=require(script.Parent.Gameplay.PartyQueueStore)
local Service={Name='PartyMatchService'}
local function now()return workspace:GetServerTimeNow()end
local function guid()return Http:GenerateGUID(false)end
local function connected(id)return Players:GetPlayerByUserId(id)end
local function ensure(parent,name,class)
 local o=parent:FindFirstChild(name);if o then assert(o:IsA(class));return o end
 o=Instance.new(class);o.Name=name;o.Parent=parent;return o
end
function Service:Init(context)
 self.Context=context;self.Social=context:GetService('SocialPlayService');self.Rounds=context:GetService('RoundService')
 self.MM=context:GetService('MatchmakingService');self.Profiles=context:GetService('PlayerService')
 local info=context.PersistenceInfo
 self.Global=not Run:IsStudio()and Config.GlobalEnabled and game.GameId==Config.ApprovedUniverseId
  and info and info.Environment=='Production'and info.WritesToCloud==true or false
 self.Enabled=Run:IsStudio()and info and info.ProviderName=='InMemory'and info.WritesToCloud==false or self.Global
 self.Job=game.JobId~=''and game.JobId or guid();self.Store=Store.new(self.Global,'PartyMatchV1_'..game.PlaceId)
 self.Tickets={};self.Regions={};self.Last={};self.Busy={};self.Grants={};self.PendingArrivals={};self.Arrivals={};self.ArrivalLoading={};self.Returning={};self.ReturnGroups={}
 self.IsReserved=self.Global and game.PrivateServerId~=''and game.PrivateServerOwnerId==0
 local folder=ensure(RS.Remotes,'PartyMatch','Folder');self.Remote=ensure(folder,'Request','RemoteFunction');self.Updated=ensure(folder,'Updated','RemoteEvent')
end
function Service:Available(p,ownTicket)
 if not p or p.Parent~=Players or not self.Profiles:IsShopDataReady(p)then return false end
 if self.Rounds:GetSessionForPlayer(p)or p:GetAttribute('ResultsSessionId')or p:GetAttribute('TrainingSessionId')then return false end
 local lock=p:GetAttribute('PartyQueueTicket');if lock and lock~=ownTicket then return false end
 if self.MM:IsPlayerOnPhysicalQueue(p)then return false end
 local trade=self.Context:GetService('SocialService');if trade and trade.Engine and trade.Engine.Busy[p.UserId]then return false end
 local crates=self.Context:GetService('CrateService');if crates and crates._stands and crates._stands.Active[p.UserId]then return false end
 local h=p.Character and p.Character:FindFirstChildOfClass('Humanoid');return h~=nil and h.Health>0
end
function Service:State(p)
 local id=p:GetAttribute('PartyQueueTicket');local t=id and self.Tickets[id]
 local modes={};for _,mode in ipairs(Config.Modes)do modes[mode]=self.Rounds:IsModePlayable(mode)end
 return {Ok=true,Enabled=self.Enabled==true,Global=self.Global,Modes=modes,State=t and t.State or self.IsReserved and 'Destination'or 'Idle',Mode=t and t.Mode,
  Since=t and t.Since or 0,Leader=t and t.Leader,CanCancel=t and t.State=='Searching'and t.Leader==p.UserId or false,
  CanReturn=self.IsReserved and not self.Rounds:GetSessionForPlayer(p)and not self.PendingArrivals[p.UserId]and not self.Destination,
  Server=Run:IsStudio()and 'Studio' or self.Job:sub(1,8),Version=game.PlaceVersion,Region='Región del servidor no disponible'}
end
function Service:Push(t,reason)
 for _,id in ipairs(t.Members)do local p=connected(id);if p then local s=self:State(p);s.Reason=reason;self.Updated:FireClient(p,s)end end
end
function Service:Unlock(t,reason)
 if self.Tickets[t.Id]~=t then return end
 local removed=pcall(function()self.Store:Update(t.Mode,function(s)
  local row=s.Tickets[t.Id];if row and row.Job==self.Job then s.Tickets[t.Id]=nil end
 end)end)
 if not removed and now()-t.Since<=Config.MaxSearchSeconds+Config.MatchTTL then return end
 self.Tickets[t.Id]=nil
 for _,id in ipairs(t.Members)do local p=connected(id);if p and p:GetAttribute('PartyQueueTicket')==t.Id then p:SetAttribute('PartyQueueTicket',nil)end end
 self:Push(t,reason)
end
function Service:Join(p,mode)
 if not self.Enabled or self.IsReserved then return {Ok=false,Reason='Unavailable'}end
 if not table.find(Config.Modes,mode)or not self.Rounds:IsModePlayable(mode)then return {Ok=false,Reason='ModeUnavailable'}end
 local size=tonumber(mode:sub(1,1));local group=self.Social.Engine:Group(p.UserId)
 if group and group.Leader~=p.UserId then return {Ok=false,Reason='NotLeader'}end
 local members=group and table.clone(group.Members)or {p.UserId}
 if #members>size then return {Ok=false,Reason='GroupTooLarge'}end
 local ping=0;local region
 for _,id in ipairs(members)do local member=connected(id)
  if not self:Available(member)or self.Social.Engine.Busy[id]then return {Ok=false,Reason='PlayerUnavailable'}end
  local ok,value=pcall(member.GetNetworkPing,member);ping=math.max(ping,ok and value*1000 or 0)
  local r=self.Regions[id]or 'Unknown';region=region and(region==r and r or 'Mixed')or r
 end
 local id=guid();local t={Id=id,Mode=mode,Leader=p.UserId,Members=members,Job=self.Job,CreatedAt=now(),Since=now(),Region=region,Ping=ping,State='Searching'}
 self.Tickets[id]=t;for _,uid in ipairs(members)do connected(uid):SetAttribute('PartyQueueTicket',id)end
 local ok,state=pcall(function()return self.Store:Update(mode,function(s)Model.Prune(s,now());Model.Add(s,t,Config,now())end)end)
 if not ok or not state.Tickets[id]then self:Unlock(t,'QueueUnavailable');return {Ok=false,Reason='QueueUnavailable'}end
 self:Push(t);return self:State(p)
end
function Service:Cancel(p)
 local t=self.Tickets[p:GetAttribute('PartyQueueTicket')];if not t then return self:State(p)end
 if t.Leader~=p.UserId then return {Ok=false,Reason='NotLeader'}end
 local ok,s=pcall(function()return self.Store:Update(t.Mode,function(state)Model.Cancel(state,t.Id,self.Job)end)end)
 if not ok then return {Ok=false,Reason='QueueUnavailable'}end
 if s.Tickets[t.Id]then return {Ok=false,Reason='MatchFound'}end
 self:Unlock(t,'Cancelled');return self:State(p)
end
function Service:Abort(t,reason)
 local ok=pcall(function()self.Store:Update(t.Mode,function(s)
  local row=s.Tickets[t.Id];if row and row.Match then Model.Fail(s,row.Match,reason)end
  s.Tickets[t.Id]=nil
 end)end)
 if ok or now()-t.Since>Config.MaxSearchSeconds+Config.TicketTTL then self:Unlock(t,reason)end
end
function Service:ValidateReservation(token,request)
 local g=self.Grants[token];if not g or g.Consumed or now()>=g.ExpiresAt or g.ZoneId~=request.ZoneId or g.Mode~=request.Mode or g.Size~=request.TeamSize then return false,'InvalidMenuReservation'end
 for _,side in ipairs({'RedTeam','BlueTeam'})do
  if #g[side]~=#request[side]then return false,'InvalidRoster'end
  for i,p in ipairs(g[side])do if p~=request[side][i]or p.Parent~=Players then return false,'InvalidRoster'end end
 end
 return true
end
function Service:ConsumeReservation(token)local g=self.Grants[token];if not g or g.Consumed then return false end;g.Consumed=true;return true end
function Service:Prepared(zone,red,blue)
 for _,g in pairs(self.Grants)do if g.ZoneId==zone and g.Consumed then
  for _,side in ipairs({{g.RedTeam,red},{g.BlueTeam,blue}})do if #side[1]~=#side[2]then return false end
   for i,p in ipairs(side[1])do local s=self.Rounds:GetSessionForPlayer(p);local h=p.Character and p.Character:FindFirstChildOfClass('Humanoid');if p.Parent~=Players or not h or h.Health<=0 or side[2][i]~=p or not s or s.ZoneId~=zone or s.Closing then return false end end
  end;return true
 end end;return false
end
function Service:Release(zone,token)local g=self.Grants[token];if g and g.ZoneId==zone then self.Grants[token]=nil end end
function Service:StartMatch(m)
 local g={ZoneId='Menu:'..m.Id,Mode=m.Mode,Size=m.Size,ExpiresAt=now()+120,RedTeam={},BlueTeam={}}
 for _,side in ipairs({'Red','Blue'})do for _,id in ipairs(m[side])do
  local p=connected(id);if not self:Available(p,p and p:GetAttribute('PartyQueueTicket'))then return false,'PlayerUnavailable'end
  table.insert(g[side..'Team'],p)
 end end
 local token=guid();self.Grants[token]=g
 local ok,started,why=pcall(self.Rounds.StartTeamMatch,self.Rounds,{ZoneId=g.ZoneId,Mode=g.Mode,TeamSize=g.Size,RedTeam=g.RedTeam,BlueTeam=g.BlueTeam,ReservationToken=token})
 if not ok or not started then self.Grants[token]=nil;return false,ok and why or 'StartFailed'end
 return true
end
function Service:RestoreParties(m)
 local e=self.Social.Engine
 for _,t in ipairs(m.Parties)do
  if #t.Members>1 then
   for _,id in ipairs(t.Members)do if e:Group(id)then return false end end
  end
 end
 for _,t in ipairs(m.Parties)do if #t.Members>1 then
  local g={Id=guid(),Leader=t.Leader,Members=table.clone(t.Members),Revision=0};e.Groups[g.Id]=g;e:_publish(g)
 end end;return true
end
function Service:Teleport(t,m)
 if t.State=='Teleporting'then return end
 t.State='Teleporting';t.Match=m.Id;self:Push(t)
 local list={};for _,id in ipairs(t.Members)do local p=connected(id);if not self:Available(p,t.Id)then self:Abort(t,'PlayerUnavailable');return end;table.insert(list,p)end
 local options=Instance.new('TeleportOptions');options.ReservedServerAccessCode=m.AccessCode
 options:SetTeleportData({PartyMatchV1={Id=m.Id,Mode=m.Mode}})
 local ok=pcall(function()game:GetService('TeleportService'):TeleportAsync(game.PlaceId,list,options)end)
 if not ok then self:Abort(t,'TeleportFailed')end
end
function Service:PollMode(mode)
 local timestamp=now();local candidateId=guid();local size=tonumber(mode:sub(1,1))
 local state=self.Store:Update(mode,function(s)
  Model.Prune(s,timestamp)
  for _,t in pairs(self.Tickets)do if t.Mode==mode then Model.Heartbeat(s,t.Id,self.Job,timestamp,Config)end end
  for _,m in pairs(s.Matches)do if m.State=='Allocating'and timestamp>=m.AllocateUntil then Model.Fail(s,m.Id,'ReservationTimeout')end end
  if self.Global or self.Rounds:IsAvailable()then Model.Assign(s,candidateId,mode,size,self.Job,timestamp,Config)end
 end)
 for _,m in pairs(state.Matches)do if m.Owner==self.Job and m.State=='Allocating'then
  if self.Global then
   local ok,access,privateId=pcall(function()return game:GetService('TeleportService'):ReserveServerAsync(game.PlaceId)end)
   state=self.Store:Update(mode,function(s)
    local current=s.Matches[m.Id]
    if current and current.State=='Allocating'and now()<current.AllocateUntil then
     if ok then current.State='Ready';current.AccessCode=access;current.PrivateId=privateId else Model.Fail(s,m.Id,'ReservationFailed')end
    end
   end)
  else
   local ok,why=self:StartMatch(m)
   state=self.Store:Update(mode,function(s)local row=s.Matches[m.Id];if row then row.State=ok and 'Running'or 'Failed';row.Reason=why end end)
  end
 end end
 for _,t in pairs(table.clone(self.Tickets))do if t.Mode==mode then
  local row=state.Tickets[t.Id];local m=row and row.Match and state.Matches[row.Match]
  if not row then self:Unlock(t,'QueueExpired')
  elseif m and m.State=='Failed'then self:Unlock(t,m.Reason)
  elseif m and m.State=='Running'then self:Unlock(t)
  elseif m then
   t.Match=m.Id
   if m.State=='Ready'and self.Global then self:Teleport(t,m)
   elseif t.State~='Teleporting'then t.State='Matched';self:Push(t)end
  else self:Push(t)end
 end end
end
function Service:LoadArrival(p)
 if self.ArrivalLoading[p]or self.Arrivals[p]then return end;self.ArrivalLoading[p]=true
 local ok,join=pcall(p.GetJoinData,p);local payload=ok and join.TeleportData and join.TeleportData.PartyMatchV1
 if not payload or type(payload.Id)~='string'or #payload.Id>64 or not table.find(Config.Modes,payload.Mode)or join.SourcePlaceId~=game.PlaceId then
  self.PendingArrivals[p.UserId]=nil;p:SetAttribute('PartyQueueTicket',nil);self.Arrivals[p]=true;self.ArrivalLoading[p]=nil;return
 end
 local loaded,s=pcall(function()return self.Store:Read(payload.Mode)end)
 local m=loaded and s and s.Matches[payload.Id]
 if not loaded then self.ArrivalLoading[p]=nil;return end
 if not Model.ValidArrival(m,p.UserId,game.PrivateServerId,now())then
  self.PendingArrivals[p.UserId]=nil;p:SetAttribute('PartyQueueTicket',nil);self.Arrivals[p]=true;self.ArrivalLoading[p]=nil;return
 end
 if self.Destination and self.Destination.Id~=m.Id then self.PendingArrivals[p.UserId]=nil;p:SetAttribute('PartyQueueTicket',nil);self.Arrivals[p]=true;self.ArrivalLoading[p]=nil;return end
 self.Destination=self.Destination or m
 self.Arrivals[p]=true;self.ArrivalLoading[p]=nil
 p:SetAttribute('PartyQueueTicket','Arrival:'..m.Id)
end
function Service:DestinationTick()
 if not self.Destination then return end
 local m=self.Destination;local state=self.Store:Read(m.Mode);local current=state and state.Matches[m.Id]
 if not current or current.State=='Failed'or now()>=m.ExpiresAt then self:FinishDestination('ArrivalFailed');return end
 local all=true
 for _,side in ipairs({'Red','Blue'})do for _,id in ipairs(m[side])do
  local p=connected(id)
  if not p or not self.Arrivals[p]or not self:Available(p,'Arrival:'..m.Id)then all=false end
 end end
 if not all then return end
 -- Verify actual latency at the destination rather than treating source ping as a guarantee.
 for _,side in ipairs({'Red','Blue'})do for _,id in ipairs(m[side])do
  if connected(id):GetNetworkPing()*1000>Config.ArrivalMaxPingMs then
   self.Store:Update(m.Mode,function(s)Model.Fail(s,m.Id,'DestinationLatency')end);self:FinishDestination('DestinationLatency');return
  end
 end end
 local committed=self.Store:Update(m.Mode,function(s)
  local row=s.Matches[m.Id]
  if row and row.State=='Ready'and not row.ConsumerJob then row.ConsumerJob=self.Job;row.State='Starting'end
 end)
 local row=committed.Matches[m.Id]
 if not row or row.ConsumerJob~=self.Job or row.State~='Starting'then self:FinishDestination('DestinationUnavailable');return end
 local ok,why=false,'PartyRestoreFailed'
 if self:RestoreParties(row)then ok,why=self:StartMatch(row)end
 self.Store:Update(m.Mode,function(s)local r=s.Matches[m.Id];if r and r.ConsumerJob==self.Job then r.State=ok and 'Running'or 'Failed';r.Reason=why end end)
 self:FinishDestination(ok and nil or why)
end
function Service:FinishDestination(reason)
 self.Destination=nil
 for _,p in ipairs(Players:GetPlayers())do self.PendingArrivals[p.UserId]=nil;p:SetAttribute('PartyQueueTicket',nil)
  local s=self:State(p);s.Reason=reason;self.Updated:FireClient(p,s)
 end
end
function Service:Return(p)
 if not self:State(p).CanReturn or self.Returning[p]then return {Ok=false,Reason='PlayerUnavailable'}end
 local g=self.Social.Engine:Group(p.UserId);if g and g.Leader~=p.UserId then return {Ok=false,Reason='NotLeader'}end
 local members=g and g.Members or {p.UserId};local list={}
 for _,id in ipairs(members)do local q=connected(id);if not q or not self:Available(q)or not self:State(q).CanReturn then return {Ok=false,Reason='PlayerUnavailable'}end;table.insert(list,q)end
 for _,q in ipairs(list)do self.Returning[q]=true end
 local ok=pcall(function()
  local key='Return_'..guid();local data={Members=table.clone(members),Leader=p.UserId,ExpiresAt=now()+Config.MatchTTL}
  self.Store:Update(key,function(s)s.Return=data end)
  local options=Instance.new('TeleportOptions');options:SetTeleportData({PartyReturnV1=key})
  game:GetService('TeleportService'):TeleportAsync(game.PlaceId,list,options)
 end)
 if not ok then for _,q in ipairs(list)do self.Returning[q]=nil end end
 return {Ok=ok,Reason=not ok and 'TeleportFailed'or nil}
end
function Service:LoadReturn(p)
 local join=p:GetJoinData();local key=join.TeleportData and join.TeleportData.PartyReturnV1
 if join.SourcePlaceId~=game.PlaceId or type(key)~='string'or #key>64 or key:sub(1,7)~='Return_'then return end
 p:SetAttribute('PartyQueueTicket',key)
 local ok,s=pcall(function()return self.Store:Update(key,function(state)
  local r=state.Return;if r and r.ExpiresAt>now()and table.find(r.Members,p.UserId)and(not r.Job or r.Job==self.Job)then r.Job=self.Job end
 end)end)
 local r=ok and s.Return
 if r and r.ExpiresAt>now()and r.Job==self.Job and table.find(r.Members,p.UserId)then self.ReturnGroups[key]=r
 else p:SetAttribute('PartyQueueTicket',nil)end
end
function Service:ReturnTick()
 for key,r in pairs(self.ReturnGroups)do
  local ready=true;for _,id in ipairs(r.Members)do local p=connected(id);if not p or not self:Available(p,key)then ready=false end end
  if ready or now()>=r.ExpiresAt then
   if ready then self:RestoreParties({Parties={r}})end
   for _,id in ipairs(r.Members)do local p=connected(id);if p and p:GetAttribute('PartyQueueTicket')==key then p:SetAttribute('PartyQueueTicket',nil)end end
   self.ReturnGroups[key]=nil
   self.Store:Update(key,function(s)s.Return=nil end)
  end
 end
end
function Service:Request(p,action,arg)
 if self.Busy[p]or now()-(self.Last[p]or 0)<.4 then return {Ok=false,Reason='RateLimited'}end
 self.Last[p]=now();self.Busy[p]=true
 local ok,r=pcall(function()
  if action=='State'then return self:State(p)
  elseif action=='Join'and type(arg)=='string'then return self:Join(p,arg)
  elseif action=='Cancel'then return self:Cancel(p)
  elseif action=='Return'then return self:Return(p)end
  return {Ok=false,Reason='InvalidRequest'}
 end)
 self.Busy[p]=nil;if not ok then warn('[PartyMatch] Request failed: '..tostring(r));return {Ok=false,Reason='QueueUnavailable'}end;return r
end
function Service:Start()
 self.Remote.OnServerInvoke=function(...)return self:Request(...)end
 if not self.Enabled then return end
 local function added(p)
  if self.IsReserved then self.PendingArrivals[p.UserId]=now();p:SetAttribute('PartyQueueTicket','ArrivalPending');task.spawn(function()self:LoadArrival(p)end)
  elseif self.Global then task.spawn(function()
   local returned,err=pcall(self.LoadReturn,self,p);if not returned then p:SetAttribute('PartyQueueTicket',nil);warn('[PartyMatch] Return validation failed: '..tostring(err))end
   local ok,r=pcall(function()return game:GetService('LocalizationService'):GetCountryRegionForPlayerAsync(p)end)
   if ok and p.Parent==Players then self.Regions[p.UserId]=r end
  end)end
 end
 Players.PlayerAdded:Connect(added);for _,p in ipairs(Players:GetPlayers())do added(p)end
 Players.PlayerRemoving:Connect(function(p)
  local t=self.Tickets[p:GetAttribute('PartyQueueTicket')];if t and t.State~='Teleporting'then task.spawn(function()self:Abort(t,'Disconnected')end)end
  self.Last[p]=nil;self.Busy[p]=nil;self.Arrivals[p]=nil;self.ArrivalLoading[p]=nil;self.Regions[p.UserId]=nil;self.Returning[p]=nil
 end)
 if self.Global then game:GetService('TeleportService').TeleportInitFailed:Connect(function(p,_,_,_,options)
  self.Returning[p]=nil
  local data=options and options:GetTeleportData();local id=data and data.PartyMatchV1 and data.PartyMatchV1.Id
  local t=self.Tickets[p:GetAttribute('PartyQueueTicket')]
  if t and type(id)=='string'and t.Match==id then task.spawn(function()self:Abort(t,'TeleportFailed')end)end
 end)end
 task.spawn(function()while true do
  task.wait(Config.PollSeconds)
  local ok,err=pcall(function()
   if self.IsReserved then
    for id,since in pairs(self.PendingArrivals)do local p=connected(id)
     if p and now()-since<Config.MatchTTL then self:LoadArrival(p)
     elseif now()-since>=Config.MatchTTL then self.PendingArrivals[id]=nil;if p then p:SetAttribute('PartyQueueTicket',nil)end end
    end
    self:DestinationTick();for _,p in ipairs(Players:GetPlayers())do self.Updated:FireClient(p,self:State(p))end
   else
    self:ReturnTick()
    local modes={}
    for _,t in pairs(table.clone(self.Tickets))do
     local present=false;for _,id in ipairs(t.Members)do if connected(id)then present=true;break end end
     if t.State=='Teleporting'and not present then self:Unlock(t);continue end
     local valid=now()-t.Since<Config.MaxSearchSeconds
     if t.State~='Teleporting'then for _,id in ipairs(t.Members)do if not self:Available(connected(id),t.Id)then valid=false end end end
     if not valid then self:Abort(t,'PlayerUnavailable')else modes[t.Mode]=true end
    end
    for mode in pairs(modes)do self:PollMode(mode)end
   end
   for token,g in pairs(self.Grants)do if not self.Rounds:GetSessionForPlayer(g.RedTeam[1])and now()>g.ExpiresAt then self.Grants[token]=nil end end
  end)
  if not ok then warn('[PartyMatch] Poll failed; leases expire safely: '..tostring(err))end
 end end)
end
return Service
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="978">
        <Properties>
          <string name="Name">Persistence</string>
        </Properties>
        <Item class="ModuleScript" referent="979">
          <Properties>
            <string name="Name">InMemoryDataStore</string>
            <string name="Source"><![CDATA[--!strict
-- InMemoryDataStore
-- Implementa el subconjunto de GlobalDataStore usado por PlayerDataService.
-- Vive solamente durante el servidor actual y nunca accede a servicios cloud.

local InMemoryDataStore = {}
InMemoryDataStore.__index = InMemoryDataStore

export type Diagnostics = {
	ProviderName: string,
	WritesToCloud: boolean,
	GetAsyncCalls: number,
	UpdateAsyncCalls: number,
	CommittedWrites: number,
	StoredKeys: number,
}

export type Store = typeof(setmetatable({} :: {
	_records: { [string]: any },
	_getAsyncCalls: number,
	_updateAsyncCalls: number,
	_committedWrites: number,
}, InMemoryDataStore))

local function deepCopy(value: any, seen: { [any]: any }?): any
	if type(value) ~= "table" then
		return value
	end

	local visited = seen or {}
	if visited[value] ~= nil then
		return visited[value]
	end

	local copy = {}
	visited[value] = copy
	for key, child in pairs(value) do
		copy[deepCopy(key, visited)] = deepCopy(child, visited)
	end
	return copy
end

function InMemoryDataStore.new(): Store
	return setmetatable({
		_records = {},
		_getAsyncCalls = 0,
		_updateAsyncCalls = 0,
		_committedWrites = 0,
	}, InMemoryDataStore) :: any
end

function InMemoryDataStore:GetAsync(key: string): any
	assert(type(key) == "string" and key ~= "", "InMemoryDataStore:GetAsync requires a non-empty string key")
	self._getAsyncCalls += 1
	return deepCopy(self._records[key])
end

function InMemoryDataStore:UpdateAsync(key: string, transform: (any) -> any): any
	assert(type(key) == "string" and key ~= "", "InMemoryDataStore:UpdateAsync requires a non-empty string key")
	assert(type(transform) == "function", "InMemoryDataStore:UpdateAsync requires a transform callback")
	self._updateAsyncCalls += 1

	local previousValue = deepCopy(self._records[key])
	local nextValue = transform(previousValue)
	if nextValue == nil then
		return nil
	end

	local storedValue = deepCopy(nextValue)
	self._records[key] = storedValue
	self._committedWrites += 1
	return deepCopy(storedValue)
end

function InMemoryDataStore:GetDiagnostics(): Diagnostics
	local storedKeys = 0
	for _ in pairs(self._records) do
		storedKeys += 1
	end

	return {
		ProviderName = "InMemory",
		WritesToCloud = false,
		GetAsyncCalls = self._getAsyncCalls,
		UpdateAsyncCalls = self._updateAsyncCalls,
		CommittedWrites = self._committedWrites,
		StoredKeys = storedKeys,
	}
end

-- Hooks deliberadamente acotados para pruebas unitarias aisladas.
function InMemoryDataStore:_seedForTests(key: string, value: any)
	self._records[key] = deepCopy(value)
end

function InMemoryDataStore:_readForTests(key: string): any
	return deepCopy(self._records[key])
end

return InMemoryDataStore
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="980">
          <Properties>
            <string name="Name">PersistenceEnvironment</string>
            <string name="Source"><![CDATA[--!strict
-- PersistenceEnvironment
-- Selecciona una vez el proveedor de persistencia antes de inicializar servicios.

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local InMemoryDataStore = require(script.Parent.InMemoryDataStore)
local RobloxDataStoreAdapter = require(script.Parent.RobloxDataStoreAdapter)

local PersistenceEnvironment = {}

-- Bloqueado intencionalmente hasta que el propietario apruebe un Universe ID.
-- No inferir este valor a partir de PlaceId.
local APPROVED_PRODUCTION_UNIVERSE_ID: number? = 10769217377

export type Selection = {
	Environment: string,
	ProviderName: string,
	WritesToCloud: boolean,
	GameId: number,
	PlaceId: number,
	StoreName: string?,
	BlockedReason: string?,
	Provider: any?,
}

export type ResolveOptions = {
	IsStudio: boolean,
	GameId: number,
	PlaceId: number,
	ApprovedProductionUniverseId: number?,
	ProductionStoreName: string,
	CreateInMemory: () -> any,
	CreateProduction: (string) -> any,
}

function PersistenceEnvironment.ResolveWithOptions(options: ResolveOptions): Selection
	if options.IsStudio then
		return {
			Environment = "Studio",
			ProviderName = "InMemory",
			WritesToCloud = false,
			GameId = options.GameId,
			PlaceId = options.PlaceId,
			StoreName = nil,
			BlockedReason = nil,
			Provider = options.CreateInMemory(),
		}
	end

	local approvedId = options.ApprovedProductionUniverseId
	if type(approvedId) ~= "number" or approvedId <= 0 then
		return {
			Environment = "Blocked",
			ProviderName = "Unavailable",
			WritesToCloud = false,
			GameId = options.GameId,
			PlaceId = options.PlaceId,
			StoreName = nil,
			BlockedReason = "ProductionUniverseIdNotApproved",
			Provider = nil,
		}
	end

	if options.GameId ~= approvedId then
		return {
			Environment = "Blocked",
			ProviderName = "Unavailable",
			WritesToCloud = false,
			GameId = options.GameId,
			PlaceId = options.PlaceId,
			StoreName = nil,
			BlockedReason = "UnknownUniverse",
			Provider = nil,
		}
	end

	local ok, providerOrError = pcall(options.CreateProduction, options.ProductionStoreName)
	if not ok or providerOrError == nil then
		return {
			Environment = "Blocked",
			ProviderName = "Unavailable",
			WritesToCloud = false,
			GameId = options.GameId,
			PlaceId = options.PlaceId,
			StoreName = nil,
			BlockedReason = "ProductionProviderInitializationFailed",
			Provider = nil,
		}
	end

	return {
		Environment = "Production",
		ProviderName = "RobloxDataStore",
		WritesToCloud = true,
		GameId = options.GameId,
		PlaceId = options.PlaceId,
		StoreName = options.ProductionStoreName,
		BlockedReason = nil,
		Provider = providerOrError,
	}
end

function PersistenceEnvironment.Resolve(): Selection
	local storeName = (Config.DataStore and Config.DataStore.Name) or "SlapDuels_PlayerData_v1"
	return PersistenceEnvironment.ResolveWithOptions({
		IsStudio = RunService:IsStudio(),
		GameId = game.GameId,
		PlaceId = game.PlaceId,
		ApprovedProductionUniverseId = APPROVED_PRODUCTION_UNIVERSE_ID,
		ProductionStoreName = storeName,
		CreateInMemory = function()
			return InMemoryDataStore.new()
		end,
		CreateProduction = function(name: string)
			return RobloxDataStoreAdapter.new(name)
		end,
	})
end

return PersistenceEnvironment
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="981">
          <Properties>
            <string name="Name">ProfileSessions</string>
            <string name="Source"><![CDATA[--!nonstrict
-- One fenced writer per profile. Injected provider only; no DataStoreService lookup.
local Http=game:GetService('HttpService')
local Profiles={};Profiles.__index=Profiles
function Profiles.Copy(value,seen,depth)
 if type(value)~='table'then
  assert(type(value)=='nil'or type(value)=='string'or type(value)=='boolean'or(type(value)=='number'and value==value and math.abs(value)<math.huge),'Non-serializable profile value')
  return value
 end
 seen=seen or {};depth=depth or 0;assert(depth<40 and not seen[value],'Invalid profile graph');seen[value]=true
 local result={};for k,v in pairs(value)do assert(type(k)=='string'or(type(k)=='number'and k%1==0),'Invalid profile key');result[k]=Profiles.Copy(v,seen,depth+1)end
 seen[value]=nil;return result
end
function Profiles.Acquire(old,id,now,ttl,normalize)
 if old~=nil and type(old)~='table'then return nil,'CorruptedProfile'end
 if old and old._PremiumProfile~=nil then return nil,'FencedProfileLifecycleRequired'end
 local lease=old and old._Session
 if lease~=nil and(type(lease)~='table'or type(lease.Id)~='string'or type(lease.Until)~='number'or lease.Until~=lease.Until)then return nil,'InvalidSessionLease'end
 if lease and lease.Id~=id and lease.Until>now then return nil,'ProfileInUse'end
 local valid,data,reason=normalize(old);if not valid then return nil,reason or 'InvalidProfile'end
 local row=Profiles.Copy(old or {})
 for k,v in pairs(data)do row[k]=Profiles.Copy(v)end
 row._Session={Id=id,Until=now+ttl};return row
end
function Profiles.Write(old,request,id,now,ttl)
 if type(old)~='table'then return nil,'ProfileMissing'end
 if old._PremiumProfile~=nil then return nil,'FencedProfileLifecycleRequired'end
 if old._LastProfileWrite and old._LastProfileWrite.Id==request.Id then return Profiles.Copy(old),'Replay'end
 local lease=old._Session
 if not lease or lease.Id~=id or lease.Until<=now then return nil,'SessionLost'end
 if type(old.Version)=='number'and old.Version>(request.Data.Version or 0)then return nil,'IncompatibleVersion'end
 local row=Profiles.Copy(old)
 for k,v in pairs(request.Data)do row[k]=Profiles.Copy(v)end
 row._LastProfileWrite={Id=request.Id,Session=id}
 row._Session=not request.Release and {Id=id,Until=now+ttl}or nil
 row.LastSaved=now;return row
end
function Profiles.new(store,normalize,latest,options)
 options=options or {}
 return setmetatable({Store=store,Normalize=normalize,Latest=latest,Handles={},TTL=options.TTL or 180,Clock=options.Clock or os.time,Wait=options.Wait or task.wait,Retries=options.Retries or 3,NewId=options.NewId or function()return Http:GenerateGUID(false)end},Profiles)
end
function Profiles:Load(player)
 if self.Handles[player]then return false,nil,'AlreadyLoaded'end
 local id=self.NewId();local key='Player_'..tostring(player.UserId);local last
 for attempt=1,self.Retries do
  local reason;local now=self.Clock()
  local ok,row=pcall(self.Store.UpdateAsync,self.Store,key,function(old)local nextData,why=Profiles.Acquire(old,id,now,self.TTL,self.Normalize);reason=why;return nextData end)
  if ok and row and row._Session and row._Session.Id==id then
   local valid,data,why=self.Normalize(row);if not valid then return false,nil,why end
   self.Handles[player]={Id=id,Key=key,Until=row._Session.Until,Data=data};return true,data
  end
  last=ok and reason or tostring(row)
  if reason and reason~='ProfileInUse'then break end
  if attempt<self.Retries then self.Wait(attempt*2)end
 end
 return false,nil,last or 'LoadUnconfirmed'
end
function Profiles:Owns(player)
 local h=self.Handles[player];return h~=nil and not h.Released and not h.Lost and h.Until>self.Clock()
end
function Profiles:_write(player,h)
 local request=h.Pending;local last
 for attempt=1,self.Retries do
  local reason;local now=self.Clock()
  local ok,row=pcall(self.Store.UpdateAsync,self.Store,h.Key,function(old)local nextData,why=Profiles.Write(old,request,h.Id,now,self.TTL);reason=why;return nextData end)
  if ok and row and row._LastProfileWrite and row._LastProfileWrite.Id==request.Id then
   if not request.Release and(not row._Session or row._Session.Id~=h.Id)then h.Lost=true;h.Pending=nil;return false,'SessionLost'end
   h.Pending=nil;h.Released=request.Release;h.Until=row._Session and row._Session.Until or 0;return true
  end
  last=ok and reason or tostring(row)
  if reason=='SessionLost'or reason=='IncompatibleVersion'or reason=='FencedProfileLifecycleRequired'then h.Lost=true;return false,reason end
  if attempt<self.Retries then self.Wait(attempt)end
 end
 return false,last or 'WriteUnconfirmed'
end
function Profiles:Save(player,fallback,release)
 local h=self.Handles[player];if not h then return false,'ProfileNotOwned'end
 local waited=0;while h.Busy and waited<20 do self.Wait(.05);waited+=.05 end
 if h.Busy then return false,'SaveBusy'end
 if h.Released then return release==true,release and nil or 'ProfileReleased'end
 h.Busy=true
 local ok,saved,reason=pcall(function()
  if h.Pending then local done,why=self:_write(player,h);if not done then return false,why end;if h.Released then return release==true,'ProfileReleased'end end
  if not self:Owns(player)then h.Lost=true;return false,'SessionLost'end
  -- Capture AFTER acquiring the write queue, never before a previous yielding save.
  local data=self.Latest(player)or fallback or h.Data
  local valid,payload,why=self.Normalize(data);if not valid then return false,why end
  h.Data=Profiles.Copy(payload)
  assert(#Http:JSONEncode(h.Data)<3500000,'ProfileTooLarge')
  h.Pending={Id=self.NewId(),Data=h.Data,Release=release==true}
  return self:_write(player,h)
 end)
 h.Busy=false
 if not ok then return false,tostring(saved)end
 return saved,reason
end
function Profiles:Cleanup(player)
 local h=self.Handles[player];if not h then return end
 if h.Released then self.Handles[player]=nil;return end
 -- Keep uncertain final writes and their exact operation IDs alive after disconnect.
 task.spawn(function()
  for _=1,3 do local done=self:Save(player,h.Data,true);if done or h.Lost then break end;self.Wait(2)end
  if h.Released or h.Lost then self.Handles[player]=nil end
 end)
end
return Profiles
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="982">
          <Properties>
            <string name="Name">RobloxDataStoreAdapter</string>
            <string name="Source"><![CDATA[--!strict
-- RobloxDataStoreAdapter
-- Encapsula el único punto autorizado para obtener el DataStore de producción.
-- Este constructor no debe invocarse desde Studio ni desde entornos desconocidos.

local RobloxDataStoreAdapter = {}
RobloxDataStoreAdapter.__index = RobloxDataStoreAdapter

export type Store = typeof(setmetatable({} :: {
	_store: any,
	_storeName: string,
	_getAsyncCalls: number,
	_updateAsyncCalls: number,
}, RobloxDataStoreAdapter))

function RobloxDataStoreAdapter.new(storeName: string, dataStoreServiceOverride: any?): Store
	assert(type(storeName) == "string" and storeName ~= "", "Production DataStore name is required")

	-- Requerir el servicio aquí, y no al cargar el módulo, garantiza que la ruta
	-- Studio no realiza ninguna operación sobre DataStoreService. La dependencia
	-- opcional permite verificar el contrato con un mock sin acceso a la nube.
	local dataStoreService = dataStoreServiceOverride or game:GetService("DataStoreService")
	local store = dataStoreService:GetDataStore(storeName)

	return setmetatable({
		_store = store,
		_storeName = storeName,
		_getAsyncCalls = 0,
		_updateAsyncCalls = 0,
	}, RobloxDataStoreAdapter) :: any
end

function RobloxDataStoreAdapter:GetAsync(key: string, fresh: boolean?): any
	self._getAsyncCalls += 1
	if fresh then local options=Instance.new("DataStoreGetOptions");options.UseCache=false;return self._store:GetAsync(key,options)end
	return self._store:GetAsync(key)
end

function RobloxDataStoreAdapter:UpdateAsync(key: string, transform: (any) -> any): any
	self._updateAsyncCalls += 1
	return self._store:UpdateAsync(key, transform)
end

function RobloxDataStoreAdapter:GetDiagnostics(): { [string]: any }
	return {
		ProviderName = "RobloxDataStore",
		WritesToCloud = true,
		StoreName = self._storeName,
		GetAsyncCalls = self._getAsyncCalls,
		UpdateAsyncCalls = self._updateAsyncCalls,
	}
end

return RobloxDataStoreAdapter
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="983">
        <Properties>
          <string name="Name">Platforms</string>
        </Properties>
        <Item class="ModuleScript" referent="984">
          <Properties>
            <string name="Name">PlatformPolicy</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Pure configuration and support geometry policy; no remotes or per-part scripts.
local Policy = {}
local function number(value, minimum, maximum, exclusiveMinimum)
 return type(value)=="number" and value==value and value<math.huge
  and value>=minimum and value<=maximum and (not exclusiveMinimum or value>minimum)
end
function Policy.Validate(raw)
 if type(raw)~="table" then return nil,"Expected configuration table" end
 if type(raw.Enabled)~="boolean" then return nil,"Enabled must be boolean" end
 for _,key in {"TargetPartName","GeometryFolderName"} do
  if type(raw[key])~="string" or raw[key]=="" then return nil,key.." must be a nonempty name" end
 end
 local ranges={FadeDelay={0,60},FadeDuration={0,60,true},DetectionInterval={0.02,5},
  SupportTolerance={0.01,0.5},SurfaceTolerance={0.001,0.2},TopNormalDot={0.9,1},MaxSupportNormalSpeed={0,10}}
 for key,range in pairs(ranges) do
  if not number(raw[key],range[1],range[2],range[3]) then return nil,"Invalid "..key end
 end
 if raw.ResetDuringMatch~=false then return nil,"V1 requires ResetDuringMatch=false" end
 if raw.DisableCollisionOnFadeComplete~=true then return nil,"V1 requires DisableCollisionOnFadeComplete=true" end
 return table.freeze(table.clone(raw))
end
function Policy.ExpectedHeight(character,humanoid,root)
 local height=root.Size.Y*0.5+humanoid.HipHeight
 if humanoid.RigType==Enum.HumanoidRigType.R6 then
  local leg=character:FindFirstChild("Left Leg") or character:FindFirstChild("Right Leg")
  if not leg or not leg:IsA("BasePart") then return nil end
  height+=leg.Size.Y
 end
 return if height>0 then height else nil
end
function Policy.CanStand(character,humanoid,root,config)
 if humanoid.Health<=0 or humanoid.PlatformStand or humanoid.Sit
  or character:GetAttribute("ArenaRespawnPending") or character:GetAttribute("Ragdolled") then return false end
 local state=humanoid:GetState()
 if state~=Enum.HumanoidStateType.Running and state~=Enum.HumanoidStateType.RunningNoPhysics
  and state~=Enum.HumanoidStateType.Landed then return false end
 return true
end
function Policy.IsTopSupport(part,root,hit,expectedHeight,config)
 if not part.CanCollide or hit.Instance~=part then return false end
 local up=part.CFrame.UpVector
 if up.Y<=0 or hit.Normal:Dot(up)<config.TopNormalDot then return false end
 local point=part.CFrame:PointToObjectSpace(hit.Position)
 local half=part.Size*0.5
 if math.abs(point.X)>half.X+config.SurfaceTolerance or math.abs(point.Z)>half.Z+config.SurfaceTolerance
  or math.abs(point.Y-half.Y)>config.SurfaceTolerance then return false end
 local rootLocal=part.CFrame:PointToObjectSpace(root.Position)
 if rootLocal.Y<=half.Y then return false end
 -- Normal avatar clearance, not a long ray that can reach through an airborne jump.
 if math.abs(root.Position.Y-hit.Position.Y-expectedHeight)>config.SupportTolerance then return false end
 -- Tangential walking on a slope is support, even when world Y velocity is nonzero.
 local normalSpeed=(root.AssemblyLinearVelocity-part.AssemblyLinearVelocity):Dot(up)
 return math.abs(normalSpeed)<=config.MaxSupportNormalSpeed
end
return table.freeze(Policy)
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="985">
        <Properties>
          <string name="Name">PlayerDataService</string>
          <string name="Source"><![CDATA[--!strict
-- PlayerDataService
-- Capa de persistencia autoritativa mediante el proveedor seleccionado al arrancar.
-- Gestiona el ciclo de vida de persistencia (Load, Save, BindToClose, Retries, Validación).
-- No contiene lógica económica de gameplay (responsabilidad de PlayerService).

local WinStreak = require(script.Parent.Gameplay.WinStreak)
local Progression = require(game.ReplicatedStorage.Shared.Progression.Model)
local ProfileSessions = require(script.Parent.Persistence.ProfileSessions)
local RichInventory = require(game.ReplicatedStorage.Shared.SlapCrates.Inventory)
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Types = require(ReplicatedStorage.Shared.Types)
local DeathSettings = require(ReplicatedStorage.Shared.DeathFeedbackConfig).DeathEffects

type PlayerData = Types.PlayerData
type PlayerDataRecord = Types.PlayerDataRecord
type DataLoadState = Types.DataLoadState

local PlayerDataService = {}
PlayerDataService.Name = "PlayerDataService"

PlayerDataService._context = nil :: any
PlayerDataService._store = nil :: any
PlayerDataService._persistenceInfo = nil :: any
PlayerDataService._loadStates = {} :: { [Player]: DataLoadState }
PlayerDataService._saving = {} :: { [Player]: boolean }
PlayerDataService._bindToCloseConnected = false
PlayerDataService._playerService = nil :: any

-- Función auxiliar para verificar números finitos válidos y no-NaN
local function isValidNumber(val: any): boolean
	return typeof(val) == "number" and val == val and math.abs(val) ~= math.huge
end

-- Función auxiliar para generar Inventory por defecto
local function getDefaultInventory(): Types.PlayerInventory
	return {
		Owned = {
			["PointEffects"] = { ["Basic"] = true },
			["DeathEffects"] = { [DeathSettings.DefaultKillEffectId] = true },
			["Abilities"] = { Dash = true },
		},
		Equipped = {
			["PointEffects"] = "Basic",
			["DeathEffects"] = DeathSettings.DefaultKillEffectId,
			["Abilities"] = "Dash",
		},
	}
end

-- Sanitiza y valida profundamente una estructura de Inventory
local function sanitizeInventory(rawInv: any, warnings: { string }): Types.PlayerInventory
	if type(rawInv) ~= "table" then
		table.insert(warnings, "Inventory is not a table, generated default Inventory")
		return getDefaultInventory()
	end

	local sanitizedOwned: { [string]: { [string]: boolean } } = {}
	local rawOwned = rawInv.Owned
	if type(rawOwned) == "table" then
		for category, items in pairs(rawOwned) do
			if type(category) == "string" and type(items) == "table" then
				local catItems: { [string]: boolean } = {}
				for itemId, isOwned in pairs(items) do
					if type(itemId) == "string" and isOwned == true then
						catItems[itemId] = true
					end
				end
				sanitizedOwned[category] = catItems
			end
		end
	else
		table.insert(warnings, "Inventory.Owned is not a table, initialized empty Owned")
	end

	-- Regla arquitectónica: PointEffects.Basic siempre debe existir
	if not sanitizedOwned["PointEffects"] then
		sanitizedOwned["PointEffects"] = {}
	end
	sanitizedOwned["PointEffects"]["Basic"] = true
	-- Additive initial entitlement within the existing schema; preserve all owned future effects.
	sanitizedOwned["DeathEffects"] = sanitizedOwned["DeathEffects"] or {}
	sanitizedOwned["DeathEffects"][DeathSettings.DefaultKillEffectId] = true
	sanitizedOwned["Abilities"] = sanitizedOwned["Abilities"] or {}
	sanitizedOwned["Abilities"].Dash = true

	local sanitizedEquipped: { [string]: string? } = {}
	local rawEquipped = rawInv.Equipped
	if type(rawEquipped) == "table" then
		for category, equippedId in pairs(rawEquipped) do
			if type(category) == "string" and type(equippedId) == "string" then
				-- Verificar que el ítem realmente se posea en su categoría
				if sanitizedOwned[category] and sanitizedOwned[category][equippedId] == true then
					sanitizedEquipped[category] = equippedId
				else
					table.insert(warnings, string.format("Equipped item '%s' in category '%s' not owned, unequipped", equippedId, category))
				end
			end
		end
	else
		table.insert(warnings, "Inventory.Equipped is not a table, initialized empty Equipped")
	end

	-- Regla arquitectónica: PointEffects.Equipped fallback seguro obligatorio a Basic
	if not sanitizedEquipped["PointEffects"] or not sanitizedOwned["PointEffects"][sanitizedEquipped["PointEffects"]] then
		sanitizedEquipped["PointEffects"] = "Basic"
	end
	if not sanitizedEquipped["DeathEffects"] or sanitizedEquipped["DeathEffects"] == DeathSettings.DefaultFallEffectId then
		sanitizedEquipped["DeathEffects"] = DeathSettings.DefaultKillEffectId
	end
	if not sanitizedEquipped["Abilities"] then sanitizedEquipped["Abilities"] = "Dash" end

		local result = { Owned = sanitizedOwned, Equipped = sanitizedEquipped }
		-- Rich crate inventory is additive; keep units/journal through load/save.
			for _, key in ipairs({"Crates", "SlapUnits", "CrateOperations", "PremiumReceipts", "PremiumPurchases"}) do
			if rawInv[key] ~= nil then result[key] = rawInv[key] end
		end
			return RichInventory.Preserve(rawInv,result)
end

-- ==================================================
-- VALIDACIÓN CENTRAL DE DATOS
-- ==================================================

function PlayerDataService:ValidatePlayerData(raw: any): (boolean, PlayerDataRecord, string?)
	local defaultInv = getDefaultInventory()
	if type(raw) ~= "table" then
		return false, {
			Version = Config.DataStore.CurrentVersion or 2,
			Coins = Config.Economy.StartingCoins or 0,
			Wins = Config.Economy.StartingWins or 0,
			Losses = Config.Economy.StartingLosses or 0,
			Kills = Config.Economy.StartingKills or 0,
			WinStreak = WinStreak.Normalize(nil),
			Progression = Progression.Normalize(nil),
			Inventory = defaultInv,
		}, "Raw data is not a table"
	end

	local warnings: { string } = {}

	local version = raw.Version
	local currentVersion = (Config.DataStore and Config.DataStore.CurrentVersion) or 2
	if not isValidNumber(version) or version < 1 then
		table.insert(warnings, string.format("Invalid or missing Version (%s), migrating to %d", tostring(version), currentVersion))
		version = currentVersion
	elseif version < currentVersion then
		table.insert(warnings, string.format("Migrating PlayerData from version %d to %d", version, currentVersion))
		version = currentVersion
	elseif version > currentVersion then
		local errMsg = string.format("IncompatibleVersion: Data version (%d) is newer than current config (%d)", version, currentVersion)
		warn(string.format("[PlayerData] %s. Normalización y guardado bloqueados para prevenir corrupción de esquema futuro.", errMsg))
		return false, raw, errMsg
	end

	-- Coins
	local coins = raw.Coins
	if not isValidNumber(coins) or coins < 0 then
		table.insert(warnings, string.format("Invalid Coins (%s), fallback to 0", tostring(coins)))
		coins = 0
	else
		coins = math.floor(coins)
	end

	-- Wins
	local wins = raw.Wins
	if not isValidNumber(wins) or wins < 0 then
		table.insert(warnings, string.format("Invalid Wins (%s), fallback to 0", tostring(wins)))
		wins = 0
	else
		wins = math.floor(wins)
	end

	-- Losses
	local losses = raw.Losses
	if not isValidNumber(losses) or losses < 0 then
		table.insert(warnings, string.format("Invalid Losses (%s), fallback to 0", tostring(losses)))
		losses = 0
	else
		losses = math.floor(losses)
	end

	-- Kills (retrocompatible: perfiles anteriores sin Kills reciben fallback a 0)
	local kills = raw.Kills
	if not isValidNumber(kills) or kills < 0 then
		table.insert(warnings, string.format("Invalid or missing Kills (%s), fallback to 0", tostring(kills)))
		kills = 0
	else
		kills = math.floor(kills)
	end

	-- Inventory (Migración y sanitización profunda)
	local inventory = sanitizeInventory(raw.Inventory, warnings)

	local validatedRecord: PlayerDataRecord = {
		Version = Config.DataStore.CurrentVersion or 2,
		Coins = coins,
		Wins = wins,
		Losses = losses,
		Kills = kills,
		WinStreak = WinStreak.Normalize(raw.WinStreak),
		Progression = Progression.Normalize(raw.Progression),
			Preferences = {
				MusicEnabled = type(raw.Preferences)~="table" or raw.Preferences.MusicEnabled~=false,
				MusicVolume = if type(raw.Preferences)=="table" and isValidNumber(raw.Preferences.MusicVolume) then math.clamp(raw.Preferences.MusicVolume,0,1) else 1,
			},
		Inventory = inventory,
		LastSaved = raw.LastSaved,
	}

	local warningMsg = if #warnings > 0 then table.concat(warnings, "; ") else nil
	return true, validatedRecord, warningMsg
end

-- ==================================================
-- INICIALIZACIÓN Y BINDTOCLOSE
-- ==================================================

function PlayerDataService:Init(context: any)
	self._context = context
	self._loadStates = {}
	self._saving = {}
	self._store = context and context.PersistenceProvider or nil
	self._persistenceInfo = context and context.PersistenceInfo or nil
		self._sessions = nil
		if self._store and self._persistenceInfo and self._persistenceInfo.Environment=="Production" and self._persistenceInfo.WritesToCloud==true then
			self._sessions=ProfileSessions.new(self._store,function(raw)
				if raw==nil then raw={Version=Config.DataStore.CurrentVersion,Coins=Config.Economy.StartingCoins or 0,Wins=0,Losses=0,Kills=0,Inventory=getDefaultInventory()}end
				return self:ValidatePlayerData(ProfileSessions.Copy(raw))
			end,function(player)
				local ps=self:_getPlayerService();return ps and ps._data and ps._data[player]
			end)
		end

	if not self._store then
		local reason = self._persistenceInfo and self._persistenceInfo.BlockedReason or "ProviderMissing"
		warn(string.format("[PlayerData] Persistencia no disponible; acceso cloud bloqueado (%s)", tostring(reason)))
	end

	-- BindToClose seguro con espera activa de guardados
	if not self._bindToCloseConnected then
		self._bindToCloseConnected = true
		game:BindToClose(function()
			local ps = self:_getPlayerService()
				if ps then ps:BeginShopShutdown() end
				print("[PlayerData] BindToClose: Guardando datos de todos los jugadores...")
			self:SaveAllPlayers()
			print("[PlayerData] BindToClose: Finalizado.")
		end)
	end
end

function PlayerDataService:Start(context: any)
	print("[PlayerDataService] Servicio de persistencia iniciado y listo")
		if self._sessions then
			task.spawn(function()
				while true do
					task.wait(45+math.random()*10)
					local ps=self:_getPlayerService()
					if ps and not ps._shopShutdown then for _,player in ipairs(Players:GetPlayers())do
						if self._loadStates[player]=="Loaded"then task.spawn(function()
							local ok,why=self:SavePlayer(player)
							if not ok then warn("[PlayerData] Autosave failed: "..tostring(why));if not self._sessions:Owns(player)then player:Kick("Tu perfil perdió la conexión segura. Volvé a ingresar en unos segundos.")end end
						end)end
					end end
				end
			end)
		end
end

function PlayerDataService:GetStore(): any
	-- La selección es fija durante toda la vida del servidor. Nunca realizar
	-- fallback automático a DataStoreService si el proveedor está ausente o falla.
	return self._store
end

function PlayerDataService:GetPersistenceDiagnostics(): { [string]: any }
	local result = {
		Environment = self._persistenceInfo and self._persistenceInfo.Environment or "Unknown",
		ProviderName = self._persistenceInfo and self._persistenceInfo.ProviderName or "Unavailable",
		WritesToCloud = self._persistenceInfo and self._persistenceInfo.WritesToCloud == true or false,
		GameId = self._persistenceInfo and self._persistenceInfo.GameId or game.GameId,
		PlaceId = self._persistenceInfo and self._persistenceInfo.PlaceId or game.PlaceId,
		BlockedReason = self._persistenceInfo and self._persistenceInfo.BlockedReason or nil,
	}

	if self._store and type(self._store.GetDiagnostics) == "function" then
		for key, value in pairs(self._store:GetDiagnostics()) do
			result[key] = value
		end
	end
	return result
end

function PlayerDataService:GetLoadState(player: Player): DataLoadState?
	return self._loadStates[player]
end

function PlayerDataService:SetLoadState(player: Player, state: DataLoadState)
	self._loadStates[player] = state
end

-- ==================================================
-- CARGA DE DATOS (LOAD)
-- ==================================================

function PlayerDataService:LoadPlayer(player: Player): (boolean, PlayerDataRecord?, string?)
	if not player or not player:IsA("Player") then
		return false, nil, "InvalidPlayerInstance"
	end

	self._loadStates[player] = "Loading"
		if self._sessions then
			local ok,data,why=self._sessions:Load(player);self._loadStates[player]=ok and "Loaded" or "Failed"
			if ok then print("[ProfilePersistence] Loaded UserId="..player.UserId.." fenced=true")else warn("[ProfilePersistence] Load rejected: "..tostring(why))end
			return ok,data,why
		end

	local store = self:GetStore()
	if not store then
		self._loadStates[player] = "Failed"
		warn(string.format("[PlayerData] Load failed: DataStore no disponible para '%s'", player.Name))
		return false, nil, "DataStoreNotAvailable"
	end

	local key = string.format("Player_%d", player.UserId)
	local maxRetries = (Config.DataStore and Config.DataStore.MaxRetries) or 3
	local retryDelay = (Config.DataStore and Config.DataStore.InitialRetryDelay) or 1.0
	local backoff = (Config.DataStore and Config.DataStore.RetryBackoffMultiplier) or 2.0

	local lastErr: any = nil
	for attempt = 1, maxRetries do
		local ok, result = pcall(function()
			return store:GetAsync(key)
		end)

		if ok then
				if type(result)=="table" and result._PremiumProfile~=nil then
					self._loadStates[player]="Failed"
					return false,nil,"FencedProfileLifecycleRequired"
				end
			if result == nil then
				-- Jugador nuevo sin datos previos
				local newRecord: PlayerDataRecord = {
					Version = (Config.DataStore and Config.DataStore.CurrentVersion) or 2,
					Coins = (Config.Economy and Config.Economy.StartingCoins) or 0,
					Wins = (Config.Economy and Config.Economy.StartingWins) or 0,
					Losses = (Config.Economy and Config.Economy.StartingLosses) or 0,
					Kills = (Config.Economy and Config.Economy.StartingKills) or 0,
					Inventory = getDefaultInventory(),
						Progression = Progression.Normalize(nil),
				}
				self._loadStates[player] = "Loaded"
				print(string.format("[PlayerData] Load success (Nuevo jugador): '%s' (UserId: %d)", player.Name, player.UserId))
				return true, newRecord, nil
			else
				local valid, validatedRecord, warnMsg = self:ValidatePlayerData(result)
				if not valid then
					if type(result) == "table" and isValidNumber(result.Version) and result.Version > ((Config.DataStore and Config.DataStore.CurrentVersion) or 2) then
						self._loadStates[player] = "IncompatibleVersion"
						warn(string.format("[PlayerData] Load rejected para '%s': Versión de datos incompatible (%d > %d). Guardado bloqueado.",
							player.Name, result.Version, (Config.DataStore and Config.DataStore.CurrentVersion) or 2))
						return false, nil, warnMsg or "IncompatibleVersion"
					else
						self._loadStates[player] = "Corrupted"
						warn(string.format("[PlayerData] Load rejected para '%s': Datos corruptos (%s)", player.Name, tostring(warnMsg)))
						return false, nil, warnMsg or "ValidationFailed"
					end
				end

				if warnMsg then
					warn(string.format("[PlayerData] Advertencia en datos de '%s': %s", player.Name, warnMsg))
				end
				self._loadStates[player] = "Loaded"
				print(string.format("[PlayerData] Load success: '%s' (Coins=%d, Wins=%d, Losses=%d)",
					player.Name, validatedRecord.Coins, validatedRecord.Wins, validatedRecord.Losses))
				return true, validatedRecord, nil
			end
		else
			lastErr = result
			print(string.format("[PlayerData] Load retry %d/%d para '%s': %s", attempt, maxRetries, player.Name, tostring(result)))
			if attempt < maxRetries then
				task.wait(retryDelay)
				retryDelay *= backoff
			end
		end
	end

	self._loadStates[player] = "Failed"
	warn(string.format("[PlayerData] Load failed definitivo para '%s' tras %d intentos: %s", player.Name, maxRetries, tostring(lastErr)))
	return false, nil, tostring(lastErr)
end

-- ==================================================
-- GUARDADO DE DATOS (SAVE)
-- ==================================================

local function snapshotInventory(inventory: any): any
 return ProfileSessions.Copy(inventory)
end

function PlayerDataService:SavePlayer(player: Player, runtimeData: PlayerData?, release: boolean?): (boolean, string?)
	if not player or not player:IsA("Player") then
		return false, "InvalidPlayerInstance"
	end
		if self._sessions then
			if self._loadStates[player]~="Loaded"then return false,"DataNotLoaded"end
			local saved,why=self._sessions:Save(player,runtimeData,release)
			if saved then print("[ProfilePersistence] Saved UserId="..player.UserId.." release="..tostring(release==true))else warn("[ProfilePersistence] Save pending: "..tostring(why))end
			return saved,why
		end

	-- SEGURIDAD CRÍTICA: Si el jugador no cargó correctamente, NUNCA guardar para no corromper ni sobrescribir
	local loadState = self._loadStates[player]
	if loadState == "IncompatibleVersion" then
		warn(string.format("[PlayerData] RECHAZO DE GUARDADO para '%s': Versión de datos en DataStore es incompatible (%s). Guardado bloqueado para proteger datos futuros.",
			player.Name, tostring(loadState)))
		return false, "IncompatibleVersion"
	end

	if loadState ~= "Loaded" then
		warn(string.format("[PlayerData] RECHAZO DE GUARDADO para '%s': Estado no es 'Loaded' (Estado actual: %s). Protección contra pérdida de datos activada.",
			player.Name, tostring(loadState)))
		return false, "DataNotLoaded"
	end

	if not runtimeData then
		warn(string.format("[PlayerData] RECHAZO DE GUARDADO para '%s': runtimeData es nil", player.Name))
		return false, "NilRuntimeData"
	end

	-- Capture the entire purchase state before any yielding wait/retry.
	runtimeData = table.clone(runtimeData)
	runtimeData.Inventory = snapshotInventory(runtimeData.Inventory or getDefaultInventory())

	-- Protección contra guardado simultáneo del mismo jugador
	if self._saving[player] then
		-- Esperar de forma controlada si ya hay un guardado en curso
		local waitAttempts = 0
		while self._saving[player] and waitAttempts < 40 do
			task.wait(0.05)
			waitAttempts += 1
		end
		if self._saving[player] then
			warn(string.format("[PlayerData] Guardado concurrente en curso para '%s', abortando solicitud duplicada", player.Name))
			return false, "AlreadySaving"
		end
	end

	self._saving[player] = true

	local store = self:GetStore()
	if not store then
		self._saving[player] = nil
		warn(string.format("[PlayerData] Save failed: DataStore no disponible para '%s'", player.Name))
		return false, "DataStoreNotAvailable"
	end

	local key = string.format("Player_%d", player.UserId)
	local maxRetries = (Config.DataStore and Config.DataStore.MaxRetries) or 3
	local retryDelay = (Config.DataStore and Config.DataStore.InitialRetryDelay) or 1.0
	local backoff = (Config.DataStore and Config.DataStore.RetryBackoffMultiplier) or 2.0

	local payload: PlayerDataRecord = {
		Version = (Config.DataStore and Config.DataStore.CurrentVersion) or 2,
		Coins = math.max(0, math.floor(runtimeData.Coins or 0)),
		Wins = math.max(0, math.floor(runtimeData.Wins or 0)),
		Losses = math.max(0, math.floor(runtimeData.Losses or 0)),
		Kills = math.max(0, math.floor(runtimeData.Kills or 0)),
		WinStreak = WinStreak.Normalize(runtimeData.WinStreak),
		Progression = Progression.Normalize(runtimeData.Progression),
			Preferences = runtimeData.Preferences,
		Inventory = runtimeData.Inventory or getDefaultInventory(),
		LastSaved = os.time(),
	}

	local lastErr: any = nil
	local wasVersionAborted = false
		local wasCommerceAborted = false
	for attempt = 1, maxRetries do
		local ok, err = pcall(function()
			store:UpdateAsync(key, function(oldData: any)
					if type(oldData)=="table" and oldData._PremiumProfile~=nil then wasCommerceAborted=true;return nil end
				-- Mantener posibles campos externos futuros si existen
				if type(oldData) == "table" then
					local currentVersion = (Config.DataStore and Config.DataStore.CurrentVersion) or 2
					if isValidNumber(oldData.Version) and oldData.Version > currentVersion then
						wasVersionAborted = true
						return nil -- Cancela la escritura atómica en DataStore sin alterar los datos remotos
					end

					local updated = table.clone(oldData)
					updated.Version = payload.Version
					updated.Coins = payload.Coins
					updated.Wins = payload.Wins
					updated.Losses = payload.Losses
					updated.Kills = payload.Kills
					updated.WinStreak = payload.WinStreak
						updated.Progression = payload.Progression
						updated.Preferences = payload.Preferences
					updated.Inventory = payload.Inventory
					updated.LastSaved = payload.LastSaved
					return updated
				end
				return payload
			end)
		end)

			if wasCommerceAborted then self._saving[player]=nil;return false,"FencedProfileLifecycleRequired"end
			if wasVersionAborted then
			self._saving[player] = nil
			self._loadStates[player] = "IncompatibleVersion"
			warn(string.format("[PlayerData] Save abortado para '%s': Versión remota en DataStore es superior a la versión soportada (%d).",
				player.Name, (Config.DataStore and Config.DataStore.CurrentVersion) or 2))
			return false, "IncompatibleVersion"
		end

		if ok then
			self._saving[player] = nil
			print(string.format("[PlayerData] Save success: '%s' (Coins=%d, Wins=%d, Losses=%d, Kills=%d)",
				player.Name, payload.Coins, payload.Wins, payload.Losses, payload.Kills))
			return true, nil
		else
			lastErr = err
			print(string.format("[PlayerData] Save retry %d/%d para '%s': %s", attempt, maxRetries, player.Name, tostring(err)))
			if attempt < maxRetries then
				task.wait(retryDelay)
				retryDelay *= backoff
			end
		end
	end

	self._saving[player] = nil
	warn(string.format("[PlayerData] Save failed definitivo para '%s' tras %d intentos: %s", player.Name, maxRetries, tostring(lastErr)))
	return false, tostring(lastErr)
end

function PlayerDataService:_getPlayerService(): any
	if self._playerService then
		return self._playerService
	end
	if self._context and type(self._context.GetService) == "function" then
		local s = self._context:GetService("PlayerService")
		if s then
			self._playerService = s
			return s
		end
	end
	local ok, mod = pcall(require, script.Parent.PlayerService)
	if ok and mod then
		self._playerService = mod
		return mod
	end
	return nil
end

-- ==================================================
-- GUARDADO COLECTIVO (BINDTOCLOSE / SHUTDOWN)
-- ==================================================

function PlayerDataService:SaveAllPlayers(): (number, number)
	local players = Players:GetPlayers()
	if #players == 0 then
		return 0, 0
	end

	local playerService = self:_getPlayerService()
	local remaining = #players
	local savedCount = 0
	local failedCount = 0

	for _, player in ipairs(players) do
		task.spawn(function()
			local runtimeData: PlayerData? = nil
			if playerService and type(playerService.GetPlayerData) == "function" then
				runtimeData = playerService:GetPlayerData(player)
			end

			local success = false
			if runtimeData and self._loadStates[player] == "Loaded" then
					local ok = self:SavePlayer(player, runtimeData, true)
				success = ok
			else
				print(string.format("[PlayerData] SaveAllPlayers: Omitiendo '%s' (no cargado o sin datos runtime)", player.Name))
			end

			if success then
				savedCount += 1
			else
				failedCount += 1
			end
			remaining -= 1
		end)
	end

	-- Esperar hasta que todos los hilos terminen o timeout de seguridad de 25 segundos
	local timeout = 25
	local elapsed = 0
	while remaining > 0 and elapsed < timeout do
		task.wait(0.1)
		elapsed += 0.1
	end

	print(string.format("[PlayerData] SaveAllPlayers completado: %d guardados, %d omitidos/fallidos", savedCount, failedCount))
	return savedCount, failedCount
end

-- Limpieza de estado auxiliar al salir
function PlayerDataService:Cleanup(player: Player)
		if self._sessions then self._sessions:Cleanup(player)end
	self._loadStates[player] = nil
	self._saving[player] = nil
end

return PlayerDataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="986">
        <Properties>
          <string name="Name">PlayerService</string>
          <string name="Source"><![CDATA[--!strict
-- PlayerService
-- Ciclo de vida de jugadores: registro/desregistro, estado económico y datos runtime (Coins, Wins, Losses).
-- Servidor autoritativo. Integrado con PlayerDataService para persistencia segura vía DataStoreService.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local WinStreak = require(script.Parent.Gameplay.WinStreak)
local Progression = require(game.ReplicatedStorage.Shared.Progression.Model)
local Players = game:GetService("Players")

local PointEffectDefinitions = require(ReplicatedStorage.Shared.PointEffectDefinitions)
local Config = require(ReplicatedStorage.Shared.Config)
local Types = require(ReplicatedStorage.Shared.Types)
local ProfilePurchase = require(script.Parent.Parent.Shop.ProfilePurchase)
local Constants = require(ReplicatedStorage.Shared.Constants)
local DeathSettings = require(ReplicatedStorage.Shared.DeathFeedbackConfig).DeathEffects

type PlayerData = Types.PlayerData

local PlayerService = {}
PlayerService.Name = "PlayerService"

PlayerService._context = nil :: any
PlayerService._registered = {}
PlayerService._connections = {} :: { RBXScriptConnection }
PlayerService._data = {} :: { [any]: PlayerData }
PlayerService._coins = {} :: { [any]: number } -- Retrocompatibilidad
PlayerService._kills = {} :: { [any]: number }
PlayerService._coinTransactions = {} :: { [any]: { [string]: boolean } }
PlayerService._ownedPointEffects = {} :: { [any]: { [string]: boolean } }
PlayerService._equippedPointEffects = {} :: { [any]: string }
PlayerService._dataUpdatedRemote = nil :: RemoteEvent?
PlayerService._playerDataService = nil :: any
PlayerService._shopClosing = {} :: { [any]: boolean }
PlayerService._shopShutdown = false

-- Utilidad para garantizar la existencia de RemoteEvents
local function ensureRemote(parent: Instance, name: string): RemoteEvent
	local existing = parent:FindFirstChild(name)
	if existing and existing:IsA("RemoteEvent") then
		return existing
	end
	local remote = Instance.new("RemoteEvent")
	remote.Name = name
	remote.Parent = parent
	return remote
end

local function ensureFolder(parent: Instance, name: string): Folder
	local existing = parent:FindFirstChild(name)
	if existing and existing:IsA("Folder") then
		return existing
	end
	local folder = Instance.new("Folder")
	folder.Name = name
	folder.Parent = parent
	return folder
end

function PlayerService:Init(context)
	self._context = context
	self._registered = {}
	self._shopClosing = {}
	self._shopShutdown = false
	self._connections = {}
	self._data = {}
	self._coins = {}
	self._kills = {}
	self._coinTransactions = {}
	self._ownedPointEffects = {}
	self._equippedPointEffects = {}

	self:_getDataUpdatedRemote()
end

function PlayerService:_getDataUpdatedRemote(): RemoteEvent?
	if self._dataUpdatedRemote and self._dataUpdatedRemote.Parent then
		return self._dataUpdatedRemote
	end
	local remotesFolder = ensureFolder(ReplicatedStorage, "Remotes")
	local playerFolder = ensureFolder(remotesFolder, "Player")
	local remote = ensureRemote(playerFolder, "DataUpdated")
	self._dataUpdatedRemote = remote
	return remote
end

-- Sincroniza las estadísticas del jugador con el folder nativo leaderstats de Roblox
function PlayerService:_syncLeaderstats(player: any, data: PlayerData)
	if typeof(player) ~= "Instance" or not player:IsA("Player") then
		return
	end

	local leaderstats = player:FindFirstChild("leaderstats")
	if not leaderstats then
		local folder = Instance.new("Folder")
		folder.Name = "leaderstats"

		local coinsVal = Instance.new("IntValue")
		coinsVal.Name = "Coins"
		coinsVal.Value = data.Coins
		coinsVal.Parent = folder

		local winsVal = Instance.new("IntValue")
		winsVal.Name = "Wins"
		winsVal.Value = data.Wins
		winsVal.Parent = folder

		local killsVal = Instance.new("IntValue")
		killsVal.Name = "Kills"
		killsVal.Value = data.Kills or 0
		killsVal.Parent = folder

		folder.Parent = player
	else
		local coinsVal = leaderstats:FindFirstChild("Coins") :: IntValue?
		if not coinsVal then
			coinsVal = Instance.new("IntValue")
			coinsVal.Name = "Coins"
			coinsVal.Value = data.Coins
			coinsVal.Parent = leaderstats
		else
			coinsVal.Value = data.Coins
		end

		local winsVal = leaderstats:FindFirstChild("Wins") :: IntValue?
		if not winsVal then
			winsVal = Instance.new("IntValue")
			winsVal.Name = "Wins"
			winsVal.Value = data.Wins
			winsVal.Parent = leaderstats
		else
			winsVal.Value = data.Wins
		end

		local killsVal = leaderstats:FindFirstChild("Kills") :: IntValue?
		if not killsVal then
			killsVal = Instance.new("IntValue")
			killsVal.Name = "Kills"
			killsVal.Value = data.Kills or 0
			killsVal.Parent = leaderstats
		else
			killsVal.Value = data.Kills or 0
		end
	end
end

-- Envía actualización autoritativa de datos al cliente correspondiente y sincroniza leaderstats
function PlayerService:_sendDataUpdate(player: any, rewardReceipt: any?)
	local backSlap = self._context and self._context:GetService("BackSlapService")
	if backSlap then
		local ok, failure = pcall(backSlap.Refresh, backSlap, player)
		if not ok then warn("[PlayerService] Back Slap cosmetic refresh failed: " .. tostring(failure)) end
	end
	if typeof(player) == "Instance" and player:IsA("Player") then
		local data = self:GetPlayerData(player)
		local progress = Progression.Normalize(data.Progression)
		local level = Progression.Level(progress.TotalXP)
		player:SetAttribute("Level", level)
		player:SetAttribute("TotalXP", progress.TotalXP)
		self:_syncLeaderstats(player, data)

		local remote = self:_getDataUpdatedRemote()
		if remote then
			remote:FireClient(player, data, rewardReceipt)
		end
	end
end

function PlayerService:_getPlayerDataService(): any
	if self._playerDataService then
		return self._playerDataService
	end
	if self._context and type(self._context.GetService) == "function" then
		local s = self._context:GetService("PlayerDataService")
		if s then
			self._playerDataService = s
			return s
		end
	end
	local ok, mod = pcall(require, script.Parent.PlayerDataService)
	if ok and mod then
		self._playerDataService = mod
		return mod
	end
	return nil
end

function PlayerService:_register(player: any)
	self._registered[player] = {}

	local initialData: PlayerData = {
		Coins = (Config.Economy and Config.Economy.StartingCoins) or 0,
		Wins = (Config.Economy and Config.Economy.StartingWins) or 0,
		Losses = (Config.Economy and Config.Economy.StartingLosses) or 0,
		Kills = (Config.Economy and Config.Economy.StartingKills) or 0,
		WinStreak = WinStreak.Normalize(nil),
		Progression = Progression.Normalize(nil),
		Inventory = {
			Owned = {
				["PointEffects"] = { [PointEffectDefinitions.DefaultEffectId] = true },
				["DeathEffects"] = { [DeathSettings.DefaultKillEffectId] = true },
				["Abilities"] = { Dash = true },
			},
			Equipped = {
				["PointEffects"] = PointEffectDefinitions.DefaultEffectId,
				["DeathEffects"] = DeathSettings.DefaultKillEffectId,
				["Abilities"] = "Dash",
			},
		},
	}

	if typeof(player) == "Instance" and player:IsA("Player") then
		local pds = self:_getPlayerDataService()
		if pds and type(pds.LoadPlayer) == "function" then
			local ok, record, err = pds:LoadPlayer(player)
			if ok and record then
					if not self._registered[player] or player.Parent~=Players then pds:SavePlayer(player,record,true);pds:Cleanup(player);return end
				initialData.Coins = record.Coins
				initialData.Wins = record.Wins
				initialData.Losses = record.Losses
				initialData.Kills = record.Kills or 0
				initialData.WinStreak = WinStreak.Normalize(record.WinStreak)
					initialData.Progression = Progression.Normalize(record.Progression)
				if record.Inventory then
					initialData.Inventory = record.Inventory
				end
					initialData.Preferences = record.Preferences
			else
				warn(string.format("[PlayerService] No se pudo cargar PlayerData de '%s' (err: %s). Usando valores seguros no persistibles.", player.Name, tostring(err)))
					if pds._persistenceInfo and pds._persistenceInfo.Environment=="Production"then player:Kick("No se pudo cargar tu perfil de forma segura. Reintentá en unos segundos.");return end
			end
		end
	end

		local crates = self._context and self._context:GetService("CrateService")
		if crates then initialData.Inventory = crates:ExtendInventory(initialData.Inventory) end
		self._data[player] = initialData
	self._coins[player] = initialData.Coins
	self._kills[player] = initialData.Kills
	self._ownedPointEffects[player] = initialData.Inventory.Owned["PointEffects"]
	self._equippedPointEffects[player] = initialData.Inventory.Equipped["PointEffects"] or PointEffectDefinitions.DefaultEffectId

	local pName = if type(player) == "table" and player.Name then player.Name elseif typeof(player) == "Instance" then player.Name else tostring(player)
	print(string.format("[PlayerService] Registrado: %s (Coins=%d, Wins=%d, Losses=%d, Kills=%d, PointEffect: %s)",
		pName, initialData.Coins, initialData.Wins, initialData.Losses, initialData.Kills, tostring(self._equippedPointEffects[player])))

	-- Enviar estado inicial cargado al jugador (el HUD muestra inmediatamente datos reales sin parpadeo de 0)
	self:_sendDataUpdate(player)
end

function PlayerService:_unregister(player: any)
	self._shopClosing[player] = true -- Before the first save/yield; never accept another Shop mutation.
	if typeof(player) == "Instance" and player:IsA("Player") then
		local pds = self:_getPlayerDataService()
		if pds and type(pds.SavePlayer) == "function" then
			local currentData = self._data[player]
				local saved, saveError = pds:SavePlayer(player, currentData, true)
			if not saved then warn("[PlayerService] Final save failed; no durability guarantee: " .. tostring(saveError)) end
			if type(pds.Cleanup) == "function" then
				pds:Cleanup(player)
			end
		end
	end

	self._registered[player] = nil
	self._data[player] = nil
	self._shopClosing[player] = nil
	self._coins[player] = nil
	self._kills[player] = nil
	self._coinTransactions[player] = nil
	self._ownedPointEffects[player] = nil
	self._equippedPointEffects[player] = nil

	local pName = if type(player) == "table" and player.Name then player.Name elseif typeof(player) == "Instance" then player.Name else tostring(player)
	print(string.format("[PlayerService] Desregistrado: %s", pName))
end

-- ==================================================
-- INTERFAZ AUTORITATIVA DE ECONOMÍA Y ESTADÍSTICAS
-- ==================================================

function PlayerService:AddCoins(player: any, amount: number, reason: string, transactionId: string?): (number, number)
	if not player or amount ~= amount or amount <= 0 or amount == math.huge then
		return self:GetCoins(player), 0
	end

	local data = self._data[player]
	if transactionId then
		-- Transactional awards never reload/recreate a disconnected or missing profile.
		if transactionId == "" or not data then return self:GetCoins(player), 0 end
		local transactions = self._coinTransactions[player]
		if not transactions then transactions = {}; self._coinTransactions[player] = transactions end
		if transactions[transactionId] then return self:GetCoins(player), 0 end
		-- No yields between reserving the key and committing the in-memory balance.
		transactions[transactionId] = true
	end
	if not data then
		self:_register(player)
		data = self._data[player]
	end

	local newBalance = data.Coins + amount
	data.Coins = newBalance
	self._coins[player] = newBalance

	local pName = if type(player) == "table" and player.Name then player.Name elseif typeof(player) == "Instance" then player.Name else tostring(player)
	print(string.format("[PlayerService] +%d Coins otorgados a '%s' (Razón: %s). Saldo: %d",
		amount, pName, reason or "Unspecified", newBalance))

	if transactionId then
		-- Failure to notify cannot roll back a committed award or allow a second credit.
		local receipt = if reason == "MatchPoint" and string.sub(transactionId, 1, 5) == "Goal:" then {
			Kind = "CreditedGoal", RecipientUserId = player.UserId,
			SessionId = player:GetAttribute("MatchId"), EventId = transactionId, RewardCoins = amount,
		} else nil
		local ok, failure = pcall(self._sendDataUpdate, self, player, receipt)
		if not ok then warn("[PlayerService] Committed Coins; data notification failed: " .. tostring(failure)) end
	else
		self:_sendDataUpdate(player)
	end
	return newBalance, amount
end

-- Called only by the elimination authority after its final credited-kill decision.
-- Separate from AddKill so generic stat corrections never create money.
function PlayerService:AwardConfirmedKill(player: Player, victim: Player, sessionId: string, eliminationId: string): (number, number)
	if not player or not victim or player == victim or player.Parent ~= Players or victim.Parent ~= Players then
		return 0, self:GetCoins(player)
	end
	local rounds = self._context and self._context:GetService("RoundService")
	local session = rounds and rounds:GetSessionById(sessionId)
	if not session or not rounds:IsSessionActive(sessionId) or session.GameplayFrozen
		or session.Closing or session.Cancelled or session.Closed
		or (session.State ~= Constants.RoundState.Playing and session.State ~= Constants.RoundState.PointRestartCountdown) then
		return 0, self:GetCoins(player)
	end
	local attacker = rounds:GetSessionParticipant(sessionId, player)
	local target = rounds:GetSessionParticipant(sessionId, victim)
	local prefix = sessionId .. "_" .. tostring(victim.UserId) .. "_"
	if not attacker or not target or attacker.Team == target.Team
		or player:GetAttribute("MatchId") ~= sessionId or victim:GetAttribute("MatchId") ~= sessionId
		or type(eliminationId) ~= "string" or string.sub(eliminationId, 1, #prefix) ~= prefix then
		return 0, self:GetCoins(player)
	end
	local amount = Config.Economy.KillRewardCoins
	if type(amount) ~= "number" or amount ~= amount or amount < 0 or amount % 1 ~= 0 or amount == math.huge then
		warn("[PlayerService] Invalid Economy.KillRewardCoins")
		return 0, self:GetCoins(player)
	end
	local balance, credited = self:AddCoins(player, amount, "SlapElimination", "Kill:" .. eliminationId)
	return credited, balance
end

function PlayerService:GetCoins(player: any): number
	local data = self._data[player]
	return (data and data.Coins) or self._coins[player] or 0
end

-- Deduce monedas del jugador de forma server-authoritative (retorna éxito y nuevo balance)
function PlayerService:DeductCoins(player: any, amount: number, reason: string?): (boolean, number)
	if not player or amount <= 0 then
		return false, self:GetCoins(player)
	end

	local data = self._data[player]
	if not data then
		self:_register(player)
		data = self._data[player]
	end

	if data.Coins < amount then
		return false, data.Coins
	end

	local newBalance = data.Coins - amount
	data.Coins = newBalance
	self._coins[player] = newBalance

	local pName = if type(player) == "table" and player.Name then player.Name elseif typeof(player) == "Instance" then player.Name else tostring(player)
	print(string.format("[PlayerService] -%d Coins deducidos de '%s' (Razón: %s). Saldo restante: %d",
		amount, pName, reason or "ShopPurchase", newBalance))

	self:_sendDataUpdate(player)
	return true, newBalance
end

function PlayerService:RecordStreakResult(player: any, matchId: string, outcome: string): boolean
 local data=self._data[player]
 if not data then return false end
 local applied=WinStreak.Apply(data,matchId,outcome)
 if applied then
  local ok,why=pcall(self._sendDataUpdate,self,player)
  if not ok then warn('[PlayerService] Streak notification failed: '..tostring(why))end
 end
 return applied
end

function PlayerService:AddWin(player: any, reason: string?): number
	if not player then return 0 end

	local data = self._data[player]
	if not data then
		self:_register(player)
		data = self._data[player]
	end

	data.Wins += 1
	local pName = if type(player) == "table" and player.Name then player.Name elseif typeof(player) == "Instance" then player.Name else tostring(player)
	print(string.format("[PlayerService] +1 Win otorgado a '%s' (Razón: %s). Total Wins: %d",
		pName, reason or "MatchWin", data.Wins))

	self:_sendDataUpdate(player)
	return data.Wins
end

function PlayerService:GetWins(player: any): number
	local data = self._data[player]
	return (data and data.Wins) or 0
end

function PlayerService:AddLoss(player: any, reason: string?): number
	if not player then return 0 end

	local data = self._data[player]
	if not data then
		self:_register(player)
		data = self._data[player]
	end

	data.Losses += 1
	local pName = if type(player) == "table" and player.Name then player.Name elseif typeof(player) == "Instance" then player.Name else tostring(player)
	print(string.format("[PlayerService] +1 Loss registrado a '%s' (Razón: %s). Total Losses: %d",
		pName, reason or "MatchLoss", data.Losses))

	self:_sendDataUpdate(player)
	return data.Losses
end

function PlayerService:GetLosses(player: any): number
	local data = self._data[player]
	return (data and data.Losses) or 0
end

-- Stats-only API. Kill money requires AwardConfirmedKill and its elimination transaction key.
function PlayerService:AddKill(player: any, amount: number?, reason: string?): (number, number)
	if not player then return 0, 0 end
	local addAmt = amount or 1
	if addAmt <= 0 then
		return self:GetKills(player), 0
	end

	local data = self._data[player]
	if not data then
		self:_register(player)
		data = self._data[player]
	end

	data.Kills = (data.Kills or 0) + addAmt
	self._kills[player] = data.Kills

	local pName = if type(player) == "table" and player.Name then player.Name elseif typeof(player) == "Instance" then player.Name else tostring(player)
	print(string.format("[PlayerService] +%d Kill(s) registrado a '%s' (Razón: %s). Total Kills: %d",
		addAmt, pName, reason or "Elimination", data.Kills))

	local ok, failure = pcall(self._sendDataUpdate, self, player)
	if not ok then warn("[PlayerService] Kill registered; data notification failed: " .. tostring(failure)) end
	return data.Kills, 0
end

function PlayerService:GetKills(player: any): number
	local data = self._data[player]
	return (data and data.Kills) or self._kills[player] or 0
end

function PlayerService:GetPlayerData(player: any): PlayerData
	local data = self._data[player]
	if data then
		return {
			Coins = data.Coins,
			Wins = data.Wins,
			Losses = data.Losses,
			Kills = data.Kills or 0,
			WinStreak = WinStreak.Normalize(data.WinStreak),
			Progression = Progression.Normalize(data.Progression),
				Preferences = data.Preferences,
			Inventory = data.Inventory,
		}
	end
	return {
		Coins = self:GetCoins(player),
		Wins = 0,
		Losses = 0,
		Kills = 0,
		Inventory = {
			Owned = {
				["PointEffects"] = { [PointEffectDefinitions.DefaultEffectId] = true },
				["DeathEffects"] = { [DeathSettings.DefaultKillEffectId] = true },
			},
			Equipped = {
				["PointEffects"] = PointEffectDefinitions.DefaultEffectId,
				["DeathEffects"] = DeathSettings.DefaultKillEffectId,
			},
		},
	}
end

-- ==================================================
-- INTERFAZ AUTORITATIVA GENÉRICA DE INVENTORY
-- ==================================================

-- Obtiene el inventario completo del jugador
function PlayerService:IsShopDataReady(player: any): boolean
	if self._shopShutdown or self._shopClosing[player] then return false end
	if typeof(player) ~= "Instance" or not player:IsA("Player") or player.Parent ~= Players or not self._data[player] then return false end
	local pds = self:_getPlayerDataService()
		if pds and pds._sessions and not pds._sessions:Owns(player)then return false end
	return pds ~= nil and pds:GetLoadState(player) == "Loaded"
end

-- Stops Shop mutations before shutdown snapshots. Does not change reward rules.
function PlayerService:BeginShopShutdown()
 self._shopShutdown = true
end

function PlayerService:CommitShopPurchase(player: any, product: any): (boolean, string?)
 if not self:IsShopDataReady(player) then return false,"DataNotLoaded" end
 local current = self._data[player]
 local nextData, reason = ProfilePurchase.Stage(current, product)
 if not nextData then return false,reason end
 -- Stage is pure/non-yielding; recheck identity/readiness immediately before commit.
 if self._data[player] ~= current or not self:IsShopDataReady(player) then return false,"DataNotLoaded" end
 self._data[player] = nextData
 self._coins[player] = nextData.Coins
 self._ownedPointEffects[player] = nextData.Inventory.Owned.PointEffects
 -- A notification failure never undoes payment/ownership or reports a failed commit.
 self:NotifyShopUpdate(player)
 return self:FlushPersistentProfile(player)
end

function PlayerService:FlushPersistentProfile(player: any): (boolean, string?)
 local pds=self:_getPlayerDataService()
 if not pds or not pds._sessions then return true end
 local ok,why=pds:SavePlayer(player,self._data[player])
 if not ok then warn("[PlayerData] Critical checkpoint pending: "..tostring(why));return false,"PersistencePending"end
 return true
end
function PlayerService:NotifyShopUpdate(player: any)
 local ok, err = pcall(function() self:_sendDataUpdate(player) end)
 if not ok then warn("[PlayerService] Shop committed; snapshot delivery failed: " .. tostring(err)) end
end

-- One non-yielding runtime assignment followed by the fenced production checkpoint.
-- Grant + claim marker share one profile key; an uncertain write remains pending, never rolled back.
function PlayerService:CommitProgression(player: any, expected: any, nextData: any): boolean
 if not self:IsShopDataReady(player) or self._data[player] ~= expected then return false end
 self._data[player] = nextData
 self._coins[player] = nextData.Coins
 self._ownedPointEffects[player] = nextData.Inventory.Owned.PointEffects
 self:NotifyShopUpdate(player)
 return self:FlushPersistentProfile(player)
end

function PlayerService:CommitCrateState(player: any, expectedInventory: any, nextData: any): (boolean, string?)
 if not self:IsShopDataReady(player) then return false,"DataNotLoaded" end
 local current=self._data[player]
 if current.Inventory~=expectedInventory then return false,"ProfileChanged" end
 self._data[player]=nextData
 self._coins[player]=nextData.Coins
 self._ownedPointEffects[player]=nextData.Inventory.Owned.PointEffects
 self:NotifyShopUpdate(player)
 return self:FlushPersistentProfile(player)
end

function PlayerService:GetInventory(player: any): Types.PlayerInventory?
	local data = self._data[player]
	if not data then return nil end
	return data.Inventory
end

-- Verifica si el jugador posee un ítem en una categoría específica
function PlayerService:HasItem(player: any, category: string, productId: string): boolean
	if not player or type(category) ~= "string" or type(productId) ~= "string" then
		return false
	end

	-- Regla especial universal: PointEffects.Basic siempre es poseído
	if category == "PointEffects" and productId == PointEffectDefinitions.DefaultEffectId then
		return true
	end
	-- Initial entitlement, never a purchase/grant event or Coins transaction.
	if category == "DeathEffects" and productId == DeathSettings.DefaultKillEffectId then return true end
	if category == "Abilities" and productId == "Dash" then return true end

	local data = self._data[player]
	if not data or not data.Inventory or not data.Inventory.Owned then
		return false
	end

	local catOwned = data.Inventory.Owned[category]
	return catOwned ~= nil and catOwned[productId] == true
end

-- Otorga propiedad de un ítem en una categoría genérica (server-authoritative)
function PlayerService:AddItem(player: any, category: string, productId: string): (boolean, string?)
	if not player then
		return false, "PlayerNotFound"
	end
	if type(category) ~= "string" or category == "" then
		return false, "InvalidCategory"
	end
	if type(productId) ~= "string" or productId == "" then
		return false, "InvalidProductId"
	end

	local data = self._data[player]
	if not data then
		self:_register(player)
		data = self._data[player]
	end

	if not data.Inventory then
		data.Inventory = { Owned = {}, Equipped = {} }
	end
	if not data.Inventory.Owned then
		data.Inventory.Owned = {}
	end
	if not data.Inventory.Owned[category] then
		data.Inventory.Owned[category] = {}
	end

	data.Inventory.Owned[category][productId] = true

	-- Mantener referencias auxiliares de PointEffects sincronizadas
	if category == "PointEffects" then
		self._ownedPointEffects[player] = data.Inventory.Owned[category]
	end

	local pName = if type(player) == "table" and player.Name then player.Name elseif typeof(player) == "Instance" then player.Name else tostring(player)
	print(string.format("[PlayerService] Jugador '%s' adquirió ítem: [%s] '%s'", pName, category, productId))

	self:_sendDataUpdate(player)
	return true, nil
end

-- Retorna el ítem equipado actualmente en una categoría
function PlayerService:GetEquippedItem(player: any, category: string): string?
	if not player or type(category) ~= "string" then
		return nil
	end
	if category == "DeathEffects" then
		local shop = self._context and self._context:GetService("ShopService")
		local provider = shop and shop:GetProvider(category)
		return if provider then provider:GetEquippedEffectId(player) else DeathSettings.DefaultKillEffectId
	end

	local data = self._data[player]
	if not data or not data.Inventory or not data.Inventory.Equipped then
		if category == "PointEffects" then
			return PointEffectDefinitions.DefaultEffectId
		end
		return nil
	end

	local equipped = data.Inventory.Equipped[category]

	if category == "PointEffects" then
		local models = game:GetService("ServerStorage"):FindFirstChild("PointEffects")
		local model = equipped and models and models:FindFirstChild(equipped)
		if not equipped or not PointEffectDefinitions.IsValid(equipped) or not self:HasItem(player, category, equipped)
			or not model or not model:IsA("Model") then
			return PointEffectDefinitions.DefaultEffectId
		end
		return equipped
	end

	if equipped and not self:HasItem(player, category, equipped) then
		return nil
	end

	return equipped
end

-- Equipa un ítem en una categoría (valida propiedad y disponibilidad)
function PlayerService:SetEquippedItem(player: any, category: string, productId: string?): (boolean, string?)
	if not self:IsShopDataReady(player) then return false, "DataNotLoaded" end
	if not player then
		return false, "PlayerNotFound"
	end
	if type(category) ~= "string" or category == "" then
		return false, "InvalidCategory"
	end
	if category == "DeathEffects" then
		if not self:IsShopDataReady(player) then return false, "DataNotLoaded" end
		local shop = self._context and self._context:GetService("ShopService")
		local provider = shop and shop:GetProvider(category)
		local actualId = if productId and productId ~= "" then productId else DeathSettings.DefaultKillEffectId
		local product = provider and provider:GetProduct(actualId)
		if not product then return false, "ProductNotFound" end
		if not provider:GetResource(actualId) then return false, "ProductUnavailable" end
	end
	if category == "PointEffects" and productId and productId ~= "" then
		if not PointEffectDefinitions.IsValid(productId) then return false, "ProductNotFound" end
		local models = game:GetService("ServerStorage"):FindFirstChild("PointEffects")
		local model = models and models:FindFirstChild(productId)
		if not model or not model:IsA("Model") then return false, "ProductUnavailable" end
	end

	local data = self._data[player]
	if not data then
		self:_register(player)
		data = self._data[player]
	end

	if not data.Inventory then
		data.Inventory = { Owned = {}, Equipped = {} }
	end
	if not data.Inventory.Equipped then
		data.Inventory.Equipped = {}
	end

	if productId == nil or productId == "" then
		return self:UnequipItem(player, category)
	end

	if not self:HasItem(player, category, productId) then
		warn(string.format("[PlayerService] Jugador no posee el ítem: [%s] '%s'", category, productId))
		return false, "NotOwned"
	end

	data.Inventory.Equipped[category] = productId

	if category == "PointEffects" then
		self._equippedPointEffects[player] = productId
	end

	local pName = if type(player) == "table" and player.Name then player.Name elseif typeof(player) == "Instance" then player.Name else tostring(player)
	print(string.format("[PlayerService] Jugador '%s' equipó ítem: [%s] '%s'", pName, category, productId))

	self:NotifyShopUpdate(player)
	return true, nil
end

-- Desequipa el ítem de una categoría (restituye default seguro si aplica)
function PlayerService:UnequipItem(player: any, category: string): (boolean, string?)
	if not self:IsShopDataReady(player) then return false, "DataNotLoaded" end
	if not player then
		return false, "PlayerNotFound"
	end
	if type(category) ~= "string" or category == "" then
		return false, "InvalidCategory"
	end

	local data = self._data[player]
	if not data or not data.Inventory then
		return false, "NoInventory"
	end
	if not data.Inventory.Equipped then
		data.Inventory.Equipped = {}
	end

	if category == "PointEffects" then
		data.Inventory.Equipped["PointEffects"] = PointEffectDefinitions.DefaultEffectId
		self._equippedPointEffects[player] = PointEffectDefinitions.DefaultEffectId
	elseif category == "DeathEffects" then
		return self:SetEquippedItem(player, category, DeathSettings.DefaultKillEffectId)
	else
		data.Inventory.Equipped[category] = nil
	end

	local pName = if type(player) == "table" and player.Name then player.Name elseif typeof(player) == "Instance" then player.Name else tostring(player)
	print(string.format("[PlayerService] Jugador '%s' desequipó categoría: [%s]", pName, category))

	self:NotifyShopUpdate(player)
	return true, nil
end

-- ==================================================
-- INTERFAZ ESPECÍFICA DE POINT EFFECTS (WRAPPERS SOBRE INVENTORY)
-- ==================================================

-- Verifica si el jugador posee un PointEffect específico
function PlayerService:HasPointEffect(player: any, effectId: string): boolean
	return self:HasItem(player, "PointEffects", effectId)
end

-- Retorna el diccionario de efectos que posee el jugador
function PlayerService:GetOwnedPointEffects(player: any): { [string]: boolean }
	local inv = self:GetInventory(player)
	local owned = (inv and inv.Owned and inv.Owned["PointEffects"]) or {}
	local copy = { [PointEffectDefinitions.DefaultEffectId] = true }
	for k, v in pairs(owned) do
		copy[k] = v
	end
	return copy
end

-- Agrega un efecto a la lista de efectos poseídos (wrapper compatible)
function PlayerService:AddOwnedPointEffect(player: any, effectId: string): (boolean, string?)
	if not PointEffectDefinitions.IsValid(effectId) then
		return false, "InvalidEffectId"
	end
	return self:AddItem(player, "PointEffects", effectId)
end

-- Retorna el PointEffect equipado por el jugador (con fallback seguro obligatorio a Basic)
function PlayerService:GetEquippedPointEffect(player: any): string
	return self:GetEquippedItem(player, "PointEffects") or PointEffectDefinitions.DefaultEffectId
end

-- Equipa autoritativamente un PointEffect para el jugador (wrapper compatible)
function PlayerService:SetEquippedPointEffect(player: any, effectId: string): (boolean, string?)
	if not PointEffectDefinitions.IsValid(effectId) then
		warn(string.format("[PlayerService] Intento de equipar effectId inexistente: '%s'", tostring(effectId)))
		return false, "InvalidEffectId"
	end
	return self:SetEquippedItem(player, "PointEffects", effectId)
end

function PlayerService:Start(context)
	self._context = context
		local remotes=ReplicatedStorage:FindFirstChild("Remotes")
		if not remotes then remotes=Instance.new("Folder");remotes.Name="Remotes";remotes.Parent=ReplicatedStorage end
		local preferences=remotes:FindFirstChild("PlayerPreferences")
		if not preferences then preferences=Instance.new("RemoteFunction");preferences.Name="PlayerPreferences";preferences.Parent=remotes end
		assert(preferences:IsA("RemoteFunction"),"PlayerPreferences class conflict")
		self._preferencesRate={}
		preferences.OnServerInvoke=function(player,action,args)
			if not self:IsShopDataReady(player)then return {Ok=false,Reason="DataNotLoaded"}end
			local now=os.clock();if now-(self._preferencesRate[player]or -math.huge)<.3 then return {Ok=false,Reason="RateLimited"}end;self._preferencesRate[player]=now
			local data=self._data[player]
			if action=="Update"then
				if type(args)~="table"or type(args.MusicEnabled)~="boolean"or type(args.MusicVolume)~="number"or args.MusicVolume~=args.MusicVolume or args.MusicVolume<0 or args.MusicVolume>1 then return {Ok=false,Reason="InvalidPreferences"}end
				data.Preferences={MusicEnabled=args.MusicEnabled,MusicVolume=args.MusicVolume}
			elseif action~="Snapshot"then return {Ok=false,Reason="InvalidAction"}end
			return {Ok=true,Preferences=table.clone(data.Preferences or {MusicEnabled=true,MusicVolume=1})}
		end
	table.insert(self._connections, Players.PlayerAdded:Connect(function(player)
		self:_register(player)
	end))
	table.insert(self._connections, Players.PlayerRemoving:Connect(function(player)
			self._preferencesRate[player]=nil
		self:_unregister(player)
	end))

	for _, player in ipairs(Players:GetPlayers()) do
		self:_register(player)
	end
end

return PlayerService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="987">
        <Properties>
          <string name="Name">PointEffectTestService</string>
          <string name="Source"><![CDATA[--!strict
-- PointEffectTestService
-- Herramienta exclusiva de desarrollo y testing para Point Effects.
-- Permite probar cosméticos directamente en Workspace.PointEffectTest.TestPart
-- sin iniciar partidas, sin ScoreService, sin Coins, sin MatchScore ni alterar el gameplay.
-- Reutiliza autoritativamente PointEffectRegistry y los Controllers de coreografía.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local ServerStorage = game:GetService("ServerStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local PointEffectDefinitions = require(ReplicatedStorage.Shared.PointEffectDefinitions)

local PointEffectTestService = {}
PointEffectTestService.Name = "PointEffectTestService"

PointEffectTestService._context = nil :: any
PointEffectTestService._cooldowns = {} :: { [BasePart]: number }
PointEffectTestService._activeHandles = {} :: { [BasePart]: { any } }
PointEffectTestService._touchingPlayers = {} :: { [BasePart]: { [Player]: boolean } }
PointEffectTestService._connections = {} :: { RBXScriptConnection }

-- Resuelve el catálogo de PointEffectRegistry
function PointEffectTestService:_getRegistry()
	local controllersFolder = ServerScriptService:FindFirstChild("PointEffectControllers")
	if not controllersFolder then
		return nil
	end

	-- Asegurar que BasicController esté cargado para su auto-registro
	local basicMod = controllersFolder:FindFirstChild("BasicController")
	if basicMod and basicMod:IsA("ModuleScript") then
		pcall(require, basicMod)
	end

	local registryMod = controllersFolder:FindFirstChild("PointEffectRegistry")
	if registryMod and registryMod:IsA("ModuleScript") then
		local ok, reg = pcall(require, registryMod)
		if ok then return reg end
	end
	return nil
end

-- Obtiene el servicio de jugadores para resolver el cosmético equipado
function PointEffectTestService:_getPlayerService()
	if self._context and type(self._context.GetService) == "function" then
		local s = self._context:GetService("PlayerService")
		if s then return s end
	end
	local servicesFolder = ServerScriptService:FindFirstChild("Services")
	local mod = servicesFolder and servicesFolder:FindFirstChild("PlayerService")
	if mod and mod:IsA("ModuleScript") then
		local ok, result = pcall(require, mod)
		if ok then return result end
	end
	return nil
end

-- Resuelve autoritativamente el EffectId equipado por el jugador (con fallback seguro a Basic)
function PointEffectTestService:_resolvePlayerEffectId(player: Player?): string
	local defaultId = PointEffectDefinitions.DefaultEffectId
	if not player then
		return defaultId
	end

	local playerService = self:_getPlayerService()
	if not playerService or type(playerService.GetEquippedPointEffect) ~= "function" then
		return defaultId
	end

	local equipped = playerService:GetEquippedPointEffect(player)
	if not equipped or not PointEffectDefinitions.IsValid(equipped) then
		return defaultId
	end

	return equipped
end

-- Obtiene el template visual/sonoro desde ServerStorage.PointEffects[EffectId] (con fallback seguro a Basic)
function PointEffectTestService:_getEffectTemplate(effectId: string): Instance?
	local pointEffectsFolder = ServerStorage:FindFirstChild("PointEffects")
	if not pointEffectsFolder then
		warn("[PointEffectTestService] ServerStorage.PointEffects no existe")
		return nil
	end

	local template = pointEffectsFolder:FindFirstChild(effectId)
	if not template and effectId ~= PointEffectDefinitions.DefaultEffectId then
		warn(string.format("[PointEffectTestService] Template para '%s' no encontrado en ServerStorage.PointEffects. Usando fallback '%s'",
			tostring(effectId), PointEffectDefinitions.DefaultEffectId))
		template = pointEffectsFolder:FindFirstChild(PointEffectDefinitions.DefaultEffectId)
	end

	if not template then
		warn(string.format("[PointEffectTestService] Template de efecto '%s' no encontrado", tostring(effectId)))
		return nil
	end

	return template
end

-- Obtiene el RemoteEvent PointFeedback de ReplicatedStorage.Remotes.Match
function PointEffectTestService:_getFeedbackRemote(): RemoteEvent?
	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	local matchFolder = remotes and remotes:FindFirstChild("Match")
	local pointFeedback = matchFolder and matchFolder:FindFirstChild("PointFeedback")
	if pointFeedback and pointFeedback:IsA("RemoteEvent") then
		return pointFeedback
	end
	return nil
end

-- Obtiene el servicio de Ragdoll para física de impacto
function PointEffectTestService:_getRagdollService()
	if self._context and self._context.GetService then
		local s = self._context:GetService("RagdollService")
		if s then return s end
	end
	local servicesFolder = ServerScriptService:FindFirstChild("Services")
	local mod = servicesFolder and servicesFolder:FindFirstChild("RagdollService")
	if mod and mod:IsA("ModuleScript") then
		local ok, result = pcall(require, mod)
		if ok then return result end
	end
	return nil
end

-- Extrae el Player desde un BasePart del personaje
local function getPlayerFromHit(hit: BasePart): Player?
	if not hit or not hit:IsA("BasePart") then return nil end
	local current: Instance? = hit
	while current and current ~= Workspace do
		if current:IsA("Model") then
			local hum = current:FindFirstChildOfClass("Humanoid")
			if hum then
				return Players:GetPlayerFromCharacter(current)
			end
		end
		current = current.Parent
	end
	return nil
end

-- Ejecuta la prueba de un cosmético sobre el TestPart
function PointEffectTestService:_triggerTest(part: BasePart, player: Player?)
	if not part or not part:IsDescendantOf(Workspace) then return end

	-- Si el jugador ya se encuentra en estado Ragdoll, ignorar activación para evitar bucles
	if player and player.Character then
		local ragdollService = self:_getRagdollService()
		if ragdollService and ragdollService:IsRagdolled(player.Character) then
			return
		end
	end

	-- 1. Verificación de Cooldown
	local rawCooldown = part:GetAttribute("Cooldown")
	local cooldown = if typeof(rawCooldown) == "number" and rawCooldown >= 0 then rawCooldown else 1.0

	local now = os.clock()
	local lastTime = self._cooldowns[part] or 0
	if (now - lastTime) < cooldown then
		-- Cooldown activo: ignorar activaciones repetidas
		return
	end
	self._cooldowns[part] = now

	-- 2. Resolución dinámica del efecto equipado por el jugador (o fallback seguro a Basic)
	local effectId = self:_resolvePlayerEffectId(player)

	-- 3. Localizar template del efecto en ServerStorage.PointEffects
	local template = self:_getEffectTemplate(effectId)
	if not template then
		return
	end

	-- 4. Obtener Controller correspondiente desde PointEffectRegistry
	local registry = self:_getRegistry()
	local controller = registry and registry.GetController(effectId)
	if not controller or typeof(controller.Play) ~= "function" then
		warn(string.format("[PointEffectTestService] Controller no disponible para '%s'", effectId))
		return
	end

	-- 5. Clonar y posicionar físicamente en TestPart
	local clone = template:Clone()
	if clone:IsA("Model") then
		clone:PivotTo(CFrame.new(part.Position))
	elseif clone:IsA("BasePart") then
		clone.CFrame = CFrame.new(part.Position)
	end
	clone.Parent = part

	-- 6. Construir contexto de prueba compatible
	local isFinalPoint = (part:GetAttribute("IsFinalPoint") == true)
	local testPointId = string.format("TEST_%s_%d", effectId, math.floor(now * 1000))
	local testContext = {
		EffectModel = clone :: Model,
		ScoringZone = part,
		OriginPart = part,
		ScoringPlayer = player,
		MatchId = "TEST",
		PointId = testPointId,
		IsFinalPoint = isFinalPoint,
		Score = { Red = 0, Blue = 0 },
	}

	-- 7. Ejecutar coreografía mediante el controller
	local ok, handle = pcall(function()
		return controller.Play(testContext)
	end)

	if ok and handle and typeof(handle) == "table" then
		if not self._activeHandles[part] then
			self._activeHandles[part] = {}
		end
		table.insert(self._activeHandles[part], handle)
	elseif not ok then
		warn(string.format("[PointEffectTestService] Error al reproducir '%s': %s", effectId, tostring(handle)))
		if clone and clone.Parent then
			clone:Destroy()
		end
		return
	end

	-- 8. Broadcast a clientes vía RemoteEvent PointFeedback (para PointCameraFX y feedback de cámara)
	local feedbackRemote = self:_getFeedbackRemote()
	if feedbackRemote then
		local broadcastData = {
			MatchId = "TEST",
			PointId = testPointId,
			ScoringTeam = "Test",
			ScoringPlayer = player,
			ScoringPlayerName = if player then player.Name else "Touched",
			ScoringZonePosition = part.Position,
			IsFinalPoint = isFinalPoint,
			EffectId = effectId,
		}
		feedbackRemote:FireAllClients(broadcastData)
	end

	local playerName = if player then player.Name else "Touched"
	print(string.format("[PointEffectTestService] PointEffect '%s' ejecutado en TestPart (Invocador: %s, PointId: %s, Final: %s)",
		effectId, playerName, testPointId, tostring(isFinalPoint)))

	-- 9. Física de lanzamiento en Ragdoll por la onda expansiva
	local ragdollService = self:_getRagdollService()
	if ragdollService then
		local rawRadius = part:GetAttribute("RagdollRadius")
		local rawForce = part:GetAttribute("RagdollForce")
		local rawDuration = part:GetAttribute("RagdollDuration")
		local rawUpRatio = part:GetAttribute("UpwardRatio")

		local blastRadius = if typeof(rawRadius) == "number" then rawRadius else (Config.Ragdoll and Config.Ragdoll.BlastRadius) or 100
		local blastForce = if typeof(rawForce) == "number" then rawForce else (Config.Ragdoll and Config.Ragdoll.BlastForce) or 110
		local ragDuration = if typeof(rawDuration) == "number" then rawDuration else (Config.Ragdoll and Config.Ragdoll.DefaultDuration) or 5.0
		local upRatio = if typeof(rawUpRatio) == "number" then rawUpRatio else (Config.Ragdoll and Config.Ragdoll.UpwardRatio) or 1.0
		if isFinalPoint then
			blastForce *= 1.3
		end

		local affectScorer = part:GetAttribute("AffectScorer") == true
		local function filterScoringPlayer(targetPlayer: Player?, _char: Model): boolean
			if not affectScorer and player and targetPlayer == player then
				return false -- El jugador que anota el punto no es afectado por la explosión ni el ragdoll
			end
			return true
		end

		ragdollService:BlastZone(part.Position, blastRadius, blastForce, upRatio, ragDuration, filterScoringPlayer)
	end
end

-- Configura y registra un TestPart con Attributes, ProximityPrompt y conexiones
function PointEffectTestService:RegisterTestPart(part: BasePart)
	if not part or not part:IsA("BasePart") then return end

	-- Asegurar atributos por defecto
	if part:GetAttribute("EffectId") == nil then
		part:SetAttribute("EffectId", "Basic")
	end
	if part:GetAttribute("Cooldown") == nil then
		part:SetAttribute("Cooldown", 1)
	end
	if part:GetAttribute("IsFinalPoint") == nil then
		part:SetAttribute("IsFinalPoint", false)
	end
	if part:GetAttribute("RagdollForce") == nil then
		part:SetAttribute("RagdollForce", (Config.Ragdoll and Config.Ragdoll.BlastForce) or 110)
	end
	if part:GetAttribute("RagdollRadius") == nil then
		part:SetAttribute("RagdollRadius", (Config.Ragdoll and Config.Ragdoll.BlastRadius) or 100)
	end
	if part:GetAttribute("RagdollDuration") == nil then
		part:SetAttribute("RagdollDuration", (Config.Ragdoll and Config.Ragdoll.DefaultDuration) or 5.0)
	end
	if part:GetAttribute("UpwardRatio") == nil then
		part:SetAttribute("UpwardRatio", (Config.Ragdoll and Config.Ragdoll.UpwardRatio) or 1.0)
	end
	if part:GetAttribute("AffectScorer") == nil then
		part:SetAttribute("AffectScorer", false)
	end

	-- Asegurar ProximityPrompt para activación manual (permite activarlo desde lejos para probar la distancia)
	local prompt = part:FindFirstChildOfClass("ProximityPrompt")
	if not prompt then
		prompt = Instance.new("ProximityPrompt")
		prompt.Name = "TestPrompt"
		prompt.ActionText = "Probar efecto"
		prompt.ObjectText = "Point Effect Test"
		prompt.MaxActivationDistance = 35
		prompt.RequiresLineOfSight = false
		prompt.Parent = part
	else
		prompt.MaxActivationDistance = 35
	end

	-- Conexión ProximityPrompt
	local promptConn = prompt.Triggered:Connect(function(player: Player)
		self:_triggerTest(part, player)
	end)
	table.insert(self._connections, promptConn)

	-- Conexión Touched (sólo para personajes vivos que no estén actualmente en ragdoll ni ya dentro del part)
	local touchConn = part.Touched:Connect(function(hit: BasePart)
		local player = getPlayerFromHit(hit)
		if not player or not player.Character then return end

		local ragdollService = self:_getRagdollService()
		if ragdollService and ragdollService:IsRagdolled(player.Character) then
			return
		end

		if not self._touchingPlayers[part] then
			self._touchingPlayers[part] = {}
		end
		if self._touchingPlayers[part][player] then
			return
		end
		self._touchingPlayers[part][player] = true

		self:_triggerTest(part, player)
	end)
	table.insert(self._connections, touchConn)

	-- Conexión TouchEnded para permitir volver a activar al salir y re-entrar
	local touchEndConn = part.TouchEnded:Connect(function(hit: BasePart)
		local player = getPlayerFromHit(hit)
		if player and self._touchingPlayers[part] then
			self._touchingPlayers[part][player] = nil
		end
	end)
	table.insert(self._connections, touchEndConn)

	print(string.format("[PointEffectTestService] TestPart registrado: %s [EffectId=%s, Cooldown=%s, AffectScorer=%s]",
		part:GetFullName(), tostring(part:GetAttribute("EffectId")), tostring(part:GetAttribute("Cooldown")), tostring(part:GetAttribute("AffectScorer"))))
end

-- Crea la estructura física predeterminada en Workspace si no existe
function PointEffectTestService:EnsureDefaultTestSetup(): (Folder, BasePart)
	local container = Workspace:FindFirstChild("PointEffectTest") :: Folder?
	if not container then
		container = Instance.new("Folder")
		container.Name = "PointEffectTest"
		container.Parent = Workspace
	end

	local testPart = container:FindFirstChild("TestPart") :: BasePart?
	if not testPart then
		local part = Instance.new("Part")
		part.Name = "TestPart"
		part.Size = Vector3.new(4, 0.6, 4)
		part.Position = Vector3.new(35, 0.5, -115) -- Cerca del Spawn del Lobby
		part.Material = Enum.Material.Neon
		part.Color = Color3.fromRGB(255, 170, 0)
		part.Anchored = true
		part.CanCollide = true
		part:SetAttribute("EffectId", "Basic")
		part:SetAttribute("Cooldown", 1)
		part.Parent = container
		testPart = part
	end

	-- Indicador visual del radio de explosión en el suelo
	local adorn = testPart:FindFirstChild("BlastRadiusIndicator") :: CylinderHandleAdornment?
	if not adorn then
		adorn = Instance.new("CylinderHandleAdornment")
		adorn.Name = "BlastRadiusIndicator"
		adorn.Adornee = testPart
		adorn.Radius = (testPart:GetAttribute("RagdollRadius")) or 25
		adorn.Height = 0.05
		adorn.CFrame = CFrame.Angles(math.rad(90), 0, 0)
		adorn.Color3 = Color3.fromRGB(255, 170, 0)
		adorn.Transparency = 0.85
		adorn.AlwaysOnTop = false
		adorn.Parent = testPart
	end

	return container, testPart
end

function PointEffectTestService:Init(context)
	self._context = context
	self._cooldowns = {}
	self._activeHandles = {}
	self._touchingPlayers = {}
	self._connections = {}
end

function PointEffectTestService:Start(context)
	self._context = context

	-- 1. Crear o localizar la estructura en Workspace
	local container, defaultPart = self:EnsureDefaultTestSetup()
	self:RegisterTestPart(defaultPart)

	-- 2. Registrar cualquier otro part dentro de Workspace.PointEffectTest
	for _, child in ipairs(container:GetChildren()) do
		if child:IsA("BasePart") and child ~= defaultPart then
			self:RegisterTestPart(child)
		end
	end

	-- 3. Escuchar adiciones dinámicas en tiempo de ejecución (útil en Studio)
	local childConn = container.ChildAdded:Connect(function(child: Instance)
		if child:IsA("BasePart") then
			self:RegisterTestPart(child)
		end
	end)
	table.insert(self._connections, childConn)

	print("[PointEffectTestService] Servicio de testing de Point Effects activo y listo")
end

-- Limpieza de efectos activos de un TestPart específico o de todos
function PointEffectTestService:CleanupTest(part: BasePart?)
	if part then
		local handles = self._activeHandles[part]
		if handles then
			for _, h in ipairs(handles) do
				if typeof(h) == "table" and typeof(h.Destroy) == "function" then
					pcall(function() h:Destroy() end)
				end
			end
			self._activeHandles[part] = nil
		end
	else
		for _, handles in pairs(self._activeHandles) do
			for _, h in ipairs(handles) do
				if typeof(h) == "table" and typeof(h.Destroy) == "function" then
					pcall(function() h:Destroy() end)
				end
			end
		end
		self._activeHandles = {}
	end
end

return PointEffectTestService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="988">
        <Properties>
          <string name="Name">PointFeedbackService</string>
          <string name="Source"><![CDATA[--!strict
-- PointFeedbackService
-- Responsable del ciclo de vida, posicionamiento físico y delegación al Controller correspondiente de Point Effects.
-- El cosmético (PointEffect) pertenece al ScoringPlayer, pero su origen físico es ScoringZone (RedWin/BlueWin).
-- La coreografía específica de cada efecto la gestiona su respectivo Controller (ej. BasicController).
-- No detecta puntos, no valida jugadores, no otorga monedas ni altera scores (responsabilidad de ScoreService).

local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local ServerStorage = game:GetService("ServerStorage")
local Workspace = game:GetService("Workspace")

local Types = require(ReplicatedStorage.Shared.Types)
local Config = require(ReplicatedStorage.Shared.Config)
local PointEffectDefinitions = require(ReplicatedStorage.Shared.PointEffectDefinitions)

type MatchSession = Types.MatchSession
type PointFeedbackPayload = Types.PointFeedbackPayload
type PointFeedbackBroadcast = Types.PointFeedbackBroadcast

local PointFeedbackService = {}
PointFeedbackService.Name = "PointFeedbackService"

PointFeedbackService._context = nil :: any
PointFeedbackService._processedPoints = {} :: { [string]: boolean } -- pointId -> boolean (evita duplicación de feedback)
PointFeedbackService._activeMatchEffects = {} :: { [string]: { any } } -- matchId -> lista de instancias temporales
PointFeedbackService._activeMatchHandles = {} :: { [string]: { any } } -- matchId -> lista de handles de controllers activos

-- Remotes requeridos
local function ensureRemoteFolder(parent: Instance, name: string): Folder
	local folder = parent:FindFirstChild(name)
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = name
		folder.Parent = parent
	end
	return folder :: Folder
end

local function ensureRemoteEvent(parent: Instance, name: string): RemoteEvent
	local event = parent:FindFirstChild(name)
	if not event then
		event = Instance.new("RemoteEvent")
		event.Name = name
		event.Parent = parent
	end
	return event :: RemoteEvent
end

function PointFeedbackService:_ensureRemotes()
	local remotesFolder = ensureRemoteFolder(ReplicatedStorage, "Remotes")
	local matchFolder = ensureRemoteFolder(remotesFolder, "Match")
	ensureRemoteEvent(matchFolder, "PointFeedback")
end

function PointFeedbackService:_getRemote(eventName: string): RemoteEvent?
	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	local matchFolder = remotes and remotes:FindFirstChild("Match")
	local event = matchFolder and matchFolder:FindFirstChild(eventName)
	if event and event:IsA("RemoteEvent") then
		return event
	end
	return nil
end

function PointFeedbackService:_getPlayerService()
	if self._context and self._context.GetService then
		local s = self._context:GetService("PlayerService")
		if s then return s end
	end

	local servicesFolder = ServerScriptService:FindFirstChild("Services")
	local mod = servicesFolder and servicesFolder:FindFirstChild("PlayerService")
	if mod and mod:IsA("ModuleScript") then
		local ok, result = pcall(require, mod)
		if ok then return result end
	end
	return nil
end

function PointFeedbackService:_getRoundService()
	if self._context and self._context.GetService then
		local service = self._context:GetService("RoundService")
		if service then return service end
	end
	return nil
end

-- Obtiene el registro de controllers cargando BasicController si aún no se inicializó
function PointFeedbackService:_getControllerRegistry()
	local controllersFolder = ServerScriptService:FindFirstChild("PointEffectControllers")
	if not controllersFolder then
		return nil
	end

	-- Asegurar que BasicController esté cargado para su auto-registro
	local basicMod = controllersFolder:FindFirstChild("BasicController")
	if basicMod and basicMod:IsA("ModuleScript") then
		pcall(require, basicMod)
	end

	local registryMod = controllersFolder:FindFirstChild("PointEffectRegistry")
	if registryMod and registryMod:IsA("ModuleScript") then
		local ok, reg = pcall(require, registryMod)
		if ok then return reg end
	end
	return nil
end

-- Obtiene el servicio de Ragdoll para física de impacto
function PointFeedbackService:_getRagdollService()
	if self._context and self._context.GetService then
		local s = self._context:GetService("RagdollService")
		if s then return s end
	end
	local servicesFolder = ServerScriptService:FindFirstChild("Services")
	local mod = servicesFolder and servicesFolder:FindFirstChild("RagdollService")
	if mod and mod:IsA("ModuleScript") then
		local ok, result = pcall(require, mod)
		if ok then return result end
	end
	return nil
end

function PointFeedbackService:Init(context)
	self._context = context
	self._processedPoints = {}
	self._activeMatchEffects = {}
	self._activeMatchHandles = {}

	self:_ensureRemotes()
end

function PointFeedbackService:Start(context)
	self._context = context
	-- Pre-cargar registro de controllers
	local _ = self:_getControllerRegistry()
	print("[PointFeedbackService] Servicio iniciado y listo para despachar PointEffects a Controllers")
end

-- Resuelve autoritativamente el EffectId equipado por el jugador anotador con fallback seguro a Basic
function PointFeedbackService:_resolvePlayerEffectId(scoringPlayer: Player?): string
	if not scoringPlayer then
		return PointEffectDefinitions.DefaultEffectId
	end

	local playerService = self:_getPlayerService()
	if not playerService or not playerService.GetEquippedPointEffect then
		return PointEffectDefinitions.DefaultEffectId
	end

	local equipped = playerService:GetEquippedPointEffect(scoringPlayer)
	if not equipped or not PointEffectDefinitions.IsValid(equipped) then
		return PointEffectDefinitions.DefaultEffectId
	end

	return equipped
end

-- Obtiene el template visual/sonoro desde ServerStorage.PointEffects[EffectId] (editable desde Studio)
function PointFeedbackService:_getEffectTemplate(effectId: string): Instance?
	local pointEffectsFolder = ServerStorage:FindFirstChild("PointEffects")
	if not pointEffectsFolder then
		warn("[PointFeedbackService] ServerStorage.PointEffects no existe")
		return nil
	end

	local template = pointEffectsFolder:FindFirstChild(effectId)
	if not template and effectId ~= PointEffectDefinitions.DefaultEffectId then
		warn(string.format("[PointFeedbackService] Template para '%s' no encontrado en ServerStorage.PointEffects. Usando fallback '%s'",
			tostring(effectId), PointEffectDefinitions.DefaultEffectId))
		template = pointEffectsFolder:FindFirstChild(PointEffectDefinitions.DefaultEffectId)
	end

	if not template then
		warn(string.format("[PointFeedbackService] Template de efecto '%s' no encontrado", tostring(effectId)))
		return nil
	end

	return template
end

-- Valida defensivamente que ScoringZone sea válida, pertenezca a la instancia y corresponda al equipo anotador
function PointFeedbackService:_validateScoringZone(session: MatchSession, payload: PointFeedbackPayload): boolean
	local scoringZone = payload.ScoringZone
	if not scoringZone or not scoringZone:IsA("BasePart") then
		warn(string.format("[PointFeedbackService] ScoringZone inválido o no es BasePart para Match '%s'", tostring(payload.MatchId)))
		return false
	end

	if not scoringZone:IsDescendantOf(Workspace) then
		warn(string.format("[PointFeedbackService] ScoringZone no es descendiente de Workspace para Match '%s'", tostring(payload.MatchId)))
		return false
	end

	local info = session.InstanceInfo
	if not info then
		warn(string.format("[PointFeedbackService] session.InstanceInfo ausente para Match '%s'", tostring(payload.MatchId)))
		return false
	end

	-- Validar que pertenezca a la instancia activa de la partida
	if info.InstanceModel and not scoringZone:IsDescendantOf(info.InstanceModel) then
		warn(string.format("[PointFeedbackService] ScoringZone no pertenece a InstanceModel de Match '%s'", tostring(payload.MatchId)))
		return false
	end

	-- Validar que corresponda al equipo que anotó
	if payload.ScoringTeam == "Red" and scoringZone ~= info.RedWin then
		warn("[PointFeedbackService] ScoringZone no coincide con info.RedWin para anotación de Red")
		return false
	elseif payload.ScoringTeam == "Blue" and scoringZone ~= info.BlueWin then
		warn("[PointFeedbackService] ScoringZone no coincide con info.BlueWin para anotación de Blue")
		return false
	end

	return true
end

-- Fallback defensivo si un controller no estuviera disponible para un efecto
function PointFeedbackService:_fallbackPlay(clone: Instance, scoringZone: BasePart, matchId: string)
	local rawDuration = clone:GetAttribute("Duration")
	local duration = if typeof(rawDuration) == "number" and rawDuration > 0 then rawDuration else 1.2

	for _, desc in ipairs(clone:GetDescendants()) do
		if desc:IsA("Sound") then
			desc.Looped = false
			local rawDelay = desc:GetAttribute("PlayDelay")
			local playDelay = if typeof(rawDelay) == "number" and rawDelay >= 0 then rawDelay else 0
			if playDelay > 0 then
				task.delay(playDelay, function() if desc and desc.Parent then desc:Play() end end)
			else
				desc:Play()
			end
		elseif desc:IsA("ParticleEmitter") then
			desc.Enabled = false
			desc.Rate = 0
			local rawCount = desc:GetAttribute("EmitCount")
			local emitCount = if typeof(rawCount) == "number" and rawCount > 0 then rawCount else 10
			local rawDelay = desc:GetAttribute("EmitDelay")
			local emitDelay = if typeof(rawDelay) == "number" and rawDelay >= 0 then rawDelay else 0
			if emitDelay > 0 then
				task.delay(emitDelay, function() if desc and desc.Parent then desc:Emit(emitCount) end end)
			else
				desc:Emit(emitCount)
			end
		end
	end

	task.delay(duration, function()
		if clone and clone.Parent then
			clone:Destroy()
		end
	end)
	Debris:AddItem(clone, duration + 1.0)
end

-- Punto de entrada principal invocado por ScoreService al validar un punto
function PointFeedbackService:PlayPoint(session: MatchSession, payload: PointFeedbackPayload, finalToken: string?): boolean
	if not session or not payload then
		warn("[PointFeedbackService] PlayPoint llamado con parámetros nulos")
		return false
	end
	local authority = self:_getRoundService()
	local stateVersion = session.StateVersion
		local visualOnly = finalToken ~= nil
		local function isCurrent(): boolean
			if not authority or authority:GetSessionById(session.Id) ~= session or session.Closed
				or session.StateVersion ~= stateVersion then return false end
			if visualOnly then
				local results = session.Results
				return session.State == "Ending" and session.GameplayFrozen == true and not session.Cancelled
					and results ~= nil and results.Celebrating == true and results.Token == finalToken
					and payload.IsFinalPoint == true and session.Result == payload.ScoringTeam
			end
			return not session.GameplayFrozen and session.Result == nil and not session.Closing
				and authority:IsSessionActive(session.Id) and authority:GetSessionState(session.Id) == "Playing"
		end
		if not isCurrent() then return false end

	local pointId = payload.PointId
	if not pointId or self._processedPoints[pointId] then
		-- Duplicación detectada: ignorar silenciosamente sin interrumpir el flujo
		return false
	end

	-- Marcar punto como procesado (protección contra doble feedback)
	self._processedPoints[pointId] = true

	-- Validación defensiva sin romper el juego
	local isValidZone = self:_validateScoringZone(session, payload)
	if not isValidZone then
		-- Warning registrado por _validateScoringZone; no rompe el scoring ni la partida
		return false
	end

	local matchId = payload.MatchId or session.Id

	-- 1. Resolver el PointEffect equipado por el ScoringPlayer (con fallback seguro a Basic)
	local scoringPlayer = payload.ScoringPlayer
	local effectId = self:_resolvePlayerEffectId(scoringPlayer)
	local effectDef = PointEffectDefinitions.Get(effectId) or PointEffectDefinitions.GetDefault()
	local resolvedEffectId = effectDef.Id

	local playerName = if scoringPlayer and scoringPlayer.Name then scoringPlayer.Name else "Unknown"
	print(string.format("[PointFeedbackService] Feedback activado para Match '%s' (Punto: %s, Equipo: %s, Jugador: %s, PointEffect: %s [%s], Origen: %s, Final: %s)",
		matchId,
		tostring(pointId),
		payload.ScoringTeam,
		playerName,
		resolvedEffectId,
		effectDef.DisplayName,
		payload.ScoringZone:GetFullName(),
		tostring(payload.IsFinalPoint)))

	-- 2. Notificar a clientes para Camera Shake y efectos locales controlados por servidor
	local roundService = self:_getRoundService()
	if roundService and type(roundService.FireSessionRemote) == "function" then
		local broadcastData: PointFeedbackBroadcast = {
			MatchId = matchId,
			PointId = pointId,
			ScoringTeam = payload.ScoringTeam,
			ScoringPlayerName = playerName,
			ScoringZonePosition = payload.ScoringZone.Position,
			EffectId = resolvedEffectId,
			IsFinalPoint = payload.IsFinalPoint,
			RedScore = payload.RedScore,
			BlueScore = payload.BlueScore,
				VisualOnly = visualOnly,
				SessionId = session.Id,
				StateVersion = stateVersion,
		}
		roundService:FireSessionRemote(matchId, "Match", "PointFeedback", broadcastData)
	end

	-- 3. Obtener template, clonar y posicionar en ScoringZone
	local template = self:_getEffectTemplate(resolvedEffectId)
	if not template then
		warn(string.format("[PointFeedbackService] Template no disponible para efecto '%s'", resolvedEffectId))
		return true
	end

	local clone = template:Clone()
		if visualOnly then
			-- Existing controllers provide visuals/audio; the final copy cannot apply physics.
			for _, object in ipairs(clone:GetDescendants()) do
				if object:IsA("LuaSourceContainer") then object:Destroy()
				elseif object:IsA("BasePart") then
					object.Anchored = true; object.CanCollide = false; object.CanTouch = false; object.CanQuery = false
				elseif object:IsA("Explosion") then object.BlastPressure = 0; object.DestroyJointRadiusPercent = 0 end
			end
		end

	-- Posicionar con orientación neutral exactamente en la posición física de ScoringZone
	if clone:IsA("Model") then
		clone:PivotTo(CFrame.new(payload.ScoringZone.Position))
	elseif clone:IsA("BasePart") then
		clone.CFrame = CFrame.new(payload.ScoringZone.Position)
	end

	-- Parentar dentro de la instancia de la partida (ScoringZone)
	clone.Parent = payload.ScoringZone

	-- Registrar instancia activa para cleanup
	if not self._activeMatchEffects[matchId] then
		self._activeMatchEffects[matchId] = {}
	end
	table.insert(self._activeMatchEffects[matchId], clone)

	-- 4. Obtener Controller correspondiente desde PointEffectRegistry
	local registry = self:_getControllerRegistry()
	local controller = registry and registry.GetController(resolvedEffectId)

	if controller and typeof(controller.Play) == "function" then
		local playContext = {
			EffectModel = clone :: Model,
			ScoringZone = payload.ScoringZone,
			ScoringPlayer = payload.ScoringPlayer,
			MatchId = matchId,
			PointId = pointId,
			IsFinalPoint = payload.IsFinalPoint,
			Score = session.Score,
		}

		local ok, handle = pcall(function()
			return controller.Play(playContext)
		end)
		-- A controller may yield while the terminal barrier cleans this session.
			if not isCurrent() then
			if ok and typeof(handle) == "table" then
				local cleanup = handle.Destroy or handle.Stop
				if typeof(cleanup) == "function" then pcall(cleanup, handle) end
			end
			clone:Destroy()
			return false
		end

		if ok and handle and typeof(handle) == "table" then
			if not self._activeMatchHandles[matchId] then
				self._activeMatchHandles[matchId] = {}
			end
			table.insert(self._activeMatchHandles[matchId], handle)
		elseif not ok then
			warn(string.format("[PointFeedbackService] Error al ejecutar controller para '%s': %s", resolvedEffectId, tostring(handle)))
			self:_fallbackPlay(clone, payload.ScoringZone, matchId)
		end
	else
		-- Fallback seguro si no hubiera controller registrado
		self:_fallbackPlay(clone, payload.ScoringZone, matchId)
	end

	-- 5. Física de lanzamiento en Ragdoll por la onda expansiva del punto
	local ragdollService = self:_getRagdollService()
		if not visualOnly and ragdollService and payload.ScoringZone then
		local blastRadius = (Config.Ragdoll and Config.Ragdoll.BlastRadius) or 100
		local blastForce = (Config.Ragdoll and Config.Ragdoll.BlastForce) or 110
		local upRatio = (Config.Ragdoll and Config.Ragdoll.UpwardRatio) or 1.0
		local ragDuration = (Config.Ragdoll and Config.Ragdoll.DefaultDuration) or 5.0
		if payload.IsFinalPoint then
			blastForce *= 1.3
		end

		local scoringPlayer = payload.ScoringPlayer
		local scoringTeam = payload.ScoringTeam
		local function filterScoringPlayer(targetPlayer: Player?, _char: Model): boolean
			if session.GameplayFrozen or session.Result ~= nil or session.Closing
				or session.StateVersion ~= stateVersion
				or authority:GetSessionById(session.Id) ~= session or not authority:IsSessionActive(session.Id)
				or not targetPlayer or authority:GetSessionParticipant(session.Id, targetPlayer) == nil then
				return false
			end
			if scoringPlayer and targetPlayer == scoringPlayer then
				return false -- El jugador que anota el punto no es afectado por la explosión ni el ragdoll
			end
			if scoringTeam and session and session.Teams then
				local teamPlayers = session.Teams[scoringTeam]
				if typeof(teamPlayers) == "table" and targetPlayer and table.find(teamPlayers, targetPlayer) then
					return false -- Los compañeros del equipo anotador tampoco son afectados
				end
			end
			return true
		end

		ragdollService:BlastZone(payload.ScoringZone.Position, blastRadius, blastForce, upRatio, ragDuration, filterScoringPlayer)
	end
return true
end

function PointFeedbackService:HasActiveFeedback(matchId: string): boolean
	for _, handle in ipairs(self._activeMatchHandles[matchId] or {}) do
		if typeof(handle.IsActive) == "function" then
			local ok, active = pcall(handle.IsActive, handle)
			if ok and active then return true end
		end
	end
	for _, clone in ipairs(self._activeMatchEffects[matchId] or {}) do
		if typeof(clone) == "Instance" and clone.Parent then return true end
	end
	return false
end

-- Limpieza de recursos temporales de una partida
function PointFeedbackService:CleanupMatch(matchId: string)
	-- 1. Detener y destruir handles de controllers activos
	local handles = self._activeMatchHandles[matchId]
	if handles then
		for _, handle in ipairs(handles) do
			if typeof(handle) == "table" then
				if typeof(handle.Destroy) == "function" then
					pcall(function() handle:Destroy() end)
				elseif typeof(handle.Stop) == "function" then
					pcall(function() handle:Stop() end)
				end
			end
		end
		self._activeMatchHandles[matchId] = nil
	end

	-- 2. Limpieza de instancias físicas residuales
	local effects = self._activeMatchEffects[matchId]
	if effects then
		for _, item in ipairs(effects) do
			if typeof(item) == "Instance" then
				for _, desc in ipairs(item:GetDescendants()) do
					if desc:IsA("Sound") and desc.IsPlaying then
						pcall(function() desc:Stop() end)
					elseif desc:IsA("ParticleEmitter") then
						desc.Enabled = false
					end
				end
				item:Destroy()
			elseif typeof(item) == "RBXScriptConnection" then
				item:Disconnect()
			end
		end
		self._activeMatchEffects[matchId] = nil
	end

	print(string.format("[PointFeedbackService] Limpieza completada para Match '%s'", matchId))
end

return PointFeedbackService
]]></string>
