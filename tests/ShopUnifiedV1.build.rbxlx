      <Item class="ModuleScript" referent="906">
        <Properties>
          <string name="Name">AbilityAssetValidator</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Physical, authored templates only. Never imports assets or executes code.
local Validator={}
function Validator.Validate(assets,root)
 if assets.Profile=="None" then return true end
 local template=root and root:FindFirstChild(assets.Key)
 local origin=template and template:FindFirstChild("Origin")
 if not template or not origin or not origin:IsA("Attachment") then return false,"MissingEffectOrigin" end
 local descendants=template:GetDescendants()
 if #descendants>500 then return false,"EffectTooLarge" end
 local visual=false
 for _,v in ipairs(descendants) do
  if v:IsA("LuaSourceContainer") or v:IsA("Explosion") then return false,"ExecutableOrUnsafeEffect" end
  if v:IsA("BasePart") and (not v.Anchored or v.CanCollide or v.CanTouch or v.CanQuery) then return false,"UnsafeEffectPart" end
  if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam") then visual=true end
  if v:IsA("Trail") or v:IsA("Beam") then
   if not v.Attachment0 or not v.Attachment1 or not v.Attachment0:IsDescendantOf(origin)
    or not v.Attachment1:IsDescendantOf(origin) then return false,"InvalidEffectAttachments" end
  end
 end
 if not visual then return false,"MissingVisualTrace" end
 for _,cue in pairs(assets.Cues or {}) do
  local resource=template:FindFirstChild(cue.Resource)
  if not resource or not resource:IsA("BasePart") then return false,"MissingCueResource" end
 end
 return true
end
return table.freeze(Validator)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="907">
        <Properties>
          <string name="Name">AbilityCallbacks</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Ability lifecycle callbacks must not yield. A suspended callback is cancelled
-- before it can resume against a different Character/round.
local Callbacks={}
function Callbacks.Call(callback,...)
 if type(callback)~="function" then return false,"MissingCallback" end
 local thread=coroutine.create(callback)
 local result=table.pack(coroutine.resume(thread,...))
 if coroutine.status(thread)~="dead" then
  if task and task.cancel then pcall(task.cancel,thread) end
  pcall(coroutine.close,thread)
  return false,"CallbackYielded"
 end
 if not result[1] then return false,tostring(result[2]) end
 return true,table.unpack(result,2,result.n)
end
function Callbacks.Runtime(core)
 return setmetatable({State="Active"},{
  __index=core,
  __newindex=function(t,key,value)
   assert(core[key]==nil,"ReadOnlyAbilityContext: "..tostring(key));rawset(t,key,value)
  end,
  __metatable="AbilityRuntime",
 })
end
return table.freeze(Callbacks)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="908">
        <Properties>
          <string name="Name">AbilityInputAdapter</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Reusable input capabilities, not ability identifiers.
local Adapter={}
function Adapter.Validate(profile,payload)
 if profile=="None" then return true,Vector3.zero end
 if profile~="Direction" then return false end
 local v=payload.Direction
 if typeof(v)~="Vector3" then return false end
 for _,number in {v.X,v.Y,v.Z} do
  if number~=number or math.abs(number)==math.huge then return false end
 end
 if v.Magnitude>1.1 then return false end
 return true,v
end
return table.freeze(Adapter)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="909">
