      <Item class="LocalScript" referent="4333">
        <Properties>
          <string name="Name">EndCinematicPreview</string>
          <string name="Source"><![CDATA[--!nonstrict
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Config = require(game.ReplicatedStorage.Shared.EndCinematicConfig)
if not RunService:IsStudio() or not Config.Preview.Enabled then return end
local player = Players.LocalPlayer
local controller = require(script.Parent.Controllers.EndCinematicController)
controller:Initialize()
local gui = Instance.new("ScreenGui")
gui.Name = "EndCinematicPreview"
gui.ResetOnSpawn = false
gui.DisplayOrder = 10001
gui.Parent = player:WaitForChild("PlayerGui")
local frame = Instance.new("Frame")
frame.Position = UDim2.new(0, 12, 0.28, 0)
frame.Size = UDim2.fromOffset(210, 344)
frame.BackgroundColor3 = Color3.fromRGB(15, 18, 30)
frame.Parent = gui
local layout = Instance.new("UIListLayout")
layout.Padding = UDim.new(0, 4)
layout.SortOrder = Enum.SortOrder.LayoutOrder
layout.Parent = frame
local nextButtonOrder=0
local function button(text, callback)
	local b = Instance.new("TextButton")
	b.Name = text:gsub("[^%w]+", "_")
	nextButtonOrder+=1
	b.LayoutOrder=nextButtonOrder
	b.Size = UDim2.new(1, 0, 0, 34)
	b.Text = text
	b.Font = Enum.Font.GothamBold
	b.TextSize = 13
	b.TextColor3 = Color3.new(1, 1, 1)
	b.BackgroundColor3 = Color3.fromRGB(37, 42, 65)
	b.Parent = frame
	b.Activated:Connect(callback)
	return b
end
local team = "Red"
local count = 1
local mode = "1v1"
local floatingEnabled,billboardsEnabled=true,true
local previewSerial = 0
local function cancel()
	previewSerial += 1
	controller:Stop()
end
local function play(n, selectedMode)
	mode = selectedMode or mode
	count = n
	cancel()
	local serial = previewSerial
	local remote = game.ReplicatedStorage.Remotes.Match:WaitForChild("EndCinematicPreview", 5)
	if not remote then warn("[EndCinematicPreview] Studio preview remote missing"); return end
	local success, descriptor = pcall(function() return remote:InvokeServer("Prepare") end)
	if not success or type(descriptor) ~= "table" then warn("[EndCinematicPreview] Scene denied or unavailable"); return end
	local released = false
	local function release()
		if released then return end
		released = true
		task.spawn(function() pcall(function() remote:InvokeServer("Release", descriptor.Name) end) end)
	end
	local deadline = os.clock() + Config.Results.SceneWaitTimeout
	task.spawn(function() pcall(function() player:RequestStreamAroundAsync(descriptor.Origin, Config.Results.SceneWaitTimeout) end) end)
	local scene
	repeat
		local folder = workspace:FindFirstChild("EndCinematicPreviews")
		scene = folder and folder:FindFirstChild(descriptor.Name)
		local cameras = scene and scene:FindFirstChild("TransCamera")
		local slots = scene and scene:FindFirstChild("Players")
		local complete = scene ~= nil and cameras ~= nil and slots ~= nil and scene:GetAttribute("PreviewOwnerUserId") == player.UserId
		for _, name in { "CameraCheck-v1", "CameraCheck-v2", "CameraCheck-Only1V1" } do
			complete = complete and cameras:FindFirstChild(name) ~= nil
		end
		for index = 1, 5 do complete = complete and slots:FindFirstChild("SlotPlayer_" .. index) ~= nil end
		if complete then break end
		scene = nil
		task.wait(.05)
	until serial ~= previewSerial or os.clock() >= deadline
	if serial ~= previewSerial or not scene or player:GetAttribute("MatchId") ~= nil then release(); return end
	local winners = {}
	local participants = {}
	local available = Players:GetPlayers()
	table.sort(available, function(a, b) return a.UserId < b.UserId end)
	for i = 1, n*2 do
		local candidate = available[i] or player
		-- Repeated local appearance is intentional demonstration data, not match results.
		local competitiveSlot=(i-1)%n+1
		local row={ UserId = i<=#available and candidate.UserId or -100000-i,
			AppearanceUserId=candidate.UserId,DisplayName=candidate.DisplayName..(i>#available and " · Demo "..i or ""),
			Username=candidate.Name,Team=i<=n and "Red" or "Blue",Slot=competitiveSlot,CompetitiveSlot=competitiveSlot,
			Goals=competitiveSlot==1 and (i<=n and 3 or 2) or (competitiveSlot==2 and (i<=n and 2 or 1) or 0),
			Kills=i%4,Deaths=i%3,Preview=true }
		table.insert(participants,row)
		if i<=n then table.insert(winners,row) end
	end
	local ok, reason = controller:Play({ MatchId = "PREVIEW_" .. tostring(os.clock()), Mode = mode, TeamSize = n, WinningTeam = "Red", Winners = winners, Participants=participants, LocalTeam = team, Score = { Red = 5, Blue = 3 }, EligibleParticipantCount = n * 2 }, { Scene = scene, OnStopped = release, FloatingEnabled=floatingEnabled, BillboardsEnabled=billboardsEnabled })
	if not ok then release(); warn("[EndCinematicPreview] " .. tostring(reason)) end
end
button("PREVIEW · 1v1", function() play(1, "1v1") end)
button("PREVIEW · 2v2", function() play(2, "2v2") end)
button("PREVIEW · 3v3", function() play(3, "3v3") end)
button("PREVIEW · 4v4", function() play(4, "4v4") end)
local toggle
toggle = button("VISTA: VICTORIA", function()
	team = team == "Red" and "Blue" or "Red"
	toggle.Text = team == "Red" and "VISTA: VICTORIA" or "VISTA: DERROTA"
end)
button("REINICIAR", function() play(count) end)
button("DETENER", cancel)
local floatingToggle
floatingToggle=button("FLOTACIÓN: ON",function()
	floatingEnabled=not floatingEnabled
	floatingToggle.Text="FLOTACIÓN: "..(floatingEnabled and "ON" or "OFF")
	controller:SetPreviewOptions(floatingEnabled,billboardsEnabled)
end)
local billboardToggle
billboardToggle=button("BILLBOARDS: ON",function()
	billboardsEnabled=not billboardsEnabled
	billboardToggle.Text="BILLBOARDS: "..(billboardsEnabled and "ON" or "OFF")
	controller:SetPreviewOptions(floatingEnabled,billboardsEnabled)
end)
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="4334">
        <Properties>
          <string name="Name">GroupPromptTrigger</string>
        </Properties>
        <Item class="LocalScript" referent="4335">
          <Properties>
            <string name="Name">AutomaticPrompt</string>
            <string name="Source">local GROUP_ID = 484233593
local GroupService = game:GetService("GroupService")

task.wait(10) -- how long the script waits after you join before prompting the join group.

local success, result = pcall(function()
	return GroupService:PromptJoinAsync(GROUP_ID)
end)</string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="4336">
          <Properties>
            <string name="Name">ChatCommand</string>
            <string name="Source"><![CDATA[local GROUP_ID = 484233593
local GroupService = game:GetService("GroupService")
local player = game.Players.LocalPlayer

player.Chatted:Connect(function(msg)
	if msg:lower() == "!joingroup" then 				-- Command to type in chat to show the join group prompt
		local success, result = pcall(function()
			return GroupService:PromptJoinAsync(GROUP_ID)
		end)
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="4337">
          <Properties>
            <string name="Name">PartTouch</string>
            <string name="Source"><![CDATA[local GROUP_ID = 484233593
local GroupService = game:GetService("GroupService")

local part = workspace:WaitForChild("TouchPart")
local player = game.Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()

local debounce = false

part.Touched:Connect(function(hit)
	if debounce then return end
	if hit.Parent == character then
		debounce = true
		local success, result = pcall(function()
			return GroupService:PromptJoinAsync(GROUP_ID)
		end)

		task.wait(3) -- touch cooldown here
		debounce = false
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="4338">
          <Properties>
            <string name="Name">ProximityPrompt</string>
            <string name="Source"><![CDATA[local GROUP_ID = 484233593
local GroupService = game:GetService("GroupService")

local prompt = workspace:WaitForChild("ProxPart"):WaitForChild("ProximityPrompt")  -- change path if needed

prompt.Triggered:Connect(function(player)
	if player ~= game.Players.LocalPlayer then return end

	local success, result = pcall(function()
		return GroupService:PromptJoinAsync(GROUP_ID)
	end)
end)
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="LocalScript" referent="4339">
        <Properties>
          <string name="Name">NametagPlatform</string>
          <string name="Source"><![CDATA[--!strict
local UIS=game:GetService('UserInputService')
local RS=game:GetService('ReplicatedStorage')
local shared=RS:WaitForChild('Shared',10)
local module=shared and shared:WaitForChild('NametagPresentation',10)
local remotes=RS:WaitForChild('Remotes',10)
local folder=remotes and remotes:WaitForChild('Nametag',10)
local report=folder and folder:WaitForChild('ReportPlatform',10)
if not module or not module:IsA('ModuleScript')or not report or not report:IsA('RemoteEvent')then
 warn('[NametagPlatform] Inicialización incompleta: revisar errores de Workspace.NametagService en el servidor.')
 return
end
local Presentation=require(module)
local version=0
local function send()
 version+=1;local current=version
 -- Coalesce fast input changes and remain below the cosmetic server rate limit.
 task.delay(2.1,function()
  if current==version then report:FireServer(Presentation.FromInput(UIS.PreferredInput.Name))end
 end)
end
UIS:GetPropertyChangedSignal('PreferredInput'):Connect(send)
send()
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="4340">
        <Properties>
          <string name="Name">PointCameraFX</string>
          <string name="Source"><![CDATA[--!strict
-- PointCameraFX (LocalScript, solo cliente)
-- Feedback de camara local cuando se anota un punto: sacudida, destellos de pantalla, bloom y golpe de FOV.
-- Escucha el RemoteEvent existente ReplicatedStorage.Remotes.Match.PointFeedback (no altera la logica de gameplay).
-- La intensidad cae con la distancia entre la camara y la ScoringZone, asi que solo se nota en quien esta en la partida.
-- Accesibilidad: si el jugador tiene el atributo "ReduceScreenEffects" = true, los efectos se atenuan mucho.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")

local CONFIG = {
	FullPowerDistance = 40,   -- studs: a esta distancia o menos, intensidad completa
	MaxDistance = 260,        -- studs: mas lejos que esto no se aplica nada
	ShakeTrauma = 0.9,        -- 0..1 por punto normal
	ShakeTraumaFinal = 1.0,
	ShakeDecay = 1.6,         -- trauma perdido por segundo
	ShakeMoveStuds = 1.1,
	ShakeRollDegrees = 4,
	FlashStrength = 0.6,      -- opacidad maxima del destello blanco (0..1)
	FlashFinalBoost = 1.15,
	FovKick = 12,             -- grados extra de FOV
	BloomPeak = 1.6,
	ReducedScale = 0.25,
}

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera :: Camera

local function effectScale(): number
	if player:GetAttribute("ReduceScreenEffects") == true then
		return CONFIG.ReducedScale
	end
	return 1
end

-- UI de destello
local gui = Instance.new("ScreenGui")
gui.Name = "PointCameraFX"
gui.IgnoreGuiInset = true
gui.ResetOnSpawn = false
gui.DisplayOrder = 1000
gui.Parent = player:WaitForChild("PlayerGui")

local flashFrame = Instance.new("Frame")
flashFrame.Name = "Flash"
flashFrame.Size = UDim2.fromScale(1, 1)
flashFrame.BackgroundColor3 = Color3.new(1, 1, 1)
flashFrame.BackgroundTransparency = 1
flashFrame.BorderSizePixel = 0
flashFrame.Active = false
flashFrame.Parent = gui

-- Efectos de iluminacion locales (no se replican)
local bloom = Instance.new("BloomEffect")
bloom.Name = "PointFX_Bloom"
bloom.Intensity = 0
bloom.Size = 36
bloom.Threshold = 1.2
bloom.Parent = Lighting

local color = Instance.new("ColorCorrectionEffect")
color.Name = "PointFX_Color"
color.Brightness = 0
color.Contrast = 0
color.Parent = Lighting

local flashTween: Tween? = nil
local function pulse(tint: Color3, strength: number, fadeTime: number)
	if flashTween then flashTween:Cancel() end
	flashFrame.BackgroundColor3 = tint
	flashFrame.BackgroundTransparency = 1 - math.clamp(strength, 0, 1)
	local tw = TweenService:Create(flashFrame, TweenInfo.new(fadeTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundTransparency = 1 })
	flashTween = tw
	tw:Play()
end

-- Sacudida de camara (modelo de "trauma")
local trauma = 0
local seed = math.random() * 100
RunService:BindToRenderStep("PointCameraFX", Enum.RenderPriority.Camera.Value + 1, function(dt: number)
	if player:GetAttribute("ResultsSessionId") ~= nil and player:GetAttribute("FinalGoalSessionId") == nil then trauma = 0; return end
	if trauma <= 0 then return end
	trauma = math.max(0, trauma - dt * CONFIG.ShakeDecay)
	local shake = trauma * trauma
	local t = os.clock() * 28
	local nx = math.noise(seed, t, 0) * 2
	local ny = math.noise(seed, t, 10) * 2
	local nr = math.noise(seed, t, 20) * 2
	local cam = workspace.CurrentCamera
	if cam then
		local move = CONFIG.ShakeMoveStuds * shake
		local roll = math.rad(CONFIG.ShakeRollDegrees) * shake
		cam.CFrame = cam.CFrame * CFrame.new(nx * move, ny * move, 0) * CFrame.Angles(0, 0, nr * roll)
	end
end)

-- Golpe de FOV
local fovBase: number? = nil
local function fovKick(amount: number)
	local sourceSessionId = player:GetAttribute("MatchId")
	local cam = workspace.CurrentCamera
	if not cam then return end
	if fovBase == nil then fovBase = cam.FieldOfView end
	local base = fovBase :: number
	TweenService:Create(cam, TweenInfo.new(0.06, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { FieldOfView = base + amount }):Play()
	task.delay(0.07, function()
		if player:GetAttribute("MatchId") ~= sourceSessionId or (player:GetAttribute("ResultsSessionId") ~= nil and player:GetAttribute("FinalGoalSessionId") ~= sourceSessionId) then
			if fovBase then cam.FieldOfView = fovBase; fovBase = nil end
			return
		end
		local c = workspace.CurrentCamera
		if not c then return end
		local back = TweenService:Create(c, TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { FieldOfView = base })
		back.Completed:Once(function() fovBase = nil end)
		back:Play()
	end)
end

local function distanceFactor(pos: Vector3): number
	local cam = workspace.CurrentCamera
	if not cam then return 0 end
	local d = (cam.CFrame.Position - pos).Magnitude
	if d <= CONFIG.FullPowerDistance then return 1 end
	return math.clamp(1 - (d - CONFIG.FullPowerDistance) / (CONFIG.MaxDistance - CONFIG.FullPowerDistance), 0, 1)
end

local function onPoint(data: any)
	if typeof(data) ~= "table" then return end
	local sessionId = data.SessionId or data.MatchId
	if type(sessionId) ~= "string" or player:GetAttribute("MatchId") ~= sessionId then return end
	local function allowed()
		return player:GetAttribute("MatchId") == sessionId and (player:GetAttribute("ResultsSessionId") == nil
			or (data.VisualOnly == true and player:GetAttribute("FinalGoalSessionId") == sessionId))
	end
	if not allowed() then return end
	local pos = data.ScoringZonePosition
	if typeof(pos) ~= "Vector3" then return end

	local factor = distanceFactor(pos) * effectScale()
	if factor < 0.04 then return end
	local isFinal = data.IsFinalPoint == true

	-- Sacudida
	trauma = math.min(1, trauma + (if isFinal then CONFIG.ShakeTraumaFinal else CONFIG.ShakeTrauma) * factor)

	-- Destello 1 (blanco, fuerte) y destello 2 (calido, mas suave): solo 2 pulsos de pantalla completa
	local strength = CONFIG.FlashStrength * factor * (if isFinal then CONFIG.FlashFinalBoost else 1)
	pulse(Color3.new(1, 1, 1), strength, 0.34)
	task.delay(0.2, function()
		if not allowed() then return end
		pulse(Color3.fromRGB(255, 232, 160), strength * 0.55, 0.45)
	end)

	-- Bloom + contraste
	bloom.Intensity = CONFIG.BloomPeak * factor
	color.Brightness = 0.16 * factor
	color.Contrast = 0.35 * factor
	local info = TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(bloom, info, { Intensity = 0 }):Play()
	TweenService:Create(color, info, { Brightness = 0, Contrast = 0 }):Play()

	-- FOV
	fovKick(CONFIG.FovKick * factor)
end

local remotes = ReplicatedStorage:WaitForChild("Remotes")
local matchFolder = remotes:WaitForChild("Match")
local pointFeedback = matchFolder:WaitForChild("PointFeedback") :: RemoteEvent
pointFeedback.OnClientEvent:Connect(onPoint)
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="4341">
        <Properties>
          <string name="Name">PremiumShop</string>
        </Properties>
        <Item class="ModuleScript" referent="4342">
          <Properties>
            <string name="Name">PremiumPurchaseFlow</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Personal price is queried on the client, never SuggestedRobux or a shared server cache.
local Flow={};Flow.__index=Flow
function Flow.new(marketplace,player,request,changed,clock,reserved)
 return setmetatable({Marketplace=marketplace,Player=player,Request=request,Changed=changed,Clock=clock or os.clock,State="Unavailable",Seen={},Sequence=0,Reserved=reserved or {}},Flow)
end
function Flow:Set(state,extra)self.State=state;self.Changed(state,extra)end
function Flow:Price(product)
 if product.IsPlaceholder~=false or not product.ProductId or self.Reserved[product.ProductId]or not product.CommercialVerified then return nil,"PlaceholderProduct"end
 local ok,info=pcall(self.Marketplace.GetProductInfoAsync,self.Marketplace,product.ProductId,Enum.InfoType.Product)
 local price=ok and type(info)=="table"and info.PriceInRobux
 if type(price)~="number"or price~=price or price<1 or price==math.huge or info.IsForSale~=true then return nil,"PriceUnavailable"end
 return price
end
function Flow:Begin(product)
 if self.Pending or self.Busy then return false,"PurchaseInProgress"end
 self.Sequence+=1;local seq=self.Sequence;self.Busy=true;self:Set("Processing")
 local function fail(state,why)if seq==self.Sequence then self.Busy=false;self:Set(state,why)end;return false,why end
 local price,why=self:Price(product)
 if seq~=self.Sequence then return false,"Cancelled"end
 if not price then return fail("TemporaryError",why)end
 if product.PriceRobux~=nil and product.PriceRobux~=price then product.PriceRobux=price;return fail("TemporaryError","PriceChanged")end
 local requested,result=pcall(self.Request,"Purchase",{Id=product.Id,QuoteTokens=product.QuoteTokens})
 if seq~=self.Sequence then return false,"Cancelled"end
 if not requested or type(result)~="table"then return fail("TemporaryError","RequestUnavailable")end
 if not result.Ok or result.ProductId~=product.ProductId or result.PromptAllowed~=true then return fail("Restricted",result.Code)end
 -- Requery immediately before the prompt. No price supplied by the client controls fulfillment.
 local latest=self:Price(product);if seq~=self.Sequence then return false,"Cancelled"end
 if latest~=price then return fail("TemporaryError","PriceChanged")end
 self.Pending={ProductKey=product.Id,ProductId=result.ProductId,Since=self.Clock(),Known=result.KnownReceipts or {}};self:Set("Purchasing",price)
 local ok=pcall(self.Marketplace.PromptProductPurchase,self.Marketplace,self.Player,result.ProductId)
 self.Busy=false
 if not ok then self.Pending=nil;return fail("TemporaryError","PromptUnavailable")end
 return true
end
function Flow:PromptClosed(userId,productId,purchased)
 if userId~=self.Player.UserId or not self.Pending or self.Pending.ProductId~=productId then return end
 -- Never grant/announce success here. Status endpoint/receipt event is authoritative.
 if purchased then self:Set("AwaitingConfirmation")else self.Pending=nil;self:Set("Available")end
end
function Flow:Delivery(receipt)
 if type(receipt)~="table"or receipt.State~="Applied"or type(receipt.PurchaseId)~="string"or self.Seen[receipt.PurchaseId]then return false end
 self.Seen[receipt.PurchaseId]=true
 if self.Pending and self.Pending.ProductId==receipt.ProductId then self.Pending=nil end
 self:Set("Credited",receipt.ProductKey);return true
end
function Flow:CancelAuthorization()if not self.Pending then self.Sequence+=1;self.Busy=false end end
function Flow:Status(receipts)
 for _,r in ipairs(receipts)do
  if self.Pending and self.Pending.ProductId==r.ProductId and not self.Pending.Known[r.PurchaseId]then self:Delivery(r)
  elseif not self.Pending then self.Seen[r.PurchaseId]=true end
 end
end
return Flow
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="4343">
        <Properties>
          <string name="Name">Social</string>
        </Properties>
        <Item class="ModuleScript" referent="4344">
          <Properties>
            <string name="Name">Targeting</string>
            <string name="Source"><![CDATA[--!nonstrict
local Targeting={}
function Targeting.Valid(localPlayer,target,maxDistance)
 if not target or target==localPlayer or not target.Parent or target.Parent~=localPlayer.Parent or localPlayer:GetAttribute('MatchId')or target:GetAttribute('MatchId')then return false end
 local a=localPlayer.Character;local b=target.Character
 local x=a and a:FindFirstChild('HumanoidRootPart');local y=b and b:FindFirstChild('HumanoidRootPart')
 local h=b and b:FindFirstChildOfClass('Humanoid')
 local ownHumanoid=a and a:FindFirstChildOfClass('Humanoid')
 return x~=nil and y~=nil and h~=nil and h.Health>0 and ownHumanoid~=nil and ownHumanoid.Health>0 and (x.Position-y.Position).Magnitude<=maxDistance
end
-- Exclude whole avatars: a torso/back Slap must not hide its own profile prompt.
-- Both the viewer's body and camera must have an unobstructed path to the target.
function Targeting.Visible(world,localPlayer,target,cameraPosition)
 local a,b=localPlayer.Character,target and target.Character
 local origin=a and a:FindFirstChild('HumanoidRootPart')
 local root=b and b:FindFirstChild('HumanoidRootPart')
 if not origin or not root or not cameraPosition then return false end
 local head=b:FindFirstChild('Head') or root
 local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude
 params.FilterDescendantsInstances={a,b};params.RespectCanCollide=true
 local function clear(from,to)
  local delta=to-from
  return delta.Magnitude<0.001 or world:Raycast(from,delta,params)==nil
 end
 return clear(origin.Position,root.Position) and clear(cameraPosition,head.Position)
end
function Targeting.Select(localPlayer,players,aimed,maxDistance,visible)
 if Targeting.Valid(localPlayer,aimed,maxDistance) and visible(aimed) then return aimed end
 local candidates={}
 local root=localPlayer.Character and localPlayer.Character:FindFirstChild('HumanoidRootPart')
 if not root then return nil end
 for _,target in ipairs(players) do
  if Targeting.Valid(localPlayer,target,maxDistance) then
   table.insert(candidates,{Player=target,Distance=(root.Position-target.Character:FindFirstChild('HumanoidRootPart').Position).Magnitude})
  end
 end
 table.sort(candidates,function(a,b)
  if a.Distance==b.Distance then return a.Player.UserId<b.Player.UserId end
  return a.Distance<b.Distance
 end)
 for _,candidate in ipairs(candidates) do if visible(candidate.Player) then return candidate.Player end end
 return nil
end
function Targeting.FromHit(players,hit)
 local current=hit
 while current and current~=workspace do
  if current:IsA('Model')then local player=players:GetPlayerFromCharacter(current);if player then return player end end
  current=current.Parent
 end
 return nil
end
return Targeting
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="4345">
          <Properties>
            <string name="Name">ViewportPool</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Bounded visual clones exclusively inside ViewportFrames; no workspace or input ownership.
local RS=game:GetService('ReplicatedStorage')
local Players=game:GetService('Players')
local Appearance=require(RS.Shared.SlapCrates.Appearance)
local Pool={};Pool.__index=Pool
function Pool.new(maximum)return setmetatable({Rows={},Count=0,Maximum=maximum},Pool)end
function Pool:Remove(view)
 local row=self.Rows[view];if not row then return end
 self.Rows[view]=nil;self.Count-=1
 for _,connection in ipairs(row.Connections)do connection:Disconnect()end
 view.CurrentCamera=nil;row.World:Destroy();row.Camera:Destroy()
end
function Pool:Clear()local keys={};for view in pairs(self.Rows)do table.insert(keys,view)end;for _,view in ipairs(keys)do self:Remove(view)end end
local function clean(model)
 for _,p in ipairs(model:GetDescendants())do
  if p:IsA('LuaSourceContainer')or p:IsA('Tool')or p:IsA('Sound')then p:Destroy()
  elseif p:IsA('BasePart')then p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false
  elseif p:IsA('ParticleEmitter')then p.Enabled=false -- Viewport preview uses authored tint plus UI aura; no workspace emitters.
  end
 end
end
function Pool:Add(view,source,avatar)
 if self.Rows[view]then return true end
 if self.Count>=self.Maximum or not source or not view.Parent then return false end
 local model
 if avatar then
  local char=source.Character;if not char then return false end
  local humanoid=char:FindFirstChildOfClass('Humanoid');if not humanoid then return false end
  -- Clone the existing visual character; no web lookup, no temporary models in Workspace.
  local original=char.Archivable;char.Archivable=true
  local ok,result=pcall(char.Clone,char);char.Archivable=original
  if not ok or not result then return false end;model=result
 else model=source:Clone()end
 if not model:IsA('Model')then model:Destroy();return false end
 clean(model)
 local world=Instance.new('WorldModel');world.Name='SocialPreviewWorld';world.Parent=view
 local camera=Instance.new('Camera');camera.Name='SocialPreviewCamera';camera.FieldOfView=35;camera.Parent=view
 model.Parent=world
 if avatar then model:PivotTo(CFrame.new())end -- Neutral forward orientation; camera looks at the avatar's front.
 local box,size=model:GetBoundingBox();model:PivotTo(CFrame.new(-box.Position)*model:GetPivot())
 local row={World=world,Camera=camera,Model=model,Avatar=avatar,Base=model:GetPivot(),Size=size,Angle=0,Connections={}}
 local function fit()
  if not view.Parent then return end
  local aspect=math.max(0.2,view.AbsoluteSize.X/math.max(1,view.AbsoluteSize.Y))
  local radius=math.max(0.5,size.Magnitude/2)
  local half=math.atan(math.tan(math.rad(camera.FieldOfView/2))*math.min(1,aspect))
  local distance=radius/math.sin(half)*1.12
  camera.CFrame=CFrame.lookAt(Vector3.new(0,0,avatar and -distance or distance),Vector3.zero)
 end
 table.insert(row.Connections,view:GetPropertyChangedSignal('AbsoluteSize'):Connect(fit))
 table.insert(row.Connections,view.Destroying:Connect(function()self:Remove(view)end))
 self.Rows[view]=row;self.Count+=1;view.CurrentCamera=camera;fit();return true
end
function Pool:Slap(view,item)
 local roots=RS:FindFirstChild('SlapVariationPreviews');local base=roots and roots:FindFirstChild(item.SlapId)
 local source=base and base:FindFirstChild(item.VariationId)
 if not source then local fallback=RS:FindFirstChild('CrateRewardPreviews');source=fallback and fallback:FindFirstChild(item.SlapId)end
 if not self:Add(view,source,false)then return false end
 local row=self.Rows[view];local part=row.Model:FindFirstChildWhichIsA('BasePart',true)
 local effects=RS:FindFirstChild('SlapVariationEffects');local profile=effects and effects:FindFirstChild(item.VariationId)
 if part then Appearance.Apply(part,profile);clean(row.Model)end
 return true
end
function Pool:Step(dt)
 for view,row in pairs(self.Rows)do
  if view.Parent then
   row.Angle+=dt*(row.Avatar and 0.08 or 0.45)
   row.Model:PivotTo(CFrame.Angles(0,row.Angle,0)*row.Base)
  end
 end
end
return Pool
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="4346">
        <Properties>
          <string name="Name">UI</string>
        </Properties>
        <Item class="LocalScript" referent="4347">
          <Properties>
            <string name="Name">CoinCardsTiltEffect</string>
            <string name="Source"><![CDATA[--!strict
-- CoinCardsTiltEffect
-- Efecto 3D de inclinación interactiva al pasar el ratón (Smooth 3D Tilt & Parallax)
-- para las tarjetas de la Tienda Premium. 100% nativo y compatible con CanvasGroup.

local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local container = script.Parent :: GuiObject
if not container then return end

local MAX_TILT_DEG = 3.5 -- Grados máximos de rotación
local PARALLAX_OFFSET = 6 -- Píxeles de desplazamiento hacia el cursor (sensación de elevación)
local HOVER_SCALE = 1.04 -- Escala al pasar el ratón por encima
local LERP_SPEED = 14 -- Velocidad de suavizado

type CardState = {
	card: GuiObject,
	origPos: UDim2,
	origZIndex: number,
	scaleObj: UIScale,
	isHovered: boolean,
	currentRot: number,
	currentX: number,
	currentY: number,
	currentScale: number,
	targetRot: number,
	targetX: number,
	targetY: number,
	targetScale: number,
	reflejo: ImageLabel?,
	origReflejoPos: UDim2?,
}

local cardStates: { CardState } = {}

for _, child in ipairs(container:GetChildren()) do
	if child.Name == "Paquete de monedas" and child:IsA("GuiObject") then
		local origPos = child.Position
		local origZIndex = child.ZIndex

		-- Asegurar UIScale para elevación limpia
		local scaleObj = child:FindFirstChild("TiltScale") :: UIScale?
		if not scaleObj then
			scaleObj = Instance.new("UIScale")
			scaleObj.Name = "TiltScale"
			scaleObj.Scale = 1
			scaleObj.Parent = child
		end

		local reflejo = child:FindFirstChild("Reflejo angular", true) :: ImageLabel?
		local origReflejoPos = reflejo and reflejo.Position or nil

		local state: CardState = {
			card = child,
			origPos = origPos,
			origZIndex = origZIndex,
			scaleObj = scaleObj,
			isHovered = false,
			currentRot = 0,
			currentX = 0,
			currentY = 0,
			currentScale = 1,
			targetRot = 0,
			targetX = 0,
			targetY = 0,
			targetScale = 1,
			reflejo = reflejo,
			origReflejoPos = origReflejoPos,
		}

		child.MouseEnter:Connect(function()
			state.isHovered = true
			state.targetScale = HOVER_SCALE
			child.ZIndex = origZIndex + 20
		end)

		child.MouseLeave:Connect(function()
			state.isHovered = false
			state.targetRot = 0
			state.targetX = 0
			state.targetY = 0
			state.targetScale = 1
			child.ZIndex = origZIndex
		end)

		table.insert(cardStates, state)
	end
end

-- Bucle de interpolación suave (RenderStepped)
RunService.RenderStepped:Connect(function(dt: number)
	local mousePos = UserInputService:GetMouseLocation() - GuiService:GetGuiInset()
	local factor = math.clamp(dt * LERP_SPEED, 0, 1)

	for _, state in ipairs(cardStates) do
		local card = state.card
		if not card.Parent then continue end

		if state.isHovered then
			local absPos = card.AbsolutePosition
			local absSize = card.AbsoluteSize
			if absSize.X > 0 and absSize.Y > 0 then
				local center = absPos + (absSize * 0.5)
				local nx = math.clamp((mousePos.X - center.X) / (absSize.X * 0.5), -1, 1)
				local ny = math.clamp((mousePos.Y - center.Y) / (absSize.Y * 0.5), -1, 1)

				state.targetRot = nx * MAX_TILT_DEG
				state.targetX = nx * PARALLAX_OFFSET
				state.targetY = ny * PARALLAX_OFFSET
			end
		end

		-- Suavizado lerp
		state.currentRot += (state.targetRot - state.currentRot) * factor
		state.currentX += (state.targetX - state.currentX) * factor
		state.currentY += (state.targetY - state.currentY) * factor
		state.currentScale += (state.targetScale - state.currentScale) * factor

		-- Aplicar transformaciones
		card.Rotation = state.currentRot
		card.Position = UDim2.new(
			state.origPos.X.Scale,
			state.origPos.X.Offset + state.currentX,
			state.origPos.Y.Scale,
			state.origPos.Y.Offset + state.currentY
		)
		state.scaleObj.Scale = state.currentScale

		-- Efecto de reflejo de luz (brillo que acompaña el ángulo de inclinación)
		if state.reflejo and state.origReflejoPos then
			state.reflejo.Position = UDim2.new(
				state.origReflejoPos.X.Scale,
				state.origReflejoPos.X.Offset - (state.currentX * 1.5),
				state.origReflejoPos.Y.Scale,
				state.origReflejoPos.Y.Offset - (state.currentY * 1.5)
			)
		end
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="4348">
          <Properties>
            <string name="Name">InventoryView</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Editable Studio UI; Build is also a fallback for fresh Rojo installs.
local View={}
local C=Color3.fromRGB
local icons={Slaps='rbxassetid://134866490325088',DeathEffects='rbxassetid://84058950298471',PointEffects='rbxassetid://123068502871010',Crates='rbxassetid://88695662177399'}
local function make(class,name,parent,props)
 local x=Instance.new(class);x.Name=name;for k,v in pairs(props or {})do x[k]=v end;x.Parent=parent;return x
end
local function round(p,r)make('UICorner','Corner',p,{CornerRadius=UDim.new(0,r or 12)})end
local function stroke(p,c,w,a)return make('UIStroke','Stroke',p,{Color=c,Thickness=w or 1,Transparency=a or 0,ApplyStrokeMode=Enum.ApplyStrokeMode.Border})end
local function frame(name,p,pos,size,color,alpha)
 return make('Frame',name,p,{Position=pos,Size=size,BackgroundColor3=color or C(17,26,32),BackgroundTransparency=alpha or 0,BorderSizePixel=0})
end
local function label(name,p,t,pos,size,sz,col)
 return make('TextLabel',name,p,{Text=t,Position=pos,Size=size,BackgroundTransparency=1,TextColor3=col or C(238,246,244),TextSize=sz or 16,Font=Enum.Font.GothamBold,TextWrapped=true})
end
local function button(name,p,t,pos,size)
 local b=make('TextButton',name,p,{Text=t,Position=pos,Size=size,BackgroundColor3=C(41,217,82),TextColor3=C(255,255,255),TextSize=18,Font=Enum.Font.GothamBold,BorderSizePixel=0,AutoButtonColor=false})
 round(b,10);stroke(b,C(114,255,146),1,.25)
 make('UIGradient','Gloss',b,{Color=ColorSequence.new(C(255,255,255),C(185,222,195)),Rotation=90})
 return b
end
local function image(name,p,id,pos,size)
 return make('ImageLabel',name,p,{Image=id,Position=pos,Size=size,BackgroundTransparency=1,ScaleType=Enum.ScaleType.Fit})
end
local function preview(name,p,pos,size)
 return make('ViewportFrame',name,p,{Position=pos,Size=size,BackgroundTransparency=1,Ambient=C(210,215,230),LightColor=C(255,247,228),LightDirection=Vector3.new(-1,-1,-1)})
end
function View.Build(parent)
 if parent:FindFirstChild('InventoryHUD')then return parent.InventoryHUD end
 local hud=make('ScreenGui','InventoryHUD',parent,{Enabled=false,ResetOnSpawn=false,IgnoreGuiInset=false,DisplayOrder=65,ZIndexBehavior=Enum.ZIndexBehavior.Sibling})
 frame('Dim',hud,UDim2.fromScale(0,0),UDim2.fromScale(1,1),C(1,8,13),.38)
 local m=frame('MainFrame',hud,UDim2.fromScale(.5,.51),UDim2.fromScale(.91,.88),C(22,29,39),.04);m.AnchorPoint=Vector2.new(.5,.5)
 round(m,16);stroke(m,C(124,150,160),1,.25)
 make('UISizeConstraint','Bounds',m,{MaxSize=Vector2.new(1280,860),MinSize=Vector2.zero})
 make('UIScale','OpenScale',m,{Scale=1})
 make('UIGradient','Atmosphere',m,{Color=ColorSequence.new(C(209,225,241),C(74,89,103)),Rotation=35})
 local tabs=frame('Tabs',m,UDim2.fromOffset(0,0),UDim2.new(0,112,1,0),C(15,24,33),.08);round(tabs,14)
 local names={Slaps='SLAPS',DeathEffects='KILL EFFECT',PointEffects='POINT EFFECT',Crates='CAJAS'}
 for i,key in ipairs({'Slaps','DeathEffects','PointEffects','Crates'})do
  local b=button(key,tabs,'',UDim2.new(0,8,0,16+(i-1)*112),UDim2.new(1,-16,0,100));b.BackgroundColor3=C(28,43,53)
  image('Icon',b,icons[key],UDim2.fromScale(.2,.07),UDim2.fromScale(.6,.57))
  label('Label',b,names[key],UDim2.fromScale(.03,.68),UDim2.fromScale(.94,.26),12)
 end
 local head=frame('Header',m,UDim2.fromOffset(130,12),UDim2.new(1,-146,0,54),nil,1)
 local title=label('Title',head,'INVENTARIO',UDim2.fromOffset(0,0),UDim2.fromOffset(185,24),20);title.TextXAlignment=Enum.TextXAlignment.Left
 local sub=label('Subtitle',head,'TUS OBJETOS · TU ESTILO',UDim2.fromOffset(0,28),UDim2.fromOffset(185,18),10,C(152,177,183));sub.TextXAlignment=Enum.TextXAlignment.Left
 local search=make('TextBox','Search',head,{Position=UDim2.fromOffset(196,3),Size=UDim2.new(1,-254,0,44),BackgroundColor3=C(9,17,21),BackgroundTransparency=.1,BorderSizePixel=0,Text='',PlaceholderText='Buscar en tu inventario…',TextColor3=C(244,250,247),PlaceholderColor3=C(150,170,173),TextSize=16,Font=Enum.Font.Gotham,TextXAlignment=Enum.TextXAlignment.Left,ClearTextOnFocus=false})
 round(search,22);stroke(search,C(91,117,122),1,.3);make('UIPadding','Padding',search,{PaddingLeft=UDim.new(0,18),PaddingRight=UDim.new(0,18)})
 local close=button('Close',head,'×',UDim2.new(1,-44,0,3),UDim2.fromOffset(44,44));close.BackgroundColor3=C(249,65,91);close.TextSize=32
 local content=frame('Content',m,UDim2.fromOffset(130,80),UDim2.new(1,-146,1,-96),nil,1)
 local grid=make('ScrollingFrame','Grid',content,{Size=UDim2.new(.67,-14,1,-108),BackgroundTransparency=1,BorderSizePixel=0,ScrollBarThickness=3,ScrollBarImageColor3=C(82,214,125),CanvasSize=UDim2.new(),AutomaticCanvasSize=Enum.AutomaticSize.Y})
 make('UIGridLayout','Layout',grid,{CellSize=UDim2.new(1/3,-9,0,180),CellPadding=UDim2.fromOffset(10,12),SortOrder=Enum.SortOrder.LayoutOrder})
 make('UIPadding','Padding',grid,{PaddingLeft=UDim.new(0,3),PaddingTop=UDim.new(0,3),PaddingBottom=UDim.new(0,5)})
 local empty=label('Empty',content,'Cargando inventario…',UDim2.fromScale(.03,.18),UDim2.fromScale(.6,.32),20,C(208,223,224))
 local footer=frame('Footer',content,UDim2.new(0,0,1,-100),UDim2.new(.67,-14,0,100),nil,1)
 local prev=button('Previous',footer,'‹',UDim2.fromOffset(0,0),UDim2.fromOffset(34,30));prev.BackgroundColor3=C(47,65,71)
 label('Page',footer,'1 / 1',UDim2.new(.5,-55,0,0),UDim2.fromOffset(110,30),12,C(178,200,203))
 local nextButton=button('Next',footer,'›',UDim2.new(1,-34,0,0),UDim2.fromOffset(34,30));nextButton.BackgroundColor3=C(47,65,71)
 local more=button('More',footer,'VER MIS CAJAS',UDim2.new(.5,-100,0,40),UDim2.fromOffset(200,38));more.TextSize=14
 label('Status',footer,'',UDim2.new(0,0,0,80),UDim2.new(1,0,0,20),11,C(180,207,204))
 local detail=frame('Detail',content,UDim2.fromScale(.67,0),UDim2.fromScale(.33,1),C(6,15,19),.12);round(detail,14);stroke(detail,C(66,91,94),1,.5)
 label('Title',detail,'Seleccioná un objeto',UDim2.fromScale(.06,.025),UDim2.fromScale(.88,.1),22)
 local aura=frame('Aura',detail,UDim2.fromScale(.05,.15),UDim2.fromScale(.9,.39),C(25,124,61),.55);round(aura,28)
 make('UIGradient','Fade',aura,{Rotation=90,Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,.8),NumberSequenceKeypoint.new(.5,.15),NumberSequenceKeypoint.new(1,.95)})})
 preview('Preview',detail,UDim2.fromScale(.05,.13),UDim2.fromScale(.9,.43))
 image('Icon',detail,'',UDim2.fromScale(.2,.2),UDim2.fromScale(.6,.3))
 label('Rarity',detail,'',UDim2.fromScale(.06,.57),UDim2.fromScale(.88,.07),22,C(78,244,101))
 label('Quantity',detail,'',UDim2.fromScale(.06,.65),UDim2.fromScale(.88,.05),14,C(209,223,223))
 label('Description',detail,'Elegí una categoría para ver lo que tenés.',UDim2.fromScale(.07,.72),UDim2.fromScale(.86,.1),13,C(163,190,191))
 local action=button('Action',detail,'EQUIPAR',UDim2.fromScale(.065,.86),UDim2.fromScale(.87,.1));action.Active=false
 local card=button('CardTemplate',hud,'',UDim2.new(),UDim2.fromOffset(170,180));card.Visible=false;card.BackgroundColor3=C(15,22,28);card.Stroke.Color=C(64,85,89);card.Gloss:Destroy()
 local ca=frame('Aura',card,UDim2.fromScale(.03,.03),UDim2.fromScale(.94,.78),C(24,122,57),.4);round(ca,13)
 make('UIGradient','Fade',ca,{Rotation=90,Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,.9),NumberSequenceKeypoint.new(.5,.1),NumberSequenceKeypoint.new(1,1)})})
 preview('Preview',card,UDim2.fromScale(.03,.02),UDim2.fromScale(.94,.74))
 image('Icon',card,'',UDim2.fromScale(.23,.15),UDim2.fromScale(.54,.48))
 label('ItemName',card,'Objeto',UDim2.fromScale(.04,.76),UDim2.fromScale(.92,.2),14,C(86,246,113))
 local check=label('Equipped',card,'✓',UDim2.fromOffset(7,7),UDim2.fromOffset(25,25),21);check.BackgroundTransparency=0;check.BackgroundColor3=C(24,216,70);round(check,20);check.Visible=false
 local count=label('Count',card,'',UDim2.new(1,-53,0,9),UDim2.fromOffset(45,20),12);count.TextXAlignment=Enum.TextXAlignment.Right
 return hud
end
function View.Button(parent)
 if parent:FindFirstChild('InventoryButton')then return parent.InventoryButton end
 local b=button('InventoryButton',parent,'',UDim2.fromScale(.041,.67),UDim2.fromScale(.062,.104));b.AnchorPoint=Vector2.new(.5,.5);b.BackgroundColor3=C(32,73,69)
 image('IconImage',b,icons.Crates,UDim2.fromScale(.12,.02),UDim2.fromScale(.76,.68))
 local t=label('TextLabel',b,'INVENTARIO',UDim2.fromScale(.01,.64),UDim2.fromScale(.98,.32),11);t.TextScaled=true
 make('UITextSizeConstraint','Bounds',t,{MaxTextSize=12,MinTextSize=8})
 make('UISizeConstraint','Bounds',b,{MinSize=Vector2.new(54,58),MaxSize=Vector2.new(100,104)})
 return b
end
View.Icons=icons
return View
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="4349">
          <Properties>
            <string name="Name">ShopLayout</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Shared Edit/runtime layout. No commerce, networking or gameplay side effects.
local Layout = {}
local function rect(o,x,y,w,h)
 if not o then return end
 o.AnchorPoint=Vector2.zero;o.Position=UDim2.fromOffset(x,y);o.Size=UDim2.fromOffset(w,h)
end
local function text(o,size)
 if o and (o:IsA("TextLabel") or o:IsA("TextButton")) then
  o.TextScaled=false;o.TextSize=size;o.TextWrapped=true
 end
end
function Layout.Card(card)
 local preview=card:FindFirstChild("Preview")
 if preview then preview.Position=UDim2.fromOffset(8,8);preview.Size=UDim2.new(1,-16,0,112);preview.ClipsDescendants=true end
 local name=card:FindFirstChild("NameLabel")
 if name then name.Position=UDim2.fromOffset(10,126);name.Size=UDim2.new(1,-20,0,30);text(name,18) end
 local rarity=card:FindFirstChild("RarityLabel")
 if rarity then rarity.Position=UDim2.fromOffset(10,158);rarity.Size=UDim2.new(1,-20,0,20);text(rarity,13) end
 local price=card:FindFirstChild("PriceLabel")
 if price then price.AnchorPoint=Vector2.zero;price.Position=UDim2.new(0,10,1,-40);price.Size=UDim2.new(1,-20,0,30);text(price,18) end
 if card:IsA("TextButton") then card.Text="" end
 for _,o in card:GetChildren() do
  if o:IsA("GuiObject") and (o.Name=="CrateActions" or o.Name=="CoinIcon") then o.Visible=false end
 end
end
function Layout.Prepare(hud)
 local main=hud.MainFrame;local body=main.Body
 local host=body:FindFirstChild("DetailHost")
 if not host then
  host=Instance.new("ScrollingFrame");host.Name="DetailHost";host.BackgroundTransparency=1;host.BorderSizePixel=0
  host.ScrollBarThickness=4;host.ScrollingDirection=Enum.ScrollingDirection.Y;host.CanvasSize=UDim2.new();host.Parent=body
 end
 local detail=body:FindFirstChild("DetailPanel") or host:FindFirstChild("DetailPanel")
 if detail then detail.Parent=host end
 local panel=hud:FindFirstChild("CratePanel") or host:FindFirstChild("CratePanel")
 if panel then
  panel.Parent=host;panel:SetAttribute("EmbeddedShop",true)
  if not panel:FindFirstChild("CrateThumbnail") and detail and detail:FindFirstChild("Preview") then
   local preview=detail.Preview:Clone();preview.Name="CrateThumbnail";preview.Parent=panel
  end
  for _,c in panel:GetChildren() do
   if c:IsA("UIScale") then c.Scale=1 end
   if c:IsA("UIAspectRatioConstraint") or c:IsA("UISizeConstraint") then c:Destroy() end
  end
 end
 local back=body:FindFirstChild("BackToCollection")
 if not back then
  back=Instance.new("TextButton");back.Name="BackToCollection";back.Text="‹ VOLVER A LA COLECCIÓN"
  back.Font=Enum.Font.GothamBold;back.TextSize=14;back.TextColor3=Color3.new(1,1,1)
  back.BackgroundColor3=Color3.fromRGB(38,57,101);back.BorderSizePixel=0;back.Parent=body
  local corner=Instance.new("UICorner");corner.CornerRadius=UDim.new(0,10);corner.Parent=back
 end
 -- ScrollingEnabled alone leaves wheel/touch input disabled when Active is false.
 -- Keep native scrolling so the deepest hovered/touched scroll owns its gesture.
 for _,scroll in {body.Catalog,host,main.Tabs,panel and panel:FindFirstChild("RewardScroll")} do
  if scroll and scroll:IsA("ScrollingFrame")then
   scroll.Active=true
   scroll.ScrollingEnabled=true
  end
 end
 Layout.Card(body.Catalog.ProductCardTemplate)
 return host,detail,panel,back
end
function Layout.Apply(hud,focused)
 local main=hud.MainFrame;local body=main.Body
 local host,detail,panel,back=Layout.Prepare(hud)
 local w,h=main.AbsoluteSize.X,main.AbsoluteSize.Y
 if w<1 or h<1 then return end
 local compact=w<850
 local rail=if compact then 0 else 112
 local top=if compact then 170 else 104
 rect(main.Header,0,0,w,72)
 local header=main.Header
 rect(header.CloseButton,w-54,12,42,42)
 rect(header.CoinsContainer,w-(compact and 166 or 218),16,compact and 100 or 150,36)
 if header:FindFirstChild("TitlePlate")then
  local plate=header.TitlePlate
  rect(plate,12,10,compact and math.max(100,w-190)or 260,54)
  rect(plate.PlateIcon,0,4,compact and 32 or 48,compact and 32 or 48)
  rect(plate.TitleLabel,compact and 38 or 60,2,compact and math.max(62,w-228)or 200,36)
  text(plate.TitleLabel,compact and 20 or 30)
  plate.TitleLabel.TextScaled=compact
  plate.V2Subtitle.Visible=not compact
 end
 for _,o in header:GetChildren() do
  if o:IsA("TextLabel") then
   text(o,if o.Name:lower():find("title") then (compact and 22 or 30) else 11)
   if compact and o.Name:lower():find("subtitle") then o.Visible=false end
  end
 end
 local tabs=main.Tabs;local list=tabs:FindFirstChildOfClass("UIListLayout")
 rect(tabs,12,82,if compact then w-24 else 100,if compact then 76 else h-110)
 if tabs:IsA("ScrollingFrame") then
  tabs.AutomaticCanvasSize=if compact then Enum.AutomaticSize.X else Enum.AutomaticSize.Y
  tabs.ScrollingDirection=if compact then Enum.ScrollingDirection.X else Enum.ScrollingDirection.Y
  tabs.CanvasSize=UDim2.new()
 end
 if list then
  list.FillDirection=if compact then Enum.FillDirection.Horizontal else Enum.FillDirection.Vertical
  list.HorizontalAlignment=Enum.HorizontalAlignment.Left;list.VerticalAlignment=Enum.VerticalAlignment.Top
  list.Padding=UDim.new(0,8)
 end
 for _,tab in tabs:GetChildren() do if tab:IsA("GuiButton") then tab.Size=UDim2.fromOffset(88,64) end end
 rect(body,12+rail,top,w-24-rail,math.max(80,h-top-34))
 local bw,bh=w-24-rail,math.max(80,h-top-34)
 if main:FindFirstChild("V2CollectionTitle") then main.V2CollectionTitle.Visible=not compact;rect(main.V2CollectionTitle,12+rail,80,180,20) end
 rect(main.MessageLabel,12,h-28,w-24,24);text(main.MessageLabel,13)
 local detailWidth=if compact then bw else math.max(340,math.floor(bw*.43))
 local catalogWidth=if compact then bw else bw-detailWidth-12
 rect(body.Catalog,0,0,catalogWidth,bh)
 rect(host,if compact then 0 else catalogWidth+12,if compact then 42 else 0,detailWidth,if compact then bh-42 else bh)
 host.Visible=body.Catalog:GetAttribute("HasProducts")==true and (not compact or focused==true)
 body.Catalog.Visible=body.Catalog:GetAttribute("HasProducts")==true and (not compact or not focused)
 back.Visible=compact and focused==true;rect(back,0,0,bw,36)
 for _,name in {"EmptyState","LoadingLabel"} do rect(body:FindFirstChild(name),0,0,catalogWidth,bh) end
 local grid=body.Catalog:FindFirstChildOfClass("UIGridLayout")
 if grid then
  local columns=math.max(1,math.floor(catalogWidth/210))
  grid.CellSize=UDim2.fromOffset(math.floor((catalogWidth-12*(columns-1)-8)/columns),226)
  grid.CellPadding=UDim2.fromOffset(12,12)
 end
 body.Catalog.AutomaticCanvasSize=Enum.AutomaticSize.Y;body.Catalog.CanvasSize=UDim2.new()
 local contentHeight=math.max(500,if compact then bh-42 else bh)
 host.CanvasSize=UDim2.fromOffset(0,contentHeight)
 if detail then rect(detail,0,0,detailWidth-6,contentHeight) end
 if panel then
  local pw=detailWidth-6;rect(panel,0,0,pw,contentHeight)
  for _,name in {"Close","Header","Footer","LeftMask","RightMask","ProbabilityNote"} do local o=panel:FindFirstChild(name);if o then o.Visible=false end end
  rect(panel.CrateThumbnail,12,12,80,88)
  rect(panel.Title,104,12,pw-116,34);text(panel.Title,22)
  rect(panel.Count,104,49,pw-116,22);text(panel.Count,12)
  rect(panel.Price,104,75,pw-116,26);text(panel.Price,18)
  rect(panel.Hint,14,108,pw-28,20);text(panel.Hint,11)
  rect(panel.RewardScroll,12,136,pw-24,contentHeight-300)
  panel.RewardScroll.ClipsDescendants=true
  panel.RewardCard.Size=UDim2.new(0,158,1,-10)
  for _,card in panel.RewardScroll:GetChildren()do if card:IsA("Frame")then card.Size=panel.RewardCard.Size end end
  rect(panel.Status,14,contentHeight-155,pw-28,42);text(panel.Status,13)
  local half=math.floor((pw-36)/2)
  rect(panel.Buy,12,contentHeight-104,half,44);text(panel.Buy,17)
  rect(panel.OpenActions,12,contentHeight-104,pw-24,94)
  panel.OpenActions.BackgroundTransparency=1;panel.OpenActions.Active=false
  for _,o in panel.OpenActions:GetChildren()do if o:IsA("UIListLayout")or o:IsA("UIGridLayout")then o:Destroy()end end
  rect(panel.OpenActions.X1,half+12,0,half,44)
  rect(panel.OpenActions.X5,0,50,half,44)
  rect(panel.OpenActions.X10,half+12,50,half,44)
  for _,b in panel.OpenActions:GetChildren()do text(b,17)end
 end
 return compact
end
return Layout
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="4350">
          <Properties>
            <string name="Name">WindowStack</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Desired windows are retained while covered; only the top is physically visible.
local Stack={};Stack.__index=Stack
function Stack.new(apply)return setmetatable({Order={},Apply=apply},Stack)end
function Stack:Remove(id)
 for i=#self.Order,1,-1 do if self.Order[i]==id then table.remove(self.Order,i)end end
 self:Refresh()
end
function Stack:Push(id)
 for i=#self.Order,1,-1 do if self.Order[i]==id then table.remove(self.Order,i)end end
 table.insert(self.Order,id);self:Refresh()
end
function Stack:Refresh()self.Apply(self.Order[#self.Order],self.Order)end
function Stack:Clear()table.clear(self.Order);self:Refresh()end
return Stack
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="LocalScript" referent="4351">
        <Properties>
          <string name="Name">WindController</string>
          <string name="Source">--credits:k3n and vuuk. model goes to tim for free--
local Camera = workspace.CurrentCamera
local RunService = game:GetService("RunService")

local WIND_DIRECTION = Vector3.new(1,0,0.3)
local WIND_SPEED = 20
local WIND_POWER = 0.5


local WindLines = require(script.WindLines)
local WindShake = require(script.WindShake)

WindLines:Init({
	Direction = WIND_DIRECTION;
	Speed = WIND_SPEED;
	Lifetime = 2;
	SpawnRate = 15;
})


WindShake:SetDefaultSettings({
	WindSpeed = WIND_SPEED;
	WindDirection = WIND_DIRECTION;
	WindPower = WIND_POWER;
})
WindShake:Init()

-- Demo dynamic settings

local Gui = Instance.new("ScreenGui")


local CountLabel = Instance.new("TextLabel")
CountLabel.Text = string.format("Leaf Count: %d Active, %d Inactive, 77760 Total",0,0)
CountLabel.BackgroundTransparency = 0.3
CountLabel.BackgroundColor3 = Color3.new()
CountLabel.TextStrokeTransparency = 0.8
CountLabel.Size = UDim2.new(0.6,0,0,27)
CountLabel.Position = UDim2.new(0.2,0,1,-35)
CountLabel.Font = Enum.Font.RobotoMono
CountLabel.TextSize = 25
CountLabel.TextColor3 = Color3.new(1,1,1)
CountLabel.Parent = Gui

local SpeedInput = Instance.new("TextBox")
SpeedInput.Text = string.format("Wind Speed: %.1f",WIND_SPEED)
SpeedInput.PlaceholderText = "Input Speed"
SpeedInput.BackgroundTransparency = 0.8
SpeedInput.TextStrokeTransparency = 0.8
SpeedInput.Size = UDim2.new(0.2,0,0,20)
SpeedInput.Position = UDim2.new(0,5,0.45,0)
SpeedInput.Font = Enum.Font.RobotoMono
SpeedInput.TextXAlignment = Enum.TextXAlignment.Left
SpeedInput.TextSize = 18
SpeedInput.TextColor3 = Color3.new(1,1,1)
SpeedInput.FocusLost:Connect(function()
	local newSpeed = tonumber(SpeedInput.Text:match("[%d%.]+"))
	if newSpeed then
		WIND_SPEED = math.clamp(newSpeed,0,50)
		WindLines.Speed = WIND_SPEED
		WindShake:UpdateAllObjectSettings({Speed = WIND_SPEED})
		WindShake:SetDefaultSettings({Speed = WIND_SPEED})
	end
	SpeedInput.Text = string.format("Wind Speed: %.1f",WIND_SPEED)
end)
SpeedInput.Parent = Gui

local PowerInput = Instance.new("TextBox")
PowerInput.Text = string.format("Wind Power: %.1f",WIND_POWER)
PowerInput.PlaceholderText = "Input Power"
PowerInput.BackgroundTransparency = 0.8
PowerInput.TextStrokeTransparency = 0.8
PowerInput.Size = UDim2.new(0.2,0,0,20)
PowerInput.Position = UDim2.new(0,5,0.45,25)
PowerInput.Font = Enum.Font.RobotoMono
PowerInput.TextXAlignment = Enum.TextXAlignment.Left
PowerInput.TextSize = 18
PowerInput.TextColor3 = Color3.new(1,1,1)
PowerInput.FocusLost:Connect(function()
	local newPower = tonumber(PowerInput.Text:match("[%d%.]+"))
	if newPower then
		WIND_POWER = math.clamp(newPower,0,3)
		WindShake:UpdateAllObjectSettings({Power = WIND_POWER})
		WindShake:SetDefaultSettings({Power = WIND_POWER})
	end
	PowerInput.Text = string.format("Wind Power: %.1f",WIND_POWER)
end)
PowerInput.Parent = Gui

local DirInput = Instance.new("TextBox")
DirInput.Text = string.format("Wind Direction: %.1f,%.1f,%.1f",WIND_DIRECTION.X,WIND_DIRECTION.Y,WIND_DIRECTION.Z)
DirInput.PlaceholderText = "Input Direction"
DirInput.BackgroundTransparency = 0.8
DirInput.TextStrokeTransparency = 0.8
DirInput.Size = UDim2.new(0.2,0,0,20)
DirInput.Position = UDim2.new(0,5,0.45,50)
DirInput.Font = Enum.Font.RobotoMono
DirInput.TextXAlignment = Enum.TextXAlignment.Left
DirInput.TextSize = 18
DirInput.TextColor3 = Color3.new(1,1,1)
DirInput.FocusLost:Connect(function()

	local Inputs = table.create(3)
	for Num in string.gmatch(DirInput.Text, "%-?[%d%.]+") do
		Inputs[#Inputs+1] = tonumber(Num)
	end

	local newDir = Vector3.new(
		Inputs[1] or WIND_DIRECTION.X,
		Inputs[2] or WIND_DIRECTION.Y,
		Inputs[3] or WIND_DIRECTION.Z
	).Unit
	if newDir then
		WIND_DIRECTION = newDir
		WindLines.Direction = newDir
		WindShake:UpdateAllObjectSettings({Direction = newDir})
		WindShake:SetDefaultSettings({Direction = newDir})
	end

	DirInput.Text = string.format("Wind Direction: %.1f, %.1f, %.1f",WIND_DIRECTION.X,WIND_DIRECTION.Y,WIND_DIRECTION.Z)
end)
DirInput.Parent = Gui



spawn(function()
	while wait(0.1) do
		local Active,Handled = WindShake.Active,WindShake.Handled
		CountLabel.Text = string.format("Leaf Count: %d Active, %d Inactive, %d Not Streamed In (77760 Total)",Active,Handled-Active,77760-Handled)
	end
end)</string>
        </Properties>
        <Item class="ModuleScript" referent="4352">
          <Properties>
            <string name="Name">WindLines</string>
            <string name="Source"><![CDATA[--k3n credits.. this is windlines so anything in wind its based on this mainmodule--
local RunService = game:GetService("RunService")
local Terrain = workspace:FindFirstChildOfClass("Terrain")

local EMPTY_TABLE = {}
local OFFSET = Vector3.new(0,0.1,0)

local module = {}

module.UpdateQueue = table.create(10)

function module:Init(Settings)
	-- Set defaults
	module.Lifetime = Settings.Lifetime or 3
	module.Direction = Settings.Direction or Vector3.new(1,0,0)
	module.Speed = Settings.Speed or 6
	
	-- Clear any old stuff
	if module.UpdateConnection then
		module.UpdateConnection:Disconnect()
		module.UpdateConnection = nil
	end
	
	for _, WindLine in ipairs(module.UpdateQueue) do
		WindLine.Attachment0:Destroy()
		WindLine.Attachment1:Destroy()
		WindLine.Trail:Destroy()
	end
	table.clear(module.UpdateQueue)
	
	module.LastSpawned = os.clock()
	local SpawnRate = 1/(Settings.SpawnRate or 25)
	
	-- Setup logic loop
	module.UpdateConnection = RunService.Heartbeat:Connect(function()
		local Clock = os.clock()
		
		-- Spawn handler
		if Clock-module.LastSpawned > SpawnRate then
			module:Create()
			module.LastSpawned = Clock
		end
		
		-- Update queue handler
		debug.profilebegin("Wind Lines")
		for i, WindLine in ipairs(module.UpdateQueue) do
			
			local AliveTime = Clock-WindLine.StartClock
			if AliveTime >= WindLine.Lifetime then
				-- Destroy the objects
				WindLine.Attachment0:Destroy()
				WindLine.Attachment1:Destroy()
				WindLine.Trail:Destroy()
				
				-- unordered remove at this index
				local Length = #module.UpdateQueue
				module.UpdateQueue[i] = module.UpdateQueue[Length]
				module.UpdateQueue[Length] = nil
				
				continue
			end
			
			WindLine.Trail.MaxLength = 20 - (20*(AliveTime/WindLine.Lifetime))
			
			local SeededClock = (Clock+WindLine.Seed)*(WindLine.Speed*0.2)
			local StartPos = WindLine.Position
			WindLine.Attachment0.WorldPosition = (
				CFrame.new(StartPos, StartPos+WindLine.Direction) * CFrame.new(0,0,WindLine.Speed * -AliveTime)
			).Position + Vector3.new(math.sin(SeededClock)*0.5,math.sin(SeededClock)*0.8,math.sin(SeededClock)*0.5)
			
			WindLine.Attachment1.WorldPosition = WindLine.Attachment0.WorldPosition + OFFSET
			
		end
		debug.profileend()
	end)


end

function module:Cleanup()
	
	if module.UpdateConnection then
		module.UpdateConnection:Disconnect()
		module.UpdateConnection = nil
	end

	for _, WindLine in ipairs(module.UpdateQueue) do
		WindLine.Attachment0:Destroy()
		WindLine.Attachment1:Destroy()
		WindLine.Trail:Destroy()
	end
	table.clear(module.UpdateQueue)
	
end

function module:Create(Settings)
	debug.profilebegin("Add Wind Line")
	
	Settings = Settings or EMPTY_TABLE

	local Lifetime = Settings.Lifetime or module.Lifetime
	local Position = Settings.Position or (workspace.CurrentCamera.CFrame*CFrame.Angles(math.rad(math.random(-30,70)),math.rad(math.random(-80,80)),0))*CFrame.new(0,0,math.random(200,600)*-0.1).Position
	local Direction = Settings.Direction or module.Direction
	local Speed = Settings.Speed or module.Speed
	if Speed <= 0 then return end

	local Attachment0 = Instance.new("Attachment")
	local Attachment1 = Instance.new("Attachment")
	
	local Trail = Instance.new("Trail")
	Trail.Attachment0 = Attachment0
	Trail.Attachment1 = Attachment1
	Trail.WidthScale = NumberSequence.new({
		NumberSequenceKeypoint.new(0,0.3),
		NumberSequenceKeypoint.new(0.2,1),
		NumberSequenceKeypoint.new(0.8,1),
		NumberSequenceKeypoint.new(1,0.3),
	})
	Trail.Transparency = NumberSequence.new(0.7)
	Trail.FaceCamera = true
	Trail.Parent = Attachment0

	Attachment0.WorldPosition = Position
	Attachment1.WorldPosition = Position+OFFSET
	
	local WindLine = {
		Attachment0 = Attachment0;
		Attachment1 = Attachment1;
		Trail = Trail;
		Lifetime = Lifetime+(math.random(-10,10)*0.1);
		Position = Position;
		Direction = Direction;
		Speed = Speed+(math.random(-10,10)*0.1);
		StartClock = os.clock();
		Seed = math.random(1,1000)*0.1;
	}
	
	module.UpdateQueue[#module.UpdateQueue+1] = WindLine

	Attachment0.Parent = Terrain
	Attachment1.Parent = Terrain
	
	debug.profileend()
end

return module
]]></string>
