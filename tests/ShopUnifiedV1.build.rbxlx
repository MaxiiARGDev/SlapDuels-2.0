 "InvisibilityAbility",
})
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="910">
        <Properties>
          <string name="Name">AirJumpsAbility</string>
          <string name="Source"><![CDATA[--!nonstrict
local Guard=require(script.Parent.MovementGuard)
local Air={}
function Air.Start(record)
 record.AirJumps=0;record.LastJump=0;record.GroundY=record.Root.Position.Y
 return true
end
function Air.Step(record,_dt)
 if record.OwnershipUntil and os.clock()>=record.OwnershipUntil then
  Guard.Release(record.Root,record.Ownership);record.OwnershipUntil=nil;record.Ownership=nil
 end
 if record.Humanoid.FloorMaterial~=Enum.Material.Air then
  record.AirJumps=0;record.GroundY=record.Root.Position.Y
 end
 return true
end
function Air.Jump(record,now)
 local d=record.Definition
 if record.Humanoid.FloorMaterial~=Enum.Material.Air or now-record.LastJump<d.MinJumpInterval
  or record.AirJumps>=d.MaxConsecutiveAirJumps or record.Root.Position.Y-record.GroundY>=d.MaxRiseStuds then return false end
 local displacement=Vector3.new(0,3,0)
 if Guard.SafeDistance(record,displacement)<3 then return false end
 local taken,ownership=Guard.Take(record.Root)
 if not taken then return false end
 record.Ownership=ownership
 record.OwnershipUntil=now+0.15
 record.AirJumps+=1;record.LastJump=now
 local v=record.Root.AssemblyLinearVelocity
 record.Root.AssemblyLinearVelocity=Vector3.new(v.X,math.min(d.AirJumpStrength,d.MaxVerticalVelocity),v.Z)
 return true
end
function Air.Cancel(record) Guard.Release(record.Root,record.Ownership);record.Ownership=nil end
Air.Descriptor={Id="AirJumps",DisplayName="Saltos de Aire",Description="Saltos aéreos moderados durante 15 s; hasta 4 antes de tocar suelo.",Type="Movilidad",
 Duration=15,Cooldown=20,Icon="",SortOrder=30}
Air.Enabled=true
Air.Config={AirJumpStrength=32,MinJumpInterval=0.8,MaxConsecutiveAirJumps=4,MaxVerticalVelocity=38,MaxRiseStuds=24}
Air.ConfigSchema={AirJumpStrength={Type="number",Min=1,Max=100},MinJumpInterval={Type="number",Min=0.1,Max=10},MaxConsecutiveAirJumps={Type="number",Min=1,Max=10,Integer=true},MaxVerticalVelocity={Type="number",Min=1,Max=100},MaxRiseStuds={Type="number",Min=1,Max=100}}
Air.Shop={Price=750,PriceApproved=true,PurchaseEnabled=true}
Air.Dependencies={"MovementGuard"}
Air.Input={Primary="None",ActivePrimaryAction="AirJump",JumpAction="AirJump"}
Air.Assets={Key="AirJumps",Profile="AttachmentEffect"}
Air.Actions={AirJump={Input="None"}}
function Air.OnAction(record,action,_input,clock)
 if action=="AirJump" then return Air.Jump(record,clock) end
 return false
end
return Air
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="911">
        <Properties>
          <string name="Name">DashAbility</string>
          <string name="Source"><![CDATA[--!nonstrict
local Guard=require(script.Parent.MovementGuard)
local Dash={}
function Dash.Start(record,direction)
 local horizontal=Vector3.new(direction.X,0,direction.Z)
 if horizontal.Magnitude<0.05 then horizontal=Vector3.new(record.Root.CFrame.LookVector.X,0,record.Root.CFrame.LookVector.Z) end
 if horizontal.Magnitude<0.05 then record.StopReason="NoHorizontalDirection";return false end
 local taken,ownership,reason=Guard.Take(record.Root)
 if not taken then record.StopReason=reason or "OwnershipUnavailable";return false end
 record.Ownership=ownership
 record.Direction=horizontal.Unit;record.Travelled=0
 record.DashOrigin=record.Root.Position
 return true
end
function Dash.Step(record,dt)
 record.LastStepDt=dt
 if dt>0.1 then record.StopReason="LongFrame";return false end -- same tunnelling guard
 local speed=record.Definition.DistanceStuds/record.Definition.Duration
 local remaining=record.Definition.DistanceStuds-(record.Root.Position-record.DashOrigin).Magnitude
 local requested=math.min(speed*dt,remaining)
 if requested<=0 then record.StopReason="DistanceComplete";return false end
 local safe,reason=Guard.SafeDistance(record,record.Direction*requested)
 if safe<requested then record.StopReason=reason or "MovementBlocked";return false end
 local v=record.Root.AssemblyLinearVelocity
 record.Root.AssemblyLinearVelocity=record.Direction*math.min(speed,safe/math.max(dt,0.001))+Vector3.new(0,v.Y,0)
 record.MovementApplied=true
 return true
end
function Dash.Cancel(record)
 local hum=record.Humanoid
 if record.Root.Parent and not hum.PlatformStand and not record.Character:GetAttribute("ArenaRespawnPending") then
  local v=record.Root.AssemblyLinearVelocity
  record.Root.AssemblyLinearVelocity=Vector3.new(0,v.Y,0)
 end
 Guard.Release(record.Root,record.Ownership);record.Ownership=nil
end
Dash.Descriptor={Id="Dash",DisplayName="Impulso",Description="Impulso horizontal dirigido. E o botón táctil.",Type="Movimiento",
 Duration=0.2,Cooldown=11,Icon="",SortOrder=10,DurationKind="Instant"}
Dash.Enabled=true
Dash.Config={DistanceStuds=24}
Dash.ConfigSchema={DistanceStuds={Type="number",Min=1,Max=100}}
Dash.Shop={Price=0,PriceApproved=true,PurchaseEnabled=false}
Dash.Dependencies={"MovementGuard"}
Dash.Input={Primary="Direction"}
Dash.Assets={Key="Dash",Profile="AttachmentEffect"}
return Dash
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="912">
        <Properties>
          <string name="Name">DevilSpeedAbility</string>
          <string name="Source"><![CDATA[--!nonstrict
local Speed={}
local Movement=require(script.Parent.Parent.Services.Respawn.MovementSpeed)
function Speed.Start(record)
 record.BaseSpeed=Movement.Base(record.Humanoid);record.AppliedSpeed=record.Humanoid.WalkSpeed
 return record.BaseSpeed>0
end
function Speed.Step(record,dt)
 local hum=record.Humanoid
 -- Another owner (lock, recovery, modifier) wins. Do not overwrite its value.
 if math.abs(hum.WalkSpeed-record.AppliedSpeed)>0.001 then return false end
 local target=math.min(record.BaseSpeed*record.Definition.SpeedMultiplier,record.Definition.MaxSpeed)
 record.AppliedSpeed=math.min(target,record.AppliedSpeed+record.Definition.Acceleration*dt)
 return Movement.SetModifier(hum,record,record.AppliedSpeed-Movement.Base(hum))
end
function Speed.Cancel(record)
 Movement.RemoveModifier(record.Humanoid,record)
end
Speed.Descriptor={Id="DevilSpeed",DisplayName="Velocidad Diabólica",Description="Acelera durante 5 s. El derribo cancela el efecto.",Type="Movilidad",
 Duration=5,Cooldown=14,Icon="",SortOrder=40}
Speed.Enabled=true
Speed.Config={SpeedMultiplier=2.4,MaxSpeed=48,Acceleration=100}
Speed.ConfigSchema={SpeedMultiplier={Type="number",Min=1,Max=5},MaxSpeed={Type="number",Min=1,Max=100},Acceleration={Type="number",Min=1,Max=500}}
Speed.Shop={Price=1500,PriceApproved=true,PurchaseEnabled=true}
Speed.Dependencies={}
Speed.Input={Primary="None"}
Speed.Assets={Key="DevilSpeed",Profile="AttachmentEffect"}
return Speed
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="913">
        <Properties>
          <string name="Name">InvisibilityAbility</string>
          <string name="Source"><![CDATA[--!strict
-- Presentation is coordinated only to session recipients. No server transparency,
-- collision, hitbox, health, Tool or sensor changes.
local Invisible = {}
function Invisible.Start(_record: any): boolean return true end
function Invisible.Step(_record: any,_dt: number): boolean return true end
function Invisible.Cancel(_record: any) end
Invisible.Descriptor={Id="Invisible",DisplayName="Invisible",Description="Oculta avatar y Slap durante 5 s; deja un rastro tenue.",Type="Sigilo",
 Duration=5,Cooldown=35,Icon="",SortOrder=50}
Invisible.Enabled=true
Invisible.Config={}
Invisible.ConfigSchema={}
Invisible.Shop={Price=2250,PriceApproved=true,PurchaseEnabled=true}
Invisible.Dependencies={}
Invisible.Input={Primary="None"}
Invisible.Assets={Key="Invisible",Profile="InvisibleAvatar"}
return Invisible
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="914">
        <Properties>
          <string name="Name">MovementGuard</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Server-owned movement, conservative body sweep and explicit arena envelope.
local Guard = {}
local function segmentBox(cf,size,origin,delta,padding)
 local p=cf:PointToObjectSpace(origin)
 local d=cf:VectorToObjectSpace(delta)
 local half=size/2+Vector3.new(padding,padding,padding)
 local lo,hi=0,1
 for _,axis in {"X","Y","Z"} do
  if math.abs(d[axis])<1e-6 then
   if math.abs(p[axis])>half[axis] then return nil end
  else
   local a,b=(-half[axis]-p[axis])/d[axis],(half[axis]-p[axis])/d[axis]
   if a>b then a,b=b,a end
   lo=math.max(lo,a);hi=math.min(hi,b)
   if lo>hi then return nil end
  end
 end
 return lo
end
Guard.SegmentBox=segmentBox
function Guard.CanOwn(root)
 local ok,allowed=pcall(function() return root:CanSetNetworkOwnership() end)
 return ok and allowed
end
function Guard.Take(root)
 if not Guard.CanOwn(root) then return false,nil,"OwnershipUnavailable" end
 local captured,ownership=pcall(function() return {Auto=root:GetNetworkOwnershipAuto(),Owner=root:GetNetworkOwner()} end)
 if not captured then return false,nil,"OwnershipCaptureFailed" end
 local ok=pcall(function() root:SetNetworkOwner(nil) end)
 return ok,if ok then ownership else nil,if ok then nil else "OwnershipTakeFailed"
end
function Guard.Release(root,ownership)
 if root and root.Parent and ownership then pcall(function()
  if root:GetNetworkOwner()~=nil then return end -- A newer explicit owner wins.
  if ownership.Auto then root:SetNetworkOwnershipAuto() else root:SetNetworkOwner(ownership.Owner) end
 end) end
end
function Guard.SafeDistance(record,delta)
 if delta.Magnitude<1e-5 then return 0,"ZeroDisplacement" end
 local root=record.Root
 local size=Vector3.new(3,3,3)
 local params=RaycastParams.new()
 params.FilterType=Enum.RaycastFilterType.Exclude
 params.FilterDescendantsInstances={record.Character}
 params.RespectCanCollide=true
 local overlap=OverlapParams.new()
 overlap.FilterType=Enum.RaycastFilterType.Exclude
 overlap.FilterDescendantsInstances={record.Character}
 overlap.RespectCanCollide=true
 -- Blockcast does not detect an initial overlap. Fail closed on such overlaps.
 if #workspace:GetPartBoundsInBox(root.CFrame,size,overlap)>0 then return 0,"InitialOverlap" end
 local hit=workspace:Blockcast(root.CFrame,size,delta,params)
 local distance=if hit then math.max(0,hit.Distance-0.3) else delta.Magnitude
 local reason=if hit then "ObstacleSweep" else "Clear"
 local info=record.World
 if not info or not info.VoidBoundaryPart then return 0,"MissingArenaBounds" end
 local bounds=info.VoidBoundaryPart
 local relative=root.Position-bounds.Position
 local endRelative=relative+delta
 if math.abs(endRelative.X)>bounds.Size.X/2-3 or math.abs(endRelative.Z)>bounds.Size.Z/2-3 then return 0,"ArenaEnvelope" end
 -- Noncolliding KillPart/void sensors may have CanQuery=false. Never skip them
 -- merely because they are absent from a physics query.
 for _,part in info.KillParts or {} do
  local t=segmentBox(part.CFrame,part.Size,root.Position,delta,1.5)
  if t then
   local clipped=math.max(0,t*delta.Magnitude-0.3)
   if clipped<distance then distance=clipped;reason="KillPartSweep" end
  end
 end
 return distance,reason
end
return Guard
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="915">
        <Properties>
          <string name="Name">StrongSlapAbility</string>
          <string name="Source"><![CDATA[--!nonstrict
local Strong={}
function Strong.Start(record) record.State="Armed";return true end
function Strong.Step(_record,_dt) return true end
function Strong.Cancel(_record) end
Strong.Descriptor={Id="StrongSlap",DisplayName="Golpe Fuerte",Description="Prepara el próximo impacto válido durante 15 s. Eliminación inmediata.",Type="Ofensiva",
 Duration=15,Cooldown=25,Icon="",SortOrder=20,ActiveLabel="PREPARADA"}
Strong.Enabled=true
Strong.Config={PresentationLift=25}
Strong.ConfigSchema={PresentationLift={Type="number",Min=0,Max=100}}
Strong.Shop={Price=3000,PriceApproved=true,PurchaseEnabled=true}
Strong.Dependencies={}
Strong.Input={Primary="None"}
Strong.Assets={Key="StrongSlap",Profile="AttachmentEffect",Cues={Impact={Profile="VerticalLaunch",Resource="LaunchSpectacle",Lift=Strong.Config.PresentationLift,Duration=0.65}}}
Strong.Hooks={Profile="ImmediateElimination",Reason="StrongSlap",Cue="Impact",
 BeforeHit=function(record) return record.State=="Armed" end,
 Consume=function(record)
  if record.State~="Armed" then return false end
  record.State="Consumed";return true
 end}
return Strong
]]></string>
