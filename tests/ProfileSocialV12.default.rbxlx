      <Item class="LocalScript" referent="1779">
        <Properties>
          <string name="Name">ArenaRespawnGuard</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Local movement-state cleanup only. Server attributes decide retirement and respawn.
local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local Input=game:GetService("UserInputService")
local player=Players.LocalPlayer
local character=script.Parent
local humanoid=character:WaitForChild("Humanoid")
local connections={}
local jumpTouches={}
local buttons={}
local paused=false
local observedRevision=0
local focused=true
local savedJumping,savedAutoJump
local barrier
local settledGeneration
local lobbyGeneration
-- No cross-sandbox module dependency: diagnostics are selected by the server.
local function heldJump()
 if not focused then return false end
 if Input:IsKeyDown(Enum.KeyCode.Space) or next(jumpTouches)~=nil then return true end
 for _,pad in ipairs(Input:GetConnectedGamepads()) do if Input:IsGamepadButtonDown(pad,Enum.KeyCode.ButtonA) then return true end end
 return false
end
local function release()
 if not paused or player.Character~=character or character:GetAttribute("ArenaRespawnPending") then return end
 if barrier then barrier:Disconnect() end
 local generation=character:GetAttribute("ArenaPhysicsGeneration")
 local sessionId=player:GetAttribute("MatchId")
 -- Clear held state at a physics boundary, after default input has processed key/touch release.
 barrier=RunService.PreSimulation:Connect(function()
  barrier:Disconnect();barrier=nil
  if player.Character~=character or not humanoid.Parent or character:GetAttribute("ArenaRespawnPending")
   or player:GetAttribute("MatchId")~=sessionId
   or generation~=character:GetAttribute("ArenaPhysicsGeneration") then return end
  humanoid.Jump=false
  -- The slap owner can still have local Physics/angular velocity when the server
  -- returns ownership. Settle once at the first playable physics boundary,
  -- including when old jump input is held. Never zero later legitimate movement.
  if settledGeneration~=generation then
   -- A valid NEW hit delivered after respawn must retain its competitive physics.
   if character:GetAttribute("ArenaAcceptedLaunchGeneration")~=generation then
    for _,part in ipairs(character:GetDescendants()) do
     if part:IsA("BasePart") then part.AssemblyLinearVelocity=Vector3.zero;part.AssemblyAngularVelocity=Vector3.zero end
    end
    humanoid.PlatformStand=false
    humanoid:SetStateEnabled(Enum.HumanoidStateType.GettingUp,true)
    humanoid:ChangeState(Enum.HumanoidStateType.Running)
   end
   settledGeneration=generation
   if character:GetAttribute("ArenaRespawnDebug")==true then
    local root=character:FindFirstChild("HumanoidRootPart")
    print("[RespawnDebug] ClientSettled",player.UserId,character:GetAttribute("ArenaEliminationId"),generation,
     humanoid:GetState().Name,root and root.AssemblyLinearVelocity,root and root.AssemblyAngularVelocity)
   end
  end
  if heldJump() then return end
  humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping,savedJumping)
  humanoid.AutoJumpEnabled=savedAutoJump
  paused=false
 end)
end
local function pause()
  if barrier then barrier:Disconnect();barrier=nil end
  if not paused then
   savedJumping=humanoid:GetStateEnabled(Enum.HumanoidStateType.Jumping)
   savedAutoJump=humanoid.AutoJumpEnabled
  end
  paused=true
  humanoid.Jump=false
  humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping,false)
  humanoid.AutoJumpEnabled=false
end
local function refresh()
 -- Revision survives replication coalescing when a 0ms retirement is already complete.
 local revision=character:GetAttribute("ArenaRespawnRevision") or 0
 if revision~=observedRevision then observedRevision=revision;pause() end
 local generation=character:GetAttribute("ArenaPhysicsGeneration")
 if character:GetAttribute("ArenaPhysicsPhase")=="Lobby" and lobbyGeneration~=generation then
  lobbyGeneration=generation;pause()
 end
 if character:GetAttribute("ArenaRespawnPending") then pause() else release() end
end
local function trackButton(object)
 if object.Name~="JumpButton" or not object:IsA("GuiButton") or buttons[object] then return end
 buttons[object]=true
 table.insert(connections,object.InputBegan:Connect(function(input)
  if input.UserInputType==Enum.UserInputType.Touch then jumpTouches[input]=true end
 end))
 table.insert(connections,object.InputEnded:Connect(function(input)jumpTouches[input]=nil;release()end))
end
local playerGui=player:WaitForChild("PlayerGui")
for _,object in ipairs(playerGui:GetDescendants()) do trackButton(object) end
table.insert(connections,playerGui.DescendantAdded:Connect(trackButton))
table.insert(connections,Input.InputEnded:Connect(function(input)jumpTouches[input]=nil;release()end))
table.insert(connections,Input.WindowFocusReleased:Connect(function()focused=false;table.clear(jumpTouches);release()end))
table.insert(connections,Input.WindowFocused:Connect(function()focused=true;release()end))
table.insert(connections,character:GetAttributeChangedSignal("ArenaRespawnPending"):Connect(refresh))
table.insert(connections,character:GetAttributeChangedSignal("ArenaPhysicsGeneration"):Connect(refresh))
table.insert(connections,character:GetAttributeChangedSignal("ArenaRespawnRevision"):Connect(refresh))
table.insert(connections,character:GetAttributeChangedSignal("ArenaPhysicsPhase"):Connect(refresh))
table.insert(connections,player:GetAttributeChangedSignal("MatchId"):Connect(refresh))
table.insert(connections,humanoid:GetPropertyChangedSignal("Jump"):Connect(function()if paused and humanoid.Jump then humanoid.Jump=false end end))
table.insert(connections,character.Destroying:Connect(function()
 if barrier then barrier:Disconnect() end
 for _,connection in ipairs(connections) do connection:Disconnect() end
end))
refresh()
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="1780">
        <Properties>
          <string name="Name">RagdollStatesHandler</string>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService('ReplicatedStorage')
local stateEvent = ReplicatedStorage:WaitForChild('StateEvent') :: UnreliableRemoteEvent
local character = script.Parent
local humanoid = character:WaitForChild('Humanoid') :: Humanoid
local rootPart = character:WaitForChild('HumanoidRootPart') :: BasePart?
local latestGeneration = character:GetAttribute("ArenaPhysicsGeneration") or 0
local player = game:GetService("Players").LocalPlayer
-- Character scripts may be sandboxed; read the server's diagnostic flag, never require Config here.
local currentPacket

local function onClientEvent(status: boolean, launchVelocity: Vector3?, sourceSessionId: string?, physicsGeneration: number?, sourceCharacter: Model?)
	if not humanoid.Parent or player.Character ~= character then return end
	if type(physicsGeneration) ~= "number" or sourceCharacter ~= character then return end
	local generation = physicsGeneration or 0
	if generation < math.max(latestGeneration, character:GetAttribute("ArenaPhysicsGeneration") or 0)
		or character:GetAttribute("ArenaRespawnPending") then return end
	latestGeneration = generation
	local packet = {}
	currentPacket = packet
	local function staleLaunch(): boolean
		return currentPacket ~= packet or player.Parent == nil or player.Character ~= character or not character.Parent
			or sourceSessionId ~= nil
			and (player:GetAttribute("MatchId") ~= sourceSessionId or player:GetAttribute("ResultsSessionId") == sourceSessionId)
			or character:GetAttribute("ArenaRespawnPending") == true
			or generation ~= math.max(latestGeneration, character:GetAttribute("ArenaPhysicsGeneration") or 0)
	end
		if staleLaunch() then
			if character:GetAttribute("ArenaRespawnDebug") == true then warn("[RespawnDebug] StaleStateEvent", player.UserId, generation, character:GetAttribute("ArenaEliminationId")) end
			return
		end
	humanoid:SetStateEnabled(Enum.HumanoidStateType.GettingUp, status)
	humanoid:ChangeState(if status then Enum.HumanoidStateType.GettingUp else Enum.HumanoidStateType.Physics)

	if not status then
			character:SetAttribute("ArenaAcceptedLaunchGeneration", generation)
		if rootPart then
			rootPart.CanCollide = false
		end
		if launchVelocity then
			for _, part in ipairs(character:GetDescendants()) do
				if part:IsA("BasePart") then
					part.AssemblyLinearVelocity = launchVelocity
					part.AssemblyAngularVelocity = Vector3.new(
						math.random(-6, 6),
						math.random(-6, 6),
						math.random(-6, 6)
					)
				end
			end
			task.defer(function()
				if not staleLaunch() and humanoid.Parent and not humanoid:GetStateEnabled(Enum.HumanoidStateType.GettingUp) then
					for _, part in ipairs(character:GetDescendants()) do
						if part:IsA("BasePart") then
							part.AssemblyLinearVelocity = launchVelocity
						end
					end
					elseif character:GetAttribute("ArenaRespawnDebug") == true then
					warn("[RespawnDebug] StaleDeferredLaunch", player.UserId, generation, character:GetAttribute("ArenaEliminationId"))
				end
			end)
		end
	else
		-- Root collision is restored by the server to its saved value, never forced true here.
	end
end

local connection = stateEvent.OnClientEvent:Connect(onClientEvent)
local removing
removing = player.CharacterRemoving:Connect(function(oldCharacter)
	if oldCharacter == character then connection:Disconnect(); removing:Disconnect() end
end)
character.Destroying:Connect(function() connection:Disconnect(); removing:Disconnect() end)

]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="StarterPlayerScripts" referent="1781">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="1782">
        <Properties>
          <string name="Name">Abilities</string>
        </Properties>
        <Item class="ModuleScript" referent="1783">
          <Properties>
            <string name="Name">AbilityPresentation</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Only session participants receive these records. Local visual changes never
-- touch collision, hitboxes, health, equipped tools or persistent preferences.
local Players=game:GetService("Players")
local RS=game:GetService("ReplicatedStorage")
local TweenService=game:GetService("TweenService")
local Debris=game:GetService("Debris")
local Catalog=require(RS.Shared.AbilityCatalog)
local Profiles=require(script.Parent.AbilityPresentationProfiles)
local Presentation={}
Presentation.__index=Presentation
function Presentation.new() return setmetatable({Active={},Impacts={},Transient={}},Presentation) end
function Presentation:_remove(key)
 local record=self.Active[key]
 if not record then return end
 self.Active[key]=nil
 if record.Connection then record.Connection:Disconnect() end
 for object,properties in pairs(record.Saved) do
  if object.Parent then
   for property,values in pairs(properties) do
    -- A later local visual owner wins; restore only values still owned here.
    pcall(function() if object[property]==values.Applied then object[property]=values.Original end end)
   end
  end
 end
 for _,v in ipairs(record.Assets) do v:Destroy() end
end
function Presentation:Reconcile(payload)
 local desired={}
 if payload.Playing and payload.SessionId==Players.LocalPlayer:GetAttribute("MatchId") then
  for _,effect in ipairs(payload.Presentations or {}) do
   local player=Players:GetPlayerByUserId(effect.UserId)
   local char=player and player.Character
   local root=char and char:FindFirstChild("HumanoidRootPart")
   local definition=Catalog.GetItem(effect.AbilityId)
   if definition and char and root and (char:GetAttribute("ArenaPhysicsGeneration") or 0)==effect.CharacterGeneration
    and not char:GetAttribute("ArenaRespawnPending") and effect.ActiveUntil>workspace:GetServerTimeNow() then
    desired[effect.ActivationId]=true
    local record=self.Active[effect.ActivationId]
    if record and record.Character~=char then self:_remove(effect.ActivationId);record=nil end
    if not record then
     record={Saved={},Assets={},Character=char,Until=effect.ActiveUntil,Generation=effect.CharacterGeneration}
     self.Active[effect.ActivationId]=record
     Profiles.Start(definition.Assets,record,char,root)
    end
   end
  end
 end
 local remove={}
 for key in pairs(self.Active) do if not desired[key] then table.insert(remove,key) end end
 for _,key in ipairs(remove) do self:_remove(key) end
end
function Presentation:Tick()
 local remove={}
 for key,r in pairs(self.Active) do
  if not r.Character.Parent or r.Character:GetAttribute("ArenaRespawnPending")
   or (r.Character:GetAttribute("ArenaPhysicsGeneration") or 0)~=r.Generation or workspace:GetServerTimeNow()>=r.Until then table.insert(remove,key) end
 end
 for _,key in ipairs(remove) do self:_remove(key) end
end
function Presentation:Impact(payload)
 if payload.SessionId~=Players.LocalPlayer:GetAttribute("MatchId") or self.Impacts[payload.ActivationId] then return end
 self.Impacts[payload.ActivationId]=true
 local definition=Catalog.GetItem(payload.AbilityId)
 local cue=definition and definition.Assets.Cues[payload.Cue]
 if not cue or cue.Profile~="VerticalLaunch" or typeof(payload.Position)~="Vector3" then return end
 local folder=RS:FindFirstChild("AbilityEffects")
 local assets=folder and folder:FindFirstChild(definition.Assets.Key)
 local template=assets and assets:FindFirstChild(cue.Resource)
 if not template or not template:IsA("BasePart") then return end
 -- Visual prop only: no force is applied to the competitive Character.
 local prop=template:Clone();prop:SetAttribute("AbilityPresentation",true)
 prop.CFrame=CFrame.new(payload.Position);prop.Parent=workspace
 self.Transient[prop]=true
 local tween=TweenService:Create(prop,TweenInfo.new(cue.Duration,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),
  {CFrame=prop.CFrame+Vector3.new(0,cue.Lift,0),Transparency=1})
 tween:Play();Debris:AddItem(prop,cue.Duration+0.15)
 task.delay(cue.Duration+0.25,function() self.Transient[prop]=nil end)
end
function Presentation:Clear()
 local keys={} for key in pairs(self.Active) do table.insert(keys,key) end
 for _,key in ipairs(keys) do self:_remove(key) end
 for prop in pairs(self.Transient) do prop:Destroy() end
 self.Transient={};self.Impacts={}
end
return Presentation
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1784">
          <Properties>
            <string name="Name">AbilityPresentationProfiles</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Reviewed visual adapters. Profiles describe capabilities, never ability IDs.
local RS=game:GetService("ReplicatedStorage")
local Profiles={}
local function marked(object)
 while object do
  if object:GetAttribute("AbilityPresentation") then return true end
  object=object.Parent
 end
 return false
end
local function hide(record,object)
 if marked(object) or record.Saved[object] then return end
 local property,value
 if object:IsA("BasePart") then property,value="LocalTransparencyModifier",1
 elseif object:IsA("Decal") then property,value="Transparency",1
 elseif object:IsA("ParticleEmitter") or object:IsA("Trail") or object:IsA("Beam") then property,value="Enabled",false
 elseif object:IsA("BillboardGui") then property,value="Enabled",false
 elseif object:IsA("Humanoid") then property,value="DisplayDistanceType",Enum.HumanoidDisplayDistanceType.None end
 if property then
  record.Saved[object]={[property]={Original=object[property],Applied=value}}
  object[property]=value
 end
end
function Profiles.Start(assets,record,char,root)
 if assets.Profile=="None" then return end
 if assets.Profile=="InvisibleAvatar" then
  for _,v in ipairs(char:GetDescendants()) do hide(record,v) end
  record.Connection=char.DescendantAdded:Connect(function(v) hide(record,v) end)
 elseif assets.Profile~="AttachmentEffect" then return end
 local templates=RS:FindFirstChild("AbilityEffects")
 local template=templates and templates:FindFirstChild(assets.Key)
 local origin=template and template:FindFirstChild("Origin")
 if not origin then return end
 local asset=origin:Clone();asset:SetAttribute("AbilityPresentation",true);asset.Parent=root
 table.insert(record.Assets,asset)
 for _,v in ipairs(asset:GetDescendants()) do
  if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam") then v.Enabled=true
  elseif v:IsA("Sound") and v.SoundId~="" then v:Play() end
 end
end
return table.freeze(Profiles)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1785">
          <Properties>
            <string name="Name">AbilitySelection</string>
            <string name="Source"><![CDATA[--!nonstrict
local Catalog=require(game.ReplicatedStorage.Shared.AbilityCatalog)
local HttpService=game:GetService("HttpService")
local Selection={}
Selection.__index=Selection
function Selection.new(frame,request,isCurrentSession)
 local self=setmetatable({Frame=frame,Cards={},Connections={},Request=request,IsCurrentSession=isCurrentSession},Selection)
 frame.Visible=false
 return self
end
function Selection:_buildCards()
 local catalog=Catalog.Get()
 if self.CatalogVersion==catalog.Version then return end
 self.CatalogVersion=catalog.Version
 for _,connection in ipairs(self.Connections) do connection:Disconnect() end
 for _,card in pairs(self.Cards) do card:Destroy() end
 self.Connections={};self.Cards={}
 local template=self.Frame.Cards.AbilityCardTemplate
 for index,id in ipairs(catalog.Order) do
  local d=catalog.Items[id]
  local card=template:Clone();card.Name=id;card.LayoutOrder=index;card.Visible=true
  card.AbilityName.Text=d.DisplayName
  card.Description.Text=d.Description
  card.Cooldown.Text=string.format("CD %ds · duración %ss",d.Cooldown,if d.DurationKind=="Instant" then "instantánea" else tostring(d.Duration))
  card.Icon.Image=d.Icon;card.Icon.Visible=d.Icon~=""
  card.Parent=self.Frame.Cards;self.Cards[id]=card
  table.insert(self.Connections,card.Activated:Connect(function()
   if self.IsOpen and self:CanOpen() and self.Payload.Owned[id] and not self.Pending then
    local requestId=HttpService:GenerateGUID(false)
    self.Pending={RequestId=requestId,WindowId=self.Payload.WindowId,PreparationId=self.Payload.PreparationId}
    self.Request(id,self.Payload,requestId)
   end
  end))
 end
end
function Selection:Render(payload)
 self:_buildCards()
 local key=payload.SessionId and payload.PreparationId and payload.WindowId
  and (payload.SessionId.."/"..payload.PreparationId.."/"..payload.WindowId)
 if key~=self.WindowKey then self:Close();self.WindowKey=key end
 self.Payload=payload
 if not self:CanOpen() then self:Close() end
 local receipt=payload.SelectionReceipt
 if self.Pending and receipt and receipt.RequestId==self.Pending.RequestId
  and receipt.WindowId==self.Pending.WindowId and receipt.PreparationId==self.Pending.PreparationId then
  self.Pending=nil
  if receipt.Accepted and receipt.AbilityId==payload.AbilityId then self:Close() end
 end
 for id,card in pairs(self.Cards) do
  local owned=payload.Owned[id]==true
  card.Active=owned and self:CanOpen() and self.Pending==nil
  card.Status.Text=if not owned then "BLOQUEADA · SHOP" elseif payload.AbilityId==id then "CONFIRMADA" else "SELECCIONAR"
  card.BackgroundTransparency=if owned then 0.05 else 0.45
 end
end
function Selection:CanOpen()
 local p=self.Payload
 return p~=nil and p.Selecting==true and not p.Playing and type(p.SelectionUntil)=="number"
  and p.SelectionUntil>workspace:GetServerTimeNow() and p.PreparationId~=nil and p.WindowId~=nil
  and (p.PreparationState=="StartCountdown" or p.PreparationState=="PointRestartCountdown")
  and (not self.IsCurrentSession or self.IsCurrentSession(p))
end
function Selection:Open()
 if not self:CanOpen() then self:Close();return false end
 self.IsOpen=true;self.Frame.Visible=true;return true
end
function Selection:Close()
 self.IsOpen=false;self.Pending=nil;self.Frame.Visible=false
end
function Selection:Tick()
 if not self:CanOpen() then self:Close() end
 if self.Payload and self:CanOpen() then
  self.Frame.Title.Text=string.format("ELEGÍ TU HABILIDAD · %ds",math.max(0,math.ceil(self.Payload.SelectionUntil-workspace:GetServerTimeNow())))
 end
end
function Selection:Destroy()
 self:Close()
 for _,c in ipairs(self.Connections) do c:Disconnect() end
 for _,c in pairs(self.Cards) do c:Destroy() end
end
return Selection
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="LocalScript" referent="1786">
        <Properties>
          <string name="Name">AnimacionLetras1v1</string>
          <string name="Source"><![CDATA[--[[
	====================================================================
	SISTEMA DE SECUENCIA DE ANIMACIONES EN BUCLE CON CROSSFADE (MULTI-ZONA)
	====================================================================

	Recorre TODAS las carpetas dentro de Workspace.ZoneMatchmaking que
	contengan un subfolder "text" y anima sus modelos de letras
	(front / shadow). Cada carpeta puede tener SU PROPIA secuencia.

	CÓMO CONFIGURAR CADA CARPETA (atributos en la propia carpeta,
	por ej. Workspace.ZoneMatchmaking.1v1):
	- "Secuencia" (String): Números separados por coma. Ej: "3, 4, 5"
	- "DuracionFase" (Number): Segundos por animación (por defecto 4.0).
	- "TiempoTransicion" (Number): Segundos de fundido entre fases (0.6).

	Si una carpeta no tiene "Secuencia", usa SECUENCIA_DEFAULT.

	CATÁLOGO DE ANIMACIONES:
		0  = Apagada     |  5 = Glitch       |  9 = Shockwave
		1  = Ola         |  6 = Bamboleo     | 10 = Respiración
		2  = Pulso       |  7 = Latido       | 11 = Twist 3D
		3  = Rebote      |  8 = Péndulo      | 12 = Alerta
		4  = Flotación   |
	====================================================================
]]

local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

-- Secuencia por defecto si una carpeta no define el atributo "Secuencia"
local SECUENCIA_DEFAULT = {
	{ id = 1, duracion = 5.0 },
	{ id = 3, duracion = 4.0 },
	{ id = 7, duracion = 4.5 },
}

local DURACION_FASE_DEFAULT = 4.0
local TIEMPO_TRANSICION_DEFAULT = 0.6

-- 1. Carpeta raíz
local raiz = Workspace:WaitForChild("ZoneMatchmaking", 10)
if not raiz then warn("[AnimacionLetras] Falta ZoneMatchmaking") return end

-- Catálogo matemático de animaciones
local animaciones = {
	[0] = function() return 0, 1, 1, 0, 0 end,

	[1] = function(t, i)
		local s = math.sin(t * 2.2 - i * 0.45)
		local u = s * 0.5 + 0.5
		local esc = 1 + 0.15 * u
		return s * 0.8, esc, esc, 0, 0
	end,

	[2] = function(t)
		local u = math.sin(t * 2.5) * 0.5 + 0.5
		local esc = 1 + 0.25 * u
		return u * 0.4, esc, esc, 0, 0
	end,

	[3] = function(t, i, alto)
		local ciclo = (t * 1.2 - i * 0.09) % 1
		local dy, sxz, sy = 0, 1, 1
		if ciclo < 0.6 then
			local h = math.sin(math.pi * ciclo / 0.6)
			dy = h * 1.3
			sy = 1 + 0.12 * h
			sxz = 1 - 0.04 * h
		elseif ciclo < 0.8 then
			local q = math.sin(math.pi * (ciclo - 0.6) / 0.2)
			sy = 1 - 0.2 * q
			sxz = 1 + 0.1 * q
		end
		dy += (sy - 1) * alto * 0.5
		return dy, sxz, sy, 0, 0
	end,

	[4] = function(t, i)
		local dy = math.sin(t * 1.8 + i * 0.35) * 0.35
		local roll = math.sin(t * 1.4 + i * 0.25) * 0.04
		return dy, 1, 1, roll, 0
	end,

	[5] = function(t, i)
		local shake = math.sin(t * 35 + i * 17) * 0.08
		local pulse = 1 + math.abs(math.sin(t * 18 + i)) * 0.08
		return shake, pulse, pulse, shake * 0.4, 0
	end,

	[6] = function(t, i)
		local rot = math.sin(t * 3 - i * 0.5) * 0.12
		local dy = math.abs(math.sin(t * 3 - i * 0.5)) * 0.2
		return dy, 1, 1, rot, 0
	end,

	[7] = function(t, i)
		local ciclo = (t * 1.1 - i * 0.04) % 1
		local esc = 1
		if ciclo < 0.12 then
			esc = 1 + math.sin(ciclo / 0.12 * math.pi) * 0.3
		elseif ciclo > 0.2 and ciclo < 0.32 then
			esc = 1 + math.sin((ciclo - 0.2) / 0.12 * math.pi) * 0.18
		end
		return (esc - 1) * 0.5, esc, esc, 0, 0
	end,

	[8] = function(t, i)
		local rot = math.sin(t * 2.4 - i * 0.3) * 0.18
		local dy = -math.abs(rot) * 0.3
		return dy, 1, 1, rot, 0
	end,

	[9] = function(t, i, alto)
		local ciclo = (t * 0.9 - i * 0.07) % 1
		local dy, sy, sxz = 0, 1, 1
		if ciclo < 0.15 then
			local p = math.sin(ciclo / 0.15 * math.pi)
			sy = 1 - 0.25 * p
			sxz = 1 + 0.2 * p
			dy = -(1 - sy) * alto * 0.5
		elseif ciclo < 0.5 then
			local p = math.sin((ciclo - 0.15) / 0.35 * math.pi)
			dy = p * 1.1
			sy = 1 + 0.15 * p
			sxz = 1 - 0.05 * p
		end
		return dy, sxz, sy, 0, 0
	end,

	[10] = function(t)
		local u = math.sin(t * 1.4) * 0.5 + 0.5
		local esc = 1 + 0.18 * (u ^ 2)
		return (esc - 1) * 0.3, esc, esc, 0, 0
	end,

	[11] = function(t, i)
		local rotZ = math.sin(t * 2.5 - i * 0.4) * 0.1
		local rotX = math.cos(t * 2.5 - i * 0.4) * 0.12
		local dy = math.sin(t * 2.5 - i * 0.4) * 0.25
		return dy, 1, 1, rotZ, rotX
	end,

	[12] = function(t, i)
		local ciclo = (t * 3.5) % 1
		local pulse = (ciclo < 0.4) and (1 + math.sin(ciclo / 0.4 * math.pi) * 0.22) or 1
		local shake = math.sin(t * 40 + i * 5) * 0.05
		return (pulse - 1) * 0.3, pulse, pulse, shake, 0
	end,
}

local function lerp(a, b, w)
	return a + (b - a) * w
end

-- Espera a que un modelo tenga partes cargadas
local function esperarCargaPartes(modelo)
	local partes = {}
	local timeout = os.clock() + 5
	repeat
		partes = {}
		for _, desc in ipairs(modelo:GetDescendants()) do
			if desc:IsA("BasePart") then
				table.insert(partes, desc)
			end
		end
		if #partes == 0 then task.wait(0.2) end
	until #partes > 0 or os.clock() > timeout
	return partes
end

local function reunir(modelo)
	local lista = esperarCargaPartes(modelo)
	table.sort(lista, function(a, b)
		return a.Position.Z < b.Position.Z
	end)
	return lista
end

-- Devuelve true si el nombre parece de letra frontal o sombra
local function esModeloDeLetras(nombre)
	local n = string.lower(nombre)
	return string.find(n, "front", 1, true) ~= nil or string.find(n, "shadow", 1, true) ~= nil
end

-- Lee la secuencia de una carpeta (atributo "Secuencia") o cae a la default
local function obtenerSecuencia(carpeta)
	local attr = carpeta:GetAttribute("Secuencia")
	if type(attr) == "string" and #attr > 0 then
		local lista = {}
		local dur = tonumber(carpeta:GetAttribute("DuracionFase")) or DURACION_FASE_DEFAULT
		for token in string.gmatch(attr, "[^,%s]+") do
			local id = tonumber(token)
			if id then
				table.insert(lista, { id = id, duracion = dur })
			end
		end
		if #lista > 0 then return lista end
	end
	return SECUENCIA_DEFAULT
end

-- Arranca la animación para una zona (carpeta con subfolder "text")
local function animarZona(carpeta)
	local textFolder = carpeta:WaitForChild("text", 10)
	if not textFolder then
		warn("[AnimacionLetras] Falta 'text' en " .. carpeta.Name)
		return
	end

	-- Reunir SOLO los modelos de letras (front / shadow)
	local letras = {}
	for _, hijo in ipairs(textFolder:GetChildren()) do
		if hijo:IsA("Model") and esModeloDeLetras(hijo.Name) then
			local partes = reunir(hijo)
			for i, parte in ipairs(partes) do
				table.insert(letras, {
					parte = parte,
					i = i,
					cf = parte.CFrame,
					size = parte.Size,
				})
			end
		end
	end

	if #letras == 0 then
		warn("[AnimacionLetras] Sin modelos de letras en " .. carpeta.Name)
		return
	end

	local t0 = os.clock()
	local updateSignal = RunService:IsClient() and RunService.RenderStepped or RunService.Heartbeat

	updateSignal:Connect(function()
		local t = os.clock() - t0
		local secuencia = obtenerSecuencia(carpeta)
		local transicion = tonumber(carpeta:GetAttribute("TiempoTransicion")) or TIEMPO_TRANSICION_DEFAULT

		local duracionTotal = 0
		for _, paso in ipairs(secuencia) do
			duracionTotal += paso.duracion
		end
		if duracionTotal <= 0 then return end

		local tCiclo = t % duracionTotal
		local acumulado = 0
		local indiceActual = 1
		local tiempoEnFase = 0

		for idx, paso in ipairs(secuencia) do
			if tCiclo >= acumulado and tCiclo < (acumulado + paso.duracion) then
				indiceActual = idx
				tiempoEnFase = tCiclo - acumulado
				break
			end
			acumulado += paso.duracion
		end

		local pasoActual = secuencia[indiceActual]
		local siguienteIndice = (indiceActual % #secuencia) + 1
		local pasoSiguiente = secuencia[siguienteIndice]

		local fActual = animaciones[pasoActual.id] or animaciones[0]
		local fSiguiente = animaciones[pasoSiguiente.id] or animaciones[0]

		local pesoMezcla = 0
		local tiempoRestante = pasoActual.duracion - tiempoEnFase
		if tiempoRestante < transicion then
			local p = 1 - (tiempoRestante / transicion)
			pesoMezcla = p * p * (3 - 2 * p)
		end

		for _, l in ipairs(letras) do
			local dy1, sxz1, sy1, rz1, rx1 = fActual(t, l.i, l.size.Y)
			local dy, sxz, sy, rz, rx = dy1, sxz1, sy1, rz1 or 0, rx1 or 0

			if pesoMezcla > 0 then
				local dy2, sxz2, sy2, rz2, rx2 = fSiguiente(t, l.i, l.size.Y)
				dy = lerp(dy1, dy2, pesoMezcla)
				sxz = lerp(sxz1, sxz2, pesoMezcla)
				sy = lerp(sy1, sy2, pesoMezcla)
				rz = lerp(rz1 or 0, rz2 or 0, pesoMezcla)
				rx = lerp(rx1 or 0, rx2 or 0, pesoMezcla)
			end

			l.parte.Size = Vector3.new(l.size.X * sxz, l.size.Y * sy, l.size.Z * sxz)
			l.parte.CFrame = (l.cf + Vector3.new(0, dy, 0)) * CFrame.Angles(rx, 0, rz)
		end
	end)
end

-- Arrancar zonas ya presentes
for _, hijo in ipairs(raiz:GetChildren()) do
	if hijo:IsA("Folder") and hijo:FindFirstChild("text") then
		task.spawn(animarZona, hijo)
	end
end

-- Detectar zonas nuevas (clones, carpetas añadidas en runtime)
raiz.ChildAdded:Connect(function(hijo)
	if hijo:IsA("Folder") then
		local textFolder = hijo:WaitForChild("text", 10)
		if textFolder then
			task.spawn(animarZona, hijo)
		end
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="1787">
        <Properties>
          <string name="Name">ClientBootstrap</string>
          <string name="Source"><![CDATA[--!strict
local StarterPlayerScripts = script.Parent
local ControllersFolder = StarterPlayerScripts:WaitForChild("Controllers", 10)
assert(ControllersFolder, "[ClientBootstrap] No se encontro StarterPlayerScripts.Controllers")

local loadedControllers: { [string]: any } = {}
local initializedControllers = {}

for _, child in ipairs(ControllersFolder:GetChildren()) do
	if child:IsA("ModuleScript") then
		local ok, result = pcall(require, child)
		if ok then
			loadedControllers[child.Name] = result
		else
			warn(string.format("[ClientBootstrap] Error al requerir %s: %s", child.Name, tostring(result)))
		end
	end
end

local context = {
	Controllers = loadedControllers,
	GetController = function(_self, name: string)
		return loadedControllers[name]
	end,
}

for name, controller in pairs(loadedControllers) do
	if type(controller.Init) == "function" then
		local ok, err = pcall(function()
			controller:Init(context)
		end)
		if ok then
			table.insert(initializedControllers, name)
		else
			warn(string.format("[ClientBootstrap] Error en Init() de %s: %s", name, tostring(err)))
		end
	end
end

for name, controller in pairs(loadedControllers) do
	if type(controller.Start) == "function" then
		local ok, err = pcall(function()
			controller:Start(context)
		end)
		if not ok then
			warn(string.format("[ClientBootstrap] Error en Start() de %s: %s", name, tostring(err)))
		end
	end
end

print(string.format("[ClientBootstrap] Controladores inicializados: %s", table.concat(initializedControllers, ", ")))
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="1788">
        <Properties>
          <string name="Name">Controllers</string>
        </Properties>
        <Item class="ModuleScript" referent="1789">
          <Properties>
            <string name="Name">AbilityController</string>
            <string name="Source"><![CDATA[--!nonstrict
local Players=game:GetService("Players")
local RS=game:GetService("ReplicatedStorage")
local UIS=game:GetService("UserInputService")
local RunService=game:GetService("RunService")
local Definitions=require(RS.Shared.AbilityDefinitions)
local Catalog=require(RS.Shared.AbilityCatalog)
local Diagnostics=require(RS.Shared.AbilityDiagnostics)
local Presentation=require(script.Parent.Parent.Abilities.AbilityPresentation)
local Selection=require(script.Parent.Parent.Abilities.AbilitySelection)
local Controller={Name="AbilityController"}
function Controller:_trace(phase,reason,p,extra)
 if not Diagnostics.Enabled() then return end
 local row={UserId=Players.LocalPlayer.UserId,SessionId=p and p.SessionId,RoundId=p and p.RoundId,
  AbilityId=p and p.AbilityId,Playing=p and p.Playing,Preparing=p and p.Preparing,
  Generation=p and p.CharacterGeneration,LifeId=p and p.LifeId,Reason=reason}
 for key,value in pairs(extra or {})do row[key]=value end
 Diagnostics.Emit("Client",phase,row)
end
function Controller:Init(context)
 self._context=context;self._connections={};self._revision=0;self._lastRequest=0;self._presentation=Presentation.new()
 self._traceState=nil;self._inputSource=nil
end
function Controller:_send(action)
 local p=self._payload
 if not p or not p.Playing then self:_trace("InputBlocked","NoPlayingSnapshot",p);return end
 if os.clock()-self._lastRequest<Definitions.RequestInterval then self:_trace("InputBlocked","ClientRateLimited",p);return end
 local char=Players.LocalPlayer.Character
 local hum=char and char:FindFirstChildOfClass("Humanoid")
 if not hum or hum.WalkSpeed<=0 or hum.PlatformStand or char:GetAttribute("ArenaRespawnPending") then
  self:_trace("InputBlocked","CharacterMovementBlocked",p);return
 end
 self._lastRequest=os.clock()
 local traceId=Diagnostics.NewTrace()
 self:_trace("RequestSent",nil,p,{TraceId=traceId,Action=action,Source=self._inputSource})
 self._request:FireServer({Action=action,SessionId=p.SessionId,RoundId=p.RoundId,
  CharacterGeneration=char:GetAttribute("ArenaPhysicsGeneration") or 0,AbilityId=p.AbilityId,
  ActivationId=p.ActivationId,LifeId=p.LifeId,Direction=hum.MoveDirection,TraceId=traceId})
end
function Controller:_activate()
 local p=self._payload
 local d=p and Catalog.GetItem(p.AbilityId)
 if not d then self:_trace("InputBlocked","CatalogEntryMissing",p);return end
 self:_send(if p.ActivationId and d.Input.ActivePrimaryAction then d.Input.ActivePrimaryAction else "Activate")
end
function Controller:_render()
 local p=self._payload;if not p or not self._hud then return end
 local char=Players.LocalPlayer.Character
 local matching=p.SessionId~=nil and p.SessionId==Players.LocalPlayer:GetAttribute("MatchId")
 self._hud.Enabled=matching and (p.Preparing or p.Playing)
 self._selection:Tick()
 self._hud.ChangeAbilityButton.Visible=matching and self._selection:CanOpen()
 self._hud.ChangeAbilityButton.Active=self._hud.ChangeAbilityButton.Visible
 local button=self._hud.AbilityButton
 button.Visible=matching and (p.Preparing or p.Playing)
 if not button.Visible then return end
 local d=Catalog.GetItem(p.AbilityId)
 if not d then button.Visible=false;return end
 local t=workspace:GetServerTimeNow()
 local cooldown=math.max(0,(p.CooldownUntil or 0)-t)
 local remaining=math.max(0,(p.ActiveUntil or 0)-t)
 local hum=char and char:FindFirstChildOfClass("Humanoid")
 local blocked=not hum or hum.WalkSpeed<=0 or hum.PlatformStand or char:GetAttribute("ArenaRespawnPending")
 button.AbilityName.Text=d.DisplayName
 button.Icon.Image=d.Icon;button.Icon.Visible=d.Icon~=""
 button.CooldownLabel.Text=if not p.Playing then "PREPARACIÓN" elseif blocked then "BLOQUEADA" elseif remaining>0 then
  string.format("%s · %.1fs",d.ActiveLabel,remaining)
  elseif cooldown>0 then string.format("%.1fs",cooldown) else (if UIS.TouchEnabled then "ACTIVAR" else "E · LISTA")
 button.CooldownOverlay.Visible=cooldown>0 and remaining<=0
 button.Active=p.Playing==true and not blocked and (cooldown<=0 or (remaining>0 and d.Input.ActivePrimaryAction~=nil))
 button.AutoButtonColor=button.Active
end
function Controller:Start(_context)
 task.spawn(function()
  local combat=RS:WaitForChild("Remotes"):WaitForChild("Combat")
  self._request=combat:WaitForChild("AbilityRequest",15)
  local state=combat:WaitForChild("AbilityState",15)
  self._hud=Players.LocalPlayer:WaitForChild("PlayerGui"):WaitForChild("AbilityHUD",15)
  if not self._request or not state or not self._hud then warn("[AbilityController] PhysicalResourcesMissing");return end
  self._selection=Selection.new(self._hud.AbilitySelectionFrame,function(id,p,requestId)
   self._request:FireServer({Action="Select",SessionId=p.SessionId,WindowId=p.WindowId,
    PreparationId=p.PreparationId,AbilityId=id,RequestId=requestId})
  end,function(p) return p.SessionId==Players.LocalPlayer:GetAttribute("MatchId") end)
  table.insert(self._connections,self._hud.ChangeAbilityButton.Activated:Connect(function()
   self._selection:Open()
  end))
  table.insert(self._connections,state.OnClientEvent:Connect(function(p)
   if type(p)~="table" then return end
   if p.Kind=="AbilityDiagnostic" then
    self:_trace("ServerResult",p.Reason,p,{TraceId=p.TraceId,ActivationId=p.ActivationId,Result=p.Result});return
   end
   if p.Kind=="AbilityCue" then self._presentation:Impact(p);return end
   if p.Kind~="State" or type(p.Revision)~="number" or p.Revision<=self._revision then return end
   if p.Catalog then Catalog.Apply(p.Catalog) end
   self._revision=p.Revision;self._payload=p
   if Diagnostics.Enabled() then
    local key=table.concat({tostring(p.SessionId),tostring(p.RoundId),tostring(p.State),tostring(p.AbilityId),tostring(p.ActivationId),tostring(p.LifeId),tostring(p.Playing),tostring(p.Preparing)},"/")
    if key~=self._traceState then
     self._traceState=key;self:_trace("SnapshotChanged",p.State,p,{ActivationId=p.ActivationId,CatalogVersion=Catalog.Get().Version})
    end
   end
   self._selection:Render(p);self._presentation:Reconcile(p);self:_render()
  end))
  table.insert(self._connections,self._hud.AbilityButton.Activated:Connect(function()
   self._inputSource="AbilityButton";self:_trace("InputDetected",nil,self._payload,{Source=self._inputSource});self:_activate()
  end))
  table.insert(self._connections,UIS.InputBegan:Connect(function(input,processed)
   if input.KeyCode==Enum.KeyCode.E then
    self._inputSource="E"
    self:_trace("InputDetected",if processed then "Processed" elseif UIS:GetFocusedTextBox() then "TextBoxFocused" else "Eligible",self._payload,{Source="E"})
    if not processed and not UIS:GetFocusedTextBox() then self:_activate() end
   end
  end))
  table.insert(self._connections,UIS.JumpRequest:Connect(function()
   local p=self._payload
   local d=p and Catalog.GetItem(p.AbilityId)
   if d and p.ActivationId and d.Input.JumpAction then self:_send(d.Input.JumpAction) end
  end))
  table.insert(self._connections,Players.LocalPlayer:GetAttributeChangedSignal("MatchId"):Connect(function()
   self._presentation:Clear();self:_render()
  end))
  table.insert(self._connections,RunService.RenderStepped:Connect(function()
   self:_render();self._presentation:Tick()
  end))
  self._request:FireServer({Action="Sync"})
  self:_trace("Ready",nil,nil,{RemotesReady=true,CatalogVersion=Catalog.Get().Version})
 end)
end
function Controller:Destroy()
 Diagnostics.Forget("Client",Players.LocalPlayer.UserId)
 for _,c in ipairs(self._connections) do c:Disconnect() end
 self._presentation:Clear()
 if self._selection then self._selection:Destroy() end
 if self._hud then self._hud.Enabled=false end
end
return Controller
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1790">
          <Properties>
            <string name="Name">CrateController</string>
            <string name="Source"><![CDATA[--!nonstrict
local Players=game:GetService("Players")
local RS=game:GetService("ReplicatedStorage")
local TweenService=game:GetService("TweenService")
local Http=game:GetService("HttpService")
local Chat=game:GetService("TextChatService")
local Catalog=require(RS.Shared.SlapCrates.Catalog)
local Appearance=require(RS.Shared.SlapCrates.Appearance)
local View=require(RS.Shared.SlapCrates.CrateShopView)
local OddsPresentation=require(RS.Shared.SlapCrates.OddsPresentation)
local OpeningConfig=require(RS.Shared.SlapCrates.OpeningConfig)
local Batch=require(RS.Shared.SlapCrates.BatchOpening)
local Controller={}
local ERRORS={CommercialApprovalPending="Precio y probabilidades pendientes de aprobación.",ProductionBackendBlocked="Ventas bloqueadas: backend productivo pendiente.",
 PaidRandomItemsRestricted="Esta apertura no está habilitada por las políticas de Roblox o no se pudo verificar elegibilidad.",
 OddsChanged="Cambió el stock o la probabilidad. Volvé a consultar antes de continuar.",ViewOddsFirst="Consultá las probabilidades actuales primero.",
 LobbyOnly="Solo podés abrir cajas en el lobby.",InsufficientFunds="Coins insuficientes.",NoCrate="No tenés cajas cerradas.",
 NoEligibleResults="No quedan premios elegibles para vos.",RateLimited="Esperá un momento y reintentá.",DataNotLoaded="Esperá a que cargue tu perfil."}
function Controller:Init(context)
 self._context=context;self._connections={};self._seen={};self._worldSeen={};self._chatSeen={};self._worldModels={};self._pending={};self._busy=false
 self._products={};self._quoteCache={};self._snapshotVersion=0;self._selectionVersion=0;self._quoteVersion=0
 self._openQuantity=1
end
function Controller:SetCatalog(products)
 for _,product in ipairs(products)do if product.Category=="Crates"then self._products[product.Id]=product end end
end
function Controller:SetSnapshot(data,fromEvent)
 if type(data)~="table"then return end
 self._data=data;self._inventory=data.Inventory;self._snapshotVersion+=1
 self:_renderPanel()
 if not fromEvent and self._context and self._context.GetController then
  local shop=self._context:GetController("ShopController")
  if shop then
   local merged=table.clone(shop._playerData or {});for k,v in pairs(data)do merged[k]=v end;shop._playerData=merged
   if shop._refreshStates then shop:_refreshStates()end
  end
 end
end
function Controller:GetView(product,snapshot)
 local state=View.State(product,snapshot or self._data,self._quoteCache[product.Id],workspace:GetServerTimeNow(),self._busy or self._quoting)
 local quantity=self._openQuantity or 1
 if quantity>state.Quantity then state.OpenEnabled=false end
 local cinematic=self._context and self._context.GetController and self._context:GetController("CrateStandCinematicController")
 if cinematic and cinematic.IsPlaying and cinematic:IsPlaying()then state.OpenEnabled=false end
 return state
end
function Controller:_renderPanel()
 if not self._panel or not self._crateId then return end
 local product=self._products[self._crateId];if not product then return end
 local state=self:GetView(product)
 self._panel.Count.Text="Cajas: "..state.Quantity.." · Saldo: "..state.CoinsText
 self._panel.Status.Text=state.Status
 self._panel.Buy.Text=state.BuyText;self._panel.Open.Text=state.OpenText
 local quantity=self._openQuantity or 1
 self._panel.Open.Text="ABRIR x"..quantity
 if state.Quantity<quantity and not state.NeedQuote then self._panel.Status.Text="Faltan "..(quantity-state.Quantity).." cajas para abrir x"..quantity end
 local selector=self._panel:FindFirstChild("OpenQuantities")
 if selector then for _,q in ipairs(OpeningConfig.AllowedOpenQuantities)do
  local button=selector:FindFirstChild("X"..q)
  if button then
   button.Active=not self._busy and not self._pendingAction and not state.NeedQuote and state.Quantity>=q and (OpeningConfig.Mode=="StandCinematic"or q==1)
   button.Text=if state.Quantity>=q then "x"..q else "x"..q.." · Faltan "..(q-state.Quantity)
   button.AutoButtonColor=button.Active;button:SetAttribute("Selected",quantity==q)
   button.BackgroundTransparency=if quantity==q then 0 else .4
   button.TextTransparency=if state.Quantity>=q and button.Active then 0 else .55
  end
 end end
 self._panel.Buy.Active=state.BuyEnabled;self._panel.Open.Active=state.OpenEnabled
 self._panel.ViewOdds.Active=not self._busy and not self._quoting
 local pending=self._pendingAction
 if pending then
  self._panel.Buy.Active=false;self._panel.Open.Active=false
  if pending.CrateId==self._crateId and not self._busy then
   local button=if pending.Kind=="Purchase"then self._panel.Buy else self._panel.Open
   button.Active=true;button.Text=if pending.Kind=="Open"then "REINTENTAR x"..(pending.Args.Quantity or 1)else "REINTENTAR"
   self._panel.Status.Text="Operación sin confirmar: reintentá sin crear otra compra."
  end
 end
 self._panel.Buy.AutoButtonColor=self._panel.Buy.Active;self._panel.Open.AutoButtonColor=self._panel.Open.Active
end
function Controller:_call(action,args)
 local ok,result=pcall(self._request.InvokeServer,self._request,action,args or {})
 return if ok and type(result)=="table" then result else {Ok=false,Code="NoResponse"}
end
function Controller:_status(result)
 self._panel.Status.Text=if result.Ok then "Operación confirmada." else (View.Errors[result.Code]or ERRORS[result.Code] or tostring(result.Code))
end
function Controller:ShowCrate(id)
 if self._busy or not self._panel or not self._request or not self._products[id] then return end
 if self._pendingAction and self._pendingAction.CrateId~=id then return end
 self._selectionVersion+=1;local selection=self._selectionVersion
 self._crateId=id;self._openQuantity=if self._pendingAction then(self._pendingAction.Args.Quantity or 1)else 1
 self._quote=nil;self._quoteCache[id]=nil;self._quoting=true;self._panel.Visible=true
 self._panel.Title.Text=self._products[id].DisplayName
 self._panel.Buy.Active=false;self._panel.Open.Active=false
 self._panel.Outcomes.Text="Consultando resultados y elegibilidad…"
 local oddsList=self._panel:FindFirstChild("OddsList")
 if oddsList then oddsList.Visible=false;self._panel.Outcomes.Visible=true end
 task.spawn(function()
  local revision=self._snapshotVersion
  local inventory=self:_call("Inventory",{})
  if self._crateId~=id or self._selectionVersion~=selection then return end
  if inventory.Ok and revision==self._snapshotVersion then self:SetSnapshot(inventory.Snapshot) end
  task.wait(.3)
  if self._selectionVersion==selection then self:_quoteCurrent(id)end
 end)
end
function Controller:_renderOdds(result)
 local list=self._panel:FindFirstChild("OddsList")
 if not list then return end -- Compatibility with older isolated UI fixtures.
 for _,child in ipairs(list:GetChildren())do if child:IsA("GuiObject")and child~=list.RowTemplate then child:Destroy()end end
 self._panel.Outcomes.Visible=false;list.Visible=true
 local header=list.RowTemplate:Clone();header.Name="QuoteHeader";header.Visible=true;header.LayoutOrder=0
 local expired=result.Ok and type(result.ExpiresAt)=="number"and workspace:GetServerTimeNow()>=result.ExpiresAt
 header.Text=if result.Ok then (if expired then "QUOTE VENCIDO · VOLVÉ A CONSULTAR\n"elseif result.ReviewOnly then "REVISIÓN · COMPRA BLOQUEADA\n"else "Probabilidades efectivas\n")..tostring(result.PriceCoins).." Coins · "..tostring(result.Scope)else (View.Errors[result.Code]or tostring(result.Code))
 header.Parent=list
 if result.Ok and result.BatchOddsNotice then
  local notice=list.RowTemplate:Clone();notice.Name="BatchOddsNotice";notice.Visible=true;notice.LayoutOrder=1;notice.Text=result.BatchOddsNotice;notice.Parent=list
  notice.TextWrapped=true;notice.AutomaticSize=Enum.AutomaticSize.Y
 end
 for i,row in ipairs(OddsPresentation.Rows(result))do
  local label=list.RowTemplate:Clone();label.Name="Outcome_"..i;label.Visible=true;label.LayoutOrder=i
  label.LayoutOrder=i+1;label.Text=row.Text;if row.Color then label.TextColor3=row.Color end;label.Parent=list
 end
 list.CanvasPosition=Vector2.zero
end
function Controller:_quoteCurrent(id)
 if id~=self._crateId or self._busy then return end
 self._quoteVersion+=1;local query=self._quoteVersion;local selection=self._selectionVersion
 local revision=self._snapshotVersion;self._quoting=true;self:_renderPanel()
 local result=self:_call("Quote",{CrateId=id})
 if id~=self._crateId or query~=self._quoteVersion or selection~=self._selectionVersion then return end
 self._quoting=false;self._quoteCache[id]=result;self._quote=if result.Ok then result else nil
 if result.Ok and revision==self._snapshotVersion then self:SetSnapshot(result.Snapshot)end
 if result.Ok then
  local lines={"Probabilidades finales por recompensa — "..result.Scope,"Precio: "..result.PriceCoins.." Coins"}
  for _,row in ipairs(result.Outcomes)do
   table.insert(lines,row.DisplayName.." — "..string.format("%.10g",row.Percent).." % | "..(row.Stock.UnlimitedStock and "Ilimitado" or tostring(row.Stock.RemainingStock).." disponibles"))
  end
  self._panel.Outcomes.Text=table.concat(lines,"\n")
 else
  local state=self:GetView(self._products[id]);self._panel.Outcomes.Text=state.Status
 end
 self:_renderOdds(result)
 self:_renderPanel()
 local shop=self._context and self._context.GetController and self._context:GetController("ShopController")
 if shop and shop._refreshStates then shop:_refreshStates()end
 if result.Ok then task.delay(30,function()if self._quoteCache[id]==result then self:_renderPanel();if self._crateId==id then self:_renderOdds(result)end;if shop and shop._refreshStates then shop:_refreshStates()end end end)end
end
function Controller:_mutate(action)
 if self._busy or self._quoting or not self._crateId or(action~="Purchase"and action~="Open")then return end
 local id=self._crateId;local key=id..":"..action;local pending=self._pendingAction
 if pending and pending.Key~=key then return end
 if not pending then
  local state=self:GetView(self._products[id]);local allowed=if action=="Purchase"then state.BuyEnabled else state.OpenEnabled
  if not allowed or not self._quote then self:_renderPanel();return end
  pending={Key=key,CrateId=id,Kind=action,Args={CrateId=id,QuoteToken=self._quote.Token,OperationId=Http:GenerateGUID(false),StandId=self._standId,Quantity=if action=="Open"then(self._openQuantity or 1)else nil}}
  self._pendingAction=pending
 end
 self._busy=true;self:_renderPanel()
 task.spawn(function()
  local revision=self._snapshotVersion
  local result=self:_call(action,pending.Args)
  self._busy=false
  if result.Ok then
   self._pendingAction=nil
   if revision==self._snapshotVersion then self:SetSnapshot(result.Snapshot)end
   if action=="Open"then
    if not result.Presentation or result.Presentation.Mode=="Spin"then
     self:_spin({OpeningId=result.Operation.UnitId,Operation=result.Operation,Duration=Catalog.Crates.ById[id].RollDuration})
    end
    self._quote=nil;self._quoteCache[id]=nil
    self:_renderOdds({Ok=false,Code="ViewOddsFirst"})
   end
  elseif result.Code~="NoResponse" and result.Code~="InternalError"and result.Code~="RateLimited"and result.Code~="DataNotLoaded"and result.Code~="TransactionInProgress"and result.Code~="StockCommitPending"then
   self._pendingAction=nil;self._quote=nil;self._quoteCache[id]={Ok=false,Code=result.Code}
  end
  self:_renderPanel();if not result.Ok then self:_renderOdds(result);self:_status(result)end
 end)
end
function Controller:_spin(packet)
 if type(packet)~="table" or not packet.OpeningId or self._seen[packet.OpeningId]then return end
 local reward=packet.Operation and Catalog.Rewards[packet.Operation.RewardId]
 if not reward then return end
 self._seen[packet.OpeningId]=true
 if self._tween then self._tween:Cancel()end
 if self._tickConnection then self._tickConnection:Disconnect()end
 local spin=self._spinPanel;spin.Visible=true;spin.Close.Visible=false
 spin.Result.Text="Abriendo…";local strip=spin.Window.RollingStrip
 for _,c in ipairs(strip:GetChildren())do if c:IsA("GuiObject") and c.Name~="RewardTemplate" then c:Destroy()end end
 local ids={}for id in pairs(Catalog.Rewards)do table.insert(ids,id)end;table.sort(ids)
 local winnerIndex=41;local stride=140
 for i=1,45 do
  local r=if i==winnerIndex then reward else Catalog.Rewards[ids[((i*7)%#ids)+1]]
  local card=strip.RewardTemplate:Clone();card.Name="Reward_"..i;card.Visible=true
  card.Position=UDim2.fromOffset((i-1)*stride,0);card.Title.Text=r.DisplayName
  card.BackgroundColor3=Catalog.Variations.ById[r.VariationId].Color;card.Parent=strip
 end
 strip.Position=UDim2.fromOffset(0,0)
 local target=spin.Window.AbsoluteSize.X/2-((winnerIndex-1)*stride+66)
 local lastIndex=0
 self._tickConnection=strip:GetPropertyChangedSignal("Position"):Connect(function()
  local index=math.floor(-strip.Position.X.Offset/stride)
  if index~=lastIndex then lastIndex=index;if spin.Tick.SoundId~="" then spin.Tick:Play()end end
 end)
 local duration=math.clamp(tonumber(packet.Duration) or 5,1,30)
 self._tween=TweenService:Create(strip,TweenInfo.new(duration,Enum.EasingStyle.Quint,Enum.EasingDirection.Out),{Position=UDim2.fromOffset(target,0)})
 local openingId=packet.OpeningId;self._currentSpin=openingId
 self._tween.Completed:Once(function(state)
  if self._currentSpin~=openingId or state~=Enum.PlaybackState.Completed then return end
  if self._tickConnection then self._tickConnection:Disconnect();self._tickConnection=nil end
  spin.Result.Text="Obtuviste "..reward.DisplayName;spin.Close.Visible=true
  if spin.Reveal.SoundId~=""then spin.Reveal:Play()end
 end)
 self._tween:Play()
end
function Controller:_world(packet)
 if not packet.OpeningId or self._worldSeen[packet.OpeningId] or typeof(packet.Position)~="Vector3"then return end
 if Players.LocalPlayer:GetAttribute("MatchId") or Players.LocalPlayer:GetAttribute("ResultsSessionId")then return end
 local root=Players.LocalPlayer.Character and Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
 if not root or (root.Position-packet.Position).Magnitude>80 then return end
 local age=workspace:GetServerTimeNow()-(packet.StartedAt or 0)
 local duration=math.clamp(packet.Duration or 5,1,30);if age>duration+2 then return end
 local model=RS.CrateEffects:FindFirstChild(packet.Model)
 if not model then return end
 self._worldSeen[packet.OpeningId]=true
 local clone=model:Clone();clone.Name="CrateOpening_"..packet.OpeningId
 local vfxTemplate=RS.CrateEffects:FindFirstChild(packet.VFX or packet.Model)
 if vfxTemplate and vfxTemplate~=model then
  local emitter=vfxTemplate:FindFirstChildWhichIsA("ParticleEmitter",true)
  local body=clone:FindFirstChild("Body")
  if emitter and body then emitter:Clone().Parent=body end
 end
 clone:PivotTo(CFrame.new(packet.Position));clone.Parent=workspace;self._worldModels[clone]=true
 local reward=Catalog.Rewards[packet.Operation.RewardId]
 local previews=RS:FindFirstChild("SlapVariationPreviews")
 local slapPreviews=previews and previews:FindFirstChild(reward.SlapId)
 local rewardModel=(slapPreviews and slapPreviews:FindFirstChild(reward.VariationId)) or RS.CrateRewardPreviews:FindFirstChild(reward.SlapId)
 local visual=rewardModel and rewardModel:Clone()
 local stopped=false;local pulse=clone:FindFirstChild("Body")
 if pulse then TweenService:Create(pulse,TweenInfo.new(math.max(.1,duration-age),Enum.EasingStyle.Sine,Enum.EasingDirection.InOut),{Orientation=Vector3.new(0,540,0)}):Play()end
 task.delay(math.max(0,duration-age-.7),function()
  if not clone.Parent then return end
  local lid=clone:FindFirstChild("Lid")
  if lid then TweenService:Create(lid,TweenInfo.new(.5),{Position=packet.Position+Vector3.new(0,3,0),Transparency=1}):Play()end
  if visual then
   visual:PivotTo(CFrame.new(packet.Position+Vector3.new(0,1,0)));visual.Parent=clone
   local v=Catalog.Variations.ById[reward.VariationId]
   local effect=RS.SlapVariationEffects:FindFirstChild(v.VisualProfile)
   local part=visual:FindFirstChildWhichIsA("BasePart",true)
   if part and effect then
    Appearance.Apply(part,effect)
    for _,child in ipairs(effect:GetChildren())do
     if child:IsA("Sound") and child.Name==v.SFX and child.SoundId~=""then local sound=child:Clone();sound.Name="VariationReveal";sound.Parent=part;sound:Play()end
    end
   end
  end
  for _,item in ipairs(clone:GetDescendants())do
   if item:IsA("ParticleEmitter")then
    local burst=item:GetAttribute("RevealBurstCount")
    if type(burst)=="number"then item:Emit(math.clamp(math.floor(burst),0,12))
    elseif item:GetAttribute("SlapVariationEmitter")~=true then item:Emit(18)end
   elseif item:IsA("Sound") and item.Name==packet.SFX and item.SoundId~=""then item:Play()end
  end
 end)
 task.delay(math.max(0,duration-age)+2,function()if not stopped then stopped=true;clone:Destroy();self._worldModels[clone]=nil end end)
end
function Controller:Start()
 task.spawn(function()
  local hud=Players.LocalPlayer:WaitForChild("PlayerGui"):WaitForChild("ShopHUD",15)
  local remotes=RS:WaitForChild("Remotes"):WaitForChild("Crates",15)
  if not hud or not remotes then return end
  self._request=remotes:WaitForChild("Request",10);self._panel=hud:WaitForChild("CratePanel",10);self._spinPanel=hud:WaitForChild("CrateSpinPanel",10)
  if not self._panel or not self._spinPanel or not self._request then warn("[Crates] Missing editable UI");return end
  self._panel.Visible=false;self._spinPanel.Visible=false
  local function on(signal,fn)table.insert(self._connections,signal:Connect(fn))end
  local playerRemotes=RS.Remotes:WaitForChild("Player",10)
  local updated=playerRemotes and playerRemotes:WaitForChild("DataUpdated",10)
  if updated then on(updated.OnClientEvent,function(data)self:SetSnapshot(data,true)end)end
  on(self._panel.Close.Activated,function()self._panel.Visible=false end)
  on(self._panel.Buy.Activated,function()self:_mutate("Purchase")end)
  on(self._panel.Open.Activated,function()self:_mutate("Open")end)
  local selector=self._panel:FindFirstChild("OpenQuantities")
  if selector then for _,quantity in ipairs(OpeningConfig.AllowedOpenQuantities)do
   local button=selector:FindFirstChild("X"..quantity)
   if button then
    on(button.Activated,function()
     if self._busy or self._pendingAction or not button.Active then return end
     self._openQuantity=quantity;self:_renderPanel()
    end)
    on(button.MouseEnter,function()if button.Active then button.TextStrokeTransparency=.35 end end)
    on(button.MouseLeave,function()button.TextStrokeTransparency=1 end)
   end
  end end
  on(self._panel.ViewOdds.Activated,function()if not self._busy then self:_quoteCurrent(self._crateId)end end)
  on(self._panel.Receipt.Activated,function()
   task.spawn(function()
    local result=self:_call("Inventory",{});if not result.Ok then self:_status(result);return end
    local last
    for _,op in pairs(result.Inventory.CrateOperations)do
     if op.Kind=="Open" and (not last or (op.CreatedAt or 0)>(last.CreatedAt or 0))then last=op end
    end
    if last then self._panel.Status.Text=if last.Quantity and last.Quantity>1 then "Lote conservado: "..last.Quantity.." premios · "..last.State else "Premio conservado: "..(Catalog.Rewards[last.RewardId] and Catalog.Rewards[last.RewardId].DisplayName or last.RewardId)
    else self._panel.Status.Text="Todavía no abriste cajas."end
   end)
  end)
  on(self._spinPanel.Close.Activated,function()self._spinPanel.Visible=false end)
  on(remotes.Reveal.OnClientEvent,function(p)self:_spin(p)end)
  on(remotes.World.OnClientEvent,function(p)self:_world(p)end)
  on(remotes.Announce.OnClientEvent,function(p)
   if self._chatSeen[p.OpeningId]then return end
   local reward=Catalog.Rewards[p.RewardId];local crate=Catalog.Crates.ById[p.CrateId]
   if not reward or not crate then return end
   self._chatSeen[p.OpeningId]=true
   local channels=Chat:FindFirstChild("TextChannels");local channel=channels and channels:FindFirstChild("RBXGeneral")
   local name=if type(p.PlayerName)=="string" and p.PlayerName:match("^[%w_]+$")then p.PlayerName else "Jugador "..tostring(p.UserId)
   if channel then channel:DisplaySystemMessage("¡"..name.." obtuvo "..reward.DisplayName.." al abrir "..crate.DisplayName.."!")end
  end)
  on(Players.LocalPlayer:GetAttributeChangedSignal("MatchId"),function()
   if Players.LocalPlayer:GetAttribute("MatchId")then
    self._panel.Visible=false;self._spinPanel.Visible=false
    if self._tween then self._tween:Cancel()end
    for model in pairs(self._worldModels)do model:Destroy()end;table.clear(self._worldModels)
   end
  end)
 end)
end
function Controller:Destroy()
 for _,c in ipairs(self._connections)do c:Disconnect()end
 if self._tickConnection then self._tickConnection:Disconnect()end
 if self._tween then self._tween:Cancel()end
 for model in pairs(self._worldModels)do model:Destroy()end
end
return Controller
]]></string>
          </Properties>
