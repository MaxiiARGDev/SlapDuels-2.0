      <Item class="ModuleScript" referent="544">
        <Properties>
          <string name="Name">PlayerDataService</string>
          <string name="Source"><![CDATA[--!strict
-- PlayerDataService
-- Capa de persistencia autoritativa mediante el proveedor seleccionado al arrancar.
-- Gestiona el ciclo de vida de persistencia (Load, Save, BindToClose, Retries, Validación).
-- No contiene lógica económica de gameplay (responsabilidad de PlayerService).

local WinStreak = require(script.Parent.Gameplay.WinStreak)
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Types = require(ReplicatedStorage.Shared.Types)
local DeathSettings = require(ReplicatedStorage.Shared.DeathFeedbackConfig).DeathEffects

type PlayerData = Types.PlayerData
type PlayerDataRecord = Types.PlayerDataRecord
type DataLoadState = Types.DataLoadState

local PlayerDataService = {}
PlayerDataService.Name = "PlayerDataService"

PlayerDataService._context = nil :: any
PlayerDataService._store = nil :: any
PlayerDataService._persistenceInfo = nil :: any
PlayerDataService._loadStates = {} :: { [Player]: DataLoadState }
PlayerDataService._saving = {} :: { [Player]: boolean }
PlayerDataService._bindToCloseConnected = false
PlayerDataService._playerService = nil :: any

-- Función auxiliar para verificar números finitos válidos y no-NaN
local function isValidNumber(val: any): boolean
	return typeof(val) == "number" and val == val and math.abs(val) ~= math.huge
end

-- Función auxiliar para generar Inventory por defecto
local function getDefaultInventory(): Types.PlayerInventory
	return {
		Owned = {
			["PointEffects"] = { ["Basic"] = true },
			["DeathEffects"] = { [DeathSettings.DefaultKillEffectId] = true },
			["Abilities"] = { Dash = true },
		},
		Equipped = {
			["PointEffects"] = "Basic",
			["DeathEffects"] = DeathSettings.DefaultKillEffectId,
			["Abilities"] = "Dash",
		},
	}
end

-- Sanitiza y valida profundamente una estructura de Inventory
local function sanitizeInventory(rawInv: any, warnings: { string }): Types.PlayerInventory
	if type(rawInv) ~= "table" then
		table.insert(warnings, "Inventory is not a table, generated default Inventory")
		return getDefaultInventory()
	end

	local sanitizedOwned: { [string]: { [string]: boolean } } = {}
	local rawOwned = rawInv.Owned
	if type(rawOwned) == "table" then
		for category, items in pairs(rawOwned) do
			if type(category) == "string" and type(items) == "table" then
				local catItems: { [string]: boolean } = {}
				for itemId, isOwned in pairs(items) do
					if type(itemId) == "string" and isOwned == true then
						catItems[itemId] = true
					end
				end
				sanitizedOwned[category] = catItems
			end
		end
	else
		table.insert(warnings, "Inventory.Owned is not a table, initialized empty Owned")
	end

	-- Regla arquitectónica: PointEffects.Basic siempre debe existir
	if not sanitizedOwned["PointEffects"] then
		sanitizedOwned["PointEffects"] = {}
	end
	sanitizedOwned["PointEffects"]["Basic"] = true
	-- Additive initial entitlement within the existing schema; preserve all owned future effects.
	sanitizedOwned["DeathEffects"] = sanitizedOwned["DeathEffects"] or {}
	sanitizedOwned["DeathEffects"][DeathSettings.DefaultKillEffectId] = true
	sanitizedOwned["Abilities"] = sanitizedOwned["Abilities"] or {}
	sanitizedOwned["Abilities"].Dash = true

	local sanitizedEquipped: { [string]: string? } = {}
	local rawEquipped = rawInv.Equipped
	if type(rawEquipped) == "table" then
		for category, equippedId in pairs(rawEquipped) do
			if type(category) == "string" and type(equippedId) == "string" then
				-- Verificar que el ítem realmente se posea en su categoría
				if sanitizedOwned[category] and sanitizedOwned[category][equippedId] == true then
					sanitizedEquipped[category] = equippedId
				else
					table.insert(warnings, string.format("Equipped item '%s' in category '%s' not owned, unequipped", equippedId, category))
				end
			end
		end
	else
		table.insert(warnings, "Inventory.Equipped is not a table, initialized empty Equipped")
	end

	-- Regla arquitectónica: PointEffects.Equipped fallback seguro obligatorio a Basic
	if not sanitizedEquipped["PointEffects"] or not sanitizedOwned["PointEffects"][sanitizedEquipped["PointEffects"]] then
		sanitizedEquipped["PointEffects"] = "Basic"
	end
	if not sanitizedEquipped["DeathEffects"] or sanitizedEquipped["DeathEffects"] == DeathSettings.DefaultFallEffectId then
		sanitizedEquipped["DeathEffects"] = DeathSettings.DefaultKillEffectId
	end
	if not sanitizedEquipped["Abilities"] then sanitizedEquipped["Abilities"] = "Dash" end

		local result = { Owned = sanitizedOwned, Equipped = sanitizedEquipped }
		-- Rich crate inventory is additive; keep units/journal through load/save.
		for _, key in ipairs({"Crates", "SlapUnits", "CrateOperations"}) do
			if rawInv[key] ~= nil then result[key] = rawInv[key] end
		end
		return result
end

-- ==================================================
-- VALIDACIÓN CENTRAL DE DATOS
-- ==================================================

function PlayerDataService:ValidatePlayerData(raw: any): (boolean, PlayerDataRecord, string?)
	local defaultInv = getDefaultInventory()
	if type(raw) ~= "table" then
		return false, {
			Version = Config.DataStore.CurrentVersion or 2,
			Coins = Config.Economy.StartingCoins or 0,
			Wins = Config.Economy.StartingWins or 0,
			Losses = Config.Economy.StartingLosses or 0,
			Kills = Config.Economy.StartingKills or 0,
			WinStreak = WinStreak.Normalize(nil),
			Inventory = defaultInv,
		}, "Raw data is not a table"
	end

	local warnings: { string } = {}

	local version = raw.Version
	local currentVersion = (Config.DataStore and Config.DataStore.CurrentVersion) or 2
	if not isValidNumber(version) or version < 1 then
		table.insert(warnings, string.format("Invalid or missing Version (%s), migrating to %d", tostring(version), currentVersion))
		version = currentVersion
	elseif version < currentVersion then
		table.insert(warnings, string.format("Migrating PlayerData from version %d to %d", version, currentVersion))
		version = currentVersion
	elseif version > currentVersion then
		local errMsg = string.format("IncompatibleVersion: Data version (%d) is newer than current config (%d)", version, currentVersion)
		warn(string.format("[PlayerData] %s. Normalización y guardado bloqueados para prevenir corrupción de esquema futuro.", errMsg))
		return false, raw, errMsg
	end

	-- Coins
	local coins = raw.Coins
	if not isValidNumber(coins) or coins < 0 then
		table.insert(warnings, string.format("Invalid Coins (%s), fallback to 0", tostring(coins)))
		coins = 0
	else
		coins = math.floor(coins)
	end

	-- Wins
	local wins = raw.Wins
	if not isValidNumber(wins) or wins < 0 then
		table.insert(warnings, string.format("Invalid Wins (%s), fallback to 0", tostring(wins)))
		wins = 0
	else
		wins = math.floor(wins)
	end

	-- Losses
	local losses = raw.Losses
	if not isValidNumber(losses) or losses < 0 then
		table.insert(warnings, string.format("Invalid Losses (%s), fallback to 0", tostring(losses)))
		losses = 0
	else
		losses = math.floor(losses)
	end

	-- Kills (retrocompatible: perfiles anteriores sin Kills reciben fallback a 0)
	local kills = raw.Kills
	if not isValidNumber(kills) or kills < 0 then
		table.insert(warnings, string.format("Invalid or missing Kills (%s), fallback to 0", tostring(kills)))
		kills = 0
	else
		kills = math.floor(kills)
	end

	-- Inventory (Migración y sanitización profunda)
	local inventory = sanitizeInventory(raw.Inventory, warnings)

	local validatedRecord: PlayerDataRecord = {
		Version = Config.DataStore.CurrentVersion or 2,
		Coins = coins,
		Wins = wins,
		Losses = losses,
		Kills = kills,
		WinStreak = WinStreak.Normalize(raw.WinStreak),
		Inventory = inventory,
		LastSaved = raw.LastSaved,
	}

	local warningMsg = if #warnings > 0 then table.concat(warnings, "; ") else nil
	return true, validatedRecord, warningMsg
end

-- ==================================================
-- INICIALIZACIÓN Y BINDTOCLOSE
-- ==================================================

function PlayerDataService:Init(context: any)
	self._context = context
	self._loadStates = {}
	self._saving = {}
	self._store = context and context.PersistenceProvider or nil
	self._persistenceInfo = context and context.PersistenceInfo or nil

	if not self._store then
		local reason = self._persistenceInfo and self._persistenceInfo.BlockedReason or "ProviderMissing"
		warn(string.format("[PlayerData] Persistencia no disponible; acceso cloud bloqueado (%s)", tostring(reason)))
	end

	-- BindToClose seguro con espera activa de guardados
	if not self._bindToCloseConnected then
		self._bindToCloseConnected = true
		game:BindToClose(function()
			local ps = self:_getPlayerService()
				if ps then ps:BeginShopShutdown() end
				print("[PlayerData] BindToClose: Guardando datos de todos los jugadores...")
			self:SaveAllPlayers()
			print("[PlayerData] BindToClose: Finalizado.")
		end)
	end
end

function PlayerDataService:Start(context: any)
	print("[PlayerDataService] Servicio de persistencia iniciado y listo")
end

function PlayerDataService:GetStore(): any
	-- La selección es fija durante toda la vida del servidor. Nunca realizar
	-- fallback automático a DataStoreService si el proveedor está ausente o falla.
	return self._store
end

function PlayerDataService:GetPersistenceDiagnostics(): { [string]: any }
	local result = {
		Environment = self._persistenceInfo and self._persistenceInfo.Environment or "Unknown",
		ProviderName = self._persistenceInfo and self._persistenceInfo.ProviderName or "Unavailable",
		WritesToCloud = self._persistenceInfo and self._persistenceInfo.WritesToCloud == true or false,
		GameId = self._persistenceInfo and self._persistenceInfo.GameId or game.GameId,
		PlaceId = self._persistenceInfo and self._persistenceInfo.PlaceId or game.PlaceId,
		BlockedReason = self._persistenceInfo and self._persistenceInfo.BlockedReason or nil,
	}

	if self._store and type(self._store.GetDiagnostics) == "function" then
		for key, value in pairs(self._store:GetDiagnostics()) do
			result[key] = value
		end
	end
	return result
end

function PlayerDataService:GetLoadState(player: Player): DataLoadState?
	return self._loadStates[player]
end

function PlayerDataService:SetLoadState(player: Player, state: DataLoadState)
	self._loadStates[player] = state
end

-- ==================================================
-- CARGA DE DATOS (LOAD)
-- ==================================================

function PlayerDataService:LoadPlayer(player: Player): (boolean, PlayerDataRecord?, string?)
	if not player or not player:IsA("Player") then
		return false, nil, "InvalidPlayerInstance"
	end

	self._loadStates[player] = "Loading"

	local store = self:GetStore()
	if not store then
		self._loadStates[player] = "Failed"
		warn(string.format("[PlayerData] Load failed: DataStore no disponible para '%s'", player.Name))
		return false, nil, "DataStoreNotAvailable"
	end

	local key = string.format("Player_%d", player.UserId)
	local maxRetries = (Config.DataStore and Config.DataStore.MaxRetries) or 3
	local retryDelay = (Config.DataStore and Config.DataStore.InitialRetryDelay) or 1.0
	local backoff = (Config.DataStore and Config.DataStore.RetryBackoffMultiplier) or 2.0

	local lastErr: any = nil
	for attempt = 1, maxRetries do
		local ok, result = pcall(function()
			return store:GetAsync(key)
		end)

		if ok then
				if type(result)=="table" and result._PremiumProfile~=nil then
					self._loadStates[player]="Failed"
					return false,nil,"FencedProfileLifecycleRequired"
				end
			if result == nil then
				-- Jugador nuevo sin datos previos
				local newRecord: PlayerDataRecord = {
					Version = (Config.DataStore and Config.DataStore.CurrentVersion) or 2,
					Coins = (Config.Economy and Config.Economy.StartingCoins) or 0,
					Wins = (Config.Economy and Config.Economy.StartingWins) or 0,
					Losses = (Config.Economy and Config.Economy.StartingLosses) or 0,
					Kills = (Config.Economy and Config.Economy.StartingKills) or 0,
					Inventory = getDefaultInventory(),
				}
				self._loadStates[player] = "Loaded"
				print(string.format("[PlayerData] Load success (Nuevo jugador): '%s' (UserId: %d)", player.Name, player.UserId))
				return true, newRecord, nil
			else
				local valid, validatedRecord, warnMsg = self:ValidatePlayerData(result)
				if not valid then
					if type(result) == "table" and isValidNumber(result.Version) and result.Version > ((Config.DataStore and Config.DataStore.CurrentVersion) or 2) then
						self._loadStates[player] = "IncompatibleVersion"
						warn(string.format("[PlayerData] Load rejected para '%s': Versión de datos incompatible (%d > %d). Guardado bloqueado.",
							player.Name, result.Version, (Config.DataStore and Config.DataStore.CurrentVersion) or 2))
						return false, nil, warnMsg or "IncompatibleVersion"
					else
						self._loadStates[player] = "Corrupted"
						warn(string.format("[PlayerData] Load rejected para '%s': Datos corruptos (%s)", player.Name, tostring(warnMsg)))
						return false, nil, warnMsg or "ValidationFailed"
					end
				end

				if warnMsg then
					warn(string.format("[PlayerData] Advertencia en datos de '%s': %s", player.Name, warnMsg))
				end
				self._loadStates[player] = "Loaded"
				print(string.format("[PlayerData] Load success: '%s' (Coins=%d, Wins=%d, Losses=%d)",
					player.Name, validatedRecord.Coins, validatedRecord.Wins, validatedRecord.Losses))
				return true, validatedRecord, nil
			end
		else
			lastErr = result
			print(string.format("[PlayerData] Load retry %d/%d para '%s': %s", attempt, maxRetries, player.Name, tostring(result)))
			if attempt < maxRetries then
				task.wait(retryDelay)
				retryDelay *= backoff
			end
		end
	end

	self._loadStates[player] = "Failed"
	warn(string.format("[PlayerData] Load failed definitivo para '%s' tras %d intentos: %s", player.Name, maxRetries, tostring(lastErr)))
	return false, nil, tostring(lastErr)
end

-- ==================================================
-- GUARDADO DE DATOS (SAVE)
-- ==================================================

local function snapshotInventory(inventory: any): any
 local result = { Owned = {}, Equipped = {} }
 for category, owned in pairs(inventory.Owned) do result.Owned[category] = table.clone(owned) end
 for category, id in pairs(inventory.Equipped) do result.Equipped[category] = id end
 return result
end

function PlayerDataService:SavePlayer(player: Player, runtimeData: PlayerData?): (boolean, string?)
	if not player or not player:IsA("Player") then
		return false, "InvalidPlayerInstance"
	end

	-- SEGURIDAD CRÍTICA: Si el jugador no cargó correctamente, NUNCA guardar para no corromper ni sobrescribir
	local loadState = self._loadStates[player]
	if loadState == "IncompatibleVersion" then
		warn(string.format("[PlayerData] RECHAZO DE GUARDADO para '%s': Versión de datos en DataStore es incompatible (%s). Guardado bloqueado para proteger datos futuros.",
			player.Name, tostring(loadState)))
		return false, "IncompatibleVersion"
	end

	if loadState ~= "Loaded" then
		warn(string.format("[PlayerData] RECHAZO DE GUARDADO para '%s': Estado no es 'Loaded' (Estado actual: %s). Protección contra pérdida de datos activada.",
			player.Name, tostring(loadState)))
		return false, "DataNotLoaded"
	end

	if not runtimeData then
		warn(string.format("[PlayerData] RECHAZO DE GUARDADO para '%s': runtimeData es nil", player.Name))
		return false, "NilRuntimeData"
	end

	-- Capture the entire purchase state before any yielding wait/retry.
	runtimeData = table.clone(runtimeData)
	runtimeData.Inventory = snapshotInventory(runtimeData.Inventory or getDefaultInventory())

	-- Protección contra guardado simultáneo del mismo jugador
	if self._saving[player] then
		-- Esperar de forma controlada si ya hay un guardado en curso
		local waitAttempts = 0
		while self._saving[player] and waitAttempts < 40 do
			task.wait(0.05)
			waitAttempts += 1
		end
		if self._saving[player] then
			warn(string.format("[PlayerData] Guardado concurrente en curso para '%s', abortando solicitud duplicada", player.Name))
			return false, "AlreadySaving"
		end
	end

	self._saving[player] = true

	local store = self:GetStore()
	if not store then
		self._saving[player] = nil
		warn(string.format("[PlayerData] Save failed: DataStore no disponible para '%s'", player.Name))
		return false, "DataStoreNotAvailable"
	end

	local key = string.format("Player_%d", player.UserId)
	local maxRetries = (Config.DataStore and Config.DataStore.MaxRetries) or 3
	local retryDelay = (Config.DataStore and Config.DataStore.InitialRetryDelay) or 1.0
	local backoff = (Config.DataStore and Config.DataStore.RetryBackoffMultiplier) or 2.0

	local payload: PlayerDataRecord = {
		Version = (Config.DataStore and Config.DataStore.CurrentVersion) or 2,
		Coins = math.max(0, math.floor(runtimeData.Coins or 0)),
		Wins = math.max(0, math.floor(runtimeData.Wins or 0)),
		Losses = math.max(0, math.floor(runtimeData.Losses or 0)),
		Kills = math.max(0, math.floor(runtimeData.Kills or 0)),
		WinStreak = WinStreak.Normalize(runtimeData.WinStreak),
		Inventory = runtimeData.Inventory or getDefaultInventory(),
		LastSaved = os.time(),
	}

	local lastErr: any = nil
	local wasVersionAborted = false
		local wasCommerceAborted = false
	for attempt = 1, maxRetries do
		local ok, err = pcall(function()
			store:UpdateAsync(key, function(oldData: any)
					if type(oldData)=="table" and oldData._PremiumProfile~=nil then wasCommerceAborted=true;return nil end
				-- Mantener posibles campos externos futuros si existen
				if type(oldData) == "table" then
					local currentVersion = (Config.DataStore and Config.DataStore.CurrentVersion) or 2
					if isValidNumber(oldData.Version) and oldData.Version > currentVersion then
						wasVersionAborted = true
						return nil -- Cancela la escritura atómica en DataStore sin alterar los datos remotos
					end

					local updated = table.clone(oldData)
					updated.Version = payload.Version
					updated.Coins = payload.Coins
					updated.Wins = payload.Wins
					updated.Losses = payload.Losses
					updated.Kills = payload.Kills
					updated.WinStreak = payload.WinStreak
					updated.Inventory = payload.Inventory
					updated.LastSaved = payload.LastSaved
					return updated
				end
				return payload
			end)
		end)

			if wasCommerceAborted then self._saving[player]=nil;return false,"FencedProfileLifecycleRequired"end
			if wasVersionAborted then
			self._saving[player] = nil
			self._loadStates[player] = "IncompatibleVersion"
			warn(string.format("[PlayerData] Save abortado para '%s': Versión remota en DataStore es superior a la versión soportada (%d).",
				player.Name, (Config.DataStore and Config.DataStore.CurrentVersion) or 2))
			return false, "IncompatibleVersion"
		end

		if ok then
			self._saving[player] = nil
			print(string.format("[PlayerData] Save success: '%s' (Coins=%d, Wins=%d, Losses=%d, Kills=%d)",
				player.Name, payload.Coins, payload.Wins, payload.Losses, payload.Kills))
			return true, nil
		else
			lastErr = err
			print(string.format("[PlayerData] Save retry %d/%d para '%s': %s", attempt, maxRetries, player.Name, tostring(err)))
			if attempt < maxRetries then
				task.wait(retryDelay)
				retryDelay *= backoff
			end
		end
	end

	self._saving[player] = nil
	warn(string.format("[PlayerData] Save failed definitivo para '%s' tras %d intentos: %s", player.Name, maxRetries, tostring(lastErr)))
	return false, tostring(lastErr)
end

function PlayerDataService:_getPlayerService(): any
	if self._playerService then
		return self._playerService
	end
	if self._context and type(self._context.GetService) == "function" then
		local s = self._context:GetService("PlayerService")
		if s then
			self._playerService = s
			return s
		end
	end
	local ok, mod = pcall(require, script.Parent.PlayerService)
	if ok and mod then
		self._playerService = mod
		return mod
	end
	return nil
end

-- ==================================================
-- GUARDADO COLECTIVO (BINDTOCLOSE / SHUTDOWN)
-- ==================================================

function PlayerDataService:SaveAllPlayers(): (number, number)
	local players = Players:GetPlayers()
	if #players == 0 then
		return 0, 0
	end

	local playerService = self:_getPlayerService()
	local remaining = #players
	local savedCount = 0
	local failedCount = 0

	for _, player in ipairs(players) do
		task.spawn(function()
			local runtimeData: PlayerData? = nil
			if playerService and type(playerService.GetPlayerData) == "function" then
				runtimeData = playerService:GetPlayerData(player)
			end

			local success = false
			if runtimeData and self._loadStates[player] == "Loaded" then
				local ok = self:SavePlayer(player, runtimeData)
				success = ok
			else
				print(string.format("[PlayerData] SaveAllPlayers: Omitiendo '%s' (no cargado o sin datos runtime)", player.Name))
			end

			if success then
				savedCount += 1
			else
				failedCount += 1
			end
			remaining -= 1
		end)
	end

	-- Esperar hasta que todos los hilos terminen o timeout de seguridad de 25 segundos
	local timeout = 25
	local elapsed = 0
	while remaining > 0 and elapsed < timeout do
		task.wait(0.1)
		elapsed += 0.1
	end

	print(string.format("[PlayerData] SaveAllPlayers completado: %d guardados, %d omitidos/fallidos", savedCount, failedCount))
	return savedCount, failedCount
end

-- Limpieza de estado auxiliar al salir
function PlayerDataService:Cleanup(player: Player)
	self._loadStates[player] = nil
	self._saving[player] = nil
end

return PlayerDataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="545">
        <Properties>
          <string name="Name">PlayerService</string>
          <string name="Source"><![CDATA[--!strict
-- PlayerService
-- Ciclo de vida de jugadores: registro/desregistro, estado económico y datos runtime (Coins, Wins, Losses).
-- Servidor autoritativo. Integrado con PlayerDataService para persistencia segura vía DataStoreService.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local WinStreak = require(script.Parent.Gameplay.WinStreak)
local Players = game:GetService("Players")

local PointEffectDefinitions = require(ReplicatedStorage.Shared.PointEffectDefinitions)
local Config = require(ReplicatedStorage.Shared.Config)
local Types = require(ReplicatedStorage.Shared.Types)
local ProfilePurchase = require(script.Parent.Parent.Shop.ProfilePurchase)
local Constants = require(ReplicatedStorage.Shared.Constants)
local DeathSettings = require(ReplicatedStorage.Shared.DeathFeedbackConfig).DeathEffects

type PlayerData = Types.PlayerData

local PlayerService = {}
PlayerService.Name = "PlayerService"

PlayerService._context = nil :: any
PlayerService._registered = {}
PlayerService._connections = {} :: { RBXScriptConnection }
PlayerService._data = {} :: { [any]: PlayerData }
PlayerService._coins = {} :: { [any]: number } -- Retrocompatibilidad
PlayerService._kills = {} :: { [any]: number }
PlayerService._coinTransactions = {} :: { [any]: { [string]: boolean } }
PlayerService._ownedPointEffects = {} :: { [any]: { [string]: boolean } }
PlayerService._equippedPointEffects = {} :: { [any]: string }
PlayerService._dataUpdatedRemote = nil :: RemoteEvent?
PlayerService._playerDataService = nil :: any
PlayerService._shopClosing = {} :: { [any]: boolean }
PlayerService._shopShutdown = false

-- Utilidad para garantizar la existencia de RemoteEvents
local function ensureRemote(parent: Instance, name: string): RemoteEvent
	local existing = parent:FindFirstChild(name)
	if existing and existing:IsA("RemoteEvent") then
		return existing
	end
	local remote = Instance.new("RemoteEvent")
	remote.Name = name
	remote.Parent = parent
	return remote
end

local function ensureFolder(parent: Instance, name: string): Folder
	local existing = parent:FindFirstChild(name)
	if existing and existing:IsA("Folder") then
		return existing
	end
	local folder = Instance.new("Folder")
	folder.Name = name
	folder.Parent = parent
	return folder
end

function PlayerService:Init(context)
	self._context = context
	self._registered = {}
	self._shopClosing = {}
	self._shopShutdown = false
	self._connections = {}
	self._data = {}
	self._coins = {}
	self._kills = {}
	self._coinTransactions = {}
	self._ownedPointEffects = {}
	self._equippedPointEffects = {}

	self:_getDataUpdatedRemote()
end

function PlayerService:_getDataUpdatedRemote(): RemoteEvent?
	if self._dataUpdatedRemote and self._dataUpdatedRemote.Parent then
		return self._dataUpdatedRemote
	end
	local remotesFolder = ensureFolder(ReplicatedStorage, "Remotes")
	local playerFolder = ensureFolder(remotesFolder, "Player")
	local remote = ensureRemote(playerFolder, "DataUpdated")
	self._dataUpdatedRemote = remote
	return remote
end

-- Sincroniza las estadísticas del jugador con el folder nativo leaderstats de Roblox
function PlayerService:_syncLeaderstats(player: any, data: PlayerData)
	if typeof(player) ~= "Instance" or not player:IsA("Player") then
		return
	end

	local leaderstats = player:FindFirstChild("leaderstats")
	if not leaderstats then
		local folder = Instance.new("Folder")
		folder.Name = "leaderstats"

		local coinsVal = Instance.new("IntValue")
		coinsVal.Name = "Coins"
		coinsVal.Value = data.Coins
		coinsVal.Parent = folder

		local winsVal = Instance.new("IntValue")
		winsVal.Name = "Wins"
		winsVal.Value = data.Wins
		winsVal.Parent = folder

		local killsVal = Instance.new("IntValue")
		killsVal.Name = "Kills"
		killsVal.Value = data.Kills or 0
		killsVal.Parent = folder

		folder.Parent = player
	else
		local coinsVal = leaderstats:FindFirstChild("Coins") :: IntValue?
		if not coinsVal then
			coinsVal = Instance.new("IntValue")
			coinsVal.Name = "Coins"
			coinsVal.Value = data.Coins
			coinsVal.Parent = leaderstats
		else
			coinsVal.Value = data.Coins
		end

		local winsVal = leaderstats:FindFirstChild("Wins") :: IntValue?
		if not winsVal then
			winsVal = Instance.new("IntValue")
			winsVal.Name = "Wins"
			winsVal.Value = data.Wins
			winsVal.Parent = leaderstats
		else
			winsVal.Value = data.Wins
		end

		local killsVal = leaderstats:FindFirstChild("Kills") :: IntValue?
		if not killsVal then
			killsVal = Instance.new("IntValue")
			killsVal.Name = "Kills"
			killsVal.Value = data.Kills or 0
			killsVal.Parent = leaderstats
		else
			killsVal.Value = data.Kills or 0
		end
	end
end

-- Envía actualización autoritativa de datos al cliente correspondiente y sincroniza leaderstats
function PlayerService:_sendDataUpdate(player: any, rewardReceipt: any?)
	if typeof(player) == "Instance" and player:IsA("Player") then
		local data = self:GetPlayerData(player)
		self:_syncLeaderstats(player, data)

		local remote = self:_getDataUpdatedRemote()
		if remote then
			remote:FireClient(player, data, rewardReceipt)
		end
	end
end

function PlayerService:_getPlayerDataService(): any
	if self._playerDataService then
		return self._playerDataService
	end
	if self._context and type(self._context.GetService) == "function" then
		local s = self._context:GetService("PlayerDataService")
		if s then
			self._playerDataService = s
			return s
		end
	end
	local ok, mod = pcall(require, script.Parent.PlayerDataService)
	if ok and mod then
		self._playerDataService = mod
		return mod
	end
	return nil
end

function PlayerService:_register(player: any)
	self._registered[player] = {}

	local initialData: PlayerData = {
		Coins = (Config.Economy and Config.Economy.StartingCoins) or 0,
		Wins = (Config.Economy and Config.Economy.StartingWins) or 0,
		Losses = (Config.Economy and Config.Economy.StartingLosses) or 0,
		Kills = (Config.Economy and Config.Economy.StartingKills) or 0,
		WinStreak = WinStreak.Normalize(nil),
		Inventory = {
			Owned = {
				["PointEffects"] = { [PointEffectDefinitions.DefaultEffectId] = true },
				["DeathEffects"] = { [DeathSettings.DefaultKillEffectId] = true },
				["Abilities"] = { Dash = true },
			},
			Equipped = {
				["PointEffects"] = PointEffectDefinitions.DefaultEffectId,
				["DeathEffects"] = DeathSettings.DefaultKillEffectId,
				["Abilities"] = "Dash",
			},
		},
	}

	if typeof(player) == "Instance" and player:IsA("Player") then
		local pds = self:_getPlayerDataService()
		if pds and type(pds.LoadPlayer) == "function" then
			local ok, record, err = pds:LoadPlayer(player)
			if ok and record then
				initialData.Coins = record.Coins
				initialData.Wins = record.Wins
				initialData.Losses = record.Losses
				initialData.Kills = record.Kills or 0
				initialData.WinStreak = WinStreak.Normalize(record.WinStreak)
				if record.Inventory then
					initialData.Inventory = record.Inventory
				end
			else
				warn(string.format("[PlayerService] No se pudo cargar PlayerData de '%s' (err: %s). Usando valores seguros no persistibles.", player.Name, tostring(err)))
			end
		end
	end

		local crates = self._context and self._context:GetService("CrateService")
		if crates then initialData.Inventory = crates:ExtendInventory(initialData.Inventory) end
		self._data[player] = initialData
	self._coins[player] = initialData.Coins
	self._kills[player] = initialData.Kills
	self._ownedPointEffects[player] = initialData.Inventory.Owned["PointEffects"]
	self._equippedPointEffects[player] = initialData.Inventory.Equipped["PointEffects"] or PointEffectDefinitions.DefaultEffectId

	local pName = if type(player) == "table" and player.Name then player.Name elseif typeof(player) == "Instance" then player.Name else tostring(player)
	print(string.format("[PlayerService] Registrado: %s (Coins=%d, Wins=%d, Losses=%d, Kills=%d, PointEffect: %s)",
		pName, initialData.Coins, initialData.Wins, initialData.Losses, initialData.Kills, tostring(self._equippedPointEffects[player])))

	-- Enviar estado inicial cargado al jugador (el HUD muestra inmediatamente datos reales sin parpadeo de 0)
	self:_sendDataUpdate(player)
end

function PlayerService:_unregister(player: any)
	self._shopClosing[player] = true -- Before the first save/yield; never accept another Shop mutation.
	if typeof(player) == "Instance" and player:IsA("Player") then
		local pds = self:_getPlayerDataService()
		if pds and type(pds.SavePlayer) == "function" then
			local currentData = self._data[player]
			local saved, saveError = pds:SavePlayer(player, currentData)
			if not saved then warn("[PlayerService] Final save failed; no durability guarantee: " .. tostring(saveError)) end
			if type(pds.Cleanup) == "function" then
				pds:Cleanup(player)
			end
		end
	end

	self._registered[player] = nil
	self._data[player] = nil
	self._shopClosing[player] = nil
	self._coins[player] = nil
	self._kills[player] = nil
	self._coinTransactions[player] = nil
	self._ownedPointEffects[player] = nil
	self._equippedPointEffects[player] = nil

	local pName = if type(player) == "table" and player.Name then player.Name elseif typeof(player) == "Instance" then player.Name else tostring(player)
	print(string.format("[PlayerService] Desregistrado: %s", pName))
end

-- ==================================================
-- INTERFAZ AUTORITATIVA DE ECONOMÍA Y ESTADÍSTICAS
-- ==================================================

function PlayerService:AddCoins(player: any, amount: number, reason: string, transactionId: string?): (number, number)
	if not player or amount ~= amount or amount <= 0 or amount == math.huge then
		return self:GetCoins(player), 0
	end

	local data = self._data[player]
	if transactionId then
		-- Transactional awards never reload/recreate a disconnected or missing profile.
		if transactionId == "" or not data then return self:GetCoins(player), 0 end
		local transactions = self._coinTransactions[player]
		if not transactions then transactions = {}; self._coinTransactions[player] = transactions end
		if transactions[transactionId] then return self:GetCoins(player), 0 end
		-- No yields between reserving the key and committing the in-memory balance.
		transactions[transactionId] = true
	end
	if not data then
		self:_register(player)
		data = self._data[player]
	end

	local newBalance = data.Coins + amount
	data.Coins = newBalance
	self._coins[player] = newBalance

	local pName = if type(player) == "table" and player.Name then player.Name elseif typeof(player) == "Instance" then player.Name else tostring(player)
	print(string.format("[PlayerService] +%d Coins otorgados a '%s' (Razón: %s). Saldo: %d",
		amount, pName, reason or "Unspecified", newBalance))

	if transactionId then
		-- Failure to notify cannot roll back a committed award or allow a second credit.
		local receipt = if reason == "MatchPoint" and string.sub(transactionId, 1, 5) == "Goal:" then {
			Kind = "CreditedGoal", RecipientUserId = player.UserId,
			SessionId = player:GetAttribute("MatchId"), EventId = transactionId, RewardCoins = amount,
		} else nil
		local ok, failure = pcall(self._sendDataUpdate, self, player, receipt)
		if not ok then warn("[PlayerService] Committed Coins; data notification failed: " .. tostring(failure)) end
	else
		self:_sendDataUpdate(player)
	end
	return newBalance, amount
end

-- Called only by the elimination authority after its final credited-kill decision.
-- Separate from AddKill so generic stat corrections never create money.
function PlayerService:AwardConfirmedKill(player: Player, victim: Player, sessionId: string, eliminationId: string): (number, number)
	if not player or not victim or player == victim or player.Parent ~= Players or victim.Parent ~= Players then
		return 0, self:GetCoins(player)
	end
	local rounds = self._context and self._context:GetService("RoundService")
	local session = rounds and rounds:GetSessionById(sessionId)
	if not session or not rounds:IsSessionActive(sessionId) or session.GameplayFrozen
		or session.Closing or session.Cancelled or session.Closed
		or (session.State ~= Constants.RoundState.Playing and session.State ~= Constants.RoundState.PointRestartCountdown) then
		return 0, self:GetCoins(player)
	end
	local attacker = rounds:GetSessionParticipant(sessionId, player)
	local target = rounds:GetSessionParticipant(sessionId, victim)
	local prefix = sessionId .. "_" .. tostring(victim.UserId) .. "_"
	if not attacker or not target or attacker.Team == target.Team
		or player:GetAttribute("MatchId") ~= sessionId or victim:GetAttribute("MatchId") ~= sessionId
		or type(eliminationId) ~= "string" or string.sub(eliminationId, 1, #prefix) ~= prefix then
		return 0, self:GetCoins(player)
	end
	local amount = Config.Economy.KillRewardCoins
	if type(amount) ~= "number" or amount ~= amount or amount < 0 or amount % 1 ~= 0 or amount == math.huge then
		warn("[PlayerService] Invalid Economy.KillRewardCoins")
		return 0, self:GetCoins(player)
	end
	local balance, credited = self:AddCoins(player, amount, "SlapElimination", "Kill:" .. eliminationId)
	return credited, balance
end

function PlayerService:GetCoins(player: any): number
	local data = self._data[player]
	return (data and data.Coins) or self._coins[player] or 0
end

-- Deduce monedas del jugador de forma server-authoritative (retorna éxito y nuevo balance)
function PlayerService:DeductCoins(player: any, amount: number, reason: string?): (boolean, number)
	if not player or amount <= 0 then
		return false, self:GetCoins(player)
	end

	local data = self._data[player]
	if not data then
		self:_register(player)
		data = self._data[player]
	end

	if data.Coins < amount then
		return false, data.Coins
	end

	local newBalance = data.Coins - amount
	data.Coins = newBalance
	self._coins[player] = newBalance

	local pName = if type(player) == "table" and player.Name then player.Name elseif typeof(player) == "Instance" then player.Name else tostring(player)
	print(string.format("[PlayerService] -%d Coins deducidos de '%s' (Razón: %s). Saldo restante: %d",
		amount, pName, reason or "ShopPurchase", newBalance))

	self:_sendDataUpdate(player)
	return true, newBalance
end

function PlayerService:RecordStreakResult(player: any, matchId: string, outcome: string): boolean
 local data=self._data[player]
 if not data then return false end
 local applied=WinStreak.Apply(data,matchId,outcome)
 if applied then
  local ok,why=pcall(self._sendDataUpdate,self,player)
  if not ok then warn('[PlayerService] Streak notification failed: '..tostring(why))end
 end
 return applied
end

function PlayerService:AddWin(player: any, reason: string?): number
	if not player then return 0 end

	local data = self._data[player]
	if not data then
		self:_register(player)
		data = self._data[player]
	end

	data.Wins += 1
	local pName = if type(player) == "table" and player.Name then player.Name elseif typeof(player) == "Instance" then player.Name else tostring(player)
	print(string.format("[PlayerService] +1 Win otorgado a '%s' (Razón: %s). Total Wins: %d",
		pName, reason or "MatchWin", data.Wins))

	self:_sendDataUpdate(player)
	return data.Wins
end

function PlayerService:GetWins(player: any): number
	local data = self._data[player]
	return (data and data.Wins) or 0
end

function PlayerService:AddLoss(player: any, reason: string?): number
	if not player then return 0 end

	local data = self._data[player]
	if not data then
		self:_register(player)
		data = self._data[player]
	end

	data.Losses += 1
	local pName = if type(player) == "table" and player.Name then player.Name elseif typeof(player) == "Instance" then player.Name else tostring(player)
	print(string.format("[PlayerService] +1 Loss registrado a '%s' (Razón: %s). Total Losses: %d",
		pName, reason or "MatchLoss", data.Losses))

	self:_sendDataUpdate(player)
	return data.Losses
end

function PlayerService:GetLosses(player: any): number
	local data = self._data[player]
	return (data and data.Losses) or 0
end

-- Stats-only API. Kill money requires AwardConfirmedKill and its elimination transaction key.
function PlayerService:AddKill(player: any, amount: number?, reason: string?): (number, number)
	if not player then return 0, 0 end
	local addAmt = amount or 1
	if addAmt <= 0 then
		return self:GetKills(player), 0
	end

	local data = self._data[player]
	if not data then
		self:_register(player)
		data = self._data[player]
	end

	data.Kills = (data.Kills or 0) + addAmt
	self._kills[player] = data.Kills

	local pName = if type(player) == "table" and player.Name then player.Name elseif typeof(player) == "Instance" then player.Name else tostring(player)
	print(string.format("[PlayerService] +%d Kill(s) registrado a '%s' (Razón: %s). Total Kills: %d",
		addAmt, pName, reason or "Elimination", data.Kills))

	local ok, failure = pcall(self._sendDataUpdate, self, player)
	if not ok then warn("[PlayerService] Kill registered; data notification failed: " .. tostring(failure)) end
	return data.Kills, 0
end

function PlayerService:GetKills(player: any): number
	local data = self._data[player]
	return (data and data.Kills) or self._kills[player] or 0
end

function PlayerService:GetPlayerData(player: any): PlayerData
	local data = self._data[player]
	if data then
		return {
			Coins = data.Coins,
			Wins = data.Wins,
			Losses = data.Losses,
			Kills = data.Kills or 0,
			WinStreak = WinStreak.Normalize(data.WinStreak),
			Inventory = data.Inventory,
		}
	end
	return {
		Coins = self:GetCoins(player),
		Wins = 0,
		Losses = 0,
		Kills = 0,
		Inventory = {
			Owned = {
				["PointEffects"] = { [PointEffectDefinitions.DefaultEffectId] = true },
				["DeathEffects"] = { [DeathSettings.DefaultKillEffectId] = true },
			},
			Equipped = {
				["PointEffects"] = PointEffectDefinitions.DefaultEffectId,
				["DeathEffects"] = DeathSettings.DefaultKillEffectId,
			},
		},
	}
end

-- ==================================================
-- INTERFAZ AUTORITATIVA GENÉRICA DE INVENTORY
-- ==================================================

-- Obtiene el inventario completo del jugador
function PlayerService:IsShopDataReady(player: any): boolean
	if self._shopShutdown or self._shopClosing[player] then return false end
	if typeof(player) ~= "Instance" or not player:IsA("Player") or player.Parent ~= Players or not self._data[player] then return false end
	local pds = self:_getPlayerDataService()
	return pds ~= nil and pds:GetLoadState(player) == "Loaded"
end

-- Stops Shop mutations before shutdown snapshots. Does not change reward rules.
function PlayerService:BeginShopShutdown()
 self._shopShutdown = true
end

function PlayerService:CommitShopPurchase(player: any, product: any): (boolean, string?)
 if not self:IsShopDataReady(player) then return false,"DataNotLoaded" end
 local current = self._data[player]
 local nextData, reason = ProfilePurchase.Stage(current, product)
 if not nextData then return false,reason end
 -- Stage is pure/non-yielding; recheck identity/readiness immediately before commit.
 if self._data[player] ~= current or not self:IsShopDataReady(player) then return false,"DataNotLoaded" end
 self._data[player] = nextData
 self._coins[player] = nextData.Coins
 self._ownedPointEffects[player] = nextData.Inventory.Owned.PointEffects
 -- A notification failure never undoes payment/ownership or reports a failed commit.
 self:NotifyShopUpdate(player)
 return true,nil
end

function PlayerService:NotifyShopUpdate(player: any)
 local ok, err = pcall(function() self:_sendDataUpdate(player) end)
 if not ok then warn("[PlayerService] Shop committed; snapshot delivery failed: " .. tostring(err)) end
end

-- Server-only no-yield commit. Uses the same profile/Coins caches and Shop lock.
function PlayerService:CommitCrateState(player: any, expectedInventory: any, nextData: any): (boolean, string?)
 if not self:IsShopDataReady(player) then return false,"DataNotLoaded" end
 local current=self._data[player]
 if current.Inventory~=expectedInventory then return false,"ProfileChanged" end
 self._data[player]=nextData
 self._coins[player]=nextData.Coins
 self._ownedPointEffects[player]=nextData.Inventory.Owned.PointEffects
 self:NotifyShopUpdate(player)
 return true
end

function PlayerService:GetInventory(player: any): Types.PlayerInventory?
	local data = self._data[player]
	if not data then return nil end
	return data.Inventory
end

-- Verifica si el jugador posee un ítem en una categoría específica
function PlayerService:HasItem(player: any, category: string, productId: string): boolean
	if not player or type(category) ~= "string" or type(productId) ~= "string" then
		return false
	end

	-- Regla especial universal: PointEffects.Basic siempre es poseído
	if category == "PointEffects" and productId == PointEffectDefinitions.DefaultEffectId then
		return true
	end
	-- Initial entitlement, never a purchase/grant event or Coins transaction.
	if category == "DeathEffects" and productId == DeathSettings.DefaultKillEffectId then return true end
	if category == "Abilities" and productId == "Dash" then return true end

	local data = self._data[player]
	if not data or not data.Inventory or not data.Inventory.Owned then
		return false
	end

	local catOwned = data.Inventory.Owned[category]
	return catOwned ~= nil and catOwned[productId] == true
end

-- Otorga propiedad de un ítem en una categoría genérica (server-authoritative)
function PlayerService:AddItem(player: any, category: string, productId: string): (boolean, string?)
	if not player then
		return false, "PlayerNotFound"
	end
	if type(category) ~= "string" or category == "" then
		return false, "InvalidCategory"
	end
	if type(productId) ~= "string" or productId == "" then
		return false, "InvalidProductId"
	end

	local data = self._data[player]
	if not data then
		self:_register(player)
		data = self._data[player]
	end

	if not data.Inventory then
		data.Inventory = { Owned = {}, Equipped = {} }
	end
	if not data.Inventory.Owned then
		data.Inventory.Owned = {}
	end
	if not data.Inventory.Owned[category] then
		data.Inventory.Owned[category] = {}
	end

	data.Inventory.Owned[category][productId] = true

	-- Mantener referencias auxiliares de PointEffects sincronizadas
	if category == "PointEffects" then
		self._ownedPointEffects[player] = data.Inventory.Owned[category]
	end

	local pName = if type(player) == "table" and player.Name then player.Name elseif typeof(player) == "Instance" then player.Name else tostring(player)
	print(string.format("[PlayerService] Jugador '%s' adquirió ítem: [%s] '%s'", pName, category, productId))

	self:_sendDataUpdate(player)
	return true, nil
end

-- Retorna el ítem equipado actualmente en una categoría
function PlayerService:GetEquippedItem(player: any, category: string): string?
	if not player or type(category) ~= "string" then
		return nil
	end
	if category == "DeathEffects" then
		local shop = self._context and self._context:GetService("ShopService")
		local provider = shop and shop:GetProvider(category)
		return if provider then provider:GetEquippedEffectId(player) else DeathSettings.DefaultKillEffectId
	end

	local data = self._data[player]
	if not data or not data.Inventory or not data.Inventory.Equipped then
		if category == "PointEffects" then
			return PointEffectDefinitions.DefaultEffectId
		end
		return nil
	end

	local equipped = data.Inventory.Equipped[category]

	if category == "PointEffects" then
		local models = game:GetService("ServerStorage"):FindFirstChild("PointEffects")
		local model = equipped and models and models:FindFirstChild(equipped)
		if not equipped or not PointEffectDefinitions.IsValid(equipped) or not self:HasItem(player, category, equipped)
			or not model or not model:IsA("Model") then
			return PointEffectDefinitions.DefaultEffectId
		end
		return equipped
	end

	if equipped and not self:HasItem(player, category, equipped) then
		return nil
	end

	return equipped
end

-- Equipa un ítem en una categoría (valida propiedad y disponibilidad)
function PlayerService:SetEquippedItem(player: any, category: string, productId: string?): (boolean, string?)
	if not self:IsShopDataReady(player) then return false, "DataNotLoaded" end
	if not player then
		return false, "PlayerNotFound"
	end
	if type(category) ~= "string" or category == "" then
		return false, "InvalidCategory"
	end
	if category == "DeathEffects" then
		if not self:IsShopDataReady(player) then return false, "DataNotLoaded" end
		local shop = self._context and self._context:GetService("ShopService")
		local provider = shop and shop:GetProvider(category)
		local actualId = if productId and productId ~= "" then productId else DeathSettings.DefaultKillEffectId
		local product = provider and provider:GetProduct(actualId)
		if not product then return false, "ProductNotFound" end
		if not provider:GetResource(actualId) then return false, "ProductUnavailable" end
	end
	if category == "PointEffects" and productId and productId ~= "" then
		if not PointEffectDefinitions.IsValid(productId) then return false, "ProductNotFound" end
		local models = game:GetService("ServerStorage"):FindFirstChild("PointEffects")
		local model = models and models:FindFirstChild(productId)
		if not model or not model:IsA("Model") then return false, "ProductUnavailable" end
	end

	local data = self._data[player]
	if not data then
		self:_register(player)
		data = self._data[player]
	end

	if not data.Inventory then
		data.Inventory = { Owned = {}, Equipped = {} }
	end
	if not data.Inventory.Equipped then
		data.Inventory.Equipped = {}
	end

	if productId == nil or productId == "" then
		return self:UnequipItem(player, category)
	end

	if not self:HasItem(player, category, productId) then
		warn(string.format("[PlayerService] Jugador no posee el ítem: [%s] '%s'", category, productId))
		return false, "NotOwned"
	end

	data.Inventory.Equipped[category] = productId

	if category == "PointEffects" then
		self._equippedPointEffects[player] = productId
	end

	local pName = if type(player) == "table" and player.Name then player.Name elseif typeof(player) == "Instance" then player.Name else tostring(player)
	print(string.format("[PlayerService] Jugador '%s' equipó ítem: [%s] '%s'", pName, category, productId))

	self:NotifyShopUpdate(player)
	return true, nil
end

-- Desequipa el ítem de una categoría (restituye default seguro si aplica)
function PlayerService:UnequipItem(player: any, category: string): (boolean, string?)
	if not self:IsShopDataReady(player) then return false, "DataNotLoaded" end
	if not player then
		return false, "PlayerNotFound"
	end
	if type(category) ~= "string" or category == "" then
		return false, "InvalidCategory"
	end

	local data = self._data[player]
	if not data or not data.Inventory then
		return false, "NoInventory"
	end
	if not data.Inventory.Equipped then
		data.Inventory.Equipped = {}
	end

	if category == "PointEffects" then
		data.Inventory.Equipped["PointEffects"] = PointEffectDefinitions.DefaultEffectId
		self._equippedPointEffects[player] = PointEffectDefinitions.DefaultEffectId
	elseif category == "DeathEffects" then
		return self:SetEquippedItem(player, category, DeathSettings.DefaultKillEffectId)
	else
		data.Inventory.Equipped[category] = nil
	end

	local pName = if type(player) == "table" and player.Name then player.Name elseif typeof(player) == "Instance" then player.Name else tostring(player)
	print(string.format("[PlayerService] Jugador '%s' desequipó categoría: [%s]", pName, category))

	self:NotifyShopUpdate(player)
	return true, nil
end

-- ==================================================
-- INTERFAZ ESPECÍFICA DE POINT EFFECTS (WRAPPERS SOBRE INVENTORY)
-- ==================================================

-- Verifica si el jugador posee un PointEffect específico
function PlayerService:HasPointEffect(player: any, effectId: string): boolean
	return self:HasItem(player, "PointEffects", effectId)
end

-- Retorna el diccionario de efectos que posee el jugador
function PlayerService:GetOwnedPointEffects(player: any): { [string]: boolean }
	local inv = self:GetInventory(player)
	local owned = (inv and inv.Owned and inv.Owned["PointEffects"]) or {}
	local copy = { [PointEffectDefinitions.DefaultEffectId] = true }
	for k, v in pairs(owned) do
		copy[k] = v
	end
	return copy
end

-- Agrega un efecto a la lista de efectos poseídos (wrapper compatible)
function PlayerService:AddOwnedPointEffect(player: any, effectId: string): (boolean, string?)
	if not PointEffectDefinitions.IsValid(effectId) then
		return false, "InvalidEffectId"
	end
	return self:AddItem(player, "PointEffects", effectId)
end

-- Retorna el PointEffect equipado por el jugador (con fallback seguro obligatorio a Basic)
function PlayerService:GetEquippedPointEffect(player: any): string
	return self:GetEquippedItem(player, "PointEffects") or PointEffectDefinitions.DefaultEffectId
end

-- Equipa autoritativamente un PointEffect para el jugador (wrapper compatible)
function PlayerService:SetEquippedPointEffect(player: any, effectId: string): (boolean, string?)
	if not PointEffectDefinitions.IsValid(effectId) then
		warn(string.format("[PlayerService] Intento de equipar effectId inexistente: '%s'", tostring(effectId)))
		return false, "InvalidEffectId"
	end
	return self:SetEquippedItem(player, "PointEffects", effectId)
end

function PlayerService:Start(context)
	self._context = context
	table.insert(self._connections, Players.PlayerAdded:Connect(function(player)
		self:_register(player)
	end))
	table.insert(self._connections, Players.PlayerRemoving:Connect(function(player)
		self:_unregister(player)
	end))

	for _, player in ipairs(Players:GetPlayers()) do
		self:_register(player)
	end
end

return PlayerService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="546">
        <Properties>
          <string name="Name">PointEffectTestService</string>
          <string name="Source"><![CDATA[--!strict
-- PointEffectTestService
-- Herramienta exclusiva de desarrollo y testing para Point Effects.
-- Permite probar cosméticos directamente en Workspace.PointEffectTest.TestPart
-- sin iniciar partidas, sin ScoreService, sin Coins, sin MatchScore ni alterar el gameplay.
-- Reutiliza autoritativamente PointEffectRegistry y los Controllers de coreografía.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local ServerStorage = game:GetService("ServerStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local PointEffectDefinitions = require(ReplicatedStorage.Shared.PointEffectDefinitions)

local PointEffectTestService = {}
PointEffectTestService.Name = "PointEffectTestService"

PointEffectTestService._context = nil :: any
PointEffectTestService._cooldowns = {} :: { [BasePart]: number }
PointEffectTestService._activeHandles = {} :: { [BasePart]: { any } }
PointEffectTestService._touchingPlayers = {} :: { [BasePart]: { [Player]: boolean } }
PointEffectTestService._connections = {} :: { RBXScriptConnection }

-- Resuelve el catálogo de PointEffectRegistry
function PointEffectTestService:_getRegistry()
	local controllersFolder = ServerScriptService:FindFirstChild("PointEffectControllers")
	if not controllersFolder then
		return nil
	end

	-- Asegurar que BasicController esté cargado para su auto-registro
	local basicMod = controllersFolder:FindFirstChild("BasicController")
	if basicMod and basicMod:IsA("ModuleScript") then
		pcall(require, basicMod)
	end

	local registryMod = controllersFolder:FindFirstChild("PointEffectRegistry")
	if registryMod and registryMod:IsA("ModuleScript") then
		local ok, reg = pcall(require, registryMod)
		if ok then return reg end
	end
	return nil
end

-- Obtiene el servicio de jugadores para resolver el cosmético equipado
function PointEffectTestService:_getPlayerService()
	if self._context and type(self._context.GetService) == "function" then
		local s = self._context:GetService("PlayerService")
		if s then return s end
	end
	local servicesFolder = ServerScriptService:FindFirstChild("Services")
	local mod = servicesFolder and servicesFolder:FindFirstChild("PlayerService")
	if mod and mod:IsA("ModuleScript") then
		local ok, result = pcall(require, mod)
		if ok then return result end
	end
	return nil
end

-- Resuelve autoritativamente el EffectId equipado por el jugador (con fallback seguro a Basic)
function PointEffectTestService:_resolvePlayerEffectId(player: Player?): string
	local defaultId = PointEffectDefinitions.DefaultEffectId
	if not player then
		return defaultId
	end

	local playerService = self:_getPlayerService()
	if not playerService or type(playerService.GetEquippedPointEffect) ~= "function" then
		return defaultId
	end

	local equipped = playerService:GetEquippedPointEffect(player)
	if not equipped or not PointEffectDefinitions.IsValid(equipped) then
		return defaultId
	end

	return equipped
end

-- Obtiene el template visual/sonoro desde ServerStorage.PointEffects[EffectId] (con fallback seguro a Basic)
function PointEffectTestService:_getEffectTemplate(effectId: string): Instance?
	local pointEffectsFolder = ServerStorage:FindFirstChild("PointEffects")
	if not pointEffectsFolder then
		warn("[PointEffectTestService] ServerStorage.PointEffects no existe")
		return nil
	end

	local template = pointEffectsFolder:FindFirstChild(effectId)
	if not template and effectId ~= PointEffectDefinitions.DefaultEffectId then
		warn(string.format("[PointEffectTestService] Template para '%s' no encontrado en ServerStorage.PointEffects. Usando fallback '%s'",
			tostring(effectId), PointEffectDefinitions.DefaultEffectId))
		template = pointEffectsFolder:FindFirstChild(PointEffectDefinitions.DefaultEffectId)
	end

	if not template then
		warn(string.format("[PointEffectTestService] Template de efecto '%s' no encontrado", tostring(effectId)))
		return nil
	end

	return template
end

-- Obtiene el RemoteEvent PointFeedback de ReplicatedStorage.Remotes.Match
function PointEffectTestService:_getFeedbackRemote(): RemoteEvent?
	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	local matchFolder = remotes and remotes:FindFirstChild("Match")
	local pointFeedback = matchFolder and matchFolder:FindFirstChild("PointFeedback")
	if pointFeedback and pointFeedback:IsA("RemoteEvent") then
		return pointFeedback
	end
	return nil
end

-- Obtiene el servicio de Ragdoll para física de impacto
function PointEffectTestService:_getRagdollService()
	if self._context and self._context.GetService then
		local s = self._context:GetService("RagdollService")
		if s then return s end
	end
	local servicesFolder = ServerScriptService:FindFirstChild("Services")
	local mod = servicesFolder and servicesFolder:FindFirstChild("RagdollService")
	if mod and mod:IsA("ModuleScript") then
		local ok, result = pcall(require, mod)
		if ok then return result end
	end
	return nil
end

-- Extrae el Player desde un BasePart del personaje
local function getPlayerFromHit(hit: BasePart): Player?
	if not hit or not hit:IsA("BasePart") then return nil end
	local current: Instance? = hit
	while current and current ~= Workspace do
		if current:IsA("Model") then
			local hum = current:FindFirstChildOfClass("Humanoid")
			if hum then
				return Players:GetPlayerFromCharacter(current)
			end
		end
		current = current.Parent
	end
	return nil
end

-- Ejecuta la prueba de un cosmético sobre el TestPart
function PointEffectTestService:_triggerTest(part: BasePart, player: Player?)
	if not part or not part:IsDescendantOf(Workspace) then return end

	-- Si el jugador ya se encuentra en estado Ragdoll, ignorar activación para evitar bucles
	if player and player.Character then
		local ragdollService = self:_getRagdollService()
		if ragdollService and ragdollService:IsRagdolled(player.Character) then
			return
		end
	end

	-- 1. Verificación de Cooldown
	local rawCooldown = part:GetAttribute("Cooldown")
	local cooldown = if typeof(rawCooldown) == "number" and rawCooldown >= 0 then rawCooldown else 1.0

	local now = os.clock()
	local lastTime = self._cooldowns[part] or 0
	if (now - lastTime) < cooldown then
		-- Cooldown activo: ignorar activaciones repetidas
		return
	end
	self._cooldowns[part] = now

	-- 2. Resolución dinámica del efecto equipado por el jugador (o fallback seguro a Basic)
	local effectId = self:_resolvePlayerEffectId(player)

	-- 3. Localizar template del efecto en ServerStorage.PointEffects
	local template = self:_getEffectTemplate(effectId)
	if not template then
		return
	end

	-- 4. Obtener Controller correspondiente desde PointEffectRegistry
	local registry = self:_getRegistry()
	local controller = registry and registry.GetController(effectId)
	if not controller or typeof(controller.Play) ~= "function" then
		warn(string.format("[PointEffectTestService] Controller no disponible para '%s'", effectId))
		return
	end

	-- 5. Clonar y posicionar físicamente en TestPart
	local clone = template:Clone()
	if clone:IsA("Model") then
		clone:PivotTo(CFrame.new(part.Position))
	elseif clone:IsA("BasePart") then
		clone.CFrame = CFrame.new(part.Position)
	end
	clone.Parent = part

	-- 6. Construir contexto de prueba compatible
	local isFinalPoint = (part:GetAttribute("IsFinalPoint") == true)
	local testPointId = string.format("TEST_%s_%d", effectId, math.floor(now * 1000))
	local testContext = {
		EffectModel = clone :: Model,
		ScoringZone = part,
		OriginPart = part,
		ScoringPlayer = player,
		MatchId = "TEST",
		PointId = testPointId,
		IsFinalPoint = isFinalPoint,
		Score = { Red = 0, Blue = 0 },
	}

	-- 7. Ejecutar coreografía mediante el controller
	local ok, handle = pcall(function()
		return controller.Play(testContext)
	end)

	if ok and handle and typeof(handle) == "table" then
		if not self._activeHandles[part] then
			self._activeHandles[part] = {}
		end
		table.insert(self._activeHandles[part], handle)
	elseif not ok then
		warn(string.format("[PointEffectTestService] Error al reproducir '%s': %s", effectId, tostring(handle)))
		if clone and clone.Parent then
			clone:Destroy()
		end
		return
	end

	-- 8. Broadcast a clientes vía RemoteEvent PointFeedback (para PointCameraFX y feedback de cámara)
	local feedbackRemote = self:_getFeedbackRemote()
	if feedbackRemote then
		local broadcastData = {
			MatchId = "TEST",
			PointId = testPointId,
			ScoringTeam = "Test",
			ScoringPlayer = player,
			ScoringPlayerName = if player then player.Name else "Touched",
			ScoringZonePosition = part.Position,
			IsFinalPoint = isFinalPoint,
			EffectId = effectId,
		}
		feedbackRemote:FireAllClients(broadcastData)
	end

	local playerName = if player then player.Name else "Touched"
	print(string.format("[PointEffectTestService] PointEffect '%s' ejecutado en TestPart (Invocador: %s, PointId: %s, Final: %s)",
		effectId, playerName, testPointId, tostring(isFinalPoint)))

	-- 9. Física de lanzamiento en Ragdoll por la onda expansiva
	local ragdollService = self:_getRagdollService()
	if ragdollService then
		local rawRadius = part:GetAttribute("RagdollRadius")
		local rawForce = part:GetAttribute("RagdollForce")
		local rawDuration = part:GetAttribute("RagdollDuration")
		local rawUpRatio = part:GetAttribute("UpwardRatio")

		local blastRadius = if typeof(rawRadius) == "number" then rawRadius else (Config.Ragdoll and Config.Ragdoll.BlastRadius) or 100
		local blastForce = if typeof(rawForce) == "number" then rawForce else (Config.Ragdoll and Config.Ragdoll.BlastForce) or 110
		local ragDuration = if typeof(rawDuration) == "number" then rawDuration else (Config.Ragdoll and Config.Ragdoll.DefaultDuration) or 5.0
		local upRatio = if typeof(rawUpRatio) == "number" then rawUpRatio else (Config.Ragdoll and Config.Ragdoll.UpwardRatio) or 1.0
		if isFinalPoint then
			blastForce *= 1.3
		end

		local affectScorer = part:GetAttribute("AffectScorer") == true
		local function filterScoringPlayer(targetPlayer: Player?, _char: Model): boolean
			if not affectScorer and player and targetPlayer == player then
				return false -- El jugador que anota el punto no es afectado por la explosión ni el ragdoll
			end
			return true
		end

		ragdollService:BlastZone(part.Position, blastRadius, blastForce, upRatio, ragDuration, filterScoringPlayer)
	end
end

-- Configura y registra un TestPart con Attributes, ProximityPrompt y conexiones
function PointEffectTestService:RegisterTestPart(part: BasePart)
	if not part or not part:IsA("BasePart") then return end

	-- Asegurar atributos por defecto
	if part:GetAttribute("EffectId") == nil then
		part:SetAttribute("EffectId", "Basic")
	end
	if part:GetAttribute("Cooldown") == nil then
		part:SetAttribute("Cooldown", 1)
	end
	if part:GetAttribute("IsFinalPoint") == nil then
		part:SetAttribute("IsFinalPoint", false)
	end
	if part:GetAttribute("RagdollForce") == nil then
		part:SetAttribute("RagdollForce", (Config.Ragdoll and Config.Ragdoll.BlastForce) or 110)
	end
	if part:GetAttribute("RagdollRadius") == nil then
		part:SetAttribute("RagdollRadius", (Config.Ragdoll and Config.Ragdoll.BlastRadius) or 100)
	end
	if part:GetAttribute("RagdollDuration") == nil then
		part:SetAttribute("RagdollDuration", (Config.Ragdoll and Config.Ragdoll.DefaultDuration) or 5.0)
	end
	if part:GetAttribute("UpwardRatio") == nil then
		part:SetAttribute("UpwardRatio", (Config.Ragdoll and Config.Ragdoll.UpwardRatio) or 1.0)
	end
	if part:GetAttribute("AffectScorer") == nil then
		part:SetAttribute("AffectScorer", false)
	end

	-- Asegurar ProximityPrompt para activación manual (permite activarlo desde lejos para probar la distancia)
	local prompt = part:FindFirstChildOfClass("ProximityPrompt")
	if not prompt then
		prompt = Instance.new("ProximityPrompt")
		prompt.Name = "TestPrompt"
		prompt.ActionText = "Probar efecto"
		prompt.ObjectText = "Point Effect Test"
		prompt.MaxActivationDistance = 35
		prompt.RequiresLineOfSight = false
		prompt.Parent = part
	else
		prompt.MaxActivationDistance = 35
	end

	-- Conexión ProximityPrompt
	local promptConn = prompt.Triggered:Connect(function(player: Player)
		self:_triggerTest(part, player)
	end)
	table.insert(self._connections, promptConn)

	-- Conexión Touched (sólo para personajes vivos que no estén actualmente en ragdoll ni ya dentro del part)
	local touchConn = part.Touched:Connect(function(hit: BasePart)
		local player = getPlayerFromHit(hit)
		if not player or not player.Character then return end

		local ragdollService = self:_getRagdollService()
		if ragdollService and ragdollService:IsRagdolled(player.Character) then
			return
		end

		if not self._touchingPlayers[part] then
			self._touchingPlayers[part] = {}
		end
		if self._touchingPlayers[part][player] then
			return
		end
		self._touchingPlayers[part][player] = true

		self:_triggerTest(part, player)
	end)
	table.insert(self._connections, touchConn)

	-- Conexión TouchEnded para permitir volver a activar al salir y re-entrar
	local touchEndConn = part.TouchEnded:Connect(function(hit: BasePart)
		local player = getPlayerFromHit(hit)
		if player and self._touchingPlayers[part] then
			self._touchingPlayers[part][player] = nil
		end
	end)
	table.insert(self._connections, touchEndConn)

	print(string.format("[PointEffectTestService] TestPart registrado: %s [EffectId=%s, Cooldown=%s, AffectScorer=%s]",
		part:GetFullName(), tostring(part:GetAttribute("EffectId")), tostring(part:GetAttribute("Cooldown")), tostring(part:GetAttribute("AffectScorer"))))
end

-- Crea la estructura física predeterminada en Workspace si no existe
function PointEffectTestService:EnsureDefaultTestSetup(): (Folder, BasePart)
	local container = Workspace:FindFirstChild("PointEffectTest") :: Folder?
	if not container then
		container = Instance.new("Folder")
		container.Name = "PointEffectTest"
		container.Parent = Workspace
	end

	local testPart = container:FindFirstChild("TestPart") :: BasePart?
	if not testPart then
		local part = Instance.new("Part")
		part.Name = "TestPart"
		part.Size = Vector3.new(4, 0.6, 4)
		part.Position = Vector3.new(35, 0.5, -115) -- Cerca del Spawn del Lobby
		part.Material = Enum.Material.Neon
		part.Color = Color3.fromRGB(255, 170, 0)
		part.Anchored = true
		part.CanCollide = true
		part:SetAttribute("EffectId", "Basic")
		part:SetAttribute("Cooldown", 1)
		part.Parent = container
		testPart = part
	end

	-- Indicador visual del radio de explosión en el suelo
	local adorn = testPart:FindFirstChild("BlastRadiusIndicator") :: CylinderHandleAdornment?
	if not adorn then
		adorn = Instance.new("CylinderHandleAdornment")
		adorn.Name = "BlastRadiusIndicator"
		adorn.Adornee = testPart
		adorn.Radius = (testPart:GetAttribute("RagdollRadius")) or 25
		adorn.Height = 0.05
		adorn.CFrame = CFrame.Angles(math.rad(90), 0, 0)
		adorn.Color3 = Color3.fromRGB(255, 170, 0)
		adorn.Transparency = 0.85
		adorn.AlwaysOnTop = false
		adorn.Parent = testPart
	end

	return container, testPart
end

function PointEffectTestService:Init(context)
	self._context = context
	self._cooldowns = {}
	self._activeHandles = {}
	self._touchingPlayers = {}
	self._connections = {}
end

function PointEffectTestService:Start(context)
	self._context = context

	-- 1. Crear o localizar la estructura en Workspace
	local container, defaultPart = self:EnsureDefaultTestSetup()
	self:RegisterTestPart(defaultPart)

	-- 2. Registrar cualquier otro part dentro de Workspace.PointEffectTest
	for _, child in ipairs(container:GetChildren()) do
		if child:IsA("BasePart") and child ~= defaultPart then
			self:RegisterTestPart(child)
		end
	end

	-- 3. Escuchar adiciones dinámicas en tiempo de ejecución (útil en Studio)
	local childConn = container.ChildAdded:Connect(function(child: Instance)
		if child:IsA("BasePart") then
			self:RegisterTestPart(child)
		end
	end)
	table.insert(self._connections, childConn)

	print("[PointEffectTestService] Servicio de testing de Point Effects activo y listo")
end

-- Limpieza de efectos activos de un TestPart específico o de todos
function PointEffectTestService:CleanupTest(part: BasePart?)
	if part then
		local handles = self._activeHandles[part]
		if handles then
			for _, h in ipairs(handles) do
				if typeof(h) == "table" and typeof(h.Destroy) == "function" then
					pcall(function() h:Destroy() end)
				end
			end
			self._activeHandles[part] = nil
		end
	else
		for _, handles in pairs(self._activeHandles) do
			for _, h in ipairs(handles) do
				if typeof(h) == "table" and typeof(h.Destroy) == "function" then
					pcall(function() h:Destroy() end)
				end
			end
		end
		self._activeHandles = {}
	end
end

return PointEffectTestService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="547">
        <Properties>
          <string name="Name">PointFeedbackService</string>
          <string name="Source"><![CDATA[--!strict
-- PointFeedbackService
-- Responsable del ciclo de vida, posicionamiento físico y delegación al Controller correspondiente de Point Effects.
-- El cosmético (PointEffect) pertenece al ScoringPlayer, pero su origen físico es ScoringZone (RedWin/BlueWin).
-- La coreografía específica de cada efecto la gestiona su respectivo Controller (ej. BasicController).
-- No detecta puntos, no valida jugadores, no otorga monedas ni altera scores (responsabilidad de ScoreService).

local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local ServerStorage = game:GetService("ServerStorage")
local Workspace = game:GetService("Workspace")

local Types = require(ReplicatedStorage.Shared.Types)
local Config = require(ReplicatedStorage.Shared.Config)
local PointEffectDefinitions = require(ReplicatedStorage.Shared.PointEffectDefinitions)

type MatchSession = Types.MatchSession
type PointFeedbackPayload = Types.PointFeedbackPayload
type PointFeedbackBroadcast = Types.PointFeedbackBroadcast

local PointFeedbackService = {}
PointFeedbackService.Name = "PointFeedbackService"

PointFeedbackService._context = nil :: any
PointFeedbackService._processedPoints = {} :: { [string]: boolean } -- pointId -> boolean (evita duplicación de feedback)
PointFeedbackService._activeMatchEffects = {} :: { [string]: { any } } -- matchId -> lista de instancias temporales
PointFeedbackService._activeMatchHandles = {} :: { [string]: { any } } -- matchId -> lista de handles de controllers activos

-- Remotes requeridos
local function ensureRemoteFolder(parent: Instance, name: string): Folder
	local folder = parent:FindFirstChild(name)
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = name
		folder.Parent = parent
	end
	return folder :: Folder
end

local function ensureRemoteEvent(parent: Instance, name: string): RemoteEvent
	local event = parent:FindFirstChild(name)
	if not event then
		event = Instance.new("RemoteEvent")
		event.Name = name
		event.Parent = parent
	end
	return event :: RemoteEvent
end

function PointFeedbackService:_ensureRemotes()
	local remotesFolder = ensureRemoteFolder(ReplicatedStorage, "Remotes")
	local matchFolder = ensureRemoteFolder(remotesFolder, "Match")
	ensureRemoteEvent(matchFolder, "PointFeedback")
end

function PointFeedbackService:_getRemote(eventName: string): RemoteEvent?
	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	local matchFolder = remotes and remotes:FindFirstChild("Match")
	local event = matchFolder and matchFolder:FindFirstChild(eventName)
	if event and event:IsA("RemoteEvent") then
		return event
	end
	return nil
end

function PointFeedbackService:_getPlayerService()
	if self._context and self._context.GetService then
		local s = self._context:GetService("PlayerService")
		if s then return s end
	end

	local servicesFolder = ServerScriptService:FindFirstChild("Services")
	local mod = servicesFolder and servicesFolder:FindFirstChild("PlayerService")
	if mod and mod:IsA("ModuleScript") then
		local ok, result = pcall(require, mod)
		if ok then return result end
	end
	return nil
end

function PointFeedbackService:_getRoundService()
	if self._context and self._context.GetService then
		local service = self._context:GetService("RoundService")
		if service then return service end
	end
	return nil
end

-- Obtiene el registro de controllers cargando BasicController si aún no se inicializó
function PointFeedbackService:_getControllerRegistry()
	local controllersFolder = ServerScriptService:FindFirstChild("PointEffectControllers")
	if not controllersFolder then
		return nil
	end

	-- Asegurar que BasicController esté cargado para su auto-registro
	local basicMod = controllersFolder:FindFirstChild("BasicController")
	if basicMod and basicMod:IsA("ModuleScript") then
		pcall(require, basicMod)
	end

	local registryMod = controllersFolder:FindFirstChild("PointEffectRegistry")
	if registryMod and registryMod:IsA("ModuleScript") then
		local ok, reg = pcall(require, registryMod)
		if ok then return reg end
	end
	return nil
end

-- Obtiene el servicio de Ragdoll para física de impacto
function PointFeedbackService:_getRagdollService()
	if self._context and self._context.GetService then
		local s = self._context:GetService("RagdollService")
		if s then return s end
	end
	local servicesFolder = ServerScriptService:FindFirstChild("Services")
	local mod = servicesFolder and servicesFolder:FindFirstChild("RagdollService")
	if mod and mod:IsA("ModuleScript") then
		local ok, result = pcall(require, mod)
		if ok then return result end
	end
	return nil
end

function PointFeedbackService:Init(context)
	self._context = context
	self._processedPoints = {}
	self._activeMatchEffects = {}
	self._activeMatchHandles = {}

	self:_ensureRemotes()
end

function PointFeedbackService:Start(context)
	self._context = context
	-- Pre-cargar registro de controllers
	local _ = self:_getControllerRegistry()
	print("[PointFeedbackService] Servicio iniciado y listo para despachar PointEffects a Controllers")
end

-- Resuelve autoritativamente el EffectId equipado por el jugador anotador con fallback seguro a Basic
function PointFeedbackService:_resolvePlayerEffectId(scoringPlayer: Player?): string
	if not scoringPlayer then
		return PointEffectDefinitions.DefaultEffectId
	end

	local playerService = self:_getPlayerService()
	if not playerService or not playerService.GetEquippedPointEffect then
		return PointEffectDefinitions.DefaultEffectId
	end

	local equipped = playerService:GetEquippedPointEffect(scoringPlayer)
	if not equipped or not PointEffectDefinitions.IsValid(equipped) then
		return PointEffectDefinitions.DefaultEffectId
	end

	return equipped
end

-- Obtiene el template visual/sonoro desde ServerStorage.PointEffects[EffectId] (editable desde Studio)
function PointFeedbackService:_getEffectTemplate(effectId: string): Instance?
	local pointEffectsFolder = ServerStorage:FindFirstChild("PointEffects")
	if not pointEffectsFolder then
		warn("[PointFeedbackService] ServerStorage.PointEffects no existe")
		return nil
	end

	local template = pointEffectsFolder:FindFirstChild(effectId)
	if not template and effectId ~= PointEffectDefinitions.DefaultEffectId then
		warn(string.format("[PointFeedbackService] Template para '%s' no encontrado en ServerStorage.PointEffects. Usando fallback '%s'",
			tostring(effectId), PointEffectDefinitions.DefaultEffectId))
		template = pointEffectsFolder:FindFirstChild(PointEffectDefinitions.DefaultEffectId)
	end

	if not template then
		warn(string.format("[PointFeedbackService] Template de efecto '%s' no encontrado", tostring(effectId)))
		return nil
	end

	return template
end

-- Valida defensivamente que ScoringZone sea válida, pertenezca a la instancia y corresponda al equipo anotador
function PointFeedbackService:_validateScoringZone(session: MatchSession, payload: PointFeedbackPayload): boolean
	local scoringZone = payload.ScoringZone
	if not scoringZone or not scoringZone:IsA("BasePart") then
		warn(string.format("[PointFeedbackService] ScoringZone inválido o no es BasePart para Match '%s'", tostring(payload.MatchId)))
		return false
	end

	if not scoringZone:IsDescendantOf(Workspace) then
		warn(string.format("[PointFeedbackService] ScoringZone no es descendiente de Workspace para Match '%s'", tostring(payload.MatchId)))
		return false
	end

	local info = session.InstanceInfo
	if not info then
		warn(string.format("[PointFeedbackService] session.InstanceInfo ausente para Match '%s'", tostring(payload.MatchId)))
		return false
	end

	-- Validar que pertenezca a la instancia activa de la partida
	if info.InstanceModel and not scoringZone:IsDescendantOf(info.InstanceModel) then
		warn(string.format("[PointFeedbackService] ScoringZone no pertenece a InstanceModel de Match '%s'", tostring(payload.MatchId)))
		return false
	end

	-- Validar que corresponda al equipo que anotó
	if payload.ScoringTeam == "Red" and scoringZone ~= info.RedWin then
		warn("[PointFeedbackService] ScoringZone no coincide con info.RedWin para anotación de Red")
		return false
	elseif payload.ScoringTeam == "Blue" and scoringZone ~= info.BlueWin then
		warn("[PointFeedbackService] ScoringZone no coincide con info.BlueWin para anotación de Blue")
		return false
	end

	return true
end

-- Fallback defensivo si un controller no estuviera disponible para un efecto
function PointFeedbackService:_fallbackPlay(clone: Instance, scoringZone: BasePart, matchId: string)
	local rawDuration = clone:GetAttribute("Duration")
	local duration = if typeof(rawDuration) == "number" and rawDuration > 0 then rawDuration else 1.2

	for _, desc in ipairs(clone:GetDescendants()) do
		if desc:IsA("Sound") then
			desc.Looped = false
			local rawDelay = desc:GetAttribute("PlayDelay")
			local playDelay = if typeof(rawDelay) == "number" and rawDelay >= 0 then rawDelay else 0
			if playDelay > 0 then
				task.delay(playDelay, function() if desc and desc.Parent then desc:Play() end end)
			else
				desc:Play()
			end
		elseif desc:IsA("ParticleEmitter") then
			desc.Enabled = false
			desc.Rate = 0
			local rawCount = desc:GetAttribute("EmitCount")
			local emitCount = if typeof(rawCount) == "number" and rawCount > 0 then rawCount else 10
			local rawDelay = desc:GetAttribute("EmitDelay")
			local emitDelay = if typeof(rawDelay) == "number" and rawDelay >= 0 then rawDelay else 0
			if emitDelay > 0 then
				task.delay(emitDelay, function() if desc and desc.Parent then desc:Emit(emitCount) end end)
			else
				desc:Emit(emitCount)
			end
		end
	end

	task.delay(duration, function()
		if clone and clone.Parent then
			clone:Destroy()
		end
	end)
	Debris:AddItem(clone, duration + 1.0)
end

-- Punto de entrada principal invocado por ScoreService al validar un punto
function PointFeedbackService:PlayPoint(session: MatchSession, payload: PointFeedbackPayload, finalToken: string?): boolean
	if not session or not payload then
		warn("[PointFeedbackService] PlayPoint llamado con parámetros nulos")
		return false
	end
	local authority = self:_getRoundService()
	local stateVersion = session.StateVersion
		local visualOnly = finalToken ~= nil
		local function isCurrent(): boolean
			if not authority or authority:GetSessionById(session.Id) ~= session or session.Closed
				or session.StateVersion ~= stateVersion then return false end
			if visualOnly then
				local results = session.Results
				return session.State == "Ending" and session.GameplayFrozen == true and not session.Cancelled
					and results ~= nil and results.Celebrating == true and results.Token == finalToken
					and payload.IsFinalPoint == true and session.Result == payload.ScoringTeam
			end
			return not session.GameplayFrozen and session.Result == nil and not session.Closing
				and authority:IsSessionActive(session.Id) and authority:GetSessionState(session.Id) == "Playing"
		end
		if not isCurrent() then return false end

	local pointId = payload.PointId
	if not pointId or self._processedPoints[pointId] then
		-- Duplicación detectada: ignorar silenciosamente sin interrumpir el flujo
		return false
	end

	-- Marcar punto como procesado (protección contra doble feedback)
	self._processedPoints[pointId] = true

	-- Validación defensiva sin romper el juego
	local isValidZone = self:_validateScoringZone(session, payload)
	if not isValidZone then
		-- Warning registrado por _validateScoringZone; no rompe el scoring ni la partida
		return false
	end

	local matchId = payload.MatchId or session.Id

	-- 1. Resolver el PointEffect equipado por el ScoringPlayer (con fallback seguro a Basic)
	local scoringPlayer = payload.ScoringPlayer
	local effectId = self:_resolvePlayerEffectId(scoringPlayer)
	local effectDef = PointEffectDefinitions.Get(effectId) or PointEffectDefinitions.GetDefault()
	local resolvedEffectId = effectDef.Id

	local playerName = if scoringPlayer and scoringPlayer.Name then scoringPlayer.Name else "Unknown"
	print(string.format("[PointFeedbackService] Feedback activado para Match '%s' (Punto: %s, Equipo: %s, Jugador: %s, PointEffect: %s [%s], Origen: %s, Final: %s)",
		matchId,
		tostring(pointId),
		payload.ScoringTeam,
		playerName,
		resolvedEffectId,
		effectDef.DisplayName,
		payload.ScoringZone:GetFullName(),
		tostring(payload.IsFinalPoint)))

	-- 2. Notificar a clientes para Camera Shake y efectos locales controlados por servidor
	local roundService = self:_getRoundService()
	if roundService and type(roundService.FireSessionRemote) == "function" then
		local broadcastData: PointFeedbackBroadcast = {
			MatchId = matchId,
			PointId = pointId,
			ScoringTeam = payload.ScoringTeam,
			ScoringPlayerName = playerName,
			ScoringZonePosition = payload.ScoringZone.Position,
			EffectId = resolvedEffectId,
			IsFinalPoint = payload.IsFinalPoint,
			RedScore = payload.RedScore,
			BlueScore = payload.BlueScore,
				VisualOnly = visualOnly,
				SessionId = session.Id,
				StateVersion = stateVersion,
		}
		roundService:FireSessionRemote(matchId, "Match", "PointFeedback", broadcastData)
	end

	-- 3. Obtener template, clonar y posicionar en ScoringZone
	local template = self:_getEffectTemplate(resolvedEffectId)
	if not template then
		warn(string.format("[PointFeedbackService] Template no disponible para efecto '%s'", resolvedEffectId))
		return true
	end

	local clone = template:Clone()
		if visualOnly then
			-- Existing controllers provide visuals/audio; the final copy cannot apply physics.
			for _, object in ipairs(clone:GetDescendants()) do
				if object:IsA("LuaSourceContainer") then object:Destroy()
				elseif object:IsA("BasePart") then
					object.Anchored = true; object.CanCollide = false; object.CanTouch = false; object.CanQuery = false
				elseif object:IsA("Explosion") then object.BlastPressure = 0; object.DestroyJointRadiusPercent = 0 end
			end
		end

	-- Posicionar con orientación neutral exactamente en la posición física de ScoringZone
	if clone:IsA("Model") then
		clone:PivotTo(CFrame.new(payload.ScoringZone.Position))
	elseif clone:IsA("BasePart") then
		clone.CFrame = CFrame.new(payload.ScoringZone.Position)
	end

	-- Parentar dentro de la instancia de la partida (ScoringZone)
	clone.Parent = payload.ScoringZone

	-- Registrar instancia activa para cleanup
	if not self._activeMatchEffects[matchId] then
		self._activeMatchEffects[matchId] = {}
	end
	table.insert(self._activeMatchEffects[matchId], clone)

	-- 4. Obtener Controller correspondiente desde PointEffectRegistry
	local registry = self:_getControllerRegistry()
	local controller = registry and registry.GetController(resolvedEffectId)

	if controller and typeof(controller.Play) == "function" then
		local playContext = {
			EffectModel = clone :: Model,
			ScoringZone = payload.ScoringZone,
			ScoringPlayer = payload.ScoringPlayer,
			MatchId = matchId,
			PointId = pointId,
			IsFinalPoint = payload.IsFinalPoint,
			Score = session.Score,
		}

		local ok, handle = pcall(function()
			return controller.Play(playContext)
		end)
		-- A controller may yield while the terminal barrier cleans this session.
			if not isCurrent() then
			if ok and typeof(handle) == "table" then
				local cleanup = handle.Destroy or handle.Stop
				if typeof(cleanup) == "function" then pcall(cleanup, handle) end
			end
			clone:Destroy()
			return false
		end

		if ok and handle and typeof(handle) == "table" then
			if not self._activeMatchHandles[matchId] then
				self._activeMatchHandles[matchId] = {}
			end
			table.insert(self._activeMatchHandles[matchId], handle)
		elseif not ok then
			warn(string.format("[PointFeedbackService] Error al ejecutar controller para '%s': %s", resolvedEffectId, tostring(handle)))
			self:_fallbackPlay(clone, payload.ScoringZone, matchId)
		end
	else
		-- Fallback seguro si no hubiera controller registrado
		self:_fallbackPlay(clone, payload.ScoringZone, matchId)
	end

	-- 5. Física de lanzamiento en Ragdoll por la onda expansiva del punto
	local ragdollService = self:_getRagdollService()
		if not visualOnly and ragdollService and payload.ScoringZone then
		local blastRadius = (Config.Ragdoll and Config.Ragdoll.BlastRadius) or 100
		local blastForce = (Config.Ragdoll and Config.Ragdoll.BlastForce) or 110
		local upRatio = (Config.Ragdoll and Config.Ragdoll.UpwardRatio) or 1.0
		local ragDuration = (Config.Ragdoll and Config.Ragdoll.DefaultDuration) or 5.0
		if payload.IsFinalPoint then
			blastForce *= 1.3
		end

		local scoringPlayer = payload.ScoringPlayer
		local scoringTeam = payload.ScoringTeam
		local function filterScoringPlayer(targetPlayer: Player?, _char: Model): boolean
			if session.GameplayFrozen or session.Result ~= nil or session.Closing
				or session.StateVersion ~= stateVersion
				or authority:GetSessionById(session.Id) ~= session or not authority:IsSessionActive(session.Id)
				or not targetPlayer or authority:GetSessionParticipant(session.Id, targetPlayer) == nil then
				return false
			end
			if scoringPlayer and targetPlayer == scoringPlayer then
				return false -- El jugador que anota el punto no es afectado por la explosión ni el ragdoll
			end
			if scoringTeam and session and session.Teams then
				local teamPlayers = session.Teams[scoringTeam]
				if typeof(teamPlayers) == "table" and targetPlayer and table.find(teamPlayers, targetPlayer) then
					return false -- Los compañeros del equipo anotador tampoco son afectados
				end
			end
			return true
		end

		ragdollService:BlastZone(payload.ScoringZone.Position, blastRadius, blastForce, upRatio, ragDuration, filterScoringPlayer)
	end
return true
end

function PointFeedbackService:HasActiveFeedback(matchId: string): boolean
	for _, handle in ipairs(self._activeMatchHandles[matchId] or {}) do
		if typeof(handle.IsActive) == "function" then
			local ok, active = pcall(handle.IsActive, handle)
			if ok and active then return true end
		end
	end
	for _, clone in ipairs(self._activeMatchEffects[matchId] or {}) do
		if typeof(clone) == "Instance" and clone.Parent then return true end
	end
	return false
end

-- Limpieza de recursos temporales de una partida
function PointFeedbackService:CleanupMatch(matchId: string)
	-- 1. Detener y destruir handles de controllers activos
	local handles = self._activeMatchHandles[matchId]
	if handles then
		for _, handle in ipairs(handles) do
			if typeof(handle) == "table" then
				if typeof(handle.Destroy) == "function" then
					pcall(function() handle:Destroy() end)
				elseif typeof(handle.Stop) == "function" then
					pcall(function() handle:Stop() end)
				end
			end
		end
		self._activeMatchHandles[matchId] = nil
	end

	-- 2. Limpieza de instancias físicas residuales
	local effects = self._activeMatchEffects[matchId]
	if effects then
		for _, item in ipairs(effects) do
			if typeof(item) == "Instance" then
				for _, desc in ipairs(item:GetDescendants()) do
					if desc:IsA("Sound") and desc.IsPlaying then
						pcall(function() desc:Stop() end)
					elseif desc:IsA("ParticleEmitter") then
						desc.Enabled = false
					end
				end
				item:Destroy()
			elseif typeof(item) == "RBXScriptConnection" then
				item:Disconnect()
			end
		end
		self._activeMatchEffects[matchId] = nil
	end

	print(string.format("[PointFeedbackService] Limpieza completada para Match '%s'", matchId))
end

return PointFeedbackService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="548">
        <Properties>
          <string name="Name">PremiumShopService</string>
          <string name="Source"><![CDATA[--!nonstrict
local Players=game:GetService("Players");local RS=game:GetService("ReplicatedStorage")
local Marketplace=game:GetService("MarketplaceService");local Policy=game:GetService("PolicyService")
local Run=game:GetService("RunService")
local Config=require(RS.Shared.PremiumShop.PremiumShopConfig)
local Root=script.Parent.Parent.PremiumShop
local Registry=require(Root.PremiumProductRegistry);local Eligibility=require(Root.PremiumEligibility)
local Coordinator=require(Root.ReceiptCoordinator)
local Backend=require(Root.DurableReceiptBackend);local Verifier=require(Root.ProductVerifier)
local Reserved=require(RS.Shared.PremiumShop.PlaceholderProductIds)
local Service={Name="PremiumShopService"}
local function ensure(p,n,k)local o=p:FindFirstChild(n);if o then assert(o:IsA(k),"Premium class conflict");return o end;o=Instance.new(k);o.Name=n;o.Parent=p;return o end
function Service:Init(context)
 self.Context=context;self.Registry=Registry.Load(RS.Shared);self.Rate={};self.Connections={}
 self.Backend,self.BackendReason=Backend.Create(context,Run:IsStudio())
 self.Verifier=Verifier.new(Marketplace,Reserved,Run:IsStudio(),game.GameId)
 self.Receipt=Coordinator.new(self.Registry,self.Backend,Players,{Reserved=Reserved,Delivered=function(uid,result,p)
  if result.Replay then return end
  local player=Players:GetPlayerByUserId(uid)
  if player and self.Delivery then self.Delivery:FireClient(player,{PurchaseId=result.PurchaseId,ProductId=result.ProductId,ProductKey=p.Id,State="Applied"})end
 end})
end
function Service:_lobby(player)
 local rounds=self.Context:GetService("RoundService")
 return player.Parent==Players and not player:GetAttribute("MatchId")and not player:GetAttribute("ResultsSessionId")and rounds and not rounds:GetSessionForPlayer(player)
end
function Service:_authorize(player,p,tokens)
 local ok,why=Eligibility.CanPurchase(Config,p,Eligibility.Policy(Policy,player),self.Context:GetService("PlayerService"):IsShopDataReady(player),self:_lobby(player))
 if not ok then return false,why end
 if Run:IsStudio()or not self.Backend or not self.Backend.DurableValidated then return false,self.BackendReason or "DurableBackendPending"end
 local verified,reason=self.Verifier:Verify(p);if not verified then return false,reason end
 for _,item in ipairs(p.Rewards.Crates)do
  local valid,code=self.Context:GetService("CrateService"):ValidatePremiumAcquisitionQuote(player,item.CrateId,type(tokens)=="table"and tokens[item.CrateId])
  if not valid then return false,code end
 end
 local checked,ready,code=pcall(self.Backend.CanPurchase,self.Backend,player.UserId,p)
 if not checked then return false,"PersistenceTemporaryError"end
 if not ready then return false,code end
 if not self:_lobby(player)or not self.Context:GetService("PlayerService"):IsShopDataReady(player)then return false,"DataNotLoaded"end
 return true
end
function Service:_receipts(player)
 if not self.Backend then return {}end
 local ok,records=pcall(self.Backend.ReadReceipts,self.Backend,player.UserId)
 if not ok or type(records)~="table"then return nil,"PersistenceTemporaryError"end
 local result={};for purchaseId,r in pairs(records)do if r.PlayerId==player.UserId and r.State=="Applied"then table.insert(result,{PurchaseId=purchaseId,ProductId=r.ProductId,ProductKey=r.ProductKey,State=r.State})end end
 return result
end
function Service:Catalog(player)
 if not Config.PremiumShopEnabled then return {Ok=false,Code="ShopDisabled"}end
 local policy=Eligibility.Policy(Policy,player);local products={}
 for _,id in ipairs(self.Registry.Order)do
  local p=self.Registry.ById[id];local verified,verificationReason=self.Verifier:Verify(p)
  local allowed,why=Eligibility.CanPurchase(Config,p,policy,self.Context:GetService("PlayerService"):IsShopDataReady(player),self:_lobby(player))
  -- Always blocked until a durable backend is explicitly installed and validated.
  allowed=allowed and self.Backend~=nil and verified~=nil
  table.insert(products,{Id=p.Id,Category=p.Category,DisplayName=p.DisplayName,Description=p.Description,Icon=p.Icon,
   PreviewModel=p.PreviewModel,CrateId=p.CrateId,SortOrder=p.SortOrder,Rewards=p.Rewards,HasRandomContents=p.HasRandomContents,
   DuplicatePolicy=p.DuplicatePolicy,PriceRobux=nil,SuggestedRobux=p.SuggestedRobux,IsPlaceholder=p.IsPlaceholder,
   ProductId=verified and p.DeveloperProductId,CommercialVerified=verified~=nil,PurchaseAllowed=allowed,
   Status=p.BlockedReason or why or verificationReason or self.BackendReason,ConfigurationStatus=p.BlockedReason,
   OddsNotice=if p.HasRandomContents then "Probabilidades y elegibilidad deben consultarse antes de comprar y abrir. Stock y propiedad pueden modificar cada extracción."else nil})
 end
 return {Ok=true,Products=products,Policy=policy,PurchasesEnabled=Config.PurchasesEnabled and self.Backend~=nil,BackendStatus=self.BackendReason,DefaultCategory=Config.DefaultCategory,
  CrateProducts=self.Context:GetService("CrateService"):GetCatalog()}
end
function Service:Request(player,action,args)
 if typeof(player)~="Instance"or not player:IsA("Player")or player.Parent~=Players then return {Ok=false,Code="InvalidPlayer"}end
 local now=os.clock();if now<(self.Rate[player]or 0)then return {Ok=false,Code="RateLimited"}end;self.Rate[player]=now+.5
 if action=="Catalog"then return self:Catalog(player)end
 if action=="Status"then local receipts,reason=self:_receipts(player);return {Ok=receipts~=nil,Receipts=receipts,Code=reason}end
 if action=="Odds"then
  local p=type(args)=="table"and self.Registry.ById[args.Id]
  if not p then return {Ok=false,Code="UnknownProduct"}end
  local quotes={}
  for _,item in ipairs(p.Rewards.Crates)do quotes[item.CrateId]=self.Context:GetService("CrateService"):QuoteForPremium(player,item.CrateId)end
  return {Ok=true,Quotes=quotes,Notice="Cada extracción recalcula stock y propiedad; probabilidades vigentes por RewardId."}
 end
 if action=="Purchase"then
  local p=type(args)=="table"and type(args.Id)=="string"and self.Registry.ById[args.Id]
  local ok,code=self:_authorize(player,p,type(args)=="table"and args.QuoteTokens)
  if not ok then return {Ok=false,Code=code}end
  local receipts,reason=self:_receipts(player);if not receipts then return {Ok=false,Code=reason}end
  local known={};for _,r in ipairs(receipts)do known[r.PurchaseId]=true end
  return {Ok=true,PromptAllowed=true,ProductId=p.DeveloperProductId,KnownReceipts=known}
 end
 return {Ok=false,Code="InvalidAction"}
end
function Service:Start()
 local folder=ensure(ensure(RS,"Remotes","Folder"),"PremiumShop","Folder")
 ensure(folder,"Request","RemoteFunction").OnServerInvoke=function(player,action,args)return self:Request(player,action,args)end
 self.Delivery=ensure(folder,"Delivery","RemoteEvent")
 -- The only ProcessReceipt assignment in the project. No PromptProductPurchaseFinished grant.
 Marketplace.ProcessReceipt=function(receipt)return self.Receipt:Process(receipt)end
 table.insert(self.Connections,Players.PlayerRemoving:Connect(function(p)self.Rate[p]=nil end))
end
return Service
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="549">
        <Properties>
          <string name="Name">RagdollService</string>
          <string name="Source"><![CDATA[--!strict
-- RagdollService
-- Servicio central para el ciclo de vida de Ragdoll y física de impacto/lanzamiento.
-- Coordina ReplicatedStorage.StateEvent y StarterCharacterScripts.RagdollStatesHandler.
-- Soporta avatares R15 modernos (AnimationConstraint + BallSocketConstraint) y R6 clásicos (Motor6D).
-- Diseñado para la onda expansiva del Point Effect y para el futuro sistema de combate/slap.

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)

local RagdollService = {}
RagdollService.Name = "RagdollService"

RagdollService._context = nil :: any
RagdollService._activeTimers = {} :: { [Model]: thread }
RagdollService._r6Instances = {} :: { [Model]: { Instance } }
RagdollService._rootCollisions = setmetatable({}, { __mode = "k" }) :: { [Model]: boolean }

function RagdollService:_getStateEvent(): UnreliableRemoteEvent?
	local evt = ReplicatedStorage:FindFirstChild("StateEvent")
	if evt and evt:IsA("UnreliableRemoteEvent") then
		return evt
	elseif evt and evt:IsA("RemoteEvent") then
		return evt :: any
	end
	return nil
end

-- Retorna true si el personaje se encuentra actualmente en estado Ragdoll
function RagdollService:IsRagdolled(character: Model): boolean
	if not character then return false end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then return false end
	return humanoid.PlatformStand == true or self._activeTimers[character] ~= nil
end

-- Pasa el personaje a estado Ragdoll físico y notifica a RagdollStatesHandler
function RagdollService:ApplyRagdoll(character: Model, duration: number?, launchVelocity: Vector3?): boolean
	if not character or not character:IsDescendantOf(Workspace) then return false end
	if character:GetAttribute("ArenaRespawnPending") then return false end
	local owner = Players:GetPlayerFromCharacter(character)
	if owner and owner:GetAttribute("ResultsSessionId") ~= nil then return false end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then return false end

	local rootPart = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not rootPart then return false end
	-- Release ability movement ownership BEFORE ragdoll takes ownership/velocity.
	local abilities = self._context and self._context:GetService("AbilityService")
	if owner and abilities then abilities:CancelPlayer(owner, "Ragdoll") end
	if self._rootCollisions[character] == nil then self._rootCollisions[character] = rootPart.CanCollide end

	-- Cancelar timer previo si ya estaba en ragdoll
	local prevTimer = self._activeTimers[character]
	if prevTimer then
		pcall(task.cancel, prevTimer)
		self._activeTimers[character] = nil
	end

	local hasAnimationConstraints = false
	for _, desc in ipairs(character:GetDescendants()) do
		if desc:IsA("AnimationConstraint") and desc.Name ~= "Root" then
			hasAnimationConstraints = true
			desc.Enabled = false
		end
	end

	-- Si es R6 clásico (no usa AnimationConstraint sino Motor6D)
	-- Repeated hits refresh velocity/timer, not the physical rig. Replacing this
	-- list leaked the first hit's constraints/colliders beyond ResetRagdollImmediate.
	if not hasAnimationConstraints and not self._r6Instances[character] then
		local torso = character:FindFirstChild("Torso") :: BasePart?
		local rootJoint = rootPart:FindFirstChild("RootJoint") :: Motor6D?
		if torso and rootJoint then
			rootPart.Massless = true
			local instances = {}

			if not rootPart:FindFirstChild("TorsoWeld") then
				local torsoWeld = Instance.new("WeldConstraint")
				torsoWeld.Part0 = rootPart
				torsoWeld.Part1 = torso
				torsoWeld.Name = "TorsoWeld"
				torsoWeld.Parent = rootPart
				table.insert(instances, torsoWeld)
			end
			rootJoint.Enabled = false

			for _, v in ipairs(character:GetDescendants()) do
				if v:IsA("Motor6D") and v ~= rootJoint then
					local part0, part1 = v.Part0, v.Part1
					if part0 and part1 then
						local collider = Instance.new("Part")
						collider.Size = part1.Size / 1.7
						collider.CFrame = part1.CFrame
						collider.Massless = true
						collider.CanQuery = false
						collider.CollisionGroup = part1.CollisionGroup
						collider.CanTouch = false
						collider.Transparency = 1
						collider.Name = "Collider"
						collider.Parent = part1
						table.insert(instances, collider)

						local colliderWeld = Instance.new("WeldConstraint")
						colliderWeld.Part0 = collider
						colliderWeld.Part1 = part1
						colliderWeld.Parent = collider
						table.insert(instances, colliderWeld)

						local attachment0 = Instance.new("Attachment")
						attachment0.CFrame = v.C0
						attachment0.Name = part1.Name .. "_RagdollAttachment0"
						attachment0.Parent = part0
						table.insert(instances, attachment0)

						local attachment1 = Instance.new("Attachment")
						attachment1.CFrame = v.C1
						attachment1.Name = "RagdollAttachment1"
						attachment1.Parent = part1
						table.insert(instances, attachment1)

						local ballSocket = Instance.new("BallSocketConstraint")
						ballSocket.Attachment0 = attachment0
						ballSocket.Attachment1 = attachment1
						ballSocket.LimitsEnabled = true
						ballSocket.TwistLimitsEnabled = true
						ballSocket.Name = "RagdollConstraint"
						ballSocket.Parent = part1
						table.insert(instances, ballSocket)

						v.Enabled = false
					end
				end
			end
			self._r6Instances[character] = instances
		end
	end

	-- Configuración del Humanoid
	humanoid.PlatformStand = true
	humanoid.AutoRotate = false
	rootPart.CanCollide = false

	-- Aplicar velocidad en el servidor si se provee a todas las partes
	if launchVelocity then
		for _, part in ipairs(character:GetDescendants()) do
			if part:IsA("BasePart") then
				part.AssemblyLinearVelocity = launchVelocity
				part.AssemblyAngularVelocity = Vector3.new(
					math.random(-6, 6),
					math.random(-6, 6),
					math.random(-6, 6)
				)
			end
		end
	end

	-- Notificar al cliente mediante StateEvent para activar RagdollStatesHandler
	local player = Players:GetPlayerFromCharacter(character)
	local stateEvent = self:_getStateEvent()
	if player and stateEvent then
		stateEvent:FireClient(player, false, launchVelocity, player:GetAttribute("MatchId"), character:GetAttribute("ArenaPhysicsGeneration") or 0, character)
	else
		pcall(function()
			humanoid:SetStateEnabled(Enum.HumanoidStateType.GettingUp, false)
			humanoid:ChangeState(Enum.HumanoidStateType.Physics)
		end)
	end

	-- Programar recuperación automática
	local ragDuration = duration or (Config.Ragdoll and Config.Ragdoll.DefaultDuration) or 2.0
	if ragDuration > 0 then
		local generation = character:GetAttribute("ArenaPhysicsGeneration") or 0
		local sessionId = player and player:GetAttribute("MatchId")
		local rounds = self._context and self._context:GetService("RoundService")
		local session = player and rounds and rounds:GetSessionForPlayer(player)
		local stateVersion = session and session.StateVersion
		local deadline=os.clock()+ragDuration
		character:SetAttribute("RagdollRecoveryDeadline",deadline)
		local recovery: thread
		recovery = task.delay(math.max(0,deadline-os.clock()), function()
			local stale = self._activeTimers[character] ~= recovery or not character:IsDescendantOf(Workspace)
				or (character:GetAttribute("ArenaPhysicsGeneration") or 0) ~= generation
				or character:GetAttribute("ArenaRespawnPending") == true
				or (player ~= nil and (player.Parent ~= Players or player.Character ~= character
					or player:GetAttribute("MatchId") ~= sessionId or player:GetAttribute("ResultsSessionId") ~= nil))
				or (session ~= nil and (rounds:GetSessionForPlayer(player) ~= session
					or session.StateVersion ~= stateVersion or not rounds:IsSessionActive(session.Id)
					or session.Closing or session.Closed or session.Cancelled or session.GameplayFrozen))
			if stale then
				if self._activeTimers[character] == recovery then self._activeTimers[character] = nil end
				if Config.Respawn.Debug then warn("[RespawnDebug] StaleRagdollRecovery", player and player.UserId, generation, character:GetAttribute("ArenaEliminationId")) end
				return
			end
			self._activeTimers[character] = nil
			character:SetAttribute("RagdollRecoveryDeadline",nil)
			self:RemoveRagdoll(character)
		end)
		self._activeTimers[character] = recovery
	end

	return true
end

-- Restaura el personaje a su estado normal de locomoción notificando a RagdollStatesHandler
function RagdollService:CancelRecovery(character: Model)
 local timer=self._activeTimers[character]
 if timer then pcall(task.cancel,timer);self._activeTimers[character]=nil end
 character:SetAttribute("RagdollRecoveryDeadline",nil)
end

function RagdollService:RemoveRagdoll(character: Model): boolean
	if character then character:SetAttribute("RagdollRecoveryDeadline",nil) end
	if character and character:GetAttribute("ArenaRespawnPending") then return false end
	local timer = self._activeTimers[character]
	if timer then
		pcall(task.cancel, timer)
		self._activeTimers[character] = nil
	end

	if not character or not character.Parent then return false end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local rootPart = character:FindFirstChild("HumanoidRootPart") :: BasePart?

	-- 1. Reactivar AnimationConstraints si es R15
	for _, desc in ipairs(character:GetDescendants()) do
		if desc:IsA("AnimationConstraint") then
			desc.Enabled = true
		end
	end

	-- 2. Limpiar R6 si correspondía
	local r6Instances = self._r6Instances[character]
	if r6Instances then
		if rootPart then rootPart.Massless = false end
		for _, v in ipairs(character:GetDescendants()) do
			if v:IsA("Motor6D") then
				v.Enabled = true
			end
		end
		for _, inst in ipairs(r6Instances) do
			if inst and inst.Parent then
				inst:Destroy()
			end
		end
		self._r6Instances[character] = nil
	end

	-- 3. Restaurar Humanoid y colisión del RootPart
	if rootPart then
		local original = self._rootCollisions[character]
		if original ~= nil then rootPart.CanCollide = original end
		self._rootCollisions[character] = nil
	end

	if humanoid and humanoid.Health > 0 then
		humanoid.PlatformStand = false
		humanoid.AutoRotate = true

		local player = Players:GetPlayerFromCharacter(character)
		local stateEvent = self:_getStateEvent()
		if player and stateEvent then
			stateEvent:FireClient(player, true, nil, player:GetAttribute("MatchId"), character:GetAttribute("ArenaPhysicsGeneration") or 0, character)
		else
			pcall(function()
				humanoid:SetStateEnabled(Enum.HumanoidStateType.GettingUp, true)
				humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
			end)
		end
	end

	return true
end

-- Reseteo forzado e inmediato de ragdoll para reposicionamiento en arena (Zero-Death)
-- Idempotente, síncrono, cancela timers/callbacks y restaura articulaciones, colisiones y estado físico.
function RagdollService:ResetRagdollImmediate(character: Model, quietRespawn: boolean?): boolean
	if character then character:SetAttribute("RagdollRecoveryDeadline",nil) end
	if not character or not character.Parent then return false end

	-- 1. Cancelar cualquier timer pendiente para evitar callbacks diferidos
	local timer = self._activeTimers[character]
	if timer then
		pcall(task.cancel, timer)
		self._activeTimers[character] = nil
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local rootPart = character:FindFirstChild("HumanoidRootPart") :: BasePart?

	-- 2. Reactivar AnimationConstraints si es R15
	for _, desc in ipairs(character:GetDescendants()) do
		if desc:IsA("AnimationConstraint") then
			desc.Enabled = true
		end
	end

	-- 3. Limpiar instancias R6 si correspondía
	local r6Instances = self._r6Instances[character]
	if r6Instances then
		if rootPart then rootPart.Massless = false end
		for _, v in ipairs(character:GetDescendants()) do
			if v:IsA("Motor6D") then
				v.Enabled = true
			end
		end
		for _, inst in ipairs(r6Instances) do
			if inst and inst.Parent then
				inst:Destroy()
			end
		end
		self._r6Instances[character] = nil
	end

	-- 4. Anular colapso de RootJoint / TorsoWeld residuales si existieran
	if rootPart then
		rootPart.Massless = false
		local original = self._rootCollisions[character]
		if original ~= nil then rootPart.CanCollide = original end
		self._rootCollisions[character] = nil
		local rootJoint = rootPart:FindFirstChild("RootJoint") :: Motor6D?
		if rootJoint then
			rootJoint.Enabled = true
		end
		local torsoWeld = rootPart:FindFirstChild("TorsoWeld")
		if torsoWeld then
			torsoWeld:Destroy()
		end
	end

	-- Quiet Zero-Death recovery runs with the root anchored by ArenaRespawn.
	-- Reassemble R6 at rest BEFORE teleport/collision restoration; enabling motors
	-- alone leaves ragdoll limb poses for the next solver step to correct.
	if quietRespawn and r6Instances and rootPart and rootPart.Anchored then
		local motors: { Motor6D } = {}
		for _, joint in ipairs(character:GetDescendants()) do
			if joint:IsA("Motor6D") and joint.Part0 and joint.Part1 then
				joint.Transform = CFrame.identity
				table.insert(motors, joint)
			end
		end
		local positioned: { [BasePart]: boolean } = { [rootPart] = true }
		for _ = 1, #motors do
			local progressed = false
			for _, joint in ipairs(motors) do
				local a, b = joint.Part0, joint.Part1
				if a and b and positioned[a] and not positioned[b] then
					b.CFrame = a.CFrame * joint.C0 * joint.C1:Inverse()
					positioned[b] = true
					progressed = true
				end
			end
			if not progressed then break end
		end
	end

	-- 5. Restaurar estado de locomoción en Humanoid sin alterar Health
	if humanoid and humanoid.Health > 0 then
		humanoid.PlatformStand = false
		humanoid.AutoRotate = true

		local player = Players:GetPlayerFromCharacter(character)
		local stateEvent = self:_getStateEvent()
		if player and stateEvent and not quietRespawn then
			stateEvent:FireClient(player, true, nil, player:GetAttribute("MatchId"), character:GetAttribute("ArenaPhysicsGeneration") or 0, character)
		end

		pcall(function()
			humanoid:SetStateEnabled(Enum.HumanoidStateType.GettingUp, true)
			if quietRespawn then humanoid.Jump = false end
			humanoid:ChangeState(if quietRespawn then Enum.HumanoidStateType.Running else Enum.HumanoidStateType.GettingUp)
		end)
	end

	-- 6. Anular cualquier inercia o impulso en todas las partes del modelo
	for _, desc in ipairs(character:GetDescendants()) do
		if desc:IsA("BasePart") then
			desc.AssemblyLinearVelocity = Vector3.zero
			desc.AssemblyAngularVelocity = Vector3.zero
		end
	end

	return true
end

-- Calcula el vector tridimensional de impulso de lanzamiento a partir de un punto de origen
function RagdollService:ComputeLaunchVelocity(
	originPos: Vector3,
	targetPos: Vector3,
	forceMagnitude: number?,
	upwardRatio: number?
): Vector3
	local force = forceMagnitude or (Config.Ragdoll and Config.Ragdoll.BlastForce) or 110
	local upRatio = upwardRatio or (Config.Ragdoll and Config.Ragdoll.UpwardRatio) or 0.65
	upRatio = math.clamp(upRatio, 0.2, 0.9)

	local diff = targetPos - originPos
	local horizontal = Vector3.new(diff.X, 0, diff.Z)
	local horizDist = horizontal.Magnitude

	local horizDir: Vector3
	if horizDist > 0.5 then
		horizDir = horizontal.Unit
	else
		-- Directamente en el epicentro: dispersar en dirección horizontal aleatoria
		local angle = math.random() * math.pi * 2
		horizDir = Vector3.new(math.cos(angle), 0, math.sin(angle))
	end

	-- Componente vertical fuerte y garantizado para elevar al personaje por los aires (vence gravedad 196.2)
	local vertSpeed = math.max(force * upRatio * 1.3, 85)
	local horizSpeed = force * (1 - upRatio * 0.4)

	return horizDir * horizSpeed + Vector3.new(0, vertSpeed, 0)
end

-- Aplica un impulso físico de lanzamiento al personaje alejándolo de un punto de origen
function RagdollService:LaunchCharacter(character: Model, originPos: Vector3, forceMagnitude: number?, upwardRatio: number?)
	if not character or not character:IsDescendantOf(Workspace) then return end
	if character:GetAttribute("ArenaRespawnPending") then return end
	local owner = Players:GetPlayerFromCharacter(character)
	if owner and owner:GetAttribute("ResultsSessionId") ~= nil then return end

	local rootPart = character:FindFirstChild("HumanoidRootPart") :: BasePart? or character.PrimaryPart
	if not rootPart then return end

	local launchVel = self:ComputeLaunchVelocity(originPos, rootPart.Position, forceMagnitude, upwardRatio)

	-- Asignar velocidad lineal y rotacional en el servidor a todas las partes del cuerpo
	for _, part in ipairs(character:GetDescendants()) do
		if part:IsA("BasePart") then
			part.AssemblyLinearVelocity = launchVel
			part.AssemblyAngularVelocity = Vector3.new(
				math.random(-6, 6),
				math.random(-6, 6),
				math.random(-6, 6)
			)
		end
	end

	-- Notificar al cliente para que su simulación local replique el lanzamiento
	local player = Players:GetPlayerFromCharacter(character)
	local stateEvent = self:_getStateEvent()
	if player and stateEvent then
		stateEvent:FireClient(player, false, launchVel, player:GetAttribute("MatchId"), character:GetAttribute("ArenaPhysicsGeneration") or 0, character)
	end
end

-- Detona una onda expansiva en originPos, enviando en ragdoll y por los aires a todos los personajes dentro del radio
function RagdollService:BlastZone(
	originPos: Vector3,
	radius: number?,
	forceMagnitude: number?,
	upwardRatio: number?,
	duration: number?,
	filterFunc: ((Player?, Model) -> boolean)?
): number
	local blastRadius = radius or (Config.Ragdoll and Config.Ragdoll.BlastRadius) or 25
	local blastForce = forceMagnitude or (Config.Ragdoll and Config.Ragdoll.BlastForce) or 110
	local upRatio = upwardRatio or (Config.Ragdoll and Config.Ragdoll.UpwardRatio) or 0.65
	local ragDuration = duration or (Config.Ragdoll and Config.Ragdoll.DefaultDuration) or 2.0

	local affectedCount = 0

	for _, player in ipairs(Players:GetPlayers()) do
		local char = player.Character
		if char and char:IsDescendantOf(Workspace) then
			local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root then
				local dist = (root.Position - originPos).Magnitude
				if dist <= blastRadius then
					local allowed = true
					if filterFunc then
						allowed = filterFunc(player, char)
					end
					if allowed then
						local falloff = math.clamp(1 - (dist / blastRadius) * 0.35, 0.65, 1.0)
						local force = blastForce * falloff
						local launchVel = self:ComputeLaunchVelocity(originPos, root.Position, force, upRatio)

						self:ApplyRagdoll(char, ragDuration, launchVel)
						affectedCount += 1
					end
				end
			end
		end
	end

	return affectedCount
end

function RagdollService:Init(context)
	self._context = context
	self._activeTimers = {}
	self._r6Instances = {}
	self._rootCollisions = setmetatable({}, { __mode = "k" })
end

function RagdollService:Start(context)
	self._context = context
	print("[RagdollService] Servicio de Ragdoll activo, integrado con ReplicatedStorage.StateEvent y RagdollStatesHandler")
end

return RagdollService
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="550">
        <Properties>
          <string name="Name">Respawn</string>
        </Properties>
        <Item class="ModuleScript" referent="551">
          <Properties>
            <string name="Name">ArenaRespawn</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Zero-Death lifecycle owned by SpawnService. Keeps the same Character and independent VFX alive.
local Players=game:GetService("Players")
local Config=require(game.ReplicatedStorage.Shared.Config)
local Policy=require(game.ReplicatedStorage.Shared.ArenaRespawnPolicy)
local CharacterPhysics=require(script.Parent.CharacterPhysics)
local Lifecycle={}
Lifecycle.__index=Lifecycle
function Lifecycle.new(spawn) return setmetatable({Spawn=spawn,Pending={}},Lifecycle) end
function Lifecycle:Trace(record,phase)
 if not Config.Respawn.Debug then return end
 print("[RespawnDebug]",phase,"EliminationId",record.EliminationId,"UserId",record.Player.UserId,
  "Generation",record.Character:GetAttribute("ArenaPhysicsGeneration"),"Kind",record.Kind,
  "Session",record.Session.Id,"RoundState",record.Session.State,"State",record.Humanoid:GetState().Name,"Jump",record.Humanoid.Jump,
  "Linear",record.Root.AssemblyLinearVelocity,"Angular",record.Root.AssemblyAngularVelocity)
end
local function zero(character)
 for _,part in ipairs(character:GetDescendants()) do
  if part:IsA("BasePart") then part.AssemblyLinearVelocity=Vector3.zero;part.AssemblyAngularVelocity=Vector3.zero end
 end
end
function Lifecycle:Take(player)
 local record=self.Pending[player]
 if not record then return nil end
 self.Pending[player]=nil
 if record.Thread and record.Thread~=coroutine.running() then pcall(task.cancel,record.Thread) end
 if record.Connection then record.Connection:Disconnect() end
 return record
end
function Lifecycle:Restore(record)
 local character=record.Character
 if not character.Parent then return end
 for object,properties in pairs(record.Properties) do
  if object.Parent then for key,value in pairs(properties) do object[key]=value end end
 end
 -- Never adopt transient Physics/ragdoll collision values as the normal avatar contract.
 CharacterPhysics.Restore(character)
 local humanoid=record.Humanoid
 if humanoid.Parent then
  humanoid.Jump=false
  humanoid.AutoRotate=not humanoid:GetAttribute("MovementLocked") and record.AutoRotate
  humanoid.PlatformStand=record.PlatformStand
  humanoid.DisplayDistanceType=record.DisplayDistanceType
  humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping,record.JumpingEnabled)
 end
 zero(character)
 record.Root.Anchored=record.Anchored
 character:SetAttribute("ArenaRespawnPending",nil)
 character:SetAttribute("ArenaPhysicsPhase","Playing")
 self:Trace(record,"ServerRestored")
 if record.Root.Parent and not record.Root.Anchored then
  pcall(function()
   if record.OwnerAuto then record.Root:SetNetworkOwnershipAuto()
   else record.Root:SetNetworkOwner(record.Owner and record.Owner.Parent==Players and record.Owner or nil) end
  end)
 end
end
function Lifecycle:Cancel(player,reason,recover)
 local record=self.Pending[player]
 if not record then return end
 print("[ArenaRespawn] Cancelled",record.Session.Id,record.EliminationId,reason)
 self:Trace(record,"Cancelled:"..reason)
 if recover and player.Parent==Players and player.Character==record.Character then
  if self.Spawn:ResetCharacterInArena(player,record.Session.Id) then return end
 end
 record=self:Take(player)
 if record then self:Restore(record) end
end
function Lifecycle:CancelSession(id,reason,recover)
 local players={}
 for player,record in pairs(self.Pending) do if record.Session.Id==id then table.insert(players,player) end end
 for _,player in ipairs(players) do self:Cancel(player,reason,recover) end
end
function Lifecycle:Begin(player,session,eliminationId,kind)
 if self.Pending[player] then return false end
 local character=player.Character
 local humanoid=character and character:FindFirstChildOfClass("Humanoid")
 local root=character and character:FindFirstChild("HumanoidRootPart")
 if not character or not humanoid or not root or humanoid.Health<=0 then return false end
 local delayMs,valid=Policy.NormalizeDelayMs(Config.Respawn.KillPartDelayMs,Config.Respawn.MaxKillPartDelayMs)
 if not valid then warn("[ArenaRespawn] Invalid/out-of-range KillPartDelayMs normalized to",delayMs) end
 local ownerAuto,owner=true,nil
 pcall(function()ownerAuto=root:GetNetworkOwnershipAuto();owner=root:GetNetworkOwner();root:SetNetworkOwner(nil)end)
 local generation=(character:GetAttribute("ArenaPhysicsGeneration") or 0)+1
 local ragdoll=self.Spawn:_getRagdollService()
 local hadRagdoll=ragdoll and ragdoll:IsRagdolled(character) or false
 local record={Player=player,Character=character,Humanoid=humanoid,Root=root,Session=session,
  StateVersion=session.StateVersion,Generation=generation,EliminationId=eliminationId,Kind=kind or "KillPart",
  Anchored=root.Anchored,OwnerAuto=ownerAuto,Owner=owner,Properties={},Started=os.clock(),
  AutoRotate=humanoid.AutoRotate,PlatformStand=false,JumpingEnabled=humanoid:GetStateEnabled(Enum.HumanoidStateType.Jumping),
  DisplayDistanceType=humanoid.DisplayDistanceType}
 self.Pending[player]=record
 character:SetAttribute("ArenaPhysicsPhase","Retired")
 character:SetAttribute("ArenaRespawnDebug",Config.Respawn.Debug==true)
 character:SetAttribute("ArenaEliminationId",eliminationId)
 character:SetAttribute("ArenaPhysicsGeneration",generation)
 character:SetAttribute("ArenaRespawnPending",true)
 character:SetAttribute("ArenaRespawnRevision",(character:GetAttribute("ArenaRespawnRevision") or 0)+1)
 root.Anchored=true
 -- Cancel old ragdoll callbacks/constraints without a GettingUp impulse or a new launch.
 if ragdoll then ragdoll:ResetRagdollImmediate(character,true) end
 record.AutoRotate=humanoid.AutoRotate
 local function hide(object)
  if record.Properties[object] then return end
  if object:IsA("BasePart") then
   record.Properties[object]={Transparency=object.Transparency,CanCollide=object.CanCollide,
    CanTouch=object.CanTouch,CanQuery=object.CanQuery,CastShadow=object.CastShadow}
   object.Transparency=1;object.CanCollide=false;object.CanTouch=false;object.CanQuery=false;object.CastShadow=false
  elseif object:IsA("Decal") then record.Properties[object]={Transparency=object.Transparency};object.Transparency=1
  elseif object:IsA("ParticleEmitter") or object:IsA("Trail") or object:IsA("Beam") then
   record.Properties[object]={Enabled=object.Enabled};object.Enabled=false
  elseif object:IsA("BillboardGui") then record.Properties[object]={Enabled=object.Enabled};object.Enabled=false end
 end
 for _,object in ipairs(character:GetDescendants()) do hide(object) end
 record.Connection=character.DescendantAdded:Connect(hide)
 humanoid.Jump=false;humanoid.AutoRotate=false;humanoid.PlatformStand=true
 humanoid.DisplayDistanceType=Enum.HumanoidDisplayDistanceType.None
 humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping,false)
 zero(character)
 self:Trace(record,if hadRagdoll then "RetiredAfterRagdoll" else "RetiredWithoutRagdoll")
 print("[ArenaRespawn] Retired",session.Id,eliminationId,"Generation",generation,"DelayMs",delayMs)
 record.Thread=task.delay(math.max(0,delayMs/1000-(os.clock()-record.Started)),function()
  record.Thread=nil
  if self.Pending[player]~=record then return end
  local rounds=self.Spawn:_getRoundService()
  local current=rounds:GetSessionForPlayer(player)
  if player.Parent~=Players or not Policy.IsCurrent(record,current,player.Character,character:GetAttribute("ArenaPhysicsGeneration"))
   or rounds:GetSessionParticipant(session.Id,player)==nil then
   -- Obsolete timers only release their own resources; never reposition any Character.
   self:Cancel(player,"StaleTimer",false)
   return
  end
  local ok,failure=pcall(self.Spawn.ResetCharacterInArena,self.Spawn,player,session.Id)
  if not ok or not failure then
   warn("[ArenaRespawn] Respawn failed",session.Id,eliminationId,tostring(failure))
   self:Cancel(player,"PlacementFailed",false)
   if rounds._cancelSession then rounds:_cancelSession("KillPartRespawnFailed",session.Id) end
   return
  end
  print("[ArenaRespawn] Restored",session.Id,eliminationId,"ElapsedMs",math.floor((os.clock()-record.Started)*1000))
 end)
 return true
end
return Lifecycle
]]></string>
          </Properties>
