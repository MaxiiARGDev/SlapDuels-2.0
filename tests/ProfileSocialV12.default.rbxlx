      <Item class="ModuleScript" referent="503">
        <Properties>
          <string name="Name">MovementGuard</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Server-owned movement, conservative body sweep and explicit arena envelope.
local Guard = {}
local function segmentBox(cf,size,origin,delta,padding)
 local p=cf:PointToObjectSpace(origin)
 local d=cf:VectorToObjectSpace(delta)
 local half=size/2+Vector3.new(padding,padding,padding)
 local lo,hi=0,1
 for _,axis in {"X","Y","Z"} do
  if math.abs(d[axis])<1e-6 then
   if math.abs(p[axis])>half[axis] then return nil end
  else
   local a,b=(-half[axis]-p[axis])/d[axis],(half[axis]-p[axis])/d[axis]
   if a>b then a,b=b,a end
   lo=math.max(lo,a);hi=math.min(hi,b)
   if lo>hi then return nil end
  end
 end
 return lo
end
Guard.SegmentBox=segmentBox
function Guard.CanOwn(root)
 local ok,allowed=pcall(function() return root:CanSetNetworkOwnership() end)
 return ok and allowed
end
function Guard.Take(root)
 if not Guard.CanOwn(root) then return false,nil,"OwnershipUnavailable" end
 local captured,ownership=pcall(function() return {Auto=root:GetNetworkOwnershipAuto(),Owner=root:GetNetworkOwner()} end)
 if not captured then return false,nil,"OwnershipCaptureFailed" end
 local ok=pcall(function() root:SetNetworkOwner(nil) end)
 return ok,if ok then ownership else nil,if ok then nil else "OwnershipTakeFailed"
end
function Guard.Release(root,ownership)
 if root and root.Parent and ownership then pcall(function()
  if root:GetNetworkOwner()~=nil then return end -- A newer explicit owner wins.
  if ownership.Auto then root:SetNetworkOwnershipAuto() else root:SetNetworkOwner(ownership.Owner) end
 end) end
end
function Guard.SafeDistance(record,delta)
 if delta.Magnitude<1e-5 then return 0,"ZeroDisplacement" end
 local root=record.Root
 local size=Vector3.new(3,3,3)
 local params=RaycastParams.new()
 params.FilterType=Enum.RaycastFilterType.Exclude
 params.FilterDescendantsInstances={record.Character}
 params.RespectCanCollide=true
 local overlap=OverlapParams.new()
 overlap.FilterType=Enum.RaycastFilterType.Exclude
 overlap.FilterDescendantsInstances={record.Character}
 overlap.RespectCanCollide=true
 -- Blockcast does not detect an initial overlap. Fail closed on such overlaps.
 if #workspace:GetPartBoundsInBox(root.CFrame,size,overlap)>0 then return 0,"InitialOverlap" end
 local hit=workspace:Blockcast(root.CFrame,size,delta,params)
 local distance=if hit then math.max(0,hit.Distance-0.3) else delta.Magnitude
 local reason=if hit then "ObstacleSweep" else "Clear"
 local info=record.World
 if not info or not info.VoidBoundaryPart then return 0,"MissingArenaBounds" end
 local bounds=info.VoidBoundaryPart
 local relative=root.Position-bounds.Position
 local endRelative=relative+delta
 if math.abs(endRelative.X)>bounds.Size.X/2-3 or math.abs(endRelative.Z)>bounds.Size.Z/2-3 then return 0,"ArenaEnvelope" end
 -- Noncolliding KillPart/void sensors may have CanQuery=false. Never skip them
 -- merely because they are absent from a physics query.
 for _,part in info.KillParts or {} do
  local t=segmentBox(part.CFrame,part.Size,root.Position,delta,1.5)
  if t then
   local clipped=math.max(0,t*delta.Magnitude-0.3)
   if clipped<distance then distance=clipped;reason="KillPartSweep" end
  end
 end
 return distance,reason
end
return Guard
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="504">
        <Properties>
          <string name="Name">StrongSlapAbility</string>
          <string name="Source"><![CDATA[--!nonstrict
local Strong={}
function Strong.Start(record) record.State="Armed";return true end
function Strong.Step(_record,_dt) return true end
function Strong.Cancel(_record) end
Strong.Descriptor={Id="StrongSlap",DisplayName="Golpe Fuerte",Description="Prepara el próximo impacto válido durante 15 s. Eliminación inmediata.",Type="Ofensiva",
 Duration=15,Cooldown=25,Icon="",SortOrder=20,ActiveLabel="PREPARADA"}
Strong.Enabled=true
Strong.Config={PresentationLift=25}
Strong.ConfigSchema={PresentationLift={Type="number",Min=0,Max=100}}
Strong.Shop={Price=3000,PriceApproved=true,PurchaseEnabled=true}
Strong.Dependencies={}
Strong.Input={Primary="None"}
Strong.Assets={Key="StrongSlap",Profile="AttachmentEffect",Cues={Impact={Profile="VerticalLaunch",Resource="LaunchSpectacle",Lift=Strong.Config.PresentationLift,Duration=0.65}}}
Strong.Hooks={Profile="ImmediateElimination",Reason="StrongSlap",Cue="Impact",
 BeforeHit=function(record) return record.State=="Armed" end,
 Consume=function(record)
  if record.State~="Armed" then return false end
  record.State="Consumed";return true
 end}
return Strong
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="505">
        <Properties>
          <string name="Name">Templates</string>
        </Properties>
        <Item class="ModuleScript" referent="506">
          <Properties>
            <string name="Name">AbilityTemplate</string>
            <string name="Source"><![CDATA[--!nonstrict
-- DOCUMENTATION ONLY. Not in AbilityManifest; rejected even if added by mistake.
-- Copy to the direct Abilities folder, rename, review, then remove IsTemplate.
local Ability={
 IsTemplate=true,Enabled=false,
 Descriptor={Id="ReplaceWithUniqueId",DisplayName="Nombre",Description="Descripción de la habilidad.",
  Type="Utilidad",Duration=1,Cooldown=10,Icon="",SortOrder=60},
 Config={},ConfigSchema={},Dependencies={},
 Assets={Profile="None"}, -- Or AttachmentEffect / InvisibleAvatar, Key="YourAssetFolder".
 Shop={Price=0,PriceApproved=false,PurchaseEnabled=false},
 Input={Primary="None"}, -- Direction is validated by the server input adapter.
}
function Ability.ValidateActivation(_runtime,_input) return true end
function Ability.Start(runtime,_input)
 -- No waits, tasks, connections or delayed work. Store only activation-local state.
 runtime.Started=true
 return true -- false rejects activation without spending the cooldown.
end
function Ability.Step(_runtime,_dt)
 return true -- optional; false ends the active window, preserving cooldown.
end
function Ability.Cancel(runtime)
 -- Safe after partial Start and safe to call repeatedly. Restore only values owned
 -- by this activation; never overwrite a later movement/visual owner.
 runtime.Started=false
end
return Ability
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
    <Item class="Script" referent="507">
      <Properties>
        <string name="Name">Bootstrap</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
-- Bootstrap
-- Punto de entrada del servidor. Requiere los servicios, ejecuta Init() y Start()
-- en orden controlado, y maneja errores de inicializacion de forma clara.

local ServerScriptService = game:GetService("ServerScriptService")

local ServicesFolder = ServerScriptService:WaitForChild("Services", 10)
assert(ServicesFolder, "[Bootstrap] No se encontro ServerScriptService.Services")

local PersistenceFolder = ServicesFolder:WaitForChild("Persistence", 10)
assert(PersistenceFolder, "[Bootstrap] No se encontro ServerScriptService.Services.Persistence")
local PersistenceEnvironment = require(PersistenceFolder:WaitForChild("PersistenceEnvironment"))
local persistenceSelection = PersistenceEnvironment.Resolve()

print(string.format(
	"[Bootstrap] PersistenceEnvironment=%s PersistenceProvider=%s WritesToCloud=%s GameId=%d PlaceId=%d",
	persistenceSelection.Environment,
	persistenceSelection.ProviderName,
	tostring(persistenceSelection.WritesToCloud),
	persistenceSelection.GameId,
	persistenceSelection.PlaceId
))
if persistenceSelection.BlockedReason then
	warn(string.format("[Bootstrap] Persistencia bloqueada de forma segura: %s", persistenceSelection.BlockedReason))
end

-- Seal the approved ability catalog before ShopService builds its products.
-- Only direct, explicitly named ModuleScripts are eligible for require.
local abilityFolder = ServerScriptService:WaitForChild("Abilities")
local AbilityRegistry = require(ServicesFolder:WaitForChild("AbilityRegistry"))
local AbilityAssets = require(abilityFolder:WaitForChild("AbilityAssetValidator"))
AbilityRegistry.Initialize({
 Manifest = require(abilityFolder:WaitForChild("AbilityManifest")),
 DefaultId = require(game.ReplicatedStorage.Shared.AbilityDefinitions).DefaultId,
 Resolve = function(name)
  local found
  for _,child in ipairs(abilityFolder:GetChildren()) do
   if child.Name == name then
    assert(found == nil, "AmbiguousAbilityModule: " .. name)
    found = child
   end
  end
  return found
 end,
 IsModule = function(value) return value:IsA("ModuleScript") and value.Parent == abilityFolder end,
 Load = require,
 HasDependency = function(name)
  local dependency = abilityFolder:FindFirstChild(name)
  return name == "MovementGuard" and dependency ~= nil and dependency:IsA("ModuleScript")
 end,
 CheckAssets = function(assets)
  return AbilityAssets.Validate(assets, game.ReplicatedStorage:FindFirstChild("AbilityEffects"))
 end,
 Warn = warn,
})

-- Orden de carga controlado. Cada servicio expone Name, Init(context) y Start(context).
local SERVICE_ORDER = {
	"PlayerDataService",
	"PlayerService",
	"ShopService",
	"RagdollService",
	"MatchInstanceService",
	"SpawnService",
	"PointFeedbackService",
	"PointEffectTestService",
	"ScoreService",
	"RoundService",
	"MatchmakingFeedbackService",
	"MatchmakingService",
	"CombatService",
	"KnockbackService",
	"EliminationService",
	"DeathEffectService",
	"SlapService",
	"AbilityService",
	"CrateService",
	"CoinShopAccessService",
	"PremiumShopService",
	"SocialPlayService",
	"SocialService",
}

local loadedServices: { [string]: any } = {}
local initializedServices = {}

-- Carga de modulos
for _, name in ipairs(SERVICE_ORDER) do
	local moduleScript = ServicesFolder:FindFirstChild(name)
	if not moduleScript or not moduleScript:IsA("ModuleScript") then
		warn(string.format("[Bootstrap] Servicio no encontrado o invalido: %s", name))
		continue
	end

	local ok, result = pcall(require, moduleScript)
	if not ok then
		warn(string.format("[Bootstrap] Error al requerir %s: %s", name, tostring(result)))
		continue
	end

	loadedServices[name] = result
end

-- Contexto compartido: permite referencias controladas sin dependencias circulares.
local context = {
	Services = loadedServices,
	PersistenceProvider = persistenceSelection.Provider,
	PersistenceInfo = persistenceSelection,
	GetService = function(_self, name: string)
		return loadedServices[name]
	end,
}

-- Init() en todos
for _, name in ipairs(SERVICE_ORDER) do
	local service = loadedServices[name]
	if not service then
		continue
	end

	if type(service.Init) == "function" then
		local ok, err = pcall(function()
			service:Init(context)
		end)
		if ok then
			table.insert(initializedServices, name)
		else
			warn(string.format("[Bootstrap] Error en Init() de %s: %s", name, tostring(err)))
		end
	else
		warn(string.format("[Bootstrap] %s no implementa Init()", name))
	end
end

-- Start() en todos
for _, name in ipairs(SERVICE_ORDER) do
	local service = loadedServices[name]
	if not service then
		continue
	end

	if type(service.Start) == "function" then
		local ok, err = pcall(function()
			service:Start(context)
		end)
		if not ok then
			warn(string.format("[Bootstrap] Error en Start() de %s: %s", name, tostring(err)))
		end
	else
		warn(string.format("[Bootstrap] %s no implementa Start()", name))
	end
end

print(string.format("[Bootstrap] Servicios inicializados: %s", table.concat(initializedServices, ", ")))
print("[Bootstrap] Arranque completado")
]]></string>
      </Properties>
    </Item>
    <Item class="Folder" referent="508">
      <Properties>
        <string name="Name">PointEffectControllers</string>
      </Properties>
      <Item class="ModuleScript" referent="509">
        <Properties>
          <string name="Name">BasicController</string>
          <string name="Source"><![CDATA[--!strict
-- BasicController
-- Coreografia del Point Effect "Basic". Es data-driven: lee atributos del template (editables en Studio).
--   ParticleEmitter: EmitCount, EmitDelay
--   Sound:           PlayDelay
--   PointLight:      LightPeak, LightIn, LightFade   (destello de luz)
--   Beam:            PulsePeak, PulseTopRatio, PulseIn, PulseOut (pulso de la columna de luz)
--   Model:           Duration, FinalMultiplier
local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")

local PointEffectRegistry = require(script.Parent.PointEffectRegistry)

type PlayContext = PointEffectRegistry.PlayContext
type EffectHandle = PointEffectRegistry.EffectHandle

local BasicController = {}

local function num(inst: Instance, attr: string, default: number): number
	local v = inst:GetAttribute(attr)
	if typeof(v) == "number" then
		return v
	end
	return default
end

function BasicController.Play(context: PlayContext): EffectHandle
	local model = context.EffectModel
	local isFinalPoint = context.IsFinalPoint

	local isActive = true
	local scheduledThreads: { thread } = {}
	local activeTweens: { Tween } = {}

	local function schedule(delaySeconds: number, fn: () -> ())
		if not isActive then return end
		local t: thread
		t = task.delay(delaySeconds, function()
			if not isActive then return end
			local idx = table.find(scheduledThreads, t)
			if idx then
				table.remove(scheduledThreads, idx)
			end
			fn()
		end)
		table.insert(scheduledThreads, t)
	end

	local function tween(inst: Instance, info: TweenInfo, goal: { [string]: any })
		local tw = TweenService:Create(inst, info, goal)
		table.insert(activeTweens, tw)
		tw:Play()
	end

	local duration = num(model, "Duration", 1.8)
	if duration <= 0 then duration = 1.8 end
	local multiplier = if isFinalPoint then num(model, "FinalMultiplier", 1.4) else 1

	-- Estado inicial seguro
	for _, desc in ipairs(model:GetDescendants()) do
		if desc:IsA("ParticleEmitter") then
			desc.Enabled = false
			desc.Rate = 0
		elseif desc:IsA("Sound") then
			desc.Looped = false
		end
	end

	-- Programar todo segun atributos
	for _, desc in ipairs(model:GetDescendants()) do
		if desc:IsA("ParticleEmitter") then
			local emitter = desc
			local count = math.max(1, math.floor(num(emitter, "EmitCount", 1) * multiplier + 0.5))
			local delay = num(emitter, "EmitDelay", 0)
			if delay <= 0 then
				emitter:Emit(count)
			else
				schedule(delay, function()
					if emitter.Parent then emitter:Emit(count) end
				end)
			end

		elseif desc:IsA("Sound") then
			local sound = desc
			if isFinalPoint then
				sound.Volume = math.min(sound.Volume * 1.15, 10)
			end
			local delay = num(sound, "PlayDelay", 0)
			if delay <= 0 then
				sound:Play()
			else
				schedule(delay, function()
					if sound.Parent then sound:Play() end
				end)
			end

		elseif desc:IsA("PointLight") then
			local light = desc
			local peak = num(light, "LightPeak", 0) * (if isFinalPoint then 1.2 else 1)
			if peak > 0 then
				light.Brightness = 0
				tween(light, TweenInfo.new(num(light, "LightIn", 0.04), Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Brightness = peak })
				schedule(num(light, "LightIn", 0.04), function()
					if light.Parent then
						tween(light, TweenInfo.new(num(light, "LightFade", 0.5), Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Brightness = 0 })
					end
				end)
			end

		elseif desc:IsA("Beam") then
			local beam = desc
			local peak = num(beam, "PulsePeak", 0) * (if isFinalPoint then 1.25 else 1)
			if peak > 0 then
				local topRatio = num(beam, "PulseTopRatio", 0.35)
				local pulseIn = num(beam, "PulseIn", 0.07)
				local pulseOut = num(beam, "PulseOut", 0.45)
				beam.Width0 = 0
				beam.Width1 = 0
				tween(beam, TweenInfo.new(pulseIn, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Width0 = peak, Width1 = peak * topRatio })
				schedule(pulseIn, function()
					if beam.Parent then
						tween(beam, TweenInfo.new(pulseOut, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Width0 = 0, Width1 = 0 })
					end
				end)
			end
		end
	end

	local function cleanup()
		if not isActive then return end
		isActive = false

		for _, th in ipairs(scheduledThreads) do
			pcall(task.cancel, th)
		end
		table.clear(scheduledThreads)

		for _, tw in ipairs(activeTweens) do
			pcall(function() tw:Cancel() end)
		end
		table.clear(activeTweens)

		if model and model.Parent then
			for _, desc in ipairs(model:GetDescendants()) do
				if desc:IsA("Sound") and desc.IsPlaying then
					pcall(function() desc:Stop() end)
				elseif desc:IsA("ParticleEmitter") then
					desc.Enabled = false
				end
			end
			model:Destroy()
		end
	end

	schedule(duration, cleanup)
	Debris:AddItem(model, duration + 1.0)

	local handle: EffectHandle = {
		Stop = function(_self) cleanup() end,
		Destroy = function(_self) cleanup() end,
		IsActive = function(_self) return isActive end,
	}

	return handle
end

PointEffectRegistry.Register("Basic", BasicController)

return BasicController
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="510">
        <Properties>
          <string name="Name">InfernoController</string>
          <string name="Source"><![CDATA[--!strict
-- InfernoController
-- Coreografia exclusiva del Point Effect "Inferno". Reutiliza los componentes del template
-- ServerStorage.PointEffects.Inferno (no crea instancias ni modifica SoundIds) y respeta el contrato
-- de PointEffectRegistry: Play(context) -> EffectHandle { Stop, Destroy, IsActive }.
--
-- Atributos existentes que se leen (mismos que BasicController, sin cambiar sus valores):
--   Model:           Duration (ciclo de vida/cleanup), FinalMultiplier
--   ParticleEmitter: EmitCount, EmitDelay (offset dentro de su fase)
--   Sound:           PlayDelay (offset dentro de su fase)
--   PointLight:      LightPeak, LightIn, LightFade
--   Beam:            PulsePeak, PulseTopRatio, PulseIn
-- Atributo OPCIONAL del Model (si no existe se usa el valor por defecto):
--   CinematicDuration: duracion de la cinematica en segundos (default 4.6). Se limita para que la
--   cinematica + la cola de particulas quepan dentro de Duration.
--
-- Fases: Ignition -> Eruption -> Pillar -> Expansion (oleadas) -> Fragmentation -> Dissipation.
-- Toda la secuencia corre en UN solo hilo (task.spawn + task.wait), sin esperas bloqueantes.
local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")

local PointEffectRegistry = require(script.Parent.PointEffectRegistry)

type PlayContext = PointEffectRegistry.PlayContext
type EffectHandle = PointEffectRegistry.EffectHandle

type Burst = { phase: string, offset: number?, fraction: number, finalOnly: boolean? }
type Event = { time: number, order: number, run: () -> () }

local InfernoController = {}

-- Hook opcional SOLO para pruebas: recibe (nombreDeFase, segundosTranscurridos). nil en produccion.
InfernoController.DebugHook = nil :: ((phase: string, elapsed: number) -> ())?

local DEFAULT_DURATION = 8
local BASE_LENGTH = 4.6 -- duracion de la cinematica a escala 1 (segundos)
local TAIL_MARGIN = 1.6 -- vida maxima de particulas existentes (~1.3 s) + margen
local MIN_SCALE = 0.25
local MAX_SCALE = 3

-- Inicio de cada fase (segundos a escala 1)
local PHASES: { [string]: number } = {
	Ignition = 0,
	Eruption = 0.12,
	Pillar = 0.38,
	Expansion = 0.85, -- primera oleada; la 2da y 3ra usan offset (ver BURSTS)
	Fragmentation = 2.7,
	Dissipation = 3.3,
	End = BASE_LENGTH,
}
local PHASE_ORDER = { "Ignition", "Eruption", "Pillar", "Expansion", "Fragmentation", "Dissipation" }
local WAVE_OFFSETS = { 0, 0.65, 1.3 }

-- Plan de emisiones puntuales por emisor (nombre -> rafagas). fraction multiplica EmitCount.
local BURSTS: { [string]: { Burst } } = {
	-- Ignicion: destello inicial + primeras chispas
	Glow = { { phase = "Ignition", fraction = 1 }, { phase = "Fragmentation", fraction = 1 } },
	Core = { { phase = "Ignition", fraction = 1 } },
	Halo = { { phase = "Ignition", fraction = 1 } },
	Glints = { { phase = "Ignition", fraction = 1 }, { phase = "Fragmentation", fraction = 0.6 } },
	GlintsLate = { { phase = "Eruption", fraction = 1 }, { phase = "Fragmentation", fraction = 1 } },
	-- Erupcion + fragmentacion
	Sparks = {
		{ phase = "Ignition", fraction = 0.3 },
		{ phase = "Eruption", fraction = 0.7 },
		{ phase = "Fragmentation", fraction = 0.8 },
	},
	Embers = { { phase = "Eruption", fraction = 1 }, { phase = "Fragmentation", fraction = 0.6 } },
	Puff = { { phase = "Eruption", fraction = 1 }, { phase = "Fragmentation", fraction = 0.5 } },
	-- Expansion: oleadas temporizadas (la 3ra solo en punto final)
	Disc = {
		{ phase = "Expansion", offset = WAVE_OFFSETS[1], fraction = 1 },
		{ phase = "Expansion", offset = WAVE_OFFSETS[2], fraction = 1 },
		{ phase = "Expansion", offset = WAVE_OFFSETS[3], fraction = 1, finalOnly = true },
	},
	DiscGlow = {
		{ phase = "Expansion", offset = WAVE_OFFSETS[1], fraction = 1 },
		{ phase = "Expansion", offset = WAVE_OFFSETS[2], fraction = 1 },
		{ phase = "Expansion", offset = WAVE_OFFSETS[3], fraction = 1, finalOnly = true },
	},
	Streaks = {
		{ phase = "Expansion", offset = WAVE_OFFSETS[1], fraction = 0.6 },
		{ phase = "Expansion", offset = WAVE_OFFSETS[2], fraction = 0.8 },
		{ phase = "Expansion", offset = WAVE_OFFSETS[3], fraction = 0.5, finalOnly = true },
	},
	Dust = {
		{ phase = "Expansion", offset = WAVE_OFFSETS[1], fraction = 0.6 },
		{ phase = "Expansion", offset = WAVE_OFFSETS[2], fraction = 0.6 },
	},
}

-- Emision sostenida durante la columna (particulas/seg a escala 1), se reduce en la disipacion
local SUSTAIN: { [string]: number } = { Embers = 26, Sparks = 8, Puff = 4 }

-- Fase en la que arranca cada sonido existente (se suma su PlayDelay). Desconocidos: PlayDelay como en Basic.
local SOUND_PHASES: { [string]: string } = {
	Thump = "Ignition",
	Snap = "Ignition",
	Boom = "Eruption",
	Crack = "Pillar",
	Ping = "Fragmentation",
	Glint = "Fragmentation",
}

-- Instancias activas por modelo: garantiza una sola ejecucion por instancia del efecto
local activeHandles: { [Instance]: EffectHandle } = {}

local function num(inst: Instance, attr: string, default: number): number
	local v = inst:GetAttribute(attr)
	if typeof(v) == "number" then
		return v
	end
	return default
end

function InfernoController.Play(context: PlayContext): EffectHandle
	local model = context.EffectModel
	local isFinalPoint = context.IsFinalPoint

	-- Una sola vez por instancia: si ya hay una secuencia activa sobre este modelo, se reutiliza su handle
	local existing = activeHandles[model]
	if existing and existing:IsActive() then
		return existing
	end

	local isActive = true
	local events: { Event } = {}
	local activeTweens: { Tween } = {}
	local driver: thread? = nil
	local destroyingConn: RBXScriptConnection? = nil
	local order = 0
	local startClock = os.clock()
	local rng = Random.new()

	local duration = num(model, "Duration", DEFAULT_DURATION)
	if duration <= 0 then
		duration = DEFAULT_DURATION
	end
	local multiplier = if isFinalPoint then num(model, "FinalMultiplier", 1.4) else 1
	local rateMul = math.min(multiplier, 3)

	-- Escala temporal configurable, limitada para que cinematica + cola quepan en Duration
	local scale = math.clamp(num(model, "CinematicDuration", BASE_LENGTH) / BASE_LENGTH, MIN_SCALE, MAX_SCALE)
	local maxScale = (duration - TAIL_MARGIN) / BASE_LENGTH
	if scale > maxScale then
		scale = math.max(maxScale, MIN_SCALE)
	end

	local function at(phase: string, offset: number?): number
		return ((PHASES[phase] or 0) + (offset or 0)) * scale
	end

	local function add(time: number, run: () -> ())
		if time >= duration then
			return -- nada se programa mas alla del ciclo de vida del modelo
		end
		order += 1
		table.insert(events, { time = math.max(time, 0), order = order, run = run })
	end

	local function mark(name: string)
		local hook = InfernoController.DebugHook
		if hook then
			pcall(hook, name, os.clock() - startClock)
		end
	end

	local function tween(inst: Instance, info: TweenInfo, goal: { [string]: any })
		if not isActive then
			return
		end
		local tw = TweenService:Create(inst, info, goal)
		table.insert(activeTweens, tw)
		tw:Play()
	end

	-- Cleanup (declarado antes de conectar Destroying)
	local function cleanup()
		if not isActive then
			return
		end
		isActive = false
		mark("Cleanup")
		activeHandles[model] = nil

		if destroyingConn then
			destroyingConn:Disconnect()
			destroyingConn = nil
		end

		if driver and driver ~= coroutine.running() then
			pcall(task.cancel, driver)
		end
		driver = nil

		for _, tw in ipairs(activeTweens) do
			pcall(function()
				tw:Cancel()
			end)
		end
		table.clear(activeTweens)
		table.clear(events)

		if model.Parent then
			for _, desc in ipairs(model:GetDescendants()) do
				if desc:IsA("Sound") and desc.IsPlaying then
					pcall(function()
						desc:Stop()
					end)
				elseif desc:IsA("ParticleEmitter") then
					desc.Enabled = false
					desc.Rate = 0
				end
			end
			model:Destroy()
		end
	end

	-- Recolectar componentes existentes y dejarlos en estado inicial seguro
	local emitters: { ParticleEmitter } = {}
	local sounds: { Sound } = {}
	local lights: { PointLight } = {}
	local beams: { Beam } = {}
	for _, desc in ipairs(model:GetDescendants()) do
		if desc:IsA("ParticleEmitter") then
			desc.Enabled = false
			desc.Rate = 0
			table.insert(emitters, desc)
		elseif desc:IsA("Sound") then
			desc.Looped = false
			table.insert(sounds, desc)
		elseif desc:IsA("PointLight") then
			table.insert(lights, desc)
		elseif desc:IsA("Beam") then
			table.insert(beams, desc)
		end
	end

	-- Marcadores de fase (se insertan primero: en un mismo instante van antes que sus componentes)
	for _, phase in ipairs(PHASE_ORDER) do
		local name = phase
		add(at(name), function()
			mark(name)
		end)
	end

	-- Rafagas de particulas
	for _, emitter in ipairs(emitters) do
		local base = num(emitter, "EmitCount", 1)
		local emitOffset = math.max(num(emitter, "EmitDelay", 0), 0)
		local plan = BURSTS[emitter.Name]
		if plan then
			for _, burst in ipairs(plan) do
				if not burst.finalOnly or isFinalPoint then
					local count = math.max(1, math.floor(base * multiplier * burst.fraction + 0.5))
					add(at(burst.phase, burst.offset) + emitOffset, function()
						if emitter.Parent then
							emitter:Emit(count)
						end
					end)
				end
			end
		else
			-- Emisor no previsto: se comporta como en Basic (una emision segun EmitDelay)
			local count = math.max(1, math.floor(base * multiplier + 0.5))
			add(emitOffset, function()
				if emitter.Parent then
					emitter:Emit(count)
				end
			end)
		end
	end

	-- Emision sostenida durante la columna y reduccion en la disipacion
	local dissipationLength = (PHASES.End - PHASES.Dissipation) * scale
	for _, emitter in ipairs(emitters) do
		local sustain = SUSTAIN[emitter.Name]
		if sustain then
			local target = sustain * rateMul
			add(at("Pillar"), function()
				if emitter.Parent then
					emitter.Enabled = true
					tween(emitter, TweenInfo.new(0.5 * scale, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Rate = target })
				end
			end)
			add(at("Dissipation"), function()
				if emitter.Parent then
					tween(emitter, TweenInfo.new(dissipationLength * 0.75, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Rate = 0 })
				end
			end)
			add(at("End"), function()
				if emitter.Parent then
					emitter.Rate = 0
					emitter.Enabled = false
				end
			end)
		end
	end

	-- Iluminacion: pico de ignicion -> brasa -> parpadeo de columna -> pico de fragmentacion -> apagado
	for _, light in ipairs(lights) do
		local peak = num(light, "LightPeak", 0) * (if isFinalPoint then 1.2 else 1)
		if peak > 0 then
			local lightIn = math.max(num(light, "LightIn", 0.04), 0.01)
			local lightFade = math.max(num(light, "LightFade", 0.5), 0.1)
			light.Brightness = 0

			local function lightTo(time: number, level: number, dur: number, style: Enum.EasingStyle, dir: Enum.EasingDirection)
				add(time, function()
					if light.Parent then
						tween(light, TweenInfo.new(dur, style, dir), { Brightness = level })
					end
				end)
			end

			lightTo(at("Ignition"), peak, lightIn, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			lightTo(at("Ignition") + lightIn, peak * 0.45, 0.3 * scale, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

			local flickerStep = math.max(0.2 * scale, 0.05)
			local t = at("Pillar")
			local flickerEnd = at("Fragmentation") - flickerStep
			local guard = 0
			while t < flickerEnd and guard < 24 do
				lightTo(t, peak * (0.3 + 0.2 * rng:NextNumber()), flickerStep * 0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
				t += flickerStep
				guard += 1
			end

			lightTo(at("Fragmentation"), peak * 0.8, 0.05, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			lightTo(at("Fragmentation") + 0.05, peak * 0.3, lightFade * scale, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			lightTo(at("Dissipation"), 0, dissipationLength * 0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			add(at("End"), function()
				if light.Parent then
					light.Brightness = 0
				end
			end)
		end
	end

	-- Columna infernal: el Beam crece progresivamente, respira durante las oleadas, se sobrecarga y colapsa
	for _, beam in ipairs(beams) do
		local peak = num(beam, "PulsePeak", 0) * (if isFinalPoint then 1.25 else 1)
		if peak > 0 then
			local topRatio = num(beam, "PulseTopRatio", 0.35)
			local surgeIn = math.max(num(beam, "PulseIn", 0.07), 0.02)
			beam.Width0 = 0
			beam.Width1 = 0

			local function beamTo(time: number, factor: number, dur: number, style: Enum.EasingStyle, dir: Enum.EasingDirection)
				add(time, function()
					if beam.Parent then
						tween(beam, TweenInfo.new(dur, style, dir), { Width0 = peak * factor, Width1 = peak * factor * topRatio })
					end
				end)
			end

			beamTo(at("Pillar"), 0.5, 0.45 * scale, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			beamTo(at("Pillar", 0.5), 1, 0.55 * scale, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
			beamTo(at("Expansion", WAVE_OFFSETS[2]), 0.88, 0.35 * scale, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
			beamTo(at("Expansion", WAVE_OFFSETS[3]), 1, 0.35 * scale, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
			beamTo(at("Fragmentation"), 1.3, surgeIn, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			beamTo(at("Fragmentation") + surgeIn, 0.6, 0.3 * scale, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			beamTo(at("Dissipation"), 0, dissipationLength * 0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			add(at("End"), function()
				if beam.Parent then
					beam.Width0 = 0
					beam.Width1 = 0
				end
			end)
		end
	end

	-- Sonidos existentes (sin SoundIds nuevos ni cambios a los sonidos)
	for _, sound in ipairs(sounds) do
		if isFinalPoint then
			sound.Volume = math.min(sound.Volume * 1.15, 10)
		end
		local phase = SOUND_PHASES[sound.Name]
		local playOffset = math.max(num(sound, "PlayDelay", 0), 0)
		local when = (if phase then at(phase) else 0) + playOffset
		add(when, function()
			if sound.Parent then
				sound:Play()
			end
		end)
	end

	-- Fin del ciclo de vida (cleanup) y red de seguridad igual que Basic
	order += 1
	table.insert(events, { time = duration, order = order, run = cleanup })
	Debris:AddItem(model, duration + 1.0)

	local handle: EffectHandle = {
		Stop = function(_self)
			cleanup()
		end,
		Destroy = function(_self)
			cleanup()
		end,
		IsActive = function(_self)
			return isActive
		end,
	}
	activeHandles[model] = handle

	-- Si el modelo se destruye externamente (limpieza de partida/arena) se corta toda tarea pendiente
	destroyingConn = model.Destroying:Connect(function()
		cleanup()
	end)

	table.sort(events, function(a, b)
		if a.time ~= b.time then
			return a.time < b.time
		end
		return a.order < b.order
	end)

	-- Un unico hilo temporizador: no bloquea al llamador; los eventos de t=0 corren de inmediato
	driver = task.spawn(function()
		for _, ev in ipairs(events) do
			if not isActive then
				return
			end
			local remaining = ev.time - (os.clock() - startClock)
			if remaining > 0 then
				task.wait(remaining)
			end
			if not isActive then
				return
			end
			if not model.Parent then
				cleanup()
				return
			end
			local ok, err = pcall(ev.run)
			if not ok then
				warn(string.format("[InfernoController] Error en evento de la cinematica: %s", tostring(err)))
			end
		end
	end)

	return handle
end

PointEffectRegistry.Register("Inferno", InfernoController)

return InfernoController
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="511">
        <Properties>
          <string name="Name">PointEffectRegistry</string>
          <string name="Source"><![CDATA[--!strict
export type EffectHandle = {
	Stop: (self: EffectHandle) -> (),
	Destroy: (self: EffectHandle) -> (),
	IsActive: (self: EffectHandle) -> boolean,
}

export type PlayContext = {
	EffectModel: Model,
	ScoringZone: BasePart,
	ScoringPlayer: Player?,
	MatchId: string,
	PointId: string,
	IsFinalPoint: boolean,
	Score: { Red: number, Blue: number }?,
}

export type EffectController = {
	Play: (context: PlayContext) -> EffectHandle,
}

local PointEffectRegistry = {}

local _controllers: { [string]: EffectController } = {}
local _defaultEffectId = "Basic"

function PointEffectRegistry.Register(effectId: string, controller: EffectController)
	assert(typeof(effectId) == "string" and effectId ~= "", "[PointEffectRegistry] effectId inválido")
	assert(controller and typeof(controller.Play) == "function", "[PointEffectRegistry] controller debe implementar Play(context)")
	_controllers[effectId] = controller
end

-- Controllers exclusivos que se registran explícitamente aquí y se cargan bajo demanda (effectId -> ModuleScript
-- hermano). Los servicios solo precargan BasicController; cada controller exclusivo se auto-registra al cargarse.
-- Si el módulo falla o no existe, se conserva el fallback al controller por defecto.
local _exclusiveControllers: { [string]: string } = {
	Inferno = "InfernoController",
	Thunder = "ThunderController",
}
local _exclusiveAttempted: { [string]: boolean } = {}

local function ensureExclusiveLoaded(effectId: string)
	if _controllers[effectId] then
		return
	end
	local moduleName = _exclusiveControllers[effectId]
	if not moduleName or _exclusiveAttempted[effectId] then
		return
	end
	_exclusiveAttempted[effectId] = true

	local container = script.Parent
	local moduleScript = if container then container:FindFirstChild(moduleName) else nil
	if not moduleScript or not moduleScript:IsA("ModuleScript") then
		warn(string.format("[PointEffectRegistry] Controller exclusivo '%s' no encontrado; se usara el fallback", moduleName))
		return
	end

	local ok, result = pcall(require, moduleScript)
	if not ok then
		warn(string.format("[PointEffectRegistry] Error al cargar '%s': %s; se usara el fallback", moduleName, tostring(result)))
		return
	end

	-- Registro explícito si el módulo no se auto-registró
	if not _controllers[effectId] and typeof(result) == "table" and typeof((result :: any).Play) == "function" then
		PointEffectRegistry.Register(effectId, result :: any)
	end
end

function PointEffectRegistry.GetController(effectId: string?): EffectController?
	if effectId then
		ensureExclusiveLoaded(effectId)
	end
	if effectId and _controllers[effectId] then
		return _controllers[effectId]
	end
	if _controllers[_defaultEffectId] then
		return _controllers[_defaultEffectId]
	end
	return nil
end

function PointEffectRegistry.Has(effectId: string): boolean
	ensureExclusiveLoaded(effectId)
	return _controllers[effectId] ~= nil
end

return PointEffectRegistry
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="512">
        <Properties>
          <string name="Name">ThunderController</string>
          <string name="Source"><![CDATA[--!strict
-- ThunderController
-- Coreografía exclusiva y data-driven del Point Effect "Thunder" para Slap Duels 2.0.
-- Soporta tanto los componentes base por convención de nombres (BURSTS, SUSTAIN, SOUND_PHASES)
-- como nuevos componentes agregados desde Roblox Studio (ParticleEmitter, Part, MeshPart, Attachment, Beam, Explosion)
-- mediante atributos de configuración o fallback inteligente basado en el estado inicial del template.
--
-- Contrato PointEffectRegistry: Play(context: PlayContext) -> EffectHandle { Stop, Destroy, IsActive }
-- Fases (5):
--   1. InitialDischarge (0.0s - 0.3s): Descarga inicial, destello de luz, chispas primarias.
--   2. LightningStrike  (0.3s - 1.0s): Rayo principal, erupción de partículas, columna sostenida.
--   3. Overcharge       (1.0s - 2.2s): Ondas de sobrecarga, pulsos de beam, oleadas secundarias.
--   4. FinalDischarge   (2.2s - 3.2s): Descarga conclusiva de alta energía.
--   5. Dissipation      (3.2s - 4.0s): Disipación gradual, decaimiento de tasas a cero.
--   Fin                 (4.0s):        Apagado de emisores y cierre seguro antes de cleanup.

local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")

local PointEffectRegistry = require(script.Parent.PointEffectRegistry)

type PlayContext = PointEffectRegistry.PlayContext
type EffectHandle = PointEffectRegistry.EffectHandle

type Burst = { phase: string, offset: number?, fraction: number, finalOnly: boolean? }
type Event = { time: number, order: number, run: () -> () }

local ThunderController = {}

-- Configuración de depuración global o por modelo (model:GetAttribute("Debug") == true)
ThunderController.Debug = false
-- Hook opcional para testing automatizado: (nombreDeFase, segundosTranscurridos) -> ()
ThunderController.DebugHook = nil :: ((phase: string, elapsed: number) -> ())?

local DEFAULT_DURATION = 8
local BASE_LENGTH = 4.0 -- Duración de la cinemática a escala 1 (segundos)
local TAIL_MARGIN = 1.6 -- Vida máxima de partículas + margen de seguridad
local MIN_SCALE = 0.25
local MAX_SCALE = 3.0

-- Inicio de cada fase (segundos a escala 1)
local PHASES: { [string]: number } = {
	InitialDischarge = 0.0,
	LightningStrike = 0.3,
	Overcharge = 1.0,
	FinalDischarge = 2.2,
	Dissipation = 3.2,
	End = BASE_LENGTH,
}
local PHASE_ORDER = { "InitialDischarge", "LightningStrike", "Overcharge", "FinalDischarge", "Dissipation" }
local WAVE_OFFSETS = { 0, 0.4, 0.8 }

-- Ráfagas heredadas por nombre (compatibilidad total con template Thunder original)
local BURSTS: { [string]: { Burst } } = {
	Glow = { { phase = "InitialDischarge", fraction = 1 }, { phase = "FinalDischarge", fraction = 1 } },
	Core = { { phase = "InitialDischarge", fraction = 1 } },
	Halo = { { phase = "InitialDischarge", fraction = 1 } },
	Glints = { { phase = "InitialDischarge", fraction = 1 }, { phase = "FinalDischarge", fraction = 0.6 } },
	GlintsLate = { { phase = "LightningStrike", fraction = 1 }, { phase = "FinalDischarge", fraction = 1 } },
	Sparks = {
		{ phase = "InitialDischarge", fraction = 0.3 },
		{ phase = "LightningStrike", fraction = 0.7 },
		{ phase = "FinalDischarge", fraction = 0.8 },
	},
	Embers = { { phase = "LightningStrike", fraction = 1 }, { phase = "FinalDischarge", fraction = 0.6 } },
	Puff = { { phase = "LightningStrike", fraction = 1 }, { phase = "FinalDischarge", fraction = 0.5 } },
	Disc = {
		{ phase = "Overcharge", offset = WAVE_OFFSETS[1], fraction = 1 },
		{ phase = "Overcharge", offset = WAVE_OFFSETS[2], fraction = 1 },
		{ phase = "Overcharge", offset = WAVE_OFFSETS[3], fraction = 1, finalOnly = true },
	},
	DiscGlow = {
		{ phase = "Overcharge", offset = WAVE_OFFSETS[1], fraction = 1 },
		{ phase = "Overcharge", offset = WAVE_OFFSETS[2], fraction = 1 },
		{ phase = "Overcharge", offset = WAVE_OFFSETS[3], fraction = 1, finalOnly = true },
	},
	Streaks = {
		{ phase = "Overcharge", offset = WAVE_OFFSETS[1], fraction = 0.6 },
		{ phase = "Overcharge", offset = WAVE_OFFSETS[2], fraction = 0.8 },
		{ phase = "Overcharge", offset = WAVE_OFFSETS[3], fraction = 0.5, finalOnly = true },
	},
	Dust = {
		{ phase = "Overcharge", offset = WAVE_OFFSETS[1], fraction = 0.6 },
		{ phase = "Overcharge", offset = WAVE_OFFSETS[2], fraction = 0.6 },
	},
}

-- Emisión continua sostenida heredada por nombre (partículas/seg a escala 1)
local SUSTAIN: { [string]: number } = { Embers = 24, Sparks = 10, Puff = 4 }

-- Fases de disparo de sonidos heredados
local SOUND_PHASES: { [string]: string } = {
	Thump = "InitialDischarge",
	Snap = "InitialDischarge",
	Boom = "LightningStrike",
	Crack = "FinalDischarge",
	Ping = "Overcharge",
	Glint = "FinalDischarge",
}

-- Instancias activas por modelo para evitar ejecuciones duplicadas simultáneas
local activeHandles: { [Instance]: EffectHandle } = {}

--------------------------------------------------------------------------------
-- Helpers de lectura defensiva de atributos
--------------------------------------------------------------------------------

local function num(inst: Instance, attr: string, default: number): number
	local v = inst:GetAttribute(attr)
	if typeof(v) == "number" then
		return v
	end
	return default
end

local function str(inst: Instance, attr: string, default: string?): string?
	local v = inst:GetAttribute(attr)
	if typeof(v) == "string" and v ~= "" then
		return v
	end
	return default
end

local function bool(inst: Instance, attr: string, default: boolean): boolean
	local v = inst:GetAttribute(attr)
	if typeof(v) == "boolean" then
		return v
	end
	return default
end

local function vec3(inst: Instance, attr: string, default: Vector3?): Vector3?
	local v = inst:GetAttribute(attr)
	if typeof(v) == "Vector3" then
		return v
	elseif typeof(v) == "string" then
		local parts = string.split(v, ",")
		if #parts == 3 then
			local x = tonumber(string.match(parts[1], "[%d%.%-]+"))
			local y = tonumber(string.match(parts[2], "[%d%.%-]+"))
			local z = tonumber(string.match(parts[3], "[%d%.%-]+"))
			if x and y and z then
				return Vector3.new(x, y, z)
			end
		end
	end
	return default
end

local function getEasingStyle(inst: Instance, attr: string, default: Enum.EasingStyle): Enum.EasingStyle
	local s = inst:GetAttribute(attr)
	if typeof(s) == "string" then
		local ok, val = pcall(function() return (Enum.EasingStyle :: any)[s] end)
		if ok and val then return val end
	end
	return default
end

local function getEasingDirection(inst: Instance, attr: string, default: Enum.EasingDirection): Enum.EasingDirection
	local s = inst:GetAttribute(attr)
	if typeof(s) == "string" then
		local ok, val = pcall(function() return (Enum.EasingDirection :: any)[s] end)
		if ok and val then return val end
	end
	return default
end

--------------------------------------------------------------------------------
-- Diagnóstico estático de componentes de un modelo
--------------------------------------------------------------------------------

export type DiagnosticResult = {
	modelName: string,
	totalCounts: { [string]: number },
	emitters: { { name: string, path: string, role: string, reason: string } },
	parts: { { name: string, path: string, role: string, reason: string, animType: string?, distFromPivot: number?, anchored: boolean?, canCollide: boolean? } },
	attachments: { { name: string, path: string, role: string, animType: string?, distFromPivot: number? } },
	beams: { { name: string, path: string, valid: boolean, att0: string?, att1: string? } },
	sounds: { { name: string, path: string, phase: string } },
	explosions: { { name: string, path: string, safe: boolean, phase: string } },
}

function ThunderController.Diagnose(model: Model): DiagnosticResult
	local emitters = {}
	local parts = {}
	local attachments = {}
	local beams = {}
	local lights = {}
	local sounds = {}
	local explosions = {}
	local pivotPos = model:GetPivot().Position

	for _, desc in ipairs(model:GetDescendants()) do
		local rel = desc:GetFullName()
		if desc:IsA("ParticleEmitter") then
			local customPhase = str(desc, "Phase", nil)
			local customCount = num(desc, "EmitCount", -1)
			local customSustain = num(desc, "SustainRate", -1)
			local hasBurstPlan = BURSTS[desc.Name] ~= nil
			local hasSustainPlan = SUSTAIN[desc.Name] ~= nil

			local role = "Desconocido"
			local reason = "Sin plan BURSTS ni atributos específicos"
			if customPhase or customCount > 0 or customSustain > 0 then
				role = "Atributos personalizados"
				reason = string.format("Phase=%s, EmitCount=%d, SustainRate=%.1f", tostring(customPhase), customCount, customSustain)
			elseif hasBurstPlan or hasSustainPlan then
				role = "Plan base heredado (BURSTS/SUSTAIN)"
				reason = string.format("BURSTS=%s, SUSTAIN=%s", tostring(hasBurstPlan), tostring(hasSustainPlan))
			elseif desc.Rate > 0 or desc.Enabled then
				role = "Sustain automático detectado"
				reason = string.format("Template original tenía Rate=%.1f y Enabled=%s", desc.Rate, tostring(desc.Enabled))
			else
				role = "Emisión puntual simple por defecto"
				reason = "EmitCount=1, EmitDelay=0"
			end

			table.insert(emitters, {
				name = desc.Name,
				path = rel,
				role = role,
				reason = reason,
			})
		elseif desc:IsA("BasePart") then
			local animType = str(desc, "AnimationType", nil)
			local role = if animType then ("Animada: " .. animType) else "Estática / Anclaje"
			local reason = if animType then "Tiene atributo AnimationType" else "Sin AnimationType (preservada estática)"
			local dist = (desc.Position - pivotPos).Magnitude
			table.insert(parts, {
				name = desc.Name,
				path = rel,
				role = role,
				reason = reason,
				animType = animType,
				distFromPivot = dist,
				anchored = desc.Anchored,
				canCollide = desc.CanCollide,
			})
		elseif desc:IsA("Attachment") then
			local animType = str(desc, "AnimationType", nil)
			local role = if animType then ("Animado: " .. animType) else "Estático"
			local dist = (desc.WorldPosition - pivotPos).Magnitude
			table.insert(attachments, {
				name = desc.Name,
				path = rel,
				role = role,
				animType = animType,
				distFromPivot = dist,
			})
		elseif desc:IsA("PointLight") then
			table.insert(lights, desc)
		elseif desc:IsA("Beam") then
			local hasAtt0 = desc.Attachment0 ~= nil and desc.Attachment0:IsDescendantOf(model)
			local hasAtt1 = desc.Attachment1 ~= nil and desc.Attachment1:IsDescendantOf(model)
			table.insert(beams, {
				name = desc.Name,
				path = rel,
				valid = hasAtt0 and hasAtt1,
				att0 = if desc.Attachment0 then desc.Attachment0.Name else nil,
				att1 = if desc.Attachment1 then desc.Attachment1.Name else nil,
			})
		elseif desc:IsA("Sound") then
			table.insert(sounds, {
				name = desc.Name,
				path = rel,
				phase = SOUND_PHASES[desc.Name] or "t=0",
			})
		elseif desc:IsA("Explosion") then
			table.insert(explosions, {
				name = desc.Name,
				path = rel,
				safe = true,
				phase = str(desc, "Phase", "LightningStrike") or "LightningStrike",
			})
		end
	end

	return {
		modelName = model.Name,
		totalCounts = {
			Emitters = #emitters,
			Parts = #parts,
			Attachments = #attachments,
			Beams = #beams,
			Lights = #lights,
			Sounds = #sounds,
			Explosions = #explosions,
		},
		emitters = emitters,
		parts = parts,
		attachments = attachments,
		beams = beams,
		sounds = sounds,
		explosions = explosions,
	}
end

--------------------------------------------------------------------------------
-- Función principal Play(context)
--------------------------------------------------------------------------------

function ThunderController.Play(context: PlayContext): EffectHandle
	local model = context.EffectModel
	local isFinalPoint = context.IsFinalPoint
	local scoringZone = context.ScoringZone

	-- Protección contra ejecuciones duplicadas sobre la misma instancia
	local existing = activeHandles[model]
	if existing and existing:IsActive() then
		return existing
	end

	local isActive = true
	local events: { Event } = {}
	local activeTweens: { Tween } = {}
	local driver: thread? = nil
	local destroyingConn: RBXScriptConnection? = nil
	local order = 0
	local startClock = os.clock()
	local rng = Random.new()

	local isDebug = ThunderController.Debug or bool(model, "Debug", false)

	-- Referencia espacial canónica: ScoringZone o Pivot del modelo clonado
	local originPosition = if scoringZone and scoringZone:IsA("BasePart")
		then scoringZone.Position
		else model:GetPivot().Position
	local originCFrame = if scoringZone and scoringZone:IsA("BasePart")
		then CFrame.new(scoringZone.Position)
		else model:GetPivot()

	local duration = num(model, "Duration", DEFAULT_DURATION)
	if duration <= 0 then
		duration = DEFAULT_DURATION
	end
	local multiplier = if isFinalPoint then num(model, "FinalMultiplier", 1.4) else 1
	local rateMul = math.min(multiplier, 3)

	-- Escala temporal configurable (CinematicDuration / BASE_LENGTH)
	local scale = math.clamp(num(model, "CinematicDuration", BASE_LENGTH) / BASE_LENGTH, MIN_SCALE, MAX_SCALE)
	local maxScale = (duration - TAIL_MARGIN) / BASE_LENGTH
	if scale > maxScale then
		scale = math.max(maxScale, MIN_SCALE)
	end

	local function at(phase: string, offset: number?): number
		return ((PHASES[phase] or 0) + (offset or 0)) * scale
	end

	local function add(time: number, run: () -> ())
		if time >= duration then
			return
		end
		order += 1
		table.insert(events, { time = math.max(time, 0), order = order, run = run })
	end

	local function mark(name: string)
		local hook = ThunderController.DebugHook
		if hook then
			pcall(hook, name, os.clock() - startClock)
		end
	end

	local function tween(inst: Instance, info: TweenInfo, goal: { [string]: any })
		if not isActive then
			return
		end
		local tw = TweenService:Create(inst, info, goal)
		table.insert(activeTweens, tw)
		tw:Play()
	end

	-- Limpieza segura garantizada
	local function cleanup()
		if not isActive then
			return
		end
		isActive = false
		mark("Cleanup")
		activeHandles[model] = nil

		if destroyingConn then
			destroyingConn:Disconnect()
			destroyingConn = nil
		end

		if driver and driver ~= coroutine.running() then
			pcall(task.cancel, driver)
		end
		driver = nil

		for _, tw in ipairs(activeTweens) do
			pcall(function()
				tw:Cancel()
			end)
		end
		table.clear(activeTweens)
		table.clear(events)

		if model.Parent then
			for _, desc in ipairs(model:GetDescendants()) do
				if desc:IsA("Sound") and desc.IsPlaying then
					pcall(function()
						desc:Stop()
					end)
				elseif desc:IsA("ParticleEmitter") then
					desc.Enabled = false
					desc.Rate = 0
				end
			end
			model:Destroy()
		end
	end

	----------------------------------------------------------------------------
	-- Fase 1.5: Normalización espacial defensiva del modelo clonado
	----------------------------------------------------------------------------

	for _, desc in ipairs(model:GetDescendants()) do
		if desc:IsA("BasePart") then
			-- Asegurar invariantes físicas: las partes visuales deben estar ancladas
			-- y sin colisión para evitar desplazamientos por física, gravedad o contacto
			desc.Anchored = true
			desc.CanCollide = false
			desc.Massless = true

			-- Si alguna pieza importada de un pack externo se encontraba a coordenadas
			-- arbitrarias del mundo (> 60 studs del origen), normalizarla al origen del gol
			local dist = (desc.Position - originPosition).Magnitude
			if dist > 60 then
				if isDebug then
					warn(string.format("[ThunderController] Normalización defensiva: Part '%s' a %.1f studs del origen. Reubicada a CFrame del ScoringZone.", desc.Name, dist))
				end
				desc.CFrame = originCFrame
			end
		elseif desc:IsA("Explosion") then
			-- Normalizar posición inicial de Explosion: no heredan PivotTo de modelos
			local parent = desc.Parent
			if parent and parent:IsA("BasePart") then
				desc.Position = parent.Position
			elseif parent and parent:IsA("Attachment") then
				desc.Position = parent.WorldPosition
			else
				desc.Position = originPosition
			end
			desc.BlastPressure = 0
			desc.BlastRadius = 0
			desc.DestroyJointRadiusPercent = 0
		end
	end

	----------------------------------------------------------------------------
	-- Fase 2: Recolección y diagnóstico de componentes
	----------------------------------------------------------------------------

	type EmitterRecord = {
		emitter: ParticleEmitter,
		origRate: number,
		origEnabled: boolean,
		path: string,
	}

	type PartRecord = {
		part: BasePart,
		origSize: Vector3,
		origTransparency: number,
		origCFrame: CFrame,
		path: string,
	}

	type AttachmentRecord = {
		attachment: Attachment,
		origPosition: Vector3,
		path: string,
	}

	local emitterRecords: { EmitterRecord } = {}
	local partRecords: { PartRecord } = {}
	local attachmentRecords: { AttachmentRecord } = {}
	local lights: { PointLight } = {}
	local beams: { Beam } = {}
	local sounds: { Sound } = {}
	local explosions: { Explosion } = {}

	for _, desc in ipairs(model:GetDescendants()) do
		local relPath = desc:GetFullName()
		if desc:IsA("ParticleEmitter") then
			table.insert(emitterRecords, {
				emitter = desc,
				origRate = desc.Rate,
				origEnabled = desc.Enabled,
				path = relPath,
			})
			-- Estado inicial seguro: desactivar hasta su programación
			desc.Enabled = false
			desc.Rate = 0
		elseif desc:IsA("BasePart") then
			table.insert(partRecords, {
				part = desc,
				origSize = desc.Size,
				origTransparency = desc.Transparency,
				origCFrame = desc.CFrame,
				path = relPath,
			})
		elseif desc:IsA("Attachment") then
			table.insert(attachmentRecords, {
				attachment = desc,
				origPosition = desc.Position,
				path = relPath,
			})
		elseif desc:IsA("PointLight") then
			table.insert(lights, desc)
		elseif desc:IsA("Beam") then
			table.insert(beams, desc)
		elseif desc:IsA("Sound") then
			desc.Looped = false
			table.insert(sounds, desc)
		elseif desc:IsA("Explosion") then
			-- Seguridad física absoluta: cero daño, presión ni destrucción
			desc.BlastPressure = 0
			desc.BlastRadius = 0
			desc.DestroyJointRadiusPercent = 0
			table.insert(explosions, desc)
		end
	end

	-- Diagnóstico controlado si Debug está activo
	if isDebug then
		print(string.format("[ThunderController:DEBUG] --- Diagnóstico de '%s' (IsFinalPoint=%s, Scale=%.2f, Origin=%s) ---",
			model.Name, tostring(isFinalPoint), scale, tostring(originPosition)))
		print(string.format("[ThunderController:DEBUG] Total componentes: %d Emisores, %d Parts, %d Attachments, %d Beams, %d Luces, %d Sonidos, %d Explosiones",
			#emitterRecords, #partRecords, #attachmentRecords, #beams, #lights, #sounds, #explosions))

		for _, er in ipairs(emitterRecords) do
			local e = er.emitter
			local customPhase = str(e, "Phase", nil)
			local customCount = num(e, "EmitCount", -1)
			local customSustain = num(e, "SustainRate", -1)
			local hasBurstPlan = BURSTS[e.Name] ~= nil
			local hasSustainPlan = SUSTAIN[e.Name] ~= nil

			local descRole = "Desconocido"
			if customPhase or customCount > 0 or customSustain > 0 then
				descRole = string.format("Atributos personalizados (Phase=%s, EmitCount=%d, SustainRate=%.1f)",
					tostring(customPhase), customCount, customSustain)
			elseif hasBurstPlan or hasSustainPlan then
				descRole = string.format("Plan base heredado (Bursts=%s, Sustain=%s)",
					tostring(hasBurstPlan), tostring(hasSustainPlan))
			elseif er.origRate > 0 or er.origEnabled then
				descRole = string.format("Fallback visual Studio (Sustain detectado: Rate=%.1f)", er.origRate)
			else
				descRole = "Emisión puntual simple por defecto"
			end
			print(string.format("  • [Emitter] %s -> %s", e.Name, descRole))
		end

		for _, pr in ipairs(partRecords) do
			local animType = str(pr.part, "AnimationType", nil)
			local dist = (pr.part.Position - originPosition).Magnitude
			if animType then
				print(string.format("  • [Part/MeshPart] %s -> Animación configurada (%s, Dist=%.1f)", pr.part.Name, animType, dist))
			else
				print(string.format("  • [Part/MeshPart] %s -> Estático/Anclaje (Dist=%.1f)", pr.part.Name, dist))
			end
		end

		for _, b in ipairs(beams) do
			local hasAtt0 = b.Attachment0 ~= nil and b.Attachment0:IsDescendantOf(model)
			local hasAtt1 = b.Attachment1 ~= nil and b.Attachment1:IsDescendantOf(model)
			print(string.format("  • [Beam] %s -> Attachments válidos: %s (Att0=%s, Att1=%s)",
				b.Name, tostring(hasAtt0 and hasAtt1), tostring(b.Attachment0), tostring(b.Attachment1)))
		end

		for _, exp in ipairs(explosions) do
			print(string.format("  • [Explosion] %s -> Cosmética segura en Pos=%s", exp.Name, tostring(exp.Position)))
		end
		print("[ThunderController:DEBUG] ----------------------------------------------------")
	end

	----------------------------------------------------------------------------
	-- Fase 3: Programación de marcadores de fase
	----------------------------------------------------------------------------

	for _, phase in ipairs(PHASE_ORDER) do
		local name = phase
		add(at(name), function()
			mark(name)
		end)
	end

	----------------------------------------------------------------------------
	-- Fase 3: Programación de ParticleEmitters
	----------------------------------------------------------------------------

	local dissipationLength = (PHASES.End - PHASES.Dissipation) * scale

	for _, er in ipairs(emitterRecords) do
		local emitter = er.emitter
		local isFinalOnly = bool(emitter, "FinalOnly", false)
		if isFinalOnly and not isFinalPoint then
			continue
		end

		local attrPhase = str(emitter, "Phase", nil)
		local attrEmitCount = emitter:GetAttribute("EmitCount")
		local attrEmitDelay = num(emitter, "EmitDelay", 0)
		local attrSustainRate = emitter:GetAttribute("SustainRate")
		local burstPlan = BURSTS[emitter.Name]
		local sustainPlan = SUSTAIN[emitter.Name]

		-- 1. Ráfagas programadas por atributos explícitos
		if attrPhase or (typeof(attrEmitCount) == "number" and attrEmitCount > 0 and not burstPlan) then
			local targetPhase = attrPhase or "LightningStrike"
			local baseCount = if typeof(attrEmitCount) == "number" and attrEmitCount > 0 then attrEmitCount else 1
			local count = math.max(1, math.floor(baseCount * multiplier + 0.5))
			local repeatCount = math.max(1, math.floor(num(emitter, "BurstCount", 1)))
			local burstInterval = math.max(num(emitter, "BurstInterval", 0.2), 0.05)

			for i = 1, repeatCount do
				local offset = attrEmitDelay + (i - 1) * burstInterval
				add(at(targetPhase, offset), function()
					if emitter.Parent then
						emitter:Emit(count)
					end
				end)
			end

		-- 2. Ráfagas heredadas por nombre (BURSTS)
		elseif burstPlan then
			local base = num(emitter, "EmitCount", 1)
			local emitOffset = math.max(attrEmitDelay, 0)
			for _, burst in ipairs(burstPlan) do
				if not burst.finalOnly or isFinalPoint then
					local count = math.max(1, math.floor(base * multiplier * burst.fraction + 0.5))
					add(at(burst.phase, burst.offset) + emitOffset, function()
						if emitter.Parent then
							emitter:Emit(count)
						end
					end)
				end
			end

		-- 3. Emisor sin plan pero con Rate > 0 original en Studio: se maneja en la sección de sustain abajo
		-- 4. Emisor totalmente sin configuración: ráfaga genérica segura
		elseif er.origRate <= 0 and not er.origEnabled then
			local base = num(emitter, "EmitCount", 1)
			local count = math.max(1, math.floor(base * multiplier + 0.5))
			add(attrEmitDelay, function()
				if emitter.Parent then
					emitter:Emit(count)
				end
			end)
		end

		-- 5. Emisión continua sostenida (Sustain)
		-- Prioridad: Atributo SustainRate > Plan SUSTAIN heredado > Tasa original de Studio si estaba habilitada
		local sustainTarget: number? = nil
		if typeof(attrSustainRate) == "number" and attrSustainRate > 0 then
			sustainTarget = attrSustainRate * rateMul
		elseif sustainPlan then
			sustainTarget = sustainPlan * rateMul
		elseif er.origRate > 0 or er.origEnabled then
			-- Reconocimiento automático de componentes agregados desde Studio con Rate pre-configurado
			local effectiveRate = if er.origRate > 0 then er.origRate else 20
			sustainTarget = effectiveRate * rateMul
		end

		if sustainTarget and sustainTarget > 0 then
			local targetRate = sustainTarget :: number
			local startPhase = str(emitter, "SustainPhase", "LightningStrike") :: string
			local endPhase = str(emitter, "SustainEndPhase", "Dissipation") :: string

			add(at(startPhase), function()
				if emitter.Parent then
					emitter.Enabled = true
					tween(emitter, TweenInfo.new(0.4 * scale, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Rate = targetRate })
				end
			end)

			add(at(endPhase), function()
				if emitter.Parent then
					tween(emitter, TweenInfo.new(dissipationLength * 0.75, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Rate = 0 })
				end
			end)

			add(at("End"), function()
				if emitter.Parent then
					emitter.Rate = 0
					emitter.Enabled = false
				end
			end)
		end
	end

	----------------------------------------------------------------------------
	-- Fase 3: Animación configurable de Part y MeshPart
	----------------------------------------------------------------------------

	for _, pr in ipairs(partRecords) do
		local part = pr.part
		local animType = str(part, "AnimationType", nil)
		if not animType then
			continue -- Partes de anclaje/colisión no configuradas se preservan estáticas
		end

		local phase = str(part, "Phase", "LightningStrike") :: string
		local delaySec = num(part, "AnimationDelay", 0)
		local durSec = math.max(num(part, "AnimationDuration", 0.5 * scale), 0.05)
		local style = getEasingStyle(part, "EasingStyle", Enum.EasingStyle.Quad)
		local dir = getEasingDirection(part, "EasingDirection", Enum.EasingDirection.Out)
		local scaleWithFinal = bool(part, "ScaleWithFinal", false)
		local partMul = if scaleWithFinal and isFinalPoint then multiplier else 1

		local startSize = vec3(part, "StartSize", nil)
		local endSize = vec3(part, "EndSize", nil)
		local startTrans = part:GetAttribute("StartTransparency")
		local endTrans = part:GetAttribute("EndTransparency")
		local rotateAngles = vec3(part, "RotateAngles", nil)
		local startOffset = vec3(part, "StartOffset", nil) or vec3(part, "StartPosition", nil)
		local endOffset = vec3(part, "EndOffset", nil) or vec3(part, "EndPosition", nil)

		local animTypes = string.split(string.lower(animType), ",")

		-- Configuración del estado inicial de la animación (relativo al clon)
		if table.find(animTypes, "expand") then
			if startSize then
				part.Size = startSize
			end
		end
		if table.find(animTypes, "fade") and typeof(startTrans) == "number" then
			part.Transparency = startTrans
		end
		if startOffset then
			part.CFrame = pr.origCFrame * CFrame.new(startOffset)
		end

		local targetTime = at(phase, delaySec)

		add(targetTime, function()
			if not part.Parent then return end

			local goals: { [string]: any } = {}

			for _, t in ipairs(animTypes) do
				local cleanT = string.gsub(t, "%s+", "")
				if cleanT == "expand" then
					local targetSize = if endSize then (endSize * partMul) else (pr.origSize * partMul)
					goals.Size = targetSize
				elseif cleanT == "fade" then
					local targetTrans = if typeof(endTrans) == "number" then endTrans else 1
					goals.Transparency = targetTrans
				elseif cleanT == "pulse" then
					-- Pulso: crece y retorna
					local pulseSize = (endSize or pr.origSize * 1.3) * partMul
					local halfDur = durSec * 0.5
					tween(part, TweenInfo.new(halfDur, style, Enum.EasingDirection.Out), { Size = pulseSize })
					task.delay(halfDur, function()
						if part.Parent and isActive then
							tween(part, TweenInfo.new(halfDur, style, Enum.EasingDirection.In), { Size = pr.origSize })
						end
					end)
				elseif cleanT == "rotate" and rotateAngles then
					local radAngles = Vector3.new(math.rad(rotateAngles.X), math.rad(rotateAngles.Y), math.rad(rotateAngles.Z))
					local baseCF = if endOffset then (pr.origCFrame * CFrame.new(endOffset * partMul)) else pr.origCFrame
					goals.CFrame = baseCF * CFrame.Angles(radAngles.X * partMul, radAngles.Y * partMul, radAngles.Z * partMul)
				end
			end

			if endOffset and not (table.find(animTypes, "rotate") and rotateAngles) then
				goals.CFrame = pr.origCFrame * CFrame.new(endOffset * partMul)
			end

			if next(goals) ~= nil then
				tween(part, TweenInfo.new(durSec, style, dir), goals)
			end
		end)

		-- Limpieza o desvanecimiento hacia el final si la parte debe desaparecer
		local autoFadeAtEnd = bool(part, "AutoFadeAtEnd", false)
		if autoFadeAtEnd then
			add(at("Dissipation"), function()
				if part.Parent then
					tween(part, TweenInfo.new(dissipationLength * 0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Transparency = 1 })
				end
			end)
		end
	end

	----------------------------------------------------------------------------
	-- Fase 3: Animación opcional de Attachments (sin alterar Beams)
	----------------------------------------------------------------------------

	-- Determinar qué attachments son requeridos por Beams para proteger su geometría
	local protectedAttachments: { [Attachment]: boolean } = {}
	for _, beam in ipairs(beams) do
		if beam.Attachment0 then protectedAttachments[beam.Attachment0] = true end
		if beam.Attachment1 then protectedAttachments[beam.Attachment1] = true end
	end

	for _, ar in ipairs(attachmentRecords) do
		local att = ar.attachment
		local animType = str(att, "AnimationType", nil)
		if not animType then
			continue
		end

		-- Si el attachment forma parte de un Beam y no se declaró explícitamente OverrideBeam
		if protectedAttachments[att] and not bool(att, "OverrideBeam", false) then
			if isDebug then
				warn(string.format("[ThunderController:DEBUG] Attachment '%s' protege geometría de Beam; animación omitida.", att.Name))
			end
			continue
		end

		local phase = str(att, "Phase", "LightningStrike") :: string
		local delaySec = num(att, "AnimationDelay", 0)
		local durSec = math.max(num(att, "AnimationDuration", 0.5 * scale), 0.05)
		local startPos = vec3(att, "StartPosition", nil)
		local endPos = vec3(att, "EndPosition", nil)
		local style = getEasingStyle(att, "EasingStyle", Enum.EasingStyle.Quad)
		local dir = getEasingDirection(att, "EasingDirection", Enum.EasingDirection.Out)

		if startPos then
			att.Position = startPos
		end

		if endPos then
			add(at(phase, delaySec), function()
				if att.Parent then
					tween(att, TweenInfo.new(durSec, style, dir), { Position = endPos })
				end
			end)
		end
	end

	----------------------------------------------------------------------------
	-- Fase 3: Detección y ejecución segura de Explosions (cosméticas)
	----------------------------------------------------------------------------

	for _, exp in ipairs(explosions) do
		local phase = str(exp, "Phase", "LightningStrike") :: string
		local delaySec = num(exp, "Delay", 0)
		local isVisible = bool(exp, "Visible", true)

		add(at(phase, delaySec), function()
			if exp.Parent then
				-- Asegurar invariante: posición en el padre o ScoringZone, cero daño físico
				local parent = exp.Parent
				if parent:IsA("BasePart") then
					exp.Position = parent.Position
				elseif parent:IsA("Attachment") then
					exp.Position = parent.WorldPosition
				else
					exp.Position = originPosition
				end
				exp.BlastPressure = 0
				exp.BlastRadius = 0
				exp.DestroyJointRadiusPercent = 0
				exp.Visible = isVisible
			end
		end)
	end

	----------------------------------------------------------------------------
	-- Iluminación (PointLight)
	----------------------------------------------------------------------------

	for _, light in ipairs(lights) do
		local peak = num(light, "LightPeak", 0) * (if isFinalPoint then 1.2 else 1)
		if peak > 0 then
			local lightIn = math.max(num(light, "LightIn", 0.04), 0.01)
			local lightFade = math.max(num(light, "LightFade", 0.5), 0.1)
			light.Brightness = 0

			local function lightTo(time: number, level: number, dur: number, style: Enum.EasingStyle, dir: Enum.EasingDirection)
				add(time, function()
					if light.Parent then
						tween(light, TweenInfo.new(dur, style, dir), { Brightness = level })
					end
				end)
			end

			lightTo(at("InitialDischarge"), peak, lightIn, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			lightTo(at("InitialDischarge") + lightIn, peak * 0.45, 0.25 * scale, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

			local flickerStep = math.max(0.15 * scale, 0.05)
			local t = at("LightningStrike")
			local flickerEnd = at("FinalDischarge") - flickerStep
			local guard = 0
			while t < flickerEnd and guard < 24 do
				lightTo(t, peak * (0.3 + 0.2 * rng:NextNumber()), flickerStep * 0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
				t += flickerStep
				guard += 1
			end

			lightTo(at("FinalDischarge"), peak * 0.8, 0.05, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			lightTo(at("FinalDischarge") + 0.05, peak * 0.3, lightFade * scale, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			lightTo(at("Dissipation"), 0, dissipationLength * 0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			add(at("End"), function()
				if light.Parent then
					light.Brightness = 0
				end
			end)
		end
	end

	----------------------------------------------------------------------------
	-- Columna eléctrica (Beam)
	----------------------------------------------------------------------------

	for _, beam in ipairs(beams) do
		local peak = num(beam, "PulsePeak", 0) * (if isFinalPoint then 1.25 else 1)
		if peak > 0 then
			local topRatio = num(beam, "PulseTopRatio", 0.35)
			local surgeIn = math.max(num(beam, "PulseIn", 0.07), 0.02)
			beam.Width0 = 0
			beam.Width1 = 0

			local function beamTo(time: number, factor: number, dur: number, style: Enum.EasingStyle, dir: Enum.EasingDirection)
				add(time, function()
					if beam.Parent then
						tween(beam, TweenInfo.new(dur, style, dir), { Width0 = peak * factor, Width1 = peak * factor * topRatio })
					end
				end)
			end

			beamTo(at("LightningStrike"), 0.5, 0.3 * scale, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			beamTo(at("LightningStrike", 0.3), 1, 0.4 * scale, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
			beamTo(at("Overcharge", WAVE_OFFSETS[2]), 0.88, 0.3 * scale, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
			beamTo(at("Overcharge", WAVE_OFFSETS[3]), 1, 0.3 * scale, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
			beamTo(at("FinalDischarge"), 1.3, surgeIn, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			beamTo(at("FinalDischarge") + surgeIn, 0.6, 0.25 * scale, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			beamTo(at("Dissipation"), 0, dissipationLength * 0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			add(at("End"), function()
				if beam.Parent then
					beam.Width0 = 0
					beam.Width1 = 0
				end
			end)
		end
	end

	----------------------------------------------------------------------------
	-- Sonidos existentes
	----------------------------------------------------------------------------

	for _, sound in ipairs(sounds) do
		if isFinalPoint then
			sound.Volume = math.min(sound.Volume * 1.15, 10)
		end
		local phase = SOUND_PHASES[sound.Name]
		local playOffset = math.max(num(sound, "PlayDelay", 0), 0)
		local when = (if phase then at(phase) else 0) + playOffset
		add(when, function()
			if sound.Parent then
				sound:Play()
			end
		end)
	end

	----------------------------------------------------------------------------
	-- Ciclo de vida y orquestador temporal
	----------------------------------------------------------------------------

	order += 1
	table.insert(events, { time = duration, order = order, run = cleanup })
	Debris:AddItem(model, duration + 1.0)

	local handle: EffectHandle = {
		Stop = function(_self)
			cleanup()
		end,
		Destroy = function(_self)
			cleanup()
		end,
		IsActive = function(_self)
			return isActive
		end,
	}
	activeHandles[model] = handle

	destroyingConn = model.Destroying:Connect(function()
		cleanup()
	end)

	table.sort(events, function(a, b)
		if a.time ~= b.time then
			return a.time < b.time
		end
		return a.order < b.order
	end)

	driver = task.spawn(function()
		for _, ev in ipairs(events) do
			if not isActive then
				return
			end
			local remaining = ev.time - (os.clock() - startClock)
			if remaining > 0 then
				task.wait(remaining)
			end
			if not isActive then
				return
			end
			if not model.Parent then
				cleanup()
				return
			end
			local ok, err = pcall(ev.run)
			if not ok then
				warn(string.format("[ThunderController] Error en evento de la cinemática: %s", tostring(err)))
			end
		end
	end)

	return handle
end

PointEffectRegistry.Register("Thunder", ThunderController)

return ThunderController
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Script" referent="513">
      <Properties>
        <string name="Name">RagdollHandler</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[local Players = game:GetService('Players')
local ServerStorage = game:GetService('ServerStorage')
local ragdollModule = nil -- call ragdoll module here

local function main(v: Humanoid?)
	if not v:IsA('Humanoid') or not v.Parent then return end
	local character = v.Parent
	local player = Players:GetPlayerFromCharacter(character)
	if not script:GetAttribute('NPCs') and not player then return end
	character:SetAttribute('Ragdoll', false)
	local function onGetAttributeChangedSignal()
		if character:GetAttribute('Ragdoll') then
			if ragdollModule then ragdollModule.ragdoll(character) end
		else
			if ragdollModule then ragdollModule.unRagdoll(character) end
		end
	end
	character:GetAttributeChangedSignal('Ragdoll'):Connect(onGetAttributeChangedSignal)
	v.BreakJointsOnDeath = false
	local function onDied()
		-- ragdoll
	end
	v.Died:Once(onDied)
end

workspace.DescendantAdded:Connect(main)

for _, v in workspace:GetDescendants() do
	main(v)
end
]]></string>
      </Properties>
    </Item>
    <Item class="Folder" referent="514">
      <Properties>
        <string name="Name">Services</string>
      </Properties>
      <Item class="ModuleScript" referent="515">
        <Properties>
          <string name="Name">AbilityRegistry</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Server-only sealed registry. Build is dependency-injected for isolated tests.
-- Nothing is required by discovery; only explicit manifest entries are loaded.
local Registry={}
local singleton
local function finite(v) return type(v)=="number" and v==v and math.abs(v)<math.huge end
local function text(v,max) return type(v)=="string" and #v>0 and #v<=max end
local function identifier(v) return text(v,48) and v:match("^[A-Za-z][A-Za-z0-9_]*$")~=nil end
local function copy(value)
 if type(value)~="table" then return value end
 local result={} for key,v in pairs(value) do result[key]=copy(v) end return result
end
local function freeze(value)
 if type(value)=="table" and not table.isfrozen(value) then
  for _,v in pairs(value) do freeze(v) end;table.freeze(value)
 end
 return value
end
local function validate(module,options)
 if type(module)~="table" or module.IsTemplate then return nil,"InvalidAbilityOrTemplate" end
 local d=module.Descriptor
 if type(d)~="table" or not identifier(d.Id) then return nil,"InvalidDescriptorId" end
 if not text(d.DisplayName,80) or not text(d.Description,400) or not text(d.Type,48)
  or not finite(d.Duration) or d.Duration<0 or d.Duration>600
  or not finite(d.Cooldown) or d.Cooldown<=0 or d.Cooldown>3600
  or not finite(d.SortOrder) or d.SortOrder%1~=0
  or type(d.Icon)~="string" or #d.Icon>256 or (d.Icon~="" and not d.Icon:match("^rbxassetid://%d+$")) then return nil,"InvalidDescriptor" end
 if type(module.Enabled)~="boolean" then return nil,"InvalidAvailability" end
 if type(module.Start)~="function" or type(module.Cancel)~="function" then return nil,"MissingStartOrCancel" end
 for _,name in {"Step","ValidateActivation","OnAction"} do
  if module[name]~=nil and type(module[name])~="function" then return nil,"InvalidCallback:"..name end
 end
 local config,schema=module.Config,module.ConfigSchema
 if type(config)~="table" or type(schema)~="table" then return nil,"InvalidConfigSchema" end
 for key,value in pairs(config) do
  local rule=schema[key]
  if not identifier(key) or type(rule)~="table" then return nil,"UndeclaredConfig:"..tostring(key) end
  if rule.Type=="number" then
   if not finite(value) or not finite(rule.Min) or not finite(rule.Max) or rule.Min>rule.Max
    or value<rule.Min or value>rule.Max or (rule.Integer and value%1~=0) then return nil,"InvalidConfig:"..key end
  elseif rule.Type=="boolean" then
   if type(value)~="boolean" then return nil,"InvalidConfig:"..key end
  elseif rule.Type=="string" then
   if not text(value,128) then return nil,"InvalidConfig:"..key end
  else return nil,"UnsupportedConfigType:"..key end
 end
 for key in pairs(schema) do if config[key]==nil then return nil,"MissingConfig:"..tostring(key) end end
 if module.Dependencies~=nil and type(module.Dependencies)~="table" then return nil,"InvalidDependencies" end
 for _,dependency in ipairs(module.Dependencies or {}) do
  if not identifier(dependency) or not options.HasDependency(dependency) then return nil,"MissingDependency:"..tostring(dependency) end
 end
 local input=module.Input or {Primary="None"}
 if type(input)~="table" or (input.Primary~="None" and input.Primary~="Direction") then return nil,"InvalidInputProfile" end
 local actions=module.Actions or {}
 if type(actions)~="table" then return nil,"InvalidActions" end
 local checkedActions={}
 for name,action in pairs(actions) do
  if not identifier(name) or name=="Activate" or name=="Sync" or name=="Select" or type(action)~="table"
   or (action.Input~="None" and action.Input~="Direction") or type(module.OnAction)~="function" then return nil,"InvalidAction" end
  checkedActions[name]={Input=action.Input}
 end
 for _,field in {"ActivePrimaryAction","JumpAction"} do
  if input[field]~=nil and not actions[input[field]] then return nil,"UnknownInputAction:"..field end
 end
 local assets=module.Assets
 if type(assets)~="table" or (assets.Profile~="None" and assets.Profile~="AttachmentEffect" and assets.Profile~="InvisibleAvatar")
  or (assets.Profile~="None" and not identifier(assets.Key))
  or (assets.Key~=nil and not identifier(assets.Key)) then return nil,"InvalidAssets" end
 local cues={}
 for name,cue in pairs(assets.Cues or {}) do
  if not identifier(name) or type(cue)~="table" or cue.Profile~="VerticalLaunch" or not identifier(cue.Resource)
   or not finite(cue.Lift) or cue.Lift<0 or cue.Lift>100 or not finite(cue.Duration) or cue.Duration<=0 or cue.Duration>5 then return nil,"InvalidCue" end
  cues[name]={Profile=cue.Profile,Resource=cue.Resource,Lift=cue.Lift,Duration=cue.Duration}
 end
 if assets.Profile=="None" and next(cues)~=nil then return nil,"CueWithoutVisualProfile" end
 local checkedAssets={Key=assets.Key,Profile=assets.Profile,Cues=cues}
 local assetOk,assetReason=options.CheckAssets(checkedAssets)
 if not assetOk then return nil,assetReason or "InvalidPhysicalResources" end
 local hooks=module.Hooks
 if hooks~=nil then
  if type(hooks)~="table" or hooks.Profile~="ImmediateElimination" or type(hooks.BeforeHit)~="function" or type(hooks.Consume)~="function"
   or (hooks.Reason~="StrongSlap" and hooks.Reason~="AbilityImpact") or not cues[hooks.Cue] then return nil,"InvalidImpactHook" end
  hooks={Profile=hooks.Profile,BeforeHit=hooks.BeforeHit,Consume=hooks.Consume,Reason=hooks.Reason,Cue=hooks.Cue}
 end
 local shop=module.Shop
 if type(shop)~="table" or type(shop.PurchaseEnabled)~="boolean" or type(shop.PriceApproved)~="boolean"
  or not finite(shop.Price) or shop.Price<0 or shop.Price%1~=0 then return nil,"InvalidShopMetadata" end
 if shop.PurchaseEnabled and (not shop.PriceApproved or shop.Price<=0) then return nil,"UnapprovedPurchase" end
 local activeLabel=d.ActiveLabel or "ACTIVA"
 if not text(activeLabel,40) or (d.DurationKind~=nil and d.DurationKind~="Instant") then return nil,"InvalidDisplayMetadata" end
 -- Explicit public projection: never replicate Config, schema, functions, Instance
 -- references, dependencies, service references or arbitrary extra descriptor keys.
 local public={Id=d.Id,DisplayName=d.DisplayName,Description=d.Description,Type=d.Type,Duration=d.Duration,Cooldown=d.Cooldown,
  Icon=d.Icon,SortOrder=d.SortOrder,Enabled=module.Enabled,ActiveLabel=activeLabel,DurationKind=d.DurationKind,
  Input={Primary=input.Primary,ActivePrimaryAction=input.ActivePrimaryAction,JumpAction=input.JumpAction},Assets=checkedAssets}
 local definition=copy(config)
 for key,value in pairs(public) do definition[key]=copy(value) end
 return {Id=d.Id,Enabled=module.Enabled,Public=public,Definition=definition,Config=copy(config),
  Shop={Price=shop.Price,PriceApproved=shop.PriceApproved,PurchaseEnabled=shop.PurchaseEnabled},
  Input=copy(public.Input),Actions=checkedActions,Assets=checkedAssets,Hooks=hooks,
  Module={Start=module.Start,Step=module.Step,Cancel=module.Cancel,ValidateActivation=module.ValidateActivation,OnAction=module.OnAction}}
end
function Registry.Build(options)
 local errors,entries,order,candidates,counts={},{},{},{},{}
 local function diagnostic(name,reason)
  local row={Module=tostring(name),Reason=tostring(reason):sub(1,500)};table.insert(errors,row)
  if options.Warn then options.Warn("[AbilityRegistry] "..row.Module..": "..row.Reason) end
 end
 local names={}
 if type(options.Manifest)~="table" then diagnostic("Manifest","InvalidManifest") else
  for _,name in ipairs(options.Manifest) do
   if not identifier(name) then diagnostic(name,"InvalidModuleName")
   elseif names[name] then diagnostic(name,"RepeatedManifestEntry")
   else
    names[name]=true
    local ok,module=pcall(function()
     local instance=options.Resolve(name)
     if not instance or not options.IsModule(instance) then error("MissingOrUnauthorizedModule") end
     -- Authorization occurs BEFORE require; returned-table validation is not a sandbox.
     return options.Load(instance)
    end)
    if not ok then diagnostic(name,"RequireFailed:"..tostring(module)) else
     local valid,entry,reason=pcall(validate,module,options)
     if not valid then diagnostic(name,"ContractError:"..tostring(entry))
     elseif not entry then diagnostic(name,reason) else
      counts[entry.Id]=(counts[entry.Id] or 0)+1;table.insert(candidates,{Name=name,Entry=entry})
     end
    end
   end
  end
 end
 for _,candidate in ipairs(candidates) do
  local entry=candidate.Entry
  if counts[entry.Id]>1 then diagnostic(candidate.Name,"DuplicateId:"..entry.Id)
  else entries[entry.Id]=freeze(entry);if entry.Enabled then table.insert(order,entry.Id) end end
 end
 table.sort(order,function(a,b)
  local x,y=entries[a].Public.SortOrder,entries[b].Public.SortOrder
  return if x==y then a<b else x<y
 end)
 local items={} for _,id in ipairs(order) do items[id]=entries[id].Public end
 if not items[options.DefaultId] then diagnostic("Default","DefaultAbilityUnavailable") end
 local catalog=freeze({Version=1,DefaultId=options.DefaultId,Order=order,Items=items})
 freeze(errors)
 return table.freeze({
  Get=function(_,id)return entries[id]end,
  GetPublicCatalog=function()return catalog end,
  GetDiagnostics=function()return errors end,
  IsSealed=function()return true end,
 })
end
function Registry.Initialize(options)
 if singleton then return false,"RegistryAlreadySealed" end
 singleton=Registry.Build(options);return true
end
function Registry.Get(_self,id) return singleton and singleton:Get(id) end
function Registry.GetPublicCatalog() return singleton and singleton:GetPublicCatalog() end
function Registry.GetDiagnostics() return singleton and singleton:GetDiagnostics() or {} end
return table.freeze(Registry)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="516">
        <Properties>
          <string name="Name">AbilityService</string>
          <string name="Source"><![CDATA[--!nonstrict
-- One authority for selection, ownership, activation, life identity and timers.
local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local HttpService=game:GetService("HttpService")
local RS=game:GetService("ReplicatedStorage")
local Definitions=require(RS.Shared.AbilityDefinitions)
local Registry=require(script.Parent.AbilityRegistry)
local Diagnostics=require(RS.Shared.AbilityDiagnostics)
local Callbacks=require(script.Parent.Parent.Abilities.AbilityCallbacks)
local Input=require(script.Parent.Parent.Abilities.AbilityInputAdapter)
local Service={Name="AbilityService"}
local function generation(character) return character:GetAttribute("ArenaPhysicsGeneration") or 0 end
local function now() return workspace:GetServerTimeNow() end
local function invoke(entry,label,callback,...)
 local result=table.pack(Callbacks.Call(callback,...))
 if not result[1] then
  warn(string.format("[AbilityService] %s.%s: %s",entry.Id,label,tostring(result[2]):sub(1,500)))
 end
 return table.unpack(result,1,result.n)
end
function Service:_trace(player,payload,phase,reason,session,record,state,extra)
 if not Diagnostics.Enabled() then return end
 local values={UserId=player.UserId,TraceId=payload and Diagnostics.TraceId(payload.TraceId),
  SessionId=session and session.Id,RoundId=record and record.RoundId,RoundState=session and session.State,
  AbilityId=payload and payload.AbilityId,SelectedAbilityId=state and state.AbilityId,Action=payload and payload.Action,
  Result=phase,Reason=reason,ExpectedGeneration=state and state.Generation,ExpectedLifeId=state and state.LifeId,
  Generation=payload and payload.CharacterGeneration,LifeId=payload and payload.LifeId,
  CooldownRemaining=state and math.max(0,state.CooldownUntil-os.clock()),Playing=record and record.Playing==true}
 for key,value in pairs(extra or {})do values[key]=value end
 Diagnostics.Emit("Server",phase,values)
end
function Service:_reject(player,payload,reason,session,record,state)
 if not Diagnostics.Enabled() then return end
 -- A held/spammed input must not produce an Output line or reply per packet.
 local t=os.clock()
 if t<(self._traceNext[player] or 0) then return end
 self._traceNext[player]=t+0.5
 self:_trace(player,payload,"Rejected",reason,session,record,state)
 self._state:FireClient(player,{Kind="AbilityDiagnostic",Build=Diagnostics.Build,TraceId=Diagnostics.TraceId(payload and payload.TraceId),
  Result="Rejected",Reason=reason,AbilityId=state and state.AbilityId,SessionId=session and session.Id,
  RoundId=record and record.RoundId})
end
function Service:Init(context)
 self._context=context;self._sessions={};self._rate={};self._revisions={};self._connections={};self._elapsed=0;self._catalogSent={}
 self._traceNext={}
 local combat=RS.Remotes.Combat
 local function remote(name)
  local v=combat:FindFirstChild(name)
  local count=0 for _,child in ipairs(combat:GetChildren()) do if child.Name==name then count+=1 end end
  assert(count<=1,"Duplicate ability remote: "..name)
  if not v then v=Instance.new("RemoteEvent");v.Name=name;v.Parent=combat end
  assert(v:IsA("RemoteEvent"),"Invalid ability remote: "..name);return v
 end
 self._request=remote("AbilityRequest");self._state=remote("AbilityState")
 local persistence=context.PersistenceInfo or {}
 Diagnostics.Emit("Server","Ready",{RegistryCount=#Registry.GetPublicCatalog().Order,RemotesReady=true,
  Environment=persistence.Environment,Provider=persistence.ProviderName,WritesToCloud=persistence.WritesToCloud})
 table.insert(self._connections,self._request.OnServerEvent:Connect(function(player,payload) self:HandleRequest(player,payload) end))
end
function Service:Start(_context)
 table.insert(self._connections,RunService.Heartbeat:Connect(function(dt) self:Step(dt) end))
 table.insert(self._connections,Players.PlayerRemoving:Connect(function(player)
  for _,session in pairs(self._sessions) do
   local state=session.Players[player]
   if state then self:CancelPlayer(player,"Disconnect");session.Players[player]=nil end
  end
  self._rate[player]=nil;self._revisions[player]=nil;self._catalogSent[player]=nil
  self._traceNext[player]=nil;Diagnostics.Forget("Server",player.UserId)
 end))
end
function Service:_round() return self._context:GetService("RoundService") end
function Service:_players() return self._context:GetService("PlayerService") end
function Service:Owns(player,id)
 local d=Registry:Get(id)
 local ps=self:_players()
 return d~=nil and d.Enabled==true and ps~=nil and ps:IsShopDataReady(player)
  and ps:HasItem(player,Definitions.Category,id)
end
function Service:SyncLife(player,state)
 local char=player.Character
 local gen=char and generation(char)
 if state.Character~=char or state.Generation~=gen then
  self:CancelPlayer(player,"LifeChanged")
  state.Character=char;state.Generation=gen;state.LifeId=HttpService:GenerateGUID(false)
 end
end
function Service:_get(player)
 local session=self:_round():GetSessionForPlayer(player)
 local record=session and self._sessions[session.Id]
 return session,record,record and record.Players[player]
end
function Service:_live(player,session)
 if typeof(player)~="Instance" or not player:IsA("Player") or player.Parent~=Players then return nil,nil,nil,"InvalidPlayer" end
 local round=self:_round()
 if not session or round:GetSessionById(session.Id)~=session or not round:IsSessionActive(session.Id) then return nil,nil,nil,"SessionInactive" end
 if not round:GetSessionParticipant(session.Id,player) then return nil,nil,nil,"NotParticipant" end
 if session.Closing or session.Closed or session.Cancelled or session.Result then return nil,nil,nil,"SessionTerminal" end
 local char=player.Character
 local hum=char and char:FindFirstChildOfClass("Humanoid")
 local root=char and char:FindFirstChild("HumanoidRootPart")
 if not char then return nil,nil,nil,"CharacterMissing" end
 if not char:IsDescendantOf(workspace) then return nil,nil,nil,"CharacterOutsideWorkspace" end
 if char:GetAttribute("ArenaRespawnPending") then return nil,nil,nil,"RespawnPending" end
 if not hum then return nil,nil,nil,"HumanoidMissing" end
 if hum.Health<=0 then return nil,nil,nil,"HumanoidDead" end
 if hum.WalkSpeed<=0 then return nil,nil,nil,"MovementLocked" end
 if hum.PlatformStand then return nil,nil,nil,"PlatformStand" end
 if char:GetAttribute("Ragdolled")==true then return nil,nil,nil,"RagdolledAttribute" end
 if not root then return nil,nil,nil,"RootMissing" end
 if root.Anchored then return nil,nil,nil,"RootAnchored" end
 local spawn=self._context:GetService("SpawnService")
 local ragdoll=self._context:GetService("RagdollService")
 if ragdoll and ragdoll:IsRagdolled(char) then return nil,nil,nil,"RagdolledService" end
 if spawn and spawn.IsKillPartRespawnPending and spawn:IsKillPartRespawnPending(player) then return nil,nil,nil,"KillPartRespawnPending" end
 return char,hum,root
end
function Service:PrepareSelection(session,duration)
 local preparationState=session.State
 if (preparationState~="StartCountdown" and preparationState~="PointRestartCountdown")
  or type(duration)~="number" or duration~=duration or duration<=0 or duration==math.huge
  or self:_round():GetSessionById(session.Id)~=session or session.Closing or session.Closed or session.Cancelled or session.Result then return false end
 local index=if session.GameplayRound then session.GameplayRound.Index+1 else 1
 local preparationId=session.Id..":Preparation:"..tostring(index)..":"..tostring(session.StateVersion)
 local previous=self._sessions[session.Id]
 -- A repeated opener in the same preparation must never extend its deadline.
 if previous and previous.PreparationId==preparationId then return previous.WindowId end
 local choices={}
 if previous then for player,state in pairs(previous.Players) do choices[player]=state.AbilityId end end
 self:CleanupSession(session.Id,"NewSelection")
 local record={Session=session,Players={},WindowId=HttpService:GenerateGUID(false),
  PreparationId=preparationId,PreparationIndex=index,PreparationState=preparationState,PreparationVersion=session.StateVersion,
  SelectionUntil=os.clock()+duration,SelectionNetworkUntil=now()+duration,Selecting=true}
 self._sessions[session.Id]=record
 for _,member in ipairs(session.Participants) do
  local player=member.Player
  if self:_round():GetSessionParticipant(session.Id,player) then
   local preferred=self:_players():GetEquippedItem(player,Definitions.Category)
   local selected=if self:Owns(player,choices[player]) then choices[player] elseif self:Owns(player,preferred) then preferred else Definitions.DefaultId
   record.Players[player]={AbilityId=selected,
    CooldownUntil=0,State="Selecting"}
  end
 end
 self:PublishSession(record)
 return record.WindowId
end
function Service:FinishSelection(session,windowId)
 local record=self._sessions[session.Id]
 if not record or record.WindowId~=windowId or not record.Selecting then return end
 record.Selecting=false
 for _,state in pairs(record.Players) do state.State="Prepared" end
 self:PublishSession(record)
end
function Service:IsSelectionOpen(record,player)
 local session=record.Session
 return self._sessions[session.Id]==record and record.Selecting and os.clock()<record.SelectionUntil
  and session.State==record.PreparationState and session.StateVersion==record.PreparationVersion
  and (session.State=="StartCountdown" or session.State=="PointRestartCountdown")
  and not session.Closing and not session.Closed and not session.Cancelled and session.Result==nil
  and self:_round():GetSessionById(session.Id)==session and self:_round():IsSessionActive(session.Id)
  and self:_round():GetSessionParticipant(session.Id,player)~=nil
end
function Service:BeginRound(session)
 local record=self._sessions[session.Id]
 assert(record and not record.Selecting,"AbilitySelectionRequired")
 record.RoundId=session.GameplayRound.Id;record.Playing=true
 for player,state in pairs(record.Players) do
  if not self:Owns(player,state.AbilityId) then state.AbilityId=Definitions.DefaultId end
  state.CooldownUntil=0;state.State="Ready"
 end
 self:PublishSession(record)
end
function Service:CancelPlayer(player,reason)
 local _,record,state=self:_get(player)
 -- RoundService may unregister a disconnect before this service's callback.
 if not state then
  for _,candidate in pairs(self._sessions) do
   if candidate.Players[player] then record=candidate;state=candidate.Players[player];break end
  end
 end
 if not state then return end
 local active=state.Active
 state.Active=nil
 if active then
  self:_trace(player,{TraceId=active.TraceId,AbilityId=active.AbilityId},"Cancelled",reason,record.Session,record,state,
   {ActivationId=active.ActivationId,Reason=active.Runtime.StopReason or reason,
    MovementApplied=active.Runtime.MovementApplied==true,StepDt=active.Runtime.LastStepDt,
    Elapsed=os.clock()-active.Runtime.ActivatedAt,RemainingDuration=active.ActiveUntil-os.clock(),
    MoveDistance=(active.Runtime.Root.Position-(active.Runtime.DashOrigin or active.Runtime.Root.Position)).Magnitude,
    SpeedBefore=active.Runtime.Root.AssemblyLinearVelocity.Magnitude})
  -- Detach the active record before cleanup, so duplicate callbacks cannot cancel it twice.
  invoke(active.Entry,"Cancel",active.Entry.Module.Cancel,active.Runtime)
 end
 state.State=if record.Playing then "Cooldown" else "Prepared"
 state.Reason=reason
end
function Service:CancelSession(sessionId,reason)
 local record=self._sessions[sessionId]
 if not record then return end
 record.Playing=false;record.Selecting=false
 for player in pairs(record.Players) do self:CancelPlayer(player,reason) end
 self:PublishSession(record)
end
function Service:CleanupSession(sessionId,reason)
 self:CancelSession(sessionId,reason)
 self._sessions[sessionId]=nil
end
-- Generic, single-use contact capability. SlapService captures it after all
-- normal contact checks and consumes it only after CombatService accepts the hit.
function Service:PrepareHit(player,session)
 local actual,record,state=self:_get(player)
 local active=state and state.Active
 local hooks=active and active.Entry.Hooks
 if actual~=session or not record or not record.Playing or not hooks
  or active.ActiveUntil<=os.clock() or player.Character~=active.Character
  or generation(active.Character)~=active.CharacterGeneration or not self:_live(player,session) then return nil end
 local ok,ready=invoke(active.Entry,"BeforeHit",hooks.BeforeHit,active.Runtime)
 if not ok then self:CancelPlayer(player,"HitHookFailed");return nil end
 if ready~=true then return nil end
 local ticket=table.freeze({ActivationId=active.ActivationId,SkipComboCount=true})
 active.HitTicket=ticket
 return ticket
end
function Service:ConsumeHit(player,session,opponent,ticket)
 local actual,record,state=self:_get(player)
 local active=state and state.Active
 if actual~=session or not record or not record.Playing or not active or active.HitTicket~=ticket
  or not ticket or ticket.ActivationId~=active.ActivationId or active.Character~=player.Character
  or generation(active.Character)~=active.CharacterGeneration then return false end
 active.HitTicket=nil
 local hooks=active.Entry.Hooks
 local ok,consumed=invoke(active.Entry,"Consume",hooks.Consume,active.Runtime)
 if not ok or consumed~=true then self:CancelPlayer(player,"HitHookRejected");return false end
 local char=opponent.Character
 local cue=char and {Kind="AbilityCue",AbilityId=active.AbilityId,Cue=hooks.Cue,
  SessionId=session.Id,ActivationId=active.ActivationId,Position=char:GetPivot().Position}
 self:CancelPlayer(player,"Consumed")
 self:PublishSession(record)
 return true,cue,hooks.Reason
end
function Service:PresentCue(session,cue)
 local record=self._sessions[session.Id]
 if not record or not record.Playing or not cue then return end
 for viewer in pairs(record.Players) do
  if viewer.Parent==Players then self._state:FireClient(viewer,cue) end
 end
end
function Service:HandleRequest(player,payload)
 if typeof(player)~="Instance" or not player:IsA("Player") or player.Parent~=Players then return end
 local t=os.clock()
 if t<(self._rate[player] or 0) then
  if type(payload)=="table" then self:_reject(player,payload,"RateLimited") end
  return
 end
 self._rate[player]=t+Definitions.RequestInterval
 if type(payload)~="table" or type(payload.Action)~="string" then return end
 local session,record,state=self:_get(player)
 if payload.Action~="Sync" then self:_trace(player,payload,"Received",nil,session,record,state) end
 if payload.Action=="Sync" then self._catalogSent[player]=nil;self:Publish(player,record);return end
 if not session then return self:_reject(player,payload,"NoSession") end
 if not record or not state then return self:_reject(player,payload,"AbilitySessionNotPrepared",session,record,state) end
 if payload.SessionId~=session.Id then return self:_reject(player,payload,"SessionMismatch",session,record,state) end
 if payload.Action=="Select" then
  if type(payload.RequestId)~="string" or #payload.RequestId==0 or #payload.RequestId>80 then return end
  local allowed=self:IsSelectionOpen(record,player) and payload.WindowId==record.WindowId
   and payload.PreparationId==record.PreparationId and type(payload.AbilityId)=="string" and self:Owns(player,payload.AbilityId)
  if allowed then state.AbilityId=payload.AbilityId end
  state.SelectionReceipt={RequestId=payload.RequestId,WindowId=payload.WindowId,PreparationId=payload.PreparationId,
   AbilityId=state.AbilityId,Accepted=allowed==true,Reason=if allowed then "Confirmed" else "SelectionRejected"}
  self:Publish(player,record)
  self:_trace(player,payload,"SelectionResult",if allowed then "Confirmed" else "SelectionRejected",session,record,state)
  return
 end
 local char,hum,root,liveReason=self:_live(player,session)
 if state.Character~=player.Character or (player.Character and state.Generation~=generation(player.Character)) then
  self:SyncLife(player,state);self:Publish(player,record)
  return self:_reject(player,payload,"LifeChangedResync",session,record,state)
 end
 local function reject(reason)return self:_reject(player,payload,reason,session,record,state)end
 if not char then return reject(liveReason or "CharacterNotLive") end
 if not record.Playing or session.State~="Playing" then return reject("NotPlaying") end
 if session.PointInProgress then return reject("PointInProgress") end
 if payload.LifeId~=state.LifeId then return reject("LifeIdMismatch") end
 if payload.RoundId~=record.RoundId then return reject("RoundMismatch") end
 if payload.CharacterGeneration~=generation(char) then return reject("GenerationMismatch") end
 if payload.AbilityId~=state.AbilityId then return reject("SelectedAbilityMismatch") end
 local entry=Registry:Get(state.AbilityId)
 if not entry or not entry.Enabled then return reject("RegistryEntryUnavailable") end
 if not self:Owns(player,state.AbilityId) then
  local ps=self:_players()
  return reject(if not ps then "PlayerServiceUnavailable" elseif not ps:IsShopDataReady(player) then "ProfileNotReady" else "NotOwned")
 end
 if not self:_round():IsGameplayRoundOpen(session) then return reject("GameplayRoundClosed") end
 if payload.Action~="Activate" then
  local action=entry.Actions[payload.Action]
  local active=state.Active
  if not action or not active or payload.ActivationId~=active.ActivationId
   or active.ActiveUntil<=t or active.Character~=char then return end
  local valid,input=Input.Validate(action.Input,payload)
  if not valid then return end
  local ok=invoke(entry,"OnAction",entry.Module.OnAction,active.Runtime,payload.Action,input,t)
  if not ok then self:CancelPlayer(player,"ActionFailed");self:PublishSession(record) end
  return
 end
 if state.Active then return reject("AlreadyActive") end
 if t<state.CooldownUntil then return reject("Cooldown") end
 local valid,direction=Input.Validate(entry.Input.Primary,payload)
 if not valid then return reject("InvalidActivationInput") end
 local definition=entry.Definition
 local activationId=HttpService:GenerateGUID(false)
 local info=session.InstanceInfo
 local killParts={} for _,part in ipairs(info and info.KillParts or {}) do table.insert(killParts,part) end
 local runtime=Callbacks.Runtime(table.freeze({AbilityId=state.AbilityId,Definition=definition,Config=entry.Config,
  SessionId=session.Id,RoundId=record.RoundId,UserId=player.UserId,
  Character=char,CharacterGeneration=generation(char),Humanoid=hum,Root=root,
  ActivationId=activationId,ActivatedAt=t,ActiveUntil=t+definition.Duration,
  World=table.freeze({VoidBoundaryPart=info and info.VoidBoundaryPart,KillParts=table.freeze(killParts)})}))
 local active={AbilityId=state.AbilityId,Entry=entry,Runtime=runtime,Character=char,
  CharacterGeneration=generation(char),ActivationId=activationId,ActiveUntil=t+definition.Duration,
  CooldownUntil=t+definition.Cooldown,NetworkActiveUntil=now()+definition.Duration}
 active.TraceId=Diagnostics.TraceId(payload.TraceId)
 -- Reserve before callbacks. Modules receive neither the session nor economy/services.
 -- Callbacks cannot yield; cleanup runs once even after partial activation failure.
 state.Active=active
 if entry.Module.ValidateActivation then
  local ok,allowed=invoke(entry,"ValidateActivation",entry.Module.ValidateActivation,runtime,direction)
  if not ok or allowed~=true then self:CancelPlayer(player,"ValidationRejected");self:PublishSession(record);return reject("ValidationRejected") end
 end
 self:_trace(player,payload,"StartBegin",nil,session,record,state,{ActivationId=activationId})
 local ok,started=invoke(entry,"Start",entry.Module.Start,runtime,direction)
 if not ok or started~=true then
  local reason=runtime.StopReason or (if ok then "StartReturnedFalse" else "StartCallbackError")
  self:CancelPlayer(player,"ActivationRejected");self:PublishSession(record);return reject(reason)
 end
 state.CooldownUntil=active.CooldownUntil;state.State=runtime.State
 self:PublishSession(record)
 self:_trace(player,payload,"Accepted","StartSucceeded",session,record,state,{ActivationId=activationId})
 if Diagnostics.Enabled() then self._state:FireClient(player,{Kind="AbilityDiagnostic",Build=Diagnostics.Build,
  TraceId=active.TraceId,ActivationId=activationId,Result="Accepted",Reason="StartSucceeded",AbilityId=state.AbilityId,
  SessionId=session.Id,RoundId=record.RoundId}) end
end
function Service:Publish(player,record)
 if player.Parent~=Players then return end
 local session=record and record.Session
 local state=record and record.Players[player]
 self._revisions[player]=(self._revisions[player] or 0)+1
 local payload={Kind="State",Revision=self._revisions[player],SessionId=session and session.Id,
  RoundId=record and record.RoundId,WindowId=record and record.WindowId,Selecting=record and self:IsSelectionOpen(record,player) or false,
  PreparationId=record and record.PreparationId,PreparationIndex=record and record.PreparationIndex,
  PreparationState=record and record.PreparationState,
  Preparing=record~=nil and session.State==record.PreparationState and session.StateVersion==record.PreparationVersion
   and not session.Closing and not session.Closed and not session.Cancelled and session.Result==nil,
  SelectionUntil=record and record.SelectionNetworkUntil,Playing=record and record.Playing or false,
  AbilityId=state and state.AbilityId or Definitions.DefaultId,Owned={},Presentations={}}
 for _,id in ipairs(Registry.GetPublicCatalog().Order) do payload.Owned[id]=self:Owns(player,id) end
 if state then
  self:SyncLife(player,state)
  local a=state.Active
  payload.State=state.State;payload.CooldownUntil=now()+math.max(0,state.CooldownUntil-os.clock())
  payload.ActivationId=a and a.ActivationId;payload.ActiveUntil=a and a.NetworkActiveUntil
  payload.CharacterGeneration=player.Character and generation(player.Character)
  payload.LifeId=state.LifeId
  payload.SelectionReceipt=state.SelectionReceipt
 end
 if record and record.Playing then
  for subject,s in pairs(record.Players) do
   local a=s.Active
   if a then table.insert(payload.Presentations,{UserId=subject.UserId,AbilityId=a.AbilityId,
    ActivationId=a.ActivationId,CharacterGeneration=a.CharacterGeneration,ActiveUntil=a.NetworkActiveUntil}) end
  end
 end
 if not self._catalogSent[player] then
  payload.Catalog=Registry.GetPublicCatalog();self._catalogSent[player]=true
 end
 self._state:FireClient(player,payload)
end
function Service:PublishSession(record)
 for player in pairs(record.Players) do self:Publish(player,record) end
end
function Service:Step(dt)
 self._elapsed+=dt
 local publish=self._elapsed>=Definitions.SnapshotInterval
 if publish then self._elapsed=0 end
 for _,record in pairs(self._sessions) do
  local session=record.Session
  if record.Selecting and (os.clock()>=record.SelectionUntil or session.State~=record.PreparationState
   or session.StateVersion~=record.PreparationVersion or session.Closing or session.Closed or session.Cancelled or session.Result) then
   self:FinishSelection(session,record.WindowId)
  end
  for player,state in pairs(record.Players) do
   local a=state.Active
   if a then
    local char=self:_live(player,session)
    if not record.Playing or session.State~="Playing" or session.PointInProgress or not session.GameplayRound
     or session.GameplayRound.Resolved or session.GameplayRound.Id~=record.RoundId
     or char~=a.Character or generation(a.Character)~=a.CharacterGeneration or os.clock()>=a.ActiveUntil then
     self:CancelPlayer(player,"ExpiredOrInvalidated")
    else
     local ok,keep=true,true
     if a.Entry.Module.Step then ok,keep=invoke(a.Entry,"Step",a.Entry.Module.Step,a.Runtime,dt) end
     if Diagnostics.Enabled() and not a.TraceStepLogged then
      a.TraceStepLogged=true
      local owner,automatic
      pcall(function()local p=a.Runtime.Root:GetNetworkOwner();owner=if p then p.UserId else 0;automatic=a.Runtime.Root:GetNetworkOwnershipAuto()end)
      local humState
      pcall(function()humState=a.Runtime.Humanoid:GetState().Name end)
      local stepReason=if not ok then "StepCallbackError" elseif not keep then a.Runtime.StopReason or "StepReturnedFalse" else "StepSucceeded"
      self:_trace(player,{TraceId=a.TraceId,AbilityId=a.AbilityId},"FirstStep",stepReason,session,record,state,
       {ActivationId=a.ActivationId,StepDt=dt,MovementApplied=a.Runtime.MovementApplied==true,
        SpeedAfter=a.Runtime.Root.AssemblyLinearVelocity.Magnitude,VelocityY=a.Runtime.Root.AssemblyLinearVelocity.Y,
        MoveDistance=(a.Runtime.Root.Position-(a.Runtime.DashOrigin or a.Runtime.Root.Position)).Magnitude,
        RootAnchored=a.Runtime.Root.Anchored,OwnerUserId=owner,OwnerAutomatic=automatic,HumanoidState=humState})
     end
     if not ok or not keep then self:CancelPlayer(player,"ModuleStopped") end
    end
   end
   if not state.Active and record.Playing then
    state.State=if os.clock()>=state.CooldownUntil then "Ready" else "Cooldown"
   end
  end
  if publish then self:PublishSession(record) end
 end
end
return Service
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="517">
        <Properties>
          <string name="Name">CoinShopAccessService</string>
          <string name="Source"><![CDATA[--!nonstrict
local Players=game:GetService("Players");local RS=game:GetService("ReplicatedStorage")
local Config=require(RS.Shared.PremiumShop.PremiumShopConfig)
local Service={Name="CoinShopAccessService"}
function Service:Init(context)self.Context=context;self.Connections={};self.Rate={}end
function Service:Validate(player,part,prompt)
 local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
 local hum=player.Character and player.Character:FindFirstChildOfClass("Humanoid")
 local rounds=self.Context:GetService("RoundService")
 return player.Parent==Players and part==self.Part and prompt==self.Prompt and part:IsDescendantOf(workspace)
  and prompt.Parent==part and prompt.Enabled and root and hum and hum.Health>0 and (root.Position-part.Position).Magnitude<=math.min(Config.CoinShopDistance,prompt.MaxActivationDistance)
  and not player:GetAttribute("MatchId")and not player:GetAttribute("ResultsSessionId")and rounds and not rounds:GetSessionForPlayer(player)
end
function Service:Start()
 local shops=workspace:FindFirstChild("Shops");local shop=shops and shops:FindFirstChild("CoinShop")
 self.Part=shop and shop:FindFirstChild("InteractionPart");self.Prompt=self.Part and self.Part:FindFirstChildWhichIsA("ProximityPrompt")
 if not self.Prompt then warn("[CoinShop] Missing Edit shop");return end
 local remotes=RS:WaitForChild("Remotes"):WaitForChild("Shop")
 local remote=remotes:FindFirstChild("CoinShopAccess")or Instance.new("RemoteEvent");remote.Name="CoinShopAccess";remote.Parent=remotes
 table.insert(self.Connections,self.Prompt.Triggered:Connect(function(player)
  if os.clock()<(self.Rate[player]or 0)or not self:Validate(player,self.Part,self.Prompt)then return end
  self.Rate[player]=os.clock()+.5;remote:FireClient(player)
 end))
 table.insert(self.Connections,Players.PlayerRemoving:Connect(function(p)self.Rate[p]=nil end))
end
return Service
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="518">
        <Properties>
          <string name="Name">CombatService</string>
          <string name="Source"><![CDATA[--!strict
-- CombatService
-- Registro autoritativo centralizado de combate y CombatTags.
-- Responsabilidad exclusiva:
-- - Registrar impactos válidos (Slaps) entre jugadores en una partida.
-- - Asociar CombatTags al MatchId correspondiente y timestamp del impacto.
-- - Mantener el último atacante válido (LastAttacker) con ventana de expiración (LastHitLifetime).
-- - Validar que atacante y víctima pertenezcan al mismo Match y la partida esté en estado Playing.
-- - Proveer estructura extensible para futuras asistencias y estadísticas de combate.
-- NO administra la eliminación física ni otorga puntos directamente.

local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Config = require(ReplicatedStorage.Shared.Config)
local Constants = require(ReplicatedStorage.Shared.Constants)
local Types = require(ReplicatedStorage.Shared.Types)

type CombatTag = Types.CombatTag
type CombatHitHistoryItem = Types.CombatHitHistoryItem
type MatchSession = Types.MatchSession

local CombatService = {}
CombatService.Name = "CombatService"

CombatService._context = nil :: any
CombatService._tags = {} :: { [Player]: CombatTag }
CombatService._lifeHits = {} :: { [Player]: any }
CombatService._history = {} :: { [Player]: { CombatHitHistoryItem } }
CombatService._roundService = nil :: any

function CombatService:Init(context: any)
	self._context = context
	self._tags = {}
	self._history = {}
	self._lifeHits = {}
end

function CombatService:Start(context: any)
	self._context = context
	Players.PlayerRemoving:Connect(function(player) self:ClearCombatTag(player) end)
	print("[CombatService] Servicio de combate iniciado y listo")
end

function CombatService:_getRoundService(): any
	if self._roundService then
		return self._roundService
	end
	if self._context and type(self._context.GetService) == "function" then
		local s = self._context:GetService("RoundService")
		if s then
			self._roundService = s
			return s
		end
	end
	local servicesFolder = ServerScriptService:FindFirstChild("Services")
	local mod = servicesFolder and servicesFolder:FindFirstChild("RoundService")
	if mod and mod:IsA("ModuleScript") then
		local ok, result = pcall(require, mod)
		if ok and result then
			self._roundService = result
			return result
		end
	end
	return nil
end

function CombatService:_resolveSession(player: Player): MatchSession?
	local roundService = self:_getRoundService()
	if roundService and type(roundService.GetSessionForPlayer) == "function" then
		return roundService:GetSessionForPlayer(player)
	end
	return nil
end

local function isPlayer(p: any): boolean
	if not p then return false end
	if typeof(p) == "Instance" then
		return p:IsA("Player")
	end
	if (typeof(p) == "userdata" or typeof(p) == "table") and type(p.IsA) == "function" then
		return p:IsA("Player")
	end
	return false
end

-- ==================================================
-- REGISTRO DE IMPACTOS Y COMBAT TAGS
-- ==================================================

-- One server clock and one scoped record for selection and final hit admission.
-- Do not use PlatformStand/timer callbacks: scheduler delay must not extend immunity.
function CombatService:IsHitProtected(victim: Player, session: MatchSession): boolean
	local hits = self._lifeHits[victim]
	local character = victim.Character
	return hits ~= nil and character ~= nil and hits.Character == character
		and hits.Session == session and hits.SessionId == session.Id
		and hits.RoundId == (session.GameplayRound and session.GameplayRound.Id)
		and hits.Generation == (character:GetAttribute("ArenaPhysicsGeneration") or 0)
		and os.clock() < (hits.ProtectedUntil or 0)
end

-- Registra un impacto de combate válido entre dos jugadores
function CombatService:RegisterHit(attacker: Player, victim: Player, overrideMatchId: string?, skipComboCount: boolean?): (boolean, string?, number?)
	-- 1. Validar que ambos jugadores existan y sean instancias Player
	if not isPlayer(attacker) then
		return false, "InvalidAttacker"
	end
	if not isPlayer(victim) then
		return false, "InvalidVictim"
	end

	-- 2. Validar que attacker ~= victim (rechazar auto-ataque)
	if attacker == victim then
		return false, "SelfAttack"
	end

	-- 3. Validar que sigan en el DataModel
	if not attacker.Parent or not victim.Parent then
		return false, "PlayerNotDescendant"
	end
	for _, player in ipairs({ attacker, victim }) do
		local character = player.Character
		if typeof(character) == "Instance" and character:GetAttribute("ArenaRespawnPending") then
			return false, "ParticipantRespawning"
		end
	end

	-- 4. Resolver y validar MatchId
	local roundService = self:_getRoundService()
	if not roundService then
		return false, "RoundServiceUnavailable"
	end

	local victimSession = self:_resolveSession(victim)
	local matchId = overrideMatchId or (victimSession and victimSession.Id)
	local session: MatchSession? = if matchId and type(roundService.GetSessionById) == "function"
		then roundService:GetSessionById(matchId)
		else nil

	if not matchId or not session then
		return false, "NotInMatch"
	end
	if session.Closing or session.Cancelled or session.Closed then
		return false, "SessionClosing"
	end

	-- 5. Validar identidad, vigencia y estado de la sesión explícita
	if victimSession ~= session
		or type(roundService.IsSessionActive) ~= "function"
		or not roundService:IsSessionActive(matchId) then
		return false, "DifferentMatch"
	end
	local currentState = if type(roundService.GetSessionState) == "function"
		then roundService:GetSessionState(matchId)
		else nil
	if currentState ~= Constants.RoundState.Playing then
		return false, "MatchNotPlaying"
	end

	if not roundService:IsGameplayRoundOpen(session) then return false,"RoundNotOpen" end

	-- 6. Validar que AMBOS pertenezcan al mismo MatchId
	local attackerSession = self:_resolveSession(attacker)
	if attackerSession ~= session then
		return false, "DifferentMatch"
	end
	if type(roundService.GetSessionParticipant) ~= "function" then
		return false, "ParticipantRegistryUnavailable"
	end
	local attackerParticipant = roundService:GetSessionParticipant(matchId, attacker)
	local victimParticipant = roundService:GetSessionParticipant(matchId, victim)
	if not attackerParticipant or not victimParticipant then
		return false, "NotInMatch"
	end
	if attackerParticipant.State == "Left" or attackerParticipant.State == "Released"
		or victimParticipant.State == "Left" or victimParticipant.State == "Released" then
		return false, "ParticipantInactive"
	end
	if attackerParticipant.Team == victimParticipant.Team then
		return false, "SameTeam"
	end

	local character=victim.Character
 if not character then return false,"VictimNotSpawned" end
 local generation=character:GetAttribute("ArenaPhysicsGeneration") or 0
 local roundId=session.GameplayRound.Id
 if self:IsHitProtected(victim, session) then return false,"VictimHitProtected" end
 local hits=self._lifeHits[victim]
 if not hits or hits.Session~=session or hits.SessionId~=session.Id or hits.RoundId~=roundId or hits.Character~=character or hits.Generation~=generation then
  hits={Session=session,SessionId=session.Id,RoundId=roundId,Character=character,Generation=generation,Count=0}
  self._lifeHits[victim]=hits
 end
 if not skipComboCount then hits.Count+=1 end

	-- 7. Registrar o actualizar CombatTag autoritativo
	local timestamp = os.clock()
	-- Reserve before any physics/ability side effects; rejected contacts never refresh it.
	hits.ProtectedUntil = timestamp + Config.Combat.DefaultSlapKnockdownDuration
	local tag: CombatTag = {
		Victim = victim,
		Attacker = attacker,
		MatchId = matchId,
		Timestamp = timestamp,
		HitId = HttpService:GenerateGUID(false),
	}

	self._tags[victim] = tag

	-- 8. Registrar en historial para futuras asistencias y métricas
	if not self._history[victim] then
		self._history[victim] = {}
	end
	table.insert(self._history[victim], {
		Attacker = attacker,
		Timestamp = timestamp,
		Damage = 0,
	})

	print(string.format("[CombatService] Hit registrado: '%s' golpeó a '%s' en Match '%s'",
		attacker.Name, victim.Name, matchId))

	return true, nil, hits.Count
end

-- Retorna el CombatTag activo de una víctima
function CombatService:GetCombatTag(victim: Player): CombatTag?
	if not victim then return nil end
	return self._tags[victim]
end

-- Resuelve el último atacante válido de una víctima considerando ventana de expiración
function CombatService:GetLastAttacker(victim: Player, maxLifetime: number?): (Player?, string?, number?)
	if not victim then return nil, nil, nil end

	local tag = self._tags[victim]
	if not tag then
		return nil, nil, nil
	end

	-- Validar ventana de expiración (LastHitLifetime)
	local lifetime = maxLifetime or (Config.Combat and Config.Combat.LastHitLifetime) or 10
	local elapsed = os.clock() - tag.Timestamp
	if elapsed > lifetime then
		return nil, nil, nil
	end

	-- Validar que el atacante siga siendo un Player válido en el juego
	local attacker = tag.Attacker
	if not isPlayer(attacker) or not attacker.Parent then
		return nil, nil, nil
	end

	return attacker, tag.MatchId, tag.Timestamp
end

-- Limpia el CombatTag de una víctima tras una eliminación o reset
function CombatService:ClearCombatTag(victim: Player)
	if not victim then return end
	self._tags[victim] = nil
	self._history[victim] = nil
	self._lifeHits[victim] = nil
end

-- Limpia todos los CombatTags e historial de una partida
function CombatService:ClearMatch(matchId: string)
	for player,hits in pairs(self._lifeHits) do if hits.SessionId==matchId then self._lifeHits[player]=nil end end
	if not matchId then return end
	for victim, tag in pairs(self._tags) do
		if tag.MatchId == matchId then
			self._tags[victim] = nil
			self._history[victim] = nil
		end
	end
end

-- Retorna el historial de impactos recibidos por una víctima (para futuras asistencias)
function CombatService:GetHitHistory(victim: Player): { CombatHitHistoryItem }
	if not victim or not self._history[victim] then
		return {}
	end
	return table.clone(self._history[victim])
end

return CombatService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="519">
        <Properties>
          <string name="Name">CrateService</string>
          <string name="Source"><![CDATA[--!nonstrict
local Players=game:GetService("Players")
local RS=game:GetService("ReplicatedStorage")
local SS=game:GetService("ServerStorage")
local RunService=game:GetService("RunService")
local PolicyService=game:GetService("PolicyService")
local Http=game:GetService("HttpService")
local Catalog=require(RS.Shared.SlapCrates.Catalog)
local Appearance=require(RS.Shared.SlapCrates.Appearance)
local Inventory=require(RS.Shared.SlapCrates.Inventory)
local Odds=require(RS.Shared.SlapCrates.Odds)
local Batch=require(RS.Shared.SlapCrates.BatchOpening)
local Engine=require(script.Parent.Crates.CrateEngine)
local Stock=require(script.Parent.Crates.InMemoryStock)
local Announcements=require(script.Parent.Crates.AnnouncementAdapter)
local StandOpening=require(script.Parent.Crates.StandOpeningService)
local Service={Name="CrateService"}
local function ensure(parent,name,class)
 local obj=parent:FindFirstChild(name)
 if obj then assert(obj:IsA(class),"Crate resource class conflict: "..name);return obj end
 obj=Instance.new(class);obj.Name=name;obj.Parent=parent;return obj
end
function Service:Init(context)
 self._context=context;self._quotes={};self._premiumQuotes={};self._rate={};self._cancelRate={};self._connections={}
 self._announcements=Announcements.new(function(packet)self._announce:FireAllClients(packet)end)
 self._stock=if RunService:IsStudio() and context.PersistenceInfo and context.PersistenceInfo.Environment=="Studio" and context.PersistenceInfo.ProviderName=="InMemory"
  and context.PersistenceInfo.WritesToCloud==false then Stock.new() else nil
 self._rng=Random.new()
 self._stands=StandOpening.new(self)
end
function Service:_players()return self._context:GetService("PlayerService")end
function Service:ExtendInventory(inv)return Inventory.Extend(inv)end
function Service:_lobby(player)
 local rounds=self._context:GetService("RoundService")
 return player.Parent==Players and not player:GetAttribute("MatchId") and not player:GetAttribute("ResultsSessionId")
  and rounds~=nil and rounds:GetSessionForPlayer(player)==nil
end
function Service:_resource(reward)
 local slap=Catalog.Slaps.ById[reward.SlapId];local v=Catalog.Variations.ById[reward.VariationId]
 local slaps=SS:FindFirstChild("Slaps");local tool=slaps and slap and slaps:FindFirstChild(slap.Model)
 local profiles=RS:FindFirstChild("SlapVariationEffects")
 if not tool or not tool:IsA("Tool") or not v or not profiles or not profiles:FindFirstChild(v.VisualProfile)then return false end
 local config=tool:FindFirstChild("Configuration");local power=config and config:FindFirstChild("Power");local cooldown=config and config:FindFirstChild("SlapCooldown")
 local previews=RS:FindFirstChild("CrateRewardPreviews")
 return power~=nil and power:IsA("NumberValue") and power.Value>0 and power.Value<math.huge
  and cooldown~=nil and cooldown:IsA("NumberValue") and cooldown.Value>=0 and cooldown.Value<math.huge
  and previews~=nil and previews:FindFirstChild(reward.SlapId)~=nil
end
function Service:_eligible(player,crate,reviewQuote)
 if not self._stock then return false,"ProductionBackendBlocked" end
 if not crate or (crate.StudioOnly and (not RunService:IsStudio() or SS:GetAttribute("CrateStudioTestsEnabled")~=true)) then return false,"CrateUnavailable" end
 if not Engine.Approved(crate)and not(reviewQuote and crate.MatrixVersion=="InitialV13Review")then return false,"CommercialApprovalPending" end
 if not self:_lobby(player) then return false,"LobbyOnly" end
 if not self:_players():IsShopDataReady(player)then return false,"DataNotLoaded" end
 -- Coins may be Robux-funded. No client claims or Studio bypass of this policy.
 local ok,policy=pcall(PolicyService.GetPolicyInfoForPlayerAsync,PolicyService,player)
 if not ok or type(policy)~="table" or policy.ArePaidRandomItemsRestricted~=false then return false,"PaidRandomItemsRestricted" end
 if not self:_lobby(player) or not self:_players():IsShopDataReady(player)then return false,"DataNotLoaded" end
 return true
end
local function signature(rows,crate)
 local parts={crate.CrateId,tostring(crate.PriceCoins),crate.DuplicatePolicy}
 for _,row in ipairs(rows)do table.insert(parts,row.Reward.RewardId.."="..string.format("%.17g",row.Probability)..":"..tostring(row.Stock.RemainingStock))end
 return table.concat(parts,"|")
end
function Service:Quote(player,id)
 local crate=Catalog.Crates.ById[id];local ok,reason=self:_eligible(player,crate,true)
 if not ok then return {Ok=false,Code=reason} end
 local data=self:_players():GetPlayerData(player)
 local inv=Inventory.Extend(data.Inventory);local valid,err=Inventory.Validate(inv)
 if not valid then return {Ok=false,Code=err} end
 local rows,why,excluded=Odds.Resolve(crate,Catalog,inv,self._stock,function(r)return self:_resource(r)end)
 local function describe(reward)
  local variation=Catalog.Variations.ById[reward.VariationId]
  return {RewardId=reward.RewardId,DisplayName=reward.DisplayName,SlapId=reward.SlapId,VariationId=reward.VariationId,
   SlapName=Catalog.Slaps.ById[reward.SlapId].DisplayName,VariationName=variation.DisplayName,Color=variation.Color,SortOrder=variation.SortOrder}
 end
 local excludedPublic={}
 for _,row in ipairs(excluded or {})do local entry=describe(row.Reward);entry.Reason=row.Reason;entry.Stock=row.Stock;table.insert(excludedPublic,entry)end
 if not rows then return {Ok=false,Code=why,ExcludedOutcomes=excludedPublic} end
 local token=Http:GenerateGUID(false)
 self._quotes[player]={Token=token,CrateId=id,Until=os.clock()+30,Signature=signature(rows,crate)}
 local outcomes={}
 for _,row in ipairs(rows)do local entry=describe(row.Reward);entry.Percent=row.Percent;entry.Stock=row.Stock;table.insert(outcomes,entry)end
 return {Ok=true,Token=token,Outcomes=outcomes,Scope=self._stock.Scope,PriceCoins=crate.PriceCoins,
  ReviewOnly=not Engine.Approved(crate),PurchaseAllowed=not crate.PremiumOnly and Engine.Approved(crate),ExcludedOutcomes=excludedPublic,
  BatchOddsNotice="Cada extracción recalcula elegibilidad y stock; los premios previos del lote pueden cambiar las probabilidades siguientes.",
  ExpiresAt=workspace:GetServerTimeNow()+30,Snapshot={Coins=data.Coins,Inventory=Inventory.Copy(data.Inventory)}}
end
function Service:ValidatePremiumAcquisitionQuote(player,id,token)
 local crate=Catalog.Crates.ById[id];local ok,why=self:_eligible(player,crate)
 if not ok then return false,why end
 local q=self._premiumQuotes[player]and self._premiumQuotes[player][id]or self._quotes[player]
 if not q or q.CrateId~=id or q.Token~=token or os.clock()>=q.Until then return false,"ViewOddsFirst"end
 local data=self:_players():GetPlayerData(player)
 local rows,reason=Odds.Resolve(crate,Catalog,Inventory.Extend(data.Inventory),self._stock,function(r)return self:_resource(r)end)
 if not rows then return false,reason end
 if signature(rows,crate)~=q.Signature then return false,"OddsChanged"end
 return true
end
function Service:QuoteForPremium(player,id)
 local result=self:Quote(player,id)
 if result.Ok then self._premiumQuotes[player]=self._premiumQuotes[player]or {};self._premiumQuotes[player][id]=table.clone(self._quotes[player])end
 return result
end
function Service:_transact(player,kind,args)
 local quantity=if kind=="Open"then Batch.Quantity(args.Quantity)else 1
 if not quantity then return {Ok=false,Code="InvalidQuantity"}end
 if quantity>1 and not(self._stands and self._stands:IsStandMode())then return {Ok=false,Code="MultiOpenStandOnly"}end
 local crate=Catalog.Crates.ById[args.CrateId];local ok,why=self:_eligible(player,crate)
 if not ok then return {Ok=false,Code=why} end
 local ps=self:_players();local data=ps:GetPlayerData(player)
 local inv=Inventory.Extend(data.Inventory)
 local existing=inv.CrateOperations[args.OperationId]
 for id,operation in pairs(inv.CrateOperations)do
  if id~=args.OperationId and operation.Kind=="Open"and operation.State=="GrantCommitted"then return {Ok=false,Code="TransactionInProgress"}end
 end
 if not existing then
  local q=self._quotes[player]
  if not q or q.Token~=args.QuoteToken or q.CrateId~=args.CrateId or os.clock()>=q.Until then return {Ok=false,Code="ViewOddsFirst"} end
  local rows,reason=Odds.Resolve(crate,Catalog,inv,self._stock,function(r)return self:_resource(r)end)
  if not rows then return {Ok=false,Code=reason}end
  if q.Signature~=signature(rows,crate)then return {Ok=false,Code="OddsChanged"}end
 end
 if kind=="Open"and not existing and self._stands and self._stands:IsStandMode()then
  local row=self._stands.Ledger and self._stands.Ledger.Players[player.UserId]
  local stand=self._stands:Validate(player,args.StandId)
  if not row or row.Until<=os.clock()or row.OperationId~=args.OperationId or row.Character~=player.Character or not stand then return {Ok=false,Code="StandLeaseExpired"}end
 end
 local nextData,err,op,replayed=Engine.Stage(data,crate,kind,args.OperationId,player.UserId,Catalog,self._stock,function()return self._rng:NextNumber()end,function(r)return self:_resource(r)end,quantity)
 if not nextData then return {Ok=false,Code=err}end
 if not replayed then
  local success,committed,reason=pcall(ps.CommitCrateState,ps,player,data.Inventory,nextData)
  if not success then
   committed=ps:GetPlayerData(player)==nextData;reason="ProfileCommitFailed"
  end
  if not committed then
   Engine.Release(op,self._stock)
   return {Ok=false,Code=reason}
  end
 end
 -- Idempotent recovery after profile commit. A failed stock commit retains the reservation, never rerolls.
 local completed=Engine.Reconcile(nextData,self._stock)
 if kind=="Open"and not completed then return {Ok=false,Code="StockCommitPending",Operation=Inventory.Copy(op),Snapshot={Coins=nextData.Coins,Inventory=Inventory.Copy(nextData.Inventory)}}end
 if kind=="Open" and(not replayed or op.PresentationSent==false)then self:_present(player,crate,op);op.PresentationSent=true end
 return {Ok=true,Operation=Inventory.Copy(op),Replay=replayed,Crates=Inventory.Copy(nextData.Inventory.Crates),
  Snapshot={Coins=nextData.Coins,Inventory=Inventory.Copy(nextData.Inventory)}}
end
function Service:GetCatalog()
 local results={}
 for _,id in ipairs(Catalog.Crates.Order)do
  local c=Catalog.Crates.ById[id]
  if c.StudioOnly and (not RunService:IsStudio() or SS:GetAttribute("CrateStudioTestsEnabled")~=true)then continue end
  table.insert(results,{Id=id,SortOrder=c.SortOrder,Category="Crates",ProductType="Consumable",DisplayName=c.DisplayName,Description=c.Description,
   Price=c.PriceCoins or 0,Currency=if c.PremiumOnly then "Robux"else "Coins",Icon=c.Icon,Rarity=id,IsAvailable=true,
   Metadata={PriceApproved=c.PriceApproved==true,PricePending=not c.PriceApproved,OddsApproved=c.OddsApproved==true,Enabled=c.Enabled==true,
    PurchaseEnabled=not c.PremiumOnly and Engine.Approved(c) and self._stock~=nil,Model=c.Model,PremiumOnly=c.PremiumOnly==true,OpeningEnabled=Engine.Approved(c)and self._stock~=nil,
    ApprovalStatus=c.ApprovalStatus,FavouredVariations=self:_favoured(c),RollDuration=c.RollDuration,StockScope=self._stock and self._stock.Scope or "ProductionBlocked"}})
 end
 table.sort(results,function(a,b)return if a.SortOrder==b.SortOrder then a.Id<b.Id else a.SortOrder<b.SortOrder end)
 return results
end
function Service:_favoured(crate)
 local high=0;local ids={}
 for id,weight in pairs(crate.Weights)do if type(weight)=="number" and weight>high then high=weight;ids={id}elseif weight==high and weight>0 then table.insert(ids,id)end end
 table.sort(ids);return if #ids>0 then table.concat(ids,", ") else "Pendiente"
end
function Service:Request(player,action,args)
 if typeof(player)~="Instance" or not player:IsA("Player") or player.Parent~=Players then return {Ok=false,Code="InvalidPlayer"}end
 if type(action)~="string" or type(args)~="table"then return {Ok=false,Code="InvalidRequest"}end
 if action=="CancelOpening"then
  if type(args.OpeningId)~="string"or #args.OpeningId>128 then return {Ok=false,Code="InvalidOperationId"}end
  local now=os.clock();if now<(self._cancelRate[player]or 0)then return {Ok=false,Code="RateLimited"}end
  self._cancelRate[player]=now+.1
  return self._stands:Cancel(player,args.OpeningId)
 end
 local t=os.clock();if t<(self._rate[player] or 0)then return {Ok=false,Code="RateLimited"}end
 self._rate[player]=t+.25
 if action=="OpeningContext"then return {Ok=true,Presentation=self._stands:Context()}end
 if action=="Inventory" then
  if not self:_players():IsShopDataReady(player)then return {Ok=false,Code="DataNotLoaded"}end
  local data=self:_players():GetPlayerData(player)
  if self._stock then Engine.Reconcile(data,self._stock)end
  return {Ok=true,Inventory=Inventory.Extend(data.Inventory),Snapshot={Coins=data.Coins,Inventory=Inventory.Copy(data.Inventory)}}
 end
 if type(args.CrateId)~="string" or #args.CrateId>64 then return {Ok=false,Code="InvalidCrateId"}end
 if action=="Quote"then return self:Quote(player,args.CrateId)end
 if action~="Purchase" and action~="Open"then return {Ok=false,Code="InvalidAction"}end
 if action=="Open"and not Batch.Quantity(args.Quantity)then return {Ok=false,Code="InvalidQuantity"}end
 if type(args.OperationId)~="string" or #args.OperationId>64 or not args.OperationId:match("^[%w_%-]+$")then return {Ok=false,Code="InvalidOperationId"}end
 local result;local shop=self._context:GetService("ShopService")
 local ok,code=shop:_withShopLock(player,function()
  local function perform()return self:_transact(player,action,args)end
  result=if action=="Open"and self._stands then self._stands:Open(player,args,perform)else perform()
  return result.Ok,result.Code
 end)
 return result or {Ok=ok,Code=code}
end
function Service:_present(player,crate,op)
 if self._stands and self._stands:IsStandMode()then
  self._stands:Present(player,crate,op)
 else
 local packet={OpeningId=op.UnitId,Operation=Inventory.Copy(op),Duration=crate.RollDuration,Model=crate.Model,
  VFX=crate.VFX,SFX=crate.SFX,StartedAt=workspace:GetServerTimeNow()}
 self._reveal:FireClient(player,packet)
 local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
 if root and self:_lobby(player)then
  packet.Position=root.Position+root.CFrame.LookVector*5
  for _,observer in ipairs(Players:GetPlayers())do
   local target=observer.Character and observer.Character:FindFirstChild("HumanoidRootPart")
   if target and self:_lobby(observer) and (target.Position-root.Position).Magnitude<=70 then self._world:FireClient(observer,packet)end
  end
 end
 end
 for _,unit in ipairs(Batch.Rewards(op))do
 local v=Catalog.Variations.ById[unit.VariationId]
 if v.AnnounceInChat then
  -- TextChatService system message uses only server-selected catalogue data and numeric UserId.
  self._announcements:AnnounceOnce(unit.UnitId,{OpeningId=unit.UnitId,UserId=player.UserId,PlayerName=player.Name,RewardId=unit.RewardId,CrateId=crate.CrateId})
 end
 end
end
function Service:ResolveEquipped(player)
 local ps=self:_players();if not ps:IsShopDataReady(player)then return Catalog.Rewards[Catalog.DefaultRewardId]end
 local inv=Inventory.Extend(ps:GetInventory(player));local id=inv.Equipped.Slaps
 return if Catalog.Rewards[id] and inv.Owned.Slaps[id] and self:_resource(Catalog.Rewards[id])then Catalog.Rewards[id] else Catalog.Rewards[Catalog.DefaultRewardId]
end
function Service:GetSlapModel(reward)return Catalog.Slaps.ById[reward.SlapId].Model end
function Service:ApplyVariation(tool,reward)
 local profile=RS:FindFirstChild("SlapVariationEffects")
 local definition=Catalog.Variations.ById[reward.VariationId]
 local template=profile and profile:FindFirstChild(definition.VisualProfile)
 tool:SetAttribute("RewardId",reward.RewardId);tool:SetAttribute("VariationId",reward.VariationId)
 tool:SetAttribute("DisplayName",reward.DisplayName)
 local hand=tool:FindFirstChild("Hand")
 if template and hand and hand:IsA("BasePart")then
  Appearance.Apply(hand,template)
  for _,child in ipairs(template:GetChildren())do
   if child:IsA("Sound") and child.Name=="Hit" and child.SoundId~=""then
    local original=hand:FindFirstChild("Hit")
    if original and original:IsA("Sound")then original.SoundId=child.SoundId;original.Volume=child.Volume;original.PlaybackSpeed=child.PlaybackSpeed end
   end
  end
 end
end
function Service:Start(context)
 self._context=context
 local remotes=ensure(ensure(RS,"Remotes","Folder"),"Crates","Folder")
 self._reveal=ensure(remotes,"Reveal","RemoteEvent");self._world=ensure(remotes,"World","RemoteEvent");self._announce=ensure(remotes,"Announce","RemoteEvent")
 if self._stands then self._stands:Start(ensure(remotes,"StandPresentation","RemoteEvent"))end
 local request=ensure(remotes,"Request","RemoteFunction")
 request.OnServerInvoke=function(p,action,args)
  local ok,result=pcall(self.Request,self,p,action,args)
  if not ok then warn("[Crates] Request failed safely: "..tostring(result));return {Ok=false,Code="InternalError"}end
  return result
 end
 local factory=require(script.Parent.Parent.Shop.Providers.CrateProviders)
 local shop=context:GetService("ShopService")
 for _,provider in ipairs(factory.Create(self))do if not shop:GetProvider(provider:GetCategory())then shop:RegisterProvider(provider)end end
 table.insert(self._connections,Players.PlayerRemoving:Connect(function(p)self._quotes[p]=nil;self._premiumQuotes[p]=nil;self._rate[p]=nil;self._cancelRate[p]=nil end))
 print("[Crates] SalesProduction=BLOCKED Stock="..(self._stock and self._stock.Scope or "Unavailable"))
end
return Service
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="520">
        <Properties>
          <string name="Name">Crates</string>
        </Properties>
        <Item class="ModuleScript" referent="521">
          <Properties>
            <string name="Name">AnnouncementAdapter</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Local TextChat bridge only. Optional global transport contract is inert until a later authorised phase.
local Adapter={};Adapter.__index=Adapter
function Adapter.new(sendLocal,globalProvider)
 return setmetatable({SendLocal=sendLocal,GlobalProvider=globalProvider,GlobalEnabled=false,Seen={}},Adapter)
end
function Adapter:AnnounceOnce(id,packet)
 if self.Seen[id]then return false,"AlreadyAnnounced"end
 self.Seen[id]=true
 local ok=pcall(self.SendLocal,packet)
 return ok,if ok then nil else "DeliveryUnknown"
end
function Adapter:PublishGlobal(_id,_packet)
 -- No MessagingService lookup, no cross-server writes or hidden activation switch in V1.
 return false,"GlobalAnnouncementsRequireAuthorisedBackend"
end
return Adapter
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="522">
          <Properties>
            <string name="Name">CrateBatchEngine</string>
            <string name="Source"><![CDATA[--!nonstrict
-- No-yield staging/reservations in one Studio server. Never a durable cross-server transaction.
local RS=game:GetService("ReplicatedStorage")
local Inventory=require(RS.Shared.SlapCrates.Inventory)
local Odds=require(RS.Shared.SlapCrates.Odds)
local VisualMetadata=require(script.Parent.RewardVisualMetadata)
local Batch={}
function Batch.Stage(data,crate,id,uid,catalog,stock,random,available,quantity)
 local inv=Inventory.Extend(data.Inventory)
 local valid,reason=Inventory.Validate(inv);if not valid then return nil,reason end
 if (inv.Crates[crate.CrateId]or 0)<quantity then return nil,"InsufficientCrates"end
 if type(random)~="function"then return nil,"InvalidRandomSource"end
 local nextData=table.clone(data);nextData.Inventory=inv
 local op={OperationId=id,BatchId=tostring(uid)..":"..id,UnitId=tostring(uid)..":"..id,
  Kind="Open",CrateId=crate.CrateId,Quantity=quantity,OwnerUserId=uid,CreatedAt=os.time(),
  State="GrantCommitted",PresentationSent=false,Rewards={}}
 local reserved={}
 local ok,failure=pcall(function()
  for index=1,quantity do
   -- Newly owned prizes and previous reservations alter eligibility for the next draw.
   local rows,why=Odds.Resolve(crate,catalog,inv,stock,available)
   if not rows then error(why or "NoEligibleResults",0)end
   local reward=Odds.Roll(rows,random());local variation=catalog.Variations.ById[reward.VariationId]
   local percent,eligible=VisualMetadata.Read(rows,reward.RewardId)
   if index==1 then op.PreviewRewardIds=eligible end
   local unitId=op.BatchId..":"..index
   table.insert(reserved,unitId) -- Also release if Reserve throws after allocating.
   local held,code=stock:Reserve(unitId,uid,reward,variation)
   if not held then error(code or "StockUnavailable",0)end
   local unit={UnitId=unitId,RewardId=reward.RewardId,SlapId=reward.SlapId,VariationId=reward.VariationId,
    OperationId=id,OwnerUserId=uid,EditionId=reward.EditionId,VariationEditionId=variation.EditionId,Origin="Crate",EffectivePercent=percent}
   table.insert(op.Rewards,unit);inv.SlapUnits[unitId]=unit;inv.Owned.Slaps[reward.RewardId]=true
  end
 end)
 if not ok then
  for _,unitId in ipairs(reserved)do stock:Release(unitId)end
  return nil,tostring(failure)
 end
 inv.Crates[crate.CrateId]-=quantity
 op.RewardId=op.Rewards[1].RewardId;op.SlapId=op.Rewards[1].SlapId;op.VariationId=op.Rewards[1].VariationId
 op.EffectivePercent=op.Rewards[1].EffectivePercent
 inv.CrateOperations[id]=op
 return nextData,nil,op,false
end
return Batch
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="523">
          <Properties>
            <string name="Name">CrateEngine</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Pure staging on the EXISTING profile, then stock reservation; presentation never grants items.
local RS=game:GetService("ReplicatedStorage")
local Inventory=require(RS.Shared.SlapCrates.Inventory)
local Odds=require(RS.Shared.SlapCrates.Odds)
local BatchRules=require(RS.Shared.SlapCrates.BatchOpening)
local BatchEngine=require(script.Parent.CrateBatchEngine)
local VisualMetadata=require(script.Parent.RewardVisualMetadata)
local Engine={}
function Engine.Approved(crate)
 if crate and crate.PremiumOnly then return crate.Enabled==true and crate.OddsApproved==true and crate.OpeningApproved==true end
 return crate and crate.Enabled==true and crate.PriceApproved==true and crate.OddsApproved==true
  and type(crate.PriceCoins)=="number" and crate.PriceCoins>0 and crate.PriceCoins<math.huge and crate.PriceCoins%1==0
end
function Engine.Stage(data,crate,kind,id,uid,catalog,stock,unit,available,quantity)
 if crate and crate.PremiumOnly and kind=="Purchase"then return nil,"PremiumPurchaseRequired"end
 quantity=BatchRules.Quantity(quantity);if not quantity then return nil,"InvalidQuantity"end
 if not Engine.Approved(crate)then return nil,"CommercialApprovalPending" end
 local inv=Inventory.Extend(data.Inventory);local old=inv.CrateOperations[id]
 if old then
  if old.Kind~=kind or old.CrateId~=crate.CrateId or(kind=="Open"and (old.Quantity or 1)~=quantity)then return nil,"OperationConflict" end
  -- Return the authoritative journal entry, not the deep copy used for staging.
  return data,nil,data.Inventory.CrateOperations[id],true
 end
 if kind=="Open"and quantity>1 then return BatchEngine.Stage(data,crate,id,uid,catalog,stock,unit,available,quantity)end
 local valid,reason=Inventory.Validate(inv);if not valid then return nil,reason end
 local rows,err=Odds.Resolve(crate,catalog,inv,stock,available);if not rows then return nil,err end
 local nextData=table.clone(data);nextData.Inventory=inv
 local op={OperationId=id,Kind=kind,CrateId=crate.CrateId,State="Committed",OwnerUserId=uid,CreatedAt=os.time()}
 if kind=="Purchase" then
  if type(data.Coins)~="number" or data.Coins~=data.Coins or data.Coins==math.huge or data.Coins<crate.PriceCoins then return nil,"InsufficientFunds" end
  nextData.Coins=data.Coins-crate.PriceCoins;inv.Crates[crate.CrateId]=(inv.Crates[crate.CrateId] or 0)+1
 elseif kind=="Open" then
  if (inv.Crates[crate.CrateId] or 0)<1 then return nil,"NoCrate" end
  local reward=Odds.Roll(rows,if type(unit)=="function"then unit()else unit)
  op.EffectivePercent,op.PreviewRewardIds=VisualMetadata.Read(rows,reward.RewardId)
  local v=catalog.Variations.ById[reward.VariationId]
  op.RewardId=reward.RewardId;op.SlapId=reward.SlapId;op.VariationId=reward.VariationId
  op.EditionId=reward.EditionId;op.VariationEditionId=v.EditionId
  -- Unit identity stays original, scoped by owner and unique operation, including negative Studio IDs.
  op.UnitId=tostring(uid)..":"..id;op.State="GrantCommitted"
  inv.Crates[crate.CrateId]-=1;inv.Owned.Slaps[reward.RewardId]=true
  inv.SlapUnits[op.UnitId]={UnitId=op.UnitId,RewardId=reward.RewardId,SlapId=reward.SlapId,VariationId=reward.VariationId,
   OperationId=id,OwnerUserId=uid,EditionId=reward.EditionId,VariationEditionId=v.EditionId,Origin="Crate"}
  -- All allocations staged before the reservation. The caller still owns the only profile commit.
  local ok,why=stock:Reserve(op.UnitId,uid,reward,v);if not ok then return nil,why end
 else return nil,"InvalidOperation" end
 inv.CrateOperations[id]=op
 return nextData,nil,op,false
end
function Engine.Release(op,stock)
 for _,unit in ipairs(BatchRules.Rewards(op))do if unit.UnitId then stock:Release(unit.UnitId)end end
end
function Engine.Reconcile(data,stock)
 local complete=true
 for _,op in pairs(data.Inventory.CrateOperations or {})do
  if op.Kind=="Open" and op.State=="GrantCommitted"then
   local all=true
   for _,unit in ipairs(BatchRules.Rewards(op))do
    local success,ok=pcall(stock.Commit,stock,unit.UnitId);if not success or not ok then all=false end
   end
   if all then op.State="Completed"else complete=false end
  end
 end
 return complete
end
return Engine
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="524">
          <Properties>
            <string name="Name">InMemoryStock</string>
            <string name="Source"><![CDATA[--!nonstrict
local Ledger=require(script.Parent.StockLedger)
local Stock={};Stock.__index=Stock
function Stock.new(sharedState)return setmetatable({State=sharedState or {Buckets={},Operations={}},Scope="StudioServerInMemory",WritesToCloud=false},Stock)end
function Stock:View(reward,variation)
 local cs,reason=Ledger.Constraints(reward,variation);if not cs then return nil,reason end
 local view,err=Ledger.View(self.State,cs,reward.RewardId);if view then view.Scope=self.Scope end;return view,err
end
function Stock:Reserve(id,userId,reward,variation)
 local cs,reason=Ledger.Constraints(reward,variation);if not cs then return false,reason end
 return Ledger.Reserve(self.State,id,userId,reward,cs)
end
function Stock:Commit(id)return Ledger.Finish(self.State,id,true)end
function Stock:Release(id)return Ledger.Finish(self.State,id,false)end
return Stock
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="525">
          <Properties>
            <string name="Name">ProductionStockAdapter</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Prepared adapter only: injected store, no DataStoreService lookup, never selected in V1.
local Ledger=require(script.Parent.StockLedger)
local Adapter={};Adapter.__index=Adapter
function Adapter.new(store,key)
 assert(store and type(store.UpdateAsync)=="function" and type(key)=="string","StoreRequired")
 return setmetatable({Store=store,Key=key,Scope="ProductionLedgerUnvalidated",WritesToCloud=true},Adapter)
end
function Adapter:View(reward,variation)
 local cs,reason=Ledger.Constraints(reward,variation);if not cs then return nil,reason end
 -- A potentially cached read cannot prove current available stock for a purchase quote.
 return nil,"AuthoritativeSnapshotRequired"
end
function Adapter:_update(transform)
 local accepted,reason
 local ok,err=pcall(function()self.Store:UpdateAsync(self.Key,function(old)
  local state=old or {Buckets={},Operations={}}
  accepted,reason=transform(state)
  return if accepted then state else nil
 end)end)
 if not ok then return false,"StockOutcomeUnknown:"..tostring(err) end
 return accepted,reason
end
function Adapter:Reserve(id,uid,reward,variation)
 local cs,reason=Ledger.Constraints(reward,variation);if not cs then return false,reason end
 return self:_update(function(state)return Ledger.Reserve(state,id,uid,reward,cs)end)
end
function Adapter:Commit(id)return self:_update(function(state)return Ledger.Finish(state,id,true)end)end
function Adapter:Release(id)return self:_update(function(state)return Ledger.Finish(state,id,false)end)end
return Adapter
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="526">
          <Properties>
            <string name="Name">RewardVisualMetadata</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Read-only snapshot of the distribution already used by Odds.Roll. Never rolls.
local Metadata={}
function Metadata.Read(rows,rewardId)
 local percent;local eligible={}
 for _,row in ipairs(rows)do
  if row.Probability>0 then table.insert(eligible,row.Reward.RewardId)end
  if row.Reward.RewardId==rewardId then percent=row.Percent end
 end
 return percent,eligible
end
return Metadata
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="527">
          <Properties>
            <string name="Name">StandOpeningLedger</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Pure leases; never grants inventory or Coins. Time is injected and authoritative.
local Ledger={};Ledger.__index=Ledger
function Ledger.new(config,plan,clock)
 return setmetatable({Config=config,Plan=plan,Clock=clock,Players={},Stands={},Cooldowns={}},Ledger)
end
function Ledger:Release(userId,committed)
 local row=self.Players[userId];if not row then return end
 self.Players[userId]=nil
 if self.Stands[row.StandId]==row then self.Stands[row.StandId]=nil end
 if committed or row.Committed then
  local key=tostring(userId)..":"..row.StandId
  self.Cooldowns[key]=if self.Config.Stand.ReopenCooldown>0 then math.max(self.Cooldowns[key]or 0,self.Clock()+self.Config.Stand.ReopenCooldown)else nil
 end
 return row
end
function Ledger:Acquire(userId,standId,operationId,plan)
 self:Step()
 local existing=self.Players[userId]
 if existing then
  if existing.StandId==standId and existing.OperationId==operationId then return existing,nil,true end
  return nil,"OpeningInProgress"
 end
 if self.Clock()<(self.Cooldowns[tostring(userId)..":"..standId]or 0)then return nil,"StandCooldown"end
 if self.Config.Stand.ExclusiveOpening and self.Stands[standId]then return nil,"StandBusy"end
 local row={UserId=userId,StandId=standId,OperationId=operationId,Plan=plan or self.Plan,State="Reserved",Until=self.Clock()+self.Config.Stand.MaxSequenceDuration}
 self.Players[userId]=row
 if self.Config.Stand.ExclusiveOpening then self.Stands[standId]=row end
 return row
end
function Ledger:Commit(row,openingId)
 if self.Players[row.UserId]~=row or row.Committed then return false end
 row.Committed=true;row.OpeningId=openingId;row.Started=self.Clock();row.State="Opening"
 row.Until=row.Started+row.Plan.Duration
 return true
end
function Ledger:Step()
 local expired={};local now=self.Clock()
 for id,row in pairs(self.Players)do
  if now>=row.Until then table.insert(expired,id)
  elseif row.Committed then
   local elapsed=now-row.Started
   local reward=row.Plan.Stages[8].Start;local outro=row.Plan.Stages[9].Start
   row.State=if elapsed>=outro then "Finishing"elseif elapsed>=reward then "Revealing"else "Opening"
  end
 end
 local released={};for _,id in ipairs(expired)do table.insert(released,self:Release(id))end
 for key,deadline in pairs(self.Cooldowns)do if now>=deadline then self.Cooldowns[key]=nil end end
 return released
end
return Ledger
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="528">
          <Properties>
            <string name="Name">StandOpeningService</string>
            <string name="Source"><![CDATA[--!nonstrict
local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local RS=game:GetService("ReplicatedStorage")
local Config=require(RS.Shared.SlapCrates.OpeningConfig)
local Timeline=require(RS.Shared.SlapCrates.OpeningTimeline)
local Ledger=require(script.Parent.StandOpeningLedger)
local Batch=require(RS.Shared.SlapCrates.BatchOpening)
local Service={};Service.__index=Service
function Service.new(owner)
 local plan,errorCode=Timeline.Build(Config)
 return setmetatable({Owner=owner,Plan=plan,Error=errorCode,Connections={},Prompts={},
  Ledger=plan and Ledger.new(Config,plan,os.clock),Active={},AccessRate={}},Service)
end
function Service:IsStandMode()return Config.Mode=="StandCinematic"end
function Service:Context()return {Mode=if self.Error then "Disabled"else Config.Mode,AllowedOpenQuantities=Config.AllowedOpenQuantities}end
function Service:FindStand(id)
 if type(id)~="string"or #id>64 then return nil end
 local folder=workspace:FindFirstChild("CrateStands");local found
 for _,model in ipairs(folder and folder:GetChildren()or {})do
  if model:IsA("Model")and model:GetAttribute("StandId")==id then if found then return nil end;found=model end
 end
 if not found or found:GetAttribute("Enabled")==false then return nil end
 for _,name in ipairs({"InteractionPart","SpawnPoint","CameraPoint","RewardPoint"})do
  local part=found:FindFirstChild(name);if not part or not part:IsA("BasePart")then return nil end
 end
 return found
end
function Service:Validate(player,id)
 if self.Error then return nil,self.Error end
 if not self:IsStandMode()or not Config.Stand.Enabled then return nil,"StandDisabled"end
 if not self.Owner:_lobby(player)then return nil,"LobbyOnly"end
 local model=self:FindStand(id);if not model then return nil,"InvalidStandId"end
 local char=player.Character;local root=char and char:FindFirstChild("HumanoidRootPart")
 local hum=char and char:FindFirstChildOfClass("Humanoid")
 if not root or not hum or hum.Health<=0 then return nil,"CharacterUnavailable"end
 local distance=(root.Position-model.InteractionPart.Position).Magnitude
 if distance~=distance or distance>Config.Stand.MaxActivationDistance then return nil,"StandTooFar"end
 return model
end
function Service:Release(userId,reason)
 local row=self.Ledger and self.Ledger:Release(userId)
 local visual=self.Active[userId];self.Active[userId]=nil
 if visual then
  for _,observer in ipairs(visual.Audience)do if observer.Parent==Players then
   local untilAt=self.Ledger.Cooldowns[tostring(userId)..":"..visual.Packet.StandId]
   self.Remote:FireClient(observer,{Kind="Cancel",OpeningId=visual.Packet.OpeningId,StandId=visual.Packet.StandId,Reason=reason,
    CooldownUntil=if observer.UserId==userId and untilAt then workspace:GetServerTimeNow()+math.max(0,untilAt-os.clock())else nil})
  end end
 end
 return row
end
function Service:Open(player,args,callback)
 if self.Error then return {Ok=false,Code=self.Error}end
 if not self:IsStandMode()then return callback()end
 local model,why=self:Validate(player,args.StandId);if not model then return {Ok=false,Code=why}end
 local quantity=Batch.Quantity(args.Quantity);if not quantity then return {Ok=false,Code="InvalidQuantity"}end
 local plan,planError=Timeline.Build(Config,quantity);if not plan then return {Ok=false,Code=planError}end
 local row,code=self.Ledger:Acquire(player.UserId,args.StandId,args.OperationId,plan)
 if not row then return {Ok=false,Code=code}end
 if not row.Player then row.Player=player;row.Character=player.Character end
 local ok,result=pcall(callback)
 if not ok then self:Release(player.UserId,"TransactionError");error(result)end
 -- Eligibility may yield. Present revalidates the lease, character, stand and distance.
 if not result.Ok or(result.Replay and not row.Committed)then self:Release(player.UserId,"NoNewPresentation")end
 result.Presentation={Mode="StandCinematic",OpeningId=result.Operation and result.Operation.UnitId}
 return result
end
function Service:Cancel(player,openingId)
 local visual=self.Active[player.UserId]
 if not visual then return {Ok=true}end
 if visual.Packet.OpeningId~=openingId then return {Ok=false,Code="OpeningMismatch"}end
 self:Release(player.UserId,"ClientCancelled")
 return {Ok=true}
end
function Service:Present(player,crate,op)
 local row=self.Ledger.Players[player.UserId]
 if not row or row.OperationId~=op.OperationId then return end
 -- This method is called after the existing economic commit, even if visuals cannot start.
 if not self.Ledger:Commit(row,op.UnitId)then return end
 local model=self:Validate(player,row and row.StandId)
 if row.Character~=player.Character or not model then
  self:Release(player.UserId,"PresentationUnavailable");return
 end
 local packet={Kind="Opening",Mode="StandCinematic",StandId=row.StandId,OpeningId=op.UnitId,
  Operation={RewardId=op.RewardId,CrateId=crate.CrateId,SlapId=op.SlapId,VariationId=op.VariationId,Quantity=op.Quantity or 1,Rewards=op.Rewards and table.clone(op.Rewards),EffectivePercent=op.EffectivePercent,PreviewRewardIds=op.PreviewRewardIds and table.clone(op.PreviewRewardIds)},
  StartedAt=workspace:GetServerTimeNow(),Duration=row.Plan.Duration,BuyerUserId=player.UserId,
  Exclusive=Config.Stand.ExclusiveOpening,Model=crate.Model}
 local audience={player}
 if Config.Stand.ExclusiveOpening then for _,other in ipairs(Players:GetPlayers())do
  local root=other.Character and other.Character:FindFirstChild("HumanoidRootPart")
  if other~=player and root and self.Owner:_lobby(other)and(root.Position-model.InteractionPart.Position).Magnitude<=Config.Stand.SpectatorRadius then table.insert(audience,other)end
 end end
 self.Active[player.UserId]={Packet=packet,Audience=audience,Character=player.Character}
 for _,other in ipairs(audience)do self.Remote:FireClient(other,packet)end
end
function Service:SyncStands()
 local folder=workspace:FindFirstChild("CrateStands")
 for _,model in ipairs(folder and folder:GetChildren()or {})do
  local id=model:GetAttribute("StandId");local valid=self:FindStand(id)==model
  local part=model:FindFirstChild("InteractionPart");local prompt=part and part:FindFirstChildWhichIsA("ProximityPrompt")
  if prompt then
   prompt.Enabled=valid and not self.Error and self:IsStandMode()and Config.Stand.Enabled
   if not self.Prompts[prompt]then
    self.Prompts[prompt]=prompt.Triggered:Connect(function(player)
     local now=os.clock();if now<(self.AccessRate[player]or 0)then return end;self.AccessRate[player]=now+.5
     local stand=self:Validate(player,model:GetAttribute("StandId"));if not stand then return end
     self.Remote:FireClient(player,{Kind="Access",StandId=model:GetAttribute("StandId"),Mode=Config.Mode})
    end)
   end
  end
  local lease=self.Ledger and self.Ledger.Stands[id]
  local state=lease and lease.State or "Idle"
  if model:GetAttribute("OpeningState")~=state then model:SetAttribute("OpeningState",state)end
  local anchor=model:FindFirstChild("BillboardAnchor");local gui=anchor and anchor:FindFirstChild("BillboardGui")
  local status=gui and gui:FindFirstChild("Status",true)
  local title=gui and gui:FindFirstChild("Title",true);local subtitle=gui and gui:FindFirstChild("Price",true)
  if title then title.Text=if state~="Idle"then "APERTURA EN CURSO"else "CAJAS"end
  if subtitle then subtitle.Text=if state~="Idle"then "Esperá tu turno"else "Abrí cajas y conseguí slaps exclusivos"end
  if status then status.Text=if state~="Idle"then "EN USO"elseif not valid then "STAND NO DISPONIBLE"else "VER PRECIOS Y PROBABILIDADES"end
 end
 for prompt,connection in pairs(self.Prompts)do if not prompt:IsDescendantOf(workspace)then connection:Disconnect();self.Prompts[prompt]=nil end end
end
function Service:Start(remote)
 self.Remote=remote;self:SyncStands()
 local last=0
 table.insert(self.Connections,RunService.Heartbeat:Connect(function()
  if os.clock()-last<.25 then return end;last=os.clock()
  if self.Ledger then
   for _,row in ipairs(self.Ledger:Step())do self:Release(row.UserId,"Completed")end
   for id,row in pairs(self.Ledger.Players)do
    if not row.Player or row.Player.Character~=row.Character or not self:Validate(row.Player,row.StandId)then self:Release(id,"ContextChanged")end
   end
   for _,visual in pairs(self.Active)do
    if visual.Packet.Exclusive then
     local model=self:FindStand(visual.Packet.StandId)
     if model then for _,other in ipairs(Players:GetPlayers())do
      local root=other.Character and other.Character:FindFirstChild("HumanoidRootPart")
      if root and self.Owner:_lobby(other)and(root.Position-model.InteractionPart.Position).Magnitude<=Config.Stand.SpectatorRadius
       and not table.find(visual.Audience,other)then
       table.insert(visual.Audience,other);self.Remote:FireClient(other,visual.Packet)
      end
     end end
    end
   end
  end
  self:SyncStands()
 end))
 table.insert(self.Connections,Players.PlayerRemoving:Connect(function(player)self:Release(player.UserId,"Disconnected");self.AccessRate[player]=nil end))
end
return Service
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="529">
          <Properties>
            <string name="Name">StockLedger</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Single-key ledger: reward and optional aggregate variation supply change atomically.
local Ledger={}
local function valid(n)return type(n)=="number" and n>=0 and n<math.huge and n%1==0 end
function Ledger.Constraints(reward,variation)
 local constraints={}
 for _,d in ipairs({{Definition=reward,Key="Reward:"..reward.RewardId},{Definition=variation,Key="Variation:"..variation.Id}})do
  local x=d.Definition
  if x.LimitedStock then
   if not valid(x.TotalSupply or x.DefaultStock) or type(x.EditionId)~="string" or x.EditionId=="" then return nil,"StockUnconfigured" end
   table.insert(constraints,{Key=d.Key..":"..x.EditionId,Supply=x.TotalSupply or x.DefaultStock,EditionId=x.EditionId})
  end
 end
 return constraints
end
function Ledger.View(state,constraints,rewardId)
 local remaining=nil;local issued=0;local totalSupply=nil
 for _,op in pairs(state.Operations)do if op.RewardId==rewardId and op.State=="Issued"then issued+=1 end end
 for _,c in ipairs(constraints)do
  local bucket=state.Buckets[c.Key]
  if bucket and bucket.Supply~=c.Supply then return nil,"SupplyChanged" end
  local n=bucket and bucket.Reserved or 0;local i=bucket and bucket.Issued or 0
  if not valid(n)or not valid(i)or n+i>c.Supply then return nil,"StockCorrupt" end
  remaining=math.min(remaining or math.huge,c.Supply-n-i)
  if c.Key:sub(1,7)=="Reward:"then totalSupply=c.Supply end
 end
 return {UnlimitedStock=#constraints==0,LimitedStock=#constraints>0,TotalSupply=totalSupply,RemainingStock=remaining,IssuedCount=issued,
  CurrentlyOwnedUnits=nil,UniqueOwnerCount=nil,SoldOut=remaining~=nil and remaining<=0,Scope="Ledger",Constraints=constraints}
end
function Ledger.Reserve(state,operationId,userId,reward,constraints)
 local existing=state.Operations[operationId]
 if existing then
  if existing.UserId~=userId or existing.RewardId~=reward.RewardId then return false,"OperationConflict" end
  return existing.State~="Released",existing.State=="Released" and "ReservationReleased" or nil
 end
 local size=0 for _ in pairs(state.Operations)do size+=1 end
 if size>=1024 then return false,"StockJournalCapacity" end
 local view,reason=Ledger.View(state,constraints,reward.RewardId);if not view then return false,reason end
 if view.SoldOut then return false,"SoldOut" end
 for _,c in ipairs(constraints)do
  local b=state.Buckets[c.Key] or {Supply=c.Supply,Reserved=0,Issued=0};state.Buckets[c.Key]=b;b.Reserved+=1
 end
 state.Operations[operationId]={UserId=userId,RewardId=reward.RewardId,State="Reserved",Constraints=constraints}
 return true
end
function Ledger.Finish(state,id,commit)
 local op=state.Operations[id];if not op then return false,"ReservationMissing" end
 local target=if commit then "Issued" else "Released"
 if op.State==target then return true end
 if op.State~="Reserved" then return false,"InvalidStockTransition" end
 for _,c in ipairs(op.Constraints)do local b=state.Buckets[c.Key];b.Reserved-=1;if commit then b.Issued+=1 end end
 op.State=target;return true
end
return Ledger
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="530">
        <Properties>
          <string name="Name">DeathEffectService</string>
          <string name="Source"><![CDATA[--!nonstrict
-- A presentation subscriber to the FINAL elimination decision. Never awards anything.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local RunService = game:GetService("RunService")
local Config = require(ReplicatedStorage.Shared.DeathFeedbackConfig)
local Catalog = require(ReplicatedStorage.Shared.DeathEffectDefinitions)
local Contract = require(ReplicatedStorage.Shared.DeathFeedbackContract)
local GameConfig = require(ReplicatedStorage.Shared.Config)
local Service = {Name="DeathEffectService"}
function Service:Init(context)
 self._context=context
 self._seen={}
 self._connections={}
 self._remote=ReplicatedStorage.Remotes.Match:FindFirstChild("DeathFeedback")
 if not self._remote then
  self._remote=Instance.new("RemoteEvent"); self._remote.Name="DeathFeedback"
  self._remote.Parent=ReplicatedStorage.Remotes.Match
 end
 assert(self._remote:IsA("RemoteEvent"),"DeathFeedback remote class invalid")
 -- Replicate templates, never live effects. Local clones are visible only to recipients.
 local source=assert(ServerStorage:FindFirstChild("DeathEffects"),"ServerStorage.DeathEffects missing")
 local assets=ReplicatedStorage:FindFirstChild("DeathEffectAssets")
 if not assets then assets=Instance.new("Folder");assets.Name="DeathEffectAssets";assets.Parent=ReplicatedStorage end
 for _,definition in pairs(Catalog) do
  local model=source:FindFirstChild(definition.ModelName)
  assert(model and model:IsA("Model") and model:FindFirstChild("Origin"),"Death effect template missing: "..definition.ModelName)
  for _,item in ipairs(model:GetDescendants()) do
   assert(not item:IsA("LuaSourceContainer") and not item:IsA("Explosion"),"Unsafe death effect template")
   if item:IsA("BasePart") then
    assert(item.Anchored and not item.CanCollide and not item.CanTouch and not item.CanQuery,"Unsafe death effect Part")
   end
  end
  if not assets:FindFirstChild(model.Name) then model:Clone().Parent=assets end
 end
end
function Service:HandleConfirmed(record)
 if type(record)~="table" or type(record.EliminationId)~="string" then return false end
 local function reject(reason)
  if GameConfig.Respawn.Debug then warn("[RespawnDebug] FeedbackRejectedServer",record.MatchId,record.EliminationId,record.Reason,reason) end
  return false
 end
 local snapshot=record.FeedbackSnapshot
 local killPart=record.Reason=="KillPart" or record.Reason=="KillPart_NormalFall"
 local snapshotEffect=type(snapshot)=="table" and snapshot.SessionId==record.MatchId
  and snapshot.EliminationId==record.EliminationId and typeof(snapshot.ImpactCFrame)=="CFrame"
  and Catalog[snapshot.EffectId]~=nil
 -- Compatibility for old receipts without an impact snapshot; current sensors always supply one.
 local rewardOnly=not snapshotEffect and not killPart and record.Killer~=nil and (record.RewardCoins or 0)>0
  and (record.Reason=="VoidBoundary" or record.Reason=="VoidBoundaryPolling")
 if (not snapshotEffect and not killPart and not rewardOnly) or (killPart and typeof(record.ImpactCFrame)~="CFrame") then return reject("MissingSnapshotOrImpact") end
 local rounds=self._context:GetService("RoundService")
 local session=rounds:GetSessionById(record.MatchId)
 if not session or not rounds:IsSessionActive(record.MatchId) or session.Closing or session.Closed
  or session.Cancelled or session.GameplayFrozen or not Contract.IsFeedbackState(session.State)
  or record.StateVersion~=session.StateVersion or type(record.ConfirmedAt)~="number"
  or workspace:GetServerTimeNow()-record.ConfirmedAt>Config.EventLifetime then return reject("SessionStateVersionOrAge") end
 local victim=record.Victim
 local participant=victim and rounds:GetSessionParticipant(session.Id,victim)
 if not participant or victim.Parent~=Players or victim:GetAttribute("MatchId")~=session.Id then return reject("VictimNotInSession") end
 local killer=record.Killer
 if killer then
  local attacker=rounds:GetSessionParticipant(session.Id,killer)
  if not attacker or killer==victim or killer.Parent~=Players or attacker.Team==participant.Team
   or killer:GetAttribute("MatchId")~=session.Id then return reject("AttackerNotInSession") end
 end
 local seen=self._seen[session.Id]
 if not seen then seen={};self._seen[session.Id]=seen end
 if seen[record.EliminationId] then return reject("DuplicateEliminationId") end
 seen[record.EliminationId]=true
 local effectId=if snapshotEffect then snapshot.EffectId else Contract.ResolveEffect(self._context:GetService("PlayerService"),victim,killer~=nil,Catalog,Config.DeathEffects)
 if not Catalog[effectId] then warn("[DeathEffectService] Effect not allowlisted");return false end
 local payload={
  SessionId=session.Id, StateVersion=session.StateVersion, EliminationId=record.EliminationId,
  Kind=if snapshotEffect then snapshot.Kind else (killer and "CreditedKill" or "UnattributedFall"),
  VictimUserId=if snapshotEffect then snapshot.VictimUserId else victim.UserId, VictimName=if snapshotEffect then snapshot.VictimName else victim.DisplayName,
  KillerUserId=if snapshotEffect then snapshot.KillerUserId else (killer and killer.UserId), KillerName=if snapshotEffect then snapshot.KillerName else (killer and killer.DisplayName),
  EffectId=effectId, ImpactCFrame=if snapshotEffect then snapshot.ImpactCFrame else record.ImpactCFrame,
  Debug=GameConfig.Respawn.Debug==true, Generation=if snapshotEffect then snapshot.Generation else nil, Reason=record.Reason,
  RewardOnly=rewardOnly,
  SentAt=record.ConfirmedAt,
 }
 for _,member in ipairs(session.Participants) do
  local player=member.Player
  if (not rewardOnly or player==killer) and player and player.Parent==Players and rounds:GetSessionParticipant(session.Id,player)==member
   and player:GetAttribute("MatchId")==session.Id then
   local private=table.clone(payload)
   -- Other spectators never receive a reward trigger, even inside this session.
   private.RewardCoins=player==killer and math.max(0,record.RewardCoins or 0) or 0
   self._remote:FireClient(player,private)
   if GameConfig.Respawn.Debug then print("[RespawnDebug] FeedbackSent",session.Id,record.EliminationId,"To",player.UserId,"Effect",effectId,"RewardOnly",rewardOnly,"Coins",private.RewardCoins) end
  end
 end
 print("[DeathEffectService] Confirmed",session.Id,record.EliminationId,payload.Kind,effectId)
 return true
end
function Service:Start(context)
 table.insert(self._connections,context:GetService("EliminationService").PlayerEliminated:Connect(function(record)
  local ok,failure=pcall(self.HandleConfirmed,self,record)
  if not ok then warn("[DeathEffectService] "..tostring(failure)) end
 end))
 local elapsed=0
 table.insert(self._connections,RunService.Heartbeat:Connect(function(dt)
  elapsed+=dt;if elapsed<1 then return end;elapsed=0
  local rounds=context:GetService("RoundService")
  for id in pairs(self._seen) do if not rounds:IsSessionActive(id) then self._seen[id]=nil end end
 end))
end
return Service
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="531">
        <Properties>
          <string name="Name">EliminationService</string>
          <string name="Source"><![CDATA[--!strict
-- EliminationService
-- Servicio autoritativo de resolución de eliminaciones y atribución de Kills.
-- Responsabilidad exclusiva:
-- - Detectar cuando un jugador en partida es eliminado (contacto con KillPart o Humanoid.Died).
-- - Validar que la eliminación pertenezca a una partida activa en estado Playing.
-- - Resolver el último atacante válido (LastAttacker) a través de CombatService.
-- - Validar ventana de tiempo (LastHitLifetime), pertenencia al mismo MatchId y attacker ~= victim.
-- - Otorgar autoritativamente +1 Kill al atacante vía PlayerService.
-- - Garantizar protección estricta contra Kills duplicadas (Anti-Duplicate por MatchId + Victim + EliminationId).
-- - Limpiar CombatTags una vez resuelta la Kill.
-- NO administra la lógica de puntos de partida (ScoreService) ni reposicionamiento de spawns.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Config = require(ReplicatedStorage.Shared.Config)
local Constants = require(ReplicatedStorage.Shared.Constants)
local CompetitiveTransit = require(script.Parent.Respawn.CompetitiveTransit)
local Types = require(ReplicatedStorage.Shared.Types)
local DeathFeedbackContract = require(ReplicatedStorage.Shared.DeathFeedbackContract)
local ArenaRespawnPolicy = require(ReplicatedStorage.Shared.ArenaRespawnPolicy)
local DeathEffectCatalog = require(ReplicatedStorage.Shared.DeathEffectDefinitions)
local DeathFeedbackSettings = require(ReplicatedStorage.Shared.DeathFeedbackConfig)

type MatchSession = Types.MatchSession
type EliminationRecord = Types.EliminationRecord

local EliminationService = {}
EliminationService.Name = "EliminationService"

-- Evento Bindable para que otros sistemas puedan suscribirse a eliminaciones confirmadas
local playerEliminatedBindable = Instance.new("BindableEvent")
EliminationService.PlayerEliminated = playerEliminatedBindable.Event

EliminationService._transits = CompetitiveTransit.new()
EliminationService._context = nil :: any
EliminationService._connections = {} :: { [string]: { RBXScriptConnection } }
EliminationService._resolvedEliminations = {} :: { [string]: boolean }
EliminationService._processingEliminations = {} :: { [Player]: number }
EliminationService._eliminationCounters = {} :: { [Player]: number }
EliminationService._activeSessions = {} :: { [string]: MatchSession }
EliminationService._isPolling = false
EliminationService._pollThread = nil :: thread?
EliminationService._combatService = nil :: any
EliminationService._playerService = nil :: any
EliminationService._roundService = nil :: any
EliminationService._spawnService = nil :: any

function EliminationService:Init(context: any)
	self._context = context
	self._transits = CompetitiveTransit.new()
	self._connections = {}
	self._resolvedEliminations = {}
	self._processingEliminations = {}
	self._eliminationCounters = {}
	self._activeSessions = {}
	self._isPolling = false
	self._pollThread = nil
end

function EliminationService:Start(context: any)
	self._context = context
	self._playerRemovingConnection = Players.PlayerRemoving:Connect(function(player)
		for sessionId in pairs(self._activeSessions) do self._transits:ForgetPlayer(sessionId,player) end
	end)
	print("[EliminationService] Servicio de eliminación iniciado y listo")
end

-- ==================================================
-- RESOLUCIÓN DE SERVICIOS
-- ==================================================

function EliminationService:_getCombatService(): any
	if self._combatService then return self._combatService end
	if self._context and type(self._context.GetService) == "function" then
		local s = self._context:GetService("CombatService")
		if s then self._combatService = s; return s end
	end
	local servicesFolder = ServerScriptService:FindFirstChild("Services")
	local mod = servicesFolder and servicesFolder:FindFirstChild("CombatService")
	if mod and mod:IsA("ModuleScript") then
		local ok, result = pcall(require, mod)
		if ok and result then self._combatService = result; return result end
	end
	return nil
end

function EliminationService:_getPlayerService(): any
	if self._playerService then return self._playerService end
	if self._context and type(self._context.GetService) == "function" then
		local s = self._context:GetService("PlayerService")
		if s then self._playerService = s; return s end
	end
	local servicesFolder = ServerScriptService:FindFirstChild("Services")
	local mod = servicesFolder and servicesFolder:FindFirstChild("PlayerService")
	if mod and mod:IsA("ModuleScript") then
		local ok, result = pcall(require, mod)
		if ok and result then self._playerService = result; return result end
	end
	return nil
end

function EliminationService:_getRoundService(): any
	if self._roundService then return self._roundService end
	if self._context and type(self._context.GetService) == "function" then
		local s = self._context:GetService("RoundService")
		if s then self._roundService = s; return s end
	end
	local servicesFolder = ServerScriptService:FindFirstChild("Services")
	local mod = servicesFolder and servicesFolder:FindFirstChild("RoundService")
	if mod and mod:IsA("ModuleScript") then
		local ok, result = pcall(require, mod)
		if ok and result then self._roundService = result; return result end
	end
	return nil
end

function EliminationService:_getSpawnService(): any
	if self._spawnService then return self._spawnService end
	if self._context and type(self._context.GetService) == "function" then
		local s = self._context:GetService("SpawnService")
		if s then self._spawnService = s; return s end
	end
	local servicesFolder = ServerScriptService:FindFirstChild("Services")
	local mod = servicesFolder and servicesFolder:FindFirstChild("SpawnService")
	if mod and mod:IsA("ModuleScript") then
		local ok, result = pcall(require, mod)
		if ok and result then self._spawnService = result; return result end
	end
	return nil
end

local function isPlayer(p: any): boolean
	if not p then return false end
	if typeof(p) == "Instance" then
		return p:IsA("Player")
	end
	if (typeof(p) == "userdata" or typeof(p) == "table") and type(p.IsA) == "function" then
		return p:IsA("Player")
	end
	return false
end

-- Obtiene el Player a partir de cualquier BasePart del personaje de forma robusta
local function getPlayerFromPart(part: BasePart): Player?
	if not part or not part:IsA("BasePart") then return nil end
	local current: Instance? = part
	while current and current ~= workspace do
		if current:IsA("Model") then
			local humanoid = current:FindFirstChildOfClass("Humanoid")
			if humanoid then
				local player = Players:GetPlayerFromCharacter(current)
				if player then return player end
			end
		end
		current = current.Parent
	end
	return nil
end

function EliminationService:_getActiveSession(sessionId: string): MatchSession?
	local roundService = self:_getRoundService()
	if not roundService
		or type(roundService.GetSessionById) ~= "function"
		or type(roundService.IsSessionActive) ~= "function"
		or not roundService:IsSessionActive(sessionId) then
		return nil
	end
	return roundService:GetSessionById(sessionId)
end

function EliminationService:_getParticipant(sessionId: string, player: Player): any?
	local roundService = self:_getRoundService()
	if not roundService or type(roundService.GetSessionParticipant) ~= "function" then
		return nil
	end
	return roundService:GetSessionParticipant(sessionId, player)
end

function EliminationService:_isOpposingParticipant(sessionId: string, attacker: Player, victim: Player): boolean
	local attackerParticipant = self:_getParticipant(sessionId, attacker)
	local victimParticipant = self:_getParticipant(sessionId, victim)
	return attackerParticipant ~= nil
		and victimParticipant ~= nil
		and attackerParticipant.Team ~= victimParticipant.Team
end

-- ==================================================
-- VINCULACIÓN CON MAPAS Y PARTIDAS
-- ==================================================

-- Vincula la detección de KillParts, VoidBoundary y muertes a una MatchSession activa
-- Called by ScoreService after its own zone/team validations, before any goal callbacks/yields.
function EliminationService:TryProtectGoal(session: MatchSession, player: Player, character: Model, pointId: string): boolean
 if self:_getActiveSession(session.Id) ~= session or session.State ~= Constants.RoundState.Playing then return false end
 if not self:_getParticipant(session.Id,player) or player.Character~=character or not character.Parent then return false end
 if character:GetAttribute("ArenaRespawnPending") then return false end
 local humanoid=character:FindFirstChildOfClass("Humanoid")
 if not humanoid or humanoid.Health<=0 then return false end
 return self._transits:Claim(session,player,character,character:GetAttribute("ArenaPhysicsGeneration") or 0,"Goal",pointId)
end

function EliminationService:ReleaseGoalProtections(sessionId: string)
 self._transits:ReleaseGoals(sessionId)
end

function EliminationService:BindMatch(session: MatchSession)
	if not session or not session.Id then return end
	local matchId = session.Id
	if self:_getActiveSession(matchId) ~= session then return end
	self:UnbindMatch(matchId)

	local conns: { RBXScriptConnection } = {}
	self._connections[matchId] = conns

	-- 1. Vincular partes de eliminación física (KillParts) como sensores no letales
	local killParts: { BasePart } = {}
	if session.InstanceInfo then
		if session.InstanceInfo.KillParts and #session.InstanceInfo.KillParts > 0 then
			killParts = session.InstanceInfo.KillParts
		elseif session.InstanceInfo.InstanceModel then
			for _, desc in ipairs(session.InstanceInfo.InstanceModel:GetDescendants()) do
				if desc:IsA("BasePart") and desc.Name == "KillPart" then
					table.insert(killParts, desc)
				end
			end
		end
	end

	for _, killPart in ipairs(killParts) do
		local conn = killPart.Touched:Connect(function(otherPart)
			self:HandleKillPartTouch(killPart, otherPart, session)
		end)
		table.insert(conns, conn)
	end

	-- 2. Vincular sensor de límite de vacío (VoidBoundaryPart) como sensor no letal
	if session.InstanceInfo and session.InstanceInfo.VoidBoundaryPart then
		local voidBoundary = session.InstanceInfo.VoidBoundaryPart
		local voidConn = voidBoundary.Touched:Connect(function(otherPart)
			self:HandleVoidBoundaryTouch(voidBoundary, otherPart, session)
		end)
		table.insert(conns, voidConn)
	end

	-- 3. Escuchar Humanoid.Died en modo diagnóstico pasivo (Fase 4B Zero-Death)
	local trackPlayerDeath = function(player: Player)
		if not player then return end

		local function onCharacter(character: Model)
			self._transits:ForgetPlayer(matchId,player)
			table.insert(conns, character.Destroying:Connect(function()
				if player.Character==character then self._transits:ForgetPlayer(matchId,player) end
			end))
			local hum = character:WaitForChild("Humanoid", 5) :: Humanoid?
			if hum then
				local diedConn = hum.Died:Connect(function()
					warn(string.format("[EliminationService] [DIAGNOSTIC] Humanoid.Died detectado en '%s' durante Match '%s'. Evento absorbido pasivamente por Zero-Death (sin scoring, sin respawn).",
						player.Name, matchId))
				end)
				table.insert(conns, diedConn)
			end
		end

		if player.Character then
			onCharacter(player.Character)
		end
		table.insert(conns, player.CharacterRemoving:Connect(function() self._transits:ForgetPlayer(matchId,player) end))
		table.insert(conns, player:GetAttributeChangedSignal("MatchId"):Connect(function()
			if player:GetAttribute("MatchId")~=matchId then self._transits:ForgetPlayer(matchId,player) end
		end))
		local charConn = player.CharacterAdded:Connect(onCharacter)
		table.insert(conns, charConn)
	end

	for _, participant in ipairs(session.Participants) do
		if self:_getParticipant(matchId, participant.Player) == participant then
			trackPlayerDeath(participant.Player)
		end
	end

	-- Registrar sesión activa y arrancar polling fail-safe si corresponde
	self._activeSessions[matchId] = session
	self:_startPollingIfNeeded()

	print(string.format("[EliminationService] Vinculación completada para Match '%s' (%d KillParts, VoidBoundary: %s)",
		matchId, #killParts, tostring(session.InstanceInfo and session.InstanceInfo.VoidBoundaryPart ~= nil)))
end

-- Desvincula los listeners y limpia el registro de una partida finalizada
function EliminationService:UnbindMatch(matchId: string)
	if not matchId then return end
	self._transits:ClearSession(matchId)
	local spawn = self:_getSpawnService()
	if spawn and spawn.CancelSessionRespawns then spawn:CancelSessionRespawns(matchId, "MatchUnbound") end

	local conns = self._connections[matchId]
	if conns then
		for _, c in ipairs(conns) do
			c:Disconnect()
		end
		self._connections[matchId] = nil
	end

	-- Desregistrar sesión activa y detener polling si no quedan partidas
	self._activeSessions[matchId] = nil
	if next(self._activeSessions) == nil then
		self:_stopPolling()
	end

	-- Limpiar claves resueltas asociadas al matchId
	local prefix = matchId .. "_"
	for key, _ in pairs(self._resolvedEliminations) do
		if string.sub(key, 1, #prefix) == prefix then
			self._resolvedEliminations[key] = nil
		end
	end

	-- Limpiar debounces y contadores temporales de jugadores desconectados
	for player, _ in pairs(self._processingEliminations) do
		if not player:IsDescendantOf(Players) then
			self._processingEliminations[player] = nil
		end
	end
	for player, _ in pairs(self._eliminationCounters) do
		if not player:IsDescendantOf(Players) then
			self._eliminationCounters[player] = nil
		end
	end
end

-- ==================================================
-- SENSORES NO LETALES (Zero-Death Fase 3A / 3B)
-- ==================================================

-- Procesa el contacto con un KillPart como sensor de eliminación/caída (Humanoid.Health intacto)
function EliminationService:_publishReceipt(record: EliminationRecord,beforeRoundClose: boolean?)
 -- Deferred Bindable delivery may run after a fifth-goal terminal barrier.
 -- Deliver this same receipt synchronously before closing; normal subscriber dedup remains authoritative.
 if beforeRoundClose then
  local effects=self._context and self._context:GetService("DeathEffectService")
  if effects then
   local ok,err=pcall(function() effects:HandleConfirmed(record) end)
   if not ok then warn("[EliminationService] Sudden-death presentation failed: "..tostring(err)) end
  end
 end
 playerEliminatedBindable:Fire(record)
end

-- Third authoritative Slap hit: same receipt/award/effect/Zero-Death pipeline, at the actual victim position.
function EliminationService:HandleSlapThreshold(victim: Player,session: MatchSession,attacker: Player): boolean
 if not self:_isOpposingParticipant(session.Id,attacker,victim) then return false end
 local combat=self:_getCombatService()
 local last,matchId=combat:GetLastAttacker(victim,Config.Combat.LastHitLifetime)
 if last~=attacker or matchId~=session.Id then return false end
 return self:_processEliminationEvent(victim,session,"SlapThreshold")==true
end

function EliminationService:HandleKillPartTouch(killPart: BasePart, hitPart: BasePart, session: MatchSession)
	local player = getPlayerFromPart(hitPart)
	if not player then return end
	if not ArenaRespawnPolicy.IsContactCurrent(killPart.CFrame, killPart.Size, hitPart.Position, hitPart.Size) then return end
	self:_processEliminationEvent(player, session, "KillPart", killPart, hitPart)
end

-- Controlled impact capability; modules never call the elimination/economy service.
function EliminationService:HandleAbilityHit(victim: Player, session: MatchSession, attacker: Player, reason: string): boolean
 if reason~="StrongSlap" and reason~="AbilityImpact" then return false end
 if not self:_isOpposingParticipant(session.Id,attacker,victim) then return false end
 local last,matchId=self:_getCombatService():GetLastAttacker(victim,Config.Combat.LastHitLifetime)
 if last~=attacker or matchId~=session.Id then return false end
 return self:_processEliminationEvent(victim,session,reason)==true
end

-- Procesa el contacto con el sensor VoidBoundaryPart de la arena (Humanoid.Health intacto)
function EliminationService:HandleVoidBoundaryTouch(voidBoundary: BasePart, hitPart: BasePart, session: MatchSession)
	local player = getPlayerFromPart(hitPart)
	if not player then return end
	if not ArenaRespawnPolicy.IsContactCurrent(voidBoundary.CFrame, voidBoundary.Size, hitPart.Position, hitPart.Size) then return end
	self:_processEliminationEvent(player, session, "VoidBoundary", voidBoundary, hitPart)
end

-- Núcleo unificado de procesamiento autoritativo de salida / eliminación sin muerte física
function EliminationService:_processEliminationEvent(player: Player, session: MatchSession, source: string, boundaryPart: BasePart?, hitPart: BasePart?)
	-- 1. Validar que la instancia sea un Player conectado
	if not player or not isPlayer(player) or not player:IsDescendantOf(Players) then return end

	-- 2. Validar que la sesión esté activa y en estado válido para el lifecycle
	if not session or not session.Id then return end
	local matchId = session.Id

	local roundService = self:_getRoundService()
	if self:_getActiveSession(matchId) ~= session then return end
	local currentState = roundService:GetSessionState(matchId)

	-- Estados permitidos: Playing, PointRestartCountdown, StartCountdown, Ending
	if currentState ~= Constants.RoundState.Playing
		and currentState ~= Constants.RoundState.PointRestartCountdown
		and currentState ~= Constants.RoundState.StartCountdown
		and currentState ~= Constants.RoundState.Ending then
		return
	end

	if currentState==Constants.RoundState.Playing and not roundService:IsGameplayRoundOpen(session) then return end

	-- 3. Validar pertenencia estricta del jugador a este match específico
	if not self:_getParticipant(matchId, player) then return end
	local respawnOwner = self:_getSpawnService()
	if respawnOwner and respawnOwner.IsKillPartRespawnPending and respawnOwner:IsKillPartRespawnPending(player) then return end

	-- 4. Multi-match isolation: Validar que el boundaryPart pertenezca al contenedor de esta MatchInstance
	if boundaryPart and session.InstanceInfo then
		local container = session.InstanceInfo.Container
		if container and not boundaryPart:IsDescendantOf(container) then
			-- El sensor tocado pertenece a otra arena
			return
		end
	end

	-- Reject the exact already-resolved transit BEFORE debounce, attribution, awards or feedback.
 local character = player.Character
 if not character or not character.Parent then return end
 if hitPart and not hitPart:IsDescendantOf(character) then return end
 local humanoid=character:FindFirstChildOfClass("Humanoid")
 if not humanoid or humanoid.Health<=0 then return end
 local generation=character:GetAttribute("ArenaPhysicsGeneration") or 0
 local resolved=self._transits:Get(session,player,character,generation)
 if resolved then
  if Config.Respawn.Debug then print("[ScoreKillPart] ContactSuppressed",matchId,player.UserId,resolved.Kind,resolved.EventId,generation,source) end
  return
 end

 -- Countdown contacts can use the existing placement recovery, but are not competitive eliminations.
 -- A protected goal Character has already returned above; do not give it a second recovery.
 if currentState~=Constants.RoundState.Playing then
  if respawnOwner and respawnOwner.ResetCharacterInArena then respawnOwner:ResetCharacterInArena(player,matchId) end
  return
 end

 -- Existing debounce remains for accepted elimination attempts only.
 local now=os.clock()
 local lastTouch=self._processingEliminations[player]
 if lastTouch and now-lastTouch<0.5 then return end
 self._processingEliminations[player]=now

	-- First validated authority wins; no callback/yield before reserving this life.
 if not self._transits:Claim(session,player,character,generation,"Elimination",source) then return end
 local abilities=self._context and self._context:GetService("AbilityService")
 if abilities then abilities:CancelPlayer(player,"Eliminated") end
 local round=session.GameplayRound
 local fall=source=="KillPart" or source=="VoidBoundary" or source=="VoidBoundaryPolling"
 local suddenGoal=fall and currentState==Constants.RoundState.Playing and round~=nil
  and round.SuddenDeath and Config.Round.SuddenDeath.FallAwardsGoal
 local suddenRoundId=round and round.Id
 if suddenGoal and not roundService:TryResolveGameplayRound(session,"SuddenDeathFall") then return end

	-- Capture contact BEFORE ResetCharacterInArena; never read a later spawn position in the feed.
	local impactCFrame: CFrame? = if source=="SlapThreshold" or source=="StrongSlap" or source=="AbilityImpact" then character:GetPivot() else nil
		if boundaryPart then
			local impactPart = hitPart or character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if impactPart then impactCFrame = DeathFeedbackContract.ImpactCFrame(boundaryPart.CFrame, boundaryPart.Size, impactPart.Position) end
	end
	local rewardCoins = 0

	-- 8. Resolver atacante en CombatService (solo elegible durante Playing o PointRestartCountdown)
	local combatEligible = (currentState == Constants.RoundState.Playing or currentState == Constants.RoundState.PointRestartCountdown)
	local combatService = self:_getCombatService()
	local killer: Player? = nil

	if combatEligible and combatService and type(combatService.GetLastAttacker) == "function" then
		local attacker, attackerMatchId = combatService:GetLastAttacker(
			player,
			(Config.Combat and Config.Combat.LastHitLifetime) or 10
		)

		if attacker and attacker ~= player and isPlayer(attacker) and attacker.Parent
			and attackerMatchId == matchId
			and self:_isOpposingParticipant(matchId, attacker, player) then
			killer = attacker
		end
	end

	-- 9. Clasificación del evento: CombatElimination vs Normal Fall
	local counter = (self._eliminationCounters[player] or 0) + 1
	self._eliminationCounters[player] = counter
	local elimKey = string.format("%s_%d_%d", matchId, player.UserId, counter)
		-- Resolve the victim cosmetic and immutable presentation identity BEFORE retirement.
		local effectId = DeathFeedbackContract.ResolveEffect(self:_getPlayerService(), player, killer ~= nil, DeathEffectCatalog, DeathFeedbackSettings.DeathEffects)
		local feedbackSnapshot = table.freeze({
			SessionId=matchId, StateVersion=session.StateVersion, EliminationId=elimKey,
			VictimUserId=player.UserId, VictimName=player.DisplayName,
			KillerUserId=killer and killer.UserId, KillerName=killer and killer.DisplayName,
			EffectId=effectId, ImpactCFrame=impactCFrame, Reason=source,
			Kind=if killer then "CreditedKill" else "UnattributedFall",
			Generation=character:GetAttribute("ArenaPhysicsGeneration") or 0,
		})
		if Config.Respawn.Debug then print("[RespawnDebug] EliminationConfirmed",matchId,elimKey,player.UserId,feedbackSnapshot.Generation,currentState,source,killer and killer.UserId,effectId) end
	local deferredRespawn = false
		if currentState == Constants.RoundState.Playing and not suddenGoal
		and respawnOwner and respawnOwner.BeginKillPartRespawn then
		-- Identity/impact/attacker are already captured. Retire now, before any downstream callbacks.
			-- Touched and void polling must use the SAME retirement/quiet recovery path.
			deferredRespawn = respawnOwner:BeginKillPartRespawn(player, session, elimKey, source .. (if killer then "_Kill" else "_NormalFall"))
	end

	if killer then
		-- CASO A: COMBAT ELIMINATION (+1 Kill)
		if not self._resolvedEliminations[elimKey] then
			self._resolvedEliminations[elimKey] = true
				-- Deaths means accepted competitive eliminations, never normal zero-death falls.
				if roundService.RecordMatchPerformance then
					roundService:RecordMatchPerformance(matchId, "Elimination_" .. elimKey, nil, killer, player)
				end

			local playerService = self:_getPlayerService()
			if playerService and type(playerService.AddKill) == "function" then
					playerService:AddKill(killer, 1, "SlapElimination")
					if type(playerService.AwardConfirmedKill) == "function" then
						-- Credit once by EliminationId; only the committed amount enters the visual receipt.
						rewardCoins = playerService:AwardConfirmedKill(killer, player, matchId, elimKey)
					end
			end

			print(string.format("[EliminationService] COMBAT ELIMINATION (%s): '%s' eliminó a '%s' (+1 Kill) en Match '%s'",
				source, killer.Name, player.Name, matchId))

			-- Limpiar CombatTag consumido
			if combatService and type(combatService.ClearCombatTag) == "function" then
				combatService:ClearCombatTag(player)
			end

			-- Emitir BindableEvent para sistemas de estadísticas y feed
			local record: EliminationRecord = {
				Victim = player,
				Killer = killer,
				MatchId = matchId,
				Timestamp = now,
				Reason = source,
				EliminationId = elimKey,
					FeedbackSnapshot = feedbackSnapshot,
					ImpactCFrame = impactCFrame,
					RewardCoins = rewardCoins,
					StateVersion = session.StateVersion,
					ConfirmedAt = workspace:GetServerTimeNow(),
			}
			self:_publishReceipt(record,suddenGoal)
		end
	else
		-- CASO B: NORMAL FALL (+0 Kill)
		print(string.format("[EliminationService] NORMAL FALL (%s): '%s' cayó sin atacante en Match '%s' (Estado: %s)",
			source, player.Name, matchId, tostring(currentState)))

		-- Limpiar CombatTag residual si existiese
		if combatService and type(combatService.ClearCombatTag) == "function" then
			combatService:ClearCombatTag(player)
		end

		local record: EliminationRecord = {
			Victim = player,
			Killer = nil,
			MatchId = matchId,
			Timestamp = now,
			Reason = source .. "_NormalFall",
			EliminationId = elimKey,
				FeedbackSnapshot = feedbackSnapshot,
			ImpactCFrame = impactCFrame,
			RewardCoins = 0,
				StateVersion = session.StateVersion,
				ConfirmedAt = workspace:GetServerTimeNow(),
		}
		self:_publishReceipt(record,suddenGoal)
	end

	if suddenGoal then
  local score=self._context and self._context:GetService("ScoreService")
  if not score or not score:AwardSuddenDeathGoal(session,player,suddenRoundId) then
   roundService:CloseSession(matchId,{Cancelled=true,Reason="SuddenDeathGoalCommitFailed"})
  end
  return true
 end

	-- 10. Reposicionamiento del Character EXISTENTE sin matar Humanoid ni recargar rig
	local spawnService = self:_getSpawnService()
	if not deferredRespawn and spawnService and type(spawnService.ResetCharacterInArena) == "function" then
		spawnService:ResetCharacterInArena(player)
	end
	return true
end

-- ==================================================
-- POLLING FAIL-SAFE DE CAÍDAS AL VACÍO (Fase 3B)
-- ==================================================

function EliminationService:_startPollingIfNeeded()
	if self._isPolling then return end
	self._isPolling = true
	self._pollThread = task.spawn(function()
		self:_pollActiveSessions()
	end)
end

function EliminationService:_stopPolling()
	self._isPolling = false
	if self._pollThread then
		task.cancel(self._pollThread)
		self._pollThread = nil
	end
end

-- Chequeo periódico exclusivo sobre participantes de partidas activas
function EliminationService:_pollActiveSessions()
	local pollInterval = (Config.Arena and Config.Arena.VoidBoundaryPollInterval) or 0.2

	while self._isPolling do
		task.wait(pollInterval)
		if not self._isPolling then break end

		for matchId, session in pairs(self._activeSessions) do
			if not session or not session.InstanceInfo then continue end
			if self:_getActiveSession(matchId) ~= session then continue end
			local boundaryPart = session.InstanceInfo.VoidBoundaryPart
			if not boundaryPart or not boundaryPart.Parent then continue end

			local roundService = self:_getRoundService()
			local currentState = roundService:GetSessionState(matchId)
			if currentState ~= Constants.RoundState.Playing
				and currentState ~= Constants.RoundState.PointRestartCountdown
				and currentState ~= Constants.RoundState.StartCountdown
				and currentState ~= Constants.RoundState.Ending then
				continue
			end

			-- Criterio de altura: relativa a la geometría del VoidBoundary de esta MatchInstance
			local thresholdY = boundaryPart.Position.Y + (boundaryPart.Size.Y * 0.5)

			local playersToCheck: { Player } = {}
			for _, participant in ipairs(session.Participants) do
				if self:_getParticipant(matchId, participant.Player) == participant then
					table.insert(playersToCheck, participant.Player)
				end
			end

			local now = os.clock()
			for _, player in ipairs(playersToCheck) do
				if not player:IsDescendantOf(Players) then continue end

				-- Descarte rápido si ya está en procesamiento activo por Touched
				local lastTouch = self._processingEliminations[player]
				if lastTouch and (now - lastTouch) < 0.5 then
					continue
				end

				local character = player.Character
				if not character or not character.Parent then continue end
				local hrp = character:FindFirstChild("HumanoidRootPart") :: BasePart?
				if not hrp then continue end

				if hrp.Position.Y <= thresholdY then
					self:_processEliminationEvent(player, session, "VoidBoundaryPolling", boundaryPart)
				end
			end
		end
	end
end

-- ==================================================
-- RESOLUCIÓN DE ELIMINACIONES Y KILLS (Compatibilidad)
-- ==================================================

-- Invocado cuando un jugador es eliminado; resuelve la atribución de Kill de forma segura
function EliminationService:OnPlayerEliminated(victim: Player, reason: string, overrideMatchId: string?): (boolean, Player?)
	-- 1. Validar que la víctima exista y sea Player
	if not isPlayer(victim) then
		return false, nil
	end

	-- 2. Resolver y validar MatchId
	local matchId = overrideMatchId
	local roundService = self:_getRoundService()
	local session: MatchSession? = nil

	if matchId then
		if roundService and type(roundService.GetSessionById) == "function" then
			session = roundService:GetSessionById(matchId)
		end
	else
		if roundService and type(roundService.GetSessionForPlayer) == "function" then
			session = roundService:GetSessionForPlayer(victim)
			if session then
				matchId = session.Id
			end
		end
	end

	if not matchId or not session then
		-- Jugador fuera de partida o match no encontrado
		return false, nil
	end
	if self:_getActiveSession(matchId) ~= session or not self:_getParticipant(matchId, victim) then
		return false, nil
	end

	-- En arquitectura Zero-Death, las eliminaciones autoritativas ocurren exclusivamente via KillPart/VoidBoundary
	local currentState = roundService:GetSessionState(matchId)
	if currentState == Constants.RoundState.Playing or currentState == Constants.RoundState.PointRestartCountdown then
		warn(string.format("[EliminationService] [DIAGNOSTIC] OnPlayerEliminated invocado para '%s' (Razón: %s) en partida Zero-Death. Se descarta scoring o respawn secundario.",
			victim.Name, tostring(reason)))
		return false, nil
	end

	-- 3. Validar que la partida no esté cancelada ni terminada
	if session.Result == "Cancelled" then
		return false, nil
	end

	local currentCharacter=victim.Character
 if currentCharacter and self._transits:Get(session,victim,currentCharacter,currentCharacter:GetAttribute("ArenaPhysicsGeneration") or 0) then return false,nil end

	-- 4. ANTI-DUPLICATE CHECK: Cada eliminación produce exactamente 1 resolución
	local char = victim.Character
	local charId = if char then tostring(char:GetDebugId()) else tostring(victim.UserId)
	local elimKey = string.format("%s_%d_%s", matchId, victim.UserId, charId)

	if self._resolvedEliminations[elimKey] then
		-- Ya fue resuelta para este personaje / ciclo de vida
		return false, nil
	end
	self._resolvedEliminations[elimKey] = true

	-- 5. Resolver el último atacante válido mediante CombatService
	local combatService = self:_getCombatService()
	local killer: Player? = nil

	if combatService and type(combatService.GetLastAttacker) == "function" then
		local attacker, attackerMatchId, _hitTimestamp = combatService:GetLastAttacker(
			victim,
			(Config.Combat and Config.Combat.LastHitLifetime) or 10
		)

		-- 6. Validaciones estrictas sobre el atacante
		if attacker and attacker ~= victim and isPlayer(attacker) and attacker.Parent
			and attackerMatchId == matchId
			and self:_isOpposingParticipant(matchId, attacker, victim) then
			killer = attacker
		end
	end

	-- 7. Limpiar CombatTag de la víctima para no reutilizar impactos previos
	if combatService and type(combatService.ClearCombatTag) == "function" then
		combatService:ClearCombatTag(victim)
	end

	-- 8. Atribución autoritativa de Kill si existe atacante válido
	if killer then
		local playerService = self:_getPlayerService()
		if playerService and type(playerService.AddKill) == "function" then
			playerService:AddKill(killer, 1, "SlapElimination")
		end

		print(string.format("[EliminationService] KILL CONFIRMADA: '%s' eliminó a '%s' en Match '%s' (Razón: %s)",
			killer.Name, victim.Name, matchId, reason or "KillPart"))
	else
		print(string.format("[EliminationService] Eliminación de '%s' en Match '%s' sin atacante válido (Razón: %s)",
			victim.Name, matchId, reason or "Fall/Suicide"))
	end

	-- 9. Emitir registro a través del BindableEvent
	local record: EliminationRecord = {
		Victim = victim,
		Killer = killer,
		MatchId = matchId,
		Timestamp = os.clock(),
		Reason = reason or "Unknown",
		EliminationId = elimKey,
	}
	playerEliminatedBindable:Fire(record)

	return true, killer
end

return EliminationService
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="532">
        <Properties>
          <string name="Name">Gameplay</string>
        </Properties>
        <Item class="ModuleScript" referent="533">
          <Properties>
            <string name="Name">RoundClock</string>
            <string name="Source"><![CDATA[--!strict
-- Pure deadline contract; callers supply monotonic/server network time for isolated tests.
local Clock={}
function Clock.Start(sessionId: string,index: number,duration: number,now: number,networkNow: number): any
 return {Id=sessionId..":Round:"..index,Index=index,Deadline=now+duration,NetworkDeadline=networkNow+duration,Resolved=nil,SuddenDeath=false}
end
function Clock.IsOpen(round: any,now: number): boolean
 return round~=nil and round.Resolved==nil and now<round.Deadline
end
function Clock.Remaining(round: any,now: number): number
 return math.max(0,math.ceil(round.Deadline-now))
end
function Clock.Resolve(round: any,kind: string,now: number): boolean
 if not round or round.Resolved~=nil then return false end
 if kind=="Timeout" then if now<round.Deadline then return false end
 elseif now>=round.Deadline then return false end
 round.Resolved=kind;round.ResolvedAt=now
 return true
end
return Clock
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="534">
          <Properties>
            <string name="Name">SocialPlayEngine</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Disposable server state. No remotes, persistence or client-supplied rosters.
local Engine={};Engine.__index=Engine
function Engine.new(config,deps)
 return setmetatable({C=config,D=deps,Groups={},Membership={},Pending={},Busy={},LastInvite={},Grants={}},Engine)
end
function Engine:Group(id)return self.Groups[self.Membership[id]]end
function Engine:GroupView(id)
 local g=self:Group(id);if not g then return nil end
 local members={};for _,v in ipairs(g.Members)do table.insert(members,{UserId=v,DisplayName=self.D.Name(v)})end
 return {Id=g.Id,Leader=g.Leader,Members=members,Revision=g.Revision}
end
function Engine:_publish(g)
 for _,id in ipairs(g.Members)do self.Membership[id]=g.Id;self.D.GroupChanged(id,g.Id);self.D.Emit(id,'Group',self:GroupView(id))end
end
function Engine:_finish(request,reason)
 if self.Pending[request.Id]~=request then return end
 self.Pending[request.Id]=nil
 for _,id in ipairs({request.From,request.To})do
  if self.Busy[id]==request.Id then self.Busy[id]=nil end
  self.D.Emit(id,'RequestClosed',{Id=request.Id,Reason=reason})
 end
end
function Engine:_available(id)
 return self.D.Eligible(id) and not self.Busy[id]
end
function Engine:_groupFree(g)
 for _,id in ipairs(g.Members)do if not self.D.Eligible(id)then return false end end
 return true
end
function Engine:CanChallenge(a,b)
 return a~=b and not self:Group(a)and not self:Group(b)and self:_available(a)and self:_available(b)
end
function Engine:Invite(from,to,kind)
 if kind~='Duel'and kind~='Group'then return false,'InvalidKind'end
 if from==to or not self:_available(from)or not self:_available(to)then return false,'PlayerUnavailable'end
 if not self.D.Near(from,to)then return false,'OutOfRange'end
 local group=self:Group(from)
 if kind=='Duel'then
  if group or self:Group(to)then return false,'InGroup'end
 else
  if self:Group(to)then return false,'AlreadyGrouped'end
  if group and (group.Leader~=from or #group.Members>=self.C.MaxGroupSize or not self:_groupFree(group))then return false,'GroupUnavailable'end
 end
 local now=self.D.Clock()
 if now-(self.LastInvite[from]or -math.huge)<self.C.InviteCooldown then return false,'InviteCooldown'end
 local req={Id=self.D.Id(),Kind=kind,From=from,To=to,ExpiresAt=now+self.C.RequestLifetime,GroupId=group and group.Id,Revision=group and group.Revision}
 self.LastInvite[from]=now;self.Pending[req.Id]=req;self.Busy[from]=req.Id;self.Busy[to]=req.Id
 for _,id in ipairs({from,to})do self.D.Emit(id,'Request',{Id=req.Id,Kind=kind,From=from,To=to,FromName=self.D.Name(from),ToName=self.D.Name(to),ExpiresAt=req.ExpiresAt})end
 return true,req.Id
end
function Engine:Respond(id,key,accept)
 local req=self.Pending[key]
 if not req or req.To~=id or type(accept)~='boolean'then return false,'InvalidRequest'end
 if self.D.Clock()>=req.ExpiresAt then self:_finish(req,'Expired');return false,'Expired'end
 if not accept then self:_finish(req,'Declined');return true end
 if not self.D.Eligible(req.From)or not self.D.Eligible(req.To)then self:_finish(req,'PlayerUnavailable');return false,'PlayerUnavailable'end
 if req.Kind=='Duel'then
  if self:Group(req.From)or self:Group(req.To)then self:_finish(req,'InGroup');return false,'InGroup'end
  local grant={ZoneId='Duel:'..req.Id,Token=self.D.Id(),A=req.From,B=req.To,ExpiresAt=self.D.Clock()+self.C.DuelReservationLifetime,Consumed=false}
  self:_finish(req,'Accepted');self.Grants[grant.ZoneId]=grant
  local ok,started,why=pcall(self.D.StartDuel,grant)
  if not ok or not started then
   self.Grants[grant.ZoneId]=nil
   for _,uid in ipairs({grant.A,grant.B})do self.D.Emit(uid,'Notice',{Reason=ok and why or 'DuelStartFailed'})end
   return false,ok and why or 'DuelStartFailed'
  end
 else
  local group=self:Group(req.From)
  if self:Group(req.To)or (group and (group.Leader~=req.From or group.Id~=req.GroupId or group.Revision~=req.Revision or #group.Members>=self.C.MaxGroupSize or not self:_groupFree(group)))or (not group and req.GroupId)then
   self:_finish(req,'GroupChanged');return false,'GroupChanged'
  end
  if not group then group={Id=self.D.Id(),Leader=req.From,Members={req.From},Revision=0};self.Groups[group.Id]=group end
  self:_finish(req,'Accepted');table.insert(group.Members,req.To);group.Revision+=1;self:_publish(group)
 end
 return true
end
function Engine:Leave(id,disband,force)
 local group=self:Group(id);if not group then return false,'NotGrouped'end
 if not force and not self:_groupFree(group)then return false,'GroupBusy'end
 if disband and group.Leader~=id then return false,'NotLeader'end
 local old=table.clone(group.Members)
 if disband then table.clear(group.Members)else table.remove(group.Members,table.find(group.Members,id))end
 self.Membership[id]=nil;self.D.GroupChanged(id,nil);self.D.Emit(id,'Group',nil)
 if #group.Members<2 then
  self.Groups[group.Id]=nil
  for _,member in ipairs(old)do self.Membership[member]=nil;self.D.GroupChanged(member,nil);self.D.Emit(member,'Group',nil)end
 else
  if group.Leader==id then group.Leader=group.Members[1]end
  group.Revision+=1;self:_publish(group)
 end
 return true
end
function Engine:CanQueueTeam(players,teamSize)
 local present={};for _,p in ipairs(players)do present[p.UserId]=true end
 for _,p in ipairs(players)do local g=self:Group(p.UserId)
  if g then
   if #g.Members>teamSize then return false,'GroupTooLarge'end
   for _,id in ipairs(g.Members)do if not present[id]then return false,'IncompleteGroup'end end
  end
 end
 return true
end
function Engine:Tick()
 for _,req in pairs(self.Pending)do
  if self.D.Clock()>=req.ExpiresAt or not self.D.Eligible(req.From)or not self.D.Eligible(req.To)then self:_finish(req,'ExpiredOrUnavailable')end
 end
 for zone,g in pairs(self.Grants)do if self.D.Clock()>=g.ExpiresAt then self.Grants[zone]=nil end end
end
function Engine:Disconnect(id)
 local req=self.Pending[self.Busy[id]];if req then self:_finish(req,'Disconnected')end
 self:Leave(id,false,true);self.LastInvite[id]=nil
 for zone,g in pairs(self.Grants)do if g.A==id or g.B==id then self.Grants[zone]=nil end end
end
return Engine
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="535">
          <Properties>
            <string name="Name">WinStreak</string>
            <string name="Source"><![CDATA[--!strict
-- Permanent blocks earned, plus only the unfinished consecutive-win block.
local Config=require(game:GetService('ReplicatedStorage').Shared.SocialPlayConfig)
local Streak={}
function Streak.Normalize(value: any): { [string]: any }
 local v=if type(value)=='table' then value else {}
 local function integer(n: any): number
  return if type(n)=='number' and n==n and n>=0 and n<9007199254740991 then math.floor(n) else 0
 end
 return {Total=integer(v.Total),Progress=integer(v.Progress)%Config.WinBlockSize,
  LastMatchId=if type(v.LastMatchId)=='string' and #v.LastMatchId<=128 then v.LastMatchId else nil}
end
function Streak.Apply(data: any,matchId: string,outcome: string): boolean
 if type(matchId)~='string' or #matchId==0 or #matchId>128 then return false end
 if outcome~='Win' and outcome~='Loss' and outcome~='Draw' then return false end
 local stats=Streak.Normalize(data.WinStreak)
 if stats.LastMatchId==matchId then return false end
 stats.LastMatchId=matchId
 if outcome=='Win' then
  stats.Progress+=1
  if stats.Progress==Config.WinBlockSize then stats.Total+=1;stats.Progress=0 end
 else stats.Progress=0 end
 data.WinStreak=stats
 return true
end
return Streak
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="536">
        <Properties>
          <string name="Name">KnockbackService</string>
          <string name="Source"><![CDATA[--!strict
-- KnockbackService
-- En fases posteriores manejara la fisica de los impactos.
-- En esta fase NO se implementa knockback.

local KnockbackService = {}

KnockbackService.Name = "KnockbackService"

function KnockbackService:Init(context)
end

function KnockbackService:Start(context)
end

return KnockbackService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="537">
        <Properties>
          <string name="Name">MatchInstanceService</string>
          <string name="Source"><![CDATA[--!strict
-- MatchInstanceService
-- Servicio encargado exclusivamente de crear, administrar y destruir las instancias fisicas de las partidas.
-- Asigna ArenaSlots fisicamente aislados para que los jugadores de distintas partidas no puedan verse ni interactuar.

local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

local Config = require(ReplicatedStorage.Shared.Config)
local Types = require(ReplicatedStorage.Shared.Types)

type MatchSession = Types.MatchSession
type MatchInstanceInfo = Types.MatchInstanceInfo

local MatchInstanceService = {}
MatchInstanceService.Name = "MatchInstanceService"

MatchInstanceService._context = nil
MatchInstanceService._activeMatchesFolder = nil :: Folder?
MatchInstanceService._allocatedSlots = {} :: { [number]: string } -- ArenaSlot -> MatchId
MatchInstanceService._instances = {} :: { [string]: MatchInstanceInfo } -- MatchId -> MatchInstanceInfo

local TEAM_NAMES: { "Red" | "Blue" } = { "Red", "Blue" }

local SpawnResolver = require(script.Parent.TeamSpawnResolver)
local function resolveTeamSpawns(map: Instance)
 return SpawnResolver.Resolve(map, 1)
end

function MatchInstanceService:Init(context)
	self._context = context
	self._allocatedSlots = {}
	self._instances = {}
	self._previewScenes = {}

	-- Localizar o crear de forma segura Workspace.ActiveMatches
	local activeMatches = workspace:FindFirstChild("ActiveMatches")
	if not activeMatches then
		activeMatches = Instance.new("Folder")
		activeMatches.Name = "ActiveMatches"
		activeMatches.Parent = workspace
	end
	self._activeMatchesFolder = activeMatches :: Folder
end

function MatchInstanceService:Start(context)
	if RunService:IsStudio() then
		local match = ReplicatedStorage.Remotes.Match
		local remote = match:FindFirstChild("EndCinematicPreview") or Instance.new("RemoteFunction")
		remote.Name = "EndCinematicPreview"
		remote.Parent = match
		remote.OnServerInvoke = function(player, action, name)
			if not RunService:IsStudio() or player.Parent ~= Players then return nil end
			if action == "Release" then
				local record = self._previewScenes[player]
				if record and type(name) == "string" and record.Scene.Name == name then self:ReleaseCinematicPreview(player) end
				return true
			end
			if action ~= "Prepare" then return nil end
			return self:PrepareCinematicPreview(player)
		end
		Players.PlayerRemoving:Connect(function(player) self:ReleaseCinematicPreview(player) end)
	end
	print("[MatchInstanceService] Servicio iniciado y listo para gestionar instancias de partida")
end

function MatchInstanceService:GetSlotOrigin(slot: number): Vector3
	local baseOrigin = (Config.Arena and Config.Arena.BaseOrigin) or Vector3.new(10000, 500, 0)
	local spacing = (Config.Arena and Config.Arena.Spacing) or Vector3.new(10000, 0, 0)
	return baseOrigin + spacing * slot
end

function MatchInstanceService:_allocateSlot(matchId: string): number?
	local maxSlots = (Config.Arena and Config.Arena.MaxSlots) or 100

	-- Buscar el menor ArenaSlot disponible (garantiza reutilización de slots liberados)
	for slot = 0, maxSlots - 1 do
		if self._allocatedSlots[slot] == nil then
			self._allocatedSlots[slot] = matchId
			return slot
		end
	end

	warn(string.format("[MatchInstanceService] No hay ArenaSlots disponibles (Capacidad: %d)", maxSlots))
	return nil
end

function MatchInstanceService:_releaseSlot(slot: number, expectedMatchId: string?): boolean
	if expectedMatchId and self._allocatedSlots[slot] ~= expectedMatchId then
		return false
	end
	self._allocatedSlots[slot] = nil
	return true
end

function MatchInstanceService:_validateMapTemplate(mapName: string, requiredTeamSize: number?): (boolean, string?, Model?)
	local mapsFolder = ServerStorage:FindFirstChild("Maps")
	if not mapsFolder then
		return false, "ServerStorage.Maps no existe", nil
	end

	local mapTemplate = mapsFolder:FindFirstChild(mapName)
	if not mapTemplate then
		return false, string.format("Mapa '%s' no encontrado en ServerStorage.Maps", mapName), nil
	end

	if not mapTemplate:IsA("Model") then
		return false, string.format("Mapa '%s' no es un Model (es %s)", mapName, mapTemplate.ClassName), nil
	end

	local geometry = mapTemplate:FindFirstChild("Geometry")
	if not geometry then
		return false, string.format("Mapa '%s' no contiene 'Geometry'", mapName), nil
	end

	local teamSpawns, capacity, spawnError = SpawnResolver.Resolve(mapTemplate, requiredTeamSize or 1)
	if not teamSpawns then
		return false, string.format("Mapa '%s': %s", mapName, tostring(spawnError)), nil
	end

	local zoneWin = mapTemplate:FindFirstChild("ZoneWin")
	if not zoneWin then
		return false, string.format("Mapa '%s' no contiene 'ZoneWin'", mapName), nil
	end

	local redWin = zoneWin:FindFirstChild("RedWin")
	if not redWin or not redWin:IsA("BasePart") then
		return false, string.format("Mapa '%s' no contiene 'ZoneWin.RedWin' valido (debe ser BasePart)", mapName), nil
	end

	local blueWin = zoneWin:FindFirstChild("BlueWin")
	if not blueWin or not blueWin:IsA("BasePart") then
		return false, string.format("Mapa '%s' no contiene 'ZoneWin.BlueWin' valido (debe ser BasePart)", mapName), nil
	end

	return true, nil, mapTemplate :: Model
end

function MatchInstanceService:CreateInstance(matchSession: MatchSession, mapName: string): MatchInstanceInfo?
	if not matchSession or type(matchSession.Id) ~= "string" or matchSession.Id == "" then
		warn("[MatchInstanceService] MatchSession invalida o sin ID")
		return nil
	end

	local matchId = matchSession.Id

	-- Evitar duplicados para una misma partida activa
	if self._instances[matchId] ~= nil then
		warn(string.format("[MatchInstanceService] La partida '%s' ya posee una instancia activa", matchId))
		return self._instances[matchId]
	end

	-- 1. Validar contrato de mapa
	local isValid, errReason, mapTemplate = self:_validateMapTemplate(mapName, matchSession.TeamSize or 1)
	if not isValid or not mapTemplate then
		warn(string.format("[MatchInstanceService] Error al validar mapa: %s", tostring(errReason)))
		return nil
	end

	-- 2. Reservar ArenaSlot libre
	local slot = self:_allocateSlot(matchId)
	if slot == nil then
		return nil
	end

	local origin = self:GetSlotOrigin(slot)

	-- 3. Clonar el mapa
	local clonedMap = mapTemplate:Clone()
	local arenaTransform = CFrame.new(origin) * mapTemplate:GetPivot():Inverse()

	-- 4. Crear contenedor de partida en Workspace.ActiveMatches
	if not self._activeMatchesFolder or not self._activeMatchesFolder.Parent then
		local activeMatches = workspace:FindFirstChild("ActiveMatches")
		if not activeMatches then
			activeMatches = Instance.new("Folder")
			activeMatches.Name = "ActiveMatches"
			activeMatches.Parent = workspace
		end
		self._activeMatchesFolder = activeMatches :: Folder
	end

	local container = Instance.new("Folder")
	container.Name = "Match_" .. matchId
	container:SetAttribute("SessionId", matchId)
	container.Parent = self._activeMatchesFolder

	-- 5. Posicionar el mapa completo mediante PivotTo en el origen del ArenaSlot
	clonedMap:PivotTo(CFrame.new(origin))
	clonedMap.Parent = container

	-- Extraer referencias cacheadas de las partes del contrato
	local geometry = clonedMap:FindFirstChild("Geometry") :: Instance
	local teamSpawns, teamCapacity = resolveTeamSpawns(clonedMap)
	local redSpawn = teamSpawns.Red[1]
	local blueSpawn = teamSpawns.Blue[1]
	local zoneWin = clonedMap:FindFirstChild("ZoneWin") :: Instance
	local redWin = zoneWin and zoneWin:FindFirstChild("RedWin") :: BasePart
	local blueWin = zoneWin and zoneWin:FindFirstChild("BlueWin") :: BasePart

	-- Extraer referencias a KillParts si existen en el mapa
	local killParts: { BasePart } = {}
	for _, desc in ipairs(clonedMap:GetDescendants()) do
		if desc:IsA("BasePart") and desc.Name == "KillPart" then
			table.insert(killParts, desc)
		end
	end

	-- Crear VoidBoundaryPart exclusivo para esta MatchInstance
	local voidBoundarySize = (Config.Arena and Config.Arena.VoidBoundarySize) or Vector3.new(500, 4, 500)
	local voidBoundaryOffset = (Config.Arena and Config.Arena.VoidBoundaryOffset) or Vector3.new(0, -50, 0)
	local voidBoundaryPosition = origin + voidBoundaryOffset

	local voidBoundaryPart = Instance.new("Part")
	voidBoundaryPart.Name = "VoidBoundaryPart"
	voidBoundaryPart.Size = voidBoundarySize
	voidBoundaryPart.CFrame = CFrame.new(voidBoundaryPosition)
	voidBoundaryPart.Anchored = true
	voidBoundaryPart.CanCollide = false
	voidBoundaryPart.CanTouch = true
	voidBoundaryPart.CanQuery = false
	voidBoundaryPart.Transparency = 1
	voidBoundaryPart.Parent = container

	local instanceInfo: MatchInstanceInfo = {
		MatchId = matchId,
		MapName = mapName,
		ArenaSlot = slot,
		Origin = origin,
		InstanceModel = clonedMap,
		Container = container,
		Geometry = geometry,
		RedSpawn = redSpawn,
		BlueSpawn = blueSpawn,
		TeamSpawns = teamSpawns,
		TeamCapacity = teamCapacity,
		ZoneWin = zoneWin,
		RedWin = redWin,
		BlueWin = blueWin,
		KillParts = killParts,
		VoidBoundaryPart = voidBoundaryPart,
		ArenaTransform = arenaTransform,
	}

	self._instances[matchId] = instanceInfo
	local ok, cinematicError = pcall(function()
		self:PrepareEndCinematic(matchId)
	end)
	if not ok or not instanceInfo.EndCinematic then
		warn("[MatchInstanceService] EndCinematic unavailable: " .. tostring(cinematicError))
		self:DestroyInstance(matchId)
		return nil
	end

	print(string.format("[MatchInstanceService] Instancia creada: Match '%s' -> Mapa '%s' en ArenaSlot %d (%s)",
		matchId, mapName, slot, tostring(origin)))

	return instanceInfo
end

function MatchInstanceService:GetInstance(matchId: string): MatchInstanceInfo?
	return self._instances[matchId]
end

-- Uses exactly the map's original-pivot -> arena transform, not a cinematic pivot.
function MatchInstanceService:_populateCinematicScene(scene: Model, delta: CFrame)
	local folder = ServerStorage:FindFirstChild("EndGames-Scenario")
	local template = folder and folder:FindFirstChild("ScenarioFinal")
	assert(template and template:IsA("Model"), "ServerStorage.EndGames-Scenario.ScenarioFinal missing")
	for _, child in ipairs(template:GetChildren()) do child:Clone().Parent = scene end
	for _, object in ipairs(scene:GetDescendants()) do
		if object:IsA("LuaSourceContainer") then object:Destroy()
		elseif object:IsA("BasePart") then
			object.CFrame = delta * object.CFrame
			object.Anchored = true
			object.CanCollide = false
			object.CanTouch = false
			object.CanQuery = false
			elseif object:IsA("BillboardGui") and object.Parent and object.Parent.Name == "BillboardAnchor" then
				-- Only the authorized client enables its scene's results UI.
				object.Enabled = false
			elseif object:IsA("ParticleEmitter") then object.Enabled = false
		elseif object:IsA("Sound") then object:Stop() end
	end
	scene.WorldPivot = delta * template:GetPivot()
	local cameras = assert(scene:FindFirstChild("TransCamera"), "CinematicCamerasMissing")
	for _, name in ipairs({ "CameraCheck-v1", "CameraCheck-v2", "CameraCheck-Only1V1" }) do
		local part = cameras:FindFirstChild(name)
		assert(part and part:IsA("BasePart"), "CinematicCameraMissing:" .. name)
	end
	local slots = assert(scene:FindFirstChild("Players"), "CinematicSlotsMissing")
	for index = 1, 5 do
		local slot = slots:FindFirstChild("SlotPlayer_" .. index)
		assert(slot and slot:IsA("BasePart"), "CinematicSlotMissing:" .. index)
	end
end

function MatchInstanceService:PrepareEndCinematic(matchId: string): Model?
	local info = self._instances[matchId]
	if not info then return nil end
	if info.EndCinematic and info.EndCinematic.Parent == info.Container then return info.EndCinematic end
	local scene = Instance.new("Model")
	scene.Name = "ScenarioFinal"
	scene:SetAttribute("SessionId", matchId)
	scene:SetAttribute("ArenaSlot", info.ArenaSlot)
	scene.ModelStreamingMode = Enum.ModelStreamingMode.PersistentPerPlayer
	-- Register first so the existing rollback owns partial clones too.
	info.EndCinematic = scene
	self:_populateCinematicScene(scene, info.ArenaTransform :: CFrame)
	scene.Parent = info.Container
	return scene
end

function MatchInstanceService:ReleaseCinematicPreview(player: Player, expected: Model?)
	local record = self._previewScenes and self._previewScenes[player]
	if not record or (expected and record.Scene ~= expected) then return end
	self._previewScenes[player] = nil
	if record.Connection then record.Connection:Disconnect() end
	if record.Timer and record.Timer ~= coroutine.running() then pcall(task.cancel, record.Timer) end
	record.Scene:Destroy()
	local folder = workspace:FindFirstChild("EndCinematicPreviews")
	if folder and #folder:GetChildren() == 0 then folder:Destroy() end
end

function MatchInstanceService:PrepareCinematicPreview(player: Player): any
	if not RunService:IsStudio() or player.Parent ~= Players then return nil end
	local config = require(ReplicatedStorage.Shared.EndCinematicConfig)
	local rounds = self._context and self._context:GetService("RoundService")
	if not config.Preview.Enabled or player:GetAttribute("MatchId") ~= nil
		or (rounds and rounds:GetSessionForPlayer(player)) then return nil end
	self:ReleaseCinematicPreview(player)
	local folder = workspace:FindFirstChild("EndCinematicPreviews")
	if not folder then folder = Instance.new("Folder"); folder.Name = "EndCinematicPreviews"; folder.Parent = workspace end
	local scene = Instance.new("Model")
	scene.Name = "Preview_" .. player.UserId .. "_" .. game:GetService("HttpService"):GenerateGUID(false)
	scene.ModelStreamingMode = Enum.ModelStreamingMode.PersistentPerPlayer
	scene:SetAttribute("PreviewOwnerUserId", player.UserId)
	local ok, failure = pcall(function() self:_populateCinematicScene(scene, CFrame.identity) end)
	if not ok then scene:Destroy(); if #folder:GetChildren() == 0 then folder:Destroy() end; warn(failure); return nil end
	scene.Parent = folder
	local record = { Scene = scene }
	self._previewScenes[player] = record
	local persistentOk = pcall(function() scene:AddPersistentPlayer(player) end)
	if not persistentOk then self:ReleaseCinematicPreview(player); return nil end
	record.Connection = player:GetAttributeChangedSignal("MatchId"):Connect(function()
		if player:GetAttribute("MatchId") ~= nil then self:ReleaseCinematicPreview(player, scene) end
	end)
	record.Timer = task.delay(90, function() self:ReleaseCinematicPreview(player, scene) end)
	return { Name = scene.Name, Origin = scene:GetPivot().Position }
end

function MatchInstanceService:GetSpawnPoints(matchId: string): (BasePart?, BasePart?)
	local info = self._instances[matchId]
	if info then
		return info.TeamSpawns.Red[1], info.TeamSpawns.Blue[1]
	end
	return nil, nil
end

function MatchInstanceService:GetSpawnPoint(matchId: string, team: "Red" | "Blue", slot: number): BasePart?
	local info = self._instances[matchId]
	if not info or (team ~= "Red" and team ~= "Blue") or slot < 1 then return nil end
	return info.TeamSpawns[team][slot]
end

function MatchInstanceService:GetMapCapacity(mapName: string): number
	local ok, _, template = self:_validateMapTemplate(mapName, 1)
	if not ok or not template then return 0 end
	local _, capacity = resolveTeamSpawns(template)
	return capacity
end

function MatchInstanceService:IsMapCompatible(mapName: string, teamSize: number): (boolean, string?)
	local ok, reason = self:_validateMapTemplate(mapName, teamSize)
	self._mapValidationWarnings = self._mapValidationWarnings or {}
	local key = tostring(teamSize) .. ":" .. mapName
	if not ok and self._mapValidationWarnings[key] ~= reason then
		self._mapValidationWarnings[key] = reason
		warn(string.format("[MatchInstanceService] Mapa incompatible para %dv%d: %s", teamSize, teamSize, tostring(reason)))
	elseif ok then
		self._mapValidationWarnings[key] = nil
	end
	return ok, reason
end

function MatchInstanceService:GetZoneWin(matchId: string): (BasePart?, BasePart?)
	local info = self._instances[matchId]
	if info then
		return info.RedWin, info.BlueWin
	end
	return nil, nil
end

function MatchInstanceService:DestroyInstance(matchId: string): boolean
	local info = self._instances[matchId]
	if not info then
		-- Recuperación idempotente: elimina solamente recursos que aún pertenezcan
		-- al SessionId solicitado. Nunca libera un slot reasignado a otra sesión.
		if self._activeMatchesFolder then
			local orphan = self._activeMatchesFolder:FindFirstChild("Match_" .. matchId)
			if orphan then
				orphan:Destroy()
			end
		end
		for slot, ownerId in pairs(self._allocatedSlots) do
			if ownerId == matchId then
				self:_releaseSlot(slot, matchId)
			end
		end
		return true
	end

	-- Destruir contenedor y modelo clonado
	if info.EndCinematic then info.EndCinematic:Destroy() end
	if info.Container and info.Container.Parent then
		info.Container:Destroy()
	end

	-- Liberar ArenaSlot
	if not self:_releaseSlot(info.ArenaSlot, matchId) then
		warn(string.format("[MatchInstanceService] ArenaSlot %d ya no pertenece a Match '%s'", info.ArenaSlot, matchId))
		return false
	end

	-- Limpiar registro
	self._instances[matchId] = nil

	print(string.format("[MatchInstanceService] Instancia destruida: Match '%s', ArenaSlot %d liberado",
		matchId, info.ArenaSlot))

	return true
end

function MatchInstanceService:GetAllocatedSlots(): { [number]: string }
	return self._allocatedSlots
end

return MatchInstanceService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="538">
        <Properties>
          <string name="Name">MatchmakingFeedbackService</string>
          <string name="Source"><![CDATA[--!strict
-- MatchmakingFeedbackService
-- Responsable exclusivo del feedback audiovisual (SFX espaciales, partículas, beams y cambios de material)
-- en las plataformas de matchmaking según las directrices de GAME_SDD.md.
-- NO gestiona la lógica de emparejamiento, detección ni colas (responsabilidad de MatchmakingService).
-- La instancia física (zoneFolder) es la identidad primaria para separar estados y recursos audiovisuales.

local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local MatchmakingFeedbackService = {}
MatchmakingFeedbackService.Name = "MatchmakingFeedbackService"

local function ensureRemoteFolder(parent: Instance, name: string): Folder
	local folder = parent:FindFirstChild(name)
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = name
		folder.Parent = parent
	end
	return folder :: Folder
end

local function ensureRemoteEvent(parent: Instance, name: string): RemoteEvent
	local event = parent:FindFirstChild(name)
	if not event then
		event = Instance.new("RemoteEvent")
		event.Name = name
		event.Parent = parent
	end
	return event :: RemoteEvent
end

-- Configuración de presentación audiovisual
local EFFECT_VERTICAL_OFFSET = Vector3.new(0, 4, 0)
local OCCUPIED_MATERIAL = Enum.Material.Neon

export type TeamEffectAssets = {
	effectsFolder: Instance,
	soundJoin: Sound?,
	soundJoinMusic: Sound?,
	soundLeave: Sound?,
	activateTemplate: Part?,
	beamTemplates: { Part },
}

export type ZoneFeedbackState = {
	ZoneFolder: Folder,
	EffectsFolder: Folder?,
	Pads: { [string]: BasePart }, -- teamName ("Red", "Blue") -> BasePart
	OriginalMaterials: { [string]: Enum.Material },
	TeamEffects: { [string]: TeamEffectAssets },
	ActiveClones: { [string]: Part },
	ActiveBeamClones: { [string]: { Part } },
	ActiveMusicClones: { [string]: Sound },
	PadOccupied: { [string]: boolean },
	Occupants: { [string]: Player? },
}

MatchmakingFeedbackService._context = nil :: any
MatchmakingFeedbackService._zones = {} :: { [Folder]: ZoneFeedbackState }

-- Descubre y actualiza dinámicamente todos los ParticleEmitter descendientes
local function setEmittersEnabled(instance: Instance, enabled: boolean)
	for _, desc in ipairs(instance:GetDescendants()) do
		if desc:IsA("ParticleEmitter") then
			desc.Enabled = enabled
		end
	end
	if instance:IsA("ParticleEmitter") then
		instance.Enabled = enabled
	end
end

-- Descubre y actualiza dinámicamente todos los Beams descendientes
local function setBeamsEnabled(instance: Instance, enabled: boolean)
	for _, desc in ipairs(instance:GetDescendants()) do
		if desc:IsA("Beam") then
			desc.Enabled = enabled
		end
	end
	if instance:IsA("Beam") then
		instance.Enabled = enabled
	end
end

-- Carga y configura los templates de efectos de un contenedor dado (carpeta de equipo o carpeta raíz)
local function loadTeamEffects(folder: Instance): TeamEffectAssets
	local soundJoin = folder:FindFirstChild("SoundJoin")
	local soundJoinMusic = folder:FindFirstChild("SoundJoinMusic")
	local soundLeave = folder:FindFirstChild("SoundLeave")
	local activateTemplate = folder:FindFirstChild("ActivateParticle")

	if activateTemplate and activateTemplate:IsA("BasePart") then
		activateTemplate.Anchored = true
		activateTemplate.CanCollide = false
		setEmittersEnabled(activateTemplate, false)
	end

	local beamTemplates: { Part } = {}
	for _, child in ipairs(folder:GetChildren()) do
		if child:IsA("BasePart") and child ~= activateTemplate then
			local hasBeam = child:FindFirstChildOfClass("Beam") ~= nil
			if not hasBeam then
				for _, d in ipairs(child:GetDescendants()) do
					if d:IsA("Beam") then
						hasBeam = true
						break
					end
				end
			end

			if hasBeam then
				table.insert(beamTemplates, child :: Part)
				setBeamsEnabled(child, false)
			end
		end
	end

	return {
		effectsFolder = folder,
		soundJoin = (soundJoin and soundJoin:IsA("Sound")) and soundJoin or nil,
		soundJoinMusic = (soundJoinMusic and soundJoinMusic:IsA("Sound")) and soundJoinMusic or nil,
		soundLeave = (soundLeave and soundLeave:IsA("Sound")) and soundLeave or nil,
		activateTemplate = (activateTemplate and activateTemplate:IsA("Part")) and (activateTemplate :: Part) or nil,
		beamTemplates = beamTemplates,
	}
end

-- Limpia instancias temporales residuales en una carpeta
local function cleanupResidualInstances(container: Instance)
	for _, child in ipairs(container:GetChildren()) do
		if child.Name:find("ParticleInstance_") or child.Name:find("BeamInstance_") or child.Name:find("SpatialSound_") or child.Name:find("SpatialMusic_") then
			child:Destroy()
		end
	end
end

-- Reproduce un sonido espacializado en la posición de un BasePart (escuchado por todos los jugadores cercanos)
function MatchmakingFeedbackService:_playSpatialSound(soundTemplate: Sound?, targetPart: BasePart?)
	if not soundTemplate then return end

	if not targetPart then
		soundTemplate:Play()
		return
	end

	-- Clonar el sonido en el pad correspondiente para obtener audio 3D posicional nativo con sus propiedades de Studio
	local spatialClone = soundTemplate:Clone()
	spatialClone.Name = "SpatialSound_" .. soundTemplate.Name
	spatialClone.PlayOnRemove = false
	spatialClone.Parent = targetPart

	local cleanupConnection: RBXScriptConnection?
	cleanupConnection = spatialClone.Ended:Connect(function()
		if cleanupConnection then
			cleanupConnection:Disconnect()
		end
		spatialClone:Destroy()
	end)

	-- Timeout de seguridad para evitar fugas de instancias si el sonido se interrumpe
	task.delay(math.max(spatialClone.TimeLength + 1, 4), function()
		if spatialClone and spatialClone.Parent then
			spatialClone:Destroy()
		end
	end)

	spatialClone:Play()
end

function MatchmakingFeedbackService:_ensureRemotes()
	local remotesFolder = ensureRemoteFolder(ReplicatedStorage, "Remotes")
	local mmFolder = ensureRemoteFolder(remotesFolder, "Matchmaking")
	ensureRemoteEvent(mmFolder, "PadMusic")
end

function MatchmakingFeedbackService:_getRemote(eventName: string): RemoteEvent?
	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	local mmFolder = remotes and remotes:FindFirstChild("Matchmaking")
	local event = mmFolder and mmFolder:FindFirstChild(eventName)
	if event and event:IsA("RemoteEvent") then
		return event
	end
	return nil
end

function MatchmakingFeedbackService:Init(context)
	self._context = context
	self._zones = {}
	self:_ensureRemotes()

	-- Descubrir y registrar todas las zonas físicas existentes en Workspace.ZoneMatchmaking
	local zoneContainer = Workspace:FindFirstChild("ZoneMatchmaking")
	if not zoneContainer then
		warn("[MatchmakingFeedbackService] No se encontro Workspace.ZoneMatchmaking")
		return
	end

	for _, child in ipairs(zoneContainer:GetChildren()) do
		if child:IsA("Folder") then
			self:RegisterZone(child)
		end
	end
end

function MatchmakingFeedbackService:Start(context)
	self._context = context
	print("[MatchmakingFeedbackService] Servicio audiovisual de matchmaking iniciado y listo para múltiples zonas")
end

-- Registra una zona física específica y sus assets independientes
function MatchmakingFeedbackService:RegisterZone(zoneFolder: Folder)
	if not zoneFolder or not zoneFolder:IsA("Folder") then return end
	if self._zones[zoneFolder] then return end

	local pads: { [string]: BasePart } = {}
	local originalMaterials: { [string]: Enum.Material } = {}
	local padOccupied: { [string]: boolean } = {}

	local joinsFolder = zoneFolder:FindFirstChild("joins-parts")
	if joinsFolder then
		for _, padChild in ipairs(joinsFolder:GetChildren()) do
			if padChild:IsA("BasePart") then
				local teamAttr = padChild:GetAttribute("Team")
				local teamName = if typeof(teamAttr) == "string" and teamAttr ~= ""
					then teamAttr
					elseif padChild.Name == "Red" or padChild.Name:find("Red") then "Red"
					elseif padChild.Name == "Blue" or padChild.Name:find("Blue") then "Blue"
					else padChild.Name

				pads[teamName] = padChild
				originalMaterials[teamName] = padChild.Material
				padOccupied[teamName] = false

				-- Limpieza de sonidos residuales en el pad
				for _, c in ipairs(padChild:GetChildren()) do
					if c.Name:find("SpatialSound_") or c.Name:find("SpatialMusic_") then
						c:Destroy()
					end
				end
			end
		end
	else
		warn(string.format("[MatchmakingFeedbackService] Carpeta 'joins-parts' no encontrada en zona '%s'", zoneFolder.Name))
	end

	local teamEffects: { [string]: TeamEffectAssets } = {}
	local effectsFolder = zoneFolder:FindFirstChild("effects") :: Folder?

	if effectsFolder and (effectsFolder:IsA("Folder") or effectsFolder:IsA("Model")) then
		cleanupResidualInstances(effectsFolder)

		for teamName, _ in pairs(pads) do
			local teamFolder = effectsFolder:FindFirstChild(teamName)
			if teamFolder and (teamFolder:IsA("Folder") or teamFolder:IsA("Model")) then
				cleanupResidualInstances(teamFolder)
				teamEffects[teamName] = loadTeamEffects(teamFolder)
			else
				teamEffects[teamName] = loadTeamEffects(effectsFolder)
			end
		end
	end

	local zoneFeedbackState: ZoneFeedbackState = {
		ZoneFolder = zoneFolder,
		EffectsFolder = effectsFolder,
		Pads = pads,
		OriginalMaterials = originalMaterials,
		TeamEffects = teamEffects,
		ActiveClones = {},
		ActiveBeamClones = {},
		ActiveMusicClones = {},
		PadOccupied = padOccupied,
		Occupants = {},
	}

	self._zones[zoneFolder] = zoneFeedbackState
	print(string.format("[MatchmakingFeedbackService] Zona registrada para feedback: '%s'", zoneFolder.Name))
end

-- Desregistra una zona física y realiza cleanup completo de sus recursos
function MatchmakingFeedbackService:UnregisterZone(zoneFolder: Folder)
	local zoneState = self._zones[zoneFolder]
	if not zoneState then return end

	-- Desactivar y limpiar feedback de todos los pads de esta zona
	for teamName, isOccupied in pairs(zoneState.PadOccupied) do
		if isOccupied then
			zoneState.PadOccupied[teamName] = false
			self:_deactivateZoneFeedback(zoneState, teamName)
		end
	end

	-- Limpiar ocupantes registrados
	zoneState.Occupants = {}

	-- Detener y destruir música activa remanente
	for teamName, musicClone in pairs(zoneState.ActiveMusicClones) do
		if musicClone and musicClone.Parent then
			musicClone:Stop()
			musicClone:Destroy()
		end
	end
	zoneState.ActiveMusicClones = {}

	-- Restaurar materiales en todos los pads
	for teamName, pad in pairs(zoneState.Pads) do
		local origMat = zoneState.OriginalMaterials[teamName]
		if pad and pad.Parent and origMat then
			pad.Material = origMat
		end
	end

	self._zones[zoneFolder] = nil
	print(string.format("[MatchmakingFeedbackService] Zona desregistrada y limpiada: '%s'", zoneFolder.Name))
end

-- Actualiza el estado de ocupación de un pad en una zona física específica
function MatchmakingFeedbackService:SetPadOccupied(zoneFolder: Folder, teamName: string, isOccupied: boolean, occupant: Player?)
	if not zoneFolder then return end

	local zoneState = self._zones[zoneFolder]
	if not zoneState then
		self:RegisterZone(zoneFolder)
		zoneState = self._zones[zoneFolder]
		if not zoneState then return end
	end

	local wasOccupied = zoneState.PadOccupied[teamName] == true
	if wasOccupied == isOccupied then
		return
	end

	zoneState.PadOccupied[teamName] = isOccupied

	if isOccupied then
		self:_activateZoneFeedback(zoneState, teamName, occupant)
	else
		self:_deactivateZoneFeedback(zoneState, teamName)
	end
end

-- Activa el feedback audiovisual en una zona física y equipo específicos
function MatchmakingFeedbackService:_activateZoneFeedback(zoneState: ZoneFeedbackState, teamName: string, occupant: Player?)
	local pad = zoneState.Pads[teamName]
	if not pad then return end

	local teamAssets = zoneState.TeamEffects[teamName]
	local targetFolder = (teamAssets and teamAssets.effectsFolder) or zoneState.EffectsFolder or pad.Parent

	-- 1. Reproducir SoundJoin espacializado del color correspondiente
	if teamAssets and teamAssets.soundJoin then
		self:_playSpatialSound(teamAssets.soundJoin, pad)
	end

	-- Registrar ocupante del pad para tracking de feedback
	zoneState.Occupants[teamName] = occupant

	-- 2. Cambiar material del pad a Neon
	pad.Material = OCCUPIED_MATERIAL

	-- 3. Instanciar clon temporal de partículas correspondiente al color
	if teamAssets and teamAssets.activateTemplate then
		local previousClone = zoneState.ActiveClones[teamName]
		if previousClone and previousClone.Parent then
			previousClone:Destroy()
		end

		local clone = teamAssets.activateTemplate:Clone() :: Part
		clone.Name = "ParticleInstance_" .. teamName
		clone.CanCollide = false
		clone.CanTouch = false
		clone.CanQuery = false
		clone.Anchored = true
		clone.CastShadow = false

		-- Posicionar sobre el pad correspondiente
		local targetPosition = pad.Position + EFFECT_VERTICAL_OFFSET
		clone.CFrame = CFrame.new(targetPosition)

		-- Activar dinámicamente todos los ParticleEmitters descendientes del color
		setEmittersEnabled(clone, true)

		-- Parentar a la carpeta de efectos del color
		clone.Parent = targetFolder
		zoneState.ActiveClones[teamName] = clone
	end

	-- 4. Instanciar y activar clones de Beams correspondientes al color
	local beamClones: { Part } = {}
	if teamAssets and teamAssets.beamTemplates then
		for _, beamTemplate in ipairs(teamAssets.beamTemplates) do
			local beamClone = beamTemplate:Clone() :: Part
			beamClone.Name = "BeamInstance_" .. teamName .. "_" .. beamTemplate.Name
			beamClone.CanCollide = false
			beamClone.CanTouch = false
			beamClone.CanQuery = false
			beamClone.Anchored = true
			beamClone.CastShadow = false

			-- Posicionar relativo al pad activo
			local relCFrame = pad.CFrame:ToObjectSpace(beamTemplate.CFrame)
			beamClone.CFrame = pad.CFrame * relCFrame

			-- Activar todos los Beams dentro del clon del color
			setBeamsEnabled(beamClone, true)

			beamClone.Parent = targetFolder
			table.insert(beamClones, beamClone)
		end
	end

	zoneState.ActiveBeamClones[teamName] = beamClones

	local occupantName = occupant and occupant.Name or "Desconocido"
	print(string.format("[MatchmakingFeedbackService] Feedback activado para pad '%s' en zona '%s' (Ocupante: %s)",
		teamName, zoneState.ZoneFolder.Name, occupantName))
end

-- Desactiva el feedback audiovisual en una zona física y equipo específicos
function MatchmakingFeedbackService:_deactivateZoneFeedback(zoneState: ZoneFeedbackState, teamName: string)
	local pad = zoneState.Pads[teamName]
	local teamAssets = zoneState.TeamEffects[teamName]
	local targetFolder = (teamAssets and teamAssets.effectsFolder) or zoneState.EffectsFolder

	-- 1. Limpiar ocupante registrado del pad
	local previousOccupant = zoneState.Occupants[teamName]
	zoneState.Occupants[teamName] = nil

	-- Limpieza defensiva de cualquier clon previo en el pad
	local activeMusic = zoneState.ActiveMusicClones[teamName]
	if activeMusic then
		zoneState.ActiveMusicClones[teamName] = nil
		if activeMusic.IsPlaying then
			activeMusic:Stop()
		end
		activeMusic:Destroy()
	end

	if pad then
		local leftoverMusic = pad:FindFirstChild("SpatialMusic_" .. teamName)
		if leftoverMusic then
			if leftoverMusic:IsA("Sound") and leftoverMusic.IsPlaying then
				leftoverMusic:Stop()
			end
			leftoverMusic:Destroy()
		end
	end

	-- 1b. Reproducir SoundLeave espacializado del color correspondiente
	if pad and teamAssets and teamAssets.soundLeave then
		self:_playSpatialSound(teamAssets.soundLeave, pad)
	end

	-- 2. Restaurar exactamente el material original guardado
	local originalMaterial = zoneState.OriginalMaterials[teamName]
	if pad and originalMaterial then
		pad.Material = originalMaterial
	end

	-- 3. Limpiar la instancia temporal de partículas
	local clone = zoneState.ActiveClones[teamName]
	if clone then
		zoneState.ActiveClones[teamName] = nil
		setEmittersEnabled(clone, false)
		clone:Destroy()
	end

	-- Fallback para garantizar que no queden partículas residuales
	if targetFolder then
		local leftoverParticle = targetFolder:FindFirstChild("ParticleInstance_" .. teamName)
		if leftoverParticle then
			leftoverParticle:Destroy()
		end
	end
	if zoneState.EffectsFolder and zoneState.EffectsFolder ~= targetFolder then
		local leftoverParticle = zoneState.EffectsFolder:FindFirstChild("ParticleInstance_" .. teamName)
		if leftoverParticle then
			leftoverParticle:Destroy()
		end
	end

	-- 4. Limpiar los clones temporales de Beams
	local beamClones = zoneState.ActiveBeamClones[teamName]
	if beamClones then
		zoneState.ActiveBeamClones[teamName] = nil
		for _, bClone in ipairs(beamClones) do
			setBeamsEnabled(bClone, false)
			bClone:Destroy()
		end
	end

	-- Fallback para garantizar que no queden beams residuales
	if targetFolder then
		for _, child in ipairs(targetFolder:GetChildren()) do
			if child.Name:find("BeamInstance_" .. teamName) then
				child:Destroy()
			end
		end
	end
	if zoneState.EffectsFolder and zoneState.EffectsFolder ~= targetFolder then
		for _, child in ipairs(zoneState.EffectsFolder:GetChildren()) do
			if child.Name:find("BeamInstance_" .. teamName) then
				child:Destroy()
			end
		end
	end

	print(string.format("[MatchmakingFeedbackService] Feedback desactivado y limpiado para pad '%s' en zona '%s'",
		teamName, zoneState.ZoneFolder.Name))
end

-- Consulta de assets de equipo para una zona dada
function MatchmakingFeedbackService:GetTeamAssets(zoneFolder: Folder, teamName: string): TeamEffectAssets?
	local zoneState = self._zones[zoneFolder]
	return zoneState and zoneState.TeamEffects[teamName]
end

-- Limpieza global de todas las zonas
function MatchmakingFeedbackService:ResetAll()
	for zoneFolder, zoneState in pairs(self._zones) do
		for teamName, isOccupied in pairs(zoneState.PadOccupied) do
			if isOccupied then
				zoneState.PadOccupied[teamName] = false
				self:_deactivateZoneFeedback(zoneState, teamName)
			end
		end

		for teamName, musicClone in pairs(zoneState.ActiveMusicClones) do
			if musicClone and musicClone.Parent then
				musicClone:Stop()
				musicClone:Destroy()
			end
		end
		zoneState.ActiveMusicClones = {}
	end
end

-- Consultas de estado por zona
function MatchmakingFeedbackService:IsPadOccupied(zoneFolder: Folder, teamName: string): boolean
	local zoneState = self._zones[zoneFolder]
	return (zoneState and zoneState.PadOccupied[teamName] == true) or false
end

function MatchmakingFeedbackService:GetActiveClone(zoneFolder: Folder, teamName: string): Part?
	local zoneState = self._zones[zoneFolder]
	return zoneState and zoneState.ActiveClones[teamName]
end

function MatchmakingFeedbackService:GetActiveBeamClones(zoneFolder: Folder, teamName: string): { Part }?
	local zoneState = self._zones[zoneFolder]
	return zoneState and zoneState.ActiveBeamClones[teamName]
end

function MatchmakingFeedbackService:GetActiveMusic(zoneFolder: Folder, teamName: string): Sound?
	local zoneState = self._zones[zoneFolder]
	return zoneState and zoneState.ActiveMusicClones[teamName]
end

return MatchmakingFeedbackService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="539">
        <Properties>
          <string name="Name">MatchmakingService</string>
          <string name="Source"><![CDATA[--!strict
-- MatchmakingService
-- Gestiona la detección de jugadores en zonas de matchmaking genéricas (1v1, 2v2, 3v3),
-- construye el QueueSnapshot autoritativo, controla la capacidad por equipo y despacha
-- partidas hacia RoundService.
-- La instancia física (zoneFolder) es la identidad primaria interna de la zona.
-- NO se encarga de efectos audiovisuales (delegado a MatchmakingFeedbackService)
-- ni de la presentación visual del HUD (delegado a MatchmakingController).

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerScriptService = game:GetService("ServerScriptService")

local Config = require(ReplicatedStorage.Shared.Config)
local Types = require(ReplicatedStorage.Shared.Types)

type QueueSnapshot = Types.QueueSnapshot
type MatchmakingZoneConfig = Types.MatchmakingZoneConfig
type QueueStateName = Types.QueueStateName

export type ZoneData = {
	ZoneId: string,
	Instance: Folder,
	ZoneName: string,
	Config: MatchmakingZoneConfig,
	RedPads: { BasePart },
	BluePads: { BasePart },
	PadOccupants: { [BasePart]: { Player } },
	OccupantLastSeen: { [Player]: number },
	CandidateArrivals: { [Player]: number },
	CandidateLastSeen: { [Player]: number },
	CurrentRed: { Player },
	CurrentBlue: { Player },
	State: QueueStateName,
	ActiveReservation: Types.TeamMatchReservation?,
	LastModeNotPlayableWarn: string?,
}

local MatchmakingService = {}
MatchmakingService.Name = "MatchmakingService"

MatchmakingService._context = nil :: any
MatchmakingService._zones = {} :: { [Folder]: ZoneData }
MatchmakingService._latestSnapshots = {} :: { [string]: QueueSnapshot }
MatchmakingService._checkConnection = nil :: RBXScriptConnection?
MatchmakingService._lastCheck = 0
MatchmakingService._queueStatusRemote = nil :: RemoteEvent?
MatchmakingService._containerConnections = {} :: { RBXScriptConnection }
MatchmakingService._testCharacterMap = {} :: { [Model]: any }

-- Obtiene el Player asociado a una parte de un personaje
local function getPlayerFromPart(part: BasePart): Player?
	local current: Instance? = part
	while current and current ~= workspace do
		if current:IsA("Model") then
			local player = Players:GetPlayerFromCharacter(current)
			if player then
				return player
			end
			if MatchmakingService._testCharacterMap and MatchmakingService._testCharacterMap[current] then
				return MatchmakingService._testCharacterMap[current]
			end
		end
		current = current.Parent
	end
	return nil
end

local PAD_DETECTION_HEIGHT = 6.0
local OCCUPANT_GRACE_PERIOD = 0.8 -- Segundos de gracia para tolerar saltos y fluctuaciones espaciales

-- Valida si un jugador está conectado, con personaje instanciado en workspace y Humanoid vivo
local function isPlayerAliveAndValid(player: any): boolean
	local isRealPlayer = typeof(player) == "Instance" and player:IsA("Player") and player:IsDescendantOf(Players)
	local isSimulated = typeof(player) == "table" and player.IsSimulatedPlayer == true
	if not isRealPlayer and not isSimulated then return false end

	local character = player.Character
	if not character or not character:IsDescendantOf(workspace) then return false end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then return false end
	return true
end

-- Detecta los jugadores físicos dentro del volumen de un pad usando GetPartBoundsInBox
local function getPhysicallyPresentPlayersOnPad(pad: BasePart, overlapParams: OverlapParams): { Player }
	local boxCFrame = pad.CFrame * CFrame.new(0, (pad.Size.Y / 2) + (PAD_DETECTION_HEIGHT / 2), 0)
	local boxSize = Vector3.new(pad.Size.X, PAD_DETECTION_HEIGHT, pad.Size.Z)
	local touchingParts = workspace:GetPartBoundsInBox(boxCFrame, boxSize, overlapParams)

	local presentList: { Player } = {}
	local seen: { [Player]: boolean } = {}

	for _, part in ipairs(touchingParts) do
		local player = getPlayerFromPart(part)
		if player and not seen[player] then
			if isPlayerAliveAndValid(player) then
				seen[player] = true
				table.insert(presentList, player)
			end
		end
	end

	return presentList
end

-- Actualiza autoritativamente la ocupación de un conjunto de pads (equipo) aplicando
-- prioridad por orden de llegada (FIFO), reserva por plaza, grace period y prevención de doble ocupación.
local function updateTeamOccupants(
	zone: ZoneData,
	pads: { BasePart },
	maxTeamCapacity: number,
	otherTeamOccupantsSet: { [Player]: boolean },
	overlapParams: OverlapParams,
	now: number,
	service: any
): { Player }
	if #pads == 0 or maxTeamCapacity <= 0 then
		return {}
	end

	local padCapacity = math.max(1, math.ceil(maxTeamCapacity / #pads))

	-- 1. Detección física en cada pad del equipo
	local presentByPad: { [BasePart]: { [Player]: boolean } } = {}
	local allPresentOnTeam: { [Player]: boolean } = {}

	for _, pad in ipairs(pads) do
		local presentList = getPhysicallyPresentPlayersOnPad(pad, overlapParams)
		local padSet: { [Player]: boolean } = {}
		for _, p in ipairs(presentList) do
			padSet[p] = true
			allPresentOnTeam[p] = true
		end
		presentByPad[pad] = padSet
	end

	-- 2. Retención de ocupantes existentes (con grace period)
	local assignedThisTeam: { [Player]: boolean } = {}
	local teamOccupantsList: { Player } = {}

	for _, pad in ipairs(pads) do
		local currentOccupants = zone.PadOccupants[pad] or {}
		local retained: { Player } = {}
		local presentSet = presentByPad[pad] or {}

		for _, occupant in ipairs(currentOccupants) do
			if not isPlayerAliveAndValid(occupant) then
				-- Jugador muerto o desconectado: liberación inmediata sin periodo de gracia
				zone.OccupantLastSeen[occupant] = nil
				zone.CandidateArrivals[occupant] = nil
				zone.CandidateLastSeen[occupant] = nil
			elseif assignedThisTeam[occupant] or otherTeamOccupantsSet[occupant] then
				-- Conflicto: ya asignado a otra plaza o al equipo contrario
				zone.OccupantLastSeen[occupant] = nil
				zone.CandidateArrivals[occupant] = nil
				zone.CandidateLastSeen[occupant] = nil
			else
				if presentSet[occupant] then
					-- Físicamente presente: retiene plaza y actualiza marca temporal
					zone.OccupantLastSeen[occupant] = now
					assignedThisTeam[occupant] = true
					table.insert(retained, occupant)
					table.insert(teamOccupantsList, occupant)
				else
					-- Ausente físicamente en este frame: comprobar periodo de gracia (tolerancia a saltos/jitter)
					local lastSeen = zone.OccupantLastSeen[occupant] or 0
					if (now - lastSeen) <= OCCUPANT_GRACE_PERIOD then
						assignedThisTeam[occupant] = true
						table.insert(retained, occupant)
						table.insert(teamOccupantsList, occupant)
					else
						-- Gracia expirada: abandono confirmado, liberar plaza
						zone.OccupantLastSeen[occupant] = nil
						zone.CandidateArrivals[occupant] = nil
						zone.CandidateLastSeen[occupant] = nil
					end
				end
			end
		end

		zone.PadOccupants[pad] = retained
	end

	-- 3. Registro de candidatos esperando en los pads
	for _, pad in ipairs(pads) do
		local presentSet = presentByPad[pad] or {}
		for p in pairs(presentSet) do
			if not assignedThisTeam[p] and not otherTeamOccupantsSet[p] then
				if not service:_isPlayerOccupantInOtherZone(p, zone) then
					if zone.CandidateArrivals[p] == nil then
						zone.CandidateArrivals[p] = now
					end
					zone.CandidateLastSeen[p] = now
				end
			end
		end
	end

	-- 4. Asignación de plazas disponibles por orden de llegada (FIFO)
	for _, pad in ipairs(pads) do
		local retained = zone.PadOccupants[pad] or {}
		local padSlotsAvailable = padCapacity - #retained
		local teamSlotsAvailable = maxTeamCapacity - #teamOccupantsList

		if padSlotsAvailable > 0 and teamSlotsAvailable > 0 then
			local presentSet = presentByPad[pad] or {}
			local candidates: { Player } = {}

			for p in pairs(presentSet) do
				if not assignedThisTeam[p]
					and not otherTeamOccupantsSet[p]
					and not service:_isPlayerOccupantInOtherZone(p, zone)
					and not table.find(retained, p) then
					table.insert(candidates, p)
				end
			end

			-- Ordenar candidatos por orden de llegada estricto
			table.sort(candidates, function(a, b)
				local timeA = zone.CandidateArrivals[a] or math.huge
				local timeB = zone.CandidateArrivals[b] or math.huge
				if timeA == timeB then
					return a.UserId < b.UserId
				end
				return timeA < timeB
			end)

			local toAssign = math.min(padSlotsAvailable, teamSlotsAvailable, #candidates)
			for i = 1, toAssign do
				local chosen = candidates[i]
				table.insert(retained, chosen)
				table.insert(teamOccupantsList, chosen)
				assignedThisTeam[chosen] = true
				zone.OccupantLastSeen[chosen] = now
			end

			zone.PadOccupants[pad] = retained
		end
	end

	-- 5. Limpieza de candidatos que se retiraron (respetando gracia para evitar pérdida por salto)
	for candidate, lastSeen in pairs(zone.CandidateLastSeen) do
		if not allPresentOnTeam[candidate] and not assignedThisTeam[candidate] then
			if (now - lastSeen) > OCCUPANT_GRACE_PERIOD then
				zone.CandidateArrivals[candidate] = nil
				zone.CandidateLastSeen[candidate] = nil
			end
		end
	end

	return teamOccupantsList
end

-- Attributes describe an authorized mode; they never define a new mode or its capacity.
local function getZoneConfiguration(zoneFolder: Folder): (MatchmakingZoneConfig?, string?)
	local modeAttr = zoneFolder:GetAttribute("Mode")
	local teamSizeAttr = zoneFolder:GetAttribute("TeamSize")
	local maxPerTeamAttr = zoneFolder:GetAttribute("MaxPlayersPerTeam")
	local totalAttr = zoneFolder:GetAttribute("TotalPlayers")

	local modeName = if type(modeAttr) == "string" and modeAttr ~= "" then modeAttr else zoneFolder.Name
	local configDefaults = Config.Matchmaking and Config.Matchmaking.Modes and Config.Matchmaking.Modes[modeName]

	if not configDefaults then return nil, "UnknownMode" end
	for _, entry in ipairs({
		{ Value = teamSizeAttr, Expected = configDefaults.TeamSize },
		{ Value = maxPerTeamAttr, Expected = configDefaults.MaxPlayersPerTeam },
		{ Value = totalAttr, Expected = configDefaults.TotalPlayers },
	}) do
		if entry.Value ~= nil and entry.Value ~= entry.Expected then
			return nil, "ModeCapacityMismatch"
		end
	end

	return {
		Mode = modeName,
		TeamSize = configDefaults.TeamSize,
		MaxPlayersPerTeam = configDefaults.MaxPlayersPerTeam,
		TotalPlayers = configDefaults.TotalPlayers,
	}
end

-- Verifica si un ZoneId ya está tomado por otra zona activa
function MatchmakingService:_isZoneIdTaken(zoneId: string, currentFolder: Folder): boolean
	for folder, data in pairs(self._zones) do
		if folder ~= currentFolder and data.ZoneId == zoneId then
			return true
		end
	end
	return false
end

-- Verifica si un jugador ya ocupa autoritativamente un pad en otra zona diferente
function MatchmakingService:_isPlayerOccupantInOtherZone(player: Player, currentZone: ZoneData): boolean
	for _, zone in pairs(self._zones) do
		if zone ~= currentZone then
			if table.find(zone.CurrentRed, player) or table.find(zone.CurrentBlue, player) then
				return true
			end
		end
	end
	return false
end

function MatchmakingService:Init(context)
	self._context = context
	self._zones = {}
	self._latestSnapshots = {}
	self._containerConnections = {}
	_G.MatchmakingService = self

	-- Garantizar Remote de estado de cola
	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	local mmFolder = remotes and remotes:FindFirstChild("Matchmaking")
	local queueRemote = mmFolder and mmFolder:FindFirstChild("QueueStatus")
	if queueRemote and queueRemote:IsA("RemoteEvent") then
		self._queueStatusRemote = queueRemote
	end

	-- Descubrir zonas en Workspace.ZoneMatchmaking
	local zoneContainer = workspace:FindFirstChild("ZoneMatchmaking")
	if not zoneContainer then
		warn("[MatchmakingService] No se encontro Workspace.ZoneMatchmaking")
		return
	end

	-- Registrar todas las zonas existentes
	for _, child in ipairs(zoneContainer:GetChildren()) do
		if child:IsA("Folder") then
			self:_registerZone(child)
		end
	end

	-- Conectar descubrimiento dinámico en tiempo de ejecución (Runtime Add / Remove)
	table.insert(self._containerConnections, zoneContainer.ChildAdded:Connect(function(child: Instance)
		if child:IsA("Folder") then
			-- Dar un frame para asegurar inicialización de atributos y jerarquía en caso de clonación
			task.defer(function()
				if child.Parent == zoneContainer then
					self:_registerZone(child)
				end
			end)
		end
	end))

	table.insert(self._containerConnections, zoneContainer.ChildRemoved:Connect(function(child: Instance)
		if child:IsA("Folder") then
			self:_unregisterZone(child)
		end
	end))
end

function MatchmakingService:_registerZone(zoneFolder: Folder)
	if not zoneFolder or not zoneFolder:IsA("Folder") then return end
	if self._zones[zoneFolder] then return end

	local config, configError = getZoneConfiguration(zoneFolder)
	if not config then
		-- Decorative folders have no join pads and are not matchmaking zones.
		if zoneFolder:FindFirstChild("joins-parts") then
			warn(string.format("[MatchmakingService] Zona rechazada '%s': %s", zoneFolder.Name, tostring(configError)))
		end
		return
	end
	local joinsFolder = zoneFolder:FindFirstChild("joins-parts")

	local redPads: { BasePart } = {}
	local bluePads: { BasePart } = {}

	if joinsFolder then
		for _, part in ipairs(joinsFolder:GetChildren()) do
			if part:IsA("BasePart") then
				local teamAttr = part:GetAttribute("Team")
				if teamAttr == "Red" or part.Name == "Red" or part.Name:find("Red") then
					table.insert(redPads, part)
				elseif teamAttr == "Blue" or part.Name == "Blue" or part.Name:find("Blue") then
					table.insert(bluePads, part)
				end
			end
		end
	end

	if #redPads == 0 or #bluePads == 0 then
		warn(string.format("[MatchmakingService] Zona rechazada '%s': MissingTeamPads", zoneFolder.Name))
		return
	end
	table.sort(redPads, function(a, b) return a.Name < b.Name end)
	table.sort(bluePads, function(a, b) return a.Name < b.Name end)

	-- Generación de ZoneId único
	local attrId = zoneFolder:GetAttribute("ZoneId")
	local zoneId: string
	if typeof(attrId) == "string" and attrId ~= "" then
		if self:_isZoneIdTaken(attrId, zoneFolder) then
			warn(string.format("[MatchmakingService] Zona rechazada '%s': DuplicateZoneId", zoneFolder.Name))
			return
		end
		zoneId = attrId
	else
		local baseId = "Zone_" .. zoneFolder.Name
		local uniqueId = baseId
		local counter = 1
		while self:_isZoneIdTaken(uniqueId, zoneFolder) do
			counter += 1
			uniqueId = string.format("%s_%d", baseId, counter)
		end
		zoneId = uniqueId
	end

	local padOccupants: { [BasePart]: { Player } } = {}
	for _, pad in ipairs(redPads) do
		padOccupants[pad] = {}
	end
	for _, pad in ipairs(bluePads) do
		padOccupants[pad] = {}
	end

	local zoneData: ZoneData = {
		ZoneId = zoneId,
		Instance = zoneFolder,
		ZoneName = zoneFolder.Name,
		Config = config,
		RedPads = redPads,
		BluePads = bluePads,
		PadOccupants = padOccupants,
		OccupantLastSeen = {},
		CandidateArrivals = {},
		CandidateLastSeen = {},
		CurrentRed = {},
		CurrentBlue = {},
		State = "WAITING",
		ActiveReservation = nil,
		LastModeNotPlayableWarn = nil,
	}

	-- Registrar en MatchmakingFeedbackService
	local feedbackService = self:_getFeedbackService()
	if feedbackService then
		feedbackService:RegisterZone(zoneFolder)
	end

	self._zones[zoneFolder] = zoneData
	print(string.format("[MatchmakingService] Zona registrada: '%s' (ZoneId=%s, Modo=%s, TeamSize=%d, MaxTotal=%d)",
		zoneFolder.Name, zoneId, config.Mode, config.TeamSize, config.TotalPlayers))
end

function MatchmakingService:_unregisterZone(zoneFolder: Folder)
	local zoneData = self._zones[zoneFolder]
	if not zoneData then return end

	-- Cleanup en feedback audiovisual
	local feedbackService = self:_getFeedbackService()
	if feedbackService then
		feedbackService:UnregisterZone(zoneFolder)
	end

	-- Emitir snapshot vacío final a los clientes si la zona tenía jugadores
	if #zoneData.CurrentRed > 0 or #zoneData.CurrentBlue > 0 then
		if self._queueStatusRemote then
			local finalSnapshot: QueueSnapshot = {
				ZoneId = zoneData.ZoneId,
				ZoneName = zoneData.ZoneName,
				Mode = zoneData.Config.Mode,
				TeamSize = zoneData.Config.TeamSize,
				MaxPlayersPerTeam = zoneData.Config.MaxPlayersPerTeam,
				TotalPlayers = zoneData.Config.TotalPlayers,
				Red = {},
				Blue = {},
				State = "WAITING",
			}
			self._queueStatusRemote:FireAllClients(finalSnapshot)
		end
	end

	-- Limpieza de caché de snapshots
	self._latestSnapshots[zoneData.ZoneId] = nil
	self._latestSnapshots[zoneData.ZoneName] = nil

	-- Limpieza de tablas de ocupación
	table.clear(zoneData.PadOccupants)
	table.clear(zoneData.OccupantLastSeen)
	table.clear(zoneData.CandidateArrivals)
	table.clear(zoneData.CandidateLastSeen)
	table.clear(zoneData.CurrentRed)
	table.clear(zoneData.CurrentBlue)
	zoneData.ActiveReservation = nil

	self._zones[zoneFolder] = nil
	print(string.format("[MatchmakingService] Zona desregistrada y limpiada: '%s' (ZoneId=%s)",
		zoneFolder.Name, zoneData.ZoneId))
end

-- Limpia de forma inmediata reservas huérfanas al desconectarse un jugador
function MatchmakingService:_handlePlayerRemoving(player: Player)
	local needsUpdate = false
	for _, zone in pairs(self._zones) do
		zone.OccupantLastSeen[player] = nil
		zone.CandidateArrivals[player] = nil
		zone.CandidateLastSeen[player] = nil

		for pad, occupants in pairs(zone.PadOccupants) do
			local idx = table.find(occupants, player)
			if idx then
				table.remove(occupants, idx)
				needsUpdate = true
			end
		end
	end

	if needsUpdate then
		self:_updateQueue()
	end
end

function MatchmakingService:Start(context)
	self._context = context

	-- Monitoreo de ocupación cada 0.3s
	self._checkConnection = RunService.Heartbeat:Connect(function()
		local now = os.clock()
		if now - self._lastCheck < 0.3 then return end
		self._lastCheck = now
		self:_updateQueue()
	end)

	-- Limpieza inmediata cuando un jugador se desconecta del servidor
	Players.PlayerRemoving:Connect(function(player: Player)
		self:_handlePlayerRemoving(player)
	end)

	print("[MatchmakingService] Servicio de matchmaking genérico iniciado")
end

function MatchmakingService:_getRoundService()
	if self._context and self._context.GetService then
		local s = self._context:GetService("RoundService")
		if s then return s end
	end

	local servicesFolder = ServerScriptService:FindFirstChild("Services")
	local mod = servicesFolder and servicesFolder:FindFirstChild("RoundService")
	if mod and mod:IsA("ModuleScript") then
		local ok, result = pcall(require, mod)
		if ok then return result end
	end
	return nil
end

function MatchmakingService:_getFeedbackService()
	if self._context and self._context.GetService then
		local s = self._context:GetService("MatchmakingFeedbackService")
		if s then return s end
	end

	local servicesFolder = ServerScriptService:FindFirstChild("Services")
	local mod = servicesFolder and servicesFolder:FindFirstChild("MatchmakingFeedbackService")
	if mod and mod:IsA("ModuleScript") then
		local ok, result = pcall(require, mod)
		if ok then return result end
	end
	return nil
end

-- Compara si dos listas de jugadores son idénticas
local function arePlayerListsEqual(a: { Player }, b: { Player }): boolean
	if #a ~= #b then return false end
	for i = 1, #a do
		if a[i] ~= b[i] then return false end
	end
	return true
end

function MatchmakingService:_updateQueue()
	local feedbackService = self:_getFeedbackService()
	local roundService = self:_getRoundService()
	local now = os.clock()

	-- Construir lista de personajes para OverlapParams
	local overlapParams = OverlapParams.new()
	overlapParams.FilterType = Enum.RaycastFilterType.Include
	local characterList = {}
	for _, player in ipairs(Players:GetPlayers()) do
		if player.Character then
			table.insert(characterList, player.Character)
		end
	end
	if self._testCharacterMap then
		for charModel, _ in pairs(self._testCharacterMap) do
			if charModel:IsDescendantOf(workspace) then
				table.insert(characterList, charModel)
			end
		end
	end
	overlapParams.FilterDescendantsInstances = characterList

	for zoneFolder, zone in pairs(self._zones) do
		-- Si la zona fue destruida o desparentada, desregistrar y omitir
		if not zoneFolder or not zoneFolder:IsDescendantOf(workspace) then
			self:_unregisterZone(zoneFolder)
			continue
		end

		-- Conjunto de ocupantes actuales de Blue para pasárselo a Red
		local currentBlueSet: { [Player]: boolean } = {}
		for _, p in ipairs(zone.CurrentBlue) do
			currentBlueSet[p] = true
		end

		local redOccupants = updateTeamOccupants(
			zone,
			zone.RedPads,
			zone.Config.MaxPlayersPerTeam,
			currentBlueSet,
			overlapParams,
			now,
			self
		)

		-- Conjunto de ocupantes actualizados de Red para pasárselo a Blue
		local currentRedSet: { [Player]: boolean } = {}
		for _, p in ipairs(redOccupants) do
			currentRedSet[p] = true
		end

		local blueOccupants = updateTeamOccupants(
			zone,
			zone.BluePads,
			zone.Config.MaxPlayersPerTeam,
			currentRedSet,
			overlapParams,
			now,
			self
		)

		local redChanged = not arePlayerListsEqual(zone.CurrentRed, redOccupants)
		local blueChanged = not arePlayerListsEqual(zone.CurrentBlue, blueOccupants)

		zone.CurrentRed = redOccupants
		zone.CurrentBlue = blueOccupants
		if roundService and roundService.CancelPreparationIfOccupancyLost then
			roundService:CancelPreparationIfOccupancyLost(zone.ZoneId)
		end

		-- Actualizar feedback audiovisual discreto por instancia de zona
		if feedbackService then
			feedbackService:SetPadOccupied(zoneFolder, "Red", #redOccupants > 0, redOccupants[1])
			feedbackService:SetPadOccupied(zoneFolder, "Blue", #blueOccupants > 0, blueOccupants[1])
		end

		-- Determinar candidatos comprometidos según TeamSize
		local committedRed: { Player } = {}
		for i = 1, math.min(#redOccupants, zone.Config.TeamSize) do
			table.insert(committedRed, redOccupants[i])
		end
		local committedBlue: { Player } = {}
		for i = 1, math.min(#blueOccupants, zone.Config.TeamSize) do
			table.insert(committedBlue, blueOccupants[i])
		end

		-- Verificar que los equipos sean disjuntos
		local disjoint = true
		for _, r in ipairs(committedRed) do
			if table.find(committedBlue, r) then
				disjoint = false
				break
			end
		end

		-- Verificar que ninguno de los participantes esté registrado en otra partida
		local anyAlreadyInMatch = false
		if roundService and roundService.GetSessionForPlayer then
			for _, p in ipairs(committedRed) do
				if roundService:GetSessionForPlayer(p) ~= nil then
					anyAlreadyInMatch = true
					break
				end
			end
			if not anyAlreadyInMatch then
				for _, p in ipairs(committedBlue) do
					if roundService:GetSessionForPlayer(p) ~= nil then
						anyAlreadyInMatch = true
						break
					end
				end
			end
		end

		local socialPlay=self:_socialPlay()
   local groupsReady=not socialPlay or (socialPlay:CanQueueTeam(committedRed,zone.Config.TeamSize)and socialPlay:CanQueueTeam(committedBlue,zone.Config.TeamSize))
   local isReady = groupsReady and (#committedRed == zone.Config.TeamSize)
			and (#committedBlue == zone.Config.TeamSize)
			and disjoint
			and not anyAlreadyInMatch

		-- Gestionar token autoritativo de reserva
		if isReady then
			-- Comprobar si la reserva existente sigue siendo válida para la misma plantilla
			local currentRes = zone.ActiveReservation
			local needsNewRes = true
			if currentRes and (os.clock() <= currentRes.ExpiresAt) then
				if currentRes.Mode == zone.Config.Mode
					and currentRes.TeamSize == zone.Config.TeamSize
					and #currentRes.RedTeam == #committedRed
					and #currentRes.BlueTeam == #committedBlue
				then
					local matches = true
					for i = 1, #committedRed do
						if currentRes.RedTeam[i] ~= committedRed[i] then
							matches = false
							break
						end
					end
					if matches then
						for i = 1, #committedBlue do
							if currentRes.BlueTeam[i] ~= committedBlue[i] then
								matches = false
								break
							end
						end
					end
					if matches then
						needsNewRes = false
					end
				end
			end

			if needsNewRes then
				self:CreateReservation(zone.ZoneId, zone.Config.Mode, zone.Config.TeamSize, committedRed, committedBlue)
			end
		else
			-- Si no está listo, invalidar cualquier reserva previa
			zone.ActiveReservation = nil
		end

		local newState: QueueStateName = if isReady then "READY" else "WAITING"
		local stateChanged = zone.State ~= newState
		zone.State = newState

		-- Emitir QueueSnapshot cuando hay cambios o para sincronización
		if redChanged or blueChanged or stateChanged or (zone :: any).ForceSnapshot then
			(zone :: any).ForceSnapshot = nil
			local snapshot: QueueSnapshot = {
				ZoneId = zone.ZoneId,
				ZoneName = zone.ZoneName,
				Mode = zone.Config.Mode,
				TeamSize = zone.Config.TeamSize,
				MaxPlayersPerTeam = zone.Config.MaxPlayersPerTeam,
				TotalPlayers = zone.Config.TotalPlayers,
				Red = redOccupants,
				Blue = blueOccupants,
				State = newState,
			}

			self._latestSnapshots[zone.ZoneId] = snapshot
			self._latestSnapshots[zone.ZoneName] = snapshot

			if self._queueStatusRemote then
				self._queueStatusRemote:FireAllClients(snapshot)
			end
		end

		-- Disparar inicio de partida cuando la cola está lista y RoundService disponible
		if isReady and roundService and roundService:IsAvailable() then
			local token = if zone.ActiveReservation then zone.ActiveReservation.Token else nil
			local admissionRequest: Types.TeamMatchAdmissionRequest = {
				ZoneId = zone.ZoneId,
				Mode = zone.Config.Mode,
				TeamSize = zone.Config.TeamSize,
				RedTeam = committedRed,
				BlueTeam = committedBlue,
				ReservationToken = token,
			}

			local ok, reason = roundService:StartTeamMatch(admissionRequest)
			if not ok then
				if reason == "ModeNotPlayable" then
					if zone.LastModeNotPlayableWarn ~= zone.Config.Mode then
						zone.LastModeNotPlayableWarn = zone.Config.Mode
						print(string.format("[MatchmakingService] Modalidad '%s' en zona '%s' admitida estructuralmente pero bloqueada para juego real (ModeNotPlayable)",
							zone.Config.Mode, zone.ZoneId))
					end
				else
					-- No silenciar otros errores
				end
			else
				zone.LastModeNotPlayableWarn = nil
			end
		end
	end
end

-- A party remains a complete cohort on the same physical team; no remote teleports.
function MatchmakingService:IsPlayerQueued(player: Player): boolean
 for _,zone in pairs(self._zones)do
  if table.find(zone.CurrentRed,player)or table.find(zone.CurrentBlue,player)then return true end
 end
 return false
end
function MatchmakingService:_socialPlay(): any
 return self._context and self._context:GetService('SocialPlayService')
end

-- Consulta de snapshot público (por Folder, ZoneId o ZoneName)
function MatchmakingService:GetQueueSnapshot(identifier: any): QueueSnapshot?
	if typeof(identifier) == "Instance" and identifier:IsA("Folder") then
		local data = self._zones[identifier]
		return data and self._latestSnapshots[data.ZoneId]
	elseif typeof(identifier) == "string" then
		return self._latestSnapshots[identifier]
	end
	return self._latestSnapshots["1v1"] or next(self._latestSnapshots)
end

-- Consulta de configuración de zona
function MatchmakingService:GetZoneConfig(identifier: any): MatchmakingZoneConfig?
	if typeof(identifier) == "Instance" and identifier:IsA("Folder") then
		local data = self._zones[identifier]
		return data and data.Config
	elseif typeof(identifier) == "string" then
		for _, data in pairs(self._zones) do
			if data.ZoneId == identifier or data.ZoneName == identifier then
				return data.Config
			end
		end
	end
	return nil
end

-- Obtiene la tabla completa de zonas registradas
function MatchmakingService:GetAllZones(): { [Folder]: ZoneData }
	return self._zones
end

-- Crea una reserva autoritativa para una plantilla lista
function MatchmakingService:CreateReservation(
	zoneId: string,
	mode: string,
	teamSize: number,
	redTeam: { Player },
	blueTeam: { Player },
	ttlSeconds: number?
): Types.TeamMatchReservation?
	local targetZone: ZoneData? = nil
	for _, z in pairs(self._zones) do
		if z.ZoneId == zoneId then
			targetZone = z
			break
		end
	end
	if not targetZone then return nil end

	local ttl = ttlSeconds or (Config.Matchmaking and Config.Matchmaking.ReservationTTL) or 15
	local now = os.clock()
	local token = HttpService:GenerateGUID(false)

	local redCopy: { Player } = {}
	for _, p in ipairs(redTeam) do table.insert(redCopy, p) end
	local blueCopy: { Player } = {}
	for _, p in ipairs(blueTeam) do table.insert(blueCopy, p) end

	local reservation: Types.TeamMatchReservation = {
		Token = token,
		ZoneId = zoneId,
		Mode = mode,
		TeamSize = teamSize,
		RedTeam = redCopy,
		BlueTeam = blueCopy,
		CreatedAt = now,
		ExpiresAt = now + ttl,
	}

	targetZone.ActiveReservation = reservation
	return reservation
end

-- Obtiene la reserva autoritativa activa de una zona
function MatchmakingService:GetActiveReservation(zoneId: string): Types.TeamMatchReservation?
	for _, z in pairs(self._zones) do
		if z.ZoneId == zoneId then
			return z.ActiveReservation
		end
	end
	return nil
end

-- Valida que un token corresponda exactamente a la plantilla y zona activa sin haber expirado
function MatchmakingService:ValidateReservation(
	token: string,
	request: Types.TeamMatchAdmissionRequest
): (boolean, string?)
 if type(request.ZoneId)=='string'and request.ZoneId:sub(1,5)=='Duel:'then
  local play=self:_socialPlay();if not play then return false,'SocialPlayUnavailable'end
  return play:ValidateDuel(token,request)
 end

	if not token or token == "" then
		return false, "MissingReservationToken"
	end

	local foundZone: ZoneData? = nil
	for _, z in pairs(self._zones) do
		if z.ActiveReservation and z.ActiveReservation.Token == token then
			foundZone = z
			break
		end
	end

	if not foundZone or not foundZone.ActiveReservation then
		return false, "ReservationNotFound"
	end

	local res = foundZone.ActiveReservation
	local now = os.clock()
	if now > res.ExpiresAt then
		foundZone.ActiveReservation = nil
		return false, "ReservationExpired"
	end

	if res.ZoneId ~= request.ZoneId then
		return false, "ReservationZoneMismatch"
	end

	if res.Mode ~= request.Mode then
		return false, "ReservationModeMismatch"
	end

	if res.TeamSize ~= request.TeamSize then
		return false, "ReservationTeamSizeMismatch"
	end

	if #res.RedTeam ~= #request.RedTeam or #res.BlueTeam ~= #request.BlueTeam then
		return false, "ReservationRosterMismatch"
	end

	for i = 1, #res.RedTeam do
		if res.RedTeam[i] ~= request.RedTeam[i] then
			return false, "ReservationRosterMismatch"
		end
	end

	for i = 1, #res.BlueTeam do
		if res.BlueTeam[i] ~= request.BlueTeam[i] then
			return false, "ReservationRosterMismatch"
		end
	end

	return true, nil
end

-- Consume de forma atómica una reserva al ser admitida la partida
function MatchmakingService:ConsumeReservation(token: string): boolean
 local play=self:_socialPlay();if play and play:ConsumeDuel(token)then return true end
	for _, z in pairs(self._zones) do
		if z.ActiveReservation and z.ActiveReservation.Token == token then
			z.ActiveReservation = nil
			return true
		end
	end
	return false
end

-- Invalida de forma explícita la reserva de una zona
-- Preserve physical occupancy/FIFO; only invalidate this preparation's reservation.
function MatchmakingService:ReleasePreparation(zoneId: string, token: string?)
 if zoneId:sub(1,5)=='Duel:'then local play=self:_socialPlay();if play then play:ReleaseDuel(zoneId,token)end;return end
	for _,zone in pairs(self._zones) do
		if zone.ZoneId == zoneId then
			if zone.ActiveReservation and zone.ActiveReservation.Token == token then zone.ActiveReservation = nil end
			(zone :: any).ForceSnapshot = true
			return
		end
	end
end

function MatchmakingService:InvalidateReservation(zoneId: string)
	for _, z in pairs(self._zones) do
		if z.ZoneId == zoneId then
			z.ActiveReservation = nil
			break
		end
	end
end

-- Verifica de manera server-authoritative si los jugadores siguen siendo los ocupantes registrados de su zona
function MatchmakingService:ArePlayersInZone(
	zoneId: string,
	redPlayerOrTeam: Player | { Player },
	bluePlayerOrTeam: Player | { Player },
	requirePhysical: boolean?
): boolean
	if not zoneId or not redPlayerOrTeam or not bluePlayerOrTeam then
		return false
	end

	local redList: { Player } = if typeof(redPlayerOrTeam) == "table" and not (redPlayerOrTeam :: any).IsSimulatedPlayer then (redPlayerOrTeam :: { Player }) else { redPlayerOrTeam :: Player }
	local blueList: { Player } = if typeof(bluePlayerOrTeam) == "table" and not (bluePlayerOrTeam :: any).IsSimulatedPlayer then (bluePlayerOrTeam :: { Player }) else { bluePlayerOrTeam :: Player }

	if #redList == 0 or #blueList == 0 then
		return false
	end

	for _, p in ipairs(redList) do
		if not isPlayerAliveAndValid(p) then return false end
	end
	for _, p in ipairs(blueList) do
		if not isPlayerAliveAndValid(p) then return false end
	end

 if zoneId:sub(1,5)=='Duel:'then
  local play=self:_socialPlay();return play~=nil and play:DuelPrepared(zoneId,redList,blueList)
 end

	-- 1. Resolver la zona mediante ZoneId
	local targetZone: ZoneData? = nil
	for _, zone in pairs(self._zones) do
		if zone.ZoneId == zoneId then
			targetZone = zone
			break
		end
	end

	if not targetZone then
		return false
	end

	-- Verificar existencia de la instancia física
	if not targetZone.Instance or not targetZone.Instance:IsDescendantOf(workspace) then
		return false
	end

	-- 2. Verificar que todos los jugadores de cada equipo están registrados en la zona
	for _, p in ipairs(redList) do
		if not table.find(targetZone.CurrentRed, p) then
			return false
		end
	end
	for _, p in ipairs(blueList) do
		if not table.find(targetZone.CurrentBlue, p) then
			return false
		end
	end

	if requirePhysical then
		local params=OverlapParams.new()
		params.FilterType=Enum.RaycastFilterType.Include
		local characters={}
		for _,list in ipairs({redList,blueList}) do for _,p in ipairs(list) do table.insert(characters,p.Character) end end
		params.FilterDescendantsInstances=characters
		for _,entry in ipairs({{Pads=targetZone.RedPads,Players=redList},{Pads=targetZone.BluePads,Players=blueList}}) do
			local present={}
			for _,pad in ipairs(entry.Pads) do for _,p in ipairs(getPhysicallyPresentPlayersOnPad(pad,params)) do present[p]=true end end
			for _,p in ipairs(entry.Players) do if not present[p] then return false end end
		end
	end
	return true
end

return MatchmakingService
]]></string>
        </Properties>
