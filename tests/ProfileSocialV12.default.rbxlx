        <Item class="ModuleScript" referent="552">
          <Properties>
            <string name="Name">CharacterPhysics</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Spawn-owned physical contract, captured before competitive mutations, per exact Character.
local PhysicsService=game:GetService("PhysicsService")
local Config=require(game.ReplicatedStorage.Shared.Config)
local Physics={Group="SlapDuelsCharacters",Records=setmetatable({},{__mode="k"})}
function Physics.Configure()
 if not PhysicsService:IsCollisionGroupRegistered(Physics.Group) then PhysicsService:RegisterCollisionGroup(Physics.Group) end
 -- Preserve the authored Default/Default matrix; player exclusion belongs to a separate group.
 PhysicsService:CollisionGroupSetCollidable(Physics.Group,Physics.Group,false)
 PhysicsService:CollisionGroupSetCollidable(Physics.Group,"Default",true)
end
function Physics.Track(character)
 if Physics.Records[character] then return end
 local record={Parts={}}
 Physics.Records[character]=record
 local function capture(part)
  if not part:IsA("BasePart") then return end
  part.CollisionGroup=Physics.Group
  -- These are owned temporary R6 colliders, not a normal avatar collision baseline.
  if part.Name=="Collider" or character:GetAttribute("ArenaRespawnPending") then return end
  record.Parts[part]={CanCollide=part.CanCollide,CanTouch=part.CanTouch,CanQuery=part.CanQuery}
 end
 for _,part in ipairs(character:GetDescendants()) do capture(part) end
 record.Connection=character.DescendantAdded:Connect(capture)
end
function Physics.Forget(character)
 local record=Physics.Records[character]
 if record and record.Connection then record.Connection:Disconnect() end
 Physics.Records[character]=nil
end
function Physics.Restore(character)
 local record=Physics.Records[character]
 if not record then return false end
 for part,properties in pairs(record.Parts) do
  if part:IsDescendantOf(character) then
   part.CollisionGroup=Physics.Group
   part.CanCollide=properties.CanCollide
   part.CanTouch=properties.CanTouch
   part.CanQuery=properties.CanQuery
  end
 end
 return true
end
function Physics.Trace(player,phase,spawn,roundState)
 if not Config.Respawn.Debug then return end
 local character=player.Character
 local root=character and character:FindFirstChild("HumanoidRootPart")
 local hum=character and character:FindFirstChildOfClass("Humanoid")
 if not root or not hum then return end
 local support=character:FindFirstChild("Torso") or character:FindFirstChild("LowerTorso") or root
 print("[RespawnDebug]",phase,"UserId",player.UserId,"Session",player:GetAttribute("MatchId"),
  "EliminationId",character:GetAttribute("ArenaEliminationId"),"Generation",character:GetAttribute("ArenaPhysicsGeneration"),
  "RoundState",roundState,"State",hum:GetState().Name,"Jump",hum.Jump,"PlatformStand",hum.PlatformStand,"Anchored",root.Anchored,
  "Linear",root.AssemblyLinearVelocity,"Angular",root.AssemblyAngularVelocity,
  "BodyGroup",support.CollisionGroup,"BodyCanCollide",support.CanCollide,"RootCanCollide",root.CanCollide,
  "SpawnGroup",spawn and spawn.CollisionGroup,"GroupPair",spawn and PhysicsService:CollisionGroupsAreCollidable(support.CollisionGroup,spawn.CollisionGroup))
end
return Physics
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="553">
          <Properties>
            <string name="Name">CompetitiveTransit</string>
            <string name="Source"><![CDATA[--!strict
-- One authoritative outcome per exact Character generation, scoped to session and UserId.
-- Pure registry: no timers, rewards, physics, replication or gameplay side effects.
local Transit = {}
Transit.__index = Transit
function Transit.new()
 return setmetatable({_sessions = {} :: {[string]: {[number]: any}}},Transit)
end
function Transit:Get(session: any, player: any, character: any, generation: any): any?
 local entries = self._sessions[session.Id]
 local record = entries and entries[player.UserId]
 if not record then return nil end
 -- The existing point teleport advances the physics generation on the SAME Character.
 -- Keep that goal protected through its countdown; ResumeScoring explicitly releases it.
 local pointHandoff = record.Kind=="Goal" and session.PointInProgress==true
 if record.Session ~= session or record.Player ~= player or record.Character ~= character
  or (record.Generation ~= generation and not pointHandoff) then
  entries[player.UserId] = nil
  if next(entries)==nil then self._sessions[session.Id]=nil end
  return nil
 end
 return record
end
function Transit:Claim(session: any, player: any, character: any, generation: any, kind: string, eventId: string): boolean
 if self:Get(session,player,character,generation) then return false end
 local entries = self._sessions[session.Id]
 if not entries then entries={};self._sessions[session.Id]=entries end
 entries[player.UserId]={Session=session,SessionId=session.Id,Player=player,UserId=player.UserId,
  Character=character,Generation=generation,Kind=kind,EventId=eventId}
 return true
end
function Transit:ForgetPlayer(sessionId: string, player: any)
 local entries=self._sessions[sessionId]
 local record=entries and entries[player.UserId]
 if record and record.Player==player then entries[player.UserId]=nil end
 if entries and next(entries)==nil then self._sessions[sessionId]=nil end
end
function Transit:ReleaseGoals(sessionId: string)
 local entries=self._sessions[sessionId]
 if not entries then return end
 for id,record in pairs(entries) do if record.Kind=="Goal" then entries[id]=nil end end
 if next(entries)==nil then self._sessions[sessionId]=nil end
end
function Transit:ClearSession(sessionId: string)
 self._sessions[sessionId]=nil
end
return Transit
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="554">
        <Properties>
          <string name="Name">RoundService</string>
          <string name="Source"><![CDATA[--!strict
-- RoundService
-- Maquina de estados del flujo de partida 1v1.
-- Controla el ciclo completo: Waiting -> MatchReady -> MatchCountdown -> MapSelection -> MapLoading -> Playing -> Ending -> ReturningToLobby -> Waiting.
-- NO implementa logica fisica de spawn ni mapas (delegado a SpawnService en fases posteriores).

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local HttpService = game:GetService("HttpService")

local Config = require(ReplicatedStorage.Shared.Config)
local Constants = require(ReplicatedStorage.Shared.Constants)
local RoundClock = require(script.Parent.Gameplay.RoundClock)
local Types = require(ReplicatedStorage.Shared.Types)
local CinematicConfig = require(ReplicatedStorage.Shared.EndCinematicConfig)
local CinematicRanking = require(ReplicatedStorage.Shared.EndCinematicRanking)

type RoundStateName = Types.RoundStateName
type MatchSession = Types.MatchSession
type MatchResultName = Types.MatchResultName
type SessionId = Types.SessionId
type SessionParticipant = Types.SessionParticipant

local RoundService = {}
RoundService.Name = "RoundService"

-- Evento / señal para que servicios externos (ej. SpawnService) se suscriban al retorno al lobby
local returnLobbyBindable = Instance.new("BindableEvent")
RoundService.ReturnPlayersToLobby = returnLobbyBindable.Event

-- Estado interno
RoundService._context = nil :: any
-- Adaptadores temporales para consumidores 1v1. El estado autoritativo vive en MatchSession.
RoundService._state = Constants.RoundState.Waiting :: RoundStateName
RoundService._currentSession = nil :: MatchSession?
RoundService._sessionsById = {} :: { [SessionId]: MatchSession }
RoundService._sessionIdByUserId = {} :: { [number]: SessionId }
RoundService._participantByPlayer = {} :: { [Player]: SessionParticipant }
RoundService._closedSessionIds = {} :: { [SessionId]: boolean }
RoundService._maxConcurrentSessions = 1
RoundService._connections = {} :: { RBXScriptConnection }

-- Utilidad para garantizar existencia de Remotes
local function ensureRemoteFolder(parent: Instance, name: string): Folder
	local folder = parent:FindFirstChild(name)
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = name
		folder.Parent = parent
	end
	return folder :: Folder
end

local function ensureRemoteEvent(parent: Instance, name: string): RemoteEvent
	local event = parent:FindFirstChild(name)
	if not event then
		event = Instance.new("RemoteEvent")
		event.Name = name
		event.Parent = parent
	end
	return event :: RemoteEvent
end

local function runCleanupStep(label: string, callback: () -> ())
	local ok, err = pcall(callback)
	if not ok then
		warn(string.format("[RoundService] Falló limpieza '%s': %s", label, tostring(err)))
	end
end

function RoundService:_ensureRemotes()
	local remotesFolder = ensureRemoteFolder(ReplicatedStorage, "Remotes")
	local matchFolder = ensureRemoteFolder(remotesFolder, "Match")
	local matchmakingFolder = ensureRemoteFolder(remotesFolder, "Matchmaking")

	ensureRemoteEvent(matchFolder, "StateChanged")
	ensureRemoteEvent(matchFolder, "Countdown")
	ensureRemoteEvent(matchFolder, "MapSelection")
	ensureRemoteEvent(matchFolder, "MatchResult")
	ensureRemoteEvent(matchFolder, "EndCinematic")
	ensureRemoteEvent(matchFolder, "EndCinematicAction")
	ensureRemoteEvent(matchmakingFolder, "QueueStatus")
end

function RoundService:_getRemote(folderName: string, eventName: string): RemoteEvent?
	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	if not remotes then return nil end
	local folder = remotes:FindFirstChild(folderName)
	if not folder then return nil end
	local event = folder:FindFirstChild(eventName)
	if event and event:IsA("RemoteEvent") then
		return event
	end
	return nil
end

function RoundService:Init(context)
	self._context = context
	self._state = Constants.RoundState.Waiting
	self._currentSession = nil
	self._sessionsById = {}
	self._sessionIdByUserId = {}
	self._participantByPlayer = {}
	self._maxConcurrentSessions = 1
	self._connections = {}
	self._rewardedMatches = {}

	-- Validar existencia de Workspace.Lobby.SpawnLocation
	local lobby = workspace:FindFirstChild("Lobby")
	local spawnLocation = lobby and lobby:FindFirstChild("SpawnLocation")
	if not spawnLocation then
		warn("[RoundService] Lobby SpawnLocation not found")
	end

	-- Garantizar Remotes requeridos
	self:_ensureRemotes()

	-- Manejar votos de mapa desde clientes
	local mapSelectionRemote = self:_getRemote("Match", "MapSelection")
	if mapSelectionRemote then
		table.insert(self._connections, mapSelectionRemote.OnServerEvent:Connect(function(player: Player, mapName: string, sessionId: SessionId?)
			self:SubmitMapVote(player, mapName, sessionId)
		end))
	end

	-- Manejar desconexiones de jugadores durante la partida
	local cinematicAction = self:_getRemote("Match", "EndCinematicAction")
	if cinematicAction then
		table.insert(self._connections, cinematicAction.OnServerEvent:Connect(function(player, action, sessionId, version, token)
			self:HandleCinematicAction(player, action, sessionId, version, token)
		end))
	end

	table.insert(self._connections, Players.PlayerRemoving:Connect(function(player: Player)
		self:_handlePlayerLeaving(player)
	end))
end

function RoundService:Start(context)
	self._context = context
	print("[RoundService] Servicio iniciado. Estado: Waiting")
end

function RoundService:_getMatchInstanceService()
	if self._context and self._context.GetService then
		local s = self._context:GetService("MatchInstanceService")
		if s then return s end
	end

	local servicesFolder = game:GetService("ServerScriptService"):FindFirstChild("Services")
	local mod = servicesFolder and servicesFolder:FindFirstChild("MatchInstanceService")
	if mod and mod:IsA("ModuleScript") then
		local ok, result = pcall(require, mod)
		if ok then return result end
	end
	return nil
end

