        <Item class="ModuleScript" referent="1791">
          <Properties>
            <string name="Name">CrateStandCinematicController</string>
            <string name="Source"><![CDATA[--!nonstrict
local Players=game:GetService("Players")
local RS=game:GetService("ReplicatedStorage")
local Run=game:GetService("RunService")
local Tween=game:GetService("TweenService")
local CAS=game:GetService("ContextActionService")
local Config=require(RS.Shared.SlapCrates.OpeningConfig)
local Timeline=require(RS.Shared.SlapCrates.OpeningTimeline)
local Catalog=require(RS.Shared.SlapCrates.Catalog)
local Appearance=require(RS.Shared.SlapCrates.Appearance)
local CameraLease=require(script.Parent.Parent.CrateOpening.CameraLease)
local CharacterVisibility=require(script.Parent.Parent.CrateOpening.CharacterVisibility)
local CinematicConfig=require(script.Parent.Parent.CrateOpening.CinematicConfig)
local CinematicMotion=require(script.Parent.Parent.CrateOpening.CinematicMotion)
local CinematicTransition=require(script.Parent.Parent.CrateOpening.CinematicTransition)
local StandPromptVisibility=require(script.Parent.Parent.CrateOpening.StandPromptVisibility)
local RewardGallery=require(script.Parent.Parent.CrateOpening.RewardGallery)
local RewardSpin3D=require(script.Parent.Parent.CrateOpening.RewardSpin3D)
local RewardVFX=require(script.Parent.Parent.CrateOpening.RewardVFX)
local RewardRevealProfile=require(script.Parent.Parent.CrateOpening.RewardRevealProfile)
local Batch=require(RS.Shared.SlapCrates.BatchOpening)
local VisualProfile=require(script.Parent.Parent.CrateOpening.VisualProfile)
local OverlayPresenter=require(script.Parent.Parent.CrateOpening.RewardOverlayPresenter)
local Controller={Name="CrateStandCinematicController"}
local player=Players.LocalPlayer
local function safeVisual(model)
 for _,obj in ipairs(model:GetDescendants())do
  if obj:IsA("LuaSourceContainer")then obj:Destroy()
  elseif obj:IsA("BasePart")then obj.Anchored=true;obj.CanCollide=false;obj.CanTouch=false;obj.CanQuery=false
  elseif obj:IsA("ParticleEmitter")then obj.Enabled=false;obj.Rate=math.min(obj.Rate,8)end
 end
end
local function standById(id)
 local folder=workspace:FindFirstChild("CrateStands");local result
 for _,stand in ipairs(folder and folder:GetChildren()or {})do if stand:GetAttribute("StandId")==id then if result then return nil end;result=stand end end
 return result
end
function Controller:Init(context)
 self._context=context;self._runs={};self._seen={};self._idle={};self._connections={};self._cooldowns={}
 self._plan=Timeline.Build(Config)
end
function Controller:IsPlaying()return self._private~=nil end
function Controller:_priority()
 local ending=self._context:GetController("EndCinematicController")
 return player:GetAttribute("MatchId")~=nil or player:GetAttribute("ResultsSessionId")~=nil or(ending and ending:IsPlaying())
end
function Controller:_restore(run)
 if run.Restored then return end;run.Restored=true
 if run.Action then CAS:UnbindAction(run.Action)end
 local character=player.Character;local humanoid=character and character:FindFirstChildOfClass("Humanoid")
 if humanoid and humanoid.Health<=0 then character=nil end
 if run.Lease then CameraLease.Restore(run.Lease,character,self:_priority()or workspace.CurrentCamera~=run.Lease.Camera)end
 CharacterVisibility.Release(run.Visibility);run.Visibility=nil
 if run.MusicToken then
  local music=self._context:GetController("MusicController")
  if music then music:Resume("CrateStand:"..run.Id,run.MusicToken,.3)end
 end
end
function Controller:_stop(id,reason)
 local run=self._runs[id];if not run then return end
 self._runs[id]=nil
 local restored,failure=pcall(self._restore,self,run)
 if not restored then warn("[CrateStand] Restore failure: "..tostring(failure))end
 CharacterVisibility.Release(run.Visibility);run.Visibility=nil
 StandPromptVisibility.Release(run.PromptVisibility);run.PromptVisibility=nil
 if self._private==run then self._private=nil end
 if run.Private and reason~="ServerRelease"and self._request then
  -- A late cleanup can only release its own authoritative OpeningId.
  local request=self._request;local openingId=run.Id
  task.spawn(function()pcall(request.InvokeServer,request,"CancelOpening",{OpeningId=openingId})end)
 end
 for _,t in ipairs(run.Tweens)do pcall(function()t:Cancel();t:Destroy()end)end
 for _,obj in ipairs(run.Objects)do pcall(function()obj:Destroy()end)end
 if run.Private and self._overlay then self._overlay:Reset(run.Id)end
 if run.Private and self._hud then
  CinematicTransition.Reset(self._hud)
  self._hud.Enabled=false;self._hud.Transition.BackgroundTransparency=1;self._hud.Flash.BackgroundTransparency=1
  self._hud.Transition.Visible=false;self._hud.Flash.Visible=false
 end
end
function Controller:_sound(run,name)
 local sound=run.Effects:FindFirstChild(name,true)
 if sound and sound:IsA("Sound")and sound.SoundId~=""then sound:Play()end
end
function Controller:_whoosh(run,name)
 if not run.Private then return end
 local source=run.Effects:FindFirstChild(name,true)
 if source and source:IsA("Sound")and source.SoundId~=""then
  local sound=source:Clone();sound.Volume=CinematicConfig.Audio.Volume
  sound.Parent=game:GetService("SoundService");table.insert(run.Objects,sound);sound:Play()
 end
end
function Controller:_phase(run,stage)
 if stage==run.Stage then return end;run.Stage=stage
 self:_sound(run,stage)
 VisualProfile.Emit(run.Effects,stage,run.Profile)
 if run.CrateDefinition and run.CrateDefinition.PremiumOnly and run.Chest then VisualProfile.Emit(run.Chest,stage,run.Profile)end
 if stage=="Intro"then self:_whoosh(run,CinematicConfig.Audio.Close)
 elseif stage=="CameraReveal"and run.Private then
  run.Visibility=CharacterVisibility.Acquire(Players,run.Id)
  run.Lease.Camera.CameraType=Enum.CameraType.Scriptable
  self:_whoosh(run,CinematicConfig.Audio.Open)
 elseif stage=="Outro"then
  self:_whoosh(run,CinematicConfig.Audio.Close)
 end
 if stage=="Flash"then
  if run.Private then
   self._hud.Flash.BackgroundTransparency=.25
   local t=Tween:Create(self._hud.Flash,TweenInfo.new(Config.Cinematic.FlashDuration),{BackgroundTransparency=1})
   table.insert(run.Tweens,t);t:Play()
  end
 elseif stage=="Reward"then
  if not run.Gallery and not run.Spin3D then self:_revealWinner(run,run.Plan and run.Plan.Stages[8].Start or 0)end
 end
end
function Controller:_revealWinner(run,elapsed)
 if run.Revealed then return end;run.Revealed=true
 run.Reward.Parent=run.Scene;run.Label.Enabled=true;self:_showReward(run)
 if run.RewardSound and run.RewardSound.SoundId~=""then run.RewardSound:Play()end
 if run.RewardVFX then RewardVFX.Reveal(run,run.RewardVFX,elapsed)else
  for _,item in ipairs(run.Reward:GetDescendants())do if item:IsA("ParticleEmitter")then item:Emit(math.min(item:GetAttribute("RevealBurstCount")or 6,12))end end
 end
end
function Controller:_showReward(run)
 if not run.RewardDefinition then return end
 if run.Private and self._overlay and CinematicConfig.RewardOverlayByMode.StandCinematic then
  self._overlay:Show(run,Catalog.Slaps.ById[run.RewardDefinition.SlapId],run.RewardVariation)
 end
 local special=if run.GlobalFX then run.GlobalFX.Profile and run.GlobalFX.Profile.Rank>=4 else run.Profile and run.Profile.Special
 if special and not run.SpecialPlayed then run.SpecialPlayed=true;self:_sound(run,"Special")end
end
function Controller:Play(packet)
 if not self._plan or packet.Mode~="StandCinematic"or type(packet.OpeningId)~="string"or self._seen[packet.OpeningId]
  or type(packet.StartedAt)~="number"or packet.StartedAt~=packet.StartedAt or type(packet.Operation)~="table"then return end
 local age=workspace:GetServerTimeNow()-packet.StartedAt
 local quantity=Batch.Quantity(packet.Operation.Quantity);if not quantity then return end
 local plan=Timeline.Build(Config,quantity);if not plan then return end
 if age< -1 or age>=plan.Duration or self:_priority()then return end
 if quantity>1 then
  if type(packet.Operation.Rewards)~="table"or #packet.Operation.Rewards~=quantity then return end
  for _,unit in ipairs(packet.Operation.Rewards)do if type(unit)~="table"or not Catalog.Rewards[unit.RewardId]then return end end
 end
 local stand=standById(packet.StandId);local reward=Catalog.Rewards[packet.Operation.RewardId]
 local crate=Catalog.Crates.ById[packet.Operation.CrateId]
 if not stand or not reward or not crate then return end
 local private=packet.BuyerUserId==player.UserId
 if not private and packet.Exclusive~=true then return end
 if private and self._private then
  local old=self._private
  if workspace:GetServerTimeNow()-old.Packet.StartedAt>=(old.Plan or self._plan).Duration then self:_stop(old.Id,"Completed")else return end
 end
 local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
 local radius=if private then Config.Stand.MaxActivationDistance else Config.Stand.SpectatorRadius
 if not root or(root.Position-stand.InteractionPart.Position).Magnitude>radius then return end
 local count=0;for _ in pairs(self._runs)do count+=1 end;if count>=6 then return end
 local run={Id=packet.OpeningId,Packet=packet,Stand=stand,Plan=plan,Private=private,Objects={},Tweens={},Character=player.Character}
 run.CrateDefinition=crate
 local input=game:GetService("UserInputService")
 run.VisualBudget=RewardVFX.Budget(input and input.TouchEnabled==true,quantity)
 local best,index=RewardRevealProfile.Best(Batch.Rewards(packet.Operation),Catalog)
 run.GlobalFX={Profile=best,Index=index,At=plan.Stages[8].Start+(if quantity>1 then ((index or 1)-1)*CinematicConfig.Gallery.Stagger else 0)}
 self._seen[run.Id]=packet.StartedAt;self._runs[run.Id]=run
 local ok,err=pcall(function()
  if private then
   local premium=self._context:GetController("PremiumShopController");if premium then premium:Close()end
   run.Lease=CameraLease.Acquire(workspace.CurrentCamera,run.Id,player.Character);assert(run.Lease,"CameraBusy")
   self._private=run
   if CinematicConfig.HideStandPrompt then run.PromptVisibility=StandPromptVisibility.Acquire(stand,run.Id)end
   local shop=self._context:GetController("ShopController");if shop then shop:Close()end
   local crates=self._context:GetController("CrateController");if crates and crates._panel then crates._panel.Visible=false end
   self._hud.Enabled=true;self._hud.Transition.BackgroundTransparency=1;self._hud.Flash.BackgroundTransparency=1
   self._hud.Transition.Visible=true;self._hud.Flash.Visible=true
   if self._overlay then self._overlay:Reset()end
   local overlay=self._hud:FindFirstChild("RewardOverlay");if overlay then overlay.Visible=false end
   CinematicTransition.Reset(self._hud)
   run.Action="CrateStand:"..run.Id
   CAS:BindActionAtPriority(run.Action,function()return Enum.ContextActionResult.Sink end,false,3000,table.unpack(Enum.PlayerActions:GetEnumItems()))
   local music=self._context:GetController("MusicController");if music then run.MusicToken=music:Suspend("CrateStand:"..run.Id,.3)end
  end
  local scene=stand.PresentationTemplate:Clone();scene.Name="CratePresentation_"..run.Id;scene.Parent=workspace
  table.insert(run.Objects,scene);run.Scene=scene;run.Effects=scene.Effects
  run.Effects:PivotTo(stand.SpawnPoint.CFrame);safeVisual(scene)
  local fx=run.Effects.FXAnchor;fx.EnergyBeam.Attachment0=fx.EnergyFrom;fx.EnergyBeam.Attachment1=fx.EnergyTo
  run.Chest=assert(RS.CrateEffects:FindFirstChild(crate.Model)):Clone();safeVisual(run.Chest)
  run.Chest.Parent=scene;table.insert(run.Objects,run.Chest);run.BaseScale=run.Chest:GetScale()
  local palette={};local paletteSeen={}
  for _,id in ipairs(packet.Operation.PreviewRewardIds or {})do
   local d=Catalog.Rewards[id];local v=d and Catalog.Variations.ById[d.VariationId]
   if v and not paletteSeen[v.Id]then paletteSeen[v.Id]=true;table.insert(palette,v.Color)end
  end
  local bestUnit=Batch.Rewards(packet.Operation)[index or 1]
  local bestReward=Catalog.Rewards[bestUnit.RewardId]
  run.ChestVFX=RewardVFX.Chest(run,run.Chest,palette,Catalog.Variations.ById[bestReward.VariationId])
  local previews=RS:FindFirstChild("SlapVariationPreviews");local slap=previews and previews:FindFirstChild(reward.SlapId)
  local source=slap and slap:FindFirstChild(reward.VariationId)
  source=source or RS.CrateRewardPreviews:FindFirstChild(reward.SlapId);assert(source,"RewardPreviewMissing")
  run.Reward=source:Clone();table.insert(run.Objects,run.Reward);safeVisual(run.Reward)
  local variation=Catalog.Variations.ById[reward.VariationId]
  run.Profile=VisualProfile.For(variation);run.RewardDefinition=reward
  local part=run.Reward:FindFirstChildWhichIsA("BasePart",true)
  if part then
   local profile=RS.SlapVariationEffects:FindFirstChild(variation.VisualProfile)
   Appearance.Apply(part,profile)
   local sound=profile and profile:FindFirstChild(variation.SFX,true)
   if sound and sound:IsA("Sound")then run.RewardSound=sound:Clone();run.RewardSound.Parent=part end
  end
  run.Label=scene.RewardBillboard;run.Label.Adornee=scene.RewardAnchor
  run.Label.Title.Text="¡RECOMPENSA OBTENIDA!";run.Label.Slap.Text=Catalog.Slaps.ById[reward.SlapId].DisplayName
  run.Label.Variation.Text=variation.DisplayName;run.Label.Variation.TextColor3=variation.Color
  run.RewardVariation=variation
  local beam=fx.EnergyBeam;run.BeamWidth=beam.Width0;beam.Color=ColorSequence.new(variation.Color)
  for _,item in ipairs(run.Effects:GetDescendants())do if item:IsA("PointLight")then item.Color=variation.Color end end
  if quantity>1 then run.Label.Enabled=false;run.Gallery=RewardGallery.Create(run,packet.Operation.Rewards,safeVisual)end
  if quantity==1 then
   run.RewardVFX=RewardVFX.Attach(run,run.Reward,variation,packet.Operation.EffectivePercent,true)
   run.Spin3D=RewardSpin3D.Create(run,packet.Operation.PreviewRewardIds,safeVisual)
   if run.Spin3D then run.Label.Enabled=false;run.GlobalFX.At=plan.Stages[8].Start+Config.RewardSpin.SpinDuration end
  end
  if age>=plan.Stages[8].Start then
   if not run.Gallery and not run.Spin3D then self:_revealWinner(run,age)end
  end
  self:_sound(run,"Start")
 end)
 if not ok then warn("[CrateStand] Presentation failed; reward retained: "..tostring(err));self:_stop(run.Id,"Error")end
end
function Controller:_update(run,now)
 if not run.Stand.Parent or player.Character~=run.Character or self:_priority()then self:_stop(run.Id,"ContextChanged");return end
 local hum=run.Character and run.Character:FindFirstChildOfClass("Humanoid")
 if not hum or hum.Health<=0 then self:_stop(run.Id,"CharacterLost");return end
 if run.Private and not run.Restored and(not CameraLease.Owns(run.Lease)or workspace.CurrentCamera~=run.Lease.Camera)then self:_stop(run.Id,"CameraLost");return end
 local plan=run.Plan or self._plan
 local elapsed=now-run.Packet.StartedAt;local stage,p=Timeline.At(plan,elapsed)
 if stage=="Done"then self:_stop(run.Id,"Completed");return end
 self:_phase(run,stage)
 if run.Private then CinematicTransition.Update(self._hud,CinematicMotion.Cover(stage,p,CinematicConfig.Transition))end
 local profile=run.Profile or {Light=1,Bob=.15,Spin=.65,Zoom=4}
 local height,scale=VisualProfile.Pose(stage,p)
 local pose=run.Stand.SpawnPoint.CFrame*CFrame.new(0,height,0)*CFrame.Angles(0,VisualProfile.Rotation(plan,elapsed),0)
 if stage=="Shake"then local strength=.025+.065*p;pose*=CFrame.new(math.sin(elapsed*55)*strength,math.cos(elapsed*47)*strength*.7,0)end
 if stage~="Reward"and stage~="Outro"and(stage~="Flash"or p<.25)then
  run.Chest:PivotTo(pose);run.Chest:ScaleTo(run.BaseScale*scale)
 else run.Chest.Parent=nil end
 run.Scene.RewardAnchor.CFrame=run.Stand.RewardPoint.CFrame
 if run.Reward.Parent and not run.Spin3D then run.Reward:PivotTo(run.Stand.RewardPoint.CFrame*CFrame.new(0,math.sin(elapsed*2)*profile.Bob,0)*CFrame.Angles(0,elapsed*profile.Spin,0))end
 if run.Spin3D and RewardSpin3D.Update(run,elapsed,workspace.CurrentCamera)then self:_revealWinner(run,elapsed)end
 if run.RewardVFX then RewardVFX.Update(run.RewardVFX,elapsed);RewardVFX.Label(run.RewardVFX,run.Label,elapsed)end
 if run.ChestVFX then RewardVFX.UpdateChest(run.ChestVFX,stage,p,elapsed)end
 if run.Gallery then RewardGallery.Update(run,elapsed,workspace.CurrentCamera)end
 if run.PrimaryRewardRevealed then self:_showReward(run)end
 local light=run.Effects:FindFirstChildWhichIsA("PointLight",true)
 if light then light.Brightness=(if stage=="Flash"then (1-p)*3 elseif stage=="Growth"or stage=="Shake"then .8+p else .3)*profile.Light end
 run.Effects.FXAnchor.EnergyBeam.Enabled=stage=="Growth"or stage=="Shake"
 if run.BeamWidth then run.Effects.FXAnchor.EnergyBeam.Width0=run.BeamWidth*(.92+.08*math.sin(elapsed*4))end
 if run.Private then
  if stage=="Outro"and p>=CinematicConfig.Transition.OutroHandoff then
   if not run.Restored then
    CinematicTransition.Update(self._hud,.5)
    self:_restore(run);self:_whoosh(run,CinematicConfig.Audio.Open)
   end
  elseif stage~="Intro"and not run.Restored then
   local camera=run.Lease.Camera;local cameraPoint=run.Stand.CameraPoint
   -- Late packets can skip CameraReveal; acquire before the first camera write.
   if not run.Visibility then run.Visibility=CharacterVisibility.Acquire(Players,run.Id)end
   camera.CameraType=Enum.CameraType.Scriptable
   local focus=if stage=="Reward"or stage=="Outro"then run.Stand.RewardPoint.Position else pose.Position
   local dt=math.clamp(now-(run.LastCameraAt or now),0,.1);run.LastCameraAt=now
   local c=CinematicConfig.Camera
   run.CameraFocus=if run.CameraFocus then run.CameraFocus:Lerp(focus,1-math.exp(-c.FocusResponse*dt))else focus
   local motion=CinematicMotion.Sample(plan,elapsed,stage,p,c)
   local position=cameraPoint.Position:Lerp(focus,c.PushIn*math.sin(math.min(elapsed,8)*.2))
    +cameraPoint.CFrame.UpVector*c.IntroHeight*motion.Drop
    -cameraPoint.CFrame.LookVector*c.IntroBack*motion.Drop
   local target=run.CameraFocus+cameraPoint.CFrame.UpVector*c.IntroLookHeight*motion.Drop
   if run.Gallery and(stage=="Flash"or stage=="Reward"or stage=="Outro")then
    local desired=RewardGallery.CameraPosition(run,position)
    local blend=if stage=="Flash"then p*p*(3-2*p)else 1
    position=position:Lerp(desired,blend)
   elseif run.Spin3D and(stage=="Flash"or stage=="Reward"or stage=="Outro")then
    local desired=RewardSpin3D.CameraPosition(run,position)
    position=position:Lerp(desired,if stage=="Flash"then p*p*(3-2*p)else 1)
   end
   if run.GlobalFX then
    local x,y,angle=RewardVFX.Reaction(run.GlobalFX.Profile,elapsed-run.GlobalFX.At,run.VisualBudget.Mobile)
    motion.X=math.clamp(motion.X+x,-c.MaxPositionShake,c.MaxPositionShake)
    motion.Y=math.clamp(motion.Y+y,-c.MaxPositionShake,c.MaxPositionShake)
    motion.Pitch=math.clamp(motion.Pitch+angle,-math.rad(c.MaxDegreesShake),math.rad(c.MaxDegreesShake))
   end
   camera.CFrame=CFrame.lookAt(position,target,cameraPoint.CFrame.UpVector)
    *CFrame.new(motion.X,motion.Y,0)*CFrame.Angles(motion.Pitch,0,motion.Roll)
   camera.FieldOfView=math.clamp(run.Lease.FieldOfView-profile.Zoom*math.clamp(elapsed/plan.Duration,0,1)+motion.Fov,35,100)
  end
 end
end
function Controller:_idleUpdate(now)
 if now-(self._idleAt or -math.huge)<1/30 then return end;self._idleAt=now
 local updateLabels=now>=(self._labelsAt or 0);if updateLabels then self._labelsAt=now+.25 end
 local folder=workspace:FindFirstChild("CrateStands")
 for _,stand in ipairs(folder and folder:GetChildren()or {})do
  local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
  local base=stand:FindFirstChild("Base")
  if root and base and(root.Position-base.Position).Magnitude>math.max(60,Config.Stand.SpectatorRadius*2)then continue end
  local cache=self._idle[stand]
  if not cache then
   cache={Parts={},Lights={},Previews={}};self._idle[stand]=cache
   local decor=stand:FindFirstChild("VisualDecor")
   for _,item in ipairs(decor and decor:GetDescendants()or {})do
    if item:IsA("BasePart")and(item:GetAttribute("IdleMotion")or item.Parent.Name=="Shards"or item.Name=="Ring")then
     table.insert(cache.Parts,{Object=item,Pose=stand:GetPivot():ToObjectSpace(item.CFrame),Kind=item:GetAttribute("IdleMotion")or(if item.Name=="Ring"then "Rotate"else "Float")})
    elseif item:IsA("PointLight")then table.insert(cache.Lights,{Object=item,Brightness=item.Brightness})end
   end
  end
  for i,row in ipairs(cache.Parts)do if row.Object.Parent then
   local offset=if row.Kind=="Rotate"then CFrame.Angles(0,now*.16,0)else CFrame.new(0,math.sin(now*.9+i)*.12,0)*CFrame.Angles(0,math.sin(now*.5+i)*.06,0)
   row.Object.CFrame=stand:GetPivot()*row.Pose*offset
  end end
  for i,row in ipairs(cache.Lights)do if row.Object.Parent then row.Object.Brightness=row.Brightness*(.9+.1*math.sin(now*1.1+i))end end
  local anchors=stand:FindFirstChild("PreviewAnchors");local index=0
  for _,anchor in ipairs(anchors and anchors:GetChildren()or {})do
   if not anchor:IsA("BasePart")then continue end;index+=1
   local model=anchor:FindFirstChild("Decoration");local gui=anchor:FindFirstChildWhichIsA("BillboardGui")
   local visible=index<=Config.Stand.MaxIdleCrates and stand:GetAttribute("OpeningState")=="Idle"
    and not(self._private and self._private.Stand==stand)
   if model then
    local authored=cache.Previews[anchor]
    if not authored or authored.Model~=model then
     authored={Model=model,Pose=anchor.CFrame:ToObjectSpace(model:GetPivot())};cache.Previews[anchor]=authored
    end
    for _,part in ipairs(model:GetDescendants())do if part:IsA("BasePart")then part.LocalTransparencyModifier=if visible then 0 else 1 end end
    if visible then model:PivotTo(anchor.CFrame*CFrame.new(0,math.sin(now*1.2+index)*.15,0)*CFrame.Angles(0,now*.2,0)*authored.Pose)end
   end
   if gui then
    gui.Enabled=visible
    local crate=Catalog.Crates.ById[anchor:GetAttribute("CrateId")]
    if crate and updateLabels then
     gui.Title.Text=crate.DisplayName
     gui.Price.Text=if crate.PriceApproved then tostring(crate.PriceCoins).." Coins"else "Precio pendiente"
     gui.Status.Text=if not crate.OddsApproved then "Probabilidades pendientes"elseif not crate.Enabled then "No disponible"else "Ver probabilidades"
     local variation=Catalog.Variations.ById[crate.CrateId];if variation then gui.Title.TextColor3=variation.Color end
    end
   end
  end
 end
 for stand in pairs(self._idle)do if not stand.Parent then self._idle[stand]=nil end end
end
function Controller:_cooldownUpdate(now)
 local label=self._hud and self._hud:FindFirstChild("CooldownLabel");if not label then return end
 if Config.Stand.ReopenCooldown==0 then
  table.clear(self._cooldowns);label.Visible=false;if not self._private then self._hud.Enabled=false end;return
 end
 for id,at in pairs(self._cooldowns)do if at<=now then self._cooldowns[id]=nil end end
 local crates=self._context:GetController("CrateController");local standId=crates and crates._standId
 local deadline=standId and self._cooldowns[standId]or 0
 local show=deadline>now and not self._private and not self:_priority()
 label.Visible=show
 if show then label.Text="ESPERA PERSONAL · "..tostring(standId).." · "..string.format("%.1f",deadline-now).." s";self._hud.Enabled=true
 elseif not self._private then self._hud.Enabled=false end
end
function Controller:Start()
 task.spawn(function()
  self._hud=player:WaitForChild("PlayerGui"):WaitForChild("CrateOpeningHUD",15)
  local remotes=RS:WaitForChild("Remotes"):WaitForChild("Crates",15)
  if not self._hud or not remotes then warn("[CrateStand] Missing Edit resources");return end
  self._request=remotes:WaitForChild("Request",15)
  self._hud.Enabled=false
  local cooldownLabel=self._hud:FindFirstChild("CooldownLabel")
  if cooldownLabel and Config.Stand.ReopenCooldown==0 then cooldownLabel.Visible=false end
  self._overlay=OverlayPresenter.new(self._hud:FindFirstChild("RewardOverlay"))
  table.insert(self._connections,remotes:WaitForChild("StandPresentation").OnClientEvent:Connect(function(packet)
   if type(packet)~="table"then return end
   if packet.Kind=="Access"then
    local crates=self._context:GetController("CrateController");if crates then crates._standId=packet.StandId end
    local shop=self._context:GetController("ShopController");if shop and not self:_priority()and not self:IsPlaying()then shop:OpenCategory("Crates")end
   elseif packet.Kind=="Cancel"then
    self:_stop(packet.OpeningId,"ServerRelease")
    if type(packet.StandId)=="string"and type(packet.CooldownUntil)=="number"and packet.CooldownUntil<workspace:GetServerTimeNow()+60 then self._cooldowns[packet.StandId]=packet.CooldownUntil end
   elseif packet.Kind=="Opening"then self:Play(packet)end
  end))
  table.insert(self._connections,Run.RenderStepped:Connect(function()
   local now=workspace:GetServerTimeNow()
   self:_cooldownUpdate(now)
   for id,at in pairs(self._seen)do if now-at>60 then self._seen[id]=nil end end
   for id,run in pairs(self._runs)do
    local ok,err=pcall(self._update,self,run,now)
    if not ok then warn("[CrateStand] "..tostring(err));self:_stop(id,"Error")end
   end
   if self._plan and Config.Mode=="StandCinematic"and Config.Stand.Enabled then self:_idleUpdate(now)end
  end))
 end)
end
function Controller:Destroy()
 for id in pairs(self._runs)do self:_stop(id,"Destroy")end
 for _,connection in ipairs(self._connections)do connection:Disconnect()end
 self._cooldowns={}
 for stand,cache in pairs(self._idle)do if stand.Parent then
  for anchor,row in pairs(cache.Previews)do if anchor.Parent and row.Model.Parent==anchor then row.Model:PivotTo(anchor.CFrame*row.Pose)end end
  for _,row in ipairs(cache.Parts)do if row.Object.Parent then row.Object.CFrame=stand:GetPivot()*row.Pose end end
  for _,row in ipairs(cache.Lights)do if row.Object.Parent then row.Object.Brightness=row.Brightness end end
 end end
 self._idle={}
 if self._hud then self._hud.Enabled=false end
end
return Controller
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1792">
          <Properties>
            <string name="Name">DeathFeedbackController</string>
            <string name="Source"><![CDATA[--!nonstrict
local Players=game:GetService("Players")
local Config=require(game.ReplicatedStorage.Shared.DeathFeedbackConfig)
local Catalog=require(game.ReplicatedStorage.Shared.DeathEffectDefinitions)
local Contract=require(game.ReplicatedStorage.Shared.DeathFeedbackContract)
local EffectPlayer=require(script.Parent.Parent.DeathFeedback.DeathEffectPlayer)
local Notifications=require(script.Parent.Parent.DeathFeedback.DeathNotifications)
local Controller={Name="DeathFeedbackController"}
local function trace(payload,phase,...)
 if type(payload)=="table" and payload.Debug then print("[RespawnDebug]",phase,payload.SessionId,payload.EliminationId,Players.LocalPlayer.UserId,payload.Generation,payload.Reason,payload.EffectId,...) end
end
function Controller:Init(context)
 self._context=context;self._seen={};self._effects={};self._connections={}
 self._state=nil;self._session=nil;self._version=-1
end
function Controller:Cleanup()
 self._cutoff=workspace:GetServerTimeNow()
 for _,scope in ipairs(self._effects) do scope:Destroy() end
 self._effects={}
 Notifications.Clear()
 local reward=self._context:GetController("KillRewardController")
 if reward then reward:Cleanup() end
end
function Controller:Receive(payload)
 local player=Players.LocalPlayer
 trace(payload,"FeedbackReceived",self._session,self._version,self._state)
 if type(payload)~="table" or type(payload.SessionId)~="string" or type(payload.EliminationId)~="string"
  or payload.SessionId~=player:GetAttribute("MatchId") or payload.SessionId~=self._session
  or payload.StateVersion~=self._version or not Contract.IsFeedbackState(self._state)
  or (payload.RewardOnly~=true and typeof(payload.ImpactCFrame)~="CFrame") or not Catalog[payload.EffectId]
  or (payload.Kind~="CreditedKill" and payload.Kind~="UnattributedFall")
  or type(payload.RewardCoins)~="number" or payload.RewardCoins~=payload.RewardCoins or payload.RewardCoins<0
  or type(payload.SentAt)~="number" or payload.SentAt<(self._cutoff or 0)
  or math.abs(workspace:GetServerTimeNow()-payload.SentAt)>Config.EventLifetime then
  trace(payload,"FeedbackRejectedContract","LocalVersion",self._version,"RemoteVersion",type(payload)=="table" and payload.StateVersion,"Cutoff",self._cutoff)
  return
 end
 local key=payload.SessionId..":"..payload.EliminationId
 if self._seen[key] then trace(payload,"FeedbackDuplicate");return end
 self._seen[key]=true
 for i=#self._effects,1,-1 do if self._effects[i].Dead then table.remove(self._effects,i) end end
 while #self._effects>=math.max(1,Config.DeathEffects.MaxConcurrentEffects) do table.remove(self._effects,1):Destroy() end
 if payload.RewardOnly~=true then
  local scope=EffectPlayer.Play(payload)
  table.insert(self._effects,scope)
  trace(payload,if scope.Dead then "EffectNotStarted" else "EffectStarted")
  Notifications.Play(payload)
 end
 local reward=self._context:GetController("KillRewardController")
 if reward then reward:PlayReceipt(payload) end
end
function Controller:Start()
 if self._started then return end;self._started=true
 local player=Players.LocalPlayer
 local match=game.ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Match")
 table.insert(self._connections,match:WaitForChild("StateChanged").OnClientEvent:Connect(function(state,metadata)
  if type(metadata)~="table" or metadata.SessionId~=player:GetAttribute("MatchId")
   or type(metadata.StateVersion)~="number" then return end
  if self._session==metadata.SessionId and metadata.StateVersion<self._version then return end
  if self._session~=metadata.SessionId then self:Cleanup();self._seen={} end
  self._session=metadata.SessionId;self._version=metadata.StateVersion;self._state=state
  if not Contract.IsFeedbackState(state) then self:Cleanup() end
 end))
 table.insert(self._connections,match:WaitForChild("DeathFeedback").OnClientEvent:Connect(function(payload)
  local ok,failure=pcall(self.Receive,self,payload)
  if not ok then warn("[DeathFeedback] "..tostring(failure));self:Cleanup() end
 end))
 table.insert(self._connections,player:GetAttributeChangedSignal("MatchId"):Connect(function()
  self:Cleanup();self._seen={};self._state=nil;self._session=nil;self._version=-1
  local reward=self._context:GetController("KillRewardController")
  if reward then reward:ResetSession() end
 end))
 -- Effect scopes contain only immutable impact snapshots/local clones, not Character references.
 table.insert(self._connections,Players.PlayerRemoving:Connect(function(leaving)if leaving==player then self:Cleanup() end end))
end
function Controller:Destroy()
 self:Cleanup()
 for _,connection in ipairs(self._connections) do connection:Disconnect() end
 self._connections={}
 self._started=false
end
return Controller
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1793">
          <Properties>
            <string name="Name">EndCinematicController</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Session-authorized presentation and independent Studio preview orchestrator.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Config = require(game.ReplicatedStorage.Shared.EndCinematicConfig)
local modules = script.Parent.Parent.EndCinematic.Modules
local Camera = require(modules.EndCinematicCamera)
local Transition = require(modules.EndCinematicTransition)
local Avatars = require(modules.EndCinematicAvatars)
local Animations = require(modules.EndCinematicAnimations)
local Particles = require(modules.EndCinematicParticles)
local Audio = require(modules.EndCinematicAudio)
local HUD = require(modules.EndCinematicHUD)
local Ranking = require(modules.EndCinematicRanking)
local Billboards = require(modules.EndCinematicBillboards)
local Controller = { Name = "EndCinematicController", _serial = 0 }

function Controller:Initialize()
 if self._initialized then return end
 self._initialized = true
end

function Controller:_getMusicController()
 if self._context and typeof(self._context.GetController) == "function" then
  return self._context:GetController("MusicController")
 end
 local controllers = script.Parent
 local musicScript = controllers and controllers:FindFirstChild("MusicController")
 if musicScript and musicScript:IsA("ModuleScript") then
  local ok, mod = pcall(require, musicScript)
  if ok then return mod end
 end
 return nil
end

function Controller:IsPlaying() return self._run ~= nil end

function Controller:SetPreviewOptions(floatingEnabled,billboardsEnabled)
 local run=self._run
 if not RunService:IsStudio() or not run or (run.Context and run.Context.IsMatch) then return false end
 run.FloatingEnabled=floatingEnabled
 run.BillboardsEnabled=billboardsEnabled
 if floatingEnabled then
  if run.CameraDone then Camera.StartFloating(run,run.Destination) end
 else Camera.StopFloating(run) end
 if not billboardsEnabled then Billboards.Cleanup(run)
 elseif run.CameraDone and run.WalksDone>=#run.Rigs then
  task.spawn(function()
   local ok,failure=pcall(Billboards.Play,run)
   if not ok and run:IsAlive() then warn(failure); self:Stop() end
  end)
 end
 return true
end

function Controller:Stop()
 local run = self._run
 if not run then return end
 self._run = nil
 self._serial += 1
 for _, connection in ipairs(run.Connections) do connection:Disconnect() end
 for _, tween in ipairs(run.Tweens) do tween:Cancel(); tween:Destroy() end
 -- Each subsystem cleans only its own resources; invalidation happens first.
 for _, subsystem in ipairs({ Animations, Audio, Particles, Billboards, Avatars, Transition, HUD, Camera }) do
  if subsystem.Cleanup then
   local ok, err = pcall(subsystem.Cleanup, run)
   if not ok then warn("[EndCinematic] Cleanup: " .. tostring(err)) end
  end
 end
 for _, object in ipairs(run.Resources) do object:Destroy() end
 if run.MusicReason then
  local musicController = self:_getMusicController()
  if musicController and typeof(musicController.Resume) == "function" then
   local fadeIn = (Config.Music and Config.Music.FadeInDuration) or 0.6
   musicController:Resume(run.MusicReason, run.MusicToken, fadeIn)
  end
  run.MusicReason = nil
  run.MusicToken = nil
 end
 if run.Context and run.Context.OnStopped then run.Context.OnStopped() end
end

function Controller:Destroy()
 self:Stop()
 self._initialized = false
end

local function finite(value)
 return type(value) == "number" and value == value and math.abs(value) < math.huge
end

function Controller:Play(data, sceneContext)
 self:Initialize()
 local isMatch = sceneContext and sceneContext.IsMatch == true
 if isMatch then
  if self._serverPlayback ~= sceneContext or sceneContext.Payload ~= data then return false, "UnauthorizedContext" end
 else
  if not RunService:IsStudio() then return false, "PreviewOnly" end
  if Players.LocalPlayer:GetAttribute("MatchId") ~= nil then return false, "MatchActive" end
 end
 if self:IsPlaying() then return false, "AlreadyPlaying" end
 local stage = sceneContext and sceneContext.Scene
 if not stage then return false, "SceneContextRequired" end
 if type(data) ~= "table" or type(data.Winners) ~= "table" or (#data.Winners < 1 and data.WinningTeam ~= "Draw") or #data.Winners > Config.Winners.MaxVisible then return false, "InvalidWinners" end
 if type(data.MatchId) ~= "string" or (data.WinningTeam ~= "Red" and data.WinningTeam ~= "Blue" and data.WinningTeam ~= "Draw") or type(data.Score) ~= "table" or not finite(data.Score.Red) or not finite(data.Score.Blue) then return false, "InvalidPayload" end
 if data.EligibleParticipantCount ~= nil and (not finite(data.EligibleParticipantCount) or data.EligibleParticipantCount < 1 or data.EligibleParticipantCount % 1 ~= 0) then return false, "InvalidParticipantCount" end
 local winners = {}
 for _, w in ipairs(data.Winners) do
  if type(w) ~= "table" or not finite(w.UserId) or w.UserId == 0 or type(w.DisplayName) ~= "string" or not finite(w.Slot) then return false, "InvalidWinner" end
  table.insert(winners, table.clone(w))
 end
 table.sort(winners, function(a,b) return a.Slot == b.Slot and a.UserId < b.UserId or a.Slot < b.Slot end)
 -- Explicit Mode always wins, including XvX with only one connected winner.
 -- Legacy no-Mode previews: one winner uses 1v1; multiple winners use XvX.
 local mode = data.Mode
 if mode == nil then mode = #winners == 1 and "1v1" or "XvX" end
 if type(mode) ~= "string" or mode == "" then return false, "InvalidMode" end
 local ranking,rankingError=Ranking.Resolve(data,isMatch)
 if not ranking then return false,rankingError end
 local visible=ranking.VisibleParticipants
 local from, target, cameraError = Camera.Resolve(stage, mode)
 if not from then return false, cameraError end
 local slots = stage:FindFirstChild("Players")
 for index = 1,#visible do
  local slot = slots and slots:FindFirstChild("SlotPlayer_" .. index)
  if not slot or not slot:IsA("BasePart") then return false, "InsufficientSlots" end
 end
 if not workspace.CurrentCamera then return false, "CameraMissing" end
 local gui, hudError = HUD.Resolve()
 if not gui then return false, hudError end
 self._serial += 1
 local run = { Id = self._serial, PlaybackId = self._serial, Mode = mode, Resources = {}, Connections = {}, Tweens = {}, Tracks = {}, Rigs = {}, WalksDone = 0, Destination = target }
 self._run = run
 run.Context = sceneContext
 run.Scene = stage
 run.Ranking=ranking
 run.WinningTeam=data.WinningTeam
 run.FloatingEnabled=not sceneContext or sceneContext.FloatingEnabled~=false
 run.BillboardsEnabled=not sceneContext or sceneContext.BillboardsEnabled~=false
 if not Config.Music or Config.Music.SuspendDuringCinematic ~= false then
  local musicController = self:_getMusicController()
  if musicController and typeof(musicController.Suspend) == "function" then
   local fadeOut = (Config.Music and Config.Music.FadeOutDuration) or 0.4
   local reason = if isMatch then "EndCinematic" else "EndCinematicPreview"
   run.MusicReason = reason
   run.MusicToken = musicController:Suspend(reason, fadeOut)
  end
 end
 function run:IsAlive() return Controller._run == self and Controller._serial == self.Id end
 function run:Tween(object, duration, properties)
  if not self:IsAlive() then return false end
  local tween = TweenService:Create(object, TweenInfo.new(math.max(duration,0.001), Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), properties)
  table.insert(self.Tweens,tween)
  tween:Play()
  local result = tween.Completed:Wait()
  return self:IsAlive() and result == Enum.PlaybackState.Completed
 end
 run.Container = Instance.new("Folder")
 run.Container.Name = "EndCinematicLocal_" .. run.Id
 run.Container.Parent = workspace
 table.insert(run.Resources,run.Container)
 local function stop() if run:IsAlive() then self:Stop() end end
 run.OnRigRemoved=stop
 local function guarded(callback)
  task.spawn(function()
   local ok,err = xpcall(callback,debug.traceback)
   if not ok and run:IsAlive() then warn("[EndCinematic] " .. tostring(err)); stop() end
  end)
 end
 table.insert(run.Connections,workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(stop))
 table.insert(run.Connections,stage.Destroying:Connect(stop))
 table.insert(run.Connections,Players.LocalPlayer.CharacterAdded:Connect(stop))
 table.insert(run.Connections,Players.LocalPlayer:GetAttributeChangedSignal("MatchId"):Connect(function()
  local id = Players.LocalPlayer:GetAttribute("MatchId")
  if (isMatch and id ~= data.MatchId) or (not isMatch and id ~= nil) then stop() end
 end))
 guarded(function()
  HUD.Prepare(run,gui,sceneContext and sceneContext.OnReturn or stop)
  run.Panels = Transition.Prepare(run)
  Audio.PlayTransition(run, true)
  if not Transition.Play(run,run.Panels,true) then return end
  Camera.Prepare(run,from)
  for index,winner in ipairs(visible) do
   if not run:IsAlive() then return end
   Avatars.Prepare(run,winner,slots["SlotPlayer_" .. index],stage,target)
  end
  if not run:IsAlive() then return end
  Billboards.Prepare(run)
  Particles.Prepare(run,stage)
  Audio.Prepare(run,stage)
  task.wait(Config.Transition.ClosedHoldDuration)
  if not run:IsAlive() then return end
  if isMatch then
   sceneContext.OnPrepared()
   local deadline = os.clock() + Config.Results.PreparationTimeout
   while run:IsAlive() and not sceneContext.StartAt and os.clock() < deadline do task.wait() end
   if not run:IsAlive() then return end
   if not sceneContext.StartAt then stop(); return end
   while run:IsAlive() and workspace:GetServerTimeNow() < sceneContext.StartAt do task.wait() end
   if not run:IsAlive() then return end
  end
  Particles.Play(run); Audio.Play(run)
  guarded(function()
   Camera.Play(run,from,target)
   if run:IsAlive() then Particles.Stop(run) end
  end)
  for index,entry in ipairs(run.Rigs) do guarded(function() Animations.Play(run,entry,index) end) end
  Audio.PlayTransition(run, false)
  if not Transition.Play(run,run.Panels,false) then return end
  while run:IsAlive() and (not run.CameraDone or run.WalksDone < #run.Rigs) do task.wait() end
  task.wait(Config.HUD.ShowDelay)
  if run:IsAlive() then
   Billboards.Play(run)
   HUD.Play(run,data,winners)
  end
 end)
 return true
end
function Controller:Init(context)
 self._context = context
 self:Initialize()
 self._closedResults = self._closedResults or {}
end

function Controller:Start()
 if self._remoteConnection then return end
 local match = game.ReplicatedStorage:WaitForChild("Remotes", 10)
 match = match and match:WaitForChild("Match", 10)
 local remote = match and match:WaitForChild("EndCinematic", 10)
 local actions = match and match:WaitForChild("EndCinematicAction", 10)
 if not remote or not actions then warn("[EndCinematic] Match remotes missing"); return end
 self._closedResults = self._closedResults or {}
 self._remoteConnection = remote.OnClientEvent:Connect(function(phase, payload)
  if type(payload) ~= "table" or type(payload.SessionId) ~= "string"
   or payload.MatchId ~= payload.SessionId or type(payload.Token) ~= "string"
   or not finite(payload.StateVersion) then return end
  local id = payload.SessionId
  local pending = self._serverPlayback
  if phase == "Returned" then
   if pending and pending.Payload.SessionId == id and pending.Payload.Token == payload.Token
    and pending.Payload.StateVersion == payload.StateVersion then
    pending.Exited = true
    self._closedResults[id] = true
    self:Stop()
    self._serverPlayback = nil
   end
   return
  end
  if phase == "Start" then
   if pending and pending.Payload.SessionId == id and pending.Payload.Token == payload.Token
    and pending.Payload.StateVersion == payload.StateVersion and not pending.Exited and finite(payload.StartAt) then
    pending.StartAt = pending.StartAt or payload.StartAt
   end
   return
  end
  if phase ~= "Prepare" or self._closedResults[id] or pending then return end
  if type(payload.EligibleParticipantUserIds) ~= "table"
   or not table.find(payload.EligibleParticipantUserIds, Players.LocalPlayer.UserId)
   or payload.SceneContainer ~= "Match_" .. id or payload.SceneName ~= "ScenarioFinal" then return end
  if Players.LocalPlayer:GetAttribute("MatchId") ~= id then return end
  self:Stop() -- Stop a development preview before claiming the real presentation.
  pending = { IsMatch = true, Payload = payload, Exited = false }
  self._serverPlayback = pending
  local function send(action)
   if pending.Exited or self._serverPlayback ~= pending then return end
   actions:FireServer(action, id, payload.StateVersion, payload.Token)
  end
  pending.OnReturn = function() send("Return") end
  pending.OnPrepared = function() send("Prepared") end
  pending.OnStopped = function()
   if not pending.Exited and self._serverPlayback == pending then
    send("Failed")
    pending.Exited = true
    self._closedResults[id] = true
    self._serverPlayback = nil
   end
  end
  task.spawn(function()
   local deadline = os.clock() + Config.Results.SceneWaitTimeout
   if typeof(payload.SceneOrigin) == "Vector3" then
    task.spawn(function() pcall(function() Players.LocalPlayer:RequestStreamAroundAsync(payload.SceneOrigin, Config.Results.SceneWaitTimeout) end) end)
   end
   local scene
   while self._serverPlayback == pending and not pending.Exited and os.clock() < deadline do
    local active = workspace:FindFirstChild("ActiveMatches")
    local container = active and active:FindFirstChild(payload.SceneContainer)
    local candidate = container and container:FindFirstChild(payload.SceneName)
    if candidate and candidate:IsA("Model") and candidate:GetAttribute("SessionId") == id
     and container:GetAttribute("SessionId") == id then
     local from = Camera.Resolve(candidate, payload.Mode)
     local slots = candidate:FindFirstChild("Players")
     local descriptions = candidate:FindFirstChild("WinnerDescriptions")
     local complete = from ~= nil and slots ~= nil and descriptions ~= nil
     local visible=payload.ResultSnapshot and payload.ResultSnapshot.VisibleParticipants or payload.Winners or {}
     for index, winner in ipairs(visible) do
      complete = complete and slots:FindFirstChild("SlotPlayer_" .. index) ~= nil
       and (not winner.DescriptionKey or descriptions:FindFirstChild(winner.DescriptionKey) ~= nil)
     end
     if complete then scene = candidate; break end
    end
    task.wait(.05)
   end
   if self._serverPlayback ~= pending or pending.Exited then return end
   if not scene or Players.LocalPlayer:GetAttribute("MatchId") ~= id then
    pending.OnStopped(); return
   end
   pending.Scene = scene
   local ok, reason = self:Play(payload, pending)
   if not ok then warn("[EndCinematic] Match presentation rejected: " .. tostring(reason)); pending.OnStopped() end
  end)
 end)
end
return Controller
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1794">
          <Properties>
            <string name="Name">KillRewardController</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Displays receipts only. Never modifies Coins or the authoritative PlayerHUD counter.
local Config=require(game.ReplicatedStorage.Shared.DeathFeedbackConfig).CoinRewardAnimation
local Scope=require(script.Parent.Parent.DeathFeedback.Scope)
local RunService=game:GetService("RunService")
local Controller={Name="KillRewardController"}
function Controller:Init() self._active={};self._seen={} end
function Controller:Cleanup()
 for _,scope in ipairs(self._active or {}) do scope:Destroy() end
 self._active={}
end
function Controller:ResetSession() self:Cleanup();self._seen={} end
function Controller:PlayGoalReceipt(receipt)
 local player=game.Players.LocalPlayer
 if type(receipt)~="table" or receipt.Kind~="CreditedGoal" or receipt.RecipientUserId~=player.UserId
  or type(receipt.EventId)~="string" or type(receipt.SessionId)~="string"
  or type(receipt.RewardCoins)~="number" or receipt.RewardCoins~=receipt.RewardCoins
  or receipt.RewardCoins<=0 or receipt.RewardCoins==math.huge then return end
 self:_playAward({SessionId=receipt.SessionId,EliminationId=receipt.EventId,RewardCoins=receipt.RewardCoins})
end
function Controller:Start()
 local playerRemotes=game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("Player")
 self._goalConnection=playerRemotes:WaitForChild("DataUpdated").OnClientEvent:Connect(function(_,receipt)
  self:PlayGoalReceipt(receipt)
 end)
end
function Controller:PlayReceipt(payload)
 local player=game.Players.LocalPlayer
 if not Config.Enabled or payload.KillerUserId~=player.UserId or payload.RewardCoins<=0
  or payload.Kind~="CreditedKill" or player:GetAttribute("MatchId")~=payload.SessionId then return end
 self:_playAward(payload)
end
function Controller:_playAward(payload)
 local player=game.Players.LocalPlayer
 if not Config.Enabled or player:GetAttribute("MatchId")~=payload.SessionId then return end
 local key=payload.SessionId..":"..payload.EliminationId
 if self._seen[key] then return end
 self._seen[key]=true
 local hud=player.PlayerGui:FindFirstChild("KillRewardHUD")
 if not hud then warn("[KillReward] Physical HUD missing");return end
 local target=hud:FindFirstChild("CoinTarget")
 local template=hud:FindFirstChild("CoinTemplate")
 local effects=hud:FindFirstChild("EffectsContainer")
 if not target or not template or not effects then warn("[KillReward] Incomplete physical HUD");return end
 for i=#self._active,1,-1 do if self._active[i].Dead then table.remove(self._active,i) end end
 while #self._active>=4 do table.remove(self._active,1):Destroy() end
 local scope=Scope.new();table.insert(self._active,scope)
 local rewardTemplate=hud:FindFirstChild("RewardAmountTemplate")
 if rewardTemplate then
  local label=scope:Add(rewardTemplate:Clone())
  label.Name="Reward_"..payload.EliminationId;label.RichText=false
  label.Text="+"..tostring(payload.RewardCoins).." Coins";label.Visible=true;label.Parent=effects
 end
 local sound=hud:FindFirstChild("RewardSound")
 if sound then
  sound=scope:Add(sound:Clone())
  if Config.SoundId~="" then sound.SoundId=Config.SoundId end
  sound.Volume=Config.SoundVolume;sound.Parent=hud
  if sound.SoundId~="" then sound:Play() end
 end
 local flights={}
 local count=math.clamp(math.floor(Config.CoinCount),1,16)
 for i=1,count do
  scope:Delay((i-1)*Config.Stagger,function()
   local coin=scope:Add(template:Clone())
   coin.Visible=true;coin.Name="Coin_"..i;coin.Parent=effects
   local start=template.AbsolutePosition+template.AbsoluteSize*.5-effects.AbsolutePosition
   local coinScale=coin:FindFirstChildOfClass("UIScale")
   if coinScale then coinScale.Scale*=.8+(i%3)*.15 end
   coin.AnchorPoint=Vector2.new(.5,.5)
   table.insert(flights,{Coin=coin,Start=start,At=os.clock(),Side=(i%2==0 and 1 or -1)*(15+i*5)})
  end)
 end
 local connection
 connection=RunService.RenderStepped:Connect(function()
  if scope.Dead then return end
  -- Read actual screen geometry each frame; never overwrite CoinTarget.Position.
  local finish=target.AbsolutePosition+target.AbsoluteSize*.5-effects.AbsolutePosition
  for i=#flights,1,-1 do
   local flight=flights[i]
   local progress=math.clamp((os.clock()-flight.At)/math.max(.001,Config.FlightDuration),0,1)
   local t=progress*progress*(3-2*progress)
   local control=(flight.Start+finish)*.5+Vector2.new(flight.Side,-Config.ArcHeight)
   local point=(1-t)^2*flight.Start+2*(1-t)*t*control+t^2*finish
   flight.Coin.Position=UDim2.fromOffset(point.X,point.Y)
   flight.Coin.Rotation=t*240
   if t>=1 then flight.Coin:Destroy();table.remove(flights,i) end
  end
 end)
 -- Scope also owns the single per-animation render connection.
 scope:Add({Destroy=function()connection:Disconnect()end})
 local arrivalTemplate=target:FindFirstChild("ArrivalTemplate")
 local endTime=(count-1)*Config.Stagger+Config.FlightDuration
 scope:Delay(endTime,function()
  if arrivalTemplate then
   local pulse=scope:Add(arrivalTemplate:Clone());pulse.Visible=true;pulse.Parent=target
   local scale=pulse:FindFirstChildOfClass("UIScale")
   if scale then scope:Tween(scale,.2,{Scale=scale.Scale*Config.ArrivalPulse}) end
   scope:Tween(pulse,.25,{BackgroundTransparency=1})
  end
 end)
 scope:Delay(endTime+.5,function()scope:Destroy()end)
end
return Controller
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1795">
          <Properties>
            <string name="Name">MatchController</string>
            <string name="Source"><![CDATA[--!strict
-- MatchController
-- Controlador de la interfaz de partida 1v1.
-- NO construye la UI mediante codigo; localiza y controla las instancias reales preexistentes en PlayerGui.MatchHUD.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local Constants = require(ReplicatedStorage.Shared.Constants)
local Config = require(ReplicatedStorage.Shared.Config)

local localPlayer = Players.LocalPlayer

type Palette = { Main: Color3, Shadow: Color3, Deep: Color3, Accent: Color3 }

type Pose = {
	Position: UDim2,
	Rotation: number,
	Scale: number,
	Transparency: number,
	Depth: number,
	ShineY: number,
}

type FxStack = {
	Root: Frame,
	Scale: UIScale,
	Layers: { TextLabel },
	Stroke: UIStroke?,
}

type BurstFx = {
	Container: Frame,
	Rings: { Frame },
	RingStrokes: { UIStroke },
	Sparks: { Frame },
	SparkAngles: { number },
	SparkReach: { number },
}

type CountdownFx = {
	Container: Frame,
	Extrusion: FxStack,
	Ghosts: { FxStack },
	Burst: BurstFx,
}

type CountdownRig = {
	Frame: Frame,
	Label: TextLabel,
	UIScale: UIScale,
	Stroke: UIStroke?,
	Gradient: UIGradient?,
	Fx: CountdownFx,
}

local MatchController = {}
MatchController.Name = "MatchController"

-- Referencias a instancias de PlayerGui.MatchHUD
MatchController._hud = nil :: ScreenGui?

-- StartCountdownFrame
MatchController._startCountdownFrame = nil :: Frame?
MatchController._startCountdownTitle = nil :: TextLabel?
MatchController._startCountdownLabel = nil :: TextLabel?
MatchController._startCountdownScale = nil :: UIScale?
MatchController._countdownAnimToken = 0
MatchController._countdownConn = nil :: RBXScriptConnection?
MatchController._countdownFx = nil :: CountdownFx?
MatchController._currentMatchId = nil :: string?
MatchController._lastStateVersion = 0

-- CountdownFrame
MatchController._countdownFrame = nil :: Frame?
MatchController._countdownTitle = nil :: TextLabel?
MatchController._countdownTimer = nil :: TextLabel?

-- MapSelectionFrame
MatchController._mapSelectionFrame = nil :: Frame?
MatchController._mapHeader = nil :: TextLabel?
MatchController._mapTimer = nil :: TextLabel?
MatchController._mapsContainer = nil :: Frame?
MatchController._mapButtonTemplate = nil :: TextButton?
MatchController._randomButton = nil :: TextButton?
MatchController._clonedButtons = {} :: { [string]: TextButton }

-- MatchTimerFrame
MatchController._matchTimerFrame = nil :: Frame?
MatchController._matchTimer = nil :: TextLabel?
MatchController._roundIndex = 0
MatchController._roundDeadline = nil :: number?
MatchController._clockSessionId = nil :: string?

-- ResultFrame
MatchController._resultFrame = nil :: Frame?
MatchController._resultTitle = nil :: TextLabel?
MatchController._resultSubtitle = nil :: TextLabel?

-- RedTeamFrame (Scoreboard)
MatchController._redTeamFrame = nil :: Frame?
MatchController._redScoreLabel = nil :: TextLabel?
MatchController._redPlayersContainer = nil :: Frame?

-- BlueTeamFrame (Scoreboard)
MatchController._blueTeamFrame = nil :: Frame?
MatchController._blueScoreLabel = nil :: TextLabel?
MatchController._bluePlayersContainer = nil :: Frame?

-- PlayerSlotTemplate
MatchController._playerSlotTemplate = nil :: Frame?
MatchController._clonedSlots = {} :: { Frame }

-- LastPointFrame
MatchController._lastPointFrame = nil :: Frame?
MatchController._lastPointTitle = nil :: TextLabel?
MatchController._lastPointSubtitle = nil :: TextLabel?
MatchController._lastPointToken = 0

-- Estado local
MatchController._currentState = Constants.RoundState.Waiting
MatchController._selectedMapVote = nil :: string?
MatchController._currentRole = nil :: string? -- "Red" | "Blue" | nil
MatchController._currentSelectedMap = nil :: string?
MatchController._context = nil :: any

local function formatTime(seconds: number): string
	local m = math.floor(seconds / 60)
	local s = seconds % 60
	return string.format("%d:%02d", m, s)
end

function MatchController:Init(context)
	self._context = context
	self._currentMatchId = nil
	self._lastStateVersion = 0
	self:_bindHUD()
end

function MatchController:GetCurrentMatchId(): string?
	return self._currentMatchId
end

function MatchController:GetStartCountdownFrame(): Frame?
	return self._startCountdownFrame
end

function MatchController:GetCurrentStateVersion(): number
 return self._lastStateVersion
end

function MatchController:GetCurrentState(): string
	return self._currentState
end

function MatchController:IsParticipant(): boolean
	return self._currentRole ~= nil
end

function MatchController:GetCurrentSelectedMap(): string?
	return self._currentSelectedMap
end

function MatchController:_payloadContainsLocalPlayer(payload: any): boolean
	if type(payload) ~= "table" or type(payload.ParticipantUserIds) ~= "table" then return false end
	return table.find(payload.ParticipantUserIds, localPlayer.UserId) ~= nil
end

function MatchController:_acceptSessionPayload(payload: any, allowBind: boolean, advanceVersion: boolean?): boolean
	if type(payload) ~= "table" then return false end
	local sessionId = payload.SessionId or payload.MatchId
	if type(sessionId) ~= "string" or sessionId == "" then return false end
	if self._retiredSessionIds and self._retiredSessionIds[sessionId] then return false end
	local version = payload.StateVersion
	if version ~= nil and type(version) ~= "number" then return false end

	if self._currentMatchId == nil then
		if not allowBind
			or localPlayer:GetAttribute("MatchId") ~= sessionId
			or not self:_payloadContainsLocalPlayer(payload) then
			return false
		end
		self._currentMatchId = sessionId
		self._lastStateVersion = 0
		local teams = payload.ParticipantTeams
		if type(teams) == "table" then
			self._currentRole = teams[localPlayer.UserId]
		end
	elseif self._currentMatchId ~= sessionId then
		return false
	end

	if version ~= nil and version < self._lastStateVersion then
		return false
	end
	if advanceVersion and version ~= nil then
		self._lastStateVersion = version
	end
	return true
end

function MatchController:_clearSessionIdentity(expectedSessionId: string)
	if self._currentMatchId ~= expectedSessionId then return end
	self._retiredSessionIds=self._retiredSessionIds or {}
	self._retiredSessionIds[expectedSessionId]=true
	self._roundIndex=0;self._roundDeadline=nil;self._clockSessionId=nil
	self._currentMatchId = nil
	self._lastStateVersion = 0
end

function MatchController:Start(context)
	self._context = context
	self:_setupButtonEvents()
	self:_connectRemotes()
 game:GetService("RunService").Heartbeat:Connect(function()
  if self._roundDeadline and self._clockSessionId==self._currentMatchId and self._currentState=="Playing" and self._matchTimer then
   self._matchTimer.Text=formatTime(math.max(0,math.ceil(self._roundDeadline-workspace:GetServerTimeNow())))
  end
 end)
	print("[MatchController] Controlador iniciado y enlazado a PlayerGui.MatchHUD")
end

function MatchController:_bindHUD()
	local playerGui = localPlayer:WaitForChild("PlayerGui")
	local hud = playerGui:WaitForChild("MatchHUD", 15) :: ScreenGui?
	if not hud then
		warn("[MatchController] No se encontro MatchHUD en PlayerGui")
		return
	end
	self._hud = hud

	-- 1. CountdownFrame
	local cdFrame = hud:WaitForChild("CountdownFrame", 10) :: Frame?
	if cdFrame then
		self._countdownFrame = cdFrame
		self._countdownTitle = cdFrame:WaitForChild("Title", 10) :: TextLabel?
		self._countdownTimer = cdFrame:WaitForChild("Timer", 10) :: TextLabel?
		cdFrame.Visible = false
	end

	-- 1.5 StartCountdownFrame
	local scFrame = hud:WaitForChild("StartCountdownFrame", 10) :: Frame?
	if scFrame then
		self._startCountdownFrame = scFrame
		self._startCountdownTitle = scFrame:WaitForChild("Title", 10) :: TextLabel?
		self._startCountdownLabel = scFrame:WaitForChild("CountdownLabel", 10) :: TextLabel?
		self._startCountdownScale = (self._startCountdownLabel and self._startCountdownLabel:FindFirstChildOfClass("UIScale")) :: UIScale?
		scFrame.Visible = false
	end

	-- 2. MapSelectionFrame
	local mapFrame = hud:WaitForChild("MapSelectionFrame", 10) :: Frame?
	if mapFrame then
		self._mapSelectionFrame = mapFrame
		self._mapHeader = mapFrame:WaitForChild("Header", 10) :: TextLabel?
		self._mapTimer = mapFrame:WaitForChild("Timer", 10) :: TextLabel?
		self._randomButton = mapFrame:WaitForChild("RandomButton", 10) :: TextButton?

		local container = mapFrame:WaitForChild("MapsContainer", 10) :: Frame?
		if container then
			self._mapsContainer = container
			self._mapButtonTemplate = container:WaitForChild("MapButtonTemplate", 10) :: TextButton?
			if self._mapButtonTemplate then
				self._mapButtonTemplate.Visible = false
			end
		end
		mapFrame.Visible = false
	end

	-- 3. MatchTimerFrame
	local timerFrame = hud:WaitForChild("MatchTimerFrame", 10) :: Frame?
	if timerFrame then
		self._matchTimerFrame = timerFrame
		self._matchTimer = timerFrame:WaitForChild("Timer", 10) :: TextLabel?
		timerFrame.Visible = false
	end

	-- 4. ResultFrame
	local resFrame = hud:WaitForChild("ResultFrame", 10) :: Frame?
	if resFrame then
		self._resultFrame = resFrame
		self._resultTitle = resFrame:WaitForChild("ResultTitle", 10) :: TextLabel?
		self._resultSubtitle = resFrame:WaitForChild("ResultSubtitle", 10) :: TextLabel?
		resFrame.Visible = false
	end

	-- 5. RedTeamFrame
	local redFrame = hud:WaitForChild("RedTeamFrame", 10) :: Frame?
	if redFrame then
		self._redTeamFrame = redFrame
		self._redScoreLabel = redFrame:WaitForChild("ScoreLabel", 10) :: TextLabel?
		self._redPlayersContainer = redFrame:WaitForChild("PlayersContainer", 10) :: Frame?
		redFrame.Visible = false
	end

	-- 6. BlueTeamFrame
	local blueFrame = hud:WaitForChild("BlueTeamFrame", 10) :: Frame?
	if blueFrame then
		self._blueTeamFrame = blueFrame
		self._blueScoreLabel = blueFrame:WaitForChild("ScoreLabel", 10) :: TextLabel?
		self._bluePlayersContainer = blueFrame:WaitForChild("PlayersContainer", 10) :: Frame?
		blueFrame.Visible = false
	end

	-- 7. PlayerSlotTemplate
	local slotTemplate = hud:WaitForChild("PlayerSlotTemplate", 10) :: Frame?
	if slotTemplate then
		self._playerSlotTemplate = slotTemplate
		slotTemplate.Visible = false
	end

	-- 8. LastPointFrame
	local lpFrame = hud:WaitForChild("LastPointFrame", 10) :: Frame?
	if lpFrame then
		self._lastPointFrame = lpFrame
		self._lastPointTitle = lpFrame:WaitForChild("Title", 10) :: TextLabel?
		self._lastPointSubtitle = lpFrame:WaitForChild("Subtitle", 10) :: TextLabel?
		lpFrame.Visible = false
	end
end

function MatchController:_setupButtonEvents()
	if self._randomButton then
		self._randomButton.MouseButton1Click:Connect(function()
			self:_submitVote(Constants.SpecialMapVote.Random, self._randomButton)
		end)
	end
end

function MatchController:_connectRemotes()
	local remotesFolder = ReplicatedStorage:WaitForChild("Remotes", 10)
	if not remotesFolder then return end

	local matchFolder = remotesFolder:WaitForChild("Match", 10)
	if not matchFolder then return end

	local stateChanged = matchFolder:WaitForChild("StateChanged", 10) :: RemoteEvent?
	local countdown = matchFolder:WaitForChild("Countdown", 10) :: RemoteEvent?
	local mapSelection = matchFolder:WaitForChild("MapSelection", 10) :: RemoteEvent?
	local matchResult = matchFolder:WaitForChild("MatchResult", 10) :: RemoteEvent?
	local scoreUpdated = matchFolder:WaitForChild("ScoreUpdated", 10) :: RemoteEvent?
	local lastPoint = matchFolder:WaitForChild("LastPoint", 10) :: RemoteEvent?

	if stateChanged then
		stateChanged.OnClientEvent:Connect(function(newState: string, extraData: any)
			self:_handleStateChanged(newState, extraData)
		end)
	end

	if countdown then
		countdown.OnClientEvent:Connect(function(remaining: number, label: string, extraData: any?)
			self:_handleCountdown(remaining, label, extraData)
		end)
	end

	if mapSelection then
		mapSelection.OnClientEvent:Connect(function(data: any)
			if not self:_acceptSessionPayload(data, false, false) then return end
			if type(data) == "table" and data.Maps then
				self:_populateMapSelection(data.Maps)
			elseif type(data) == "table" and data.Voted then
				self:_highlightSelectedVote(data.Voted)
			end
		end)
	end

	if matchResult then
		matchResult.OnClientEvent:Connect(function(result: string, winnerName: string?, metadata: any)
			if not self:_acceptSessionPayload(metadata, false, false) then return end
			self:_handleMatchResult(result, winnerName)
		end)
	end

	if scoreUpdated then
		scoreUpdated.OnClientEvent:Connect(function(data: any)
			if not self:_acceptSessionPayload(data, false, false) then return end
			self:_handleScoreUpdated(data)
		end)
	end

	if lastPoint then
		lastPoint.OnClientEvent:Connect(function(data: any)
			if not self:_acceptSessionPayload(data, false, false) then return end
			self:_handleLastPoint(data)
		end)
	end

	local pointFeedback = matchFolder:WaitForChild("PointFeedback", 5) :: RemoteEvent?
	if pointFeedback then
		pointFeedback.OnClientEvent:Connect(function(data: any)
			if not self:_acceptSessionPayload(data, false, false) then return end
			self:_handlePointFeedback(data)
		end)
	end
end

function MatchController:_handlePointFeedback(data: any)
	-- Hook arquitectónico preparado para Camera Shake y efectos de pantalla
	-- Autoridad exclusiva del servidor: el cliente reacciona pero no decide
	if type(data) ~= "table" then return end
	if data.IsFinalPoint == true then
		local musicController = self._context and self._context:GetController("MusicController")
		if musicController and typeof(musicController.Suspend) == "function" then
			local endCinematicConfig = require(ReplicatedStorage.Shared.EndCinematicConfig)
			local fadeOut = (endCinematicConfig.Music and endCinematicConfig.Music.FadeOutDuration) or 0.4
			musicController:Suspend("EndCinematic", fadeOut)
		end
	end
	print(string.format("[MatchController] PointFeedback recibido del servidor: Equipo=%s, Jugador=%s, Efecto=%s, Final=%s",
		tostring(data.ScoringTeam),
		tostring(data.ScoringPlayerName),
		tostring(data.EffectId),
		tostring(data.IsFinalPoint)))
end

function MatchController:_handleStateChanged(newState: string, extraData: any)
	if not self:_acceptSessionPayload(extraData, true, true) then return end
	if extraData and extraData.PrematchCancelled == true then
		self:_stopStartCountdownAnimation()
		for _,frame in pairs({self._countdownFrame,self._startCountdownFrame,self._mapSelectionFrame,self._matchTimerFrame,self._resultFrame}) do frame.Visible=false end
		self._currentRole=nil;self._selectedMapVote=nil;self._currentSelectedMap=nil
		self:_clearClonedButtons();self:_clearPlayerSlots()
		self:_clearSessionIdentity(self._currentMatchId)
		self._currentState=Constants.RoundState.Waiting
		local queue=self._context and self._context:GetController("MatchmakingController")
		local music=self._context and self._context:GetController("MusicController")
		if music then
			if queue and queue:IsInQueue() then music:PlayMatchmaking() else music:PlayLobby() end
		end
		return
	end
	local eventSessionId = self._currentMatchId :: string
	local prevState = self._currentState
	self._currentState = newState
	print(string.format("[MatchController] Estado recibido: %s", newState))

	local isPointRestart = (newState == Constants.RoundState.PointRestartCountdown)
	if newState~=Constants.RoundState.Playing then self._roundDeadline=nil end

	-- Ocultar frames condicionalmente (durante PointRestartCountdown el HUD y timer permanecen visibles)
	if not isPointRestart then
		if self._startCountdownFrame then self._startCountdownFrame.Visible = false end
		if self._countdownFrame and newState ~= Constants.RoundState.MatchReady and newState ~= Constants.RoundState.MatchCountdown then
			self._countdownFrame.Visible = false
		end
		if self._mapSelectionFrame then self._mapSelectionFrame.Visible = false end
		if self._matchTimerFrame and newState ~= Constants.RoundState.Playing then self._matchTimerFrame.Visible = false end
		if self._resultFrame then self._resultFrame.Visible = false end
	end

	if newState == Constants.RoundState.MatchReady then
		if extraData and extraData.MatchId then
			self._currentMatchId = extraData.MatchId
		end
		if extraData and extraData.Red and extraData.Blue then
			if extraData.Red == localPlayer.Name then
				self._currentRole = "Red"
			elseif extraData.Blue == localPlayer.Name then
				self._currentRole = "Blue"
			else
				self._currentRole = nil
			end
		end
		if self._countdownFrame then
			if self._countdownTitle then
				self._countdownTitle.Text = "LA PARTIDA COMIENZA EN"
			end
			if self._countdownTimer then
				local defaultDuration = Config.Round and Config.Round.MatchCountdownTime or 5
				self._countdownTimer.Text = tostring(defaultDuration)
			end
			self._countdownFrame.Visible = true
		end

	elseif newState == Constants.RoundState.MatchCountdown then
		if self._countdownFrame then
			if self._countdownTitle then
				self._countdownTitle.Text = "LA PARTIDA COMIENZA EN"
			end
			if extraData and extraData.Duration and self._countdownTimer then
				self._countdownTimer.Text = tostring(extraData.Duration)
			end
			self._countdownFrame.Visible = true
		end

	elseif newState == Constants.RoundState.MapSelection then
		if self._mapSelectionFrame then
			self._selectedMapVote = nil
			self:_resetButtonHighlights()
			self._mapSelectionFrame.Visible = true
		end

	elseif newState == Constants.RoundState.MapLoading then
		self._currentSelectedMap = extraData and extraData.SelectedMap
		if self._countdownFrame and self._countdownTitle and self._countdownTimer then
			self._countdownTitle.Text = "CARGANDO MAPA"
			self._countdownTimer.Text = extraData and extraData.SelectedMap or "..."
			self._countdownFrame.Visible = true
		end
		if self:IsParticipant() then
			local musicController = self._context and self._context:GetController("MusicController")
			if musicController then
				musicController:PlayArena(self._currentSelectedMap or "Default")
			end
		end

	elseif newState == Constants.RoundState.StartCountdown then
		if extraData and extraData.MatchId then
			self._currentMatchId = extraData.MatchId
		end
		if extraData and extraData.SelectedMap and not self._currentSelectedMap then
			self._currentSelectedMap = extraData.SelectedMap
		end
		if self:IsParticipant() then
			local musicController = self._context and self._context:GetController("MusicController")
			if musicController and musicController:GetCurrentState() ~= "Arena" then
				musicController:PlayArena(self._currentSelectedMap or "Default")
			end
		end
		if self._startCountdownFrame then
			if self._startCountdownTitle then
				self._startCountdownTitle.Text = "LA PARTIDA COMIENZA"
			end
			if self._startCountdownLabel then
				local duration = (extraData and extraData.Duration) or 5
				self._startCountdownLabel.Text = tostring(duration)
			end
			self._startCountdownFrame.Visible = true
		end

	elseif newState == Constants.RoundState.PointRestartCountdown then
		if extraData and extraData.MatchId then
			self._currentMatchId = extraData.MatchId
		end
		if self._startCountdownFrame then
			if self._startCountdownTitle then
				self._startCountdownTitle.Text = "SIGUIENTE PUNTO EN"
			end
			if self._startCountdownLabel then
				local duration = (extraData and extraData.Duration) or 3
				self._startCountdownLabel.Text = tostring(duration)
			end
			self._startCountdownFrame.Visible = true
		end
		if self._matchTimerFrame then self._matchTimerFrame.Visible = true end
		if self._redTeamFrame then self._redTeamFrame.Visible = true end
		if self._blueTeamFrame then self._blueTeamFrame.Visible = true end

	elseif newState == Constants.RoundState.Playing then
		if self._matchTimer then self._matchTimer.Text=formatTime(Config.Round.RoundDuration) end
		if extraData and extraData.MatchId then
			self._currentMatchId = extraData.MatchId
		end
		if self._startCountdownFrame then
			self._startCountdownFrame.Visible = false
		end
		if self._matchTimerFrame then
			self._matchTimerFrame.Visible = true
		end
		if self._redTeamFrame then
			self._redTeamFrame.Visible = true
		end
		if self._blueTeamFrame then
			self._blueTeamFrame.Visible = true
		end

		-- Solo inicializar score a 0 al inicio formal de la partida (no tras un punto anotado)
		if prevState == Constants.RoundState.StartCountdown or prevState == Constants.RoundState.MapLoading then
			if self._redScoreLabel then
				self._redScoreLabel.Text = "0"
			end
			if self._blueScoreLabel then
				self._blueScoreLabel.Text = "0"
			end
		end

		self:_populatePlayers(
			extraData and extraData.RedTeam,
			extraData and extraData.BlueTeam,
			extraData and extraData.Red,
			extraData and extraData.Blue
		)

	elseif newState == Constants.RoundState.Ending then
		if self._resultFrame then
			self._resultFrame.Visible = not (extraData and extraData.Cinematic == true)
		end
		if self._lastPointFrame then
			self._lastPointFrame.Visible = false
		end
		local musicController = self._context and self._context:GetController("MusicController")
		if musicController and typeof(musicController.Suspend) == "function" then
			local endCinematicConfig = require(ReplicatedStorage.Shared.EndCinematicConfig)
			local fadeOut = (endCinematicConfig.Music and endCinematicConfig.Music.FadeOutDuration) or 0.4
			musicController:Suspend("EndCinematic", fadeOut)
		end

	elseif newState == Constants.RoundState.ReturningToLobby or newState == Constants.RoundState.Waiting then
		local wasParticipant = self:IsParticipant()
		self._currentRole = nil
		self._selectedMapVote = nil
		self._currentSelectedMap = nil
		if self._countdownFrame then self._countdownFrame.Visible = false end
		if self._startCountdownFrame then self._startCountdownFrame.Visible = false end
		if self._redTeamFrame then self._redTeamFrame.Visible = false end
		if self._blueTeamFrame then self._blueTeamFrame.Visible = false end
		if self._lastPointFrame then self._lastPointFrame.Visible = false end
		self:_clearClonedButtons()
		self:_clearPlayerSlots()

		local musicController = self._context and self._context:GetController("MusicController")
		local endCinematic = self._context and self._context:GetController("EndCinematicController")
		if (not endCinematic or not endCinematic:IsPlaying()) and musicController and typeof(musicController.Resume) == "function" then
			musicController:Resume("EndCinematic")
		end

		if wasParticipant or newState == Constants.RoundState.ReturningToLobby then
			if musicController then
				musicController:PlayLobby()
			end
		end
		self:_clearSessionIdentity(eventSessionId)
		self._currentState = Constants.RoundState.Waiting
	end
end

function MatchController:_handleScoreUpdated(data: any)
	if type(data) ~= "table" then return end
	if self._redScoreLabel and data.Red ~= nil then
		self._redScoreLabel.Text = tostring(data.Red)
	end
	if self._blueScoreLabel and data.Blue ~= nil then
		self._blueScoreLabel.Text = tostring(data.Blue)
	end
	print(string.format("[MatchController] Score actualizado en HUD: Red=%s, Blue=%s",
		tostring(data.Red), tostring(data.Blue)))
end

function MatchController:_handleLastPoint(data: any)
	if not self._lastPointFrame or not self._lastPointTitle then return end
	local team = data and data.Team
	local message = data and data.Message or "ÚLTIMO PUNTO PARA GANAR LA PARTIDA"

	self._lastPointTitle.Text = message

	if self._lastPointSubtitle then
		if team == "Red" then
			self._lastPointSubtitle.Text = "¡EQUIPO ROJO A 1 PUNTO DE LA VICTORIA!"
			self._lastPointSubtitle.TextColor3 = Color3.fromRGB(255, 120, 120)
		elseif team == "Blue" then
			self._lastPointSubtitle.Text = "¡EQUIPO AZUL A 1 PUNTO DE LA VICTORIA!"
			self._lastPointSubtitle.TextColor3 = Color3.fromRGB(120, 180, 255)
		else
			self._lastPointSubtitle.Text = "¡A 1 punto de la victoria!"
			self._lastPointSubtitle.TextColor3 = Color3.fromRGB(255, 255, 255)
		end
	end

	self._lastPointFrame.Visible = true

	local token = os.clock()
	self._lastPointToken = token
	task.delay(4, function()
		if self._lastPointToken == token and self._lastPointFrame then
			self._lastPointFrame.Visible = false
		end
	end)
end

function MatchController:_clearPlayerSlots()
	for _, slot in ipairs(self._clonedSlots) do
		slot:Destroy()
	end
	self._clonedSlots = {}
end

function MatchController:_populatePlayers(redData: any, blueData: any, redFallback: string?, blueFallback: string?)
	self:_clearPlayerSlots()
	if not self._playerSlotTemplate then return end

	local createSlot = function(playerInfo: any, fallbackName: string?, container: Frame?, teamColor: Color3)
		if not container then return end
		local slot = self._playerSlotTemplate:Clone()
		local name = if type(playerInfo) == "table" and playerInfo.Name then playerInfo.Name else fallbackName or "Jugador"
		local displayName = if type(playerInfo) == "table" and playerInfo.DisplayName then playerInfo.DisplayName else name
		local userId = if type(playerInfo) == "table" and playerInfo.UserId then playerInfo.UserId else 0

		slot.Name = "Slot_" .. name
		local nameLabel = slot:FindFirstChild("DisplayName") :: TextLabel?
		if nameLabel then
			nameLabel.Text = displayName
		end

		local userLabel = slot:FindFirstChild("Username") :: TextLabel?
		if userLabel then
			userLabel.Text = "@" .. name
		end

		local avatarImg = slot:FindFirstChild("Avatar") :: ImageLabel?
		if avatarImg and userId > 0 then
			avatarImg.Image = string.format("rbxthumb://type=AvatarHeadShot&id=%d&w=100&h=100", userId)
		end

		local stroke = slot:FindFirstChildOfClass("UIStroke")
		if stroke then
			stroke.Color = teamColor
		end

		slot.Visible = true
		slot.Parent = container
		table.insert(self._clonedSlots, slot)
	end

	-- Red team
	if type(redData) == "table" and #redData > 0 then
		for _, pInfo in ipairs(redData) do
			createSlot(pInfo, redFallback, self._redPlayersContainer, Color3.fromRGB(150, 40, 40))
		end
	else
		createSlot(nil, redFallback, self._redPlayersContainer, Color3.fromRGB(150, 40, 40))
	end

	-- Blue team
	if type(blueData) == "table" and #blueData > 0 then
		for _, pInfo in ipairs(blueData) do
			createSlot(pInfo, blueFallback, self._bluePlayersContainer, Color3.fromRGB(40, 90, 160))
		end
	else
		createSlot(nil, blueFallback, self._bluePlayersContainer, Color3.fromRGB(40, 90, 160))
	end
end

function MatchController:_handleCountdown(remaining: number, label: string, extraData: any?)
	if not self:_acceptSessionPayload(extraData, false, false) then return end

	if label=="PLAYING" and type(extraData)=="table" and type(extraData.RoundIndex)=="number" then
  if self._clockSessionId~=self._currentMatchId then self._roundIndex=0 end
  if extraData.RoundIndex<self._roundIndex then return end
  self._roundIndex=extraData.RoundIndex;self._clockSessionId=self._currentMatchId
  self._roundDeadline=if extraData.Resolved then nil else extraData.Deadline
  if self._matchTimer then self._matchTimer.Text=formatTime(remaining) end
  return
 end

	if extraData and extraData.Cancelled then
		if self._countdownFrame then
			self._countdownFrame.Visible = false
		end
		return
	end

	if self._currentState == Constants.RoundState.MatchCountdown then
		if self._countdownTimer then
			self._countdownTimer.Text = tostring(remaining)
		end
	elseif self._currentState == Constants.RoundState.MapSelection then
		if self._mapTimer then
			self._mapTimer.Text = tostring(remaining)
		end
	elseif self._currentState == Constants.RoundState.StartCountdown
		or self._currentState == Constants.RoundState.PointRestartCountdown
		or label == "START_COUNTDOWN" then
		self:_updateStartCountdown(remaining, extraData)
	elseif self._currentState == Constants.RoundState.Playing then
		if self._matchTimer then
			self._matchTimer.Text = formatTime(remaining)
		end
	end
end

local COUNTDOWN = {
	-- Cadencia (suma 0.92 s, deja 0.08 s de margen de red dentro del segundo)
	EnterTime = 0.24,
	SettleTime = 0.18,
	HoldTime = 0.35,
	ExitTime = 0.15,

	-- Trayectoria cubica en "C" (coordenadas Scale de pantalla)
	StartPoint = Vector2.new(0.88, 0.05),
	ControlA = Vector2.new(0.14, -0.05),
	ControlB = Vector2.new(0.06, 0.66),
	EndPoint = Vector2.new(0.5, 0.5),
	ExitOffset = Vector2.new(-0.20, 0.22),

	-- Vuelo
	EnterEase = 1.6,          -- >1: acelera hacia el impacto
	FadeInPortion = 0.30,
	FlightStartScale = 0.40,
	FlightTilt = 16,          -- grados de inclinacion segun la velocidad
	StretchDepth = 0.9,       -- extrusion extra durante el vuelo (estiramiento)

	-- Impacto (resorte subamortiguado)
	ImpactScale = 0.25,
	ImpactSink = 0.016,
	SquashDepth = 0.75,       -- cuanto se comprime la extrusion al impactar
	SpringFreq = 24,
	SpringDamping = 0.42,
	ShineTime = 0.35,
	ShineStart = -0.6,

	-- Salida
	ExitRotation = -24,
	ExitScale = 0.5,

	-- Estela
	GhostCount = 3,
	GhostLag = 0.07,
	GhostTransparency = 0.55,

	-- Extrusion 3D
	DepthLayers = 8,
	DepthStep = 0.011,        -- fraccion de la altura del label por capa

	-- Climax
	StartTotal = 0.90,
	StartPunchTime = 0.14,
	StartExitTime = 0.16,
	StartPeakScale = 1.55,
	StartRestScale = 1.18,
	StartPushScale = 1.30,
	SparkCount = 14,
}

local NUMBER_TOTAL = COUNTDOWN.EnterTime + COUNTDOWN.SettleTime + COUNTDOWN.HoldTime + COUNTDOWN.ExitTime

local START_PALETTE: Palette = {
	Main = Color3.fromRGB(60, 235, 130),
	Shadow = Color3.fromRGB(10, 95, 50),
	Deep = Color3.fromRGB(4, 42, 22),
	Accent = Color3.fromRGB(200, 255, 220),
}

-- ===== Utilidades matematicas =====

local function lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end

local function clamp01(x: number): number
	return math.clamp(x, 0, 1)
end

local function easeOutCubic(x: number): number
	return 1 - (1 - x) ^ 3
end

-- Bezier cubica y su derivada (tangente)
local function bezier3(p0: Vector2, p1: Vector2, p2: Vector2, p3: Vector2, t: number): Vector2
	local u = 1 - t
	return p0 * (u * u * u) + p1 * (3 * u * u * t) + p2 * (3 * u * t * t) + p3 * (t * t * t)
end

local function bezier3Tangent(p0: Vector2, p1: Vector2, p2: Vector2, p3: Vector2, t: number): Vector2
	local u = 1 - t
	return (p1 - p0) * (3 * u * u) + (p2 - p1) * (6 * u * t) + (p3 - p2) * (3 * t * t)
end

-- Resorte subamortiguado: vale 1 en t = 0 y decae a 0 oscilando (pasa por valores negativos = rebote)
local function springKick(t: number, freq: number, damping: number): number
	if t <= 0 then
		return 1
	end
	local wd = freq * math.sqrt(1 - damping * damping)
	local decay = math.exp(-damping * freq * t)
	return decay * (math.cos(wd * t) + (damping * freq / wd) * math.sin(wd * t))
end

local function flightPoint(s: number): Vector2
	local c = COUNTDOWN
	return bezier3(c.StartPoint, c.ControlA, c.ControlB, c.EndPoint, s)
end

local function flightTilt(s: number): number
	local c = COUNTDOWN
	local tan = bezier3Tangent(c.StartPoint, c.ControlA, c.ControlB, c.EndPoint, s)
	return -tan.Unit.X * c.FlightTilt
end

local END_TILT = flightTilt(1)

-- ===== Poses (funciones puras del tiempo) =====

local function numberPose(t: number): Pose
	local c = COUNTDOWN
	local exitStart = c.EnterTime + c.SettleTime + c.HoldTime

	if t < c.EnterTime then
		local u = t / c.EnterTime
		local s = u ^ c.EnterEase
		local p = flightPoint(s)
		return {
			Position = UDim2.fromScale(p.X, p.Y),
			Rotation = flightTilt(s),
			Scale = lerp(c.FlightStartScale, 1 + c.ImpactScale, 1 - (1 - u) ^ 2),
			Transparency = 1 - clamp01(u / c.FadeInPortion),
			Depth = 1 + c.StretchDepth * u ^ 0.6,
			ShineY = 0,
		}
	end

	local ti = t - c.EnterTime
	local k = springKick(ti, c.SpringFreq, c.SpringDamping)
	local center = c.EndPoint
	local y = center.Y + c.ImpactSink * k
	local rot = END_TILT * k
	local scale = 1 + c.ImpactScale * k
	local depth = 1 - c.SquashDepth * k
	local shine = lerp(c.ShineStart, 0, easeOutCubic(clamp01(ti / c.ShineTime)))

	if t < exitStart then
		return {
			Position = UDim2.fromScale(center.X, y),
			Rotation = rot,
			Scale = scale,
			Transparency = 0,
			Depth = depth,
			ShineY = shine,
		}
	end

	local v = clamp01((t - exitStart) / c.ExitTime)
	local e = v * v
	return {
		Position = UDim2.fromScale(center.X + c.ExitOffset.X * e, y + c.ExitOffset.Y * e),
		Rotation = lerp(rot, c.ExitRotation, e),
		Scale = lerp(scale, c.ExitScale, e),
		Transparency = e,
		Depth = lerp(depth, 1.5, e),
		ShineY = 0,
	}
end

local function startPose(t: number): Pose
	local c = COUNTDOWN
	local center = c.EndPoint

	if t < c.StartPunchTime then
		local u = t / c.StartPunchTime
		local e = easeOutCubic(u)
		return {
			Position = UDim2.fromScale(center.X, center.Y),
			Rotation = -8 * (1 - e),
			Scale = lerp(0.15, c.StartPeakScale, e),
			Transparency = 1 - clamp01(u / 0.4),
			Depth = lerp(2.0, 1.6, u),
			ShineY = c.ShineStart,
		}
	end

	local ti = t - c.StartPunchTime
	local k = springKick(ti, 18, 0.36)
	local push = lerp(c.StartRestScale, c.StartPushScale, clamp01(ti / 0.6))
	local scale = push + (c.StartPeakScale - c.StartRestScale) * k
	local shake = 0.006 * k
	local transparency = 0

	local exitStart = c.StartTotal - c.StartExitTime
	if t >= exitStart then
		local v = clamp01((t - exitStart) / c.StartExitTime)
		local e = v * v
		scale *= lerp(1, 1.4, e)
		transparency = e
	end

	return {
		Position = UDim2.fromScale(center.X + shake * math.sin(ti * 95), center.Y + shake * math.cos(ti * 83)),
		Rotation = 3 * k * math.sin(ti * 60),
		Scale = scale,
		Transparency = transparency,
		Depth = 1.25 - 0.95 * k,
		ShineY = lerp(c.ShineStart, 0, easeOutCubic(clamp01(ti / c.ShineTime))),
	}
end

local function paletteForNumber(remaining: number): Palette
	local main: Color3
	local shadow: Color3
	if remaining <= 2 then
		main = Color3.fromRGB(255, 95, 95)
		shadow = Color3.fromRGB(130, 25, 25)
	else
		main = Color3.fromRGB(255, 215, 60)
		shadow = Color3.fromRGB(130, 65, 10)
	end
	return {
		Main = main,
		Shadow = shadow,
		Deep = shadow:Lerp(Color3.new(0, 0, 0), 0.55),
		Accent = main:Lerp(Color3.new(1, 1, 1), 0.65),
	}
end

-- ===== Construccion de capas (se crean UNA vez y se reutilizan) =====

local function copyTextStyle(target: TextLabel, source: TextLabel)
	target.FontFace = source.FontFace
	target.TextSize = source.TextSize
	target.TextScaled = source.TextScaled
	target.TextWrapped = source.TextWrapped
	target.LineHeight = source.LineHeight
	target.TextXAlignment = source.TextXAlignment
	target.TextYAlignment = source.TextYAlignment
	target.RichText = false
end

local function newStack(name: string, container: Frame, source: TextLabel, layerCount: number, baseZ: number, outlined: boolean): FxStack
	local root = Instance.new("Frame")
	root.Name = name
	root.BackgroundTransparency = 1
	root.BorderSizePixel = 0
	root.AnchorPoint = source.AnchorPoint
	root.Size = source.Size
	root.Position = source.Position
	root.ZIndex = baseZ
	root.Visible = false

	local scale = Instance.new("UIScale")
	scale.Name = "UIScale"
	scale.Parent = root

	local layers: { TextLabel } = {}
	local stroke: UIStroke? = nil
	for i = 1, layerCount do
		local layer = Instance.new("TextLabel")
		layer.Name = "Layer" .. i
		layer.BackgroundTransparency = 1
		layer.BorderSizePixel = 0
		layer.Size = UDim2.fromScale(1, 1)
		layer.Position = UDim2.fromScale(0, 0)
		layer.ZIndex = baseZ + (layerCount - i) -- la capa 1 (pegada a la cara) queda arriba
		layer.Text = ""
		copyTextStyle(layer, source)
		if outlined and i == layerCount then
			local s = Instance.new("UIStroke")
			s.Name = "DeepStroke"
			s.Thickness = 4
			s.Color = Color3.fromRGB(10, 6, 3)
			s.Parent = layer
			stroke = s
		end
		layer.Parent = root
		table.insert(layers, layer)
	end

	root.Parent = container
	return { Root = root, Scale = scale, Layers = layers, Stroke = stroke }
end

local function newBurst(container: Frame): BurstFx
	local burst = Instance.new("Frame")
	burst.Name = "Burst"
	burst.BackgroundTransparency = 1
	burst.BorderSizePixel = 0
	burst.Size = UDim2.fromScale(1, 1)
	burst.ZIndex = 3
	burst.Visible = false
	burst.Parent = container

	local rings: { Frame } = {}
	local ringStrokes: { UIStroke } = {}
	for i = 1, 2 do
		local ring = Instance.new("Frame")
		ring.Name = "Ring" .. i
		ring.BackgroundTransparency = 1
		ring.BorderSizePixel = 0
		ring.AnchorPoint = Vector2.new(0.5, 0.5)
		ring.Position = UDim2.fromScale(0.5, 0.5)
		ring.SizeConstraint = Enum.SizeConstraint.RelativeYY -- circulo perfecto en cualquier resolucion
		ring.Size = UDim2.fromScale(0.1, 0.1)
		ring.ZIndex = 4
		ring.Visible = false

		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.5, 0)
		corner.Parent = ring

		local stroke = Instance.new("UIStroke")
		stroke.Thickness = 8
		stroke.Parent = ring

		ring.Parent = burst
		table.insert(rings, ring)
		table.insert(ringStrokes, stroke)
	end

	local rng = Random.new(1337)
	local sparks: { Frame } = {}
	local angles: { number } = {}
	local reach: { number } = {}
	for i = 1, COUNTDOWN.SparkCount do
		local spark = Instance.new("Frame")
		spark.Name = "Spark" .. i
		spark.BorderSizePixel = 0
		spark.AnchorPoint = Vector2.new(0.5, 0.5)
		spark.SizeConstraint = Enum.SizeConstraint.RelativeYY
		spark.Size = UDim2.fromScale(0.06, 0.012)
		spark.ZIndex = 5
		spark.Visible = false

		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.5, 0)
		corner.Parent = spark

		spark.Parent = burst
		table.insert(sparks, spark)
		table.insert(angles, (i - 1) / COUNTDOWN.SparkCount * math.pi * 2 + rng:NextNumber(-0.12, 0.12))
		table.insert(reach, rng:NextNumber(0.26, 0.48))
	end

	return { Container = burst, Rings = rings, RingStrokes = ringStrokes, Sparks = sparks, SparkAngles = angles, SparkReach = reach }
end

local function buildCountdownFx(frame: Frame, label: TextLabel): CountdownFx
	-- Limpieza de restos (evita duplicados si el controlador se reinicia)
	local staleFx = frame:FindFirstChild("CountdownFx")
	if staleFx then
		staleFx:Destroy()
	end
	local staleShadow = label:FindFirstChild("Shadow3D")
	if staleShadow then
		staleShadow:Destroy()
	end

	-- El label siempre por encima de las capas FX (vale para ZIndexBehavior Sibling y Global)
	label.AnchorPoint = Vector2.new(0.5, 0.5)
	label.ZIndex = math.max(label.ZIndex, 50)

	local container = Instance.new("Frame")
	container.Name = "CountdownFx"
	container.BackgroundTransparency = 1
	container.BorderSizePixel = 0
	container.Size = UDim2.fromScale(1, 1)
	container.Position = UDim2.fromScale(0, 0)
	container.ZIndex = 2
	container.Parent = frame

	local burst = newBurst(container)
	local extrusion = newStack("Extrusion", container, label, COUNTDOWN.DepthLayers, 10, true)
	local ghosts: { FxStack } = {}
	for g = 1, COUNTDOWN.GhostCount do
		table.insert(ghosts, newStack("Ghost" .. g, container, label, 1, 30 + g, false))
	end

	return { Container = container, Extrusion = extrusion, Ghosts = ghosts, Burst = burst }
end

-- ===== Sincronizacion label <-> capas =====

local function paintRig(rig: CountdownRig, text: string, palette: Palette)
	local label = rig.Label
	label.Text = text
	label.TextColor3 = palette.Main

	local layers = rig.Fx.Extrusion.Layers
	local n = #layers
	for i, layer in ipairs(layers) do
		copyTextStyle(layer, label)
		layer.Text = text
		layer.TextColor3 = palette.Shadow:Lerp(palette.Deep, if n > 1 then (i - 1) / (n - 1) else 0)
	end

	for _, ghost in ipairs(rig.Fx.Ghosts) do
		for _, layer in ipairs(ghost.Layers) do
			copyTextStyle(layer, label)
			layer.Text = text
			layer.TextColor3 = palette.Main
		end
	end

	local burst = rig.Fx.Burst
	burst.RingStrokes[1].Color = palette.Accent
	burst.RingStrokes[2].Color = palette.Main
	for i, spark in ipairs(burst.Sparks) do
		spark.BackgroundColor3 = if i % 2 == 0 then palette.Accent else palette.Main
	end
end

local function applyPose(rig: CountdownRig, pose: Pose)
	local label = rig.Label
	label.Position = pose.Position
	label.Rotation = pose.Rotation
	rig.UIScale.Scale = pose.Scale
	label.TextTransparency = pose.Transparency
	if rig.Stroke then
		rig.Stroke.Transparency = pose.Transparency
	end
	if rig.Gradient then
		rig.Gradient.Offset = Vector2.new(0, pose.ShineY)
	end

	local ext = rig.Fx.Extrusion
	ext.Root.Visible = pose.Transparency < 0.999
	ext.Root.Position = pose.Position
	ext.Root.Rotation = pose.Rotation
	ext.Scale.Scale = pose.Scale
	for i, layer in ipairs(ext.Layers) do
		layer.Position = UDim2.fromScale(0, COUNTDOWN.DepthStep * i * pose.Depth)
		layer.TextTransparency = pose.Transparency
	end
	if ext.Stroke then
		ext.Stroke.Transparency = pose.Transparency
	end
end

local function updateGhosts(rig: CountdownRig, t: number)
	local c = COUNTDOWN
	for g, ghost in ipairs(rig.Fx.Ghosts) do
		local u = t / c.EnterTime - c.GhostLag * g
		local visible = t < c.EnterTime and u > 0
		ghost.Root.Visible = visible
		if visible then
			local s = u ^ c.EnterEase
			local p = flightPoint(s)
			ghost.Root.Position = UDim2.fromScale(p.X, p.Y)
			ghost.Root.Rotation = flightTilt(s)
			ghost.Scale.Scale = lerp(c.FlightStartScale, 1 + c.ImpactScale, 1 - (1 - u) ^ 2)
			local transparency = math.max(c.GhostTransparency + (g - 1) * 0.12, 1 - clamp01(u / c.FadeInPortion))
			for _, layer in ipairs(ghost.Layers) do
				layer.TextTransparency = transparency
			end
		end
	end
end

local function hideGhosts(rig: CountdownRig)
	for _, ghost in ipairs(rig.Fx.Ghosts) do
		ghost.Root.Visible = false
	end
end

local RING_TIMING = {
	{ delay = 0, duration = 0.45, size = 2.2 },
	{ delay = 0.07, duration = 0.50, size = 1.5 },
}

local function updateBurst(rig: CountdownRig, t: number)
	local burst = rig.Fx.Burst
	burst.Container.Visible = true

	for i, ring in ipairs(burst.Rings) do
		local timing = RING_TIMING[i]
		local w = clamp01((t - timing.delay) / timing.duration)
		ring.Visible = t >= timing.delay and w < 1
		if ring.Visible then
			local e = easeOutCubic(w)
			local d = lerp(0.18, timing.size, e)
			ring.Size = UDim2.fromScale(d, d)
			burst.RingStrokes[i].Thickness = lerp(14, 1, w)
			burst.RingStrokes[i].Transparency = lerp(0.1, 1, w)
		end
	end

	local abs = rig.Frame.AbsoluteSize
	local aspect = if abs.X > 0 then abs.Y / abs.X else 1
	local w = clamp01((t - 0.02) / 0.5)
	local e = easeOutCubic(w)
	for i, spark in ipairs(burst.Sparks) do
		spark.Visible = t > 0.02 and w < 1
		if spark.Visible then
			local angle = burst.SparkAngles[i]
			local dist = burst.SparkReach[i] * e
			spark.Position = UDim2.fromScale(0.5 + math.cos(angle) * dist * aspect, 0.5 + math.sin(angle) * dist)
			spark.Rotation = math.deg(angle)
			spark.Size = UDim2.fromScale(0.06 * (1 - 0.7 * w), 0.012)
			spark.BackgroundTransparency = w * w
		end
	end
end

local function hideBurst(rig: CountdownRig)
	local burst = rig.Fx.Burst
	burst.Container.Visible = false
	for _, ring in ipairs(burst.Rings) do
		ring.Visible = false
	end
	for _, spark in ipairs(burst.Sparks) do
		spark.Visible = false
	end
end

-- ===== API del controlador =====

function MatchController:_getCountdownRig(): CountdownRig?
	local frame = self._startCountdownFrame
	local label = self._startCountdownLabel
	if not frame or not label then
		return nil
	end

	local fx = self._countdownFx
	if not fx or fx.Container.Parent ~= frame then
		fx = buildCountdownFx(frame, label)
		self._countdownFx = fx
	end

	local uiScale = label:FindFirstChildOfClass("UIScale")
	if not uiScale then
		uiScale = Instance.new("UIScale")
		uiScale.Parent = label
	end

	return {
		Frame = frame,
		Label = label,
		UIScale = uiScale :: UIScale,
		Stroke = label:FindFirstChildOfClass("UIStroke"),
		Gradient = label:FindFirstChildOfClass("UIGradient"),
		Fx = fx :: CountdownFx,
	}
end

function MatchController:_stopStartCountdownAnimation()
	self._countdownAnimToken += 1
	local conn = self._countdownConn
	if conn then
		conn:Disconnect()
		self._countdownConn = nil
	end
end

function MatchController:_updateStartCountdown(remaining: number, extraData: any?)
	local frame = self._startCountdownFrame
	if not frame or not self._startCountdownLabel then
		return
	end

	local isStarted = (remaining == 0) or (extraData and extraData.Started == true)
	local isPointRestart = (extraData and extraData.Phase == "PointRestart")
		or (self._currentState == Constants.RoundState.PointRestartCountdown)

	frame.Visible = true

	if self._startCountdownTitle then
		self._startCountdownTitle.Text = if isPointRestart then "SIGUIENTE PUNTO EN" else "LA PARTIDA COMIENZA"
	end

	local rig = self:_getCountdownRig()
	if not rig then
		return
	end

	-- Cancela cualquier animacion previa y reclama un token nuevo
	self:_stopStartCountdownAnimation()
	local myToken = self._countdownAnimToken

	local palette = if isStarted then START_PALETTE else paletteForNumber(remaining)
	paintRig(rig, if isStarted then "¡COMIENZA!" else tostring(remaining), palette)
	rig.Fx.Extrusion.Root.Visible = false
	hideGhosts(rig)
	hideBurst(rig)

	local startClock = os.clock()

	-- Un fotograma: devuelve true cuando la animacion termino
	local function step(): boolean
		local t = os.clock() - startClock
		if isStarted then
			applyPose(rig, startPose(t))
			updateBurst(rig, t)
			return t >= COUNTDOWN.StartTotal
		end
		applyPose(rig, numberPose(t))
		updateGhosts(rig, t)
		return t >= NUMBER_TOTAL
	end

	local function finish()
		hideGhosts(rig)
		hideBurst(rig)
		if isStarted
			and (self._currentState == Constants.RoundState.Playing or self._currentState == Constants.RoundState.Waiting)
		then
			frame.Visible = false
			rig.UIScale.Scale = 1
		end
	end

	-- Primer fotograma inmediato: el label nunca se ve un frame en la pose anterior
	if step() then
		finish()
		return
	end

	local conn: RBXScriptConnection? = nil
	conn = RunService.RenderStepped:Connect(function()
		if self._countdownAnimToken ~= myToken then
			if conn then
				conn:Disconnect()
			end
			return
		end
		if step() then
			if conn then
				conn:Disconnect()
			end
			if self._countdownConn == conn then
				self._countdownConn = nil
			end
			finish()
		end
	end)
	self._countdownConn = conn
end

function MatchController:_clearClonedButtons()
	for _, btn in pairs(self._clonedButtons) do
		btn:Destroy()
	end
	self._clonedButtons = {}
end

function MatchController:_populateMapSelection(maps: { string })
	if not self._mapsContainer or not self._mapButtonTemplate then return end

	self:_clearClonedButtons()

	for _, mapName in ipairs(maps) do
		local btn = self._mapButtonTemplate:Clone()
		btn.Name = "Btn_" .. mapName

		local mapNameLabel = btn:FindFirstChild("MapName") :: TextLabel?
		if mapNameLabel then
			mapNameLabel.Text = mapName
		end

		btn.Visible = true
		btn.MouseButton1Click:Connect(function()
			self:_submitVote(mapName, btn)
		end)

		btn.Parent = self._mapsContainer
		self._clonedButtons[mapName] = btn
	end
end

function MatchController:_submitVote(votePayload: string, clickedButton: TextButton?)
	local remotesFolder = ReplicatedStorage:FindFirstChild("Remotes")
	local matchFolder = remotesFolder and remotesFolder:FindFirstChild("Match")
	local mapSelection = matchFolder and matchFolder:FindFirstChild("MapSelection") :: RemoteEvent?

	if mapSelection and self._currentMatchId then
		mapSelection:FireServer(votePayload, self._currentMatchId)
	else
		return
	end

	self:_highlightSelectedVote(votePayload)
end

function MatchController:_resetButtonHighlights()
	if self._randomButton then
		local stroke = self._randomButton:FindFirstChildOfClass("UIStroke")
		self._randomButton.BackgroundColor3 = Color3.fromRGB(45, 55, 80)
		if stroke then stroke.Color = Color3.fromRGB(90, 120, 180); stroke.Thickness = 1.5 end
	end

	for _, btn in pairs(self._clonedButtons) do
		local stroke = btn:FindFirstChildOfClass("UIStroke")
		btn.BackgroundColor3 = Color3.fromRGB(30, 38, 55)
		if stroke then stroke.Color = Color3.fromRGB(60, 80, 120); stroke.Thickness = 1 end
	end
end

function MatchController:_highlightSelectedVote(votePayload: string)
	self._selectedMapVote = votePayload
	self:_resetButtonHighlights()

	if votePayload == Constants.SpecialMapVote.Random or votePayload == "Aleatorio" then
		if self._randomButton then
			local stroke = self._randomButton:FindFirstChildOfClass("UIStroke")
			self._randomButton.BackgroundColor3 = Color3.fromRGB(50, 100, 180)
			if stroke then stroke.Color = Color3.fromRGB(120, 200, 255); stroke.Thickness = 2 end
		end
	else
		local btn = self._clonedButtons[votePayload]
		if btn then
			local stroke = btn:FindFirstChildOfClass("UIStroke")
			btn.BackgroundColor3 = Color3.fromRGB(40, 90, 160)
			if stroke then stroke.Color = Color3.fromRGB(100, 180, 255); stroke.Thickness = 2 end
		end
	end
end

function MatchController:_handleMatchResult(result: string, winnerName: string?)
	if not self._resultFrame or not self._resultTitle or not self._resultSubtitle then return end

	local stroke = self._resultFrame:FindFirstChildOfClass("UIStroke")

	if result == Constants.MatchResult.Draw then
		self._resultTitle.Text = "EMPATE"
		self._resultTitle.TextColor3 = Color3.fromRGB(200, 205, 215)
		self._resultSubtitle.Text = "Se agoto el tiempo de la partida"
		if stroke then stroke.Color = Color3.fromRGB(150, 160, 180) end

	elseif result == Constants.MatchResult.Cancelled then
		self._resultTitle.Text = "CANCELADO"
		self._resultTitle.TextColor3 = Color3.fromRGB(230, 100, 100)
		self._resultSubtitle.Text = "Un jugador abandono la partida"
		if stroke then stroke.Color = Color3.fromRGB(200, 60, 60) end

	else
		local myRole = self._currentRole
		local isWinner = false

		if myRole and result == myRole then
			isWinner = true
		end

		if isWinner then
			self._resultTitle.Text = "VICTORIA"
			self._resultTitle.TextColor3 = Color3.fromRGB(255, 215, 0)
			self._resultSubtitle.Text = string.format("¡Has ganado la partida contra %s!", winnerName == localPlayer.Name and "tu oponente" or (winnerName or ""))
			if stroke then stroke.Color = Color3.fromRGB(255, 215, 0) end
		else
			self._resultTitle.Text = "DERROTA"
			self._resultTitle.TextColor3 = Color3.fromRGB(230, 70, 70)
			self._resultSubtitle.Text = string.format("Ganador: %s", winnerName or result)
			if stroke then stroke.Color = Color3.fromRGB(220, 50, 50) end
		end
	end

	self._resultFrame.Visible = true
end

return MatchController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1796">
          <Properties>
            <string name="Name">MatchStartEffectsController</string>
            <string name="Source"><![CDATA[--!strict
-- MatchStartEffectsController
-- Controlador cliente dedicado a la presentación y Game Feel del StartCountdown.
-- Responsabilidad exclusiva de PRESENTACIÓN:
-- - Camera Shake local acumulativo y seguro (RenderPriority.Camera + 1) sin alterar la base de la cámara.
-- - Destellos de pantalla (FlashOverlay) con intensidad creciente 5..1 y clímax en ¡COMIENZA!.
-- - Blur dinámico y efímero (Lighting.MatchStartBlur).
-- - Expansión de ondas (PulseFrame y ShockwaveFrame).
-- - Audio direccional/SFX (SoundService.MatchStartSFX).
-- - Aislamiento estricto por MatchId para partidas simultáneas.
-- - Cleanup defensivo ante desconexiones, cancelaciones o transición a Playing.
-- NO altera lógica de gameplay, scoring ni la autoridad del servidor.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")
local SoundService = game:GetService("SoundService")

local Config = require(ReplicatedStorage.Shared.Config)
local Constants = require(ReplicatedStorage.Shared.Constants)

local localPlayer = Players.LocalPlayer
local camera = workspace.CurrentCamera :: Camera

local MatchStartEffectsController = {}
MatchStartEffectsController.Name = "MatchStartEffectsController"

-- Referencias internas
MatchStartEffectsController._context = nil :: any
MatchStartEffectsController._activeMatchId = nil :: string?
MatchStartEffectsController._lastStateVersion = 0
MatchStartEffectsController._activeConnections = {} :: { RBXScriptConnection }
MatchStartEffectsController._activeTweens = {} :: { Tween }
MatchStartEffectsController._activeThreads = {} :: { thread }

-- Instancias de presentación en Lighting, UI y Audio
MatchStartEffectsController._blurEffect = nil :: BlurEffect?
MatchStartEffectsController._flashOverlay = nil :: Frame?
MatchStartEffectsController._pulseFrame = nil :: Frame?
MatchStartEffectsController._shockwaveFrame = nil :: Frame?
MatchStartEffectsController._pulseScale = nil :: UIScale?
MatchStartEffectsController._shockwaveScale = nil :: UIScale?
MatchStartEffectsController._effectsScale = nil :: UIScale?
MatchStartEffectsController._sfxFolder = nil :: Folder?

-- Estado de Camera Shake
MatchStartEffectsController._shakeTrauma = 0
MatchStartEffectsController._shakeDecay = 2.0
MatchStartEffectsController._shakeMoveStuds = 0.5
MatchStartEffectsController._shakeRollDeg = 1.5
MatchStartEffectsController._shakeSeed = math.random() * 1000

local RENDER_STEP_NAME = "MatchStartCameraShake"

-- Accesibilidad: reduce intensidad si el jugador tiene el atributo activado
local function getAccessibilityScale(): number
	if localPlayer and localPlayer:GetAttribute("ReduceScreenEffects") == true then
		return 0.3
	end
	return 1.0
end

function MatchStartEffectsController:Init(context)
	self._context = context
	self._activeMatchId = nil
	self._lastStateVersion = 0
	self._activeConnections = {}
	self._activeTweens = {}
	self._activeThreads = {}

	self:_bindInstances()
	self:_setupCameraShake()
end

function MatchStartEffectsController:Start(context)
	self._context = context
	self:_connectRemotes()
	print("[MatchStartEffectsController] Controlador de Game Feel de inicio de partida iniciado y listo")
end

-- Localiza las instancias visuales y auditivas en Lighting, PlayerGui y SoundService
function MatchStartEffectsController:_bindInstances()
	-- 1. Lighting.MatchStartBlur
	local blur = Lighting:FindFirstChild("MatchStartBlur") :: BlurEffect?
	if not blur then
		blur = Instance.new("BlurEffect")
		blur.Name = "MatchStartBlur"
		blur.Enabled = false
		blur.Size = 0
		blur.Parent = Lighting
	end
	self._blurEffect = blur
	blur.Enabled = false
	blur.Size = 0

	-- 2. StarterGui / PlayerGui.MatchHUD.StartEffects
	task.spawn(function()
		local playerGui = localPlayer:WaitForChild("PlayerGui", 10)
		if not playerGui then return end

		local hud = playerGui:WaitForChild("MatchHUD", 15)
		if not hud then return end

		local effects = hud:WaitForChild("StartEffects", 10)
		if not effects then return end

		self._effectsScale = effects:FindFirstChild("UIScale") :: UIScale?
		self._flashOverlay = effects:FindFirstChild("FlashOverlay") :: Frame?
		self._pulseFrame = effects:FindFirstChild("PulseFrame") :: Frame?
		self._shockwaveFrame = effects:FindFirstChild("ShockwaveFrame") :: Frame?

		if self._pulseFrame then
			self._pulseScale = self._pulseFrame:FindFirstChild("UIScale") :: UIScale?
		end
		if self._shockwaveFrame then
			self._shockwaveScale = self._shockwaveFrame:FindFirstChild("UIScale") :: UIScale?
		end

		if self._flashOverlay then self._flashOverlay.BackgroundTransparency = 1 end
		if self._pulseFrame then self._pulseFrame.Visible = false end
		if self._shockwaveFrame then self._shockwaveFrame.Visible = false end
	end)

	-- 3. SoundService.MatchStartSFX
	self._sfxFolder = SoundService:FindFirstChild("MatchStartSFX") :: Folder?
end

-- Configura el enlace de RunService para la sacudida de cámara local sin modificar CFrame de forma permanente
function MatchStartEffectsController:_setupCameraShake()
	RunService:UnbindFromRenderStep(RENDER_STEP_NAME)

	RunService:BindToRenderStep(RENDER_STEP_NAME, Enum.RenderPriority.Camera.Value + 1, function(dt: number)
		if localPlayer:GetAttribute("ResultsSessionId") ~= nil then self._shakeTrauma = 0; return end
		if self._shakeTrauma <= 0 then return end

		self._shakeTrauma = math.max(0, self._shakeTrauma - dt * self._shakeDecay)
		local traumaSq = self._shakeTrauma * self._shakeTrauma
		local scale = getAccessibilityScale()

		local t = os.clock() * 32
		local nx = math.noise(self._shakeSeed, t, 0) * 2
		local ny = math.noise(self._shakeSeed, t, 15) * 2
		local nr = math.noise(self._shakeSeed, t, 30) * 2

		local cam = workspace.CurrentCamera
		if cam then
			local move = (self._shakeMoveStuds * traumaSq) * scale
			local roll = math.rad(self._shakeRollDeg * traumaSq) * scale
			cam.CFrame = cam.CFrame * CFrame.new(nx * move, ny * move, 0) * CFrame.Angles(0, 0, nr * roll)
		end
	end)
end

-- Conexión reactiva a los RemoteEvents existentes
function MatchStartEffectsController:_connectRemotes()
	local remotesFolder = ReplicatedStorage:WaitForChild("Remotes", 10)
	if not remotesFolder then return end

	local matchFolder = remotesFolder:WaitForChild("Match", 10)
	if not matchFolder then return end

	local stateChanged = matchFolder:WaitForChild("StateChanged", 10) :: RemoteEvent?
	local countdown = matchFolder:WaitForChild("Countdown", 10) :: RemoteEvent?

	if stateChanged then
		table.insert(self._activeConnections, stateChanged.OnClientEvent:Connect(function(newState: string, extraData: any)
			self:_handleStateChanged(newState, extraData)
		end))
	end

	if countdown then
		table.insert(self._activeConnections, countdown.OnClientEvent:Connect(function(remaining: number, label: string, extraData: any?)
			self:_handleCountdown(remaining, label, extraData)
		end))
	end
end

-- Determina si el jugador local pertenece al match según los datos del servidor
local function isLocalPlayerInMatch(extraData: any): boolean
	return type(extraData) == "table"
		and type(extraData.ParticipantUserIds) == "table"
		and table.find(extraData.ParticipantUserIds, localPlayer.UserId) ~= nil
end

function MatchStartEffectsController:_acceptSessionPayload(extraData: any, allowBind: boolean, advanceVersion: boolean?): boolean
	if type(extraData) ~= "table" then return false end
	local sessionId = extraData.SessionId or extraData.MatchId
	if type(sessionId) ~= "string" or sessionId == "" then return false end
	local version = extraData.StateVersion
	if version ~= nil and type(version) ~= "number" then return false end
	if self._activeMatchId == nil then
		if not allowBind or localPlayer:GetAttribute("MatchId") ~= sessionId or not isLocalPlayerInMatch(extraData) then
			return false
		end
		self._activeMatchId = sessionId
		self._lastStateVersion = 0
	elseif self._activeMatchId ~= sessionId then
		return false
	end
	if version ~= nil and version < self._lastStateVersion then return false end
	if advanceVersion and version ~= nil then self._lastStateVersion = version end
	return true
end

function MatchStartEffectsController:_handleStateChanged(newState: string, extraData: any)
	if not self:_acceptSessionPayload(extraData, true, true) then return end
	local eventSessionId = self._activeMatchId
	if newState == Constants.RoundState.StartCountdown
		or newState == Constants.RoundState.PointRestartCountdown
		or newState == Constants.RoundState.MatchReady then
	elseif newState == Constants.RoundState.Playing then
		-- Al entrar a Playing, programar cleanup tras un breve respiro para que concluya la secuencia de ¡COMIENZA!
		task.delay(0.75, function()
			if self._activeMatchId == eventSessionId then self:Cleanup() end
		end)
	elseif newState == Constants.RoundState.Ending
		or newState == Constants.RoundState.ReturningToLobby
		or newState == Constants.RoundState.Waiting then
		self:Cleanup()
		if newState == Constants.RoundState.ReturningToLobby or newState == Constants.RoundState.Waiting then
			self._activeMatchId = nil
			self._lastStateVersion = 0
		end
	end
end

function MatchStartEffectsController:_handleCountdown(remaining: number, label: string, extraData: any?)
	-- Solo procesar conteos correspondientes a START_COUNTDOWN
	if label ~= "START_COUNTDOWN" and (extraData == nil or extraData.Started == nil) then
		return
	end

	if not self:_acceptSessionPayload(extraData, false, false) then return end

	if remaining > 0 then
		self:PlayCountdown(remaining, extraData)
	elseif remaining == 0 or (extraData and extraData.Started == true) then
		self:PlayStart(extraData)
	end
end

-- ==================================================
-- EJECUCIÓN MODULAR DE EFECTOS
-- ==================================================

-- Impacto audiovisual correspondiente a un número (5..1 o 3..1)
function MatchStartEffectsController:PlayCountdown(value: number, extraData: any?)
	local isPointRestart = (extraData and extraData.Phase == "PointRestart")
	local key = tostring(value)
	local cfgTable = if isPointRestart
		then (Config.PointRestartCountdownEffects or Config.StartCountdownEffects)
		else Config.StartCountdownEffects

	local cfg = (cfgTable and cfgTable[key]) or {
		ShakeStuds = 0.20,
		ShakeRotationDeg = 1.0,
		ShakeDuration = 0.35,
		FlashTransparency = 0.85,
		FlashFadeDuration = 0.25,
		BlurSize = 3,
		BlurDuration = 0.30,
		PulseScale = 1.6,
		PulseDuration = 0.30,
		SoundName = "CountdownTick",
		SoundVolume = 0.70,
		SoundPlaybackSpeed = 1.0,
	}

	-- 1. Camera Shake
	self:Shake(cfg.ShakeStuds, cfg.ShakeRotationDeg, cfg.ShakeDuration)

	-- 2. Screen Flash
	self:Flash(cfg.FlashTransparency, cfg.FlashFadeDuration)

	-- 3. Blur
	self:Blur(cfg.BlurSize, cfg.BlurDuration)

	-- 4. Pulse de expansión (manteniendo color editable en Studio)
	self:Pulse(cfg.PulseScale, cfg.PulseDuration)

	-- 5. Audio
	if cfg.SoundName then
		self:PlaySound(cfg.SoundName, cfg.SoundVolume, cfg.SoundPlaybackSpeed)
	end
end

-- Clímax cinematográfico correspondiente a ¡COMIENZA!
function MatchStartEffectsController:PlayStart(extraData: any?)
	local isPointRestart = (extraData and extraData.Phase == "PointRestart")
	local cfgTable = if isPointRestart
		then (Config.PointRestartCountdownEffects or Config.StartCountdownEffects)
		else Config.StartCountdownEffects

	local cfg = (cfgTable and cfgTable["GO"]) or {
		ShakeStuds = 0.90,
		ShakeRotationDeg = 3.0,
		ShakeDuration = 0.70,
		FlashTransparency = 0.18,
		FlashFadeDuration = 0.50,
		BlurSize = 10.0,
		BlurDuration = 0.60,
		PulseScale = 2.8,
		PulseDuration = 0.50,
		ShockwaveScale = 3.5,
		ShockwaveDuration = 0.55,
		WhooshSoundName = "StartWhoosh",
		ImpactSoundName = "StartImpact",
		SoundVolume = 1.25,
	}

	-- T+0.00: Gran flash, fuerte sacudida, blur y sonido whoosh
	self:Flash(cfg.FlashTransparency, cfg.FlashFadeDuration)
	self:Shake(cfg.ShakeStuds * 0.7, cfg.ShakeRotationDeg * 0.7, 0.35)
	self:Blur(cfg.BlurSize, cfg.BlurDuration)
	if cfg.WhooshSoundName then
		self:PlaySound(cfg.WhooshSoundName, 0.9, 1.0)
	end

	-- T+0.12 (o T+0.08 en PointRestart más rápido): Shockwave grande, impacto de cámara máximo y sonido explosivo
	local delayTime = if isPointRestart then 0.08 else 0.12
	local th = task.delay(delayTime, function()
		self:Shake(cfg.ShakeStuds, cfg.ShakeRotationDeg, cfg.ShakeDuration)
		self:Shockwave(cfg.ShockwaveScale or 3.5, cfg.ShockwaveDuration or 0.55)
		if cfg.ImpactSoundName then
			self:PlaySound(cfg.ImpactSoundName, cfg.SoundVolume or 1.25, 1.0)
		end
	end)
	table.insert(self._activeThreads, th)
end

-- Aplica impulso de sacudida a la cámara con trauma decreciente
function MatchStartEffectsController:Shake(studs: number, rotDeg: number, duration: number)
	self._shakeMoveStuds = studs
	self._shakeRollDeg = rotDeg
	self._shakeDecay = 1.0 / math.max(0.1, duration)
	self._shakeTrauma = 1.0
end

-- Destello de pantalla (FlashOverlay)
function MatchStartEffectsController:Flash(peakTransparency: number, fadeTime: number)
	local overlay = self._flashOverlay
	if not overlay then return end

	local accScale = getAccessibilityScale()
	local effectiveTransparency = 1 - ((1 - peakTransparency) * accScale)

	overlay.BackgroundTransparency = effectiveTransparency
	overlay.Visible = true

	local tw = TweenService:Create(overlay, TweenInfo.new(fadeTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		BackgroundTransparency = 1,
	})
	table.insert(self._activeTweens, tw)
	tw.Completed:Once(function()
		if overlay.BackgroundTransparency >= 0.99 then
			overlay.BackgroundTransparency = 1
		end
	end)
	tw:Play()
end

-- Blur efímero en Lighting
function MatchStartEffectsController:Blur(targetSize: number, duration: number)
	local blur = self._blurEffect
	if not blur then return end

	local accScale = getAccessibilityScale()
	local effectiveSize = targetSize * accScale

	blur.Enabled = true
	blur.Size = effectiveSize

	local holdTime = duration * 0.25
	local fadeTime = duration * 0.75

	local th = task.delay(holdTime, function()
		if not blur or not blur.Parent then return end
		local tw = TweenService:Create(blur, TweenInfo.new(fadeTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = 0,
		})
		table.insert(self._activeTweens, tw)
		tw.Completed:Once(function()
			if blur and blur.Size <= 0.2 then
				blur.Size = 0
				blur.Enabled = false
			end
		end)
		tw:Play()
	end)
	table.insert(self._activeThreads, th)
end

-- Onda expansiva sutil (PulseFrame) alrededor del centro del HUD
function MatchStartEffectsController:Pulse(targetScale: number, duration: number, strokeColor: Color3?)
	local frame = self._pulseFrame
	if not frame then return end

	local stroke = frame:FindFirstChildOfClass("UIStroke")
	if not stroke then return end

	local uiScale = self._pulseScale or frame:FindFirstChildOfClass("UIScale")

	frame.Visible = true
	if strokeColor then
		stroke.Color = strokeColor
	end
	stroke.Transparency = 0.1

	if uiScale then
		uiScale.Scale = 0.3
		local twScale = TweenService:Create(uiScale, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Scale = targetScale,
		})
		local twStroke = TweenService:Create(stroke, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Transparency = 1,
		})

		table.insert(self._activeTweens, twScale)
		table.insert(self._activeTweens, twStroke)

		twScale.Completed:Once(function()
			frame.Visible = false
			uiScale.Scale = 1.0
		end)

		twScale:Play()
		twStroke:Play()
	else
		local baseSize = UDim2.fromOffset(120, 120)
		frame.Size = baseSize
		local targetSize = UDim2.fromOffset(120 * targetScale, 120 * targetScale)

		local twSize = TweenService:Create(frame, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = targetSize,
		})
		local twStroke = TweenService:Create(stroke, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Transparency = 1,
		})

		table.insert(self._activeTweens, twSize)
		table.insert(self._activeTweens, twStroke)

		twSize.Completed:Once(function()
			frame.Visible = false
		end)

		twSize:Play()
		twStroke:Play()
	end
end

-- Onda expansiva prominente (ShockwaveFrame) para ¡COMIENZA!
function MatchStartEffectsController:Shockwave(targetScale: number, duration: number)
	local frame = self._shockwaveFrame
	if not frame then return end

	local stroke = frame:FindFirstChildOfClass("UIStroke")
	if not stroke then return end

	local uiScale = self._shockwaveScale or frame:FindFirstChildOfClass("UIScale")

	frame.Visible = true
	stroke.Transparency = 0

	if uiScale then
		uiScale.Scale = 0.2
		local twScale = TweenService:Create(uiScale, TweenInfo.new(duration, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), {
			Scale = targetScale,
		})
		local twStroke = TweenService:Create(stroke, TweenInfo.new(duration, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), {
			Transparency = 1,
		})

		table.insert(self._activeTweens, twScale)
		table.insert(self._activeTweens, twStroke)

		twScale.Completed:Once(function()
			frame.Visible = false
			uiScale.Scale = 1.0
		end)

		twScale:Play()
		twStroke:Play()
	else
		local baseSize = UDim2.fromOffset(140, 140)
		frame.Size = baseSize
		local targetSize = UDim2.fromOffset(140 * targetScale, 140 * targetScale)

		local twSize = TweenService:Create(frame, TweenInfo.new(duration, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), {
			Size = targetSize,
		})
		local twStroke = TweenService:Create(stroke, TweenInfo.new(duration, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), {
			Transparency = 1,
		})

		table.insert(self._activeTweens, twSize)
		table.insert(self._activeTweens, twStroke)

		twSize.Completed:Once(function()
			frame.Visible = false
		end)

		twSize:Play()
		twStroke:Play()
	end
end

-- Reproduce un sonido localizado en SoundService.MatchStartSFX
function MatchStartEffectsController:PlaySound(soundName: string, volume: number?, speed: number?)
	local folder = self._sfxFolder or SoundService:FindFirstChild("MatchStartSFX")
	if not folder then return end

	local sfx = folder:FindFirstChild(soundName) :: Sound?
	if sfx and sfx:IsA("Sound") then
		local clone = sfx:Clone()
		if volume then clone.Volume = volume end
		if speed then clone.PlaybackSpeed = speed end
		clone.Parent = SoundService
		clone.Ended:Once(function()
			clone:Destroy()
		end)
		clone:Play()
		-- Limpieza de seguridad por si el audio se interrumpe
		task.delay(3, function()
			if clone and clone.Parent then
				clone:Destroy()
			end
		end)
	end
end

-- Limpieza exhaustiva de todos los efectos visuales y auditivos
function MatchStartEffectsController:Cleanup()
	-- 1. Reset Camera Shake
	self._shakeTrauma = 0

	-- 2. Cancelar tweens activos
	for _, tw in ipairs(self._activeTweens) do
		pcall(function()
			tw:Cancel()
		end)
	end
	self._activeTweens = {}

	-- 3. Cancelar hilos activos
	for _, th in ipairs(self._activeThreads) do
		pcall(task.cancel, th)
	end
	self._activeThreads = {}

	-- 4. Reset Blur
	if self._blurEffect then
		self._blurEffect.Size = 0
		self._blurEffect.Enabled = false
	end

	-- 5. Reset Overlays y Frames
	if self._flashOverlay then
		self._flashOverlay.BackgroundTransparency = 1
	end
	if self._pulseFrame then
		self._pulseFrame.Visible = false
		local s = self._pulseFrame:FindFirstChildOfClass("UIStroke")
		if s then s.Transparency = 1 end
		local sc = self._pulseScale or self._pulseFrame:FindFirstChildOfClass("UIScale")
		if sc then sc.Scale = 1.0 end
	end
	if self._shockwaveFrame then
		self._shockwaveFrame.Visible = false
		local s = self._shockwaveFrame:FindFirstChildOfClass("UIStroke")
		if s then s.Transparency = 1 end
		local sc = self._shockwaveScale or self._shockwaveFrame:FindFirstChildOfClass("UIScale")
		if sc then sc.Scale = 1.0 end
	end
end

return MatchStartEffectsController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1797">
          <Properties>
            <string name="Name">MatchmakingController</string>
            <string name="Source"><![CDATA[--!strict
-- MatchmakingController
-- Controlador del HUD de matchmaking genérico (1v1, 2v2, 3v3).
-- Controla la visualización de PlayerGui.MatchmakingHUD basándose en los QueueSnapshots
-- emitidos autoritativamente por el servidor. NO crea la interfaz mediante código.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Constants = require(ReplicatedStorage.Shared.Constants)
local Types = require(ReplicatedStorage.Shared.Types)

type QueueSnapshot = Types.QueueSnapshot

local localPlayer = Players.LocalPlayer

local MatchmakingController = {}
MatchmakingController.Name = "MatchmakingController"

-- Referencias a instancias de PlayerGui.MatchmakingHUD
MatchmakingController._hud = nil :: ScreenGui?
MatchmakingController._queueFrame = nil :: Frame?
MatchmakingController._title = nil :: TextLabel?
MatchmakingController._statusBadge = nil :: TextLabel?
MatchmakingController._redTeamHeader = nil :: TextLabel?
MatchmakingController._blueTeamHeader = nil :: TextLabel?
MatchmakingController._redSlotsContainer = nil :: Frame?
MatchmakingController._blueSlotsContainer = nil :: Frame?
MatchmakingController._slotTemplate = nil :: Frame?

MatchmakingController._redSlotClones = {} :: { Frame }
MatchmakingController._blueSlotClones = {} :: { Frame }
MatchmakingController._currentZone = nil :: string?
MatchmakingController._context = nil :: any
MatchmakingController._isInQueue = false

function MatchmakingController:Init(context)
	self._context = context
	self:_cleanupLegacyPadMusic()
	self:_bindHUD()
end

function MatchmakingController:IsInQueue(): boolean
	return self._isInQueue
end

function MatchmakingController:Start(context)
	self._context = context
	self:_connectRemotes()
	print("[MatchmakingController] Controlador de matchmaking iniciado y enlazado a PlayerGui.MatchmakingHUD")
end

function MatchmakingController:_bindHUD()
	local playerGui = localPlayer:WaitForChild("PlayerGui")
	local hud = playerGui:WaitForChild("MatchmakingHUD", 15) :: ScreenGui?
	if not hud then
		warn("[MatchmakingController] No se encontro MatchmakingHUD en PlayerGui")
		return
	end
	self._hud = hud

	local queueFrame = hud:WaitForChild("QueueFrame", 10) :: Frame?
	if not queueFrame then
		warn("[MatchmakingController] No se encontro QueueFrame en MatchmakingHUD")
		return
	end
	self._queueFrame = queueFrame
	queueFrame.Visible = false

	local header = queueFrame:FindFirstChild("Header") :: Frame?
	if header then
		self._title = header:FindFirstChild("Title") :: TextLabel?
		self._statusBadge = header:FindFirstChild("StatusBadge") :: TextLabel?
	end

	local content = queueFrame:FindFirstChild("Content") or queueFrame
	local redSide = content:FindFirstChild("RedTeam") or content:FindFirstChild("LocalTeam")
	local blueSide = content:FindFirstChild("BlueTeam") or content:FindFirstChild("OpponentTeam")

	if redSide then
		local header = redSide:FindFirstChild("TeamLabel") or redSide:FindFirstChild("TeamHeader")
		if header and header:IsA("TextLabel") then
			header.Visible = true
			header.Position = UDim2.new(header.Position.X.Scale, header.Position.X.Offset, 0, -36)
			self._redTeamHeader = header
		end
		self._redSlotsContainer = redSide:FindFirstChild("SlotsContainer") :: Frame?
	end

	if blueSide then
		local header = blueSide:FindFirstChild("TeamLabel") or blueSide:FindFirstChild("TeamHeader")
		if header and header:IsA("TextLabel") then
			header.Visible = true
			header.Position = UDim2.new(header.Position.X.Scale, header.Position.X.Offset, 0, -36)
			self._blueTeamHeader = header
		end
		self._blueSlotsContainer = blueSide:FindFirstChild("SlotsContainer") :: Frame?
	end

	local template = queueFrame:FindFirstChild("PlayerSlotTemplate", true) :: Frame?
	if template then
		self._slotTemplate = template
		template.Visible = false
	end
	-- Reuse the authored center label when this HUD has no separate status header.
	if not self._statusBadge then
		local versus = content:FindFirstChild("Versus")
		self._statusBadge = versus and versus:FindFirstChildOfClass("TextLabel")
	end
	local scale = queueFrame:FindFirstChild("CardScale")
	if scale and scale:IsA("UIScale") then
		self._queueScale = scale
		self._authoredQueueScale = scale.Scale
	end
	if self._queueSizeConnection then self._queueSizeConnection:Disconnect() end
	if self._viewportSizeConnection then self._viewportSizeConnection:Disconnect() end
	self._queueSizeConnection = queueFrame:GetPropertyChangedSignal("AbsoluteSize"):Connect(function() self:_fitQueue() end)
	self._viewportSizeConnection = hud:GetPropertyChangedSignal("AbsoluteSize"):Connect(function() self:_fitQueue() end)
end

-- Bound the existing card to the viewport; preserve its authored scale whenever it fits.
function MatchmakingController:_fitQueue()
	local frame, scale, hud = self._queueFrame, self._queueScale, self._hud
	if not frame or not scale or not hud or scale.Scale <= 0 then return end
	local width = frame.AbsoluteSize.X / scale.Scale
	if width <= 0 or hud.AbsoluteSize.X <= 0 then return end
	local fitted = math.min(self._authoredQueueScale or 1, hud.AbsoluteSize.X * 0.92 / width)
	if math.abs(scale.Scale - fitted) > 0.001 then scale.Scale = fitted end
end

function MatchmakingController:_connectRemotes()
	local remotes = ReplicatedStorage:WaitForChild("Remotes", 10)
	if not remotes then return end

	local mmFolder = remotes:WaitForChild("Matchmaking", 10)
	if mmFolder then
		local queueRemote = mmFolder:WaitForChild("QueueStatus", 10) :: RemoteEvent?
		if queueRemote then
			queueRemote.OnClientEvent:Connect(function(snapshot: QueueSnapshot)
				self:_handleQueueStatus(snapshot)
			end)
		end
	end

	-- Ocultar el HUD de matchmaking únicamente cuando la partida pasa a fases comprometidas (supera la preparación)
	local matchFolder = remotes:WaitForChild("Match", 10)
	if matchFolder then
		local stateChanged = matchFolder:WaitForChild("StateChanged", 10) :: RemoteEvent?
		if stateChanged then
			stateChanged.OnClientEvent:Connect(function(newState: string, payload: any)
				local sessionId = type(payload) == "table" and (payload.SessionId or payload.MatchId) or nil
				if type(sessionId) ~= "string" or localPlayer:GetAttribute("MatchId") ~= sessionId then return end
				local isPreparationState = (newState == Constants.RoundState.Waiting
					or newState == Constants.RoundState.MatchReady
					or newState == Constants.RoundState.MatchCountdown)

				if not isPreparationState then
					if self._queueFrame then
						self._queueFrame.Visible = false
					end
					self._isInQueue = false
				end
			end)
		end
	end
end

-- Limpia los slots clonados previos
function MatchmakingController:_clearSlots()
	for _, slot in ipairs(self._redSlotClones) do
		slot:Destroy()
	end
	self._redSlotClones = {}

	for _, slot in ipairs(self._blueSlotClones) do
		slot:Destroy()
	end
	self._blueSlotClones = {}
end

-- Limpieza defensiva de cualquier audio de pad residual en SoundService
function MatchmakingController:_cleanupLegacyPadMusic()
	local SoundService = game:GetService("SoundService")
	local old = SoundService:FindFirstChild("LocalMatchmakingPadMusic")
	if old then
		if old:IsA("Sound") and old.IsPlaying then
			old:Stop()
		end
		old:Destroy()
	end
end

-- Determina si el jugador local forma parte de la lista de un equipo
local function isPlayerInList(player: Player, list: { Player }): boolean
	for _, p in ipairs(list) do
		if p == player then return true end
	end
	return false
end

function MatchmakingController:_handleQueueStatus(snapshot: QueueSnapshot)
	if not self._queueFrame or not self._slotTemplate then
		self:_bindHUD()
		if not self._queueFrame or not self._slotTemplate then return end
	end

	local inRed = isPlayerInList(localPlayer, snapshot.Red)
	local inBlue = isPlayerInList(localPlayer, snapshot.Blue)
	local isParticipant = inRed or inBlue
	local snapshotZoneId = snapshot.ZoneId or snapshot.ZoneName

	if isParticipant then
		self._currentZone = snapshotZoneId
		self._queueFrame.Visible = true

		if not self._isInQueue then
			self._isInQueue = true
			local musicController = self._context and self._context:GetController("MusicController")
			if musicController then
				musicController:PlayMatchmaking()
			end
		end
	else
		-- El jugador no es participante de este snapshot recibido.
		-- ÚNICAMENTE cerramos el HUD si el snapshot proviene de la zona que el jugador estaba siguiendo actualmente.
		if self._currentZone ~= nil and self._currentZone == snapshotZoneId then
			self._queueFrame.Visible = false
			self:_clearSlots()
			self._currentZone = nil

			if self._isInQueue then
				self._isInQueue = false
				local matchController = self._context and self._context:GetController("MatchController")
				local inMatch = matchController and typeof(matchController.IsParticipant) == "function" and matchController:IsParticipant()
				if not inMatch then
					local musicController = self._context and self._context:GetController("MusicController")
					if musicController then
						musicController:PlayLobby()
					end
				end
			end
		end
		-- Si el snapshot pertenece a otra zona diferente donde el jugador no está, se ignora completamente
		return
	end

	-- 1. Actualizar Título y Estado
	if self._redTeamHeader then
		self._redTeamHeader.Text = string.format("RED %d/%d", #snapshot.Red, snapshot.TeamSize)
	end
	if self._blueTeamHeader then
		self._blueTeamHeader.Text = string.format("BLUE %d/%d", #snapshot.Blue, snapshot.TeamSize)
	end
	if self._title then
		self._title.Text = string.format("COLA %s", string.upper(snapshot.Mode))
	end

	if self._statusBadge then
		if snapshot.State == "READY" then
			self._statusBadge.Text = "¡PARTIDA LISTA!"
			self._statusBadge.TextColor3 = Color3.fromRGB(120, 255, 160)
			self._statusBadge.BackgroundColor3 = Color3.fromRGB(20, 50, 30)
		else
			local currentTotal = #snapshot.Red + #snapshot.Blue
			self._statusBadge.Text = string.format("ESPERANDO (%d/%d)", currentTotal, snapshot.TotalPlayers)
			self._statusBadge.TextColor3 = Color3.fromRGB(180, 205, 255)
			self._statusBadge.BackgroundColor3 = Color3.fromRGB(30, 40, 60)
		end
	end

	-- 2. Renderizar Slots de cada lado (Lado Izquierdo = Red, Lado Derecho = Blue)
	self:_clearSlots()

	if self._redSlotsContainer then
		for i = 1, snapshot.TeamSize do
			local player = snapshot.Red[i]
			local slot = self:_createSlotInstance(player, "Red")
			slot.Parent = self._redSlotsContainer
			table.insert(self._redSlotClones, slot)
		end
	end

	if self._blueSlotsContainer then
		for i = 1, snapshot.TeamSize do
			local player = snapshot.Blue[i]
			local slot = self:_createSlotInstance(player, "Blue")
			slot.Parent = self._blueSlotsContainer
			table.insert(self._blueSlotClones, slot)
		end
	end
	self:_fitQueue()
end

-- Clona y configura una instancia del template de slot de jugador
function MatchmakingController:_createSlotInstance(player: Player?, teamName: string): Frame
	local slot = self._slotTemplate:Clone() :: Frame
	slot.Name = "Slot_" .. (player and player.Name or "Empty")

	local nameLabel = slot:FindFirstChild("NameLabel", true) :: TextLabel?
	local body = slot:FindFirstChild("Body") or slot
	local occupied = body:FindFirstChild("Occupied") :: Frame?
	local empty = body:FindFirstChild("Empty") :: Frame?

	local avatarImg = (occupied and occupied:FindFirstChild("Avatar", true)) :: ImageLabel?
		or (slot:FindFirstChild("Avatar", true) :: ImageLabel?)
	local displayName = (occupied and occupied:FindFirstChild("DisplayName", true)) :: TextLabel?
		or (slot:FindFirstChild("DisplayName", true) :: TextLabel?)
	local username = (occupied and occupied:FindFirstChild("Username", true)) :: TextLabel?
		or (slot:FindFirstChild("Username", true) :: TextLabel?)
	local occupiedStroke = (occupied and occupied:FindFirstChildOfClass("UIStroke"))
		or slot:FindFirstChildOfClass("UIStroke")
	local emptyStroke = empty and empty:FindFirstChildOfClass("UIStroke")
	local questionMark = empty and empty:FindFirstChild("QuestionMark", true) :: TextLabel?

	local teamColor = if teamName == "Red"
		then Color3.fromRGB(235, 65, 80)
		else Color3.fromRGB(65, 140, 245)

	-- Creación defensiva de NameLabel si no existe en el template
	if not nameLabel then
		local newLabel = Instance.new("TextLabel")
		newLabel.Name = "NameLabel"
		newLabel.Size = UDim2.new(1.3, 0, 0, 16)
		newLabel.Position = UDim2.new(0.5, 0, 0, -4)
		newLabel.AnchorPoint = Vector2.new(0.5, 1)
		newLabel.BackgroundTransparency = 1
		newLabel.Font = Enum.Font.GothamBold
		newLabel.TextScaled = true
		newLabel.ZIndex = 5

		local tc = Instance.new("UITextSizeConstraint")
		tc.MaxTextSize = 14
		tc.MinTextSize = 9
		tc.Parent = newLabel

		local st = Instance.new("UIStroke")
		st.Color = Color3.fromRGB(0, 0, 0)
		st.Thickness = 1.2
		st.Transparency = 0.2
		st.Parent = newLabel

		newLabel.Parent = slot
		nameLabel = newLabel
	end

	-- Creación defensiva de QuestionMark en Empty si no existe
	if empty and not questionMark then
		local qm = Instance.new("TextLabel")
		qm.Name = "QuestionMark"
		qm.Size = UDim2.new(0.6, 0, 0.6, 0)
		qm.Position = UDim2.new(0.5, 0, 0.5, 0)
		qm.AnchorPoint = Vector2.new(0.5, 0.5)
		qm.BackgroundTransparency = 1
		qm.Font = Enum.Font.GothamBold
		qm.Text = "?"
		qm.TextColor3 = Color3.fromRGB(80, 95, 125)
		qm.TextScaled = true
		qm.ZIndex = 3
		qm.Parent = empty
		questionMark = qm
	end

	if player then
		if occupied then occupied.Visible = true end
		if empty then empty.Visible = false end

		local pDisplayName = if player.DisplayName and player.DisplayName ~= "" then player.DisplayName else player.Name
		local pUsername = "@" .. player.Name

		-- Nombre visible encima del recuadro
		if nameLabel then
			nameLabel.Text = pDisplayName
			nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
			nameLabel.Visible = true
		end

		if displayName then
			displayName.Text = pDisplayName
			displayName.Visible = false -- Nombre principal está arriba del recuadro
		end

		if username then
			username.Text = pUsername
			username.Visible = false
		end

		if avatarImg then
			-- Avatar real del jugador mediante thumbnail oficial de Roblox
			avatarImg.Image = string.format("rbxthumb://type=AvatarBust&id=%d&w=150&h=150", player.UserId)
			avatarImg.Visible = true
		end

		if occupiedStroke then
			occupiedStroke.Color = teamColor
			occupiedStroke.Thickness = 1.5
		end
	else
		-- Estado cuando todavía no hay rival o slot vacío
		if occupied then occupied.Visible = false end
		if empty then empty.Visible = true end

		if nameLabel then
			nameLabel.Text = "ESPERANDO..."
			nameLabel.TextColor3 = Color3.fromRGB(130, 145, 175)
			nameLabel.Visible = true
		end

		if displayName then
			displayName.Text = "ESPERANDO..."
			displayName.TextColor3 = Color3.fromRGB(130, 145, 175)
			displayName.Visible = false
		end

		if username then
			username.Visible = false
		end

		if avatarImg then
			avatarImg.Visible = false
		end

		if questionMark then
			questionMark.Text = "?"
			questionMark.Visible = true
		end

		local spinner = empty and empty:FindFirstChild("Spinner")
		if spinner then
			spinner.Visible = false
		end

		if emptyStroke then
			emptyStroke.Color = Color3.fromRGB(45, 55, 75)
			emptyStroke.Thickness = 1
		end
	end

	slot.Visible = true
	return slot
end

return MatchmakingController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1798">
          <Properties>
            <string name="Name">MusicController</string>
            <string name="Source"><![CDATA[--!strict
-- MusicController
-- Controlador centralizado y exclusivo de la música de fondo LOCAL del jugador.
-- La música es 100% cliente, no replicada, y completamente independiente de los SFX, UI y Combat Sounds.

local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local Config = require(game.ReplicatedStorage.Shared.Config)
local Players = game:GetService("Players")

export type MusicState = "None" | "Lobby" | "Matchmaking" | "Arena" | "SuddenDeath" | "Victory" | "Defeat" | "Draw"

local MusicController = {}
MusicController.Name = "MusicController"

-- Configuración de Usuario (Local)
MusicController._musicEnabled = true
MusicController._userMusicVolume = 1.0

-- Estado de Reproducción
MusicController._suddenDeathActive = false
MusicController._currentState = "None" :: MusicState
MusicController._currentMapName = nil :: string?
MusicController._currentSound = nil :: Sound?
MusicController._baseVolumes = {} :: { [Sound]: number }
MusicController._activeTweens = {} :: { [Sound]: Tween }
MusicController._transitionToken = 0
MusicController._context = nil :: any

-- Suspensiones Locales de Música
MusicController._suspensions = {} :: { [string]: { Token: number, PreviousState: MusicState, PreviousMap: string?, PreviousSound: Sound? } }
MusicController._suspensionTokenCounter = 0
MusicController._pendingMusicState = nil :: { State: MusicState, MapName: string?, FadeDuration: number? }?

-- Parámetros de Fade
local DEFAULT_FADE_DURATION = 0.8
local FADE_EASING_STYLE = Enum.EasingStyle.Quad
local FADE_EASING_DIR = Enum.EasingDirection.Out

--------------------------------------------------------------------------------
-- Helpers Internos de Jerarquía en SoundService
--------------------------------------------------------------------------------

function MusicController:_getMusicFolder(): Folder?
	local musicFolder = SoundService:FindFirstChild("Music")
	if musicFolder and musicFolder:IsA("Folder") then
		return musicFolder
	end
	return nil
end

function MusicController:_getArenasFolder(): Folder?
	local musicFolder = self:_getMusicFolder()
	if not musicFolder then return nil end
	local arenasFolder = musicFolder:FindFirstChild("Arenas")
	if arenasFolder and arenasFolder:IsA("Folder") then
		return arenasFolder
	end
	return nil
end

function MusicController:_registerSound(sound: Instance)
	if sound:IsA("Sound") then
		if self._baseVolumes[sound] == nil then
			-- Almacenar el volumen original de Studio como referencia inmutable
			local baseVol = sound.Volume
			if baseVol <= 0 then
				baseVol = 0.35
			end
			self._baseVolumes[sound] = baseVol
		end
	end
end

function MusicController:_cacheAllSounds()
	local musicFolder = self:_getMusicFolder()
	if not musicFolder then return end

	for _, desc in ipairs(musicFolder:GetDescendants()) do
		self:_registerSound(desc)
	end

	musicFolder.DescendantAdded:Connect(function(desc)
		self:_registerSound(desc)
	end)
end

function MusicController:_getSoundInstance(name: string): Sound?
	local musicFolder = self:_getMusicFolder()
	if not musicFolder then return nil end
	local sound = musicFolder:FindFirstChild(name)
	if sound and sound:IsA("Sound") then
		self:_registerSound(sound)
		return sound
	end
	return nil
end

function MusicController:_getArenaSound(mapName: string): Sound?
	local arenasFolder = self:_getArenasFolder()
	if not arenasFolder then return nil end

	-- 1. Coincidencia exacta con el nombre del mapa
	local sound = arenasFolder:FindFirstChild(mapName)
	if sound and sound:IsA("Sound") then
		self:_registerSound(sound)
		return sound
	end

	-- 2. Fallback opcional a "ArenaDefault" o "Default"
	local fallback = arenasFolder:FindFirstChild("ArenaDefault") or arenasFolder:FindFirstChild("Default")
	if fallback and fallback:IsA("Sound") then
		self:_registerSound(fallback)
		return fallback
	end

	return nil
end

--------------------------------------------------------------------------------
-- Cálculo de Volumen
--------------------------------------------------------------------------------

function MusicController:_getTargetVolume(sound: Sound): number
	if not self._musicEnabled then
		return 0
	end

	local baseVolume = self._baseVolumes[sound] or sound.Volume
	local userVol = math.clamp(self._userMusicVolume, 0, 1)
	return baseVolume * userVol
end

--------------------------------------------------------------------------------
-- Transiciones y Cross-Fade
--------------------------------------------------------------------------------

function MusicController:_cancelTweenForSound(sound: Sound)
	local active = self._activeTweens[sound]
	if active then
		active:Cancel()
		active:Destroy()
		self._activeTweens[sound] = nil
	end
end

function MusicController:_getAllManagedSounds(): { Sound }
	local sounds: { Sound } = {}
	local musicFolder = self:_getMusicFolder()
	if musicFolder then
		for _, desc in ipairs(musicFolder:GetDescendants()) do
			if desc:IsA("Sound") then
				table.insert(sounds, desc)
			end
		end
	end
	return sounds
end

function MusicController:_transitionTo(newSound: Sound?, newState: MusicState, fadeDuration: number?)
	local duration = fadeDuration or DEFAULT_FADE_DURATION

	self._transitionToken += 1
	local thisToken = self._transitionToken

	self._currentState = newState
	self._currentSound = newSound

	-- 1. Fade Out de todos los sonidos activos que NO sean el nuevo sonido
	for _, sound in ipairs(self:_getAllManagedSounds()) do
		if sound ~= newSound then
			self:_cancelTweenForSound(sound)

			if sound.IsPlaying or sound.Volume > 0 then
				if duration > 0 then
					local tweenInfo = TweenInfo.new(duration, FADE_EASING_STYLE, FADE_EASING_DIR)
					local fadeOutTween = TweenService:Create(sound, tweenInfo, { Volume = 0 })
					self._activeTweens[sound] = fadeOutTween

					fadeOutTween.Completed:Connect(function()
						if self._activeTweens[sound] == fadeOutTween then
							self._activeTweens[sound] = nil
						end
						if self._transitionToken == thisToken and sound ~= self._currentSound then
							pcall(function()
								sound:Stop()
							end)
						end
						fadeOutTween:Destroy()
					end)

					fadeOutTween:Play()
				else
					sound.Volume = 0
					pcall(function()
						sound:Stop()
					end)
				end
			end
		end
	end

	-- 2. Fade In del nuevo sonido si existe
	if newSound then
		self:_cancelTweenForSound(newSound)

		local targetVol = self:_getTargetVolume(newSound)

		if self._musicEnabled and targetVol > 0 then
			newSound.Looped = true
			if not newSound.IsPlaying then
				newSound.Volume = 0
				pcall(function()
					newSound:Play()
				end)
			end

			if duration > 0 then
				local tweenInfo = TweenInfo.new(duration, FADE_EASING_STYLE, FADE_EASING_DIR)
				local fadeInTween = TweenService:Create(newSound, tweenInfo, { Volume = targetVol })
				self._activeTweens[newSound] = fadeInTween

				fadeInTween.Completed:Connect(function()
					if self._activeTweens[newSound] == fadeInTween then
						self._activeTweens[newSound] = nil
					end
					fadeInTween:Destroy()
				end)

				fadeInTween:Play()
			else
				newSound.Volume = targetVol
			end
		else
			-- Música deshabilitada o target volume = 0
			newSound.Volume = 0
			if newSound.IsPlaying then
				pcall(function()
					newSound:Stop()
				end)
			end
		end
	end
end

--------------------------------------------------------------------------------
-- API Pública
--------------------------------------------------------------------------------
-- API Pública y Gestión de Suspensión
--------------------------------------------------------------------------------

function MusicController:_getMatchController()
	if self._context and typeof(self._context.GetController) == "function" then
		return self._context:GetController("MatchController")
	end
	local controllers = script.Parent
	local matchScript = controllers and controllers:FindFirstChild("MatchController")
	if matchScript and matchScript:IsA("ModuleScript") then
		local ok, mod = pcall(require, matchScript)
		if ok then return mod end
	end
	return nil
end

function MusicController:_getMatchmakingController()
	if self._context and typeof(self._context.GetController) == "function" then
		return self._context:GetController("MatchmakingController")
	end
	local controllers = script.Parent
	local mmScript = controllers and controllers:FindFirstChild("MatchmakingController")
	if mmScript and mmScript:IsA("ModuleScript") then
		local ok, mod = pcall(require, mmScript)
		if ok then return mod end
	end
	return nil
end

function MusicController:IsSuspended(reason: string?): boolean
	if reason then
		return self._suspensions[reason] ~= nil
	end
	for _ in pairs(self._suspensions) do
		return true
	end
	return false
end

function MusicController:Suspend(reason: string?, fadeDuration: number?): number
	local r = reason or "Default"
	self._suspensionTokenCounter += 1
	local token = self._suspensionTokenCounter

	local record = self._suspensions[r]
	if not record then
		self._suspensions[r] = {
			Token = token,
			PreviousState = self._currentState,
			PreviousMap = self._currentMapName,
			PreviousSound = self._currentSound,
		}
	else
		record.Token = token
	end

	local duration = if fadeDuration ~= nil then fadeDuration else 0.4
	self:_transitionTo(nil, "None", duration)
	print(string.format("[MusicController] Música suspendida por '%s' (Token=%d, Fade=%.2fs)", r, token, duration))
	return token
end

function MusicController:Resume(reason: string?, token: number?, restoreFadeDuration: number?): boolean
	local r = reason or "Default"
	local record = self._suspensions[r]
	if not record then
		return false
	end

	if token ~= nil and record.Token ~= token then
		-- Token desactualizado: pertenece a una ejecución anterior ya superada
		return false
	end

	local previousState = record.PreviousState
	local previousMap = record.PreviousMap
	self._suspensions[r] = nil
	print(string.format("[MusicController] Suspensión '%s' liberada", r))

	if self:IsSuspended() then
		return true
	end

	local duration = if restoreFadeDuration ~= nil then restoreFadeDuration else 0.6
	local pending = self._pendingMusicState
	self._pendingMusicState = nil

	if pending and pending.State ~= "None" then
		local pDuration = pending.FadeDuration or duration
		if pending.State == "Lobby" then
			self:PlayLobby(pDuration)
		elseif pending.State == "Matchmaking" then
			self:PlayMatchmaking(pDuration)
		elseif pending.State == "Arena" and pending.MapName then
			self:PlayArena(pending.MapName, pDuration)
		end
	elseif r == "EndCinematicPreview" then
		if previousState == "Lobby" then
			self:PlayLobby(duration)
		elseif previousState == "Matchmaking" then
			self:PlayMatchmaking(duration)
		elseif (previousState == "Arena" or previousState == "SuddenDeath") and previousMap then
			self:PlayArena(previousMap, duration)
		else
			self:Stop(duration)
		end
	else
		local inMatch = false
		local matchController = self:_getMatchController()
		if matchController and typeof(matchController.IsParticipant) == "function" then
			inMatch = matchController:IsParticipant()
		end
		if Players.LocalPlayer and Players.LocalPlayer:GetAttribute("MatchId") ~= nil then
			inMatch = true
		end

		local mmController = self:_getMatchmakingController()
		local inQueue = mmController and typeof(mmController.IsInQueue) == "function" and mmController:IsInQueue()

		if inMatch then
			local selectedMap = matchController and matchController:GetCurrentSelectedMap() or "Default"
			self:PlayArena(selectedMap, duration)
		elseif inQueue then
			self:PlayMatchmaking(duration)
		else
			self:PlayLobby(duration)
		end
	end

	return true
end

-- Shares the existing music mixer, preferences and cinematic suspension priority.
function MusicController:_playSuddenDeath(fadeDuration: number?): boolean
 if self:IsSuspended() then return false end
 local sound=self:_getSoundInstance(Config.SuddenDeathPresentation.MusicSoundName)
 if not sound or sound.SoundId=="" then
  if not self._suddenAudioWarning then warn("[MusicController] Authorized SuddenDeath SoundId missing; arena music retained");self._suddenAudioWarning=true end
  return false
 end
 if self._currentState~="SuddenDeath" or self._currentSound~=sound or not sound.IsPlaying then
  self:_transitionTo(sound,"SuddenDeath",fadeDuration)
 end
 return true
end
function MusicController:SetSuddenDeath(active: boolean,mapName: string?,restoreArena: boolean?)
 self._suddenDeathActive=active
 if mapName then self._currentMapName=mapName end
 if self:IsSuspended() then return end
 if active then
  self:_playSuddenDeath(Config.SuddenDeathPresentation.TransitionDuration)
 elseif restoreArena and self._currentMapName then
  self:PlayArena(self._currentMapName,Config.SuddenDeathPresentation.TransitionDuration)
 end
end

function MusicController:PlayLobby(fadeDuration: number?)
	self._suddenDeathActive=false
	if self:IsSuspended() then
		self._pendingMusicState = { State = "Lobby", MapName = nil, FadeDuration = fadeDuration }
		print("[MusicController] PlayLobby recibido durante suspensión; encolado")
		return
	end

	local lobbySound = self:_getSoundInstance("Lobby")
	if self._currentState == "Lobby" and self._currentSound == lobbySound and lobbySound and lobbySound.IsPlaying then
		return
	end

	self._currentMapName = nil
	self:_transitionTo(lobbySound, "Lobby", fadeDuration)
	print("[MusicController] Reproduciendo música de Lobby")
end

function MusicController:PlayMatchmaking(fadeDuration: number?)
	self._suddenDeathActive=false
	if self:IsSuspended() then
		self._pendingMusicState = { State = "Matchmaking", MapName = nil, FadeDuration = fadeDuration }
		print("[MusicController] PlayMatchmaking recibido durante suspensión; encolado")
		return
	end

	local mmSound = self:_getSoundInstance("Matchmaking")
	if self._currentState == "Matchmaking" and self._currentSound == mmSound and mmSound and mmSound.IsPlaying then
		return
	end

	self._currentMapName = nil
	self:_transitionTo(mmSound, "Matchmaking", fadeDuration)
	print("[MusicController] Reproduciendo música de Matchmaking")
end

function MusicController:PlayArena(mapName: string, fadeDuration: number?)
	if self:IsSuspended() then
		self._pendingMusicState = { State = "Arena", MapName = mapName, FadeDuration = fadeDuration }
		print(string.format("[MusicController] PlayArena(%s) recibido durante suspensión; encolado", mapName))
		return
	end

	self._currentMapName=mapName
	if self._suddenDeathActive and self:_playSuddenDeath(fadeDuration) then return end
	local arenaSound = self:_getArenaSound(mapName)
	if self._currentState == "Arena" and self._currentMapName == mapName and self._currentSound == arenaSound and arenaSound and arenaSound.IsPlaying then
		return
	end

	self._currentMapName = mapName
	if not arenaSound then
		warn(string.format("[MusicController] No se encontro musica para la arena '%s'. Permaneciendo en silencio.", mapName))
		self:_transitionTo(nil, "Arena", fadeDuration)
		return
	end

	self:_transitionTo(arenaSound, "Arena", fadeDuration)
	print(string.format("[MusicController] Reproduciendo música de Arena: %s", mapName))
end

function MusicController:Stop(fadeDuration: number?)
	if self:IsSuspended() then
		self._pendingMusicState = { State = "None", MapName = nil, FadeDuration = fadeDuration }
		return
	end

	self._currentMapName = nil
	self:_transitionTo(nil, "None", fadeDuration)
	print("[MusicController] Música detenida")
end

function MusicController:SetMusicEnabled(enabled: boolean, fadeDuration: number?)
	if self._musicEnabled == enabled then return end
	self._musicEnabled = enabled
	print(string.format("[MusicController] MusicEnabled establecido en %s", tostring(enabled)))

	if self:IsSuspended() then
		return
	end

	local duration = if fadeDuration ~= nil then fadeDuration else 0.4

	if not enabled then
		-- Desvanecer suavemente la pista actual a 0 y pausar
		if self._currentSound and self._currentSound.IsPlaying then
			self:_cancelTweenForSound(self._currentSound)
			if duration > 0 then
				local tweenInfo = TweenInfo.new(duration, FADE_EASING_STYLE, FADE_EASING_DIR)
				local muteTween = TweenService:Create(self._currentSound, tweenInfo, { Volume = 0 })
				self._activeTweens[self._currentSound] = muteTween
				local soundRef = self._currentSound
				muteTween.Completed:Connect(function()
					if self._activeTweens[soundRef] == muteTween then
						self._activeTweens[soundRef] = nil
					end
					if not self._musicEnabled and soundRef then
						soundRef:Stop()
					end
					muteTween:Destroy()
				end)
				muteTween:Play()
			else
				self._currentSound.Volume = 0
				self._currentSound:Stop()
			end
		end
	else
		-- Reanudar o fade in hacia el volumen objetivo
		if self._currentSound then
			local targetVol = self:_getTargetVolume(self._currentSound)
			if targetVol > 0 then
				if not self._currentSound.IsPlaying then
					self._currentSound.Volume = 0
					self._currentSound:Play()
				end
				self:_cancelTweenForSound(self._currentSound)
				if duration > 0 then
					local tweenInfo = TweenInfo.new(duration, FADE_EASING_STYLE, FADE_EASING_DIR)
					local resumeTween = TweenService:Create(self._currentSound, tweenInfo, { Volume = targetVol })
					self._activeTweens[self._currentSound] = resumeTween
					local soundRef = self._currentSound
					resumeTween.Completed:Connect(function()
						if self._activeTweens[soundRef] == resumeTween then
							self._activeTweens[soundRef] = nil
						end
						resumeTween:Destroy()
					end)
					resumeTween:Play()
				else
					self._currentSound.Volume = targetVol
				end
			end
		else
			-- Si no había un track reproduciendo, volver al estado actual
			if self._currentState == "Lobby" then
				self:PlayLobby(duration)
			elseif self._currentState == "Matchmaking" then
				self:PlayMatchmaking(duration)
			elseif self._currentState == "SuddenDeath" then
				self:_playSuddenDeath(duration)
			elseif self._currentState == "Arena" and self._currentMapName then
				self:PlayArena(self._currentMapName, duration)
			end
		end
	end
end

function MusicController:SetMusicVolume(volume: number, fadeDuration: number?)
	local clamped = math.clamp(volume, 0, 1)
	self._userMusicVolume = clamped
	print(string.format("[MusicController] MusicVolume establecido en %.2f", clamped))

	local duration = if fadeDuration ~= nil then fadeDuration else 0.2

	if self._currentSound and self._currentSound.IsPlaying and self._musicEnabled then
		local targetVol = self:_getTargetVolume(self._currentSound)
		self:_cancelTweenForSound(self._currentSound)
		if duration > 0 then
			local tweenInfo = TweenInfo.new(duration, FADE_EASING_STYLE, FADE_EASING_DIR)
			local volTween = TweenService:Create(self._currentSound, tweenInfo, { Volume = targetVol })
			self._activeTweens[self._currentSound] = volTween
			local soundRef = self._currentSound
			volTween.Completed:Connect(function()
				if self._activeTweens[soundRef] == volTween then
					self._activeTweens[soundRef] = nil
				end
				volTween:Destroy()
			end)
			volTween:Play()
		else
			self._currentSound.Volume = targetVol
		end
	end
end

function MusicController:GetCurrentState(): string
	return self._currentState
end

function MusicController:GetCurrentMapName(): string?
	return self._currentMapName
end

function MusicController:IsMusicEnabled(): boolean
	return self._musicEnabled
end

function MusicController:GetMusicVolume(): number
	return self._userMusicVolume
end

function MusicController:GetCurrentSound(): Sound?
	return self._currentSound
end

--------------------------------------------------------------------------------
-- Ciclo de Vida Bootstrap
--------------------------------------------------------------------------------

function MusicController:Init(context: any)
	self._context = context
	self._suspensions = {}
	self._suspensionTokenCounter = 0
	self._pendingMusicState = nil
	self:_cacheAllSounds()
	print("[MusicController] Inicializado exitosamente")
end

function MusicController:Start(context: any)
	self._context = context

	-- Sincronización inicial segura
	local matchController = context and context:GetController("MatchController")
	local mmController = context and context:GetController("MatchmakingController")

	local inMatch = matchController and typeof(matchController.IsParticipant) == "function" and matchController:IsParticipant()
	local inQueue = mmController and typeof(mmController.IsInQueue) == "function" and mmController:IsInQueue()

	if inMatch then
		local selectedMap = matchController:GetCurrentSelectedMap() or "Default"
		self:PlayArena(selectedMap)
	elseif inQueue then
		self:PlayMatchmaking()
	else
		-- Estado predeterminado al entrar al juego
		self:PlayLobby()
	end

	print(string.format("[MusicController] Iniciado en estado: %s", self._currentState))
end

return MusicController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1799">
          <Properties>
            <string name="Name">PlayerHUDController</string>
            <string name="Source"><![CDATA[--!strict
-- PlayerHUDController
-- Controlador del HUD global del jugador (Avatar, Nombre, Coins, Wins, Losses).
-- Se enlaza con StarterGui.PlayerHUD (replicado a PlayerGui.PlayerHUD)
-- y escucha las actualizaciones autoritativas emitidas por PlayerService.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Types = require(ReplicatedStorage.Shared.Types)

type PlayerData = Types.PlayerData

local localPlayer = Players.LocalPlayer

local PlayerHUDController = {}
PlayerHUDController.Name = "PlayerHUDController"

-- Referencias a instancias de PlayerGui.PlayerHUD
PlayerHUDController._hud = nil :: ScreenGui?
PlayerHUDController._profileCard = nil :: Frame?
PlayerHUDController._avatar = nil :: ImageLabel?
PlayerHUDController._playerName = nil :: TextLabel?
PlayerHUDController._winsLabel = nil :: TextLabel?
PlayerHUDController._lossesLabel = nil :: TextLabel?
PlayerHUDController._killsLabel = nil :: TextLabel?
PlayerHUDController._coinsContainer = nil :: Frame?
PlayerHUDController._coinsLabel = nil :: TextLabel?

-- Estado interno
PlayerHUDController._currentCoins = 0
PlayerHUDController._currentWins = 0
PlayerHUDController._currentLosses = 0
PlayerHUDController._currentKills = 0
PlayerHUDController._coinTween = nil :: Tween?
PlayerHUDController._coinAnimValue = nil :: NumberValue?
PlayerHUDController._origCoinsContainerSize = nil :: UDim2?

function PlayerHUDController:Init(context: any)
	self:_bindHUD()
end

function PlayerHUDController:Start(context: any)
	self:_setupIdentity()
	self:_connectRemotes()
	print("[PlayerHUDController] HUD global iniciado y enlazado a PlayerGui.PlayerHUD")
end

function PlayerHUDController:_bindHUD()
	local playerGui = localPlayer:WaitForChild("PlayerGui")
	local hud = playerGui:WaitForChild("PlayerHUD", 15) :: ScreenGui?
	if not hud then
		warn("[PlayerHUDController] No se encontro PlayerHUD en PlayerGui")
		return
	end
	self._hud = hud

	local profileCard = hud:WaitForChild("ProfileCard", 10) :: Frame?
	if not profileCard then
		warn("[PlayerHUDController] No se encontro ProfileCard en PlayerHUD")
		return
	end
	self._profileCard = profileCard

	self._avatar = profileCard:FindFirstChild("Avatar") :: ImageLabel?
	self._playerName = profileCard:FindFirstChild("PlayerName") :: TextLabel?
	self._winsLabel = profileCard:FindFirstChild("WinsLabel") :: TextLabel?
	self._lossesLabel = profileCard:FindFirstChild("LossesLabel") :: TextLabel?
	self._killsLabel = profileCard:FindFirstChild("KillsLabel") :: TextLabel?

	local coinsContainer = profileCard:FindFirstChild("CoinsContainer") :: Frame?
	if coinsContainer then
		self._coinsContainer = coinsContainer
		self._origCoinsContainerSize = coinsContainer.Size
		self._coinsLabel = coinsContainer:FindFirstChild("CoinsLabel") :: TextLabel?
	end

	-- NumberValue auxiliar para interpolación suave de Coins
	local animVal = Instance.new("NumberValue")
	animVal.Value = 0
	animVal.Changed:Connect(function(val: number)
		if self._coinsLabel then
			self._coinsLabel.Text = string.format("%d", math.floor(val + 0.5))
		end
	end)
	self._coinAnimValue = animVal
end

function PlayerHUDController:_setupIdentity()
	-- Nombre del jugador
	if self._playerName then
		self._playerName.Text = localPlayer.DisplayName or localPlayer.Name
	end

	-- Avatar circular del jugador usando thumbnail oficial de Roblox
	if self._avatar then
		local thumbType = Enum.ThumbnailType.HeadShot
		local thumbSize = Enum.ThumbnailSize.Size150x150
		task.spawn(function()
			local content, isReady = Players:GetUserThumbnailAsync(localPlayer.UserId, thumbType, thumbSize)
			if self._avatar then
				self._avatar.Image = content
			end
		end)
	end

	-- Estado inicial por defecto en UI
	self:_renderData({
		Coins = self._currentCoins,
		Wins = self._currentWins,
		Losses = self._currentLosses,
	}, false)
end

function PlayerHUDController:_connectRemotes()
	local remotesFolder = ReplicatedStorage:WaitForChild("Remotes", 10)
	if not remotesFolder then
		warn("[PlayerHUDController] Carpeta Remotes no encontrada en ReplicatedStorage")
		return
	end

	local playerRemotes = remotesFolder:WaitForChild("Player", 10)
	if not playerRemotes then
		warn("[PlayerHUDController] Carpeta Remotes.Player no encontrada")
		return
	end

	local dataUpdated = playerRemotes:WaitForChild("DataUpdated", 10) :: RemoteEvent?
	if not dataUpdated then
		warn("[PlayerHUDController] RemoteEvent DataUpdated no encontrado")
		return
	end

	dataUpdated.OnClientEvent:Connect(function(data: PlayerData)
		if type(data) ~= "table" then
			return
		end
		self:_renderData(data, true)
	end)
end

function PlayerHUDController:_renderData(data: PlayerData, animateChanges: boolean)
	local newCoins = if typeof(data.Coins) == "number" then data.Coins else self._currentCoins
	local newWins = if typeof(data.Wins) == "number" then data.Wins else self._currentWins
	local newLosses = if typeof(data.Losses) == "number" then data.Losses else self._currentLosses
	local newKills = if typeof(data.Kills) == "number" then data.Kills else self._currentKills

	-- Actualizar Wins
	if self._winsLabel then
		self._winsLabel.Text = string.format("Wins: %d", newWins)
	end
	self._currentWins = newWins

	-- Actualizar Losses
	if self._lossesLabel then
		self._lossesLabel.Text = string.format("Losses: %d", newLosses)
	end
	self._currentLosses = newLosses

	-- Actualizar Kills (si KillsLabel existe en la UI)
	if self._killsLabel then
		self._killsLabel.Text = string.format("Kills: %d", newKills)
	end
	self._currentKills = newKills

	-- Actualizar Coins con animación si aumenta
	local oldCoins = self._currentCoins
	self._currentCoins = newCoins

	if animateChanges and newCoins > oldCoins and self._coinAnimValue and self._coinsLabel then
		self:_animateCoinsIncrease(oldCoins, newCoins)
	else
		if self._coinAnimValue then
			self._coinAnimValue.Value = newCoins
		end
		if self._coinsLabel then
			self._coinsLabel.Text = string.format("%d", newCoins)
		end
	end
end

function PlayerHUDController:_animateCoinsIncrease(fromVal: number, toVal: number)
	if not self._coinAnimValue then
		return
	end

	if self._coinTween then
		self._coinTween:Cancel()
		self._coinTween = nil
	end

	self._coinAnimValue.Value = fromVal

	-- Interpolación de número durante 0.25 segundos
	local tweenInfo = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local tween = TweenService:Create(self._coinAnimValue, tweenInfo, { Value = toVal })
	self._coinTween = tween
	tween:Play()

	-- Feedback visual sutil (pulse) en CoinsContainer
	if self._coinsContainer and self._origCoinsContainerSize then
		local origSize = self._origCoinsContainerSize
		local popSize = UDim2.new(
			origSize.X.Scale,
			origSize.X.Offset + 8,
			origSize.Y.Scale,
			origSize.Y.Offset + 4
		)

		local popTween = TweenService:Create(
			self._coinsContainer,
			TweenInfo.new(0.12, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
			{ Size = popSize }
		)
		local returnTween = TweenService:Create(
			self._coinsContainer,
			TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
			{ Size = origSize }
		)

		popTween.Completed:Connect(function()
			returnTween:Play()
		end)
		popTween:Play()
	end
end

return PlayerHUDController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1800">
          <Properties>
            <string name="Name">PremiumShopController</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Binds permanent Edit templates. Never grants currency/items or acknowledges receipts.
local Players=game:GetService("Players");local RS=game:GetService("ReplicatedStorage")
local Tween=game:GetService("TweenService");local Marketplace=game:GetService("MarketplaceService")
local Player=Players.LocalPlayer
local PurchaseFlow=require(script.Parent.Parent.PremiumShop.PremiumPurchaseFlow)
local Reserved=require(RS.Shared.PremiumShop.PlaceholderProductIds)
local Controller={}
local messages={PurchasesDisabled="Compras con Robux deshabilitadas.",ContentsPending="Contenido pendiente de aprobación.",ProductIdPending="Producto Roblox sin configurar.",
 DuplicatePolicyPending="Política de duplicados pendiente.",ApprovalPending="Venta pendiente de aprobación.",ProductDisabled="Producto deshabilitado.",DurableBackendPending="Persistencia durable pendiente.",
 PaidRandomItemsRestricted="Artículos aleatorios pagados restringidos por Roblox.",PolicyUnavailable="No se pudo verificar elegibilidad.",CommercialApprovalPending="Probabilidades y venta pendientes.",RateLimited="Esperá un momento y reintentá.",
 PlaceholderProduct="No configurado: ProductId provisional.",TestingEnvironment="Entorno de prueba: sin cobros.",TestingOrUnapprovedEnvironment="Entorno sin compras productivas.",
 ProfileLifecycleIntegrationPending="Integración durable de perfiles pendiente.",PriceUnavailable="Precio de Roblox no disponible.",PriceChanged="Cambió el precio: revisalo antes de volver a comprar.",
 ViewOddsFirst="Consultá las probabilidades actuales antes de comprar.",OddsChanged="Cambió el stock o la probabilidad. Volvé a consultar.",PersistenceTemporaryError="Error temporal de persistencia; la compra sigue pendiente."}
local categories={{"Coins","COINS","C"},{"Combos","COMBOS","★"},{"PremiumCrates","CAJAS PREMIUM","▣"}}
function Controller:Init(context)self.Context=context;self.Connections={};self.Cards={};self.CardConnections={};self.Opened=false;self.Generation=0;self.Category="Coins"end
function Controller:IsBlocked()
 local ending=self.Context:GetController("EndCinematicController");local opening=self.Context:GetController("CrateStandCinematicController")
 return Player:GetAttribute("MatchId")~=nil or Player:GetAttribute("ResultsSessionId")~=nil
  or ending and ending:IsPlaying()or opening and opening:IsPlaying()
end
function Controller:_call(action,args)
 if not self.Request then return {Ok=false,Code="NoResponse"}end
 local ok,result=pcall(self.Request.InvokeServer,self.Request,action,args or {})
 return if ok and type(result)=="table"then result else {Ok=false,Code="NoResponse"}
end
function Controller:_preview(viewport,product)
 local world=viewport:FindFirstChildWhichIsA("WorldModel");local camera=viewport:FindFirstChildWhichIsA("Camera")
 if not world or not camera then return end
 for _,obj in ipairs(world:GetChildren())do obj:Destroy()end
 local folder=RS:FindFirstChild("PremiumShopPreviews")
 local modelName=product.PreviewModel or(if product.Category=="Coins"then "CoinsDisplay"else "ComboDisplay")
 local source=(folder and folder:FindFirstChild(modelName))or RS.CrateEffects:FindFirstChild(modelName)
 if not source then return end
 local model=source:Clone()
 for _,obj in ipairs(model:GetDescendants())do
  if obj:IsA("BasePart")then obj.Anchored=true;obj.CanCollide=false;obj.CanTouch=false;obj.CanQuery=false
  elseif obj:IsA("LuaSourceContainer")then obj:Destroy()end
 end
 model.Parent=world;model:PivotTo(CFrame.new())
 local extent=model:GetExtentsSize();local size=math.max(extent.X,extent.Y,extent.Z)
 local aspect=math.max(.5,viewport.AbsoluteSize.X/math.max(1,viewport.AbsoluteSize.Y))
 camera.FieldOfView=35;camera.CFrame=CFrame.lookAt(Vector3.new(size*.8,size*.55,size*2.1/math.min(1,aspect)),Vector3.zero)
 viewport.CurrentCamera=camera
end
function Controller:_clear()
 for _,c in ipairs(self.CardConnections)do c:Disconnect()end;table.clear(self.CardConnections)
 for _,c in ipairs(self.Cards)do c:Destroy()end;table.clear(self.Cards)
end
function Controller:_layout()
 if not self.Main then return end
 local width=self.Main.AbsoluteSize.X
 local grid=self.Main.Catalog.UIGridLayout
 grid.CellSize=UDim2.new(if width<620 then 1 else .49,if width<620 then -4 else -6,0,224)
 for _,tab in ipairs(self.Main.Tabs:GetChildren())do if tab:IsA("TextButton")then tab.TextSize=if width<480 then 11 else 14 end end
end
function Controller:_render()
 if not self.Main then return end;self:_clear()
 local count=0
 for _,product in ipairs(self.Products or {})do if product.Category==self.Category then
  count+=1;local card=self.Main.Catalog.ProductCardTemplate:Clone();card.Name="Product_"..product.Id;card.LayoutOrder=count;card.Visible=true
  card.Title.Text=product.DisplayName;card.Description.Text=product.Description
  card.Content.Text=if product.Category=="Coins"then(if product.Rewards.Coins>0 then tostring(product.Rewards.Coins).." COINS"else "CANTIDAD PENDIENTE")else(if product.Category=="Combos"then "VER CONTENIDO GARANTIZADO"else "MODELO PROVISIONAL · ODDS PENDIENTES")
  card.Price.Text=if product.PriceRobux~=nil then tostring(product.PriceRobux).." ROBUX"else "ROBUX · SIN CONFIGURAR"
  card.Status.Text=messages[product.ConfigurationStatus]or messages[product.Status]or "Venta no habilitada"
  card.Buy.Active=product.PurchaseAllowed==true and product.PriceRobux~=nil;card.Buy.AutoButtonColor=card.Buy.Active
  card.Buy.Text=if card.Buy.Active then "COMPRAR"else "COMPRAR · BLOQUEADO"
  card.Buy.BackgroundTransparency=if card.Buy.Active then 0 else .5
  card.Parent=self.Main.Catalog;table.insert(self.Cards,card);self:_preview(card.Preview,product)
  table.insert(self.CardConnections,card.Activated:Connect(function()self:Details(product)end))
  table.insert(self.CardConnections,card.Buy.Activated:Connect(function()self:Details(product)end))
 end end
 self.Main.Empty.Visible=count==0
 for _,row in ipairs(categories)do local tab=self.Main.Tabs[row[1]];tab.BackgroundColor3=if self.Category==row[1]then Color3.fromRGB(94,54,176)else Color3.fromRGB(20,28,58)end
 self:_layout()
end
local function contents(product)
 local r=product.Rewards;local lines={}
 if r.Coins>0 then table.insert(lines,tostring(r.Coins).." Coins garantizadas")end
 for _,item in ipairs(r.Crates)do table.insert(lines,tostring(item.Quantity).." × caja "..item.CrateId.." cerrada (contenido aleatorio)")end
 for _,item in ipairs(r.Slaps)do table.insert(lines,"Slap garantizado: "..item.SlapId.." ["..item.VariationId.."]")end
 for _,id in ipairs(r.KillEffects)do table.insert(lines,"Kill Effect garantizado: "..id)end
 if #lines==0 then table.insert(lines,"Contenidos sin configurar. Este borrador no se puede comprar.")end
 table.insert(lines,"\nDuplicados: "..(({OncePerPlayer="compra única por jugador",RestrictOwned="bloqueado si ya poseés un premio permanente",RepeatableNoCompensation="repetible; sin compensación por duplicados",Unspecified="política pendiente"})[product.DuplicatePolicy]or "política pendiente"))
 if product.HasRandomContents then table.insert(lines,"\n"..product.OddsNotice)end
 if product.SuggestedRobux then table.insert(lines,"\nPrecio sugerido para Creator Hub: "..product.SuggestedRobux.." Robux. NO es el precio de compra; Roblox determina el precio real.")end
 return table.concat(lines,"\n")
end
function Controller:Details(product)
 if product.HasRandomContents then product.QuoteTokens=nil end
 self.Selected=product;local details=self.Main.Details;details.Visible=true
 details.Title.Text=product.DisplayName;details.Scroll.Content.Text=contents(product)
 details.Status.Text=messages[product.ConfigurationStatus]or messages[product.Status]or "Venta no habilitada"
 details.Buy.Text=if product.PriceRobux then "COMPRAR · "..product.PriceRobux.." ROBUX"else "COMPRAR · PRODUCTO SIN CONFIGURAR"
 details.Buy.Active=product.PurchaseAllowed==true and product.PriceRobux~=nil and(not product.HasRandomContents or product.QuoteTokens~=nil)and not(self.Flow and(self.Flow.Pending or self.Flow.Busy));details.Buy.AutoButtonColor=details.Buy.Active;details.Buy.BackgroundTransparency=if details.Buy.Active then 0 else .55
 details.ViewCrate.Visible=product.CrateId~=nil;details.ViewCrate.Text="VER INVENTARIO / APERTURA"
 local token=self.Generation
 if product.HasRandomContents then task.spawn(function()
  task.wait(.55);if token~=self.Generation or self.Selected~=product or not self.Opened then return end
  local result=self:_call("Odds",{Id=product.Id})
  if token~=self.Generation or self.Selected~=product or not self.Opened then return end
  local lines={contents(product),"\nPROBABILIDADES ACTUALES POR RECOMPENSA"}
  if result.Ok then
   local tokens={};local valid=true
   for crateId,quote in pairs(result.Quotes)do
    table.insert(lines,"\n"..crateId)
    if quote.Ok then
     tokens[crateId]=quote.Token
     for _,outcome in ipairs(quote.Outcomes)do table.insert(lines,string.format("%s: %.8g %%",outcome.DisplayName,outcome.Percent))end
     for _,excluded in ipairs(quote.ExcludedOutcomes or {})do table.insert(lines,excluded.DisplayName..": excluido ("..excluded.Reason..")")end
    else valid=false;table.insert(lines,messages[quote.Code]or quote.Code)end
   end
   product.QuoteTokens=if valid and next(tokens)then tokens else nil
   details.Buy.Active=product.PurchaseAllowed==true and product.PriceRobux~=nil and product.QuoteTokens~=nil and not self.Flow.Pending
  else table.insert(lines,messages[result.Code]or "No se pudo consultar. Reabrí el detalle para reintentar.")end
  details.Scroll.Content.Text=table.concat(lines,"\n")
 end)end
end
function Controller:Open()
 if not self.Main or self:IsBlocked()then return end
 self.Generation+=1;local token=self.Generation;self.Opened=true
 local shop=self.Context:GetController("ShopController");if shop then shop:Close()end
 local crate=self.Context:GetController("CrateController");if crate and crate._panel then crate._panel.Visible=false end
 self.Hud.Enabled=true;self.Main.Visible=true;self.Main.Details.Visible=false;self.Main.OpenScale.Scale=.94
 Tween:Create(self.Main.OpenScale,TweenInfo.new(.18,Enum.EasingStyle.Quad),{Scale=1}):Play()
 self.Main.Banner.Text="Cargando catálogo…"
 task.spawn(function()
  local result=self:_call("Catalog")
  if token~=self.Generation or not self.Opened then return end
  if not result.Ok then self.Main.Banner.Text=messages[result.Code]or "Catálogo no disponible. Cerrá y reintentá.";return end
  self.Products=result.Products;self.CrateProducts=result.CrateProducts;self.Category=result.DefaultCategory or "Coins"
  self.Main.Banner.Text=if result.PurchasesEnabled then "TIENDA PREMIUM · PRECIOS DE ROBLOX"else "VISTA PREVIA · COMPRAS ROBUX DESHABILITADAS"
  if not result.Policy.RandomAllowed then self.Main.Banner.Text..=" · Aleatorios restringidos o sin verificar"end
  self:_render()
  for _,p in ipairs(self.Products)do
   if p.CommercialVerified and p.IsPlaceholder==false then
    local price,why=self.Flow:Price(p);p.PriceRobux=price
    if not price then p.PurchaseAllowed=false;p.Status=why;warn("[PremiumShop] Precio no disponible: "..p.Id)end
   end
  end
  if token~=self.Generation or not self.Opened then return end
  self:_render();task.wait(.55)
  local status=self:_call("Status");if status.Ok then self.Flow:Status(status.Receipts or {})end
 end)
end
function Controller:Close()
 if self.Flow then self.Flow:CancelAuthorization()end
 self.Generation+=1;self.Opened=false;self.Selected=nil;self:_clear()
 if self.Hud then self.Hud.Enabled=false;self.Main.Visible=false;self.Main.Details.Visible=false end
end
function Controller:_purchaseState(state,extra)
 local labels={Processing="Consultando compra…",Purchasing="Comprando…",AwaitingConfirmation="Esperando confirmación del servidor…",Credited="Compra acreditada por el servidor.",TemporaryError="Error temporal.",Restricted="Producto restringido.",Available="Disponible.",Unavailable="No disponible."}
 if not self.Main then return end
 local text=labels[state]or state
 if type(extra)=="string"and messages[extra]then text..=" "..messages[extra]end
 self.Main.Banner.Text=text
 if self.Selected and(self.Selected.Id==self.BuyingKey or state=="Credited"and self.Selected.Id==extra)then
  self.Main.Details.Status.Text=text
  if state=="Purchasing"and type(extra)=="number"then self.Main.Details.Buy.Text="COMPRAR · "..extra.." ROBUX"end
  if state=="Credited"and self.Selected.DuplicatePolicy~="RepeatableNoCompensation"then self.Selected.PurchaseAllowed=false end
  if extra=="PriceChanged"and self.Selected.PriceRobux then self.Main.Details.Buy.Text="COMPRAR · "..self.Selected.PriceRobux.." ROBUX"end
  self.Main.Details.Buy.Active=(state=="Available"or state=="Credited"or state=="TemporaryError")and self.Selected.PurchaseAllowed==true and self.Selected.PriceRobux~=nil and not(self.Flow.Pending or self.Flow.Busy)
 end
end
function Controller:_pollReceipt()
 if self.Polling then return end;self.Polling=true
 task.spawn(function()
  for _=1,20 do
   task.wait(2);if self.Destroyed or not self.Flow.Pending then break end
   local status=self:_call("Status");if status.Ok then self.Flow:Status(status.Receipts or {})end
  end
  self.Polling=false
 end)
end
function Controller:Start()
 task.spawn(function()
  local pg=Player:WaitForChild("PlayerGui");self.Hud=pg:WaitForChild("PremiumShopHUD",15)
  local mainHUD=pg:WaitForChild("PlayerHUD",15);local remote=RS:WaitForChild("Remotes"):WaitForChild("PremiumShop",15)
  if not self.Hud or not mainHUD or not remote then warn("[PremiumShop] Missing Edit resources");return end
  self.Request=remote:WaitForChild("Request",15);self.Main=self.Hud.MainFrame
  self.Flow=PurchaseFlow.new(Marketplace,Player,function(action,args)return self:_call(action,args)end,function(state,extra)self:_purchaseState(state,extra)end,nil,Reserved)
  local delivery=remote:WaitForChild("Delivery",15)
  if delivery then table.insert(self.Connections,delivery.OnClientEvent:Connect(function(receipt)self.Flow:Delivery(receipt)end))end
  table.insert(self.Connections,Marketplace.PromptProductPurchaseFinished:Connect(function(uid,pid,bought)self.Flow:PromptClosed(uid,pid,bought)end))
  self:Close()
  local button=mainHUD:WaitForChild("PremiumShopButton",15);if not button then return end
  table.insert(self.Connections,button.Activated:Connect(function()if self.Opened then self:Close()else self:Open()end end))
  table.insert(self.Connections,self.Main.Close.Activated:Connect(function()self:Close()end))
  table.insert(self.Connections,self.Main.Details.Close.Activated:Connect(function()self.Main.Details.Visible=false;self.Selected=nil end))
  for _,row in ipairs(categories)do table.insert(self.Connections,self.Main.Tabs[row[1]].Activated:Connect(function()self.Category=row[1];self.Main.Details.Visible=false;self:_render()end))end
  table.insert(self.Connections,self.Main.Details.Buy.Activated:Connect(function()
   local p=self.Selected;if not p or not p.PurchaseAllowed or self:IsBlocked()or self.Purchasing then return end
   self.Purchasing=true;self.BuyingKey=p.Id
   task.spawn(function()
    self.Flow:Begin(p);self.Purchasing=false
    if self.Flow.Pending then self:_pollReceipt()end
   end)
  end))
  table.insert(self.Connections,self.Main.Details.ViewCrate.Activated:Connect(function()
   local p=self.Selected;local crate=self.Context:GetController("CrateController");if not p or not p.CrateId or not crate or self:IsBlocked()then return end
   crate:SetCatalog(self.CrateProducts or {});self:Close();crate:ShowCrate(p.CrateId)
  end))
  table.insert(self.Connections,self.Main:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()self:_layout()end))
  for _,attribute in ipairs({"MatchId","ResultsSessionId"})do table.insert(self.Connections,Player:GetAttributeChangedSignal(attribute):Connect(function()if self:IsBlocked()then self:Close()end end))end
 end)
end
function Controller:Destroy()self.Destroyed=true;self:Close();for _,c in ipairs(self.Connections)do c:Disconnect()end;table.clear(self.Connections)end
return Controller
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1801">
          <Properties>
            <string name="Name">SettingsController</string>
            <string name="Source"><![CDATA[--!strict
-- SettingsController
-- Controlador cliente de la interfaz de configuración (Settings/Ajustes).
-- Gestiona la interfaz de usuario de forma modular y se comunica exclusivamente
-- con MusicController para aplicar cambios de volumen y estado de la música.

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local localPlayer = Players.LocalPlayer

local SettingsController = {}
SettingsController.Name = "SettingsController"

-- Referencias a instancias de PlayerGui.SettingsGUI
SettingsController._hud = nil :: ScreenGui?
SettingsController._openButton = nil :: TextButton?
SettingsController._mainFrame = nil :: Frame?
SettingsController._closeButton = nil :: TextButton?

-- AudioSection - Music Toggle
SettingsController._musicToggle = nil :: TextButton?
SettingsController._toggleStatusText = nil :: TextLabel?
SettingsController._toggleStroke = nil :: UIStroke?

-- AudioSection - Music Slider
SettingsController._volumePercent = nil :: TextLabel?
SettingsController._slider = nil :: TextButton?
SettingsController._sliderTrack = nil :: Frame?
SettingsController._sliderFill = nil :: Frame?
SettingsController._sliderKnob = nil :: Frame?

-- Estado interno
SettingsController._context = nil :: any
SettingsController._isDragging = false
SettingsController._dragConnection = nil :: RBXScriptConnection?
SettingsController._endedConnection = nil :: RBXScriptConnection?

--------------------------------------------------------------------------------
-- Enlace a la Interfaz de Usuario
--------------------------------------------------------------------------------

function SettingsController:_bindHUD()
	local playerGui = localPlayer:WaitForChild("PlayerGui")
	local hud = playerGui:WaitForChild("SettingsGUI", 15) :: ScreenGui?
	if not hud then
		warn("[SettingsController] No se encontro SettingsGUI en PlayerGui")
		return
	end
	self._hud = hud

	-- Botón de apertura global (en esquina de pantalla)
	self._openButton = hud:WaitForChild("SettingsButton", 5) :: TextButton?

	-- Modal principal
	local mainFrame = hud:WaitForChild("MainFrame", 5) :: Frame?
	if not mainFrame then
		warn("[SettingsController] No se encontro MainFrame en SettingsGUI")
		return
	end
	self._mainFrame = mainFrame
	mainFrame.Visible = false

	-- Header y botón de cierre
	local header = mainFrame:FindFirstChild("Header")
	if header then
		self._closeButton = header:FindFirstChild("CloseButton") :: TextButton?
	end

	-- Sección de Audio
	local content = mainFrame:FindFirstChild("Content")
	local audioSection = content and content:FindFirstChild("AudioSection")
	if audioSection then
		-- Toggle de Música
		local toggleRow = audioSection:FindFirstChild("MusicToggleRow")
		if toggleRow then
			local toggle = toggleRow:FindFirstChild("MusicToggle") :: TextButton?
			if toggle then
				self._musicToggle = toggle
				self._toggleStatusText = toggle:FindFirstChild("StatusText") :: TextLabel?
				self._toggleStroke = toggle:FindFirstChildOfClass("UIStroke")
			end
		end

		-- Slider de Volumen
		local volumeRow = audioSection:FindFirstChild("MusicVolumeRow")
		if volumeRow then
			local topRow = volumeRow:FindFirstChild("TopRow")
			if topRow then
				self._volumePercent = topRow:FindFirstChild("MusicVolumePercent") :: TextLabel?
			end

			local slider = volumeRow:FindFirstChild("MusicSlider") :: TextButton?
			if slider then
				self._slider = slider
				self._sliderTrack = slider:FindFirstChild("Track") :: Frame?
				if self._sliderTrack then
					self._sliderFill = self._sliderTrack:FindFirstChild("Fill") :: Frame?
				end
				self._sliderKnob = slider:FindFirstChild("Knob") :: Frame?
			end
		end
	end
end

--------------------------------------------------------------------------------
-- Conexión de Eventos de Interacción (Mouse, Touch, Móvil)
--------------------------------------------------------------------------------

function SettingsController:_connectEvents()
	-- 1. Apertura y Cierre
	if self._openButton then
		self._openButton.Activated:Connect(function()
			self:Toggle()
		end)
	end

	if self._closeButton then
		self._closeButton.Activated:Connect(function()
			self:Close()
		end)
	end

	-- 2. Toggle de Música (ON / OFF)
	if self._musicToggle then
		self._musicToggle.Activated:Connect(function()
			local musicController = self:_getMusicController()
			if not musicController then return end

			local current = musicController:IsMusicEnabled()
			local nextState = not current
			musicController:SetMusicEnabled(nextState)
			self:_updateToggleUI(nextState)
		end)
	end

	-- 3. Slider de Volumen (Soporte Mouse y Touch Drag)
	if self._slider then
		self._slider.InputBegan:Connect(function(input: InputObject)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				self._isDragging = true
				self:_processSliderInput(input.Position.X, false)

				self:_setupGlobalDragListeners()
			end
		end)
	end
end

function SettingsController:_setupGlobalDragListeners()
	self:_cleanupGlobalDragListeners()

	-- Movimiento continuo (arrastre del slider con mouse o dedo en pantalla táctil)
	self._dragConnection = UserInputService.InputChanged:Connect(function(input: InputObject)
		if not self._isDragging then return end

		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			self:_processSliderInput(input.Position.X, true)
		end
	end)

	-- Fin del arrastre
	self._endedConnection = UserInputService.InputEnded:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			if self._isDragging then
				self._isDragging = false
				self:_processSliderInput(input.Position.X, false)
				self:_cleanupGlobalDragListeners()
			end
		end
	end)
end

function SettingsController:_cleanupGlobalDragListeners()
	if self._dragConnection then
		self._dragConnection:Disconnect()
		self._dragConnection = nil
	end
	if self._endedConnection then
		self._endedConnection:Disconnect()
		self._endedConnection = nil
	end
end

--------------------------------------------------------------------------------
-- Procesamiento Matemático del Slider
--------------------------------------------------------------------------------

function SettingsController:_processSliderInput(inputX: number, isDragging: boolean)
	if not self._slider then return end

	local sliderAbsPos = self._slider.AbsolutePosition
	local sliderAbsSize = self._slider.AbsoluteSize
	if sliderAbsSize.X <= 0 then return end

	local relativeX = inputX - sliderAbsPos.X
	local volumeFraction = math.clamp(relativeX / sliderAbsSize.X, 0, 1)

	-- Actualizar UI visualmente al instante
	self:_updateSliderUI(volumeFraction)

	-- Enviar valor autoritativo al MusicController
	local musicController = self:_getMusicController()
	if musicController then
		-- Si está en arrastre continuo usar fadeDuration 0 para latencia cero
		local fade = if isDragging then 0 else 0.1
		musicController:SetMusicVolume(volumeFraction, fade)
	end
end

--------------------------------------------------------------------------------
-- Actualización Visual de Componentes
--------------------------------------------------------------------------------

function SettingsController:_updateToggleUI(enabled: boolean)
	if self._musicToggle then
		local targetColor = if enabled
			then Color3.fromRGB(40, 140, 75)
			else Color3.fromRGB(45, 55, 75)
		local targetStroke = if enabled
			then Color3.fromRGB(60, 180, 100)
			else Color3.fromRGB(65, 80, 105)

		self._musicToggle.BackgroundColor3 = targetColor
		if self._toggleStroke then
			self._toggleStroke.Color = targetStroke
		end
	end

	if self._toggleStatusText then
		self._toggleStatusText.Text = if enabled then "ON" else "OFF"
		self._toggleStatusText.TextColor3 = if enabled
			then Color3.fromRGB(255, 255, 255)
			else Color3.fromRGB(160, 175, 200)
	end
end

function SettingsController:_updateSliderUI(volume: number)
	local clamped = math.clamp(volume, 0, 1)
	local percentInt = math.floor(clamped * 100 + 0.5)

	-- Porcentaje de texto
	if self._volumePercent then
		self._volumePercent.Text = string.format("%d%%", percentInt)
	end

	-- Barra de relleno (Fill)
	if self._sliderFill then
		self._sliderFill.Size = UDim2.new(clamped, 0, 1, 0)
	end

	-- Perilla de arrastre (Knob)
	if self._sliderKnob then
		self._sliderKnob.Position = UDim2.new(clamped, 0, 0.5, 0)
	end
end

--------------------------------------------------------------------------------
-- Sincronización y Acceso a MusicController
--------------------------------------------------------------------------------

function SettingsController:_getMusicController(): any
	if self._context and typeof(self._context.GetController) == "function" then
		return self._context:GetController("MusicController")
	end
	return nil
end

function SettingsController:SyncWithMusicController()
	local musicController = self:_getMusicController()
	if not musicController then return end

	local enabled = musicController:IsMusicEnabled()
	local volume = musicController:GetMusicVolume()

	self:_updateToggleUI(enabled)
	self:_updateSliderUI(volume)
end

--------------------------------------------------------------------------------
-- API Pública
--------------------------------------------------------------------------------

function SettingsController:Open()
	if self._mainFrame then
		self:SyncWithMusicController()
		self._mainFrame.Visible = true
	end
end

function SettingsController:Close()
	if self._mainFrame then
		self._mainFrame.Visible = false
		self._isDragging = false
		self:_cleanupGlobalDragListeners()
	end
end

function SettingsController:Toggle()
	if self._mainFrame then
		if self._mainFrame.Visible then
			self:Close()
		else
			self:Open()
		end
	end
end

function SettingsController:IsOpen(): boolean
	return self._mainFrame ~= nil and self._mainFrame.Visible == true
end

--------------------------------------------------------------------------------
-- Ciclo de Vida Bootstrap
--------------------------------------------------------------------------------

function SettingsController:Init(context: any)
	self._context = context
	self:_bindHUD()
end

function SettingsController:Start(context: any)
	self._context = context
	self:_connectEvents()
	self:SyncWithMusicController()
	print("[SettingsController] Controlador de ajustes iniciado y enlazado a SettingsGUI")
end

return SettingsController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1802">
          <Properties>
            <string name="Name">ShopController</string>
            <string name="Source"><![CDATA[--!strict
-- ShopController
-- Controlador cliente de la tienda (docs/SHOP_SYSTEM.md → ShopController / ShopUI).
-- - Enlaza las instancias existentes de PlayerGui.ShopHUD (creadas en Studio). No construye UI por código:
--   solo clona ProductCardTemplate por producto y modifica propiedades de instancias existentes.
-- - Obtiene el catálogo y solicita compra/equipamiento mediante Remotes.Shop (RemoteFunctions de ShopRemotes).
-- - Coins e Inventory se reflejan exclusivamente desde Remotes.Player.DataUpdated (fuente autoritativa).
-- - Sin operaciones optimistas: la UI solo cambia de estado cuando el servidor lo confirma.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local CrateView = require(ReplicatedStorage.Shared.SlapCrates.CrateShopView)

local localPlayer = Players.LocalPlayer

local ShopController = {}
ShopController.Name = "ShopController"

local DEFAULT_CATEGORY = "PointEffects"
local REMOTE_TIMEOUT = 15

-- Mensajes legibles para los códigos de error reales devueltos por ShopService / Providers / ShopRemotes
local ERROR_MESSAGES: { [string]: string } = {
	InsufficientFunds = "No tenés Coins suficientes.",
	AlreadyOwned = "Ya tenés este producto.",
	AlreadyEquipped = "Este producto ya está equipado.",
	NotOwned = "Todavía no tenés este producto.",
	TransactionInProgress = "Ya hay una compra en curso.",
	RateLimited = "Esperá un momento antes de reintentar.",
	ProductNotFound = "El producto no existe.",
	ProductUnavailable = "El producto no está disponible.",
	ProviderNotFound = "Esta categoría todavía no está disponible.",
	NotEquippable = "Este producto no se puede equipar.",
	MarketplaceIntegrationPendingPhase6 = "Las compras con Robux todavía no están disponibles.",
	MissingRobloxProductId = "Las compras con Robux todavía no están disponibles.",
	UnsupportedCurrency = "Moneda no soportada.",
	PlayerServiceNotAvailable = "El servidor no está listo. Reintentá en unos segundos.",
	InternalError = "Error del servidor. Reintentá.",
	NoResponse = "Sin respuesta del servidor. Reintentá.",
	DataNotLoaded = "Tus datos todavía no están disponibles. Reintentá cuando terminen de cargar.",
	PurchasesNotEnabled = "Las compras de esta categoría todavía no están habilitadas.",
}

type UIRefs = {
	Hud: ScreenGui,
	OpenButton: GuiButton?,
	Main: Frame,
	OpenScale: UIScale?,
	CloseButton: GuiButton?,
	CoinsLabel: TextLabel?,
	Tabs: Frame?,
	Catalog: ScrollingFrame,
	CardTemplate: GuiButton,
	EmptyState: GuiObject?,
	LoadingLabel: GuiObject?,
	MessageLabel: TextLabel?,
	Detail: {
		Frame: Frame,
		PreviewLabel: TextLabel?,
		PreviewIcon: ImageLabel?,
		NameLabel: TextLabel?,
		RarityLabel: TextLabel?,
		DescriptionLabel: TextLabel?,
		PriceRow: GuiObject?,
		PriceLabel: TextLabel?,
		StatusLabel: TextLabel?,
		ActionButton: TextButton?,
		SecondaryButton: TextButton?,
	},
}

ShopController._context = nil :: any
ShopController._ui = nil :: UIRefs?
ShopController._remotes = {} :: { [string]: RemoteFunction }
ShopController._dataUpdated = nil :: RemoteEvent?
ShopController._dataConnection = nil :: RBXScriptConnection?
ShopController._connections = {} :: { RBXScriptConnection }
ShopController._cardConnections = {} :: { RBXScriptConnection }
ShopController._tabs = {} :: { [string]: GuiButton }
ShopController._tabBaseColors = {} :: { [GuiButton]: Color3 }
ShopController._tabBaseImageColors = {} :: { [ImageButton]: Color3 }
ShopController._cards = {} :: { [string]: GuiButton }
ShopController._cardBaseStroke = nil :: { Color: Color3, Thickness: number }?

ShopController._catalog = nil :: { any }?
ShopController._catalogLoading = false
ShopController._playerData = nil :: any
ShopController._category = DEFAULT_CATEGORY
ShopController._selectedId = nil :: string?
ShopController._busy = false
ShopController._isOpen = false
ShopController._messageToken = 0

--------------------------------------------------------------------------------
-- Utilidades
--------------------------------------------------------------------------------

local function attrColor(inst: Instance?, name: string, default: Color3): Color3
	local v = inst and inst:GetAttribute(name)
	if typeof(v) == "Color3" then
		return v
	end
	return default
end

local function find(parent: Instance?, path: { string }): Instance?
	local current = parent
	for _, name in ipairs(path) do
		if not current then return nil end
		current = current:FindFirstChild(name)
	end
	return current
end

local function formatNumber(n: number): string
	local s = tostring(math.floor(n))
	local formatted = s:reverse():gsub("(%d%d%d)", "%1."):reverse()
	return (formatted:gsub("^%.", ""))
end

--------------------------------------------------------------------------------
-- Enlace de UI
--------------------------------------------------------------------------------

function ShopController:_bindHUD(): boolean
	local playerGui = localPlayer:WaitForChild("PlayerGui")
	local hud = playerGui:WaitForChild("ShopHUD", REMOTE_TIMEOUT) :: ScreenGui?
	if not hud then
		warn("[ShopController] No se encontró ShopHUD en PlayerGui")
		return false
	end

	local main = hud:FindFirstChild("MainFrame") :: Frame?
	local catalog = find(main, { "Body", "Catalog" }) :: ScrollingFrame?
	local template = catalog and catalog:FindFirstChild("ProductCardTemplate") :: GuiButton?
	local detailFrame = find(main, { "Body", "DetailPanel" }) :: Frame?
	if not main or not catalog or not template or not detailFrame then
		warn("[ShopController] Estructura de ShopHUD incompleta (MainFrame/Body/Catalog/ProductCardTemplate/DetailPanel)")
		return false
	end

	template.Visible = false
	main.Visible = false

	self._ui = {
		Hud = hud,
		OpenButton = hud:FindFirstChild("ShopButton") :: GuiButton?,
		Main = main,
		OpenScale = main:FindFirstChild("OpenScale") :: UIScale?,
		CloseButton = find(main, { "Header", "CloseButton" }) :: GuiButton?,
		CoinsLabel = find(main, { "Header", "CoinsContainer", "CoinsLabel" }) :: TextLabel?,
		Tabs = main:FindFirstChild("Tabs") :: Frame?,
		Catalog = catalog,
		CardTemplate = template,
		EmptyState = find(main, { "Body", "EmptyState" }) :: GuiObject?,
		LoadingLabel = find(main, { "Body", "LoadingLabel" }) :: GuiObject?,
		MessageLabel = main:FindFirstChild("MessageLabel") :: TextLabel?,
		Detail = {
			Frame = detailFrame,
			PreviewLabel = find(detailFrame, { "Preview", "PreviewLabel" }) :: TextLabel?,
			PreviewIcon = find(detailFrame, { "Preview", "PreviewIcon" }) :: ImageLabel?,
			NameLabel = detailFrame:FindFirstChild("NameLabel") :: TextLabel?,
			RarityLabel = detailFrame:FindFirstChild("RarityLabel") :: TextLabel?,
			DescriptionLabel = detailFrame:FindFirstChild("DescriptionLabel") :: TextLabel?,
			PriceRow = detailFrame:FindFirstChild("PriceRow") :: GuiObject?,
			PriceLabel = find(detailFrame, { "PriceRow", "PriceLabel" }) :: TextLabel?,
			StatusLabel = detailFrame:FindFirstChild("StatusLabel") :: TextLabel?,
			ActionButton = detailFrame:FindFirstChild("ActionButton") :: TextButton?,
			SecondaryButton = detailFrame:FindFirstChild("SecondaryButton") :: TextButton?,
		},
	}

	local templateStroke = template:FindFirstChildOfClass("UIStroke")
	if templateStroke then
		self._cardBaseStroke = { Color = templateStroke.Color, Thickness = templateStroke.Thickness }
	end

	-- Pestañas: cualquier GuiButton dentro de Tabs con atributo Category
	local tabsFrame = self._ui.Tabs
	if tabsFrame then
		for _, child in ipairs(tabsFrame:GetChildren()) do
			local category = child:GetAttribute("Category")
			if child:IsA("GuiButton") and typeof(category) == "string" then
				self._tabs[category] = child
				self._tabBaseColors[child] = child.BackgroundColor3
				if child:IsA("ImageButton") then self._tabBaseImageColors[child] = child.ImageColor3 end
				table.insert(self._connections, child.Activated:Connect(function()
					self:_selectCategory(category)
				end))
			end
		end
	end

	local ui = self._ui
	if ui.OpenButton then
		ui.OpenButton.Visible=false -- Ordinary access is the server-validated physical CoinShop.
	end
	if ui.CloseButton then
		table.insert(self._connections, ui.CloseButton.Activated:Connect(function()
			self:Close()
		end))
	end
	if ui.Detail.ActionButton then
		table.insert(self._connections, ui.Detail.ActionButton.Activated:Connect(function()
			self:_onActionPressed()
		end))
	end
	if ui.Detail.SecondaryButton then
		table.insert(self._connections, ui.Detail.SecondaryButton.Activated:Connect(function()
			self:_onSecondaryPressed()
		end))
	end

	return true
end

function ShopController:_bindRemotes()
	local remotes = ReplicatedStorage:WaitForChild("Remotes", REMOTE_TIMEOUT)
	local shopFolder = remotes and remotes:WaitForChild("Shop", REMOTE_TIMEOUT)
	if shopFolder then
		local access=shopFolder:WaitForChild("CoinShopAccess",REMOTE_TIMEOUT)
		if access and access:IsA("RemoteEvent")then
			table.insert(self._connections,access.OnClientEvent:Connect(function()self:Open()end))
		end
		for _, name in ipairs({ "GetCatalog", "PurchaseProduct", "EquipProduct", "UnequipProduct" }) do
			local rf = shopFolder:WaitForChild(name, REMOTE_TIMEOUT)
			if rf and rf:IsA("RemoteFunction") then
				self._remotes[name] = rf
			else
				warn(string.format("[ShopController] RemoteFunction Shop.%s no disponible", name))
			end
		end
	end

	local playerFolder = remotes and remotes:WaitForChild("Player", REMOTE_TIMEOUT)
	local dataUpdated = playerFolder and playerFolder:WaitForChild("DataUpdated", REMOTE_TIMEOUT)
	if dataUpdated and dataUpdated:IsA("RemoteEvent") then
		-- Se conecta de forma diferida en la primera apertura (ver _ensureDataListener)
		self._dataUpdated = dataUpdated
	else
		warn("[ShopController] RemoteEvent Player.DataUpdated no disponible")
	end
end

-- Conecta DataUpdated recién cuando el jugador abre la tienda.
-- Motivo: los eventos disparados antes de que exista un listener quedan encolados y se entregan al primer
-- handler que se conecta; conectar aquí evita robarle el snapshot inicial a PlayerHUDController.
-- El snapshot para la tienda lo reenvía el servidor al invocar GetCatalog.
function ShopController:_ensureDataListener()
	if self._dataConnection or not self._dataUpdated then return end
	self._dataConnection = self._dataUpdated.OnClientEvent:Connect(function(data: any)
		if type(data) == "table" then
			self._playerData = data
			self:_refresh()
		end
	end)
end

--------------------------------------------------------------------------------
-- Estado derivado (siempre desde datos del servidor)
--------------------------------------------------------------------------------

function ShopController:_isOwned(product: any): boolean
	local inv = self._playerData and self._playerData.Inventory
	local owned = inv and inv.Owned and inv.Owned[product.Category]
	return type(owned) == "table" and owned[product.Id] == true
end

function ShopController:_isEquipped(product: any): boolean
	local inv = self._playerData and self._playerData.Inventory
	return inv ~= nil and inv.Equipped ~= nil and inv.Equipped[product.Category] == product.Id
end

function ShopController:_getProducts(category: string): { any }
	local list = {}
	for _, product in ipairs(self._catalog or {}) do
		if product.Category == category then
			if product.Metadata and product.Metadata.PremiumOnly then
				local crates=self._playerData and self._playerData.Inventory and self._playerData.Inventory.Crates
				if not crates or (crates[product.Id]or 0)<=0 then continue end
			end
			table.insert(list, product)
		end
	end
		return CrateView.SortProducts(list, category)
end

function ShopController:_getProduct(productId: string?): any
	if not productId then return nil end
	for _, product in ipairs(self._catalog or {}) do
		if product.Id == productId and product.Category == self._category then return product end
	end
	return nil
end

-- Una categoría está activa si el servidor expone productos para ella (proveedor registrado)
function ShopController:_isCategoryActive(category: string): boolean
	return #self:_getProducts(category) > 0
end

--------------------------------------------------------------------------------
-- Render
--------------------------------------------------------------------------------

function ShopController:_showMessage(text: string, kind: string?)
	local ui = self._ui
	if not ui or not ui.MessageLabel then return end
	local colorName = "MessageColor_" .. (kind or "Info")
	ui.MessageLabel.TextColor3 = attrColor(ui.Main, colorName, ui.MessageLabel.TextColor3)
	ui.MessageLabel.Text = text

	self._messageToken += 1
	local token = self._messageToken
	if text ~= "" then
		task.delay(4, function()
			if self._messageToken == token and self._ui and self._ui.MessageLabel then
				self._ui.MessageLabel.Text = ""
			end
		end)
	end
end

function ShopController:_renderCoins()
	local ui = self._ui
	if not ui or not ui.CoinsLabel then return end
	local coins = self._playerData and self._playerData.Coins
	ui.CoinsLabel.Text = if typeof(coins) == "number" then formatNumber(coins) else "—"
end

function ShopController:_renderTabs()
	local ui = self._ui
	if not ui then return end
	local activeColor = attrColor(ui.Tabs, "ActiveColor", Color3.fromRGB(0, 120, 215))
	for category, tab in pairs(self._tabs) do
		local isSelected = category == self._category
		local isActive = self._catalog ~= nil and self:_isCategoryActive(category)
		tab.BackgroundColor3 = if isSelected then activeColor else (self._tabBaseColors[tab] or tab.BackgroundColor3)
		if tab:IsA("ImageButton") then
			tab.ImageColor3 = if isSelected then activeColor else (self._tabBaseImageColors[tab] or tab.ImageColor3)
		end
		local badge = tab:FindFirstChild("SoonBadge")
		if badge and badge:IsA("GuiObject") then
			badge.Visible = self._catalog ~= nil and not isActive
		end
	end
end

function ShopController:_clearCards()
	for _, conn in ipairs(self._cardConnections) do
		conn:Disconnect()
	end
	table.clear(self._cardConnections)
	for _, card in pairs(self._cards) do
		card:Destroy()
	end
	table.clear(self._cards)
end

function ShopController:_rarityColor(rarity: string?): Color3
	local ui = self._ui
	return attrColor(ui and ui.Main, "RarityColor_" .. tostring(rarity), Color3.fromRGB(170, 180, 200))
end

function ShopController:_crateView(product: any): any
	local c = self._context and self._context.GetController and self._context:GetController("CrateController")
	return if c then c:GetView(product, self._playerData) else CrateView.State(product, self._playerData, nil, workspace:GetServerTimeNow(), false)
end

function ShopController:_cratePreview(preview: Instance?, product: any)
	if not preview or product.Icon ~= "" then return end
	local template = self._ui.Hud:FindFirstChild("CratePreviewTemplate")
	local models = ReplicatedStorage:FindFirstChild("CrateEffects")
	local model = models and product.Metadata and models:FindFirstChild(product.Metadata.Model)
	if not template or not model then return end
	local viewport = template:Clone();viewport.Name="CratePreview";viewport.Visible=true;viewport.Parent=preview
		-- Cameras may be absent in the client copy of a StarterGui template.
		-- Keep the preview camera local and bind CurrentCamera explicitly.
		local camera = viewport:FindFirstChildWhichIsA("Camera") :: Camera?
		if not camera then
			camera = Instance.new("Camera")
			camera.Name = "Camera"
			camera.FieldOfView = 45
			camera.Parent = viewport
		end
	local clone=model:Clone();clone:PivotTo(CFrame.new());clone.Parent=viewport.WorldModel
	local distance=math.clamp(clone:GetExtentsSize().Magnitude*1.2,4,24)
		camera.CFrame=CFrame.lookAt(Vector3.new(distance,distance*.65,distance),Vector3.new())
		viewport.CurrentCamera=camera
	local label=preview:FindFirstChild("PreviewLabel");if label then label.Visible=false end
end

function ShopController:_applyCardState(card: GuiButton, product: any)
	local ui = self._ui
	if not ui then return end
	local owned = self:_isOwned(product)
	local equipped = self:_isEquipped(product)
		if product.Category == "Crates" then
			local state=self:_crateView(product)
			local price=card:FindFirstChild("PriceLabel");if price then price.Visible=true;price.Text=state.PriceText end
			local coin=card:FindFirstChild("CoinIcon");if coin then coin.Visible=false end
			local badge=card:FindFirstChild("StateBadge");if badge then badge.Visible=true;badge.Text=if state.Quantity>0 then state.Quantity.." cajas" else state.Badge end
			local actions=card:FindFirstChild("CrateActions")
			if actions then
				actions.Action.Text=if state.BuyEnabled then "COMPRAR" elseif state.Quantity>0 and state.OpenEnabled then "ABRIR" else "VER CAJA"
				actions.Action.Active=state.BuyEnabled or state.OpenEnabled
				if actions:FindFirstChild("StockLabel") then actions.StockLabel.Text=state.StockText end
			end
			return
		end

	local badge = card:FindFirstChild("StateBadge") :: TextLabel?
	if badge then
		if not product.IsAvailable then
			badge.Visible = true
			badge.Text = "NO DISPONIBLE"
			badge.BackgroundColor3 = attrColor(badge, "Color_Unavailable", badge.BackgroundColor3)
		elseif equipped then
			badge.Visible = true
			badge.Text = if product.Category == "Abilities" then "PREFERIDA" else "EQUIPADO"
			badge.BackgroundColor3 = attrColor(badge, "Color_Equipped", badge.BackgroundColor3)
		elseif owned then
			badge.Visible = true
			badge.Text = "TUYO"
			badge.BackgroundColor3 = attrColor(badge, "Color_Owned", badge.BackgroundColor3)
		else
			badge.Visible = false
		end
	end

	local priceLabel = card:FindFirstChild("PriceLabel") :: TextLabel?
	local coinIcon = card:FindFirstChild("CoinIcon") :: GuiObject?
	local showPrice = not owned and product.Currency == "Coins"
	if priceLabel then
		priceLabel.Visible = not owned
			priceLabel.Text = if product.Category == "Slaps" then "SOLO EN CAJAS" elseif product.Metadata and product.Metadata.PricePending then "PRECIO PENDIENTE" elseif product.Currency == "Coins" then formatNumber(product.Price or 0)
			else string.format("%s R$", formatNumber(product.Price or 0))
	end
		if coinIcon then coinIcon.Visible = showPrice and product.Category ~= "Slaps" and not (product.Metadata and product.Metadata.PricePending) end

	local cardStroke = card:FindFirstChildOfClass("UIStroke")
	if cardStroke and self._cardBaseStroke then
		local selected = product.Id == self._selectedId
		cardStroke.Color = if selected then attrColor(ui.Main, "SelectedStrokeColor", self._cardBaseStroke.Color) else self._cardBaseStroke.Color
		cardStroke.Thickness = if selected then self._cardBaseStroke.Thickness + 1 else self._cardBaseStroke.Thickness
	end
end

function ShopController:_renderCatalog()
	local ui = self._ui
	if not ui then return end
	self:_clearCards()

	local loading = self._catalog == nil
	if ui.LoadingLabel then ui.LoadingLabel.Visible = loading end

	local products = if loading then {} else self:_getProducts(self._category)
	local isEmpty = not loading and #products == 0
	if ui.EmptyState then ui.EmptyState.Visible = isEmpty end
	ui.Catalog.Visible = not loading and not isEmpty
	ui.Detail.Frame.Visible = not loading and not isEmpty

	for index, product in ipairs(products) do
		local card = ui.CardTemplate:Clone()
		card.Name = "Card_" .. tostring(product.Id)
		card.LayoutOrder = index
		card.Visible = true

		local nameLabel = card:FindFirstChild("NameLabel") :: TextLabel?
		if nameLabel then nameLabel.Text = product.DisplayName or product.Id end
		local rarityLabel = card:FindFirstChild("RarityLabel") :: TextLabel?
		if rarityLabel then
			rarityLabel.Text = product.Rarity or ""
				if product.Category == "Crates" then rarityLabel.Text="Favorece: "..(product.Metadata and product.Metadata.FavouredVariations or "Pendiente") end
			rarityLabel.TextColor3 = self:_rarityColor(product.Rarity)
		end
		local preview = card:FindFirstChild("Preview")
			if product.Category=="Crates" then self:_cratePreview(preview,product) end
			if product.Category == "Crates" then
				local actionsTemplate=ui.Hud:FindFirstChild("CrateActionsTemplate")
				if actionsTemplate then
					local actions=actionsTemplate:Clone();actions.Name="CrateActions";actions.Visible=true;actions.Parent=card
					local function show()local c=self._context:GetController("CrateController");if c then c:ShowCrate(product.Id)end end
					table.insert(self._cardConnections,actions.ViewOdds.Activated:Connect(show))
					actions.Action.Active=product.Metadata and product.Metadata.PurchaseEnabled==true
					actions.Action.Text=if actions.Action.Active then "COMPRAR/ABRIR" else "BLOQUEADA"
					table.insert(self._cardConnections,actions.Action.Activated:Connect(show))
				end
			end
		local previewStroke = preview and preview:FindFirstChildOfClass("UIStroke")
		if previewStroke then previewStroke.Color = self:_rarityColor(product.Rarity) end
		local icon = preview and preview:FindFirstChild("PreviewIcon") :: ImageLabel?
		if icon and type(product.Icon) == "string" and product.Icon ~= "" then
			icon.Image = product.Icon
			icon.Visible = true
			local placeholder = preview and preview:FindFirstChild("PreviewLabel") :: GuiObject?
			if placeholder then placeholder.Visible = false end
		end

		self:_applyCardState(card, product)
		card.Parent = ui.Catalog
		self._cards[product.Id] = card

		local productId = product.Id
		table.insert(self._cardConnections, card.Activated:Connect(function()
			self._selectedId = productId
			self:_refreshStates()
		end))
	end

	-- Mantener selección válida dentro de la categoría
	if not self:_getProduct(self._selectedId) or (self:_getProduct(self._selectedId).Category ~= self._category) then
		self._selectedId = if #products > 0 then products[1].Id else nil
	end
	self:_refreshStates()
end

function ShopController:_renderDetail()
	local ui = self._ui
	if not ui then return end
	local d = ui.Detail
	local product = self:_getProduct(self._selectedId)

	if not product then
		if d.NameLabel then d.NameLabel.Text = "Seleccioná un producto" end
		if d.RarityLabel then d.RarityLabel.Text = "" end
		if d.DescriptionLabel then d.DescriptionLabel.Text = "" end
		if d.PriceRow then d.PriceRow.Visible = false end
		if d.StatusLabel then d.StatusLabel.Text = "" end
		if d.ActionButton then d.ActionButton.Visible = false end
		if d.SecondaryButton then d.SecondaryButton.Visible = false end
		return
	end
		if product.Category == "Crates" then
				local state=self:_crateView(product)
			if d.NameLabel then d.NameLabel.Text=product.DisplayName end
			if d.DescriptionLabel then d.DescriptionLabel.Text=product.Description end
			if d.PriceRow then d.PriceRow.Visible=true end
				if d.PriceLabel then d.PriceLabel.Text=state.PriceText end
				if d.StatusLabel then d.StatusLabel.Text=state.Status.." · "..state.Quantity.." cajas" end
			if d.ActionButton then d.ActionButton.Visible=true;d.ActionButton.Active=true;d.ActionButton.Text="VER CAJA" end
			if d.SecondaryButton then d.SecondaryButton.Visible=false end
			return
		end

	local owned = self:_isOwned(product)
	local equipped = self:_isEquipped(product)
	local rarityColor = self:_rarityColor(product.Rarity)

	if d.NameLabel then d.NameLabel.Text = product.DisplayName or product.Id end
	if d.RarityLabel then
		d.RarityLabel.Text = product.Rarity or ""
		d.RarityLabel.TextColor3 = rarityColor
	end
	if d.DescriptionLabel then d.DescriptionLabel.Text = product.Description or "" end
	if d.PreviewIcon and d.PreviewLabel then
		local hasIcon = type(product.Icon) == "string" and product.Icon ~= ""
		d.PreviewIcon.Image = if hasIcon then product.Icon else ""
		d.PreviewIcon.Visible = hasIcon
		d.PreviewLabel.Visible = not hasIcon
	end
	if d.PriceRow then d.PriceRow.Visible = not owned end
		if d.PriceLabel then
			d.PriceLabel.Text = if product.Category == "Abilities" and product.Metadata and product.Metadata.PricePending then "Precio pendiente de aprobación" elseif product.Currency == "Coins" then string.format("%s Coins", formatNumber(product.Price or 0))
			else string.format("%s Robux", formatNumber(product.Price or 0))
	end

	local status, actionText, actionKind, actionEnabled
		if product.Category == "Slaps" and not owned then
			status, actionText, actionKind, actionEnabled = "Se obtiene abriendo cajas", "SOLO EN CAJAS", "Disabled", false
		elseif not product.IsAvailable then
		status, actionText, actionKind, actionEnabled = "Producto no disponible", "NO DISPONIBLE", "Disabled", false
	elseif equipped then
			status, actionText, actionKind, actionEnabled = if product.Category == "Abilities" then "Preferencia para la próxima ronda" else "Equipado actualmente", if product.Category == "Abilities" then "PREFERIDA" else "EQUIPADO", "Disabled", false
	elseif owned then
				status, actionText, actionKind, actionEnabled = "Ya es tuyo", "EQUIPAR", "Equip", true
			elseif product.Category == "Abilities" and (not product.Metadata or not product.Metadata.PurchaseEnabled or not product.Metadata.PriceApproved) then
			status, actionText, actionKind, actionEnabled = "Precio pendiente de aprobación", "PRÓXIMAMENTE", "Disabled", false
	elseif product.Currency ~= "Coins" then
		status, actionText, actionKind, actionEnabled = "Compras con Robux próximamente", "PRÓXIMAMENTE", "Disabled", false
	else
		local coins = self._playerData and self._playerData.Coins
		local canAfford = typeof(coins) == "number" and coins >= (product.Price or 0)
		status = if canAfford then "Disponible para comprar" else "Coins insuficientes"
			actionText, actionKind, actionEnabled = "COMPRAR", "Buy", canAfford
	end

	if self._busy then
		actionText, actionEnabled = "PROCESANDO…", false
	end

	if d.StatusLabel then d.StatusLabel.Text = status end
	if d.ActionButton then
		local btn = d.ActionButton
		btn.Visible = true
		btn.Text = actionText
		btn.Active = actionEnabled
		btn.AutoButtonColor = actionEnabled
		btn.BackgroundColor3 = attrColor(btn, "Color_" .. actionKind, btn.BackgroundColor3)
	end
	if d.SecondaryButton then
		-- Desequipar solo tiene sentido si el producto equipado no es el gratuito por defecto de la categoría
		d.SecondaryButton.Visible = equipped and (product.Price or 0) > 0
		d.SecondaryButton.Active = not self._busy
	end
end

-- Recalcula estados (cards + detalle + saldo) sin reconstruir las tarjetas
function ShopController:_refreshStates()
	for productId, card in pairs(self._cards) do
		local product = self:_getProduct(productId)
		if product then
			self:_applyCardState(card, product)
		end
	end
	self:_renderDetail()
	self:_renderCoins()
end

function ShopController:_refresh()
	if not self._ui then return end
	self:_renderCoins()
	if self._isOpen then
		self:_renderTabs()
		self:_refreshStates()
	end
end

--------------------------------------------------------------------------------
-- Interacción
--------------------------------------------------------------------------------

function ShopController:_selectCategory(category: string)
	if self._category == category then return end
	self._category = category
	self._selectedId = nil
	self:_renderTabs()
	self:_renderCatalog()
	if self._catalog and not self:_isCategoryActive(category) then
		self:_showMessage("Esta categoría estará disponible próximamente.", "Info")
	end
end

function ShopController:_loadCatalog()
	if self._catalogLoading then return end
	local rf = self._remotes.GetCatalog
	if not rf then
		self:_showMessage("La tienda no está disponible en este momento.", "Error")
		return
	end
	self._catalogLoading = true
	task.spawn(function()
		local ok, result = pcall(function()
			return rf:InvokeServer()
		end)
		self._catalogLoading = false
		if ok and type(result) == "table" then
			self._catalog = result
				local crates=self._context and self._context.GetController and self._context:GetController("CrateController")
				if crates then crates:SetCatalog(result) end
		else
			warn(string.format("[ShopController] GetCatalog falló: %s", tostring(result)))
			self:_showMessage("No se pudo cargar el catálogo. Cerrá y volvé a abrir la tienda.", "Error")
		end
		if self._isOpen then
			self:_renderTabs()
			self:_renderCatalog()
		end
	end)
end

-- Ejecuta una operación del servidor bloqueando acciones repetidas hasta obtener respuesta
function ShopController:_request(remoteName: string, arg: string, successText: string, category: string?)
	if self._busy then return end
	local rf = self._remotes[remoteName]
	if not rf then
		self:_showMessage("La tienda no está disponible en este momento.", "Error")
		return
	end
	self._busy = true
	self:_renderDetail()

	task.spawn(function()
		local ok, success, code = pcall(function()
			return rf:InvokeServer(arg, category)
		end)
		self._busy = false
		if not ok then
			warn(string.format("[ShopController] %s falló: %s", remoteName, tostring(success)))
			self:_showMessage(ERROR_MESSAGES.NoResponse, "Error")
		elseif success == true then
			self:_showMessage(successText, "Success")
		else
			local key = tostring(code)
			self:_showMessage(ERROR_MESSAGES[key] or string.format("No se pudo completar la operación (%s).", key), "Error")
		end
		self:_refreshStates()
	end)
end

function ShopController:_onActionPressed()
	local product = self:_getProduct(self._selectedId)
	if not product or self._busy or not product.IsAvailable then return end
	if product.Category == "Crates" then
		local controller=self._context:GetController("CrateController")
		if controller then controller:ShowCrate(product.Id) end
		return
	end
	if product.Category == "Slaps" and not self:_isOwned(product) then return end
	if self:_isEquipped(product) then return end

	if self:_isOwned(product) then
			self:_request("EquipProduct", product.Id, if product.Category == "Abilities" then "Preferencia guardada para la próxima ronda." else string.format("%s equipado.", product.DisplayName or product.Id), product.Category)
	elseif product.Currency == "Coins" then
			if product.ProductType == "Ability" and (not product.Metadata
				or product.Metadata.PurchaseEnabled ~= true or product.Metadata.PriceApproved ~= true) then return end
			local coins = self._playerData and self._playerData.Coins
			if typeof(coins) ~= "number" or coins < product.Price then return end
		self:_request("PurchaseProduct", product.Id, string.format("¡Compraste %s!", product.DisplayName or product.Id), product.Category)
	end
end

function ShopController:_onSecondaryPressed()
	local product = self:_getProduct(self._selectedId)
	if not product or self._busy or not self:_isEquipped(product) then return end
	self:_request("UnequipProduct", product.Category, "Producto desequipado.")
end

--------------------------------------------------------------------------------
-- Apertura / cierre
--------------------------------------------------------------------------------

function ShopController:OpenCategory(category: string)
	if category ~= "Crates" then return end
	self._category = category
	if self._isOpen then self:_selectCategory(category) else self:Open() end
end

function ShopController:Open()
	local ui = self._ui
	if not ui or self._isOpen then return end
	local premium=self._context:GetController("PremiumShopController")
	if premium and premium.IsBlocked and premium:IsBlocked()then return end
	if premium then premium:Close()end
	self._isOpen = true
	ui.Main.Visible = true

	if ui.OpenScale then
		ui.OpenScale.Scale = 0.92
		TweenService:Create(ui.OpenScale, TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	end

	self:_renderTabs()
	self:_renderCatalog()
	-- El catálogo se solicita en cada apertura; GetCatalog también reenvía el snapshot de DataUpdated
	self:_ensureDataListener()
	self:_loadCatalog()
end

function ShopController:Close()
	local ui = self._ui
	if not ui or not self._isOpen then return end
	self._isOpen = false
	-- Las operaciones en curso continúan en el servidor; su resultado llegará por DataUpdated
	self:_clearCards()
	ui.Main.Visible = false
	if ui.OpenScale then ui.OpenScale.Scale = 1 end
end

function ShopController:Toggle()
	if self._isOpen then self:Close() else self:Open() end
end

--------------------------------------------------------------------------------
-- Ciclo de vida
--------------------------------------------------------------------------------

function ShopController:Init(context)
	self._context = context
end

function ShopController:Start(context)
	self._context = context
	task.spawn(function()
		if not self:_bindHUD() then return end
		self:_bindRemotes()
		self:_renderCoins()
		print("[ShopController] Tienda enlazada y lista")
	end)
end

function ShopController:Destroy()
	self:Close()
	self:_clearCards()
	for _, conn in ipairs(self._connections) do
		conn:Disconnect()
	end
	table.clear(self._connections)
	if self._dataConnection then
		self._dataConnection:Disconnect()
		self._dataConnection = nil
	end
	table.clear(self._tabs)
	table.clear(self._tabBaseColors)
	table.clear(self._tabBaseImageColors)
	self._ui = nil
end

return ShopController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1803">
          <Properties>
            <string name="Name">SlapController</string>
            <string name="Source"><![CDATA[--!strict
-- SlapController
-- Controlador cliente de Slaps.
-- Responsabilidad exclusiva:
-- 1. Detectar cuando el jugador equipa un Slap (Tool con Configuration.Power).
-- 2. Conectar al evento Tool.Activated.
-- 3. Predecir Swing inmediatamente y reconciliar solo su presentación.
-- 4. Solicitar la ejecucion autoritativa al servidor via ReplicatedStorage.Remotes.Combat.PerformSlap.
-- 5. Manejar un debounce local liviano para evitar saturar la red con clics repetidos.
-- NO calcula daño, distancia autoritativa, knockback ni fisica.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local StarterGui = game:GetService("StarterGui")
local Config = require(ReplicatedStorage.Shared.Config)

local localPlayer = Players.LocalPlayer

local SlapController = {}
SlapController.Name = "SlapController"

SlapController._context = nil :: any
SlapController._performSlapRemote = nil :: RemoteEvent?
SlapController._equippedTool = nil :: Tool?
SlapController._activatedConn = nil :: RBXScriptConnection?
SlapController._swingTrack = nil :: AnimationTrack?
SlapController._localNextSlapTime = 0
SlapController._awaitingUntil = 0
SlapController._predictionUntil = 0
SlapController._lastSequence = 0
SlapController._requestId = 0
SlapController._connections = {} :: { RBXScriptConnection }
SlapController._characterConnections = {} :: { RBXScriptConnection }
SlapController._pending = nil :: any
SlapController._scope = nil :: any
SlapController._sessionId = nil :: string?
SlapController._roundId = nil :: string?
SlapController._roundIndex = 0
SlapController._stateVersion = -1
SlapController._playing = false
SlapController._roundClosed = false
SlapController._visualStart = nil :: number?

function SlapController:_stopSwing(release: boolean?)
	local track = self._swingTrack
	if not track then return end
	pcall(function() track:Stop(0.05) end)
	if release then
		self._swingTrack = nil
		pcall(function() track:Destroy() end)
	end
end

function SlapController:GetCooldownState(now: number)
	local deadline = math.max(self._localNextSlapTime, self._predictionUntil)
	local pending = self._pending ~= nil and now < self._awaitingUntil
	local remaining = math.max(0, deadline - now)
	local blocked = remaining > 0 or now < self._awaitingUntil
	local startTime = self._visualStart or now
	local duration = math.max(0, deadline - startTime)
	local progress = if duration > 0 then math.clamp((now - startTime) / duration, 0, 1) else 1
	-- A pending result cannot visually advertise readiness when its provisional clock ends.
	if pending then progress = math.min(progress, 0.98) end
	return {
		Blocked = blocked, Pending = pending, Remaining = remaining, Deadline = deadline,
		Progress = if blocked then progress else 1,
		Text = if not blocked then "" elseif remaining > 0 then string.format("%.1f s", remaining) else "…",
	}
end

function SlapController:_hideNativeBackpack()
	if self._backpackHidden then return end
	local ok = pcall(function()
		if self._originalBackpackEnabled == nil then
			self._originalBackpackEnabled = StarterGui:GetCoreGuiEnabled(Enum.CoreGuiType.Backpack)
		end
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
	end)
	self._backpackHidden = ok
end

function SlapController:_renderSlot()
	local now = workspace:GetServerTimeNow()
	if not self._backpackHidden and now >= (self._nextBackpackAttempt or 0) then
		self._nextBackpackAttempt = now + 0.5; self:_hideNativeBackpack()
	end
	local root = self._slotRoot
	if not root then return end
	local tool = self._equippedTool
	local char = localPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local inMatch = localPlayer:GetAttribute("MatchId") ~= nil
		and localPlayer:GetAttribute("MatchId") == self._sessionId
	local visible = inMatch and tool ~= nil and tool.Parent == char and hum ~= nil and hum.Health > 0
		and char:GetAttribute("ArenaRespawnPending") ~= true
		and localPlayer:GetAttribute("ResultsSessionId") == nil
		and (self._matchState == "StartCountdown" or self._matchState == "Playing" or self._matchState == "PointRestartCountdown")
	root.Visible = visible
	if not visible then return end
	local slot = root.SlapSlot
	local name = tool:GetAttribute("DisplayName")
	if type(name) ~= "string" or name == "" then name = tool.ToolTip end
	if type(name) ~= "string" or name == "" then
		local configuredTool = slot:FindFirstChild("DefaultToolName")
		local configuredName = slot:FindFirstChild("DefaultDisplayName")
		name = if configuredTool and configuredName and tool.Name == configuredTool.Value then configuredName.Value else tool.Name
	end
	slot.NameLabel.Text = name or tool.Name
	slot.ToolIcon.Image = tool.TextureId
	slot.ToolIcon.Visible = tool.TextureId ~= ""
	slot.FallbackIcon.Visible = not slot.ToolIcon.Visible
	local view = self:GetCooldownState(now)
	local overlay = slot.CooldownOverlay
	overlay.Visible = view.Blocked
	overlay.CooldownTimeLabel.Text = view.Text
	overlay.CooldownBarBackground.CooldownBarFill.Size = UDim2.new(view.Progress, 0, 1, 0)
end

function SlapController:_trace(phase: string, reason: string?, data: any?)
	if not RunService:IsStudio() or ReplicatedStorage:GetAttribute("SlapDiagnosticsEnabled") ~= true then return end
	local second = math.floor(os.clock())
	if self._diagnosticSecond ~= second then self._diagnosticSecond = second; self._diagnosticCount = 0 end
	if self._diagnosticCount >= 12 then return end
	self._diagnosticCount += 1
	local p = if type(data) == "table" then data else (self._pending or {})
	print("[SlapTrace] " .. HttpService:JSONEncode({
		Build = "CombatSystemV132", Side = "Client", Phase = phase, UserId = localPlayer.UserId,
		RequestId = p.RequestId, AttackId = p.ServerAttackId or p.AttackId,
		PredictionId = p.PredictionId, SessionId = self._sessionId,
		RoundId = self._roundId, CharacterGeneration = self._scope and self._scope.Generation,
		RecoveryUntil = self._localNextSlapTime, RejectionReason = reason,
		PredictionUntil = self._predictionUntil, RequestTime = p.RequestTime,
		ReportedRecoveryUntil = p.RecoveryUntil, RecoveryType = p.Outcome,
		AttackStartTime = p.AttackStartTime, AttackWindowClosed = p.AttackWindowClosed,
		HitConfirmed = p.Hit,
		ServerTime = workspace:GetServerTimeNow(),
	}))
end

function SlapController:_resetRecovery()
	self._pending = nil; self._awaitingUntil = 0; self._localNextSlapTime = 0; self._predictionUntil = 0
	self._visualStart = nil
	self:_stopSwing()
end

function SlapController:_refreshScope()
	local char = localPlayer.Character
	local sessionId = localPlayer:GetAttribute("MatchId")
	local roundId = if sessionId == self._sessionId then self._roundId else nil
	local generation = char and (char:GetAttribute("ArenaPhysicsGeneration") or 0)
	local scope = self._scope
	if not scope or scope.Character ~= char or scope.Generation ~= generation
		or scope.SessionId ~= sessionId or scope.RoundId ~= roundId then
		self:_resetRecovery()
		self._scope = { Character = char, Generation = generation, SessionId = sessionId, RoundId = roundId }
	end
	return self._scope
end

function SlapController:_acceptMatch(data: any): boolean
	if type(data) ~= "table" or data.SessionId ~= localPlayer:GetAttribute("MatchId")
		or type(data.SessionId) ~= "string" or type(data.StateVersion) ~= "number" then return false end
	if self._sessionId ~= data.SessionId then
		self._sessionId = data.SessionId; self._roundId = nil; self._roundIndex = 0
		self._stateVersion = -1; self._roundClosed = false; self._playing = false
		self:_resetRecovery()
	end
	if data.StateVersion < self._stateVersion then return false end
	self._stateVersion = data.StateVersion
	return true
end

function SlapController:_onMatchState(state: string, data: any)
	if not self:_acceptMatch(data) then return end
	self._matchState = state
	if state ~= "Playing" then
		self._playing = false; self._roundClosed = true; self:_resetRecovery()
	end
end

function SlapController:_onCountdown(_remaining: number, label: string, data: any)
	if label ~= "PLAYING" or not self:_acceptMatch(data)
		or type(data.RoundId) ~= "string" or type(data.RoundIndex) ~= "number"
		or data.RoundIndex < self._roundIndex then return end
	if data.RoundId ~= self._roundId then
		if data.RoundIndex <= self._roundIndex then return end
		self._roundIndex = data.RoundIndex; self._roundId = data.RoundId; self._roundClosed = false
		self:_refreshScope()
	end
	if data.Resolved then self._roundClosed = true; self:_resetRecovery() end
	self._playing = not self._roundClosed
	if self._playing then self._matchState = "Playing" end
end

function SlapController:_onFeedback(data: any)
	local scope = self:_refreshScope()
	local pending = self._pending
		if type(data) ~= "table" or data.Protocol ~= 3 or not pending
		or data.RequestId ~= pending.RequestId
		or data.PredictionId ~= pending.PredictionId
		or data.Character ~= scope.Character or data.Generation ~= scope.Generation
		or data.SessionId ~= scope.SessionId or data.RoundId ~= scope.RoundId
		or type(data.Sequence) ~= "number" or data.Sequence <= self._lastSequence then
		self:_trace("FeedbackIgnored", "ObsoleteOrUnrelated", data); return
	end
	if data.Phase ~= "Started" and data.Phase ~= "Rejected" and data.Phase ~= "Result" and data.Phase ~= "Cancelled" then return end
	if data.Phase ~= "Rejected" and (type(data.AttackId) ~= "string" or data.Accepted ~= true) then return end
	if pending.ServerAttackId and data.AttackId ~= pending.ServerAttackId then return end
	local ready = data.RecoveryUntil
	if ready ~= nil and (type(ready) ~= "number" or ready ~= ready or math.abs(ready) == math.huge) then return end
	self._lastSequence = data.Sequence
	self:_trace("FeedbackReceived", data.Reason, data)
	if data.Phase == "Started" then
		-- The prediction already animated at input. Bind server identity; never replay.
		pending.ServerAttackId = data.AttackId
		return
	end
	if data.Phase == "Result" and (ready == nil or (data.Outcome ~= "Hit" and data.Outcome ~= "Miss")) then return end
	if ready then self._localNextSlapTime = math.max(self._localNextSlapTime, ready) end
	if data.Phase == "Rejected" or data.Phase == "Cancelled" or data.Reason == "SwingInvalidated" then
		-- Correct THIS prediction only; a stale reply never gets past the scope checks.
		self:_stopSwing()
		self:_trace("PredictionCancelled", data.Reason, data)
	end
	if data.WindowPending then
		-- A rejected retry cannot pretend an earlier in-flight swing ended.
		return
	end
	-- Only a confirmed result may replace the conservative local prediction.
	-- In particular, an early rejection cannot turn the input back on immediately.
	if data.Phase == "Result" then self._predictionUntil = 0 end
	self._pending = nil; self._awaitingUntil = 0
end

--------------------------------------------------------------------------------
-- Remotes
--------------------------------------------------------------------------------

function SlapController:_getPerformRemote(): RemoteEvent?
	if self._performSlapRemote then return self._performSlapRemote end

	local remotes = ReplicatedStorage:WaitForChild("Remotes", 5) :: Folder?
	local combat = remotes and remotes:WaitForChild("Combat", 5) :: Folder?
	local remote = combat and combat:WaitForChild("PerformSlap", 5) :: RemoteEvent?
	if remote and remote:IsA("RemoteEvent") then
		self._performSlapRemote = remote
		return remote
	end
	return nil
end

--------------------------------------------------------------------------------
-- Animaciones y Ciclo del Tool
--------------------------------------------------------------------------------

local function isSlapTool(tool: Instance): boolean
	if not tool:IsA("Tool") then return false end
	if tool:GetAttribute("IsSlapWeapon") ~= true then return false end
	local config = tool:FindFirstChild("Configuration")
	if config and config:FindFirstChild("Power") then
		return true
	end
	return false
end

function SlapController:_onToolEquipped(tool: Tool)
	if not isSlapTool(tool) then return end
	if self._equippedTool == tool and self._swingTrack and self._activatedConn and self._activatedConn.Connected then return end

	self:_onToolUnequipped()
	self._equippedTool = tool

	-- Preparar animacion de swing si existe
	local swingAnim = tool:FindFirstChild("Swing") :: Animation?
	local char = localPlayer.Character
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")
	local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")

	if swingAnim and swingAnim:IsA("Animation") and animator then
		local ok, track = pcall(function()
			return animator:LoadAnimation(swingAnim)
		end)
		if ok and track then
			track.Priority = Enum.AnimationPriority.Action
			track.Looped = false
			self._swingTrack = track
		end
	end

	-- Conectar activacion del Tool
	self._activatedConn = tool.Activated:Connect(function()
		self:_onToolActivated(tool)
	end)
end

function SlapController:_onToolUnequipped()
	if self._activatedConn then
		self._activatedConn:Disconnect()
		self._activatedConn = nil
	end

	self:_stopSwing(true)

	self._equippedTool = nil
	-- Recovery belongs to the competitive life, never to this Tool.
end

function SlapController:_onToolActivated(tool: Tool)
	local scope = self:_refreshScope()
	local now = workspace:GetServerTimeNow()
	if self:GetCooldownState(now).Blocked then
		self:_trace("ClientBlocked", "RecoveryOrPending")
		return
	end
	local char = localPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not self._playing or self._roundClosed or not scope.RoundId or scope.SessionId ~= self._sessionId
		or self._equippedTool ~= tool or tool.Parent ~= char or not hum or hum.Health <= 0
		or hum.PlatformStand or hum:GetAttribute("MovementLocked") == true
		or char:GetAttribute("ArenaRespawnPending") or localPlayer:GetAttribute("ResultsSessionId") ~= nil then
		self:_trace("ClientBlocked", "CompetitiveState"); return
	end
	local remote = self:_getPerformRemote()
	if remote then
		-- Remote discovery may yield. Another input or lifecycle event can win meanwhile.
		now = workspace:GetServerTimeNow()
		if self:GetCooldownState(now).Blocked or self:_refreshScope() ~= scope
			or not self._playing or self._roundClosed or self._equippedTool ~= tool
			or tool.Parent ~= char or hum.Health <= 0 or hum.PlatformStand
			or hum:GetAttribute("MovementLocked") == true or char:GetAttribute("ArenaRespawnPending")
			or localPlayer:GetAttribute("ResultsSessionId") ~= nil then return end
		self._requestId += 1
		local predictionId = scope.SessionId .. ":Prediction:" .. tostring(localPlayer.UserId) .. ":" .. tostring(self._requestId)
		local request = { RequestId = self._requestId, PredictionId = predictionId, Character = char, Generation = scope.Generation,
			SessionId = scope.SessionId, RoundId = scope.RoundId }
		local combo = Config.Combat.SlapCombo
		local toolConfig = tool:FindFirstChild("Configuration")
		local cooldown = toolConfig and toolConfig:FindFirstChild("SlapCooldown")
		local predictedDuration = if combo.Enabled then combo.SwingWindow + combo.MissRecovery
			else (cooldown and cooldown.Value or Config.Combat.SlapCooldown)
		self._predictionUntil = now + predictedDuration
		self._visualStart = now
		self._pending = { RequestId = request.RequestId, AttackId = predictionId,
			PredictionId = predictionId, Tool = tool, RequestTime = now }
		self._awaitingUntil = now + 2 -- Transport retry only, never grants a hit or animation.
		self:_trace("ClientRequest")
		if self._swingTrack then
			pcall(function()
				self._swingTrack.Looped = false
				if self._swingTrack.IsPlaying then self._swingTrack:Stop(0) end
				self._swingTrack:Play(0.05, 1, 1.2)
			end)
		end
		self:_trace("PredictionPlayed")
		remote:FireServer(tool, request)
	end
end

--------------------------------------------------------------------------------
-- Enlace de Personaje
--------------------------------------------------------------------------------

function SlapController:_bindCharacter(character: Model)
	self._backpackHidden = false
	for _, connection in ipairs(self._characterConnections) do connection:Disconnect() end
	self._characterConnections = {}
	self:_onToolUnequipped()
	self:_refreshScope()

	-- Detectar herramientas equipadas
	table.insert(self._characterConnections, character.ChildAdded:Connect(function(child)
		if localPlayer.Character ~= character then return end
		if child:IsA("Tool") then
			self:_onToolEquipped(child)
		end
	end))

	table.insert(self._characterConnections, character.ChildRemoved:Connect(function(child)
		if child == self._equippedTool then
			self:_onToolUnequipped()
		end
	end))
	table.insert(self._characterConnections, character:GetAttributeChangedSignal("ArenaPhysicsGeneration"):Connect(function()
		self:_onToolUnequipped()
		self:_refreshScope()
		if localPlayer.Character == character then
			for _, child in ipairs(character:GetChildren()) do
				if isSlapTool(child) then self:_onToolEquipped(child); break end
			end
		end
	end))
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		table.insert(self._characterConnections, humanoid.Died:Connect(function()
			if localPlayer.Character ~= character then return end
			self._pending = nil; self._awaitingUntil = 0
			self:_onToolUnequipped()
		end))
	end

	-- Si ya tenia una herramienta equipada al iniciar
	for _, child in ipairs(character:GetChildren()) do
		if child:IsA("Tool") then
			self:_onToolEquipped(child)
			break
		end
	end
end

--------------------------------------------------------------------------------
-- Ciclo de Vida Bootstrap
--------------------------------------------------------------------------------

function SlapController:Init(context: any)
	self._context = context
	if self._initialized then return end
	self._initialized = true
	self._connections = {}; self._characterConnections = {}
	self._requestId = 0; self._lastSequence = 0; self._scope = nil
	self._sessionId = nil; self._roundId = nil; self._roundIndex = 0; self._stateVersion = -1
	self._playing = false; self._roundClosed = false; self:_resetRecovery()
	self:_getPerformRemote()
 local combat=ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Combat")
 local feedback=combat:WaitForChild("SlapFeedback",10)
 if feedback and feedback:IsA("RemoteEvent") then
  table.insert(self._connections, feedback.OnClientEvent:Connect(function(data) self:_onFeedback(data) end))
 end
	local match = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Match")
	table.insert(self._connections, match:WaitForChild("StateChanged").OnClientEvent:Connect(function(state, data)
		self:_onMatchState(state, data)
	end))
	table.insert(self._connections, match:WaitForChild("Countdown").OnClientEvent:Connect(function(remaining, label, data)
		self:_onCountdown(remaining, label, data)
	end))
	table.insert(self._connections, localPlayer:GetAttributeChangedSignal("MatchId"):Connect(function()
		self:_refreshScope()
	end))
end

function SlapController:Start(context: any)
	self._context = context
	if self._started then return end
	self._started = true
	self:_hideNativeBackpack()
	local gui = localPlayer:FindFirstChildOfClass("PlayerGui")
	local hud = gui and gui:FindFirstChild("PlayerHUD")
	self._slotRoot = hud and hud:FindFirstChild("CombatSlots")
	if not self._slotRoot then warn("[SlapController] PlayerHUD.CombatSlots missing") end
	table.insert(self._connections, RunService.RenderStepped:Connect(function()
		if not self._slotRoot or not self._slotRoot.Parent then
			local playerGui = localPlayer:FindFirstChildOfClass("PlayerGui")
			local currentHUD = playerGui and playerGui:FindFirstChild("PlayerHUD")
			self._slotRoot = currentHUD and currentHUD:FindFirstChild("CombatSlots")
		end
		self:_renderSlot()
	end))

	if localPlayer.Character then
		self:_bindCharacter(localPlayer.Character)
	end

	table.insert(self._connections, localPlayer.CharacterAdded:Connect(function(char)
		self:_bindCharacter(char)
	end))

	print("[SlapController] Controlador de Slaps iniciado y listo (CombatSystemV132 Protocol=3)")
end

function SlapController:Destroy()
	for _, connection in ipairs(self._characterConnections) do connection:Disconnect() end
	for _, connection in ipairs(self._connections) do connection:Disconnect() end
	self._characterConnections = {}; self._connections = {}
	self:_onToolUnequipped()
	self:_resetRecovery()
	if self._slotRoot then self._slotRoot.Visible = false end
	self._slotRoot = nil
	if self._originalBackpackEnabled ~= nil then
		pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, self._originalBackpackEnabled) end)
	end
	self._backpackHidden = false; self._originalBackpackEnabled = nil
	self._initialized = false; self._started = false
end

return SlapController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1804">
          <Properties>
            <string name="Name">SocialController</string>
            <string name="Source"><![CDATA[--!nonstrict
local Players=game:GetService('Players')
local RS=game:GetService('ReplicatedStorage')
local RunService=game:GetService('RunService')
local UIS=game:GetService('UserInputService')
local Tween=game:GetService('TweenService')
local Config=require(RS.Shared.SocialConfig)
local Catalog=require(RS.Shared.SlapCrates.Catalog)
local Targeting=require(script.Parent.Parent.Social.Targeting)
local Viewports=require(script.Parent.Parent.Social.ViewportPool)
local player=Players.LocalPlayer
local Controller={Name='SocialController'}
local terminal={Cancelled=true,Completed=true,FailedRecoverable=true}
local reasons={TradeCommitDisabled='PRUEBA FINALIZADA: no se transfirió ningún Slap.',RateLimited='Esperá un momento antes de volver a intentar.',
 OutOfRange='El jugador está fuera del alcance.',PlayerUnavailable='Jugador no disponible o en partida.',PlayerBusy='Uno de los jugadores ya tiene una solicitud o trade.',
 InviteCooldown='Esperá antes de enviar otra invitación.',ItemNotTradable='Este artículo no es comerciable.',StaleRevision='La oferta cambió. Revisala nuevamente.',
 OffersLocked='La oferta está bloqueada durante la confirmación.',InvitationDeclined='Solicitud rechazada.',Expired='La solicitud o el trade expiró.',InvitationsDisabled='El jugador no recibe solicitudes.'}
local function text(reason)return reasons[reason]or tostring(reason or '')end
function Controller:Sound(gui,name)
 local folder=gui and gui:FindFirstChild('Audio');local sound=folder and folder:FindFirstChild(name)
 if self.LastSound and self.LastSound.IsPlaying then self.LastSound:Stop()end
 if sound and sound.SoundId~=''then sound:Play();self.LastSound=sound end
end
function Controller:Message(message)
 for _,gui in ipairs({self.Profile,self.Request,self.Trade})do if gui.Enabled then gui.MainFrame.Status.Text=message end end
end
function Controller:RequestAction(action,id,revision,value,callback)
 if self.PendingAction then return end
 self.PendingAction=true
 task.spawn(function()
  local ok,response=pcall(self.Action.InvokeServer,self.Action,action,id,revision,value)
  self.PendingAction=false
  if not ok or type(response)~='table'then self:Message('No se pudo contactar al servidor.');return end
  if not response.Ok then self:Sound(self.Trade.Enabled and self.Trade or self.Profile,'Error');self:Message(text(response.Reason))end
  if callback then callback(response)end
  if self.PendingInventoryPage then local page=self.PendingInventoryPage;self.PendingInventoryPage=nil;task.delay(.3,function()self:OwnPage(page)end)end
 end)
end
function Controller:ClearCards(container)
 for i=#self.Cards,1,-1 do local record=self.Cards[i]
  if record.Container==container then
   self.Pool:Remove(record.View)
   if record.Connection then record.Connection:Disconnect()end
   record.Card:Destroy();table.remove(self.Cards,i)
  end
 end
end
function Controller:RefreshPreviews()
 local live=0
 for _,entry in ipairs(self.Cards)do
  local s=entry.Container;local visible=entry.Gui.Enabled and s.Visible
  local pos,size=entry.Card.AbsolutePosition,entry.Card.AbsoluteSize;local p,z=s.AbsolutePosition,s.AbsoluteSize
  visible=visible and pos.Y+size.Y>p.Y and pos.Y<p.Y+z.Y and pos.X+size.X>p.X and pos.X<p.X+z.X
  if visible and live<Config.MaxActivePreviews-2 then
   if self.Pool:Slap(entry.View,entry.Item)then live+=1 end
  else self.Pool:Remove(entry.View)end
 end
end
function Controller:CardsFor(gui,container,items,mode)
 self:ClearCards(container)
 local template=gui.CardTemplate
 for index,item in ipairs(items)do
  local card=template:Clone();card.Name='Item_'..index;card.LayoutOrder=index;card.Visible=true
  card:FindFirstChild('ItemName').Text=item.DisplayName;card.Variation.Text=item.VariationName
  local variation=Catalog.Variations.ById[item.VariationId];local color=variation and variation.Color or Color3.new(1,1,1)
  card.Accent.Color=color;card.Variation.TextColor3=color
  card.Aura.BackgroundColor3=color;card.Preview.BackgroundTransparency=1
  card.Aura.Gradient.Color=ColorSequence.new(color,Color3.fromRGB(12,20,32))
  card.State.Text=(item.Equipped and 'EQUIPADO · 'or '')..(item.Tradable and (mode=='Add'and '+ OFRECER'or mode=='Remove'and 'RETIRAR'or 'COMERCIABLE')or 'NO COMERCIABLE')
  card.UnitId.Text=item.UnitId or 'Propiedad base · sin unidad comerciable';card.UnitId.TextSize=10
  card.Parent=container
  local connection=card.Activated:Connect(function()
   if mode and item.UnitId and self.CurrentTrade and (mode=='Remove'or item.Tradable)then
    local t=self.CurrentTrade;self:RequestAction(mode,t.TradeId,t.Revision,item.UnitId)
   end
   self:Sound(gui,'Click')
   Tween:Create(card.Accent,TweenInfo.new(.15),{Thickness=3}):Play()
  end)
  table.insert(self.Cards,{Card=card,View=card.Preview,Item=item,Container=container,Gui=gui,Connection=connection})
 end
 local grid=container:FindFirstChildOfClass('UIGridLayout')
 if grid then
  local columns=container.AbsoluteSize.X>=300 and 3 or container.AbsoluteSize.X>=185 and 2 or 1
  grid.CellSize=UDim2.new(1/columns,-8,0,180)
 end
end
function Controller:Show(gui)
 self.DisplayTokens[gui]=(self.DisplayTokens[gui]or 0)+1
 if self.Fades[gui]then self.Fades[gui]:Cancel();self.Fades[gui]:Destroy()end
 gui.Enabled=true;gui.MainFrame.GroupTransparency=1
 local fade=Tween:Create(gui.MainFrame,TweenInfo.new(.2),{GroupTransparency=0});self.Fades[gui]=fade;fade:Play();self:Sound(gui,'Open')
end
function Controller:Close(gui)
 self.DisplayTokens[gui]=(self.DisplayTokens[gui]or 0)+1;local token=self.DisplayTokens[gui]
 if self.Fades[gui]then self.Fades[gui]:Cancel();self.Fades[gui]:Destroy();self.Fades[gui]=nil end
 if gui.Enabled then
  self:Sound(gui,'Close')
  local fade=Tween:Create(gui.MainFrame,TweenInfo.new(.15),{GroupTransparency=1});self.Fades[gui]=fade;fade:Play()
  task.delay(.16,function()if self.DisplayTokens[gui]==token then gui.Enabled=false end end)
 end
 self.Generation+=1
 for _,entry in ipairs(self.Cards)do if entry.Gui==gui then self.Pool:Remove(entry.View)end end
 if gui==self.Profile then local summary=gui.MainFrame:FindFirstChild('Summary');if summary then self.Pool:Remove(summary.Equipped.Preview)end;self.ProfileData=nil;self.Pool:Remove(gui.MainFrame.Avatar);self.ProfileTarget=nil;self.ProfileMode=nil;self.NextSelfRefresh=nil end
 if gui==self.Request then self.Pool:Remove(gui.MainFrame.Avatar)end
 if gui==self.Trade then self.Pool:Remove(gui.MainFrame.Mine.Avatar);self.Pool:Remove(gui.MainFrame.Theirs.Avatar)end
 local containers={};for _,entry in ipairs(self.Cards)do if entry.Gui==gui then containers[entry.Container]=true end end
 for container in pairs(containers)do self:ClearCards(container)end
end
-- These existing windows own their own lifecycle; this controller never changes them.
function Controller:WindowBusy()
 local gui=player:FindFirstChild('PlayerGui')
 if not gui then return true end
 for _,name in ipairs({'ShopHUD','PremiumShopHUD','SettingsGUI','CrateOpeningHUD'})do
  local hud=gui:FindFirstChild(name)
  local main=hud and hud:FindFirstChild('MainFrame')
  if hud and hud.Enabled and (name=='CrateOpeningHUD'or main and main.Visible)then return true end
 end
 return self.Request.Enabled or self.Trade.Enabled
end
function Controller:SetArticlesMode(show)
 local m=self.Profile.MainFrame;local summary=m:FindFirstChild('Summary')
 if not summary then return end
 self.ArticlesVisible=show;summary.Visible=not show;m.Collection.Visible=show
 for _,name in ipairs({'Previous','Page','Next'})do m[name].Visible=show end
 m.Articles.Text=show and 'Volver al perfil'or 'Ver artículos'
 if not show then for _,entry in ipairs(self.Cards)do if entry.Gui==self.Profile then self.Pool:Remove(entry.View)end end end
end
function Controller:ProfileActions(data)
 local m=self.Profile.MainFrame;local own=data.UserId==player.UserId
 local target=Players:GetPlayerByUserId(data.UserId)
 local solo=not player:GetAttribute('SocialGroupId')and target and not target:GetAttribute('SocialGroupId')
 for _,entry in ipairs({{'Challenge',not own and solo and data.Actions and data.Actions.Challenge},{'Invite',not own and data.Actions and data.Actions.Invite}})do
  local button=m:FindFirstChild(entry[1]);if button then local enabled=entry[2]==true;button.Visible=enabled;button.Active=enabled;button.Selectable=enabled end
 end
 local articles=m:FindFirstChild('Articles')
 if articles then articles.Position=UDim2.new(.02,0,.87,0);articles.Size=UDim2.new(own and .96 or .225,0,.095,0)end
end
function Controller:ApplyProfile(data,refresh)
 if type(data)~='table'or player:GetAttribute('MatchId')or self:WindowBusy()then return false end
 local owner=Players:GetPlayerByUserId(data.UserId)
 local own=data.UserId==player.UserId
 if not owner or data.ProfileMode~=(own and 'SelfProfile'or 'OtherPlayerProfile')then return false end
 self.ProfileTarget=data.UserId;self.ProfileMode=data.ProfileMode
 self.ProfilePage=data.Page;self.ProfileHasNext=data.HasNext
 self.NextSelfRefresh=workspace:GetServerTimeNow()+Config.SelfProfileRefreshSeconds
 if not refresh then self:Show(self.Profile)end
 local m=self.Profile.MainFrame
 m.Trade.Visible=not own;m.Trade.Active=not own;m.Trade.Selectable=not own
 m.Trade.AutoButtonColor=not own
 self.ProfileData=data;self:ProfileActions(data)
 if not refresh then self:SetArticlesMode(false)end
 local summary=m:FindFirstChild('Summary')
 if summary then
  summary.Streak.Value.Text=tostring(data.Stats.Streaks or 0);summary.Wins.Value.Text=tostring(data.Stats.Wins);summary.Kills.Value.Text=tostring(data.Stats.TotalKills)
 end
 m.Identity.Text=data.DisplayName..'\n@'..data.Username
 m.Stats.Text=string.format('VICTORIAS %d\nDERROTAS %d\nKILLS %d',data.Stats.Wins,data.Stats.Losses,data.Stats.TotalKills)
 m.Progression.Text=data.Progression.Status..' · Derrotas '..tostring(data.Stats.Losses);m.Page.Text=string.format('%d · %d artículos',data.Page,data.TotalItems)
 m.Status.Text=''
 -- Keep the same avatar and card pool on unchanged refreshes (no rotation reset).
 if not refresh then self.Pool:Remove(m.Avatar);self.Pool:Add(m.Avatar,owner,true)end
 local fingerprint=game:GetService('HttpService'):JSONEncode(data.Inventory)
 if not refresh or self.ProfileInventoryFingerprint~=fingerprint then
  self.ProfileInventoryFingerprint=fingerprint
  self:CardsFor(self.Profile,m.Collection,data.Inventory,nil)
  if summary then
   local equipped;for _,item in ipairs(data.Inventory)do if item.Equipped then equipped=item;break end end
   self.Pool:Remove(summary.Equipped.Preview)
   if equipped then self.Pool:Slap(summary.Equipped.Preview,equipped);summary.Equipped.Caption.Text=equipped.DisplayName..' · '..equipped.VariationName
   else summary.Equipped.Caption.Text='Consultá Ver artículos para ver el Slap equipado'end
  end
 end
 return true
end
function Controller:OpenProfile(id,page,refresh)
 if self.PendingProfile or player:GetAttribute('MatchId')or self:WindowBusy()then return end
 local own=id==player.UserId
 self.PendingProfile=true;local generation=self.Generation
 task.spawn(function()
  local remote=own and self.SelfInspect or self.Inspect
  local ok,response
  if own then ok,response=pcall(remote.InvokeServer,remote,page)
  else ok,response=pcall(remote.InvokeServer,remote,id,page)end
  self.PendingProfile=false
  if generation~=self.Generation then return end
  if not ok or type(response)~='table'or not response.Ok then
   if refresh then
    self.NextSelfRefresh=workspace:GetServerTimeNow()+Config.RequestIntervalSeconds
    if type(response)=='table'and response.Reason~='RateLimited'then self:Close(self.Profile)end
   else self:Message(text(type(response)=='table'and response.Reason or 'Error de red'))end
   return
  end
  if response.Profile.UserId~=id then return end
  self:ApplyProfile(response.Profile,refresh)
 end)
end
function Controller:OpenSelfProfile()
 if self.Profile.Enabled and self.ProfileMode=='SelfProfile'then self:Close(self.Profile);return end
 self:OpenProfile(player.UserId,1)
end
function Controller:BindProfileButton(button)
 local base=button.BackgroundColor3
 table.insert(self.Connections,button.Activated:Connect(function()self:Sound(self.Profile,'Click');self:OpenSelfProfile()end))
 table.insert(self.Connections,button.MouseEnter:Connect(function()
  self:Sound(self.Profile,'Hover');Tween:Create(button,TweenInfo.new(.12),{BackgroundColor3=base:Lerp(Color3.fromRGB(70,160,195),.25)}):Play()
 end))
 table.insert(self.Connections,button.MouseLeave:Connect(function()Tween:Create(button,TweenInfo.new(.12),{BackgroundColor3=base}):Play()end))
end
function Controller:OwnPage(page)
 local t=self.CurrentTrade;if not t or terminal[t.State]then return end
 if self.PendingAction then self.PendingInventoryPage=page;return end
 self:RequestAction('Inventory',t.TradeId,t.Revision,page,function(response)
  if not response.Ok or not self.CurrentTrade or self.CurrentTrade.TradeId~=t.TradeId or terminal[self.CurrentTrade.State]then return end
  self.OwnPageNumber=response.Profile.Page;self.OwnHasNext=response.Profile.HasNext
  self.Trade.MainFrame.Page.Text='PÁGINA '..response.Profile.Page
  self:CardsFor(self.Trade,self.Trade.MainFrame.Mine.Inventory,response.Profile.Inventory,'Add')
 end)
end
function Controller:TradePacket(t)
 local previous=self.CurrentTrade
 if previous and previous.TradeId==t.TradeId and (t.Sequence or 0)<=(previous.Sequence or 0)then return end
 self.CurrentTrade=t
 if terminal[t.State]then
  self.Request.MainFrame.Requester.Text=text(t.Reason);self:Close(self.Request)
  if self.Trade.Enabled then self.Trade.MainFrame.Status.Text=text(t.Reason);self.Trade.MainFrame.Accept.Active=false;self.Trade.MainFrame.Confirm.Active=false;self:Sound(self.Trade,'Cancel')end
  self:Message(text(t.Reason));return
 end
 local uid=player.UserId;local mine=tostring(uid);local other=tostring(t.A==uid and t.B or t.A)
 if t.State=='Requested'then
  if t.B==uid then
   self:Show(self.Request);self.Request.MainFrame.Requester.Text=t.Names[tostring(t.A)]..' quiere intercambiar Slaps.'
   self.Request.MainFrame.Status.Text='Solo negociación: transferencias reales desactivadas.'
   self.Pool:Add(self.Request.MainFrame.Avatar,Players:GetPlayerByUserId(t.A),true)
  else self:Message('Solicitud enviada. Esperando respuesta.')end
  return
 end
 self:Close(self.Profile);self:Close(self.Request)
 if not self.Trade.Enabled then self:Show(self.Trade)end
 local m=self.Trade.MainFrame
 m.Mine.Identity.Text=t.Names[mine];m.Theirs.Identity.Text=t.Names[other]
 m.Mine.Accepted.Text=t.Accepted[mine]and 'OFERTA ACEPTADA'or 'REVISANDO'
 m.Theirs.Accepted.Text=t.Accepted[other]and 'OFERTA ACEPTADA'or 'REVISANDO'
 for _,entry in ipairs({{Label=m.Mine.Accepted,Accepted=t.Accepted[mine]},{Label=m.Theirs.Accepted,Accepted=t.Accepted[other]}})do
  Tween:Create(entry.Label,TweenInfo.new(.18),{TextColor3=entry.Accepted and Color3.fromRGB(110,235,160)or Color3.fromRGB(180,205,225)}):Play()
 end
 self:CardsFor(self.Trade,m.Mine.Offers,t.Offers[mine]or {},'Remove')
 self:CardsFor(self.Trade,m.Theirs.Offers,t.Offers[other]or {},nil)
 self.Pool:Add(m.Mine.Avatar,player,true);self.Pool:Add(m.Theirs.Avatar,Players:GetPlayerByUserId(tonumber(other)),true)
 m.Accept.Active=t.State=='Negotiating';m.Confirm.Active=t.State=='FinalConfirmation'
 m.Accept.AutoButtonColor=m.Accept.Active;m.Confirm.AutoButtonColor=m.Confirm.Active
 m.Status.Text=t.State=='FinalConfirmation'and 'REVISÁ LO QUE ENTREGÁS Y RECIBÍS. Confirmación individual obligatoria.'or 'NEGOCIACIÓN DE PRUEBA · NO TRANSFIERE OBJETOS'
 if not previous or previous.TradeId~=t.TradeId or previous.State=='Requested'then task.delay(.3,function()self:OwnPage(1)end)end
end
function Controller:SetTarget(target)
 if self.Target==target and (not target or self.Prompt and self.Prompt.Parent==target.Character:FindFirstChild('HumanoidRootPart'))then return end
 if self.PromptConnection then self.PromptConnection:Disconnect();self.PromptConnection=nil end
 if self.Prompt then self.Prompt:Destroy();self.Prompt=nil end
 if self.Highlight then self.Highlight:Destroy();self.Highlight=nil end
 self.Target=target
 if not target then return end
 local root=target.Character:FindFirstChild('HumanoidRootPart')
 local prompt=Instance.new('ProximityPrompt');prompt.Name='SocialProfilePrompt';prompt.ActionText='Ver perfil';prompt.ObjectText=target.DisplayName
 prompt.HoldDuration=Config.PromptHoldSeconds;prompt.MaxActivationDistance=Config.InspectDistance;prompt.RequiresLineOfSight=true
 prompt.KeyboardKeyCode=Enum.KeyCode.E;prompt.GamepadKeyCode=Enum.KeyCode.ButtonX;prompt.ClickablePrompt=true;prompt.Parent=root
 local highlight=Instance.new('Highlight');highlight.Name='SocialTargetHighlight';highlight.Adornee=target.Character
 highlight.FillTransparency=.85;highlight.OutlineColor=Color3.fromRGB(74,210,240);highlight.FillColor=highlight.OutlineColor
 highlight.DepthMode=Enum.HighlightDepthMode.Occluded;highlight.Parent=target.Character
 self.Prompt=prompt;self.Highlight=highlight
 self.PromptConnection=prompt.Triggered:Connect(function()self:OpenProfile(target.UserId)end)
end
function Controller:PollTarget()
 if self.Profile.Enabled or self.Request.Enabled or self.Trade.Enabled or player:GetAttribute('MatchId')then self:SetTarget(nil);return end
 local camera=workspace.CurrentCamera;if not camera then self:SetTarget(nil);return end
 local point=UIS:GetMouseLocation();local ray
 if UIS.TouchEnabled or UIS.GamepadEnabled then ray=camera:ViewportPointToRay(camera.ViewportSize.X/2,camera.ViewportSize.Y/2)
 else ray=camera:ScreenPointToRay(point.X,point.Y)end
 local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude;params.FilterDescendantsInstances=player.Character and {player.Character}or {}
 local hit=workspace:Raycast(ray.Origin,ray.Direction*200,params)
 local target=hit and Targeting.FromHit(Players,hit.Instance)
 self:SetTarget(Targeting.Valid(player,target,Config.InspectDistance)and target or nil)
end
function Controller:Init(context)
 if self.Initialized then return end
 self.Initialized=true;self.Context=context
 self.Generation=0;self.Cards={};self.Connections={};self.DisplayTokens={};self.Fades={};self.Pool=Viewports.new(Config.MaxActivePreviews)
 local gui=player:WaitForChild('PlayerGui')
 self.Profile=gui:WaitForChild('PlayerProfileHUD',15);self.Request=gui:WaitForChild('TradeRequestHUD',15);self.Trade=gui:WaitForChild('TradeHUD',15)
 assert(self.Profile and self.Request and self.Trade,'Social HUDs missing in Edit')
 local remotes=RS:WaitForChild('Remotes'):WaitForChild('Social');self.SelfInspect=remotes:WaitForChild('SelfProfile');self.Inspect=remotes:WaitForChild('Inspect');self.Action=remotes:WaitForChild('Action');self.Update=remotes:WaitForChild('Updated')
 for _,hud in ipairs({self.Profile,self.Request,self.Trade})do
  hud.Enabled=false
  for _,button in ipairs(hud:GetDescendants())do if button:IsA('TextButton')then
   local base=button.BackgroundColor3
   table.insert(self.Connections,button.MouseEnter:Connect(function()self:Sound(hud,'Hover');Tween:Create(button,TweenInfo.new(.12),{BackgroundColor3=base:Lerp(Color3.fromRGB(70,160,195),.25)}):Play()end))
   table.insert(self.Connections,button.MouseLeave:Connect(function()Tween:Create(button,TweenInfo.new(.12),{BackgroundColor3=base}):Play()end))
  end end
 end
 self:BindProfileButton(gui:WaitForChild('PlayerHUD'):WaitForChild('ProfileButton',15))
 local function connect(button,fn)table.insert(self.Connections,button.Activated:Connect(fn))end
 local articles=self.Profile.MainFrame:FindFirstChild('Articles')
 if articles then connect(articles,function()self:Sound(self.Profile,'Click');self:SetArticlesMode(not self.ArticlesVisible)end)end
 for _,entry in ipairs({{'Challenge','Duel'},{'Invite','Group'}})do
  local button=self.Profile.MainFrame:FindFirstChild(entry[1])
  if button then connect(button,function()
   if button.Active and self.ProfileMode=='OtherPlayerProfile'and self.ProfileTarget~=player.UserId then
    local play=self.Context and self.Context:GetController('SocialPlayController')
    if play then self:Sound(self.Profile,'Click');play:Invite(entry[2],self.ProfileTarget)end
   end
  end)end
 end
 connect(self.Profile.MainFrame.Close,function()self:Close(self.Profile)end)
 connect(self.Profile.MainFrame.Previous,function()if (self.ProfilePage or 1)>1 then self:OpenProfile(self.ProfileTarget,self.ProfilePage-1)end end)
 connect(self.Profile.MainFrame.Next,function()if self.ProfileHasNext then self:OpenProfile(self.ProfileTarget,self.ProfilePage+1)end end)
 connect(self.Profile.MainFrame.Trade,function()if self.ProfileMode=='OtherPlayerProfile'and self.ProfileTarget and self.ProfileTarget~=player.UserId and self.Profile.MainFrame.Trade.Active then self:RequestAction('Invite',self.ProfileTarget)end end)
 local function act(name,value)local t=self.CurrentTrade;if t then self:RequestAction(name,t.TradeId,t.Revision,value)end end
 connect(self.Request.MainFrame.Accept,function()self:Sound(self.Request,'Accept');act('Respond',true)end)
 connect(self.Request.MainFrame.Decline,function()act('Respond',false)end)
 connect(self.Request.MainFrame.Close,function()act('Respond',false)end)
 connect(self.Trade.MainFrame.Close,function()if self.CurrentTrade and terminal[self.CurrentTrade.State]then self:Close(self.Trade)else act('Cancel')end end)
 connect(self.Trade.MainFrame.Cancel,function()if self.CurrentTrade and terminal[self.CurrentTrade.State]then self:Close(self.Trade)else act('Cancel')end end)
 connect(self.Trade.MainFrame.Accept,function()self:Sound(self.Trade,'Accept');act('Accept')end)
 connect(self.Trade.MainFrame.Confirm,function()self:Sound(self.Trade,'Confirm');act('Confirm')end)
 connect(self.Trade.MainFrame.Previous,function()if (self.OwnPageNumber or 1)>1 then self:OwnPage(self.OwnPageNumber-1)end end)
 connect(self.Trade.MainFrame.Next,function()if self.OwnHasNext then self:OwnPage(self.OwnPageNumber+1)end end)
end
function Controller:Start()
 if self.Started then return end
 self.Started=true
 if not self.Update or not self.Profile or not self.Request or not self.Trade then warn('[Social] Init incomplete; controller disabled');return end
 table.insert(self.Connections,self.Update.OnClientEvent:Connect(function(kind,payload)
  if kind=='Trade'then self:TradePacket(payload)
  elseif kind=='ProfileUnavailable'and self.ProfileTarget==payload.UserId then self:Close(self.Profile)end
 end))
 local function closeAll()self:SetTarget(nil);for _,hud in ipairs({self.Profile,self.Request,self.Trade})do self:Close(hud)end;self.Pool:Clear()end
 table.insert(self.Connections,player:GetAttributeChangedSignal('MatchId'):Connect(function()if player:GetAttribute('MatchId')then closeAll()end end))
 table.insert(self.Connections,player.CharacterRemoving:Connect(closeAll))
 table.insert(self.Connections,Players.PlayerRemoving:Connect(function(p)if self.ProfileTarget==p.UserId then self:Close(self.Profile)end;if self.Target==p then self:SetTarget(nil)end end))
 local dataUpdated=RS:WaitForChild('Remotes'):WaitForChild('Player'):WaitForChild('DataUpdated')
 table.insert(self.Connections,dataUpdated.OnClientEvent:Connect(function()
  -- Invalidation only; never render the client's private cached inventory.
  if self.ProfileMode=='SelfProfile'then self.NextSelfRefresh=workspace:GetServerTimeNow()+Config.RequestIntervalSeconds end
 end))
 local gui=player:WaitForChild('PlayerGui')
 for _,name in ipairs({'ShopHUD','PremiumShopHUD','SettingsGUI','CrateOpeningHUD'})do
  local hud=gui:FindFirstChild(name);local main=hud and hud:FindFirstChild('MainFrame')
  if main then
   local function changed()if self.ProfileTarget and self:WindowBusy()then self:Close(self.Profile)end end
   table.insert(self.Connections,main:GetPropertyChangedSignal('Visible'):Connect(changed))
   table.insert(self.Connections,hud:GetPropertyChangedSignal('Enabled'):Connect(changed))
  end
 end
 local elapsed=0
 table.insert(self.Connections,RunService.RenderStepped:Connect(function(dt)
  self.Pool:Step(dt);elapsed+=dt
  if elapsed<Config.AimPollSeconds then return end;elapsed=0
  self:PollTarget();self:RefreshPreviews();if self.ProfileData then self:ProfileActions(self.ProfileData)end
  if self.ProfileTarget and self:WindowBusy()then self:Close(self.Profile)end
  if self.ProfileTarget and self.Profile.Enabled and workspace:GetServerTimeNow()>=(self.NextSelfRefresh or math.huge)then
   self:OpenProfile(self.ProfileTarget,self.ProfilePage,true)
  end
  local t=self.CurrentTrade
  if t and not terminal[t.State]then
   local now=workspace:GetServerTimeNow()
   if t.State=='Requested'then self.Request.MainFrame.Countdown.Text='Expira en '..math.max(0,math.ceil(t.ExpiresAt-now))..' s'
   elseif t.State=='SafetyCountdown'then self.Trade.MainFrame.Status.Text='SEGURIDAD: '..math.max(0,math.ceil(t.Deadline-now))..' s · NO TRANSFIERE OBJETOS'end
  end
 end))
end
function Controller:Destroy()
 self.Initialized=false;self.Started=false;self.Generation+=1;self:SetTarget(nil);self.Pool:Clear()
 for _,c in ipairs(self.Connections or {})do c:Disconnect()end;self.Connections={}
 for _,hud in ipairs({self.Profile,self.Request,self.Trade})do self:Close(hud)end
end
return Controller
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1805">
          <Properties>
            <string name="Name">SocialPlayController</string>
            <string name="Source"><![CDATA[--!nonstrict
local Players=game:GetService('Players')
local RS=game:GetService('ReplicatedStorage')
local Run=game:GetService('RunService')
local player=Players.LocalPlayer
local Controller={Name='SocialPlayController'}
local reasons={InGroup='El desafío requiere que ambos estén sin grupo.',AlreadyGrouped='Ese jugador ya tiene grupo.',GroupUnavailable='Solo el líder puede invitar y debe haber espacio.',GroupChanged='El grupo cambió. Enviá otra invitación.',GroupBusy='Salgan de la cola/partida antes de modificar el grupo.',NotLeader='Solo el líder puede disolver el grupo.',PlayerUnavailable='Jugador no disponible o en cola/partida.',OutOfRange='Acercate al jugador.',InviteCooldown='Esperá antes de enviar otra solicitud.',RoundUnavailable='Hay una partida en curso. Intentá nuevamente después.',Expired='La solicitud expiró.',Declined='Solicitud rechazada.',Accepted='Solicitud aceptada.',RateLimited='Esperá un momento.',InvalidRequest='Solicitud no válida.',DuelStartFailed='No se pudo iniciar el desafío.'}
function Controller:Notice(reason)
 if not self.Hud then return end
 self.NoticeToken=(self.NoticeToken or 0)+1;local token=self.NoticeToken
 self.Hud.Notice.Text=reasons[reason]or tostring(reason or '')
 self.Hud.Notice.Visible=true
 task.delay(4,function()if self.NoticeToken==token then self.Hud.Notice.Visible=false end end)
end
function Controller:Send(action,id,value,callback)
 if self.Pending then return end;self.Pending=true
 task.spawn(function()
  local ok,response=pcall(self.Remote.InvokeServer,self.Remote,action,id,value)
  self.Pending=false
  if not ok or type(response)~='table'then self:Notice('DuelStartFailed');return end
  if not response.Ok then self:Notice(response.Reason)end
  if callback then callback(response)end
 end)
end
function Controller:Invite(kind,target)
 if target==player.UserId or player:GetAttribute('MatchId')then return end
 if kind=='Duel'and (player:GetAttribute('SocialGroupId')or target and Players:GetPlayerByUserId(target)and Players:GetPlayerByUserId(target):GetAttribute('SocialGroupId'))then return end
 self:Send(kind,target)
end
function Controller:RenderGroup(group)
 self.Group=group;local panel=self.Hud.GroupPanel
 panel.Visible=group~=nil and not player:GetAttribute('MatchId')
 if not group then return end
 local names={};for _,member in ipairs(group.Members)do table.insert(names,(member.UserId==group.Leader and '★ 'or '')..member.DisplayName)end
 panel.Members.Text='GRUPO '..#group.Members..'/4\n'..table.concat(names,' · ')
 panel.Disband.Visible=group.Leader==player.UserId;panel.Disband.Active=panel.Disband.Visible
end
function Controller:Init(context)
 if self.Initialized then return end;self.Initialized=true
 self.Context=context;self.Connections={};self.Hud=player:WaitForChild('PlayerGui'):WaitForChild('SocialPlayHUD',15)
 assert(self.Hud,'SocialPlayHUD missing in Edit')
 local folder=RS:WaitForChild('Remotes'):WaitForChild('SocialPlay')
 self.Remote=folder:WaitForChild('Request');self.Updated=folder:WaitForChild('Updated')
 self.Hud.Enabled=true;self.Hud.RequestPanel.Visible=false;self.Hud.GroupPanel.Visible=false;self.Hud.Notice.Visible=false
 local function bind(button,fn)table.insert(self.Connections,button.Activated:Connect(fn))end
 bind(self.Hud.RequestPanel.Accept,function()if self.Request then self:Send('Respond',self.Request.Id,true)end end)
 bind(self.Hud.RequestPanel.Decline,function()if self.Request then self:Send('Respond',self.Request.Id,false)end end)
 bind(self.Hud.GroupPanel.Leave,function()self:Send('Leave')end)
 bind(self.Hud.GroupPanel.Disband,function()self:Send('Disband')end)
end
function Controller:Start()
 if self.Started or not self.Updated then return end;self.Started=true
 table.insert(self.Connections,self.Updated.OnClientEvent:Connect(function(kind,data)
  if kind=='Group'then self:RenderGroup(data)
  elseif kind=='Request'then
   self.Request=data;local incoming=data.To==player.UserId
   local panel=self.Hud.RequestPanel;panel.Visible=true
   panel.Message.Text=incoming and (data.FromName..(data.Kind=='Duel'and ' te desafía a un 1v1.'or ' te invita a su grupo.'))or ('Solicitud enviada a '..data.ToName)
   panel.Accept.Visible=incoming;panel.Accept.Active=incoming;panel.Decline.Visible=incoming;panel.Decline.Active=incoming
  elseif kind=='RequestClosed'then
   if self.Request and self.Request.Id==data.Id then self.Request=nil;self.Hud.RequestPanel.Visible=false;self:Notice(data.Reason)end
  elseif kind=='Notice'then self:Notice(data.Reason)end
 end))
 table.insert(self.Connections,player:GetAttributeChangedSignal('MatchId'):Connect(function()
  self:RenderGroup(self.Group)
  if player:GetAttribute('MatchId')then self.Hud.RequestPanel.Visible=false end
 end))
 table.insert(self.Connections,Run.RenderStepped:Connect(function()
  local req=self.Request
  if req then
   self.Hud.RequestPanel.Countdown.Text=math.max(0,math.ceil(req.ExpiresAt-workspace:GetServerTimeNow()))..' s'
   if workspace:GetServerTimeNow()>=req.ExpiresAt then self.Hud.RequestPanel.Visible=false;self.Request=nil end
  end
 end))
 self:Send('State',nil,nil,function(response)if response.Ok then self:RenderGroup(response.Group)end end)
end
function Controller:Destroy()
 for _,c in ipairs(self.Connections or {})do c:Disconnect()end
 self.Connections={};self.Started=false;self.Initialized=false;self.NoticeToken=(self.NoticeToken or 0)+1
 if self.Hud then self.Hud.Enabled=false end
end
return Controller
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1806">
          <Properties>
            <string name="Name">SuddenDeathController</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Local-only additive colour correction; never edits the server or base Lighting.
local Players=game:GetService("Players")
local Lighting=game:GetService("Lighting")
local TweenService=game:GetService("TweenService")
local Config=require(game.ReplicatedStorage.Shared.Config)
local Controller={Name="SuddenDeathController"}
function Controller:Init(context)
 self._context=context;self._roundIndex=0;self._active=false;self._epoch=0
 self._connections={}
end
function Controller:_set(active,restoreArena)
 if self._active==active then return end
 self._active=active;self._epoch+=1
 local epoch=self._epoch
 local settings=Config.SuddenDeathPresentation
 local hud=Players.LocalPlayer.PlayerGui:FindFirstChild("SuddenDeathHUD")
 if hud then local label=hud:FindFirstChild("Notice");if label then label.Visible=active end end
 local music=self._context:GetController("MusicController")
 local match=self._context:GetController("MatchController")
 if music then music:SetSuddenDeath(active,match and match:GetCurrentSelectedMap(),restoreArena) end
 if self._tween then self._tween:Cancel();self._tween:Destroy();self._tween=nil end
 if active then
  if not self._effect then
   local assets=game.ReplicatedStorage:FindFirstChild("UIAssets")
   local folder=assets and assets:FindFirstChild("SuddenDeathAssets")
   local source=folder and folder:FindFirstChild("RedCorrection")
   if not source then warn("[SuddenDeath] Physical RedCorrection missing");return end
   self._effect=source:Clone()
   self._effect.Name="LocalSuddenDeathCorrection"
   self._effect.Enabled=true;self._effect.Brightness=0;self._effect.Contrast=0
   self._effect.Saturation=0;self._effect.TintColor=Color3.new(1,1,1)
   self._effect.Parent=Lighting
  end
  self._tween=TweenService:Create(self._effect,TweenInfo.new(settings.TransitionDuration),
   {Brightness=settings.Brightness,Contrast=settings.Contrast,Saturation=settings.Saturation,TintColor=settings.TintColor})
  self._tween:Play()
 elseif self._effect then
  local effect=self._effect
  local tween=TweenService:Create(effect,TweenInfo.new(settings.TransitionDuration),
   {Brightness=0,Contrast=0,Saturation=0,TintColor=Color3.new(1,1,1)})
  self._tween=tween
  tween.Completed:Connect(function()
   if self._epoch==epoch and not self._active and self._effect==effect then effect:Destroy();self._effect=nil end
  end)
  tween:Play()
 end
end
function Controller:Start(context)
 local player=Players.LocalPlayer
 local match=context:GetController("MatchController")
 local remotes=game.ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Match")
 table.insert(self._connections,remotes.Countdown.OnClientEvent:Connect(function(_,label,data)
  if label~="PLAYING" or type(data)~="table" or data.SessionId~=match:GetCurrentMatchId()
   or player:GetAttribute("MatchId")~=data.SessionId or not match:IsParticipant()
   or data.StateVersion~=match:GetCurrentStateVersion() then return end
  if self._sessionId~=data.SessionId then self._sessionId=data.SessionId;self._roundIndex=0 end
  if type(data.RoundIndex)~="number" or data.RoundIndex<self._roundIndex then return end
  self._roundIndex=data.RoundIndex
  self:_set(data.SuddenDeath==true and not data.Resolved,true)
 end))
 table.insert(self._connections,remotes.StateChanged.OnClientEvent:Connect(function(state,data)
  if type(data)=="table" and data.SessionId==self._sessionId and state~="Playing"
   and type(data.StateVersion)=="number" and data.StateVersion>=match:GetCurrentStateVersion() then
   self:_set(false,state=="PointRestartCountdown")
  end
 end))
 table.insert(self._connections,player:GetAttributeChangedSignal("MatchId"):Connect(function()
  if player:GetAttribute("MatchId")~=self._sessionId then self:_set(false,false);self._sessionId=nil;self._roundIndex=0 end
 end))
end
return Controller
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="1807">
