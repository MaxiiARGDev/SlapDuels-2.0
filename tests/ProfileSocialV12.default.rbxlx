local function countSessions(sessionsById: { [SessionId]: MatchSession }): number
	local count = 0
	for _ in pairs(sessionsById) do
		count += 1
	end
	return count
end

local VALID_TRANSITIONS: { [RoundStateName]: { [RoundStateName]: boolean } } = {
	[Constants.RoundState.Waiting] = {
		[Constants.RoundState.MatchReady] = true,
		[Constants.RoundState.ReturningToLobby] = true,
	},
	[Constants.RoundState.MatchReady] = {
		[Constants.RoundState.MatchCountdown] = true,
		[Constants.RoundState.ReturningToLobby] = true,
	},
	[Constants.RoundState.MatchCountdown] = {
		[Constants.RoundState.MapSelection] = true,
		[Constants.RoundState.ReturningToLobby] = true,
	},
	[Constants.RoundState.MapSelection] = {
		[Constants.RoundState.MapLoading] = true,
		[Constants.RoundState.ReturningToLobby] = true,
	},
	[Constants.RoundState.MapLoading] = {
		[Constants.RoundState.StartCountdown] = true,
		[Constants.RoundState.ReturningToLobby] = true,
	},
	[Constants.RoundState.StartCountdown] = {
		[Constants.RoundState.Playing] = true,
		[Constants.RoundState.ReturningToLobby] = true,
	},
	[Constants.RoundState.Playing] = {
		[Constants.RoundState.PointRestartCountdown] = true,
		[Constants.RoundState.Ending] = true,
		[Constants.RoundState.ReturningToLobby] = true,
	},
	[Constants.RoundState.PointRestartCountdown] = {
		[Constants.RoundState.Playing] = true,
		[Constants.RoundState.Ending] = true,
		[Constants.RoundState.ReturningToLobby] = true,
	},
	[Constants.RoundState.Ending] = {
		[Constants.RoundState.ReturningToLobby] = true,
	},
	[Constants.RoundState.ReturningToLobby] = {},
}

function RoundService:GetSession(sessionId: SessionId?): MatchSession?
	if sessionId then
		return self._sessionsById[sessionId]
	end
	if countSessions(self._sessionsById) ~= 1 then
		return nil
	end
	for _, session in pairs(self._sessionsById) do
		return session
	end
	return nil
end

function RoundService:GetActiveSessions(): { MatchSession }
	local list = {}
	for _, session in pairs(self._sessionsById) do
		if self:_isRegisteredSession(session) then
			table.insert(list, session)
		end
	end
	return list
end

function RoundService:GetState(): RoundStateName
	local session = self:GetSession()
	return if session then session.State else Constants.RoundState.Waiting
end

function RoundService:GetSessionById(sessionId: SessionId): MatchSession?
	return self._sessionsById[sessionId]
end

function RoundService:GetSessionState(sessionId: SessionId): RoundStateName?
	local session = self._sessionsById[sessionId]
	return if session then session.State else nil
end

function RoundService:IsSessionActive(sessionId: SessionId): boolean
	local session = self._sessionsById[sessionId]
	return session ~= nil
		and self:_isRegisteredSession(session)
end

-- Temporary performance counters only. Called from already accepted scoring/elimination events.
function RoundService:RecordMatchPerformance(sessionId: SessionId, eventId: string, scorer: Player?, killer: Player?, victim: Player?): boolean
	local session = self._sessionsById[sessionId]
	if not session or not self:IsSessionActive(sessionId) or session.GameplayFrozen
		or (session.State ~= Constants.RoundState.Playing and session.State ~= Constants.RoundState.PointRestartCountdown) then return false end
	local updates = {}
	if scorer then table.insert(updates, { Player = scorer, Metric = "Goals" }) end
	if killer and victim then
		table.insert(updates, { Player = killer, Metric = "Kills" })
		table.insert(updates, { Player = victim, Metric = "Deaths" })
	end
	if #updates == 0 then return false end
	for _, update in ipairs(updates) do
		local participant = self:GetSessionParticipant(sessionId, update.Player)
		if not participant or not participant.MatchStats then return false end
		update.Participant = participant
	end
	session.MatchStatEvents = session.MatchStatEvents or {}
	if session.MatchStatEvents[eventId] then return false end
	session.MatchStatEvents[eventId] = true
	for _, update in ipairs(updates) do update.Participant.MatchStats[update.Metric] += 1 end
	return true
end

function RoundService:CaptureCinematicRanking(session: MatchSession): any
	local rows = {}
	for _, participant in ipairs(session.Participants) do
		local player, stats = participant.Player, participant.MatchStats
		table.insert(rows, { UserId = participant.UserId, DisplayName = player.DisplayName or player.Name,
			Username = player.Name, Team = participant.Team, CompetitiveSlot = participant.Slot,
			DescriptionKey = tostring(participant.UserId), Goals = stats and stats.Goals,
			Kills = stats and stats.Kills, Deaths = stats and stats.Deaths })
	end
	return CinematicRanking.Build(rows, session.Result, session.Mode,
		{ SessionId = session.Id, StateVersion = session.StateVersion })
end

function RoundService:GetSessionParticipant(sessionId: SessionId, player: Player): SessionParticipant?
	if not player then return nil end
	local session = self._sessionsById[sessionId]
	if not session or not self:_isRegisteredSession(session) then
		return nil
	end
	if self._sessionIdByUserId[player.UserId] ~= sessionId then
		return nil
	end
	local participant = self._participantByPlayer[player]
	if not participant or participant.UserId ~= player.UserId then
		return nil
	end
	if participant.State == "Left" or participant.State == "Released" then
		return nil
	end
	local isReal = typeof(player) == "Instance" and player:IsA("Player")
	local isSimulated = typeof(player) == "table" and (player :: any).IsSimulatedPlayer == true
	if isReal and player.Parent ~= Players then
		return nil
	end
	if isSimulated and (player :: any).IsConnected == false then
		return nil
	end
	return participant
end

function RoundService:_getSessionRecipients(session: MatchSession): { Player }
	local recipients: { Player } = {}
	for _, participant in ipairs(session.Participants) do
		local player = participant.Player
		if player.Parent == Players
			and participant.State ~= "Left"
			and participant.State ~= "Released"
			and self._sessionsById[session.Id] == session
			and self._participantByPlayer[player] == participant
			and self._sessionIdByUserId[participant.UserId] == session.Id then
			table.insert(recipients, player)
		end
	end
	return recipients
end

function RoundService:_applySessionIdentity(session: MatchSession, payload: any?): any
	local data = if type(payload) == "table" then table.clone(payload) else {}
	data.SessionId = session.Id
	data.MatchId = session.Id
	data.StateVersion = session.StateVersion
	local participantUserIds: { number } = {}
	local participantTeams: { [number]: string } = {}
	for _, participant in ipairs(session.Participants) do
		table.insert(participantUserIds, participant.UserId)
		participantTeams[participant.UserId] = participant.Team
	end
	data.ParticipantUserIds = participantUserIds
	data.ParticipantTeams = participantTeams
	return data
end

function RoundService:FireSessionRemote(sessionId: SessionId, folderName: string, eventName: string, ...: any): number
	local session = self._sessionsById[sessionId]
	if not session or session.Closed then return 0 end
	local remote = self:_getRemote(folderName, eventName)
	if not remote then return 0 end
	local sent = 0
	local args = table.pack(...)
	for _, player in ipairs(self:_getSessionRecipients(session)) do
		local ok = pcall(function()
			remote:FireClient(player, table.unpack(args, 1, args.n))
		end)
		if ok then sent += 1 end
	end
	return sent
end

function RoundService:_isRegisteredSession(session: MatchSession): boolean
	return self._sessionsById[session.Id] == session
		and not session.Closing
		and not session.Cancelled
		and not session.Closed
end

function RoundService:SetSessionState(sessionId: SessionId, newState: RoundStateName, extraData: any?, allowClosing: boolean?): boolean
	local session = self._sessionsById[sessionId]
	if not session or self._sessionsById[sessionId] ~= session or session.Closed then
		return false
	end
	if session.Closing and not allowClosing then
		return false
	end
	if session.GameplayFrozen and newState ~= Constants.RoundState.Ending and newState ~= Constants.RoundState.ReturningToLobby then
		return false
	end

	local allowed = VALID_TRANSITIONS[session.State]
	if not allowed or not allowed[newState] then
		return false
	end

	session.State = newState
	session.StateVersion += 1
	self._state = newState -- Adaptador temporal para consumidores 1v1 existentes.
	print(string.format("[RoundService] Estado de sesión '%s' cambiado a: %s (v%d)", sessionId, newState, session.StateVersion))

	local payload = self:_applySessionIdentity(session, extraData)
	self:FireSessionRemote(sessionId, "Match", "StateChanged", newState, payload)
	return true
end

function RoundService:GetRegisteredSessionCount(): number
	return countSessions(self._sessionsById)
end

function RoundService:GetSessionIdForUserId(userId: number): SessionId?
	return self._sessionIdByUserId[userId]
end

function RoundService:GetSessionForUserId(userId: number): MatchSession?
	local sessionId = self:GetSessionIdForUserId(userId)
	return if sessionId then self:GetSessionById(sessionId) else nil
end

function RoundService:GetParticipantForPlayer(player: Player): SessionParticipant?
	return self._participantByPlayer[player]
end

function RoundService:GetSessionForPlayer(player: Player): MatchSession?
	if not player then return nil end
	local sessionId = self._sessionIdByUserId[player.UserId]
	return if sessionId then self._sessionsById[sessionId] else nil
end

function RoundService:_unregisterParticipant(participant: SessionParticipant, sessionId: SessionId)
	local player = participant.Player
	if self._participantByPlayer[player] == participant then
		self._participantByPlayer[player] = nil
	end
	if self._sessionIdByUserId[participant.UserId] == sessionId then
		self._sessionIdByUserId[participant.UserId] = nil
	end
end

function RoundService:_releaseSession(session: MatchSession)
	session.Closing = true
	session.Votes = {}
	session.RemainingTime = nil
	for _, participant in ipairs(session.Participants) do
		self:_unregisterParticipant(participant, session.Id)
		participant.State = "Released"
	end

	if self._sessionsById[session.Id] == session then
		self._sessionsById[session.Id] = nil
	end
	if self._currentSession == session then
		self._currentSession = nil
	end
	session.Closed = true
	self._closedSessionIds[session.Id] = true
end

function RoundService:_registerSession(session: MatchSession): (boolean, string?)
	if countSessions(self._sessionsById) >= self._maxConcurrentSessions then
		return false, "ConcurrentSessionLimitReached"
	end
	if self._sessionsById[session.Id] then
		return false, "DuplicateSessionId"
	end

	local playersSeen: { [any]: boolean } = {}
	local userIdsSeen: { [number]: boolean } = {}
	for _, participant in ipairs(session.Participants) do
		local player = participant.Player
		local isReal = typeof(player) == "Instance" and player:IsA("Player")
		local isSim = typeof(player) == "table" and (player :: any).IsSimulatedPlayer == true
		if not isReal and not isSim then
			return false, "InvalidParticipant"
		end
		if isReal and (player.Parent ~= Players and not player:IsDescendantOf(Players)) then
			return false, "ParticipantDisconnected"
		end
		if isSim and (player :: any).IsConnected == false then
			return false, "ParticipantDisconnected"
		end
		if player.UserId ~= participant.UserId then
			return false, "ParticipantUserIdMismatch"
		end
		if playersSeen[player] or userIdsSeen[participant.UserId] then
			return false, "DuplicateParticipant"
		end
		if self._participantByPlayer[player] or self._sessionIdByUserId[participant.UserId] then
			return false, "ParticipantAlreadyRegistered"
		end
		playersSeen[player] = true
		userIdsSeen[participant.UserId] = true
	end

	-- Las validaciones terminan antes de la primera escritura. El rollback mantiene
	-- la admisión atómica incluso si una futura extensión añade una operación falible.
	local registered: { SessionParticipant } = {}
	local ok, err = pcall(function()
		self._sessionsById[session.Id] = session
		for _, participant in ipairs(session.Participants) do
			table.insert(registered, participant)
			self._participantByPlayer[participant.Player] = participant
			self._sessionIdByUserId[participant.UserId] = session.Id
		end
	end)
	if not ok then
		for _, participant in ipairs(registered) do
			self:_unregisterParticipant(participant, session.Id)
		end
		self._sessionsById[session.Id] = nil
		return false, string.format("AdmissionWriteFailed:%s", tostring(err))
	end

	return true, nil
end

function RoundService:IsModePlayable(mode: string): boolean
	if Config.Round and (Config.Round :: any).PlayableModes then
		return (Config.Round :: any).PlayableModes[mode] == true
	end
	return mode == "1v1"
end

-- Conserva el UserId original. Los IDs negativos existen únicamente en los
-- clientes locales de Studio; producción exige IDs estrictamente positivos.
function RoundService:_isParticipantUserIdValid(userId: any, studioOverride: boolean?): boolean
	if typeof(userId) ~= "number" or userId ~= userId or userId == math.huge or userId == -math.huge then
		return false
	end
	local isStudio = if studioOverride ~= nil then studioOverride else RunService:IsStudio()
	return if isStudio then userId ~= 0 else userId > 0
end

function RoundService:AdmitSession(
	requestOrRedPlayers: any,
	bluePlayers: { Player }?,
	mode: string?,
	zoneId: string?,
	reservationToken: string?
): (MatchSession?, string?)
	local request: Types.TeamMatchAdmissionRequest
	if type(requestOrRedPlayers) == "table" and (requestOrRedPlayers.RedTeam ~= nil or requestOrRedPlayers.Mode ~= nil) then
		request = requestOrRedPlayers
	else
		request = {
			ZoneId = zoneId or "1v1",
			Mode = mode or "1v1",
			TeamSize = (type(requestOrRedPlayers) == "table" and #requestOrRedPlayers) or 1,
			RedTeam = requestOrRedPlayers,
			BlueTeam = bluePlayers or {},
			ReservationToken = reservationToken,
		}
	end

	if type(request) ~= "table" then
		return nil, "InvalidRequest"
	end

	local reqMode = request.Mode
	if type(reqMode) ~= "string" or reqMode == "" then
		return nil, "InvalidMode"
	end

	local modeConfig = Config.Matchmaking and Config.Matchmaking.Modes and Config.Matchmaking.Modes[reqMode]
	if not modeConfig then
		return nil, "UnknownMode"
	end

	local expectedTeamSize = modeConfig.TeamSize
	local teamSize = request.TeamSize or expectedTeamSize
	if teamSize ~= expectedTeamSize or teamSize <= 0 then
		return nil, "InvalidTeamSize"
	end

	local redTeam = request.RedTeam
	local blueTeam = request.BlueTeam
	if type(redTeam) ~= "table" or type(blueTeam) ~= "table" then
		return nil, "InvalidTeams"
	end

	if #redTeam ~= teamSize or #blueTeam ~= teamSize then
		return nil, "IncompleteTeam"
	end

	local reqZoneId = request.ZoneId
	if type(reqZoneId) ~= "string" or reqZoneId == "" then
		return nil, "InvalidZoneId"
	end

	if countSessions(self._sessionsById) >= self._maxConcurrentSessions then
		return nil, "ConcurrentSessionLimitReached"
	end

 local socialPlay=self._context and self._context:GetService('SocialPlayService')
 if socialPlay then
  for _,team in ipairs({redTeam,blueTeam})do
   local complete,reason=socialPlay:CanQueueTeam(team,teamSize)
   if not complete then return nil,reason end
  end
 end

	-- Validación estricta de token de reserva si fue provisto
	if request.ReservationToken ~= nil then
		local mmService = self:_getMatchmakingService()
		if mmService and typeof(mmService.ValidateReservation) == "function" then
			local valid, err = mmService:ValidateReservation(request.ReservationToken, request)
			if not valid then
				return nil, err or "InvalidReservationToken"
			end
		end
	end

	local participants: { SessionParticipant } = {}
	local playersSeen: { [any]: boolean } = {}
	local userIdsSeen: { [number]: boolean } = {}

	for slotIndex, player in ipairs(redTeam) do
		local isReal = typeof(player) == "Instance" and player:IsA("Player")
		local isSim = typeof(player) == "table" and (player :: any).IsSimulatedPlayer == true
		if not isReal and not isSim then
			return nil, "InvalidParticipant"
		end
		if isReal and (player.Parent ~= Players and not player:IsDescendantOf(Players)) then
			return nil, "ParticipantDisconnected"
		end
		if isSim and (player :: any).IsConnected == false then
			return nil, "ParticipantDisconnected"
		end

		local userId = player.UserId
		if not self:_isParticipantUserIdValid(userId) then
			return nil, "InvalidParticipantUserId"
		end
		if playersSeen[player] or userIdsSeen[userId] then
			return nil, "DuplicateParticipant"
		end
		if self._participantByPlayer[player] or self._sessionIdByUserId[userId] then
			return nil, "ParticipantAlreadyRegistered"
		end
		playersSeen[player] = true
		userIdsSeen[userId] = true

		table.insert(participants, {
			Player = player,
			UserId = userId,
			Team = "Red",
			Slot = slotIndex,
			State = "Reserved",
		})
	end

	for slotIndex, player in ipairs(blueTeam) do
		local isReal = typeof(player) == "Instance" and player:IsA("Player")
		local isSim = typeof(player) == "table" and (player :: any).IsSimulatedPlayer == true
		if not isReal and not isSim then
			return nil, "InvalidParticipant"
		end
		if isReal and (player.Parent ~= Players and not player:IsDescendantOf(Players)) then
			return nil, "ParticipantDisconnected"
		end
		if isSim and (player :: any).IsConnected == false then
			return nil, "ParticipantDisconnected"
		end

		local userId = player.UserId
		if not self:_isParticipantUserIdValid(userId) then
			return nil, "InvalidParticipantUserId"
		end
		if playersSeen[player] or userIdsSeen[userId] then
			return nil, "DuplicateParticipant"
		end
		if self._participantByPlayer[player] or self._sessionIdByUserId[userId] then
			return nil, "ParticipantAlreadyRegistered"
		end
		playersSeen[player] = true
		userIdsSeen[userId] = true

		table.insert(participants, {
			Player = player,
			UserId = userId,
			Team = "Blue",
			Slot = slotIndex,
			State = "Reserved",
		})
	end

		for _, participant in ipairs(participants) do participant.MatchStats = { Goals = 0, Kills = 0, Deaths = 0 } end
		local sessionId: SessionId = HttpService:GenerateGUID(false)
	local session: MatchSession = {
		Id = sessionId,
		Mode = reqMode,
		TeamSize = teamSize,
		ZoneId = reqZoneId,
		ReservationToken = request.ReservationToken,
		Participants = participants,
			MatchStatEvents = {},
		-- Referencias derivadas para conservar los contratos 1v1 actuales.
		RedPlayer = redTeam[1],
		BluePlayer = blueTeam[1],
		RedTeam = redTeam,
		BlueTeam = blueTeam,
		SelectedMap = nil,
		Result = nil,
		StartTime = nil,
		State = Constants.RoundState.Waiting,
		StateVersion = 0,
		Votes = {},
		SessionThread = nil,
		PointRestartThread = nil,
		RemainingTime = nil,
		Closing = false,
		Cancelled = false,
		Closed = false,
		CloseStarted = false,
		CloseSteps = {},
		CloseErrors = {},
		Score = { Red = 0, Blue = 0 },
		MatchmakingZoneId = reqZoneId,
	}

	local registered, reason = self:_registerSession(session)
	if not registered then
		return nil, reason
	end

	if request.ReservationToken ~= nil then
		local mmService = self:_getMatchmakingService()
		if mmService and typeof(mmService.ConsumeReservation) == "function" then
			mmService:ConsumeReservation(request.ReservationToken)
		end
	end

	return session, nil
end

RoundService.AdmitTeamSession = RoundService.AdmitSession
RoundService._admitSession = RoundService.AdmitSession

function RoundService:IsAvailable(): boolean
	return countSessions(self._sessionsById) < self._maxConcurrentSessions
end

function RoundService:GetAvailableMaps(teamSize: number?): { string }
	local mapsFolder = ServerStorage:FindFirstChild("Maps")
	if not mapsFolder then
		return {}
	end

	local maps = {}
	local matchInstanceService = self:_getMatchInstanceService()
	for _, child in ipairs(mapsFolder:GetChildren()) do
		if child:IsA("Model") or child:IsA("Folder") then
			local compatible = true
			if matchInstanceService and type(matchInstanceService.IsMapCompatible) == "function" then
				compatible = matchInstanceService:IsMapCompatible(child.Name, teamSize or 1)
			end
			if compatible then table.insert(maps, child.Name) end
		end
	end
	table.sort(maps)
	return maps
end

function RoundService:_setState(newState: RoundStateName, extraData: any?)
	local session = self:GetSession()
	if session then
		return self:SetSessionState(session.Id, newState, extraData)
	end
	if newState == Constants.RoundState.Waiting then
		self._state = newState
		return true
	end
	return false
end

function RoundService:_broadcastCountdown(sessionId: SessionId, remaining: number, label: string, payload: any?)
	local session = self._sessionsById[sessionId]
	if not session or session.Closed then return end
	session.RemainingTime = remaining
	local data = self:_applySessionIdentity(session, payload)
	data.CountdownToken = session.Id
	self:FireSessionRemote(sessionId, "Match", "Countdown", remaining, label, data)
end

function RoundService:_broadcastResult(sessionId: SessionId, result: string, winnerName: string?)
	local session = self._sessionsById[sessionId]
	if not session or session.Closed then return end
	local metadata = self:_applySessionIdentity(session, { Result = result, Winner = winnerName })
	self:FireSessionRemote(sessionId, "Match", "MatchResult", result, winnerName, metadata)
end

function RoundService:SubmitMapVote(player: Player, mapName: string, expectedSessionId: SessionId?): boolean
	if type(expectedSessionId) ~= "string" or expectedSessionId == "" then
		return false
	end
	local session = self:GetSessionForPlayer(player)
	if not session or not self:_isRegisteredSession(session) or session.State ~= Constants.RoundState.MapSelection then
		return false
	end
	if expectedSessionId ~= session.Id then
		return false
	end

	local availableMaps = self:GetAvailableMaps(session.TeamSize)
	local isRandom = (mapName == Constants.SpecialMapVote.Random or mapName == "Aleatorio")
	local isValidMap = table.find(availableMaps, mapName) ~= nil

	if not isRandom and not isValidMap then
		return false
	end

	session.Votes[player] = isRandom and Constants.SpecialMapVote.Random or mapName

	local remote = self:_getRemote("Match", "MapSelection")
	if remote then
		remote:FireClient(player, self:_applySessionIdentity(session, { Voted = session.Votes[player] }))
	end

	return true
end

function RoundService:_isSessionValid(sessionId: SessionId): boolean
	local session = self._sessionsById[sessionId]
	return session ~= nil and self:_isRegisteredSession(session)
end

function RoundService:StartMatch(redPlayer: Player, bluePlayer: Player, matchmakingZoneId: string?): boolean
	local reservationToken = nil
	local mmService = self:_getMatchmakingService()
	if mmService and typeof(mmService.GetActiveReservation) == "function" and matchmakingZoneId then
		local res = mmService:GetActiveReservation(matchmakingZoneId)
		if res then
			reservationToken = res.Token
		end
	end

	local started, _reason = self:StartTeamMatch({
		ZoneId = matchmakingZoneId or "1v1",
		Mode = "1v1",
		TeamSize = 1,
		RedTeam = { redPlayer },
		BlueTeam = { bluePlayer },
		ReservationToken = reservationToken,
	})
	return started
end

function RoundService:StartTeamMatch(
	requestOrRedPlayers: any,
	bluePlayers: { Player }?,
	mode: string?,
	matchmakingZoneId: string?,
	reservationToken: string?
): (boolean, string?)
	local request: Types.TeamMatchAdmissionRequest
	if type(requestOrRedPlayers) == "table" and (requestOrRedPlayers.RedTeam ~= nil or requestOrRedPlayers.Mode ~= nil) then
		request = requestOrRedPlayers
	else
		request = {
			ZoneId = matchmakingZoneId or "1v1",
			Mode = mode or "1v1",
			TeamSize = (type(requestOrRedPlayers) == "table" and #requestOrRedPlayers) or 1,
			RedTeam = requestOrRedPlayers or {},
			BlueTeam = bluePlayers or {},
			ReservationToken = reservationToken,
		}
	end

	-- 1. Bloqueo explícito de inicio real de partidas para modalidades no habilitadas en combate/spawns (Fase 2A)
	if not self:IsModePlayable(request.Mode) then
		warn(string.format("[RoundService] Inicio real bloqueado para modo '%s' (solo 1v1 habilitado para combate en Fase 2A)", tostring(request.Mode)))
		return false, "ModeNotPlayable"
	end

	-- 2. Capacidad global disponible
	if not self:IsAvailable() then
		warn(string.format("[RoundService] No se puede iniciar match, estado actual: %s", self:GetState()))
		return false, "RoundUnavailable"
	end

	-- 3. Admisión atómica de la sesión
	local session, reason = self:AdmitSession(request)
	if not session then
		warn(string.format("[RoundService] Admisión rechazada: %s", tostring(reason)))
		return false, reason
	end

	self._currentSession = session
	session.SessionThread = task.spawn(function()
		local ok, err = xpcall(function()
			self:_runSession(session.Id)
		end, debug.traceback)
		if not ok then
			warn(string.format("[RoundService] Error asíncrono en sesión '%s': %s", session.Id, tostring(err)))
			self:CloseSession(session.Id, {
				Cancelled = true,
				Result = Constants.MatchResult.Cancelled,
				Reason = "SessionThreadError",
			})
		end
	end)

	return true, nil
end

function RoundService:_resolveMap(sessionId: SessionId, availableMaps: { string }): string
	local session = self._sessionsById[sessionId]
	if not session or #availableMaps == 0 then
		return ""
	end

	-- Compatibilidad observable 1v1: un voto Random conserva la regla histórica
	-- de resolver entre todos los mapas, y dos votos distintos empatan entre sí.
	if session.TeamSize == 1 then
		local redVote = session.Votes[session.RedPlayer]
		local blueVote = session.Votes[session.BluePlayer]
		local isRedRandom = (redVote == Constants.SpecialMapVote.Random or redVote == "Aleatorio")
		local isBlueRandom = (blueVote == Constants.SpecialMapVote.Random or blueVote == "Aleatorio")
		local redChosen = if (redVote and not isRedRandom and table.find(availableMaps, redVote)) then redVote else nil
		local blueChosen = if (blueVote and not isBlueRandom and table.find(availableMaps, blueVote)) then blueVote else nil

		if isRedRandom or isBlueRandom then
			return availableMaps[math.random(1, #availableMaps)]
		elseif redChosen and blueChosen and redChosen == blueChosen then
			return redChosen
		elseif redChosen and blueChosen then
			return if math.random(1, 2) == 1 then redChosen else blueChosen
		elseif redChosen then
			return redChosen
		elseif blueChosen then
			return blueChosen
		end
		return availableMaps[math.random(1, #availableMaps)]
	end

	-- XvX: cada participante activo aporta exactamente un voto. Random se
	-- materializa como una elección compatible individual antes del conteo.
	local voteCounts: { [string]: number } = {}
	for _, participant in ipairs(session.Participants) do
		if self:GetSessionParticipant(sessionId, participant.Player) == participant then
			local vote = session.Votes[participant.Player]
			if vote == Constants.SpecialMapVote.Random or vote == "Aleatorio" then
				vote = availableMaps[math.random(1, #availableMaps)]
			end
			if vote and table.find(availableMaps, vote) then
				voteCounts[vote] = (voteCounts[vote] or 0) + 1
			end
		end
	end

	local highest = 0
	local tiedMaps: { string } = {}
	for _, mapName in ipairs(availableMaps) do
		local count = voteCounts[mapName] or 0
		if count > highest then
			highest = count
			tiedMaps = { mapName }
		elseif count > 0 and count == highest then
			table.insert(tiedMaps, mapName)
		end
	end

	if highest == 0 then
		return availableMaps[math.random(1, #availableMaps)]
	end
	return tiedMaps[math.random(1, #tiedMaps)]
end

local function getTeamPlayerSnapshots(players: { Player }?): { { Name: string, UserId: number, DisplayName: string } }
	local res = {}
	if players then
		for _, p in ipairs(players) do
			if p and p.Parent then
				table.insert(res, {
					Name = p.Name,
					UserId = p.UserId,
					DisplayName = p.DisplayName,
				})
			end
		end
	end
	return res
end

local function assignMatchIdentity(session: MatchSession)
	for _, participant in ipairs(session.Participants) do
		local player = participant.Player
		if player and typeof(player) == "Instance" and player:IsA("Player") and player.Parent then
			player:SetAttribute("MatchId", session.Id)
			player:SetAttribute("MatchTeam", participant.Team)
			participant.State = "Active"
		elseif player and typeof(player) == "table" and (player :: any).IsSimulatedPlayer == true then
			participant.State = "Active"
		end
	end
end

local function clearMatchIdentity(session: MatchSession?)
	if not session then return end
	for _, participant in ipairs(session.Participants) do
		local player = participant.Player
		if player and typeof(player) == "Instance" and player:IsA("Player")
			and player:GetAttribute("MatchId") == session.Id then
			runCleanupStep("ClearMatchIdentity", function()
				player:SetAttribute("MatchId", nil)
				player:SetAttribute("MatchTeam", nil)
			end)
		end
	end
end

-- Gameplay V2: one session loop polls the CURRENT round; no timer task per restart.
function RoundService:BeginGameplayRound(session: MatchSession)
 local previous=session.GameplayRound
 session.GameplayRound=RoundClock.Start(session.Id,if previous then previous.Index+1 else 1,
  Config.Round.RoundDuration,os.clock(),workspace:GetServerTimeNow())
 local combat=self:_getCombatService()
 if combat then combat:ClearMatch(session.Id) end
 local abilities=self._context and self._context:GetService("AbilityService")
 if abilities then abilities:BeginRound(session) end
 self:PublishGameplayRound(session)
end

function RoundService:PublishGameplayRound(session: MatchSession)
 local round=session.GameplayRound
 if not round then return end
 local remaining=if round.Resolved then 0 else RoundClock.Remaining(round,os.clock())
 self:_broadcastCountdown(session.Id,remaining,"PLAYING",{
  RoundId=round.Id,RoundIndex=round.Index,Deadline=round.NetworkDeadline,
  Resolved=round.Resolved,SuddenDeath=round.SuddenDeath and round.Resolved==nil,
 })
end

function RoundService:UpdateGameplayRound(session: MatchSession): boolean
 local round=session.GameplayRound
 if not round or round.Resolved then return false end
 local now=os.clock()
 if now>=round.Deadline then
  if RoundClock.Resolve(round,"Timeout",now) then
   self:CancelGameplayRecoveries(session)
   self:PublishGameplayRound(session)
   local score=self:_getScoreService()
   self:BeginSessionResults(session.Id,if score then score:GetWinner(session) else Constants.MatchResult.Draw)
  end
  return false
 end
 local sudden=Config.Round.SuddenDeath
 if sudden.Enabled and not round.SuddenDeath and round.Deadline-now<=sudden.StartAtRemainingSeconds then
  round.SuddenDeath=true
  self:PublishGameplayRound(session)
 end
 return true
end

function RoundService:IsGameplayRoundOpen(session: MatchSession): boolean
 if not self:_isRegisteredSession(session) or session.State~=Constants.RoundState.Playing
  or session.PointInProgress or session.Closing or session.Closed or session.Cancelled or session.GameplayFrozen then return false end
 return self:UpdateGameplayRound(session)
end

function RoundService:TryResolveGameplayRound(session: MatchSession,kind: string): boolean
 if not self:IsGameplayRoundOpen(session) then return false end
 if not RoundClock.Resolve(session.GameplayRound,kind,os.clock()) then
  self:UpdateGameplayRound(session);return false
 end
 self:CancelGameplayRecoveries(session)
 self:PublishGameplayRound(session)
 return true
end

function RoundService:CancelGameplayRecoveries(session: MatchSession)
 local abilities=self._context and self._context:GetService("AbilityService")
 if abilities then abilities:CancelSession(session.Id,"RoundResolved") end
 local ragdoll=self._context and self._context:GetService("RagdollService")
 if ragdoll and ragdoll.CancelRecovery then
  for _,member in ipairs(session.Participants) do
   if member.Player.Character then ragdoll:CancelRecovery(member.Player.Character) end
  end
 end
end

function RoundService:ValidatePreparationParticipants(session: MatchSession, requireCharacter: boolean?): (boolean, string?)
 if not session or self._sessionsById[session.Id] ~= session then return false,"SessionNotRegistered" end
 local seen = {}
 for _,team in ipairs({"Red","Blue"}) do
  local roster = if team == "Red" then session.RedTeam else session.BlueTeam
  if not roster or #roster ~= session.TeamSize then return false,"IncompleteTeam" end
  for slot,player in ipairs(roster) do
   local participant=self:GetSessionParticipant(session.Id,player)
   if not participant or participant.Team~=team or participant.Slot~=slot or seen[player] then return false,"PreparationParticipantMismatch" end
   seen[player]=true
   if requireCharacter then
    local character=player.Character
    local humanoid=character and character:FindFirstChildOfClass("Humanoid")
    local root=character and character:FindFirstChild("HumanoidRootPart")
    if not character or not character:IsDescendantOf(workspace) or not humanoid or humanoid.Health<=0
     or not root or not root:IsA("BasePart") then return false,"PreparationCharacterUnavailable" end
   end
  end
 end
 return true,nil
end

function RoundService:_runSession(sessionId: string)
	local session = self._sessionsById[sessionId]
	if not session or not self:_isRegisteredSession(session) then return end

	-- Bloqueo defensivo en ejecución de sesión si el modo no está habilitado para combate
	if not self:IsModePlayable(session.Mode) then
		warn(string.format("[RoundService] _runSession abortado: modo '%s' no habilitado para combate en Fase 2A", session.Mode))
		self:CloseSession(sessionId, { Cancelled = true, Reason = "ModeNotPlayable" })
		return
	end

	local redSnap = getTeamPlayerSnapshots(session.RedTeam or { session.RedPlayer })
	local blueSnap = getTeamPlayerSnapshots(session.BlueTeam or { session.BluePlayer })

	local mmService = self:_getMatchmakingService()
	if not self:ValidatePreparationParticipants(session, false) then
		self:_cancelSession("InvalidPreparationParticipants",sessionId);return
	end

	-- 1. MATCH_READY
	assignMatchIdentity(session)

	if not self:SetSessionState(sessionId, Constants.RoundState.MatchReady, {
		Red = session.RedPlayer.Name,
		Blue = session.BluePlayer.Name,
		RedTeam = redSnap,
		BlueTeam = blueSnap,
	}) then return end
	task.wait(0.5)
	if not self:_isSessionValid(sessionId) then return end

	-- Verificación pre-countdown: si alguno abandonó durante MatchReady (0.5s)
	if session.MatchmakingZoneId and mmService then
		if not mmService:ArePlayersInZone(session.MatchmakingZoneId, session.RedTeam, session.BlueTeam) then
			self:_cancelMatchPreparation("PlayerLeftQueuePad", sessionId)
			return
		end
	end

	-- 2. MATCH_COUNTDOWN (5 segundos)
	local countdownTime = Config.Round.MatchCountdownTime
	if not self:SetSessionState(sessionId, Constants.RoundState.MatchCountdown, { Duration = countdownTime }) then return end
	for t = countdownTime, 1, -1 do
		if not self:ValidatePreparationParticipants(session, false) then self:_cancelSession("InvalidPreparationParticipants",sessionId);return end
		-- Validación periódica pre-compromiso: ¿ambos siguen físicamente en sus pads?
		if session.MatchmakingZoneId and mmService then
			if not mmService:ArePlayersInZone(session.MatchmakingZoneId, session.RedTeam, session.BlueTeam) then
				self:_cancelMatchPreparation("PlayerLeftQueuePad", sessionId)
				return
			end
		end

		self:_broadcastCountdown(sessionId, t, "LA PARTIDA COMIENZA EN")
		task.wait(1)
		if not self:_isSessionValid(sessionId) then return end
	end
	self:_broadcastCountdown(sessionId, 0, "LA PARTIDA COMIENZA EN")

	-- 2.5 GATE FINAL AUTORITATIVO ANTES DE COMPROMETER LA PARTIDA EN MAPSELECTION
	if session.MatchmakingZoneId and mmService then
		if not mmService:ArePlayersInZone(session.MatchmakingZoneId, session.RedTeam, session.BlueTeam) then
			self:_cancelMatchPreparation("PlayerLeftQueuePad", sessionId)
			return
		end
	end

	-- 3. MAP_SELECTION (5 segundos)
	local availableMaps = self:GetAvailableMaps(session.TeamSize)
	if #availableMaps == 0 then
		warn("[RoundService] No maps available.")
		self:_cancelSession("NoMapsAvailable", sessionId)
		return
	end

	local mapSelectionTime = Config.Round.MapSelectionTime
	if not self:SetSessionState(sessionId, Constants.RoundState.MapSelection, {
		Maps = availableMaps,
		Duration = mapSelectionTime,
	}) then return end

	self:FireSessionRemote(sessionId, "Match", "MapSelection", self:_applySessionIdentity(session, {
			MatchId = sessionId,
			Maps = availableMaps,
			Duration = mapSelectionTime,
		}))

	for t = mapSelectionTime, 1, -1 do
		self:_broadcastCountdown(sessionId, t, "ELIGE UN MAPA")
		task.wait(1)
		if not self:_isSessionValid(sessionId) then return end
	end
	self:_broadcastCountdown(sessionId, 0, "ELIGE UN MAPA")

	-- 4. RESOLUCION DE MAPA
	local selectedMap = self:_resolveMap(sessionId, availableMaps)
	session.SelectedMap = selectedMap
	print(string.format("[RoundService] Selected map: %s", selectedMap))

	-- 5. MAP_LOADING
	if not self:ValidatePreparationParticipants(session,true)
		or (session.MatchmakingZoneId and mmService and not mmService:ArePlayersInZone(session.MatchmakingZoneId,session.RedTeam,session.BlueTeam,true)) then
		self:_cancelSession("PreparationOccupancyLost",sessionId);return
	end
	if not self:SetSessionState(sessionId, Constants.RoundState.MapLoading, { SelectedMap = selectedMap }) then return end

	local matchInstanceService = self:_getMatchInstanceService()
	if matchInstanceService then
		local instanceInfo = matchInstanceService:CreateInstance(session, selectedMap)
		if not instanceInfo then
			warn(string.format("[RoundService] No se pudo instanciar fisicamente el mapa '%s'", selectedMap))
			self:_cancelSession("MapInstanceCreationFailed", sessionId)
			return
		end
		session.InstanceInfo = instanceInfo

		-- Validar contrato ZoneWin en la instancia clonada
		local scoreService = self:_getScoreService()
		if scoreService then
			local isValidZone = scoreService:ValidateZoneWin(session)
			if not isValidZone then
				warn(string.format("[RoundService] Missing or invalid ZoneWin contract for match '%s'", sessionId))
				self:_cancelSession("ZoneWinValidationFailed", sessionId)
				return
			end
		end
	else
		local mapFolder = ServerStorage:FindFirstChild("Maps")
		local mapInstance = mapFolder and mapFolder:FindFirstChild(selectedMap)
		if not mapInstance then
			warn(string.format("[RoundService] Map '%s' not found in ServerStorage.Maps", selectedMap))
			self:_cancelSession("MapInstanceNotFound", sessionId)
			return
		end
	end

	-- Posicionamiento de jugadores en spawns de la arena aislada
	local spawnService = self:_getSpawnService()
	if spawnService then
		if not self:ValidatePreparationParticipants(session,true)
			or (session.MatchmakingZoneId and mmService and not mmService:ArePlayersInZone(session.MatchmakingZoneId,session.RedTeam,session.BlueTeam,true)) then
			self:_cancelSession("PreparationOccupancyLost",sessionId);return
		end
		local spawnResult = spawnService:SpawnMatchPlayers(session)
		if not spawnResult.Success then
			warn(string.format("[RoundService] Spawn incompleto para '%s': %d/%d, fallos=%d", sessionId, spawnResult.Placed, spawnResult.Required, #spawnResult.Failures))
			self:_cancelSession("SpawnPlayersFailed", sessionId)
			return
		end
	else
		warn("[RoundService] SpawnService no disponible durante MapLoading")
		self:_cancelSession("SpawnServiceUnavailable",sessionId)
		return
	end

	task.wait(1)
	if not self:_isSessionValid(sessionId) then return end
	if not self:ValidatePreparationParticipants(session, true) then
		self:_cancelSession("PreparationIncomplete",sessionId);return
	end

	-- 5.5 START_COUNTDOWN (Config.Match.StartCountdownTime, por defecto 5 segundos)
	-- Jugadores ya posicionados en spawns, arena cargada, scoring y match timer NO activos
	local startCountdownTime = (Config.Match and Config.Match.StartCountdownTime) or 5
	if not self:SetSessionState(sessionId, Constants.RoundState.StartCountdown, {
		MatchId = sessionId,
		Duration = startCountdownTime,
		Red = session.RedPlayer.Name,
		Blue = session.BluePlayer.Name,
		RedTeam = redSnap,
		BlueTeam = blueSnap,
	}) then return end

	-- Bloqueo autoritativo de locomoción durante StartCountdown (WalkSpeed=0, JumpPower=0, AutoRotate=false)
	if spawnService then
		spawnService:LockSessionPlayers(session)
	end

	-- Equipar Slaps autoritativos para la partida
	local slapService = self:_getSlapService()
	if slapService then
		slapService:EquipMatchPlayers(session)
	end

	local abilities = self._context and self._context:GetService("AbilityService")
	local abilityWindow = abilities and abilities:PrepareSelection(session, startCountdownTime)
	if abilities and not abilityWindow then return end
	for t = startCountdownTime, 1, -1 do
		if not self:ValidatePreparationParticipants(session, true) then self:_cancelSession("PreparationIncomplete",sessionId);return end
		self:_broadcastCountdown(sessionId, t, "START_COUNTDOWN", {
			MatchId = sessionId,
			Value = t,
			Started = false,
		})
		task.wait(1)
		if not self:_isSessionValid(sessionId) then return end
	end

	if abilities then abilities:FinishSelection(session, abilityWindow) end
	-- Emisión final autoritativa de inicio ("GO" / Value=0, Started=true)
	self:_broadcastCountdown(sessionId, 0, "START_COUNTDOWN", {
		MatchId = sessionId,
		Value = 0,
		Started = true,
	})
	task.wait(0.5)
	if not self:_isSessionValid(sessionId) then return end

	-- 6. PLAYING: each competitive round receives its own 180-second deadline.
	if not self:ValidatePreparationParticipants(session, true) then self:_cancelSession("PreparationIncomplete",sessionId);return end
	-- El timer oficial de partida (RoundDuration) y el ScoreService comienzan estrictamente al entrar en Playing
	session.StartTime = os.clock()
	local roundDuration = Config.Round.RoundDuration
	if not self:SetSessionState(sessionId, Constants.RoundState.Playing, {
		MatchId = sessionId,
		Duration = roundDuration,
		SelectedMap = selectedMap,
		Red = session.RedPlayer.Name,
		Blue = session.BluePlayer.Name,
		RedTeam = redSnap,
		BlueTeam = blueSnap,
	}) then return end


	-- Iniciar scoring autoritativo
	local scoreService = self:_getScoreService()
	if scoreService then
		scoreService:StartScoring(session)
	end

	-- Iniciar detección y resolución de eliminaciones autoritativas
	local eliminationService = self:_getEliminationService()
	if eliminationService then
		eliminationService:BindMatch(session)
	end

	-- Restaurar movimiento normal inmediatamente al pasar a PLAYING
	if spawnService then
		spawnService:UnlockSessionPlayers(session)
	end

	self:BeginGameplayRound(session)
 local lastPublished=-1
 local lastRoundId=""
 while self:_isSessionValid(sessionId) and session.Result==nil do
  local round=session.GameplayRound
  if round and not round.Resolved and session.State==Constants.RoundState.Playing and not session.PointInProgress then
   if self:UpdateGameplayRound(session) then
    local remaining=RoundClock.Remaining(round,os.clock())
    if lastPublished~=remaining or lastRoundId~=round.Id then
     lastPublished=remaining;lastRoundId=round.Id;self:PublishGameplayRound(session)
    end
   end
  end
  task.wait(0.05)
 end

	if not self:_isSessionValid(sessionId) then return end

	-- Timeout uses the same terminal barrier as the fifth point.
	local result = session.Result
	if result == nil then result = if scoreService then scoreService:GetWinner(session) else Constants.MatchResult.Draw end
	self:BeginSessionResults(sessionId, result)
end

-- Inicia la secuencia autoritativa de PointRestartCountdown (3 segundos) tras un punto anotado
function RoundService:TriggerPointRestart(session: MatchSession)
	local sessionId = session.Id
	if not self:_isSessionValid(sessionId) or session.State ~= Constants.RoundState.Playing then return end
	local respawns = self:_getSpawnService()
	if respawns and respawns.CancelSessionRespawns then respawns:CancelSessionRespawns(sessionId, "PointRestart") end

	-- Cancelar cualquier hilo previo si existiera
	if session.PointRestartThread then
		pcall(task.cancel, session.PointRestartThread)
		session.PointRestartThread = nil
	end

	session.PointRestartThread = task.spawn(function()
		local delayTime = (Config.Match and Config.Match.PointResetDelay) or 1.5
		task.wait(delayTime)

		if not self:_isSessionValid(sessionId) or session.Result ~= nil then return end

		-- Reposicionar ambos equipos en sus spawns respectivos de la arena activa y bloquear locomoción
		local spawnService = self:_getSpawnService()
		if spawnService then
			local spawnResult = spawnService:SpawnMatchPlayers(session)
			if not spawnResult.Success then
				warn(string.format("[RoundService] Reinicio de punto incompleto para '%s': %d/%d", sessionId, spawnResult.Placed, spawnResult.Required))
				self:_cancelSession("PointRestartSpawnFailed", sessionId)
				return
			end
			spawnService:LockSessionPlayers(session)
		end

		-- Limpiar registros de presencia en zonas en ScoreService
		local scoreService = self:_getScoreService()
		if scoreService then
			scoreService:ResetZonePresences(sessionId)
		end

		local countdownTime = (Config.Match and Config.Match.PointRestartCountdownTime) or 3
		local redSnap = getTeamPlayerSnapshots(session.RedTeam or { session.RedPlayer })
		local blueSnap = getTeamPlayerSnapshots(session.BlueTeam or { session.BluePlayer })

		-- Transición de estado a PointRestartCountdown
		if not self:SetSessionState(sessionId, Constants.RoundState.PointRestartCountdown, {
			MatchId = sessionId,
			Duration = countdownTime,
			Red = session.RedPlayer and session.RedPlayer.Name,
			Blue = session.BluePlayer and session.BluePlayer.Name,
			RedTeam = redSnap,
			BlueTeam = blueSnap,
		}) then return end

		-- Cuenta regresiva autoritativa: 3 -> 2 -> 1
		local abilities = self._context and self._context:GetService("AbilityService")
		local abilityWindow = abilities and abilities:PrepareSelection(session, countdownTime)
		if abilities and not abilityWindow then return end
		for t = countdownTime, 1, -1 do
			self:_broadcastCountdown(sessionId, t, "START_COUNTDOWN", {
				MatchId = sessionId,
				Value = t,
				Started = false,
				Phase = "PointRestart",
			})
			task.wait(1)
			if not self:_isSessionValid(sessionId) or session.Result ~= nil then return end
		end

		if abilities then abilities:FinishSelection(session, abilityWindow) end
		-- Emisión final clímax: ¡COMIENZA! (Value = 0, Started = true)
		self:_broadcastCountdown(sessionId, 0, "START_COUNTDOWN", {
			MatchId = sessionId,
			Value = 0,
			Started = true,
			Phase = "PointRestart",
		})
		task.wait(0.5)
		if not self:_isSessionValid(sessionId) or session.Result ~= nil then return end

		-- Retorno autoritativo al estado Playing
		if not self:SetSessionState(sessionId, Constants.RoundState.Playing, {
			MatchId = sessionId,
			Duration = Config.Round.RoundDuration,
			SelectedMap = session.SelectedMap,
			Red = session.RedPlayer and session.RedPlayer.Name,
			Blue = session.BluePlayer and session.BluePlayer.Name,
			RedTeam = redSnap,
			BlueTeam = blueSnap,
		}) then return end

		-- Restaurar movimiento normal inmediatamente al reanudar PLAYING
		if spawnService then
			spawnService:UnlockSessionPlayers(session)
		end

		-- Limpiar explícitamente el estado de PointScorer al reanudar combate
		session.PointInProgress = false
		session.PointScorer = nil
		session.PointScorerTeam = nil
		session.PointScoreTimestamp = nil
		session.PointNumber = nil

		-- New deadline begins only once this departure becomes playable.
		if scoreService then scoreService:ResumeScoring(sessionId) end
		self:BeginGameplayRound(session)

		if self:_isSessionValid(sessionId) then
			session.PointRestartThread = nil
		end
		print(string.format("[RoundService] PointRestartCountdown completado para Match '%s'. Partida reanudada en PLAYING.", sessionId))
	end)
end

function RoundService:DeclareSessionWinner(sessionId: SessionId, winner: MatchResultName, finalGoal: any?): boolean
	local session = self._sessionsById[sessionId]
	if not session or session.Result ~= nil or not self:_isRegisteredSession(session)
		or (session.State ~= Constants.RoundState.Playing and session.State ~= Constants.RoundState.PointRestartCountdown) then
		return false
	end
	if session.PointRestartThread then
		pcall(task.cancel, session.PointRestartThread)
		session.PointRestartThread = nil
	end
	return self:BeginSessionResults(sessionId, winner, finalGoal)
end

-- Adaptador 1v1 temporal para ScoreService. Retirar cuando el consumidor envíe SessionId.
function RoundService:DeclareWinner(winner: MatchResultName, sessionId: SessionId?): boolean
	local resolvedId = sessionId
	if not resolvedId then
		local session = self:GetSession()
		resolvedId = session and session.Id or nil
	end
	return if resolvedId then self:DeclareSessionWinner(resolvedId, winner) else false
end

-- Hook de entrega de recompensas y estadísticas server-authoritative
function RoundService:_processReward(session: MatchSession, result: MatchResultName)
	self._rewardedMatches = self._rewardedMatches or {}
	self._rewardedPlayers = self._rewardedPlayers or {}
	local matchId = session.Id or (session :: any).MatchId or "UNKNOWN_MATCH"
	if self._rewardedMatches[matchId] then
		print(string.format("[RoundService] Match '%s' ya fue recompensado previamente. Omitiendo duplicado.", matchId))
		return
	end
	local playerService = self:_getPlayerService()
	if playerService then
		local function isConnected(player: any): boolean
			if typeof(player) == "Instance" and player:IsA("Player") then
				return player.Parent == Players
			end
			return typeof(player) == "table"
				and player.IsSimulatedPlayer == true
				and player.IsConnected ~= false
		end

		local winningTeam = if result == Constants.MatchResult.Red then "Red"
			elseif result == Constants.MatchResult.Blue then "Blue" else nil
		if winningTeam then
			local hasConnectedWinner = false
			for _, participant in ipairs(session.Participants) do
				if participant.Team == winningTeam
					and participant.State ~= "Left"
					and participant.State ~= "Released"
					and isConnected(participant.Player) then
					hasConnectedWinner = true
					break
				end
			end
			if not hasConnectedWinner then
				self._rewardedMatches[matchId] = true
				print(string.format("[RoundService] Match '%s' terminó sin ganador conectado; no se aplican estadísticas", matchId))
				return
			end
		end

		local rewardedPlayers = self._rewardedPlayers[matchId] or {}
		self._rewardedPlayers[matchId] = rewardedPlayers
		local function award(player: Player, kind: string)
			-- PlayerService vuelve a registrar datos si recibe un Player ya removido.
			-- No recrear perfiles después de PlayerRemoving; el cierre debe poder
			-- finalizar sin dejar registros huérfanos.
			if not isConnected(player) then
				print(string.format("[RoundService] Estadística %s omitida para '%s': jugador desconectado", kind, player.Name))
				return
			end
			local key = string.format("%d:%s", player.UserId, kind)
			if rewardedPlayers[key] then return end
			if playerService.RecordStreakResult then playerService:RecordStreakResult(player,matchId,kind)end
				if kind == "Win" then
				playerService:AddWin(player, "MatchWin")
			else
				playerService:AddLoss(player, "MatchLoss")
			end
			rewardedPlayers[key] = true
		end

		if result == Constants.MatchResult.Red or result == Constants.MatchResult.Blue then
			for _, participant in ipairs(session.Participants) do
				if participant.State ~= "Left" and participant.State ~= "Released" then
					award(participant.Player, if participant.Team == result then "Win" else "Loss")
				end
			end
		end
  if result==Constants.MatchResult.Draw and playerService.RecordStreakResult then
   for _,participant in ipairs(session.Participants)do
    if participant.State~='Left' and participant.State~='Released' and isConnected(participant.Player)then
     playerService:RecordStreakResult(participant.Player,matchId,'Draw')
    end
   end
  end
		-- Draw o Cancelled: no otorgan Win ni Loss
	else
		warn("[RoundService] PlayerService no disponible al procesar recompensas")
		error("PlayerServiceUnavailable")
	end
	self._rewardedMatches[matchId] = true

	local allPlayers: { Player } = {}
	if session.RedTeam then
		for _, p in ipairs(session.RedTeam) do table.insert(allPlayers, p) end
	elseif session.RedPlayer then
		table.insert(allPlayers, session.RedPlayer)
	end
	if session.BlueTeam then
		for _, p in ipairs(session.BlueTeam) do table.insert(allPlayers, p) end
	elseif session.BluePlayer then
		table.insert(allPlayers, session.BluePlayer)
	end

	local rewardPayload: Types.MatchRewardPayload = {
		MatchId = session.Id,
		WinningTeam = result,
		Result = result,
		Players = allPlayers,
	}

	print(string.format("[RoundService] Estadísticas y recompensas procesadas para Match '%s' (Resultado: %s, %d jugadores)",
		session.Id, tostring(result), #allPlayers))
end

function RoundService:_handlePlayerLeaving(player: Player)
	local participant = self:GetParticipantForPlayer(player)
	if not participant then return end
	local session = self:GetSessionForPlayer(player)
	if not session then return end
	participant.State = "Left"
	self:_unregisterParticipant(participant, session.Id)

	-- Limpiar atributos del jugador que abandona
	player:SetAttribute("MatchId", nil)
	player:SetAttribute("MatchTeam", nil)

	print(string.format("[RoundService] Jugador desconectado: %s durante estado %s", player.Name, session.State))
	if session.Results and session.Results.Viewers[player] then
		local viewer = session.Results.Viewers[player]
		viewer.Returned = true
		if viewer.RespawnConnection then viewer.RespawnConnection:Disconnect(); viewer.RespawnConnection = nil end
		self:_releaseEndingCharacter(session, player)
	end
	if session.Closing or session.Closed then return end

	if session.State == Constants.RoundState.Playing or session.State == Constants.RoundState.PointRestartCountdown then
		local activeRed = 0
		local activeBlue = 0
		for _, remaining in ipairs(session.Participants) do
			if self:GetSessionParticipant(session.Id, remaining.Player) == remaining then
				if remaining.Team == "Red" then activeRed += 1 else activeBlue += 1 end
			end
		end

		local abandonmentResult: MatchResultName? = nil
		if activeRed == 0 and activeBlue == 0 then
			abandonmentResult = Constants.MatchResult.Draw
		elseif activeRed == 0 then
			abandonmentResult = Constants.MatchResult.Blue
		elseif activeBlue == 0 then
			abandonmentResult = Constants.MatchResult.Red
		end

		if abandonmentResult then
			local mutableSession = session :: any
			local resultSource = mutableSession.ResultSource
			if session.Result == nil or resultSource == "Abandonment" then
				session.Result = abandonmentResult
				mutableSession.ResultSource = "Abandonment"
				print(string.format("[RoundService] Resultado por abandono: %s (Red activos=%d, Blue activos=%d)",
					abandonmentResult, activeRed, activeBlue))
			end
			if session.PointRestartThread then
				pcall(task.cancel, session.PointRestartThread)
				session.PointRestartThread = nil
			end
		else
			print(string.format("[RoundService] La sesión continúa tras abandono (Red activos=%d, Blue activos=%d)", activeRed, activeBlue))
		end
		-- El loop de PLAYING solo finaliza cuando un equipo queda vacío.
	elseif session.State == Constants.RoundState.Waiting
		or session.State == Constants.RoundState.MatchReady
		or session.State == Constants.RoundState.MatchCountdown
		or session.State == Constants.RoundState.MapSelection
		or session.State == Constants.RoundState.MapLoading
		or session.State == Constants.RoundState.StartCountdown then
		-- Si abandona antes de PLAYING, cancelar la sesión y volver a Waiting
		self:_cancelSession("PlayerDisconnected", session.Id)
	end
end

-- Characters stay on safe arena spawns, anchored, while only visual rigs act.
function RoundService:_protectEndingCharacter(session: MatchSession, player: Player)
	player:SetAttribute("ResultsSessionId", session.Id)
 local character = player.Character
 if not character then return end
 session.EndingCharacters = session.EndingCharacters or {}
 local saved = session.EndingCharacters[player]
 if saved and saved.Character == character then return end
 local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
 if not root then return end
 local spawn = self:_getSpawnService()
 if session.Results and session.Results.Celebrating then
  -- Preserve the goal viewpoint, but cancel ragdoll/inertia before anchoring.
  local ragdoll = self._context and self._context:GetService("RagdollService")
  if ragdoll then ragdoll:ResetRagdollImmediate(character) end
 else
  if spawn then spawn:ResetCharacterInArena(player, session.Id) end
 end
 session.EndingCharacters[player] = { Character = character, Root = root, Anchored = root.Anchored }
 if spawn then spawn:LockCharacterMovement(player) end
 for _, part in ipairs(character:GetDescendants()) do
  if part:IsA("BasePart") then part.AssemblyLinearVelocity = Vector3.zero; part.AssemblyAngularVelocity = Vector3.zero end
 end
 root.Anchored = true
end

function RoundService:_releaseEndingCharacter(session: MatchSession, player: Player)
 local saved = session.EndingCharacters and session.EndingCharacters[player]
 if saved and saved.Root.Parent then saved.Root.Anchored = saved.Anchored end
 if session.EndingCharacters then session.EndingCharacters[player] = nil end
 if player:GetAttribute("ResultsSessionId") == session.Id then player:SetAttribute("ResultsSessionId", nil) end
 if player:GetAttribute("FinalGoalSessionId") == session.Id then player:SetAttribute("FinalGoalSessionId", nil) end
end

function RoundService:_returnResultsPlayer(session: MatchSession, player: Player): boolean
 local results = session.Results
 local viewer = results and results.Viewers[player]
 if not viewer then return false end
 if viewer.Returned then return true end
 if viewer.Returning then return false end
 viewer.Returning = true
 local succeeded, returned = xpcall(function()
 local remote = self:_getRemote("Match", "EndCinematic")
 if player.Parent == Players and remote then
  remote:FireClient(player, "Returned", { SessionId = session.Id, MatchId = session.Id, StateVersion = results.Version, Token = results.Token })
 end
 local ok = true
 if player.Parent == Players then
  local spawn = self:_getSpawnService()
  local success, returned = pcall(function()
   return spawn and spawn:ReturnPlayersToLobby({ player }, nil)
  end)
  ok = success and returned == true
 end
 if not ok then return false end
 self:_releaseEndingCharacter(session, player)
 local slap = self:_getSlapService()
 if slap and player.Parent == Players then slap:UnlockPlayer(player); slap:RemoveSlaps(player) end
 local savedConnection = viewer.RespawnConnection
 if savedConnection then savedConnection:Disconnect(); viewer.RespawnConnection = nil end
 if results.Scene and results.Scene.Parent then pcall(function() results.Scene:RemovePersistentPlayer(player) end) end
 -- Clear only this player's legacy match HUD and music, without ending peers.
 if player.Parent == Players then
  local stateRemote = self:_getRemote("Match", "StateChanged")
  if stateRemote then
   local payload = self:_applySessionIdentity(session, { Reason = "ResultsExited" })
   payload.StateVersion = session.StateVersion + 1
   stateRemote:FireClient(player, Constants.RoundState.ReturningToLobby, payload)
  end
 end
 viewer.Returned = true
 local participant = self._participantByPlayer[player]
 if participant and self._sessionIdByUserId[participant.UserId] == session.Id then
  participant.State = "Released"
  self:_unregisterParticipant(participant, session.Id)
 end
 return true
 end, debug.traceback)
 viewer.Returning = false
 if not succeeded then warn("[RoundService] Results return failed: " .. tostring(returned)) end
 return succeeded and returned == true
end

function RoundService:HandleCinematicAction(player: Player, action: any, sessionId: any, version: any, token: any): boolean
 if type(sessionId) ~= "string" or type(action) ~= "string" then return false end
 local session = self._sessionsById[sessionId]
 local results = session and session.Results
 local viewer = results and results.Viewers[player]
 if not session or session.Closed or session.State ~= Constants.RoundState.Ending
  or not results or not viewer or results.Token ~= token or results.Version ~= version then return false end
 if viewer.Returned then return action == "Return" end
 if self._sessionIdByUserId[player.UserId] ~= sessionId or self._participantByPlayer[player] ~= viewer.Participant then return false end
 if action == "Prepared" then
  viewer.Prepared = true
 elseif action == "Return" or action == "Failed" then
  return self:_returnResultsPlayer(session, player)
 else
  return false
 end
 return true
end

function RoundService:GetResultsDuration(): number
 local transition, camera, winners, hud = CinematicConfig.Transition, CinematicConfig.Camera, CinematicConfig.Winners, CinematicConfig.HUD
 local walks = winners.WalkStartDelay + (winners.MaxVisible - 1) * winners.EntryStagger + winners.WalkDuration
 return math.max(transition.OpenDuration, camera.TravelDuration + (if camera.ArrivalBounceEnabled then camera.ArrivalBounceDuration else 0), walks)
  + hud.ShowDelay + CinematicConfig.Billboards.ShowDelay
  + math.max(hud.FadeDuration, CinematicConfig.Billboards.FadeDuration) + CinematicConfig.Results.ViewDuration
end

function RoundService:BeginSessionResults(sessionId: SessionId, result: MatchResultName, finalGoal: any?): boolean
 local session = self._sessionsById[sessionId]
 if not session or session.Closed or session.GameplayFrozen or session.Cancelled then return false end
 if result ~= Constants.MatchResult.Red and result ~= Constants.MatchResult.Blue and result ~= Constants.MatchResult.Draw then return false end
 if session.Result ~= nil and session.Result ~= result then return false end
 -- No yielding before the authority barrier and state version are committed.
 session.Result = result
 if session.GameplayRound and not session.GameplayRound.Resolved then session.GameplayRound.Resolved="Closed" end
 self:CancelGameplayRecoveries(session)
 session.GameplayFrozen = true
 session.Closing = true
 if session.PointRestartThread then pcall(task.cancel, session.PointRestartThread); session.PointRestartThread = nil end
 if not self:SetSessionState(sessionId, Constants.RoundState.Ending, { Result = result, Cinematic = true }, true) then return false end
 local token = HttpService:GenerateGUID(false)
 local results = { Token = token, Version = session.StateVersion, Viewers = {}, Scene = nil, Started = false,
  Celebrating = finalGoal ~= nil and CinematicConfig.FinalGoal.CelebrationEnabled == true }
 session.Results = results
 results.Snapshot = self:CaptureCinematicRanking(session)
 for _, participant in ipairs(session.Participants) do
  local player = participant.Player
  if participant.State ~= "Left" and participant.State ~= "Released" and player.Parent == Players then
   results.Viewers[player] = { Participant = participant, Prepared = false, Returned = false }
  end
 end
 -- Stop competitive triggers before any physical repositioning can yield.
 local elimination = self:_getEliminationService()
 if elimination then elimination:UnbindMatch(sessionId) end
 local combat = self:_getCombatService()
 if combat then combat:ClearMatch(sessionId) end
 local feedback = self._context and self._context:GetService("PointFeedbackService")
 if feedback then feedback:CleanupMatch(sessionId) end
 local slap = self:_getSlapService()
 for player in pairs(results.Viewers) do
  if results.Celebrating then player:SetAttribute("FinalGoalSessionId", sessionId) end
  if slap then slap:UnlockPlayer(player); slap:RemoveSlaps(player) end
  self:_protectEndingCharacter(session, player)
  results.Viewers[player].RespawnConnection = player.CharacterAdded:Connect(function()
   task.defer(function()
    if self._sessionsById[sessionId] == session and not results.Viewers[player].Returned then
     self:_returnResultsPlayer(session, player)
    end
   end)
  end)
 end
 -- Defer StopScoring: a fifth point may currently run inside its spatial thread.
 session.ResultsThread = task.defer(function()
  local ok, failure = xpcall(function()
   if not self:CloseSession(sessionId, { Result = result, AwardRewards = true, DeferCleanup = true, Reason = "EndCinematic" }) then
    self:CloseSession(sessionId, { Reason = "ResultsSetupFailed" })
    return
   end
   local instances = self:_getMatchInstanceService()
   local info = instances and instances:GetInstance(sessionId)
   local scene = info and info.EndCinematic
   if not scene or not scene.Parent then self:CloseSession(sessionId, { Reason = "CinematicSceneMissing" }); return end
   results.Scene = scene
   local winners = {}
   local eligible = {}
   local descriptions = Instance.new("Folder")
   descriptions.Name = "WinnerDescriptions"
   descriptions.Parent = scene
   for _, participant in ipairs(session.Participants) do
    local player = participant.Player
    local descriptionKey = tostring(participant.UserId)
    local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    local captured, description = pcall(function() return humanoid and humanoid:GetAppliedDescription() end)
    if not captured or not description then description = Instance.new("HumanoidDescription") end
    description.Name = descriptionKey
    description.Parent = descriptions
    if results.Viewers[player] then
     table.insert(eligible, participant.UserId)
    end
    if participant.Team == result then
      local entry = { UserId = participant.UserId, DisplayName = player.DisplayName, Team = participant.Team, Slot = participant.Slot, DescriptionKey = descriptionKey }
      table.insert(winners, entry)
    end
   end
   table.sort(winners, function(a,b) return a.Slot == b.Slot and a.UserId < b.UserId or a.Slot < b.Slot end)
   if results.Celebrating then
    local config = CinematicConfig.FinalGoal
    local began = workspace:GetServerTimeNow()
    local minimum = math.max(0, config.CelebrationDuration)
    local maximum = math.max(minimum, config.MaxFeedbackWait)
    -- Run a potentially yielding cosmetic controller separately; the wait is bounded.
    local completed = feedback == nil
    local effectThread = if feedback then task.spawn(function()
     local played, failure = pcall(function() feedback:PlayPoint(session, finalGoal, token) end)
     completed = true
     if not played then warn("[RoundService] Final goal feedback: " .. tostring(failure)) end
    end) else nil
    results.FeedbackThread = effectThread
    while self._sessionsById[sessionId] == session and not session.Closed and results.Celebrating do
     local elapsed = workspace:GetServerTimeNow() - began
     local active = feedback and feedback.HasActiveFeedback and feedback:HasActiveFeedback(sessionId)
     if elapsed >= maximum or (elapsed >= minimum and (not config.WaitForFeedback or (completed and not active))) then break end
     task.wait(0.05)
    end
    if effectThread and coroutine.status(effectThread) ~= "dead" then pcall(task.cancel, effectThread) end
    results.FeedbackThread = nil
    results.Celebrating = false
    if feedback then feedback:CleanupMatch(sessionId) end
    for player in pairs(results.Viewers) do
     if player:GetAttribute("FinalGoalSessionId") == sessionId then player:SetAttribute("FinalGoalSessionId", nil) end
    end
    if self._sessionsById[sessionId] ~= session or session.Closed or session.State ~= Constants.RoundState.Ending then return end
    print(string.format("[RoundService] FinalGoal celebration completed for '%s' after %.3fs", sessionId, workspace:GetServerTimeNow() - began))
   end
   local remote = self:_getRemote("Match", "EndCinematic")
   local payload = self:_applySessionIdentity(session, {
    Token = token, Mode = session.Mode, TeamSize = session.TeamSize, WinningTeam = result,
    Score = table.clone(session.Score or { Red = 0, Blue = 0 }), Winners = winners,
    ResultSnapshot = results.Snapshot,
    EligibleParticipantUserIds = eligible, EligibleParticipantCount = #eligible,
    SceneContainer = info.Container.Name, SceneName = scene.Name,
    SceneOrigin = scene:GetPivot().Position,
   })
   for player, viewer in pairs(results.Viewers) do
    if player.Parent == Players and not viewer.Returned then
     scene:AddPersistentPlayer(player)
     local personal = table.clone(payload)
     personal.LocalTeam = viewer.Participant.Team
     remote:FireClient(player, "Prepare", personal)
    end
   end
   local preparationDeadline = workspace:GetServerTimeNow() + CinematicConfig.Results.PreparationTimeout
   local deadline = preparationDeadline + self:GetResultsDuration() + CinematicConfig.Results.StartLeadTime
   while self._sessionsById[sessionId] == session and not session.Closed do
    local remaining = 0
    local prepared = true
    local now = workspace:GetServerTimeNow()
    for player, viewer in pairs(results.Viewers) do
     if not viewer.Returned then
      if player.Parent ~= Players or (not viewer.Prepared and now >= preparationDeadline) or now >= deadline then
       self:_returnResultsPlayer(session, player)
      end
      if not viewer.Returned then remaining += 1; prepared = prepared and viewer.Prepared end
     end
    end
    if remaining == 0 then break end
    if prepared and not results.Started then
     results.Started = true
     local startAt = now + CinematicConfig.Results.StartLeadTime
     deadline = startAt + self:GetResultsDuration()
     for player, viewer in pairs(results.Viewers) do
      if not viewer.Returned then remote:FireClient(player, "Start", { SessionId = sessionId, MatchId = sessionId, StateVersion = results.Version, Token = token, StartAt = startAt }) end
     end
    end
    task.wait(0.1)
   end
   self:CloseSession(sessionId, { Reason = "ResultsCompleted" })
  end, debug.traceback)
  if not ok then
   warn("[RoundService] Results failed: " .. tostring(failure))
   self:CloseSession(sessionId, { Reason = "ResultsError" })
  end
 end)
 return true
end

function RoundService:_runCloseStep(session: MatchSession, key: string, callback: () -> any): boolean
	session.CloseSteps = session.CloseSteps or {}
	session.CloseErrors = session.CloseErrors or {}
	if session.CloseSteps[key] then return true end

	for attempt = 1, 2 do
		local ok, result = pcall(callback)
		if ok and result ~= false then
			session.CloseSteps[key] = true
			session.CloseErrors[key] = nil
			return true
		end
		session.CloseErrors[key] = if ok then "OperationReturnedFalse" else tostring(result)
		warn(string.format("[RoundService] Cierre '%s' falló para '%s' (intento %d/2): %s",
			key, session.Id, attempt, session.CloseErrors[key]))
	end
	return false
end

-- Coordinador único de cierre. Una sesión permanece registrada y sus participantes
-- quedan en cuarentena hasta que todos los recursos críticos se hayan liberado.
-- SessionId is the unique preparation token. Closed preparations cannot be resumed.
function RoundService:CancelPreparationIfOccupancyLost(zoneId: string)
	local matchmaking = self:_getMatchmakingService()
	if not matchmaking then return end
	for _,session in pairs(self._sessionsById) do
		local state=session.State
		if session.ZoneId==zoneId and not session.Closing and not (session :: any).ArenaTransferred
			and (state==Constants.RoundState.MatchReady or state==Constants.RoundState.MatchCountdown
				or state==Constants.RoundState.MapSelection or state==Constants.RoundState.MapLoading)
			and not matchmaking:ArePlayersInZone(zoneId,session.RedTeam,session.BlueTeam) then
			self:CloseSession(session.Id,{Cancelled=true,Reason="PlayerLeftQueuePad"})
		end
	end
end

function RoundService:_closePrematch(session: MatchSession, reason: string?): boolean
	if self._sessionsById[session.Id] ~= session or (session :: any).ArenaTransferred then return false end
	session.Closing = true
	session.Cancelled = true
	(session :: any).PreparationCancelled = true
	session.Votes = {}
	session.RemainingTime = nil
	if session.SessionThread and session.SessionThread ~= coroutine.running() then pcall(task.cancel, session.SessionThread) end
	session.SessionThread = nil
	if session.PointRestartThread then pcall(task.cancel, session.PointRestartThread);session.PointRestartThread=nil end
	-- A failed map preflight may already own an empty clone/slot. No characters were moved.
	local instances = self:_getMatchInstanceService()
	if not self:_runCloseStep(session,"PrematchInstance",function()
		if instances then return instances:DestroyInstance(session.Id) end
		return session.InstanceInfo == nil
	end) then return false end
	session.StateVersion += 1
	self:FireSessionRemote(session.Id,"Match","StateChanged",Constants.RoundState.Waiting,
		self:_applySessionIdentity(session,{PrematchCancelled=true,Reason=reason,CountdownToken=session.Id}))
	clearMatchIdentity(session)
	local matchmaking = self:_getMatchmakingService()
	if matchmaking and matchmaking.ReleasePreparation then matchmaking:ReleasePreparation(session.ZoneId,session.ReservationToken) end
	self:_releaseSession(session)
	self._state = Constants.RoundState.Waiting
	return true
end

function RoundService:CloseSession(sessionId: SessionId, options: any?): boolean
	local session = self._sessionsById[sessionId]
	if not session then return self._closedSessionIds[sessionId] == true end
	if session.Closed then return true end
	options = options or {}
	local preArena = session.State == Constants.RoundState.Waiting
		or session.State == Constants.RoundState.MatchReady or session.State == Constants.RoundState.MatchCountdown
		or session.State == Constants.RoundState.MapSelection or session.State == Constants.RoundState.MapLoading
		or session.State == Constants.RoundState.StartCountdown
	if preArena and not (session :: any).ArenaTransferred and not session.GameplayRound and not session.Results then
		return self:_closePrematch(session,options.Reason)
	end
	if options.DeferCleanup ~= true and session.Results then
		session.Results.Celebrating = false
		if session.Results.FeedbackThread then pcall(task.cancel, session.Results.FeedbackThread); session.Results.FeedbackThread = nil end
		local feedback = self._context and self._context:GetService("PointFeedbackService")
		if feedback then feedback:CleanupMatch(session.Id) end
	end
	if options.DeferCleanup ~= true and session.ResultsThread and session.ResultsThread ~= coroutine.running() then
		pcall(task.cancel, session.ResultsThread)
		session.ResultsThread = nil
	end

	if not session.CloseStarted then
		if session.GameplayRound and not session.GameplayRound.Resolved then session.GameplayRound.Resolved="Closed" end
		self:CancelGameplayRecoveries(session)
		session.CloseStarted = true
		session.Closing = true
		session.Cancelled = options.Cancelled == true
		if session.Result == nil then
			session.Result = options.Result or (if session.Cancelled then Constants.MatchResult.Cancelled else Constants.MatchResult.Draw)
		end
		session.Votes = {}
		session.RemainingTime = nil
		(session :: any).AwardRewards = options.AwardRewards == true

		local runningThread = coroutine.running()
		if session.SessionThread and session.SessionThread ~= runningThread then
			pcall(task.cancel, session.SessionThread)
		end
		session.SessionThread = nil
		if session.PointRestartThread and session.PointRestartThread ~= runningThread then
			pcall(task.cancel, session.PointRestartThread)
		end
		session.PointRestartThread = nil
	end

	local scoreService = self:_getScoreService()
	local beginOk = self:_runCloseStep(session, "StopScoring", function()
		if scoreService then scoreService:StopScoring(session.Id) end
		return true
	end)

	if (session :: any).AwardRewards == true and not session.Cancelled then
		beginOk = self:_runCloseStep(session, "Rewards", function()
			self:_processReward(session, session.Result :: MatchResultName)
			return true
		end) and beginOk
	end

	if options.DeferCleanup == true then
		return beginOk
	end

	if session.State ~= Constants.RoundState.ReturningToLobby then
		self:SetSessionState(session.Id, Constants.RoundState.ReturningToLobby, { Reason = options.Reason }, true)
	end
	if session.Cancelled and not session.CloseSteps.CancelNotification then
		self:_broadcastCountdown(session.Id, 0, "CANCELLED", { Cancelled = true })
		self:_broadcastResult(session.Id, Constants.MatchResult.Cancelled, nil)
		session.CloseSteps.CancelNotification = true
	end

	local eliminationService = self:_getEliminationService()
	local combatService = self:_getCombatService()
	local slapService = self:_getSlapService()
	local spawnService = self:_getSpawnService()
	local matchInstanceService = self:_getMatchInstanceService()

	local criticalOk = beginOk
	criticalOk = self:_runCloseStep(session, "Abilities", function()
		local abilities = self._context and self._context:GetService("AbilityService")
		if abilities then abilities:CleanupSession(session.Id,"Closed") end
		return true
	end) and criticalOk
	criticalOk = self:_runCloseStep(session, "Eliminations", function()
		if eliminationService then eliminationService:UnbindMatch(session.Id) end
		return true
	end) and criticalOk
	criticalOk = self:_runCloseStep(session, "CombatTags", function()
		if combatService then combatService:ClearMatch(session.Id) end
		return true
	end) and criticalOk
	criticalOk = self:_runCloseStep(session, "RestoreAndReturn", function()
		if session.Results then
			local returned = true
			for player in pairs(session.Results.Viewers) do
				if not self:_returnResultsPlayer(session, player) then returned = false end
			end
			return returned
		end
		if not spawnService then return session.InstanceInfo == nil end
		local participants = spawnService:GetSessionParticipants(session)
		if not session.GameplayRound and (session :: any).TransferredPlayers then
			-- Partial initial transfer: restore only those actually moved; pad occupants stay put.
			participants = {}
			for player in pairs((session :: any).TransferredPlayers) do table.insert(participants,player) end
		end
		return spawnService:ReturnPlayersToLobby(participants, nil)
	end) and criticalOk
	criticalOk = self:_runCloseStep(session, "Slaps", function()
		if slapService then
			local isSimulated = false
			for _, part in ipairs(session.Participants) do
				if typeof(part.Player) == "table" and (part.Player :: any).IsSimulatedPlayer then
					isSimulated = true
					break
				end
			end
			if not isSimulated then
				for _, participant in ipairs(session.Participants) do
					if participant.State ~= "Left" and participant.State ~= "Released" then
						slapService:UnlockPlayer(participant.Player)
						slapService:RemoveSlaps(participant.Player)
					end
				end
			end
		end
		return true
	end) and criticalOk
	criticalOk = self:_runCloseStep(session, "Identity", function()
		clearMatchIdentity(session)
		return true
	end) and criticalOk
	criticalOk = self:_runCloseStep(session, "InstanceAndArenaSlot", function()
			-- A failed physical return retains the scene and slot for quarantine/retry.
			if not criticalOk then return false end
		if matchInstanceService then return matchInstanceService:DestroyInstance(session.Id) end
		return session.InstanceInfo == nil
	end) and criticalOk
	criticalOk = self:_runCloseStep(session, "ScoreResources", function()
		if scoreService then scoreService:CleanupSession(session.Id) end
		return true
	end) and criticalOk

	if not criticalOk then
		warn(string.format("[RoundService] Sesión '%s' permanece en cuarentena; cierre parcial pendiente", session.Id))
		return false
	end

	self:_releaseSession(session)
	self:_setState(Constants.RoundState.Waiting, { Reason = options.Reason })
	print(string.format("[RoundService] Sesión '%s' cerrada sin recursos pendientes", session.Id))
	return true
end

function RoundService:_cancelMatchPreparation(reason: string, sessionId: SessionId?)
	local session = if sessionId then self._sessionsById[sessionId] else self:GetSession()
	if not session or (session.State ~= Constants.RoundState.MatchReady and session.State ~= Constants.RoundState.MatchCountdown) then return end
	self:CloseSession(session.Id, { Cancelled = true, Result = Constants.MatchResult.Cancelled, Reason = reason })
end

function RoundService:_cancelSession(reason: string, sessionId: SessionId?)
	local session = if sessionId then self._sessionsById[sessionId] else self:GetSession()
	if not session then return end
	self:CloseSession(session.Id, { Cancelled = true, Result = Constants.MatchResult.Cancelled, Reason = reason })
end

-- Adaptador interno para consumidores anteriores; todo converge en CloseSession.
function RoundService:_cleanupSession(sessionId: SessionId?)
	local session = if sessionId then self._sessionsById[sessionId] else self:GetSession()
	if session then self:CloseSession(session.Id) end
end

return RoundService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="555">
        <Properties>
          <string name="Name">ScoreService</string>
          <string name="Source"><![CDATA[--!strict
-- ScoreService
-- Responsabilidad exclusiva:
-- - Mantener el score de cada MatchSession.
-- - Detectar anotaciones físicas en ZoneWin (RedWin y BlueWin).
-- - Validar autoritativamente en servidor las anotaciones:
--     RED + RedWin = RED +1
--     BLUE + BlueWin = BLUE +1
--     RED + BlueWin = NO SCORE
--     BLUE + RedWin = NO SCORE
-- - Evitar dobles anotaciones mediante control granular (Match + Player + Zone).
-- - Soportar reingreso (re-entry) tras salir de la zona.
-- - Detectar Match Point ("ÚLTIMO PUNTO PARA GANAR LA PARTIDA") al alcanzar WinningScore - 1.
-- - Detectar victoria inmediata al alcanzar WinningScore (5) sin esperar al timer.
-- - Informar a RoundService del resultado.
-- NO administra mapas, spawn, matchmaking, hud ni timers directamente.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local ArenaRespawnPolicy = require(ReplicatedStorage.Shared.ArenaRespawnPolicy)
local Config = require(ReplicatedStorage.Shared.Config)
local Constants = require(ReplicatedStorage.Shared.Constants)
local Types = require(ReplicatedStorage.Shared.Types)

type MatchSession = Types.MatchSession
type MatchScore = Types.MatchScore
type MatchResultName = Types.MatchResultName

local ScoreService = {}
ScoreService.Name = "ScoreService"

-- Estado interno
ScoreService._context = nil :: any
ScoreService._scores = {} :: { [string]: MatchScore }
ScoreService._matchPointAnnounced = {} :: { [string]: { [string]: boolean } } -- matchId -> team -> boolean
ScoreService._playersInside = {} :: { [string]: { [string]: { [Player]: boolean } } } -- matchId -> zoneName -> player -> boolean
ScoreService._pointInProgress = {} :: { [string]: boolean } -- matchId -> boolean (bloqueo atómico durante reset de punto)
ScoreService._connections = {} :: { [string]: { RBXScriptConnection } }
ScoreService._sweepThreads = {} :: { [string]: thread }
ScoreService._spatialThreads = {} :: { [string]: thread }
ScoreService._resetThreads = {} :: { [string]: thread }

-- Remotes requeridos
local function ensureRemoteFolder(parent: Instance, name: string): Folder
	local folder = parent:FindFirstChild(name)
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = name
		folder.Parent = parent
	end
	return folder :: Folder
end

local function ensureRemoteEvent(parent: Instance, name: string): RemoteEvent
	local event = parent:FindFirstChild(name)
	if not event then
		event = Instance.new("RemoteEvent")
		event.Name = name
		event.Parent = parent
	end
	return event :: RemoteEvent
end

function ScoreService:_ensureRemotes()
	local remotesFolder = ensureRemoteFolder(ReplicatedStorage, "Remotes")
	local matchFolder = ensureRemoteFolder(remotesFolder, "Match")

	ensureRemoteEvent(matchFolder, "ScoreUpdated")
	ensureRemoteEvent(matchFolder, "LastPoint")
end

function ScoreService:_getRemote(eventName: string): RemoteEvent?
	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	local matchFolder = remotes and remotes:FindFirstChild("Match")
	local event = matchFolder and matchFolder:FindFirstChild(eventName)
	if event and event:IsA("RemoteEvent") then
		return event
	end
	return nil
end

function ScoreService:Init(context)
	self._context = context
	self._scores = {}
	self._matchPointAnnounced = {}
	self._playersInside = {}
	self._pointInProgress = {}
	self._connections = {}
	self._sweepThreads = {}
	self._spatialThreads = {}
	self._resetThreads = {}

	self:_ensureRemotes()
end

function ScoreService:Start(context)
	self._context = context
	print("[ScoreService] Servicio de puntuación iniciado y listo")
end

function ScoreService:IsPointInProgress(matchId: string): boolean
	return self._pointInProgress[matchId] == true
end

-- Obtiene el Player a partir de cualquier BasePart del personaje de forma robusta
local function getPlayerFromPart(part: BasePart): Player?
	if not part or not part:IsA("BasePart") then return nil end

	-- Buscar hacia arriba en la jerarquía hasta encontrar un Model con Humanoid perteneciente a un Player
	local current: Instance? = part
	while current and current ~= workspace do
		if current:IsA("Model") then
			local humanoid = current:FindFirstChildOfClass("Humanoid")
			if humanoid then
				local player = Players:GetPlayerFromCharacter(current)
				if player then
					return player
				end
			end
		end
		current = current.Parent
	end
	return nil
end

function ScoreService:_getPlayerFromPart(part: BasePart): any?
	if self._customPlayerResolver then
		local p = self._customPlayerResolver(part)
		if p then return p end
	end
	return getPlayerFromPart(part)
end

function ScoreService:_getRoundService()
	if self._context and self._context.GetService then
		local s = self._context:GetService("RoundService")
		if s then return s end
	end

	local servicesFolder = ServerScriptService:FindFirstChild("Services")
	local mod = servicesFolder and servicesFolder:FindFirstChild("RoundService")
	if mod and mod:IsA("ModuleScript") then
		local ok, result = pcall(require, mod)
		if ok then return result end
	end
	return nil
end

function ScoreService:_getEliminationService(): any
 return self._context and self._context:GetService("EliminationService")
end

function ScoreService:_getPlayerService()
	if self._context and self._context.GetService then
		local s = self._context:GetService("PlayerService")
		if s then return s end
	end

	local servicesFolder = ServerScriptService:FindFirstChild("Services")
	local mod = servicesFolder and servicesFolder:FindFirstChild("PlayerService")
	if mod and mod:IsA("ModuleScript") then
		local ok, result = pcall(require, mod)
		if ok then return result end
	end
	return nil
end

function ScoreService:_getSpawnService()
	if self._context and self._context.GetService then
		local s = self._context:GetService("SpawnService")
		if s then return s end
	end

	local servicesFolder = ServerScriptService:FindFirstChild("Services")
	local mod = servicesFolder and servicesFolder:FindFirstChild("SpawnService")
	if mod and mod:IsA("ModuleScript") then
		local ok, result = pcall(require, mod)
		if ok then return result end
	end
	return nil
end

function ScoreService:_getPointFeedbackService()
	if self._context and self._context.GetService then
		local s = self._context:GetService("PointFeedbackService")
		if s then return s end
	end

	local servicesFolder = ServerScriptService:FindFirstChild("Services")
	local mod = servicesFolder and servicesFolder:FindFirstChild("PointFeedbackService")
	if mod and mod:IsA("ModuleScript") then
		local ok, result = pcall(require, mod)
		if ok then return result end
	end
	return nil
end

-- Valida que el mapa físico instanciado contenga el contrato ZoneWin completo
function ScoreService:ValidateZoneWin(session: MatchSession): boolean
	if not session or not session.InstanceInfo then
		warn("[ScoreService] MatchSession o InstanceInfo no disponibles para validación")
		return false
	end

	local info = session.InstanceInfo
	local zoneWin = info.ZoneWin
	local redWin = info.RedWin
	local blueWin = info.BlueWin

	if not zoneWin or not zoneWin:IsDescendantOf(workspace) then
		warn(string.format("[ScoreService] Missing ZoneWin in match '%s'", session.Id))
		return false
	end

	if not redWin or not redWin:IsA("BasePart") or not redWin:IsDescendantOf(workspace) then
		warn(string.format("[ScoreService] Missing ZoneWin.RedWin in match '%s'", session.Id))
		return false
	end

	if not blueWin or not blueWin:IsA("BasePart") or not blueWin:IsDescendantOf(workspace) then
		warn(string.format("[ScoreService] Missing ZoneWin.BlueWin in match '%s'", session.Id))
		return false
	end

	return true
end

-- Determina el equipo de un jugador dentro de la sesión (soporta 1v1 y colecciones futuras)
function ScoreService:GetPlayerTeam(session: MatchSession, player: Player): ("Red" | "Blue")?
	if not session or not player then return nil end
	local roundService = self:_getRoundService()
	if not roundService or type(roundService.GetSessionParticipant) ~= "function" then return nil end
	local participant = roundService:GetSessionParticipant(session.Id, player)
	return if participant then participant.Team else nil
end

-- Valida las reglas estrictas de anotación:
-- RED + RedWin -> Válido (anota Red)
-- BLUE + BlueWin -> Válido (anota Blue)
-- RED + BlueWin -> Inválido
-- BLUE + RedWin -> Inválido
function ScoreService:_validateScorer(session: MatchSession, zoneName: string, player: Player): (boolean, ("Red" | "Blue")?)
	local character = player.Character
	if not character or not character.Parent then return false,nil end
	local humanoid=character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health<=0 then return false,nil end
	if typeof(character) == "Instance" and character:GetAttribute("ArenaRespawnPending") then return false, nil end
	local roundService = self:_getRoundService()
	if not roundService or type(roundService.IsSessionActive) ~= "function"
		or not roundService:IsSessionActive(session.Id) then
		return false, nil
	end
	local currentState = roundService:GetSessionState(session.Id)
	if not roundService:IsGameplayRoundOpen(session) then return false,nil end

	-- 1. Verificar que el match esté en Playing
	if currentState ~= Constants.RoundState.Playing then
		return false, nil
	end

	-- 2. Verificar pertenencia de equipo
	local playerTeam = self:GetPlayerTeam(session, player)
	if not playerTeam then
		-- El jugador no pertenece a esta partida
		return false, nil
	end

	-- 3. Comparar equipo con la zona física
	if playerTeam == "Red" and zoneName == "RedWin" then
		return true, "Red"
	elseif playerTeam == "Blue" and zoneName == "BlueWin" then
		return true, "Blue"
	end

	-- Cualquier otra combinación (ej. Red en BlueWin o Blue en RedWin) no anota
	return false, nil
end

-- Inicia el seguimiento de score y eventos de detección física para una sesión
function ScoreService:StartScoring(session: MatchSession)
	if not session or not session.InstanceInfo then
		warn("[ScoreService] No se puede iniciar scoring: sesión o mapa físico inválido")
		return
	end

	local matchId = session.Id
	local roundService = self:_getRoundService()
	if not roundService or type(roundService.IsSessionActive) ~= "function"
		or not roundService:IsSessionActive(matchId)
		or roundService:GetSessionById(matchId) ~= session then
		warn(string.format("[ScoreService] No se puede iniciar scoring: sesión '%s' no vigente", matchId))
		return
	end
	self:StopScoring(matchId)

	-- Inicializar score
	local score: MatchScore = {
		Red = 0,
		Blue = 0,
	}
	self._scores[matchId] = score
	session.Score = score
	self._matchPointAnnounced[matchId] = {
		Red = false,
		Blue = false,
	}
	self._playersInside[matchId] = {
		RedWin = {},
		BlueWin = {},
	}
	self._pointInProgress[matchId] = false
	self._connections[matchId] = {}

	local info = session.InstanceInfo
	local redWin = info.RedWin
	local blueWin = info.BlueWin

	if not redWin or not blueWin then
		warn(string.format("[ScoreService] RedWin o BlueWin ausentes para match '%s'", matchId))
		return
	end

	-- Suscribir eventos de detección para RedWin
	self:_setupZoneEvents(session, "RedWin", redWin)

	-- Suscribir eventos de detección para BlueWin
	self:_setupZoneEvents(session, "BlueWin", blueWin)

	-- Hilo de verificación periódica para limpiar estados si el personaje sale sin disparar TouchEnded
	self._sweepThreads[matchId] = task.spawn(function()
		while self._scores[matchId] ~= nil do
			task.wait(0.25)
			if not roundService:IsSessionActive(matchId)
				or roundService:GetSessionById(matchId) ~= session then break end
			self:_sweepExits(session, redWin, blueWin)
		end
	end)

	-- Hilo de detección espacial continua y robusta (segunda capa para garantizar scoring sin pérdidas por tunneling)
	self._spatialThreads[matchId] = task.spawn(function()
		while self._scores[matchId] ~= nil do
			task.wait(0.05)
			if not roundService:IsSessionActive(matchId)
				or roundService:GetSessionById(matchId) ~= session then break end
			self:_checkSpatialScoring(session)
		end
	end)

	-- Emitir score inicial a los clientes
	self:_broadcastScore(matchId, score, nil, nil)

	print(string.format("[ScoreService] Scoring iniciado para Match '%s' (0 - 0)", matchId))
end

function ScoreService:_setupZoneEvents(session: MatchSession, zoneName: string, zonePart: BasePart)
	local matchId = session.Id
	local connections = self._connections[matchId]
	if not connections then return end

	local touchConn = zonePart.Touched:Connect(function(hitPart: BasePart)
		self:_onZoneTouched(session, zoneName, hitPart)
	end)
	table.insert(connections, touchConn)

	local touchEndConn = zonePart.TouchEnded:Connect(function(hitPart: BasePart)
		self:_onZoneTouchEnded(session, zoneName, zonePart, hitPart)
	end)
	table.insert(connections, touchEndConn)
end

function ScoreService:_onZoneTouched(session: MatchSession, zoneName: string, hitPart: BasePart)
	local matchId = session.Id
	local player = self:_getPlayerFromPart(hitPart)

	-- Logs de diagnóstico requeridos para validación en Studio
	if player then
		local roundService = self:_getRoundService()
		local currentState = if roundService and type(roundService.GetSessionState) == "function"
			then roundService:GetSessionState(matchId)
			else nil
		local team = self:GetPlayerTeam(session, player)
		print(string.format("[ScoreService] Zone touched: %s", zoneName))
		print(string.format("[ScoreService] Touching instance: %s (%s)", hitPart:GetFullName(), hitPart.ClassName))
		print(string.format("[ScoreService] Resolved player: %s", player.Name))
		print(string.format("[ScoreService] Player team: %s", tostring(team)))
		print(string.format("[ScoreService] Match: %s", matchId))
		print(string.format("[ScoreService] Match state: %s", tostring(currentState)))
	end

	self:_handleZoneScoring(session, zoneName, player, hitPart)
end

-- Manejador centralizado y atómico de anotación (llamado por Touched o por detección espacial)
function ScoreService:_handleZoneScoring(session: MatchSession, zoneName: string, player: Player?, hitPart: BasePart?)
	if not player then return end
	local matchId = session.Id

	-- 1. Operación atómica: Si la ronda de punto actual está bloqueada por reset o victoria, ignorar inmediatamente
	if self._pointInProgress[matchId] then
		return
	end

	local matchZones = self._playersInside[matchId]
	if not matchZones then return end
	local insideZone = matchZones[zoneName]
	if not insideZone then return end

	-- Si el jugador ya fue registrado dentro de esta zona en esta ronda, no volver a sumar (STAY -> NO SCORE)
	if insideZone[player] then
		return
	end

	-- 2. Validar pertenencia de equipo, estado Playing y zona correspondiente
	local isValid, team = self:_validateScorer(session, zoneName, player)
	if not isValid or not team then
		return
	end

	local score = self._scores[matchId]
 if not score then return end
 local character=player.Character
 if not character then return end
 local zone=if team=="Red" then session.InstanceInfo and session.InstanceInfo.RedWin else session.InstanceInfo and session.InstanceInfo.BlueWin
 if hitPart and (not hitPart:IsDescendantOf(character) or not zone
  or not ArenaRespawnPolicy.IsContactCurrent(zone.CFrame,zone.Size,hitPart.Position,hitPart.Size)) then return end
 local pointId=string.format("%s_%s_%d_%d",matchId,team,score.Red+(if team=="Red" then 1 else 0),score.Blue+(if team=="Blue" then 1 else 0))
 local elimination=self:_getEliminationService()
 -- Fail closed if the central owner is absent; never commit an unprotected goal.
 if not elimination or not elimination:TryProtectGoal(session,player,character,pointId) then return end
 if not self:_getRoundService():TryResolveGameplayRound(session,"Goal") then return end

	self:_commitPoint(session,team,player,pointId)
end

-- Called only after EliminationService reserved this round's valid sudden-death fall.
function ScoreService:AwardSuddenDeathGoal(session: MatchSession,victim: Player,roundId: string): boolean
 local round=session.GameplayRound
 if not round or round.Id~=roundId or round.Resolved~="SuddenDeathFall" or self._pointInProgress[session.Id] then return false end
 local victimTeam=self:GetPlayerTeam(session,victim)
 if not victimTeam or not self._scores[session.Id] then return false end
 local team=if victimTeam=="Red" then "Blue" else "Red"
 self:_commitPoint(session,team,nil,round.Id..":FallGoal")
 return true
end

function ScoreService:_commitPoint(session: MatchSession,team: "Red"|"Blue",player: Player?,pointId: string)
 local matchId=session.Id
	-- 3. ATÓMICO: Bloquear scoring inmediatamente para prevenir dobles eventos por Touched repetido o múltiples partes
	self._pointInProgress[matchId] = true

	-- Marcar al jugador como dentro de la zona
	if player then self._playersInside[matchId][team=="Red" and "RedWin" or "BlueWin"][player]=true end

	print(string.format("[ScoreService] Valid scoring entry"))

	-- Incrementar score autoritativo
	local score=self._scores[matchId]
	if not score then return end
	score[team] += 1
	session.Score = score

	-- Registrar atómicamente el estado del PointScorer en la sesión para RoundService y EliminationService
	session.PointInProgress = true
	session.PointScorer = player
	session.PointScorerTeam = team
	session.PointScoreTimestamp = os.clock()
	session.PointNumber = score.Red + score.Blue
		local performanceOwner = self:_getRoundService()
		if player and performanceOwner and performanceOwner.RecordMatchPerformance then
			performanceOwner:RecordMatchPerformance(matchId, string.format("Goal_%d_%d", score.Red, score.Blue), player, nil, nil)
		end

	print(string.format("[ScoreService] PointScorer registrado: '%s' (Equipo %s, Punto %d, Match %s)",
		(if player then player.Name else "SuddenDeathTeamGoal"), team, session.PointNumber, matchId))

	print(string.format("[ScoreService] %s score incremented", team))

	-- 4. Recompensa personal configurada; el gol colectivo no inventa un receptor.
	local rewardAmount = if player then Config.Match.PointReward else 0
	local playerService = self:_getPlayerService()
	if player and playerService and playerService.AddCoins then
		playerService:AddCoins(player, rewardAmount, "MatchPoint", "Goal:" .. pointId)
	end

	print(string.format("[ScoreService] ¡ANOTACIÓN! %s anotó para %s (+%d Coins). Nuevo Score: Red=%d, Blue=%d",
		(if player then player.Name else "SuddenDeathTeamGoal"), team, rewardAmount, score.Red, score.Blue))

	-- 5. Emitir actualización a los clientes
	self:_broadcastScore(matchId, score, team, if player then player.Name else nil)

	-- 6. Disparar presentación audiovisual a través de PointFeedbackService
	local winningScore = (Config.Match and Config.Match.WinningScore) or 5
	local isFinalPoint = (score[team] >= winningScore)
	local scoringZone = if team == "Red"
		then (session.InstanceInfo and session.InstanceInfo.RedWin)
		else (session.InstanceInfo and session.InstanceInfo.BlueWin)
		-- Pass presentation data to the existing terminal owner; never replay scoring.
		if isFinalPoint then
			local roundService = self:_getRoundService()
			if roundService then roundService:DeclareSessionWinner(matchId, team, {
				PointId = string.format("%s_%s_%d_%d", matchId, team, score.Red, score.Blue),
				MatchId = matchId, ScoringTeam = team, ScoringPlayer = player,
				ScoringZone = scoringZone, IsFinalPoint = true, RedScore = score.Red, BlueScore = score.Blue,
			}) end
		end

	local pointFeedbackService = self:_getPointFeedbackService()
	if not session.GameplayFrozen and pointFeedbackService and pointFeedbackService.PlayPoint then
		local pointId = string.format("%s_%s_%d_%d", matchId, team, score.Red, score.Blue)
		local ok, err = pcall(function()
			pointFeedbackService:PlayPoint(session, {
				PointId = pointId,
				MatchId = matchId,
				ScoringTeam = team,
				ScoringPlayer = player,
				ScoringZone = scoringZone :: any,
				IsFinalPoint = isFinalPoint,
				RedScore = score.Red,
				BlueScore = score.Blue,
			})
		end)
		if not ok then
			warn(string.format("[ScoreService] Error no fatal al invocar PointFeedbackService: %s", tostring(err)))
		end
	end

	-- 7. Chequeo de Match Point (WinningScore - 1)
	if score[team] == winningScore - 1 then
		local announced = self._matchPointAnnounced[matchId]
		if announced and not announced[team] then
			announced[team] = true
			self:_broadcastLastPoint(matchId, team)
		end
	end

	-- 8. Chequeo de Victoria Inmediata al alcanzar WinningScore (5)
	if isFinalPoint then
		print(string.format("[ScoreService] ¡%s ALCANZÓ EL WINNING SCORE (%d)! Victoria inmediata.", team, winningScore))
		-- NO se realiza reset de posiciones al alcanzar winningScore (la partida pasa inmediatamente a Ending)
		return
	end

	-- 9. Si aún no se alcanza WinningScore, coordinar PointRestartCountdown con RoundService
	local roundService = self:_getRoundService()
	if roundService and roundService.TriggerPointRestart then
		roundService:TriggerPointRestart(session)
	else
		self:_schedulePointReset(session)
	end
end

-- Segunda capa de detección: Consulta espacial continua para evitar pérdidas por tunneling/velocidad en Touched
function ScoreService:_checkSpatialScoring(session: MatchSession)
	local matchId = session.Id
	if self._pointInProgress[matchId] then return end
	if not session.InstanceInfo then return end

	local redWin = session.InstanceInfo.RedWin
	local blueWin = session.InstanceInfo.BlueWin
	if not redWin or not blueWin then return end

	local roundService = self:_getRoundService()
	if not roundService or type(roundService.IsSessionActive) ~= "function"
		or not roundService:IsSessionActive(matchId) then return end
	local currentState = roundService:GetSessionState(matchId)
	if currentState ~= Constants.RoundState.Playing then return end

	local redPlayers: { Player } = {}
	local bluePlayers: { Player } = {}
	for _, participant in ipairs(session.Participants) do
		if roundService:GetSessionParticipant(matchId, participant.Player) == participant then
			if participant.Team == "Red" then
				table.insert(redPlayers, participant.Player)
			else
				table.insert(bluePlayers, participant.Player)
			end
		end
	end

	-- Verificar Red en RedWin
	for _, player in ipairs(redPlayers) do
		local char = player.Character
		if char and char.Parent and char:FindFirstChildOfClass("Humanoid") then
			local hum = char:FindFirstChildOfClass("Humanoid")
			if hum and hum.Health > 0 then
				local overlapParams = OverlapParams.new()
				overlapParams.FilterType = Enum.RaycastFilterType.Include
				overlapParams.FilterDescendantsInstances = { char }
				local parts = workspace:GetPartsInPart(redWin, overlapParams)
				if #parts > 0 then
					self:_handleZoneScoring(session, "RedWin", player, parts[1])
					return
				end
			end
		end
	end

	-- Verificar Blue en BlueWin
	for _, player in ipairs(bluePlayers) do
		local char = player.Character
		if char and char.Parent and char:FindFirstChildOfClass("Humanoid") then
			local hum = char:FindFirstChildOfClass("Humanoid")
			if hum and hum.Health > 0 then
				local overlapParams = OverlapParams.new()
				overlapParams.FilterType = Enum.RaycastFilterType.Include
				overlapParams.FilterDescendantsInstances = { char }
				local parts = workspace:GetPartsInPart(blueWin, overlapParams)
				if #parts > 0 then
					self:_handleZoneScoring(session, "BlueWin", player, parts[1])
					return
				end
			end
		end
	end
end

function ScoreService:_schedulePointReset(session: MatchSession)
	local matchId = session.Id

	-- Cancelar cualquier hilo previo si existiera
	local prevThread = self._resetThreads[matchId]
	if prevThread then
		pcall(task.cancel, prevThread)
	end

	self._resetThreads[matchId] = task.spawn(function()
		local delayTime = (Config.Match and Config.Match.PointResetDelay) or 1.5
		task.wait(delayTime)

		-- Validar que la partida siga activa y en estado Playing
		if not self._scores[matchId] then return end
		local roundService = self:_getRoundService()
		if not roundService or type(roundService.IsSessionActive) ~= "function"
			or not roundService:IsSessionActive(matchId)
			or roundService:GetSessionById(matchId) ~= session
			or roundService:GetSessionState(matchId) ~= Constants.RoundState.Playing then return end

		-- Reposicionar ambos equipos en sus spawns respectivos de la arena activa
		local spawnService = self:_getSpawnService()
		if not spawnService then return end
		local result=spawnService:SpawnMatchPlayers(session)
		if not result.Success then return end

		-- Limpiar registro de presencia en zonas para la nueva ronda de punto
		self._playersInside[matchId] = {
			RedWin = {},
			BlueWin = {},
		}

		-- Breve margen de estabilización física antes de reabrir scoring
		task.wait(0.2)
		if not self._scores[matchId]
			or not roundService:IsSessionActive(matchId)
			or roundService:GetSessionById(matchId) ~= session
			or roundService:GetSessionState(matchId) ~= Constants.RoundState.Playing then return end

		self:ResumeScoring(matchId)
		roundService:BeginGameplayRound(session)
		self._resetThreads[matchId] = nil
		print(string.format("[ScoreService] Nueva ronda de punto iniciada para Match '%s'. Score acumulado: Red=%d, Blue=%d",
			matchId, session.Score.Red, session.Score.Blue))
	end)
end

function ScoreService:_onZoneTouchEnded(session: MatchSession, zoneName: string, zonePart: BasePart, hitPart: BasePart)
	local matchId = session.Id
	local player = self:_getPlayerFromPart(hitPart)
	if not player then return end

	local matchZones = self._playersInside[matchId]
	if not matchZones then return end
	local insideZone = matchZones[zoneName]
	if not insideZone or not insideZone[player] then return end

	-- Verificar si el personaje realmente salió por completo de la zona
	local character = player.Character
	if not character or not character.Parent then
		insideZone[player] = nil
		return
	end

	local overlapParams = OverlapParams.new()
	overlapParams.FilterType = Enum.RaycastFilterType.Include
	overlapParams.FilterDescendantsInstances = { character }

	local touchingParts = workspace:GetPartsInPart(zonePart, overlapParams)
	if #touchingParts == 0 then
		insideZone[player] = nil
	end
end

-- Limpieza periódica para detectar salidas de personajes que no dispararon TouchEnded
function ScoreService:_sweepExits(session: MatchSession, redWin: BasePart, blueWin: BasePart)
	local matchId = session.Id
	local matchZones = self._playersInside[matchId]
	if not matchZones then return end

	local checkZone = function(zoneName: string, zonePart: BasePart)
		local insideZone = matchZones[zoneName]
		if not insideZone then return end

		for player, isInside in pairs(insideZone) do
			if isInside then
				local character = player.Character
				if not character or not character.Parent or not player:IsDescendantOf(Players) then
					insideZone[player] = nil
				else
					local overlapParams = OverlapParams.new()
					overlapParams.FilterType = Enum.RaycastFilterType.Include
					overlapParams.FilterDescendantsInstances = { character }
					local touching = workspace:GetPartsInPart(zonePart, overlapParams)
					if #touching == 0 then
						insideZone[player] = nil
					end
				end
			end
		end
	end

	if redWin and redWin:IsDescendantOf(workspace) then
		checkZone("RedWin", redWin)
	end
	if blueWin and blueWin:IsDescendantOf(workspace) then
		checkZone("BlueWin", blueWin)
	end
end

function ScoreService:_broadcastScore(matchId: string, score: MatchScore, scoringTeam: string?, scoringPlayer: string?)
	local roundService = self:_getRoundService()
	if roundService and type(roundService.FireSessionRemote) == "function" then
		roundService:FireSessionRemote(matchId, "Match", "ScoreUpdated", {
			SessionId = matchId,
			MatchId = matchId,
			StateVersion = roundService:GetSessionById(matchId) and roundService:GetSessionById(matchId).StateVersion or nil,
			Red = score.Red,
			Blue = score.Blue,
			ScoringTeam = scoringTeam,
			ScoringPlayer = scoringPlayer,
		})
	end
end

function ScoreService:_broadcastLastPoint(matchId: string, team: string)
	local roundService = self:_getRoundService()
	if roundService and type(roundService.FireSessionRemote) == "function" then
		roundService:FireSessionRemote(matchId, "Match", "LastPoint", {
			SessionId = matchId,
			MatchId = matchId,
			StateVersion = roundService:GetSessionById(matchId) and roundService:GetSessionById(matchId).StateVersion or nil,
			Team = team,
			Message = "ÚLTIMO PUNTO PARA GANAR LA PARTIDA",
		})
	end
	print(string.format("[ScoreService] Match Point emitido para equipo '%s'", team))
end

-- Determina el ganador al finalizar el timer
function ScoreService:GetWinner(session: MatchSession): MatchResultName
	local matchId = session.Id
	local score = self._scores[matchId] or session.Score
	if not score then
		return Constants.MatchResult.Draw
	end

	if score.Red > score.Blue then
		return Constants.MatchResult.Red
	elseif score.Blue > score.Red then
		return Constants.MatchResult.Blue
	else
		return Constants.MatchResult.Draw
	end
end

function ScoreService:GetScore(matchId: string): MatchScore?
	return self._scores[matchId]
end

-- Limpia el registro de presencia de jugadores en zonas para una nueva ronda de punto
function ScoreService:ResetZonePresences(matchId: string)
	self._playersInside[matchId] = {
		RedWin = {},
		BlueWin = {},
	}
end

-- Reanuda el scoring autoritativo al finalizar el countdown y limpia el estado de punto
function ScoreService:ResumeScoring(matchId: string)
	local elimination=self:_getEliminationService()
	if elimination then elimination:ReleaseGoalProtections(matchId) end
	self._pointInProgress[matchId] = false
	self:ClearPointState(matchId)
end

-- Limpia de forma explícita el estado temporal de PointScorer asociado a la sesión del match
function ScoreService:ClearPointState(matchId: string)
	self._pointInProgress[matchId] = false
	local roundService = self:_getRoundService()
	local session = nil
	if roundService and type(roundService.GetSessionById) == "function" then
		session = roundService:GetSessionById(matchId)
	end
	if session then
		session.PointInProgress = false
		session.PointScorer = nil
		session.PointScorerTeam = nil
		session.PointScoreTimestamp = nil
		session.PointNumber = nil
	end
end

-- Pausa temporal de scoring durante secuencias o pausas
function ScoreService:PauseScoring(matchId: string)
	self._pointInProgress[matchId] = true
end

-- Detiene el scoring y desconecta eventos físicos
function ScoreService:StopScoring(matchId: string)
	self:ClearPointState(matchId)
	local conns = self._connections[matchId]
	if conns then
		for _, conn in ipairs(conns) do
			conn:Disconnect()
		end
		self._connections[matchId] = nil
	end

	local thread = self._sweepThreads[matchId]
	if thread then
		pcall(task.cancel, thread)
		self._sweepThreads[matchId] = nil
	end

	local spatialThread = self._spatialThreads[matchId]
	if spatialThread then
		pcall(task.cancel, spatialThread)
		self._spatialThreads[matchId] = nil
	end

	local resetThread = self._resetThreads[matchId]
	if resetThread then
		pcall(task.cancel, resetThread)
		self._resetThreads[matchId] = nil
	end

	self._playersInside[matchId] = nil
	self._pointInProgress[matchId] = nil
end

-- Limpieza total de recursos de una partida
function ScoreService:CleanupSession(matchId: string)
	self:StopScoring(matchId)
	self._scores[matchId] = nil
	self._matchPointAnnounced[matchId] = nil
	self._pointInProgress[matchId] = nil

	local pointFeedbackService = self:_getPointFeedbackService()
	if pointFeedbackService and pointFeedbackService.CleanupMatch then
		pointFeedbackService:CleanupMatch(matchId)
	end

	print(string.format("[ScoreService] Limpieza completada para Match '%s'", matchId))
end

return ScoreService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="556">
        <Properties>
          <string name="Name">ShopService</string>
          <string name="Source"><![CDATA[--!strict
-- ShopService
-- Orquestador transaccional central del Shop Framework.
-- Responsabilidades:
-- - Registro y resolución desacoplada de ProductProviders vía ShopRegistry.
-- - Validación autoritativa de productos, disponibilidad y bloqueos transaccionales.
-- - Enrutamiento de divisas (Coins vs Robux) sin acoplamiento a categorías de productos.
-- - Preparación de la API de compra (PurchaseProduct), equipamiento (EquipProduct) y desequipamiento (UnequipProduct).
-- Coins cosmetics commit through PlayerService; success confirms memory only, not durable storage.
-- Robux remains disabled.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Types = require(ReplicatedStorage.Shared.Types)

type ProductDefinition = Types.ProductDefinition
type ProductProvider = Types.ProductProvider

local ShopService = {}
ShopService.Name = "ShopService"

ShopService._context = nil :: any
ShopService._registry = nil :: any
ShopService._playerService = nil :: any
ShopService._inProgressPurchases = {} :: { [any]: boolean }

-- Utilidad para garantizar carpetas en la jerarquía
local function ensureFolder(parent: Instance, name: string): Folder
	local existing = parent:FindFirstChild(name)
	if existing and existing:IsA("Folder") then
		return existing
	end
	local folder = Instance.new("Folder")
	folder.Name = name
	folder.Parent = parent
	return folder
end

-- ==================================================
-- INICIALIZACIÓN DEL SERVICIO
-- ==================================================

function ShopService:Init(context: any)
	self._context = context
	self._inProgressPurchases = {}

	-- Asegurar la existencia del namespace de remotes para la tienda
	local remotesFolder = ensureFolder(ReplicatedStorage, "Remotes")
	ensureFolder(remotesFolder, "Shop")

	-- Resolver ShopRegistry
	self:_getRegistryInternal()

	-- Auto-registrar PointEffectProvider
	self:_registerDefaultProviders()

	-- Exponer la Remote API del Shop al cliente (delegada en ShopRemotes)
	local shopFolder = ServerScriptService:FindFirstChild("Shop")
	local remotesMod = shopFolder and shopFolder:FindFirstChild("ShopRemotes")
	if remotesMod and remotesMod:IsA("ModuleScript") then
		local ok, err = pcall(function()
			require(remotesMod):Init(self)
		end)
		if not ok then
			warn(string.format("[ShopService] No se pudo inicializar ShopRemotes: %s", tostring(err)))
		end
	else
		warn("[ShopService] ShopRemotes no encontrado; la tienda no estará disponible para el cliente")
	end
end

function ShopService:_registerDefaultProviders()
	local shopFolder = ServerScriptService:FindFirstChild("Shop")
	local providersFolder = shopFolder and shopFolder:FindFirstChild("Providers")
	if providersFolder then
		local pepMod = providersFolder:FindFirstChild("PointEffectProvider")
		if pepMod and pepMod:IsA("ModuleScript") then
			local ok, pep = pcall(require, pepMod)
			if ok and pep and not self:GetProvider(pep:GetCategory()) then
				self:RegisterProvider(pep)
			end
		end
	end

	-- Fallback relativo si la estructura aún no cargó completamente
	if not self:GetProvider("PointEffects") then
		local ok, pep = pcall(function()
			return require(script.Parent.Parent.Shop.Providers.PointEffectProvider)
		end)
		if ok and pep and not self:GetProvider("PointEffects") then
			self:RegisterProvider(pep)
		end
	end
	if not self:GetProvider("DeathEffects") then
		local provider = require(script.Parent.Parent.Shop.Providers.DeathEffectProvider)
		self:RegisterProvider(provider)
	end
	if not self:GetProvider("Abilities") then
		self:RegisterProvider(require(script.Parent.Parent.Shop.Providers.AbilityProvider))
	end
end

function ShopService:Start(context: any)
	self._context = context
	self:_registerDefaultProviders()
	print("[ShopService] Orquestador transaccional de tienda iniciado y listo")
end

-- ==================================================
-- RESOLUCIÓN DE DEPENDENCIAS
-- ==================================================

function ShopService:_getRegistryInternal(): any
	if self._registry then
		return self._registry
	end

	-- 1. Intentar resolver mediante ServerScriptService.Shop.ShopRegistry
	local shopFolder = ServerScriptService:FindFirstChild("Shop")
	if shopFolder then
		local regMod = shopFolder:FindFirstChild("ShopRegistry")
		if regMod and regMod:IsA("ModuleScript") then
			local ok, mod = pcall(require, regMod)
			if ok and mod then
				self._registry = mod
				return mod
			end
		end
	end

	-- 2. Fallback de resolución relativa directa para tests / bootstrap
	local ok, mod = pcall(function()
		return require(script.Parent.Parent.Shop.ShopRegistry)
	end)
	if ok and mod then
		self._registry = mod
		return mod
	end

	warn("[ShopService] No se pudo resolver ShopRegistry automáticamente")
	return nil
end

function ShopService:GetRegistry(): any
	return self:_getRegistryInternal()
end

function ShopService:SetRegistry(registry: any)
	self._registry = registry
end

function ShopService:_getPlayerService(): any
	if self._playerService then
		return self._playerService
	end
	if self._context and type(self._context.GetService) == "function" then
		local s = self._context:GetService("PlayerService")
		if s then
			self._playerService = s
			return s
		end
	end
	local servicesFolder = ServerScriptService:FindFirstChild("Services")
	local mod = servicesFolder and servicesFolder:FindFirstChild("PlayerService")
	if mod and mod:IsA("ModuleScript") then
		local ok, result = pcall(require, mod)
		if ok and result then
			self._playerService = result
			return result
		end
	end
	return nil
end

-- ==================================================
-- API DEL REGISTRO (DELEGACIÓN)
-- ==================================================

-- Registra un ProductProvider delegando en ShopRegistry
function ShopService:RegisterProvider(provider: ProductProvider)
	local registry = self:GetRegistry()
	assert(registry, "[ShopService] Registry no disponible para registrar provider")
	registry:Register(provider)
end

-- Obtiene el ProductProvider correspondiente a una categoría
function ShopService:GetProvider(category: string): ProductProvider?
	local registry = self:GetRegistry()
	if not registry then return nil end
	return registry:GetProvider(category)
end

-- Obtiene el catálogo unificado de productos (o filtrado por categoría si se especifica)
function ShopService:GetCatalog(category: string?): { ProductDefinition }
	local registry = self:GetRegistry()
	if not registry then return {} end
	if category and category ~= "" then
		return registry:GetCategoryProducts(category)
	end
	return registry:GetCatalog()
end

-- Obtiene un producto por su Id
function ShopService:GetProduct(productId: string, category: string?): ProductDefinition?
	local registry = self:GetRegistry()
	if not registry then return nil end
	return registry:GetProduct(productId, category)
end

-- Obtiene un producto por su RobloxProductId
function ShopService:GetProductByRobloxId(robloxId: number): ProductDefinition?
	local registry = self:GetRegistry()
	if not registry then return nil end
	return registry:GetProductByRobloxId(robloxId)
end

-- ==================================================
-- GESTIÓN DE BLOQUEOS TRANSACCIONALES (IN-FLIGHT LOCKS)
-- ==================================================

function ShopService:IsTransactionInProgress(player: any): boolean
	return self._inProgressPurchases[player] == true
end

function ShopService:_setTransactionLock(player: any, locked: boolean)
	if locked then
		self._inProgressPurchases[player] = true
	else
		self._inProgressPurchases[player] = nil
	end
end

-- ==================================================
-- ORQUESTACIÓN DE COMPRAS (PURCHASE API)
-- ==================================================

-- Solicita la compra autoritativa de un producto.
-- Valida existencia, disponibilidad, locks transaccionales y enruta según Currency.
-- Lock covers validation AND commit. Always released, even if a provider throws/yields.
function ShopService:_withShopLock(player: any, operation: () -> (boolean, string?)): (boolean, string?)
 if not player then return false,"InvalidPlayer" end
 if self:IsTransactionInProgress(player) then return false,"TransactionInProgress" end
 self:_setTransactionLock(player,true)
 local ok, success, reason = pcall(operation)
 self:_setTransactionLock(player,false)
 if not ok then
  warn("[ShopService] Shop rejected before commit: " .. tostring(success))
  return false,"InternalError"
 end
 return success == true,reason
end

function ShopService:PurchaseProduct(player: any, productId: string, category: string?): (boolean, string?)
 if not player then return false,"InvalidPlayer" end
 if type(productId) ~= "string" or productId == "" then return false,"InvalidProductId" end
 return self:_withShopLock(player,function()
  local ps = self:_getPlayerService()
  if not ps or not ps:IsShopDataReady(player) then return false,"DataNotLoaded" end
  local registry = self:GetRegistry()
  if not registry then return false,"RegistryNotAvailable" end
  local product = registry:GetProduct(productId,category)
  if not product then return false,"ProductNotFound" end
  local provider = registry:GetProvider(product.Category)
  if not provider then return false,"ProviderNotFound" end
  if not product.IsAvailable then return false,"ProductUnavailable" end
  local allowed, reason = provider:CanPurchase(player,product)
  if not allowed then return false,reason or "CannotPurchase" end
  -- Re-resolve under the lock after provider validation (a future provider may yield).
  product = registry:GetProduct(productId,product.Category)
  if not product or not product.IsAvailable then return false,"ProductUnavailable" end
  if product.Currency == "Coins" then return self:_processCoinsPurchase(player,product,provider) end
  if product.Currency == "Robux" then return self:_processRobuxPurchase(player,product,provider) end
  return false,"UnsupportedCurrency"
 end)
end

function ShopService:_processCoinsPurchase(player: any, product: ProductDefinition, _provider: ProductProvider): (boolean, string?)
 local ps = self:_getPlayerService()
 if not ps then return false,"PlayerServiceNotAvailable" end
 -- No arbitrary delivery callback after debit. One coherent cosmetic profile commit.
 -- Other product types must supply a future explicit transaction contract.
 return ps:CommitShopPurchase(player,product)
end

-- Procesa compras con moneda de plataforma (Robux)
function ShopService:_processRobuxPurchase(player: any, product: ProductDefinition, provider: ProductProvider): (boolean, string?)
	if not product.RobloxProductId or product.RobloxProductId <= 0 then
		return false, "MissingRobloxProductId"
	end

	-- En Fase 2 (Core Framework): la definición y validación de Robux/RobloxProductId están establecidas.
	-- La integración con el prompt y ProcessReceipt de MarketplaceService se conecta en Fase 6.
	return false, "MarketplaceIntegrationPendingPhase6"
end

-- ==================================================
-- ORQUESTACIÓN DE EQUIPAMIENTO (EQUIP / UNEQUIP API)
-- ==================================================

-- Solicita equipar un cosmético
function ShopService:_equipProduct(player: any, productId: string, category: string?): (boolean, string?)
	if not player then
		return false, "InvalidPlayer"
	end
	if type(productId) ~= "string" or productId == "" then
		return false, "InvalidProductId"
	end
	local ps = self:_getPlayerService()
	if not ps or not ps:IsShopDataReady(player) then return false, "DataNotLoaded" end

	local registry = self:GetRegistry()
	if not registry then
		return false, "RegistryNotAvailable"
	end

	local product = registry:GetProduct(productId, category)
	if not product then
		return false, "ProductNotFound"
	end

	if product.ProductType ~= "Cosmetic" and product.ProductType ~= "Ability" then
		return false, "NotEquippable"
	end
	if not product.IsAvailable then return false, "ProductUnavailable" end

	local provider = registry:GetProvider(product.Category)
	if not provider then
		return false, "ProviderNotFound"
	end

	local canEquip, canEquipErr = provider:CanEquip(player, product)
	if not canEquip then
		return false, canEquipErr or "CannotEquip"
	end

	local equipOk, equipErr = provider:OnEquipped(player, product)
	if not equipOk then
		return false, equipErr or "EquipFailed"
	end

	return true, nil
end

-- Solicita desequipar el cosmético activo de una categoría
function ShopService:_unequipProduct(player: any, category: string): (boolean, string?)
	if not player then
		return false, "InvalidPlayer"
	end
	if type(category) ~= "string" or category == "" then
		return false, "InvalidCategory"
	end
	local ps = self:_getPlayerService()
	if not ps or not ps:IsShopDataReady(player) then return false, "DataNotLoaded" end

	local registry = self:GetRegistry()
	if not registry then
		return false, "RegistryNotAvailable"
	end

	local provider = registry:GetProvider(category)
	if not provider then
		return false, "ProviderNotFound"
	end

	local unequipOk, unequipErr = provider:OnUnequipped(player, nil)
	if not unequipOk then
		return false, unequipErr or "UnequipFailed"
	end

	return true, nil
end

function ShopService:EquipProduct(player: any, productId: string, category: string?): (boolean, string?)
 return self:_withShopLock(player,function() return self:_equipProduct(player,productId,category) end)
end
function ShopService:UnequipProduct(player: any, category: string): (boolean, string?)
 return self:_withShopLock(player,function() return self:_unequipProduct(player,category) end)
end

return ShopService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="557">
        <Properties>
          <string name="Name">SlapService</string>
          <string name="Source"><![CDATA[--!strict
-- SlapService
-- Servicio autoritativo centralizado del sistema de Slaps (bofetadas/armas de combate).
--
-- Principios arquitectonicos:
-- 1. Separacion total entre ASSET (modelo/configuracion en ServerStorage.Slaps) y LOGICA DE COMBATE (este servicio).
-- 2. Servidor autoritativo: El cliente solo solicita activar el Slap; el servidor valida que el jugador
--    tenga la herramienta equipada, pertenezca a una partida activa en estado Playing, respete el cooldown,
--    y valida el alcance/angulo fisico del impacto.
-- 3. Lectura data-driven: Power y SlapCooldown se leen directamente de Tool.Configuration (editables en Studio),
--    sin hardcodear valores ni bifurcar logica por nombre de Slap.
-- 4. Integracion estricta con la cadena existente:
--    Slap -> SlapService -> CombatService:RegisterHit() -> CombatTag -> RagdollService:ApplyRagdoll() -> KillPart -> EliminationService -> +1 Kill.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")

local Constants = require(ReplicatedStorage.Shared.Constants)
local Config = require(ReplicatedStorage.Shared.Config)
local Types = require(ReplicatedStorage.Shared.Types)

type MatchSession = Types.MatchSession

local SlapService = {}
SlapService.Name = "SlapService"

-- Constantes de validacion de combate
local MAX_SLAP_REACH = 9.0 -- Studs maximos de distancia entre agresor y objetivo
local MIN_FACING_DOT = -0.2 -- Producto punto minimo (cono frontal de impacto de ~200 grados)
-- Knockdown duration is centralized in Config.Combat.DefaultSlapKnockdownDuration.

SlapService._context = nil :: any
SlapService._swingSequence = {} :: { [Player]: number }
SlapService._attacks = {} :: { [Player]: any }
SlapService._requestIds = {} :: { [Player]: number }
SlapService._attackSerial = 0
SlapService._diagnosticBudgets = {} :: { [Player]: any }
SlapService._errorUntil = {} :: { [Player]: number }
SlapService._inventoryBindings = {} :: { [Player]: any }
SlapService._combatService = nil :: any
SlapService._ragdollService = nil :: any
SlapService._roundService = nil :: any
SlapService._performSlapRemote = nil :: RemoteEvent?
SlapService._connections = {} :: { RBXScriptConnection }

--------------------------------------------------------------------------------
-- Resolucion de Servicios Dependientes
--------------------------------------------------------------------------------

function SlapService:_getCombatService(): any
	if self._combatService then return self._combatService end
	if self._context and type(self._context.GetService) == "function" then
		local s = self._context:GetService("CombatService")
		if s then self._combatService = s; return s end
	end
	local mod = ServerScriptService.Services:FindFirstChild("CombatService")
	if mod and mod:IsA("ModuleScript") then
		local ok, res = pcall(require, mod)
		if ok and res then self._combatService = res; return res end
	end
	return nil
end

function SlapService:_getRagdollService(): any
	if self._ragdollService then return self._ragdollService end
	if self._context and type(self._context.GetService) == "function" then
		local s = self._context:GetService("RagdollService")
		if s then self._ragdollService = s; return s end
	end
	local mod = ServerScriptService.Services:FindFirstChild("RagdollService")
	if mod and mod:IsA("ModuleScript") then
		local ok, res = pcall(require, mod)
		if ok and res then self._ragdollService = res; return res end
	end
	return nil
end

function SlapService:_getRoundService(): any
	if self._roundService then return self._roundService end
	if self._context and type(self._context.GetService) == "function" then
		local s = self._context:GetService("RoundService")
		if s then self._roundService = s; return s end
	end
	local mod = ServerScriptService.Services:FindFirstChild("RoundService")
	if mod and mod:IsA("ModuleScript") then
		local ok, res = pcall(require, mod)
		if ok and res then self._roundService = res; return res end
	end
	return nil
end

--------------------------------------------------------------------------------
-- Remotes y Rutas
--------------------------------------------------------------------------------

local function ensureFolder(parent: Instance, name: string): Folder
	local f = parent:FindFirstChild(name)
	if not f then
		f = Instance.new("Folder")
		f.Name = name
		f.Parent = parent
	end
	return f :: Folder
end

local function ensureRemoteEvent(parent: Instance, name: string): RemoteEvent
	local ev = parent:FindFirstChild(name)
	if not ev then
		ev = Instance.new("RemoteEvent")
		ev.Name = name
		ev.Parent = parent
	end
	return ev :: RemoteEvent
end

function SlapService:_ensureRemotes()
	local remotesFolder = ensureFolder(ReplicatedStorage, "Remotes")
	local combatFolder = ensureFolder(remotesFolder, "Combat")
	self._performSlapRemote = ensureRemoteEvent(combatFolder, "PerformSlap")
	self._slapFeedbackRemote = ensureRemoteEvent(combatFolder, "SlapFeedback")
end

--------------------------------------------------------------------------------
-- Catalogo y Clonado de Slaps
--------------------------------------------------------------------------------

function SlapService:GetSlapsFolder(): Folder?
	local slaps = ServerStorage:FindFirstChild("Slaps")
	if slaps and slaps:IsA("Folder") then
		return slaps
	end
	return nil
end

function SlapService:GetSlapTemplate(slapName: string): Tool?
	local slapsFolder = self:GetSlapsFolder()
	if not slapsFolder then return nil end
	local template = slapsFolder:FindFirstChild(slapName)
	if template and template:IsA("Tool") then
		return template
	end
	return nil
end

-- Identifica de forma autoritativa si una herramienta es un Slap administrado por SlapService
function SlapService:IsSlapTool(tool: any): boolean
	if not tool or typeof(tool) ~= "Instance" or not tool:IsA("Tool") then
		return false
	end

	-- 1. Identificación autoritativa explícita: debe haber sido creada y sellada por GiveSlap
	if tool:GetAttribute("IsSlapWeapon") ~= true then
		return false
	end

	-- 2. Validación estructural complementaria del contenedor de combate
	local config = tool:FindFirstChild("Configuration")
	if not config or not config:FindFirstChild("Power") then
		return false
	end

	return true
end

export type PlayerLockData = {
	slapName: string,
	playerConnections: { RBXScriptConnection },
	charConnections: { RBXScriptConnection },
	isEnforcing: boolean,
	currentTool: Tool?,
}

SlapService._playerLocks = {} :: { [Player]: PlayerLockData }

-- Clona un Slap desde ServerStorage.Slaps, lo entrega al jugador y lo equipa automáticamente
function SlapService:GiveSlap(player: Player, slapName: string?): Tool?
	local crates = self._context and self._context:GetService("CrateService")
	local reward = crates and crates:ResolveEquipped(player)
	local targetName = if reward then crates:GetSlapModel(reward) else (slapName or "Classic")
	local template = self:GetSlapTemplate(targetName)
	if not template then
		-- Fallback a Classic si el solicitado no existe
		template = self:GetSlapTemplate("Classic")
	end
	if not template then
		warn(string.format("[SlapService] No se encontro plantilla de Slap para '%s'", tostring(targetName)))
		return nil
	end

	-- Limpiar cualquier Slap previo para evitar acumulacion
	self:RemoveSlaps(player)

	local clone = template:Clone()
	clone.Name = template.Name
	clone.CanBeDropped = false
	clone:SetAttribute("IsSlapWeapon", true)
	clone:SetAttribute("SlapName", template.Name)
	-- Cosmetic application never touches Configuration, Swing or combat settings.
	if crates and reward and targetName == template.Name then crates:ApplyVariation(clone, reward) end

	local backpack = player:FindFirstChildOfClass("Backpack")
	local char = player.Character
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")

	if backpack then
		clone.Parent = backpack
		if humanoid and humanoid.Health > 0 and char and char:IsDescendantOf(workspace) then
			pcall(function()
				humanoid:EquipTool(clone)
			end)
		end
	elseif char then
		clone.Parent = char
		if humanoid and humanoid.Health > 0 and char:IsDescendantOf(workspace) then
			pcall(function()
				humanoid:EquipTool(clone)
			end)
		end
	else
		clone:Destroy()
		return nil
	end

	-- Si el jugador tiene un lock activo, actualizar la referencia a la nueva herramienta
	local lock = self._playerLocks[player]
	if lock then
		lock.currentTool = clone
	end

	return clone
end

-- Remueve todos los Slap tools del Backpack y Character del jugador
function SlapService:RemoveSlaps(player: Player)
	if not player then return end

	local backpack = player:FindFirstChildOfClass("Backpack")
	if backpack then
		for _, child in ipairs(backpack:GetChildren()) do
			if self:IsSlapTool(child) then
				child:Destroy()
			end
		end
	end

	local char = player.Character
	if char then
		for _, child in ipairs(char:GetChildren()) do
			if self:IsSlapTool(child) then
				child:Destroy()
			elseif child:IsA("Tool") then
				child.Parent = backpack or player
			end
		end
	end

	-- Restaurar cualquier herramienta ajena preservada en Player hacia Backpack
	if backpack then
		for _, child in ipairs(player:GetChildren()) do
			if child:IsA("Tool") then
				if self:IsSlapTool(child) then
					child:Destroy()
				else
					child.Parent = backpack
				end
			end
		end
	end
end

-- Bloquea autoritativamente el equipamiento del jugador para que no pueda desequipar ni cambiar de herramienta
function SlapService:LockAndEquipPlayer(player: Player, slapName: string?)
	if not player or not player:IsA("Player") or not player:IsDescendantOf(Players) then
		return
	end

	self:UnlockPlayer(player)

	local lockData: PlayerLockData = {
		slapName = slapName or "Classic",
		playerConnections = {},
		charConnections = {},
		isEnforcing = false,
		currentTool = nil,
	}
	self._playerLocks[player] = lockData

	local function enforceEquipped()
		if self._playerLocks[player] ~= lockData then return end
		if lockData.isEnforcing then return end

		local char = player.Character
		if not char or not char.Parent or not char:IsDescendantOf(workspace) then return end
		local hum = char:FindFirstChildOfClass("Humanoid")
		if not hum or hum.Health <= 0 then return end

		local tool = lockData.currentTool

		-- Detectar si hay alguna herramienta no autorizada en Character
		local hasForeignTool = false
		for _, item in ipairs(char:GetChildren()) do
			if item:IsA("Tool") and item ~= tool then
				hasForeignTool = true
				break
			end
		end

		if tool and tool.Parent == char and not hasForeignTool then
			return
		end

		lockData.isEnforcing = true
			local generation = char:GetAttribute("ArenaPhysicsGeneration") or 0
			local matchId = player:GetAttribute("MatchId")
			local rounds = self:_getRoundService()
			local session = rounds and rounds:GetSessionForPlayer(player)
			local version = session and session.StateVersion
			local function currentCharacter(): boolean
				return player.Parent == Players and player.Character == char and char.Parent ~= nil
					and (char:GetAttribute("ArenaPhysicsGeneration") or 0) == generation
					and not char:GetAttribute("ArenaRespawnPending")
					and player:GetAttribute("MatchId") == matchId
					and player:GetAttribute("ResultsSessionId") == nil
					and (session == nil or (rounds:GetSessionForPlayer(player) == session
						and session.StateVersion == version and rounds:IsSessionActive(session.Id)
						and not session.Closing and not session.Closed and not session.Cancelled and not session.GameplayFrozen))
			end
		task.defer(function()
			-- Verificación estricta de identidad de bloqueo
				if self._playerLocks[player] ~= lockData or not currentCharacter() then
				lockData.isEnforcing = false
				return
			end

			local success, err = pcall(function()
					local c = char
				local h = c and c:FindFirstChildOfClass("Humanoid")
				if c and c.Parent and c:IsDescendantOf(workspace) and h and h.Health > 0 then
					local backpack = player:FindFirstChildOfClass("Backpack")
					if not backpack then
						backpack = player:WaitForChild("Backpack", 0.5) :: Backpack?
						-- Validación estricta post-yield si WaitForChild cedió el hilo
							if self._playerLocks[player] ~= lockData or not currentCharacter() or not c:IsDescendantOf(workspace) then
							return
						end
					end

					local t = lockData.currentTool

					-- Si backpack está disponible, devolver herramientas ajenas preservadas en Player
					if backpack then
						for _, child in ipairs(player:GetChildren()) do
							if child:IsA("Tool") and child ~= t then
								if not self:IsSlapTool(child) then
									child.Parent = backpack
								else
									child:Destroy()
								end
							end
						end
					end

					-- 1. Desalojar cualquier herramienta ajena del Character hacia el Backpack
					for _, item in ipairs(c:GetChildren()) do
						if item:IsA("Tool") and item ~= t then
							if backpack then
								item.Parent = backpack
							else
								-- Conservar la herramienta ajena sin destruirla; alojarla en Player temporalmente
								if self:IsSlapTool(item) then
									item:Destroy()
								else
									pcall(function()
										item.Parent = player
									end)
								end
							end
						end
					end

					-- 2. Asegurar que el Slap esté equipado en la mano
					if t and t.Parent == backpack then
						pcall(function()
							h:EquipTool(t)
						end)
					elseif not t or not t:IsDescendantOf(player) or not self:IsSlapTool(t) then
						-- Si el Slap no existe o fue destruido, regenerar y equipar
						local newTool = self:GiveSlap(player, lockData.slapName)
						lockData.currentTool = newTool
						if newTool then
							pcall(function()
								h:EquipTool(newTool)
							end)
						end
					elseif t.Parent ~= c then
						pcall(function()
							h:EquipTool(t)
						end)
					end
				end
			end)

			-- Garantizar que isEnforcing se restablezca siempre
			lockData.isEnforcing = false

			if not success and err then
				warn(string.format("[SlapService] Error durante enforceEquipped para '%s': %s", player.Name, tostring(err)))
			end
		end)
	end

	local function bindCharacter(char: Model)
		for _, c in ipairs(lockData.charConnections) do
			if c.Connected then c:Disconnect() end
		end
		table.clear(lockData.charConnections)

		local hum = char:WaitForChild("Humanoid", 5) :: Humanoid?
		-- Validación estricta post-yield: si la partida terminó o el personaje/jugador ya no es válido, salir sin entregar Slap
		if not hum or self._playerLocks[player] ~= lockData or not char.Parent or not char:IsDescendantOf(workspace) or not player:IsDescendantOf(Players) then
			return
		end

		-- Entregar y equipar Slap en este character
		local tool = self:GiveSlap(player, lockData.slapName)
		lockData.currentTool = tool
		if tool and hum.Health > 0 and char:IsDescendantOf(workspace) then
			pcall(function()
				hum:EquipTool(tool)
			end)
		end

		-- Escuchar cuando el Slap u otra cosa sale del Character (e.g. unequip)
		local charRemovedConn = char.ChildRemoved:Connect(function(child: Instance)
			if child:IsA("Tool") and self._playerLocks[player] == lockData then
				enforceEquipped()
			end
		end)
		table.insert(lockData.charConnections, charRemovedConn)

		-- Escuchar cuando otra herramienta es equipada en el Character
		local charAddedConn = char.ChildAdded:Connect(function(child: Instance)
			if child:IsA("Tool") and child ~= lockData.currentTool and self._playerLocks[player] == lockData then
				enforceEquipped()
			end
		end)
		table.insert(lockData.charConnections, charAddedConn)

		-- Escuchar cuando una herramienta entra al Backpack (cuando el cliente la desequipa)
		local backpack = player:FindFirstChildOfClass("Backpack")
		if backpack then
			local bpConn = backpack.ChildAdded:Connect(function(child: Instance)
				if child:IsA("Tool") and self._playerLocks[player] == lockData then
					enforceEquipped()
				end
			end)
			table.insert(lockData.charConnections, bpConn)
		end
	end

	-- Escuchar si el personaje muere y reaparece (respawn durante partida)
	local charAddedConn = player.CharacterAdded:Connect(function(newChar: Model)
		if self._playerLocks[player] == lockData then
			bindCharacter(newChar)
		end
	end)
	table.insert(lockData.playerConnections, charAddedConn)

	-- Si el personaje ya existe actualmente en Workspace
	if player.Character and player.Character.Parent and player.Character:IsDescendantOf(workspace) then
		bindCharacter(player.Character)
	end
end

-- Desbloquea el equipamiento del jugador y limpia todas las conexiones
function SlapService:UnlockPlayer(player: Player)
	local lockData = self._playerLocks[player]
	if lockData then
		for _, c in ipairs(lockData.playerConnections) do
			if c.Connected then c:Disconnect() end
		end
		for _, c in ipairs(lockData.charConnections) do
			if c.Connected then c:Disconnect() end
		end
		self._playerLocks[player] = nil
	end
end

function SlapService:IsPlayerLocked(player: Player): boolean
	return self._playerLocks[player] ~= nil
end

-- Only actual players are observed. NPC props, catalog tools and stored inventory are untouched.
function SlapService:_canHoldCombatTool(player: Player, tool: Instance): boolean
	if not self:IsSlapTool(tool) then return false end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then return false end
	local rounds = self:_getRoundService()
	local session = rounds and rounds:GetSessionForPlayer(player)
	if not session or session.Closing or session.Closed or session.Cancelled
		or player:GetAttribute("MatchId") ~= session.Id
		or player:GetAttribute("ResultsSessionId") ~= nil
		or not rounds:GetSessionParticipant(session.Id, player) then return false end
	return session.State == Constants.RoundState.StartCountdown or session.State == Constants.RoundState.Playing
		or session.State == Constants.RoundState.PointRestartCountdown
end

function SlapService:_enforceCombatHands(player: Player, character: Model, tool: Instance)
	if not tool:IsA("Tool") then return end
	task.defer(function()
		if player.Parent ~= Players or player.Character ~= character or tool.Parent ~= character
			or self:_canHoldCombatTool(player, tool) then return end
		-- Store, never delete, foreign tools. Managed Slaps still use existing round cleanup.
		local backpack = player:FindFirstChildOfClass("Backpack")
		tool.Parent = backpack or player
	end)
end

function SlapService:_bindCombatInventory(player: Player)
	if self._inventoryBindings[player] then return end
	local binding = {}
	self._inventoryBindings[player] = binding
	local function bind(character: Model)
		if binding.Child then binding.Child:Disconnect() end
		binding.Child = character.ChildAdded:Connect(function(tool)
			self:_enforceCombatHands(player, character, tool)
		end)
		for _, tool in ipairs(character:GetChildren()) do self:_enforceCombatHands(player, character, tool) end
	end
	binding.Character = player.CharacterAdded:Connect(bind)
	if player.Character then bind(player.Character) end
end

-- Entrega y bloquea los Slaps a todos los contendientes de una partida
function SlapService:EquipMatchPlayers(session: MatchSession, slapName: string?)
	if not session then return end

	local participants: { Player } = {}
	if session.RedTeam and #session.RedTeam > 0 then
		for _, p in ipairs(session.RedTeam) do table.insert(participants, p) end
	elseif session.RedPlayer then
		table.insert(participants, session.RedPlayer)
	end
	if session.BlueTeam and #session.BlueTeam > 0 then
		for _, p in ipairs(session.BlueTeam) do table.insert(participants, p) end
	elseif session.BluePlayer then
		table.insert(participants, session.BluePlayer)
	end

	for _, player in ipairs(participants) do
		self:LockAndEquipPlayer(player, slapName)
	end
end

-- Retira el bloqueo y los Slaps de todos los contendientes de una partida
function SlapService:RemoveMatchPlayers(session: MatchSession)
	if not session then return end

	local participants: { Player } = {}
	if session.RedTeam and #session.RedTeam > 0 then
		for _, p in ipairs(session.RedTeam) do table.insert(participants, p) end
	elseif session.RedPlayer then
		table.insert(participants, session.RedPlayer)
	end
	if session.BlueTeam and #session.BlueTeam > 0 then
		for _, p in ipairs(session.BlueTeam) do table.insert(participants, p) end
	elseif session.BluePlayer then
		table.insert(participants, session.BluePlayer)
	end

	for _, player in ipairs(participants) do
		local attack = self._attacks[player]
		if attack and attack.Session == session then self:_cancelAttack(player, "SessionRemoved") end
		self:UnlockPlayer(player)
		self:RemoveSlaps(player)
	end
end

-- Studio-only, opt-in and bounded. Never log every hitbox sample.
function SlapService:_trace(player: Player, phase: string, record: any?, reason: string?)
	if not RunService:IsStudio() or ReplicatedStorage:GetAttribute("SlapDiagnosticsEnabled") ~= true then return end
	local second = math.floor(os.clock())
	local budget = self._diagnosticBudgets[player]
	if not budget or budget.Second ~= second then
		budget = { Second = second, Count = 0 }; self._diagnosticBudgets[player] = budget
	end
	if budget.Count >= 12 then return end
	budget.Count += 1
	local row = {
		Build = "CombatSystemV132", Side = "Server", Phase = phase, UserId = player.UserId,
		RejectionReason = reason, ServerTime = workspace:GetServerTimeNow(),
		Accepted = if phase == "AttackStarted" then true elseif phase == "ServerRejected" then false else nil,
	}
	if record then
		row.SessionId = record.SessionId; row.RoundId = record.RoundId
		row.CharacterGeneration = record.Generation; row.AttackId = record.AttackId
		row.PredictionId = record.PredictionId; row.RequestTime = record.RequestTime
		row.RequestId = record.RequestId; row.AttackStartTime = record.NetworkStart
		row.HitConfirmed = record.HitConfirmed == true; row.AttackWindowClosed = record.WindowClosed
		row.RecoveryType = record.Outcome; row.RecoveryUntil = record.NetworkRecovery
		row.WindowUntil = record.NetworkWindowUntil
		row.PreviousAttackId = record.PreviousAttackId
		row.PreviousRecoveryUntil = record.PreviousRecoveryUntil
		row.StartMonotonic = record.StartTime; row.RecoveryMonotonic = record.RecoveryUntil
		row.PreviousRecoveryMonotonic = record.PreviousRecoveryMonotonic
	end
	print("[SlapTrace] " .. HttpService:JSONEncode(row))
end

function SlapService:_sendAttackFeedback(player: Player, record: any, phase: string, reason: string?)
	if player.Parent ~= Players or not self._slapFeedbackRemote then return end
	self._swingSequence[player] = (self._swingSequence[player] or 0) + 1
	self._slapFeedbackRemote:FireClient(player, {
		Protocol = 3, Sequence = self._swingSequence[player], RequestId = record.RequestId,
		PredictionId = record.PredictionId,
		AttackId = record.AttackId, Phase = phase, Accepted = phase ~= "Rejected",
		Character = record.Character, Generation = record.Generation,
		SessionId = record.SessionId, RoundId = record.RoundId,
		AttackStartTime = record.NetworkStart, AttackWindowClosed = record.WindowClosed,
		WindowUntil = record.NetworkWindowUntil,
		Hit = record.HitConfirmed == true, Outcome = record.Outcome, Reason = reason,
		WindowPending = record.Stage == "Window",
		RecoveryUntil = record.NetworkRecovery, ReadyAt = record.NetworkRecovery,
	})
end

function SlapService:_cancelAttack(player: Player, reason: string)
	local record = self._attacks[player]
	if not record then return end
	-- Detach first. A yielding old attempt can never finalize a replacement.
	self._attacks[player] = nil
	record.Stage = "Cancelled"
	self:_trace(player, "AttackCancelled", record, reason)
end

function SlapService:_sameLife(record: any, player: Player, session: any): boolean
	local char = player.Character
	return record.Character == char and char ~= nil
		and record.Generation == (char:GetAttribute("ArenaPhysicsGeneration") or 0)
		and record.Session == session and session ~= nil
		and record.RoundId == (session.GameplayRound and session.GameplayRound.Id)
end

function SlapService:_finishAttack(player: Player, record: any, outcome: string, reason: string?): boolean
	if self._attacks[player] ~= record or record.Stage ~= "Window" then return false end
	record.Stage = "Recovery"; record.Outcome = outcome
	record.HitConfirmed = outcome == "Hit"
	local now = os.clock()
	record.WindowClosed = workspace:GetServerTimeNow()
	-- Hit recovery starts at accepted RegisterHit; Miss starts at window close.
	local combo = Config.Combat.SlapCombo
	local duration = if combo.Enabled then
		(if outcome == "Hit" then combo.SuccessfulHitRecovery else combo.MissRecovery) else record.ToolCooldown
	record.RecoveryUntil = now + duration
	record.NetworkRecovery = record.WindowClosed + duration
	self:_trace(player, "RecoverySet", record, reason)
	return true
end

function SlapService:_handleRequest(player: Player, tool: any, request: any)
	-- RequestId is correlation only. The server owns attack identity and clocks.
	if type(request) ~= "table" or type(request.RequestId) ~= "number"
		or request.RequestId ~= request.RequestId or request.RequestId < 1
		or request.RequestId % 1 ~= 0 or request.RequestId > 9007199254740991 then return end
	if type(request.PredictionId) ~= "string" or #request.PredictionId > 160
		or #request.PredictionId < 1 or request.PredictionId:find("[^%w:_%-]") then return end
	local rounds = self:_getRoundService()
	local session = rounds and rounds:GetSessionForPlayer(player)
	local char = player.Character
	local attempt = { RequestId = request.RequestId, PredictionId = request.PredictionId,
		RequestTime = workspace:GetServerTimeNow(), Character = char,
		Generation = char and (char:GetAttribute("ArenaPhysicsGeneration") or 0),
		SessionId = session and session.Id, RoundId = session and session.GameplayRound and session.GameplayRound.Id }
	self:_trace(player, "RequestReceived", attempt)
	local function reject(reason: string)
		local current = self._attacks[player]
		if current and self:_sameLife(current, player, session) then
			attempt.AttackId = current.AttackId; attempt.Stage = current.Stage
			attempt.NetworkRecovery = current.NetworkRecovery
		end
		self:_trace(player, "ServerRejected", attempt, reason)
		self:_sendAttackFeedback(player, attempt, "Rejected", reason)
	end
	local previous = self._requestIds[player] or 0
	if request.RequestId <= previous then reject("RequestReplayed"); return end
	self._requestIds[player] = request.RequestId
	if request.Character ~= char or request.Generation ~= attempt.Generation
		or request.SessionId ~= attempt.SessionId or request.RoundId ~= attempt.RoundId then
		reject("RequestScopeMismatch"); return
	end
	-- The holder is local to THIS call, never read an error's owner from _attacks.
	local ok, hit, reason = pcall(self.ProcessSlap, self, player, tool, attempt)
	local record = attempt.Attack
	if not ok then
		local now = os.clock()
		if now >= (self._errorUntil[player] or 0) then
			self._errorUntil[player] = now + 5
			warn("[SlapService] AttackError UserId=" .. tostring(player.UserId)
				.. " AttackId=" .. tostring(record and record.AttackId)
				.. " " .. string.sub(tostring(hit), 1, 200))
		end
		reason = "InternalError"
		if record then self:_finishAttack(player, record, "Miss", reason) end
	end
	if record then
		if self._attacks[player] == record then
			self:_sendAttackFeedback(player, record, "Result", reason)
		else
			-- Obsolete result carries its ORIGINAL life/round and cannot affect a new request.
			self:_sendAttackFeedback(player, record, "Cancelled", reason or "AttackObsolete")
		end
	else
		reject(reason or "Rejected")
	end
end

--------------------------------------------------------------------------------
-- Validaciones Autoritativas de Activacion y Combate
--------------------------------------------------------------------------------

-- Valida que la herramienta sea un Slap autorizado con Configuration valida
function SlapService:_validateTool(player: Player, tool: any): (boolean, number, number, string?)
	if not tool or typeof(tool) ~= "Instance" or not tool:IsA("Tool") then
		return false, 0, 0, "InvalidToolInstance"
	end

	-- Debe ser un Slap legítimo administrado por SlapService
	if not self:IsSlapTool(tool) then
		return false, 0, 0, "NotAuthorizedSlap"
	end

	-- Debe estar equipada en el Character activo del jugador
	local char = player.Character
	if not char or tool.Parent ~= char then
		return false, 0, 0, "ToolNotEquipped"
	end

	local config = tool:FindFirstChild("Configuration")
	if not config then
		return false, 0, 0, "MissingConfiguration"
	end

	local powerVal = config:FindFirstChild("Power")
	if not powerVal or not powerVal:IsA("NumberValue") or powerVal.Value <= 0 or powerVal.Value~=powerVal.Value or powerVal.Value==math.huge then
		return false, 0, 0, "InvalidPowerValue"
	end

	local cooldownVal = config:FindFirstChild("SlapCooldown")
	if not cooldownVal or not cooldownVal:IsA("NumberValue") or cooldownVal.Value < 0 or cooldownVal.Value~=cooldownVal.Value or cooldownVal.Value==math.huge then
		return false, 0, 0, "InvalidCooldownValue"
	end

	return true, powerVal.Value, cooldownVal.Value, nil
end

local function isPlayer(p: any): boolean
	if not p then return false end
	if typeof(p) == "Instance" then
		return p:IsA("Player")
	end
	if (typeof(p) == "userdata" or typeof(p) == "table") and type(p.IsA) == "function" then
		return p:IsA("Player")
	end
	return false
end

-- Selecciona como máximo un oponente usando exclusivamente el registro
-- autoritativo de la sesión. Prioridad: menor distancia, luego Slot y UserId.
function SlapService:_selectOpponent(
	attacker: Player,
	session: MatchSession,
	attackerRoot: BasePart
): (Player?, BasePart?, Vector3?, string?)
	local roundService = self:_getRoundService()
	if not roundService
		or type(roundService.GetSessionParticipant) ~= "function"
		or type(roundService.GetSessionForPlayer) ~= "function"
		or type(roundService.GetSessionById) ~= "function"
		or type(roundService.IsSessionActive) ~= "function"
		or roundService:GetSessionById(session.Id) ~= session
		or not roundService:IsSessionActive(session.Id)
		or session.State ~= Constants.RoundState.Playing
		or session.Closing or session.Cancelled or session.Closed then
		return nil, nil, nil, "SessionNotCombatReady"
	end

	local attackerParticipant = roundService:GetSessionParticipant(session.Id, attacker)
	if not attackerParticipant then return nil, nil, nil, "AttackerNotParticipant" end

	local selected: Player? = nil
	local selectedRoot: BasePart? = nil
	local selectedDiff: Vector3? = nil
	local selectedDistance = math.huge
	local selectedSlot = math.huge
	local selectedUserId = math.huge
	local firstRejection: string? = nil
	local forwardDir = attackerRoot.CFrame.LookVector
	local combatService = self:_getCombatService()
	if not combatService then return nil, nil, nil, "CombatServiceUnavailable" end

	for _, rosterParticipant in ipairs(session.Participants) do
		if rosterParticipant.Team == attackerParticipant.Team
			or rosterParticipant.State == "Left"
			or rosterParticipant.State == "Released" then
			continue
		end

		local candidate = rosterParticipant.Player
		if not isPlayer(candidate) or candidate == attacker or candidate.Parent ~= Players then
			firstRejection = firstRejection or "InvalidOpponent"
			continue
		end
		if roundService:GetSessionForPlayer(candidate) ~= session
			or roundService:GetSessionParticipant(session.Id, candidate) ~= rosterParticipant then
			firstRejection = firstRejection or "DifferentMatch"
			continue
		end

		local character = candidate.Character
			if character and character:GetAttribute("ArenaRespawnPending") then
				firstRejection = firstRejection or "VictimRespawning"
				continue
			end
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not character or not character:IsDescendantOf(workspace) or not root then
			firstRejection = firstRejection or "VictimNotSpawned"
			continue
		end
		if not humanoid or humanoid.Health <= 0 then
			firstRejection = firstRejection or "VictimNotAlive"
			continue
		end
		if combatService:IsHitProtected(candidate, session) then
			firstRejection = firstRejection or "VictimHitProtected"
			continue
		end

		local diff = root.Position - attackerRoot.Position
		local distance = diff.Magnitude
		if distance > MAX_SLAP_REACH then
			firstRejection = firstRejection or "OutOfReach"
			continue
		end
		local direction = if distance > 0.05 then diff.Unit else forwardDir
		if forwardDir:Dot(direction) < MIN_FACING_DOT then
			firstRejection = firstRejection or "TargetBehindAttacker"
			continue
		end

		local slot = rosterParticipant.Slot
		local userId = rosterParticipant.UserId
		if distance < selectedDistance
			or (distance == selectedDistance and slot < selectedSlot)
			or (distance == selectedDistance and slot == selectedSlot and userId < selectedUserId) then
			selected = candidate
			selectedRoot = root
			selectedDiff = diff
			selectedDistance = distance
			selectedSlot = slot
			selectedUserId = userId
		end
	end

	return selected, selectedRoot, selectedDiff, if selected then nil else (firstRejection or "NoValidOpponent")
end

-- Ejecuta la resolucion autoritativa del golpe
function SlapService:ProcessSlap(attacker: Player, tool: Tool, attempt: any?): (boolean, string?)
	-- 1. Validar que el atacante sea un Player valido
	if not isPlayer(attacker) or not attacker.Parent then
		return false, "InvalidAttacker"
	end

	local attackerChar = attacker.Character
	if attackerChar and attackerChar:GetAttribute("ArenaRespawnPending") then return false, "AttackerRespawning" end
	if not attackerChar or not attackerChar:IsDescendantOf(workspace) then
		return false, "AttackerCharNotSpawned"
	end

	local attackerHumanoid = attackerChar:FindFirstChildOfClass("Humanoid")
	local attackerRoot = attackerChar:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not attackerHumanoid or attackerHumanoid.Health <= 0 or not attackerRoot then
		return false, "AttackerNotAlive"
	end

	if attackerHumanoid.PlatformStand then return false,"AttackerKnockedDown" end
	if attackerHumanoid:GetAttribute("MovementLocked") == true then return false, "MovementLocked" end

	-- 2. Validar que la herramienta sea un Slap valido y este equipada
	local okTool, power, cooldown, toolErr = self:_validateTool(attacker, tool)
	if not okTool then
		return false, toolErr or "ToolValidationFailed"
	end

	-- 3. Validar estado de la partida (solo en estado PLAYING)
	local roundService = self:_getRoundService()
	if not roundService then
		return false, "RoundServiceUnavailable"
	end

	local session = roundService:GetSessionForPlayer(attacker)
	if not session then
		return false, "NotInMatch"
	end

	if session.State ~= Constants.RoundState.Playing or not roundService:IsGameplayRoundOpen(session) then
		return false, "MatchNotPlaying"
	end

	-- 4. Validar cooldown del servidor
	local now = os.clock()
	local previous = self._attacks[attacker]
	if previous and not self:_sameLife(previous, attacker, session) then
		self:_cancelAttack(attacker, "LifeOrRoundChanged"); previous = nil
	end
	if previous and (previous.Stage == "Window" or now < previous.RecoveryUntil) then
		return false, "OnCooldown"
	end

	local combo=Config.Combat.SlapCombo
 local roundId=session.GameplayRound.Id
 local generation=attackerChar:GetAttribute("ArenaPhysicsGeneration") or 0
 local swingDeadline=now+(if combo.Enabled then combo.SwingWindow else 0)
	self._attackSerial += 1
	local record = { AttackId = session.Id .. ":Slap:" .. tostring(self._attackSerial),
		RequestId = attempt and attempt.RequestId, PredictionId = attempt and attempt.PredictionId,
		RequestTime = attempt and attempt.RequestTime, Character = attackerChar, Generation = generation,
		Session = session, SessionId = session.Id, RoundId = roundId, Stage = "Window",
		StartTime = now, NetworkStart = workspace:GetServerTimeNow(), ToolCooldown = cooldown }
	record.NetworkWindowUntil = record.NetworkStart + (if combo.Enabled then combo.SwingWindow else 0)
	record.PreviousAttackId = previous and previous.AttackId
	record.PreviousRecoveryUntil = previous and previous.NetworkRecovery
	record.PreviousRecoveryMonotonic = previous and previous.RecoveryUntil
	self._attacks[attacker] = record
	if attempt then attempt.Attack = record end
	self:_trace(attacker, "AttackStarted", record)
	self:_sendAttackFeedback(attacker, record, "Started")
 local opponent: Player?=nil
 local victimRoot: BasePart?=nil
 local diff: Vector3?=nil
 local targetReason: string?=nil
 repeat
  if self._attacks[attacker] ~= record or attacker.Character~=attackerChar or attacker.Parent~=Players or tool.Parent~=attackerChar
   or (attackerChar:GetAttribute("ArenaPhysicsGeneration") or 0)~=generation
   or attackerHumanoid.Health <= 0 or attackerHumanoid.PlatformStand
   or attackerHumanoid:GetAttribute("MovementLocked") == true or attackerChar:GetAttribute("ArenaRespawnPending")
   or roundService:GetSessionForPlayer(attacker) ~= session
   or not roundService:IsGameplayRoundOpen(session) or session.GameplayRound.Id~=roundId then
   self:_finishAttack(attacker,record,"Miss","SwingInvalidated");return false,"SwingInvalidated"
  end
  opponent,victimRoot,diff,targetReason=self:_selectOpponent(attacker,session,attackerRoot)
  if opponent then break end
  if os.clock()>=swingDeadline then break end
  task.wait(math.min(combo.SampleInterval,math.max(0,swingDeadline-os.clock())))
 until false
 if not opponent or not victimRoot or not diff then
  self:_finishAttack(attacker,record,"Miss",targetReason or "NoValidOpponent")
  return false,targetReason or "NoValidOpponent"
 end
	local victimChar = opponent.Character :: Model
	local forwardDir = attackerRoot.CFrame.LookVector

	-- 7. Registrar impacto autoritativo en CombatService
	local combatService = self:_getCombatService()
	if not combatService then
		self:_finishAttack(attacker,record,"Miss","CombatServiceUnavailable")
		return false, "CombatServiceUnavailable"
	end

	local abilities = self._context and self._context:GetService("AbilityService")
	local hitTicket = abilities and abilities:PrepareHit(attacker, session)
	-- Hooks may yield: recheck the owner before committing any combat side effect.
	if self._attacks[attacker] ~= record or not self:_sameLife(record, attacker, session)
		or attackerHumanoid.Health <= 0 or attackerHumanoid.PlatformStand
		or attackerHumanoid:GetAttribute("MovementLocked") == true
		or attackerChar:GetAttribute("ArenaRespawnPending") or tool.Parent ~= attackerChar
		or not roundService:IsGameplayRoundOpen(session) then
		self:_finishAttack(attacker, record, "Miss", "SwingInvalidated")
		return false, "SwingInvalidated"
	end
	local hitSuccess, hitReason, receivedHits = combatService:RegisterHit(attacker, opponent, session.Id, hitTicket ~= nil and hitTicket.SkipComboCount == true)
	if not hitSuccess then
		self:_finishAttack(attacker,record,"Miss",hitReason or "CombatServiceRejected")
		return false, hitReason or "CombatServiceRejected"
	end

	self:_finishAttack(attacker,record,"Hit")

	-- 8. Reproducir feedback sonoro de impacto
	local hand = tool:FindFirstChild("Hand")
	local hitSound = hand and hand:FindFirstChild("Hit") :: Sound?
	if hitSound and hitSound:IsA("Sound") then
		pcall(function()
			hitSound:Play()
		end)
	end

	if hitTicket then
	 local consumed,cue,reason=abilities:ConsumeHit(attacker, session, opponent, hitTicket)
	 if consumed then
	  local elimination=self._context and self._context:GetService("EliminationService")
	  if elimination and elimination:HandleAbilityHit(opponent,session,attacker,reason) then
	   abilities:PresentCue(session,cue)
	  end
	  return true,nil
	 end
	end
	if (receivedHits or 0)>=Config.Combat.SlapElimination.HitsToEliminate then
  local elimination=self._context and self._context:GetService("EliminationService")
  if elimination then elimination:HandleSlapThreshold(opponent,session,attacker) end
  return true,nil
 end

	-- 9. Aplicar knockback y ragdoll autoritativo via RagdollService
	local ragdollService = self:_getRagdollService()
	if ragdollService then
		local horizDiff = Vector3.new(diff.X, 0, diff.Z)
		local horizDir = if horizDiff.Magnitude > 0.1 then horizDiff.Unit else forwardDir

		local upwardRatio = 0.35
		local vertSpeed = math.max(power * upwardRatio * 1.3, 26)
		local horizSpeed = power * (1 - upwardRatio * 0.2)
		local launchVelocity = horizDir * horizSpeed + Vector3.new(0, vertSpeed, 0)

		ragdollService:ApplyRagdoll(victimChar, Config.Combat.DefaultSlapKnockdownDuration, launchVelocity)
	end

	print(string.format("[SlapService] Slap exitoso: '%s' golpeo a '%s' con '%s' (Power=%d, Cooldown=%.2f)",
		attacker.Name, opponent.Name, tool.Name, power, cooldown))

	return true, nil
end

--------------------------------------------------------------------------------
-- Ciclo de Vida Bootstrap
--------------------------------------------------------------------------------

function SlapService:Init(context: any)
	self._context = context
	self._attacks = {}
	self._requestIds = {}
	self._attackSerial = 0
	self._diagnosticBudgets = {}
	self._errorUntil = {}
	self._inventoryBindings = {}
	self._swingSequence = {}
	self:_ensureRemotes()
end

function SlapService:Start(context: any)
	self._context = context
	for _, player in ipairs(Players:GetPlayers()) do self:_bindCombatInventory(player) end
	table.insert(self._connections, Players.PlayerAdded:Connect(function(player) self:_bindCombatInventory(player) end))

	-- Escuchar activacion remota desde el cliente
	if self._performSlapRemote then
		local conn = self._performSlapRemote.OnServerEvent:Connect(function(player: Player, tool: any, request: any)
			self:_handleRequest(player, tool, request)
		end)
		table.insert(self._connections, conn)
	end

	-- Limpieza de cooldowns y bloqueos cuando un jugador se desconecta
	local leaveConn = Players.PlayerRemoving:Connect(function(player: Player)
		self:_cancelAttack(player, "PlayerRemoving")
		self._requestIds[player] = nil
		self._diagnosticBudgets[player] = nil
		self._errorUntil[player] = nil
		local binding = self._inventoryBindings[player]
		if binding then
			if binding.Child then binding.Child:Disconnect() end
			if binding.Character then binding.Character:Disconnect() end
			self._inventoryBindings[player] = nil
		end
		self._swingSequence[player] = nil
		self:UnlockPlayer(player)
	end)
	table.insert(self._connections, leaveConn)

	print("[SlapService] Servicio centralizado de Slaps iniciado y listo (CombatSystemV132 Protocol=3)")
end

return SlapService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="558">
        <Properties>
          <string name="Name">SocialPlayService</string>
          <string name="Source"><![CDATA[--!nonstrict
local Players=game:GetService('Players')
local RS=game:GetService('ReplicatedStorage')
local Run=game:GetService('RunService')
local Http=game:GetService('HttpService')
local Config=require(RS.Shared.SocialPlayConfig)
local SocialConfig=require(RS.Shared.SocialConfig)
local Engine=require(script.Parent.Gameplay.SocialPlayEngine)
local Service={Name='SocialPlayService'}
local function uid(id)return type(id)=='number'and id==id and id~=0 and id%1==0 and math.abs(id)<9007199254740992 end
function Service:Eligible(id)
 local p=uid(id)and Players:GetPlayerByUserId(id)
 if not p or p.Parent~=Players or not self.Profiles:IsShopDataReady(p)or self.Rounds:GetSessionForPlayer(p)then return false end
 local c=p.Character;local h=c and c:FindFirstChildOfClass('Humanoid')
 if not c or not c:IsDescendantOf(workspace)or not h or h.Health<=0 then return false end
 if self.Matchmaking:IsPlayerQueued(p)then return false end
 local social=self.Context:GetService('SocialService')
 return not(social and social.Engine and social.Engine.Busy[id])
end
function Service:Near(a,b)
 local p=Players:GetPlayerByUserId(a);local q=Players:GetPlayerByUserId(b)
 local x=p and p.Character and p.Character:FindFirstChild('HumanoidRootPart')
 local y=q and q.Character and q.Character:FindFirstChild('HumanoidRootPart')
 return x and y and (x.Position-y.Position).Magnitude<=SocialConfig.InspectDistance or false
end
function Service:Decorate(viewer,profile)
 local id=profile.UserId;local own=id==viewer.UserId
 profile.Actions={Challenge=not own and self.Engine:CanChallenge(viewer.UserId,id)and self:Near(viewer.UserId,id),
  Invite=not own and not self.Engine:Group(id)and self:Eligible(viewer.UserId)and self:Eligible(id)}
 return profile
end
function Service:StartDuel(grant)
 local a=Players:GetPlayerByUserId(grant.A);local b=Players:GetPlayerByUserId(grant.B)
 if not self:Eligible(grant.A)or not self:Eligible(grant.B)or self.Engine:Group(grant.A)or self.Engine:Group(grant.B)then return false,'PlayerUnavailable'end
 return self.Rounds:StartTeamMatch({ZoneId=grant.ZoneId,Mode='1v1',TeamSize=1,RedTeam={a},BlueTeam={b},ReservationToken=grant.Token})
end
function Service:FindGrant(zone,red,blue)
 local grant=self.Engine.Grants[zone]
 if not grant or workspace:GetServerTimeNow()>=grant.ExpiresAt or #red~=1 or #blue~=1 then return nil end
 if red[1]~=Players:GetPlayerByUserId(grant.A)or blue[1]~=Players:GetPlayerByUserId(grant.B)or self.Engine:Group(grant.A)or self.Engine:Group(grant.B)then return nil end
 return grant
end
function Service:ValidateDuel(token,request)
 local g=self:FindGrant(request.ZoneId,request.RedTeam,request.BlueTeam)
 return g~=nil and not g.Consumed and g.Token==token and request.Mode=='1v1'and request.TeamSize==1,'InvalidDuelReservation'
end
function Service:ConsumeDuel(token)
 for _,g in pairs(self.Engine.Grants)do if g.Token==token and not g.Consumed then g.Consumed=true;return true end end
 return false
end
function Service:DuelPrepared(zone,red,blue)
 local g=self:FindGrant(zone,red,blue)
 if not g or not g.Consumed then return false end
 local a=self.Rounds:GetSessionForPlayer(red[1]);local b=self.Rounds:GetSessionForPlayer(blue[1])
 return a~=nil and a==b and a.ZoneId==zone and not a.Closing and not a.Cancelled
end
function Service:ReleaseDuel(zone,token)
 local g=self.Engine.Grants[zone];if g and g.Token==token then self.Engine.Grants[zone]=nil end
end
function Service:CanQueueTeam(players,size)return self.Engine:CanQueueTeam(players,size)end
function Service:Request(p,action,id,value)
 local now=workspace:GetServerTimeNow()
 if now-(self.LastRequest[p]or -math.huge)<Config.RequestInterval then return {Ok=false,Reason='RateLimited'}end
 self.LastRequest[p]=now
 if action=='State'then return {Ok=true,Group=self.Engine:GroupView(p.UserId)}end
 local ok,why
 if (action=='Duel'or action=='Group')and uid(id)then ok,why=self.Engine:Invite(p.UserId,id,action)
 elseif action=='Respond'and type(id)=='string'and #id<=128 and type(value)=='boolean'then ok,why=self.Engine:Respond(p.UserId,id,value)
 elseif action=='Leave'then ok,why=self.Engine:Leave(p.UserId,false)
 elseif action=='Disband'then ok,why=self.Engine:Leave(p.UserId,true)
 else return {Ok=false,Reason='InvalidRequest'}end
 return {Ok=ok,Reason=ok and nil or why}
end
function Service:Init(context)
 self.Context=context;self.Profiles=context:GetService('PlayerService');self.Rounds=context:GetService('RoundService');self.Matchmaking=context:GetService('MatchmakingService')
 assert(self.Profiles and self.Rounds and self.Matchmaking,'SocialPlay dependencies missing')
 self.Connections={};self.LastRequest={}
 local remotes=RS:WaitForChild('Remotes')
 local function ensure(parent,name,class)
  local obj=parent:FindFirstChild(name);if obj then assert(obj:IsA(class),'SocialPlay class mismatch');return obj end
  obj=Instance.new(class);obj.Name=name;obj.Parent=parent;return obj
 end
 local folder=ensure(remotes,'SocialPlay','Folder');self.Remote=ensure(folder,'Request','RemoteFunction');self.Update=ensure(folder,'Updated','RemoteEvent')
 self.Engine=Engine.new(Config,{Clock=function()return workspace:GetServerTimeNow()end,Id=function()return Http:GenerateGUID(false)end,
  Eligible=function(id)return self:Eligible(id)end,Near=function(a,b)return self:Near(a,b)end,
  Name=function(id)local p=Players:GetPlayerByUserId(id);return p and p.DisplayName or 'Desconectado'end,
  GroupChanged=function(id,group)local p=Players:GetPlayerByUserId(id);if p then p:SetAttribute('SocialGroupId',group)end end,
  Emit=function(id,kind,data)local p=Players:GetPlayerByUserId(id);if p and p.Parent==Players then self.Update:FireClient(p,kind,data)end end,
  StartDuel=function(g)return self:StartDuel(g)end})
end
function Service:Start()
 self.Remote.OnServerInvoke=function(p,...)return self:Request(p,...)end
 table.insert(self.Connections,Players.PlayerRemoving:Connect(function(p)self.Engine:Disconnect(p.UserId);self.LastRequest[p]=nil end))
 local elapsed=0
 table.insert(self.Connections,Run.Heartbeat:Connect(function(dt)elapsed+=dt;if elapsed>=Config.RequestInterval then elapsed=0;self.Engine:Tick()end end))
end
return Service
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="559">
        <Properties>
          <string name="Name">SocialService</string>
          <string name="Source"><![CDATA[--!nonstrict
local Players=game:GetService('Players')
local RS=game:GetService('ReplicatedStorage')
local RunService=game:GetService('RunService')
local Http=game:GetService('HttpService')
local Config=require(RS.Shared.SocialConfig)
local Catalog=require(RS.Shared.SlapCrates.Catalog)
local Public=require(script.Parent.Trading.PublicInventory)
local Engine=require(script.Parent.Trading.TradeEngine)
local Transaction=require(script.Parent.Trading.TradeTransactionService)
local Service={Name='SocialService'}
local function uid(n)return type(n)=='number'and n==n and n~=0 and math.abs(n)<9007199254740992 and n%1==0 end
function Service:Eligible(id)
 local p=uid(id)and Players:GetPlayerByUserId(id)
 if not p or p.Parent~=Players or not self.Profiles:IsShopDataReady(p)then return false end
 if self.Rounds:GetSessionForPlayer(p)then return false end
 local c=p.Character;local h=c and c:FindFirstChildOfClass('Humanoid');local root=c and c:FindFirstChild('HumanoidRootPart')
 return c~=nil and c:IsDescendantOf(workspace)and h~=nil and h.Health>0 and root~=nil and root:IsA('BasePart')
end
function Service:Distance(a,b)
 local x=Players:GetPlayerByUserId(a);local y=Players:GetPlayerByUserId(b)
 local r=x and x.Character and x.Character:FindFirstChild('HumanoidRootPart');local s=y and y.Character and y.Character:FindFirstChild('HumanoidRootPart')
 return r and s and (r.Position-s.Position).Magnitude or math.huge
end
function Service:Unit(id,key)
 local p=Players:GetPlayerByUserId(id)
 if not p or not self.Profiles:IsShopDataReady(p)then return nil end
 for _,row in ipairs(Public.Build(self.Profiles:GetPlayerData(p),id,Catalog))do if row.UnitId==key then return row end end
end
function Service:AllowRequest(p)
 local now=workspace:GetServerTimeNow();local last=self.LastRequest[p]or -math.huge
 if now-last<Config.RequestIntervalSeconds then return false end
 self.LastRequest[p]=now;return true
end
function Service:Inspect(p,targetId,page)
 if not self:AllowRequest(p)then return {Ok=false,Reason='RateLimited'}end
 page=page or 1
 if not Config.ProfileInspectionEnabled or not uid(targetId)or type(page)~='number'or page~=page or page%1~=0 or page<1 or page>10000 then return {Ok=false,Reason='InvalidRequest'}end
 local ok,why=self.Engine:_pair(p.UserId,targetId,true)
 if not ok then return {Ok=false,Reason=why}end
 local target=Players:GetPlayerByUserId(targetId)
 local result=Public.Profile(target,self.Profiles:GetPlayerData(target),Catalog,Config,page)
 result.ProfileMode='OtherPlayerProfile'
 local play=self.Context and self.Context:GetService('SocialPlayService');if play then play:Decorate(p,result)end
 self.Viewers[p]=targetId;return {Ok=true,Profile=result}
end
-- No target or client mode argument: the authenticated caller owns this read-only view.
function Service:SelfProfile(p,page)
 if not self:AllowRequest(p)then return {Ok=false,Reason='RateLimited'}end
 if page==nil then page=1 end
 if not Config.ProfileInspectionEnabled or type(page)~='number'or page~=page or page%1~=0 or page<1 or page>10000 then return {Ok=false,Reason='InvalidRequest'}end
 if not uid(p.UserId)or Players:GetPlayerByUserId(p.UserId)~=p or not self:Eligible(p.UserId)then return {Ok=false,Reason='PlayerUnavailable'}end
 local data=self.Profiles:GetPlayerData(p)
 local count=#Public.Build(data,p.UserId,Catalog)
 page=math.min(page,math.max(1,math.ceil(count/Config.InventoryPageSize)))
 local result=Public.Profile(p,data,Catalog,Config,page)
 result.ProfileMode='SelfProfile'
 local play=self.Context and self.Context:GetService('SocialPlayService');if play then play:Decorate(p,result)end
 self.Viewers[p]=p.UserId
 return {Ok=true,Profile=result}
end
function Service:Action(p,action,id,revision,value)
 if not self:AllowRequest(p)then return {Ok=false,Reason='RateLimited'}end
 if action=='Invite'then
  if not uid(id)then return {Ok=false,Reason='InvalidTarget'}end
  local target=Players:GetPlayerByUserId(id)
  if target and target:GetAttribute('TradeInvitationsDisabled')==true then return {Ok=false,Reason='InvitationsDisabled'}end
  local ok,why=self.Engine:Invite(p.UserId,id);return {Ok=ok,Reason=ok and nil or why,TradeId=ok and why or nil}
 end
 if type(action)~='string'or #action>16 or type(id)~='string'or #id>128 or type(revision)~='number'or revision~=revision or revision<0 or revision%1~=0 then return {Ok=false,Reason='InvalidRequest'}end
 if action=='Inventory'then
  local t=self.Engine.Trades[id]
  if not t or t.Terminal or (p.UserId~=t.A and p.UserId~=t.B)or t.Revision~=revision or not self:Eligible(p.UserId)then return {Ok=false,Reason='NotParticipant'}end
  local page=value or 1
  if type(page)~='number'or page~=page or page%1~=0 or page<1 or page>10000 then return {Ok=false,Reason='InvalidPage'}end
  return {Ok=true,Profile=Public.Profile(p,self.Profiles:GetPlayerData(p),Catalog,Config,page)}
 end
 local ok,why=self.Engine:Act(p.UserId,action,id,revision,value);return {Ok=ok,Reason=why}
end
function Service:Init(context)
 self.Context=context;self.Profiles=context:GetService('PlayerService');self.Rounds=context:GetService('RoundService')
 assert(self.Profiles and self.Rounds,'Social dependencies unavailable')
 self.LastRequest={};self.Viewers={};self.Connections={};self.CharacterConnections={}
 local remotes=RS:WaitForChild('Remotes');local folder=remotes:FindFirstChild('Social')
 local function ensure(parent,name,class)local p=parent:FindFirstChild(name);if p then assert(p:IsA(class),'Social remote class mismatch');return p end;local n=Instance.new(class);n.Name=name;n.Parent=parent;return n end
 folder=folder or ensure(remotes,'Social','Folder')
 self.Update=ensure(folder,'Updated','RemoteEvent')
 self.SelfProfileRemote=ensure(folder,'SelfProfile','RemoteFunction')
 self.InspectRemote=ensure(folder,'Inspect','RemoteFunction');self.ActionRemote=ensure(folder,'Action','RemoteFunction')
 self.Engine=Engine.new(Config,{
  Clock=function()return workspace:GetServerTimeNow()end,Id=function()return Http:GenerateGUID(false)end,
  Eligible=function(id)return self:Eligible(id)end,Distance=function(a,b)return self:Distance(a,b)end,
  Name=function(id)local p=Players:GetPlayerByUserId(id);return p and p.DisplayName or 'Desconectado'end,
  Unit=function(id,key)return self:Unit(id,key)end,Commit=Transaction.Commit,
  Emit=function(id,kind,payload)local p=Players:GetPlayerByUserId(id);if p then self.Update:FireClient(p,kind,payload)end end,
 })
 self.CommitAvailable,self.CommitReason=Transaction.Availability(Config,context.PersistenceInfo,RunService:IsStudio())
 assert(not self.CommitAvailable,'Real trade commit must remain disabled')
end
function Service:ValidateViewers()
  for p,target in pairs(self.Viewers)do
   if not self:Eligible(p.UserId)or not self:Eligible(target)or (p.UserId~=target and not(self:Distance(p.UserId,target)<=Config.InspectDistance))then
    self.Viewers[p]=nil;if p.Parent==Players then self.Update:FireClient(p,'ProfileUnavailable',{UserId=target})end
   end
  end
end
function Service:Start()
 self.SelfProfileRemote.OnServerInvoke=function(p,page)return self:SelfProfile(p,page)end
 self.InspectRemote.OnServerInvoke=function(p,...)return self:Inspect(p,...)end
 self.ActionRemote.OnServerInvoke=function(p,...)return self:Action(p,...)end
 local function bind(p)
  if self.CharacterConnections[p]then self.CharacterConnections[p]:Disconnect()end
  self.CharacterConnections[p]=p.CharacterRemoving:Connect(function()self.Engine:CancelForPlayer(p.UserId)end)
 end
 for _,p in ipairs(Players:GetPlayers())do bind(p)end
 table.insert(self.Connections,Players.PlayerAdded:Connect(bind))
 table.insert(self.Connections,Players.PlayerRemoving:Connect(function(p)
  self.Engine:Disconnect(p.UserId);self.Viewers[p]=nil;self.LastRequest[p]=nil
  if self.CharacterConnections[p]then self.CharacterConnections[p]:Disconnect();self.CharacterConnections[p]=nil end
 end))
 local elapsed=0
 table.insert(self.Connections,RunService.Heartbeat:Connect(function(dt)
  elapsed+=dt;if elapsed<0.25 then return end;elapsed=0;self.Engine:Tick()
  self:ValidateViewers()
 end))
 print('[SocialService] Inspection/invitations ready; TradeCommitEnabled=false; '..self.CommitReason)
end
return Service
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="560">
        <Properties>
          <string name="Name">SpawnService</string>
          <string name="Source"><![CDATA[--!strict
-- SpawnService
-- Responsable de obtener los spawnpoints de la partida, posicionar a RedPlayer y BluePlayer,
-- validar que ambos spawn existan, evitar que los jugadores aparezcan dentro del suelo,
-- e integrarse con RoundService durante MapLoading y el retorno al lobby.
-- NO implementa: respawn, muerte, combate, knockback, eliminacion, checkpoints ni herramientas.

local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Constants = require(ReplicatedStorage.Shared.Constants)
local Types = require(ReplicatedStorage.Shared.Types)
local Config = require(ReplicatedStorage.Shared.Config)
local ArenaRespawn = require(script.Parent.Respawn.ArenaRespawn)
local CharacterPhysics = require(script.Parent.Respawn.CharacterPhysics)

print("[SpawnService] MovementLock diagnostic version loaded")

type MatchSession = Types.MatchSession
type SessionParticipant = Types.SessionParticipant
type SpawnBatchResult = Types.SpawnBatchResult

local SpawnService = {}
SpawnService.Name = "SpawnService"

SpawnService._context = nil
SpawnService._lobbySpawn = nil :: SpawnLocation?
SpawnService._returnConnection = nil :: RBXScriptConnection?

function SpawnService:Init(context)
	self._context = context
	self._arenaRespawn = ArenaRespawn.new(self)
	CharacterPhysics.Configure()
	self._respawnConnections = {}
	self._respawnPlayerConnections = {}

	-- Validar existencia de Workspace.Lobby.SpawnLocation
	local lobby = Workspace:FindFirstChild("Lobby")
	local spawnLocation = lobby and lobby:FindFirstChild("SpawnLocation")
	if spawnLocation and spawnLocation:IsA("SpawnLocation") then
		self._lobbySpawn = spawnLocation
	else
		warn("[SpawnService] Workspace.Lobby.SpawnLocation no encontrado o invalido")
	end
end

function SpawnService:Start(context)
	self._context = context
	local function track(player: Player)
		if self._respawnPlayerConnections[player] then return end
		self._respawnPlayerConnections[player] = {
			player.CharacterRemoving:Connect(function(character)
				local pending = self._arenaRespawn.Pending[player]
				if pending and pending.Character == character then self._arenaRespawn:Cancel(player, "CharacterRemoving", false) end
					CharacterPhysics.Forget(character)
			end),
			player.CharacterAdded:Connect(function(character)
				local pending = self._arenaRespawn.Pending[player]
				if pending and pending.Character ~= character then self._arenaRespawn:Cancel(player, "CharacterReplaced", false) end
					CharacterPhysics.Track(character)
			end),
			player:GetAttributeChangedSignal("MatchId"):Connect(function()
				local pending = self._arenaRespawn.Pending[player]
				if pending and player:GetAttribute("MatchId") ~= pending.Session.Id then self._arenaRespawn:Cancel(player, "MatchChanged", false) end
			end),
		}
			if player.Character then CharacterPhysics.Track(player.Character) end
	end
	table.insert(self._respawnConnections, Players.PlayerAdded:Connect(track))
	table.insert(self._respawnConnections, Players.PlayerRemoving:Connect(function(player)
		self._arenaRespawn:Cancel(player, "PlayerRemoving", false)
		if player.Character then CharacterPhysics.Forget(player.Character) end
		for _,connection in ipairs(self._respawnPlayerConnections[player] or {}) do connection:Disconnect() end
		self._respawnPlayerConnections[player] = nil
	end))
	for _,player in ipairs(Players:GetPlayers()) do track(player) end

	-- Conectar a la señal de RoundService para retornar jugadores al lobby
	local roundService = self:_getRoundService()
	if roundService and roundService.ReturnPlayersToLobby then
		self._returnConnection = roundService.ReturnPlayersToLobby:Connect(function(data: any)
			if type(data) == "table" then
				self:ReturnPlayersToLobby(data.RedPlayer, data.BluePlayer)
			end
		end)
	end

	print("[SpawnService] Servicio iniciado y listo para gestionar posicionamiento de jugadores")
end

function SpawnService:_getMatchInstanceService()
	if self._context and self._context.GetService then
		local s = self._context:GetService("MatchInstanceService")
		if s then return s end
	end

	local servicesFolder = ServerScriptService:FindFirstChild("Services")
	local mod = servicesFolder and servicesFolder:FindFirstChild("MatchInstanceService")
	if mod and mod:IsA("ModuleScript") then
		local ok, result = pcall(require, mod)
		if ok then return result end
	end
	return nil
end

function SpawnService:_getRoundService()
	if self._context and self._context.GetService then
		local s = self._context:GetService("RoundService")
		if s then return s end
	end

	local servicesFolder = ServerScriptService:FindFirstChild("Services")
	local mod = servicesFolder and servicesFolder:FindFirstChild("RoundService")
	if mod and mod:IsA("ModuleScript") then
		local ok, result = pcall(require, mod)
		if ok then return result end
	end
	return nil
end

function SpawnService:_getRagdollService()
	if self._context and self._context.GetService then
		local s = self._context:GetService("RagdollService")
		if s then return s end
	end

	local servicesFolder = ServerScriptService:FindFirstChild("Services")
	local mod = servicesFolder and servicesFolder:FindFirstChild("RagdollService")
	if mod and mod:IsA("ModuleScript") then
		local ok, result = pcall(require, mod)
		if ok then return result end
	end
	return nil
end

function SpawnService:_getSlapService()
	if self._context and self._context.GetService then
		local s = self._context:GetService("SlapService")
		if s then return s end
	end

	local servicesFolder = ServerScriptService:FindFirstChild("Services")
	local mod = servicesFolder and servicesFolder:FindFirstChild("SlapService")
	if mod and mod:IsA("ModuleScript") then
		local ok, result = pcall(require, mod)
		if ok then return result end
	end
	return nil
end

function SpawnService:_getSpawnPoints(session: MatchSession): (BasePart?, BasePart?)
	-- 1. Intentar desde session.InstanceInfo si ya esta cacheado
	if session.InstanceInfo then
		return session.InstanceInfo.TeamSpawns.Red[1], session.InstanceInfo.TeamSpawns.Blue[1]
	end

	-- 2. Consultar a MatchInstanceService
	local matchInstanceService = self:_getMatchInstanceService()
	if matchInstanceService then
		return matchInstanceService:GetSpawnPoints(session.Id)
	end

	return nil, nil
end

function SpawnService:GetSpawnPoints(session: MatchSession): (BasePart?, BasePart?)
	return self:_getSpawnPoints(session)
end

local function isPlayer(p: any): boolean
	if not p then return false end
	if typeof(p) == "Instance" then
		return p:IsA("Player")
	end
	return false
end

-- Determina si un jugador pertenece activamente a una partida en curso
function SpawnService:IsPlayerInActiveMatch(player: Player): boolean
	if not player or not isPlayer(player) then return false end
	local matchId = player:GetAttribute("MatchId")
	if matchId and matchId ~= "" then
		return true
	end
	local roundService = self:_getRoundService()
	if roundService and type(roundService.GetSessionForPlayer) == "function" then
		local session = roundService:GetSessionForPlayer(player)
		if session and session.State ~= Constants.RoundState.Waiting and session.State ~= Constants.RoundState.ReturningToLobby then
			return true
		end
	end
	return false
end

-- Posiciona un personaje de jugador de forma segura sobre un spawnpart evitando que quede incrustado en el suelo
function SpawnService:TeleportCharacterToSpawn(player: Player, spawnPart: BasePart): boolean
	if not player or not spawnPart or not spawnPart:IsDescendantOf(Workspace) then
		warn("[SpawnService] Parametros de teleportacion invalidos")
		return false
	end

	local character = player.Character
	local isLobby = spawnPart == self._lobbySpawn
	local originalCharacter = character
	local originalGeneration = character and character:GetAttribute("ArenaPhysicsGeneration")
	local originalMatchId = player:GetAttribute("MatchId")
	if self._arenaRespawn then
		self._arenaRespawn:Cancel(player, "ExternalTeleport", false)
	end
	if character then character:SetAttribute("ArenaPhysicsPhase", if isLobby then "Lobby" else "Playing") end
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local rootPart = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?

	-- Validar si el personaje existe, está activo y con vida
	local isAlive = character
		and character.Parent ~= nil
		and humanoid
		and humanoid.Health > 0
		and rootPart
		and rootPart.Position.Y > (workspace.FallenPartsDestroyHeight + 100)

	if not isAlive then
		if not isLobby and self:IsPlayerInActiveMatch(player) then
			-- REGLA FASE 4B: En MATCH, NUNCA invocar player:LoadCharacter()
			warn(string.format("[SpawnService] Personaje de '%s' no listo durante MatchSession. Esperando HumanoidRootPart sin recargar rig...", player.Name))
			character = player.Character
			if character then
				rootPart = character:WaitForChild("HumanoidRootPart", 2) :: BasePart?
				humanoid = character:FindFirstChildOfClass("Humanoid")
			end
			if not character or not rootPart or not humanoid then
				warn(string.format("[SpawnService] Imposible teletransportar '%s' en partida: Character no recuperable sin LoadCharacter.", player.Name))
				return false
			end
		else
			-- LOBBY: Recarga permitida exclusivamente como mecanismo fuera de match
			print(string.format("[SpawnService] Personaje de '%s' inactivo en Lobby. Recargando con LoadCharacter()...", player.Name))
			local ok, err = pcall(function()
				player:LoadCharacter()
			end)
			if not ok then
				warn(string.format("[SpawnService] Error al forzar LoadCharacter() para '%s': %s", player.Name, tostring(err)))
				return false
			end
			character = player.Character
			if not character then
				local start = os.clock()
				while not player.Character and (os.clock() - start) < 2 do
					task.wait(0.05)
				end
				character = player.Character
			end
		end
	end

	if not character then
		warn(string.format("[SpawnService] Jugador '%s' no tiene personaje activo tras intento de carga", player.Name))
		return false
	end

	rootPart = character:WaitForChild("HumanoidRootPart", 3) :: BasePart?
	humanoid = character:FindFirstChildOfClass("Humanoid")
	if not rootPart or not humanoid then
		warn(string.format("[SpawnService] Personaje de '%s' no contiene HumanoidRootPart o Humanoid", player.Name))
		return false
	end
	if player.Character ~= character or player.Parent ~= Players then return false end
	if player:GetAttribute("MatchId") ~= originalMatchId
		or (character == originalCharacter and character:GetAttribute("ArenaPhysicsGeneration") ~= originalGeneration) then return false end
	CharacterPhysics.Restore(character)
	character:SetAttribute("ArenaPhysicsPhase", if isLobby then "Lobby" else "Playing")

	-- Si el jugador está dentro de un match, asegurar que Dead esté deshabilitado
	character:SetAttribute("ArenaPhysicsGeneration", (character:GetAttribute("ArenaPhysicsGeneration") or 0) + 1)
	if not isLobby and self:IsPlayerInActiveMatch(player) then
		pcall(function()
			humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
		end)
	end

	-- Calculo de elevacion para evitar que el personaje aparezca dentro del suelo:
	-- (Mitad del grosor del spawn) + (HipHeight del Humanoid) + (Mitad de altura del RootPart) + margen de seguridad (0.5 studs)
	local spawnHalfThickness = spawnPart.Size.Y / 2
	local hipHeight = if humanoid.HipHeight > 0 then humanoid.HipHeight else 2.0
	local rootHalfHeight = rootPart.Size.Y / 2
	local safetyBuffer = 0.5

	local verticalClearance = spawnHalfThickness + hipHeight + rootHalfHeight + safetyBuffer

	-- Orientar al jugador segun la orientacion del spawn
		local targetCFrame = spawnPart.CFrame * CFrame.new(0, verticalClearance, 0)

	-- Detener cualquier inercia o velocidad previa del jugador en todas sus partes
	rootPart.AssemblyLinearVelocity = Vector3.zero
	rootPart.AssemblyAngularVelocity = Vector3.zero
	for _, desc in ipairs(character:GetDescendants()) do
		if desc:IsA("BasePart") then
			desc.AssemblyLinearVelocity = Vector3.zero
			desc.AssemblyAngularVelocity = Vector3.zero
		end
	end

	-- Si el personaje estaba en ragdoll, restaurarlo inmediatamente cancelando timers pendientes
	local ragdollService = self:_getRagdollService()
	if ragdollService and type(ragdollService.ResetRagdollImmediate) == "function" then
		ragdollService:ResetRagdollImmediate(character, isLobby)
	elseif ragdollService then
		ragdollService:RemoveRagdoll(character)
	end

	character:PivotTo(targetCFrame * rootPart.CFrame:Inverse() * character:GetPivot())
	if not isLobby then
		local rounds = self:_getRoundService()
		local session = rounds and rounds:GetSessionForPlayer(player)
		if session then
			(session :: any).ArenaTransferred = true
			(session :: any).TransferredPlayers = (session :: any).TransferredPlayers or {}
			(session :: any).TransferredPlayers[player] = true
		end
	end
	rootPart.AssemblyLinearVelocity = Vector3.zero
	rootPart.AssemblyAngularVelocity = Vector3.zero
	for _, desc in ipairs(character:GetDescendants()) do
		if desc:IsA("BasePart") then
			desc.AssemblyLinearVelocity = Vector3.zero
			desc.AssemblyAngularVelocity = Vector3.zero
		end
	end

	print(string.format("[SpawnService] Jugador '%s' posicionado en '%s' (%s)",
			player.Name, spawnPart.Name, tostring(targetCFrame.Position)))

	return true
end

-- Determina el equipo de un jugador dentro de una partida activa
function SpawnService:_getPlayerTeam(session: MatchSession, player: Player): ("Red" | "Blue")?
	if not session or not player then return nil end

	if session.RedTeam and table.find(session.RedTeam, player) ~= nil then
		return "Red"
	elseif session.RedPlayer == player then
		return "Red"
	end

	if session.BlueTeam and table.find(session.BlueTeam, player) ~= nil then
		return "Blue"
	elseif session.BluePlayer == player then
		return "Blue"
	end

	return nil
end

function SpawnService:_getParticipant(session: MatchSession, player: Player): SessionParticipant?
	if not session or not player then return nil end
	for _, participant in ipairs(session.Participants or {}) do
		if participant.Player == player and participant.State ~= "Released" then
			return participant
		end
	end
	return nil
end

-- Resolver autoritativo reutilizable para carga, reinicios y recuperación de caídas.
-- La sesión registrada, el participante y la instancia física deben coincidir.
function SpawnService:ResolveParticipantSpawn(sessionId: string, player: Player): (BasePart?, string?)
	local roundService = self:_getRoundService()
	if not roundService or type(roundService.GetSessionById) ~= "function" then
		return nil, "RoundServiceUnavailable"
	end
	local session = roundService:GetSessionById(sessionId)
	if not session or session.Id ~= sessionId then return nil, "SessionNotRegistered" end
	if roundService:GetSessionForPlayer(player) ~= session then return nil, "PlayerSessionMismatch" end

	local participant = self:_getParticipant(session, player)
	if not participant then return nil, "ParticipantNotRegistered" end
	if participant.State == "Left" then return nil, "ParticipantLeft" end

	local instanceService = self:_getMatchInstanceService()
	local instanceInfo = instanceService and instanceService:GetInstance(sessionId)
	if not instanceInfo or session.InstanceInfo ~= instanceInfo or instanceInfo.MatchId ~= sessionId then
		return nil, "MatchInstanceMismatch"
	end
	local spawnPart = instanceService:GetSpawnPoint(sessionId, participant.Team, participant.Slot)
	if not spawnPart or not spawnPart:IsDescendantOf(instanceInfo.Container) then
		return nil, "SpawnUnavailable"
	end
	return spawnPart, nil
end

-- Posiciona a un jugador individual en el spawn correspondiente a su equipo dentro de la partida activa
function SpawnService:SpawnPlayerInMatch(session: MatchSession, player: Player): boolean
	if not session or not player then
		warn("[SpawnService] MatchSession o Player invalido para SpawnPlayerInMatch")
		return false
	end

	local participant = self:_getParticipant(session, player)
	if not participant then
		warn(string.format("[SpawnService] Jugador '%s' no pertenece al Match '%s'", player.Name, session.Id))
		return false
	end
	local targetSpawn, reason = self:ResolveParticipantSpawn(session.Id, player)

	if not targetSpawn or not targetSpawn:IsA("BasePart") or not targetSpawn:IsDescendantOf(Workspace) then
		warn(string.format("[SpawnService] Spawn %s/%d no valido para Match '%s': %s", participant.Team, participant.Slot, session.Id, tostring(reason)))
		return false
	end

	-- Blindaje del Humanoid al ingresar al Match (Fase 4B Zero-Death)
	local character = player.Character
	if character then
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			pcall(function()
				humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
			end)
		end
	end

	return self:TeleportCharacterToSpawn(player, targetSpawn)
end

-- Reposiciona el Character EXISTENTE de un jugador dentro de su MatchInstance (Zero-Death)
-- Garantiza:
-- 1. NO invoca player:LoadCharacter().
-- 2. NO reemplaza ni destruye el Character existente.
-- 3. Resuelve TeamSpawn exclusivamente desde MatchId y MatchTeam (aislamiento multi-match).
-- 4. Invoca RagdollService:ResetRagdollImmediate() para restaurar locomoción y cancelar timers.
-- 5. Anula AssemblyLinearVelocity y AssemblyAngularVelocity antes y después de PivotTo.
-- 6. Aplica elevación vertical y orientación de forma segura para no incrustar en el suelo.
function SpawnService:ResetCharacterInArena(player: Player, expectedSessionId: string?): boolean
	if not player or not player:IsDescendantOf(game:GetService("Players")) then
		warn("[SpawnService] Player invalido o desconectado para ResetCharacterInArena")
		return false
	end

	local character = player.Character
	if not character or not character.Parent or not character:IsDescendantOf(Workspace) then
		warn(string.format("[SpawnService] Jugador '%s' no tiene Character valido en Workspace", player.Name))
		return false
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local rootPart = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not humanoid or not rootPart then
		warn(string.format("[SpawnService] Personaje de '%s' carece de Humanoid o HumanoidRootPart", player.Name))
		return false
	end

	local roundService = self:_getRoundService()
	local session = roundService and roundService:GetSessionForPlayer(player)
	if not session or (expectedSessionId and session.Id ~= expectedSessionId) then
		warn(string.format("[SpawnService] Sesion autoritativa ausente o distinta para '%s'", player.Name))
		return false
	end
	local participant = self:_getParticipant(session, player)
	local targetSpawn, reason = self:ResolveParticipantSpawn(session.Id, player)
	if not participant or not targetSpawn then
		warn(string.format("[SpawnService] No se pudo resolver spawn autoritativo para '%s': %s", player.Name, tostring(reason)))
		return false
	end
	local pending = self._arenaRespawn and self._arenaRespawn.Pending[player]
	if pending and pending.Thread and pending.Thread ~= coroutine.running() then
		pcall(task.cancel, pending.Thread)
		pending.Thread = nil
	end
	character:SetAttribute("ArenaPhysicsGeneration", (character:GetAttribute("ArenaPhysicsGeneration") or 0) + 1)

	-- 1. Resetear inmediatamente el estado de Ragdoll y cancelar callbacks pendientes
	local ragdollService = self:_getRagdollService()
	if ragdollService and type(ragdollService.ResetRagdollImmediate) == "function" then
		ragdollService:ResetRagdollImmediate(character, pending ~= nil)
	elseif ragdollService then
		ragdollService:RemoveRagdoll(character)
	end

	-- 2. Limpiar velocidades e impulsos antes del teleport
	rootPart.AssemblyLinearVelocity = Vector3.zero
	rootPart.AssemblyAngularVelocity = Vector3.zero
	for _, desc in ipairs(character:GetDescendants()) do
		if desc:IsA("BasePart") then
			desc.AssemblyLinearVelocity = Vector3.zero
			desc.AssemblyAngularVelocity = Vector3.zero
		end
	end

	-- 3. Calcular CFrame objetivo con elevación de seguridad
	local spawnHalfThickness = targetSpawn.Size.Y / 2
	local hipHeight = if humanoid.HipHeight > 0 then humanoid.HipHeight else 2.0
	local rootHalfHeight = rootPart.Size.Y / 2
	local safetyBuffer = 0.5
	if pending then
		-- Official rig clearance: R6 includes leg length; R15 uses HipHeight.
		local leg = character:FindFirstChild("Left Leg") :: BasePart?
		hipHeight = math.max(0, humanoid.HipHeight)
		if humanoid.RigType == Enum.HumanoidRigType.R6 and leg then hipHeight += leg.Size.Y end
		safetyBuffer = 0.05
	end
	local verticalClearance = spawnHalfThickness + hipHeight + rootHalfHeight + safetyBuffer

		local targetCFrame = targetSpawn.CFrame * CFrame.new(0, verticalClearance, 0)

	-- 4. Reposicionar el Character EXISTENTE
	if pending then
		-- Position the root exactly, independent of Model pivot offsets.
		character:PivotTo(targetCFrame * rootPart.CFrame:Inverse() * character:GetPivot())
	else
		character:PivotTo(targetCFrame)
	end

	-- 5. Limpieza física secundaria post-PivotTo para cancelar inercia residual
	rootPart.AssemblyLinearVelocity = Vector3.zero
	rootPart.AssemblyAngularVelocity = Vector3.zero
	if pending then
		local exclude: { Instance } = { character }
		for _,other in ipairs(Players:GetPlayers()) do
			if other.Character then table.insert(exclude, other.Character) end
		end
		local overlap = OverlapParams.new()
		overlap.FilterType = Enum.RaycastFilterType.Exclude
		overlap.FilterDescendantsInstances = exclude
		overlap.RespectCanCollide = true
		overlap.MaxParts = 1
		for _,body in ipairs(character:GetChildren()) do
			if body:IsA("BasePart") and #Workspace:GetPartBoundsInBox(body.CFrame, body.Size * 0.95, overlap) > 0 then
				warn("[ArenaRespawn] Unsafe spawn overlap", player.Name, targetSpawn:GetFullName(), body.Name)
				return false
			end
		end
		self._arenaRespawn:Take(player)
		self._arenaRespawn:Restore(pending)
	end

	-- 6. Garantizar que Humanoid pueda caminar y mantener Dead bloqueado (Zero-Death)
	if humanoid.Health > 0 then
		humanoid.Jump = false
		humanoid.PlatformStand = false
		local isLocked = humanoid:GetAttribute("MovementLocked") == true
		if not isLocked then
			humanoid.AutoRotate = true
		end
		pcall(function()
			humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
			humanoid:SetStateEnabled(Enum.HumanoidStateType.GettingUp, true)
			humanoid:ChangeState(Enum.HumanoidStateType.Running)
		end)
	end

	print(string.format("[SpawnService] ResetCharacterInArena exitoso para '%s' en '%s' (Match '%s', Team '%s')",
		player.Name, targetSpawn.Name, session.Id, participant.Team))
	CharacterPhysics.Trace(player, "ArenaPositioned", targetSpawn, session.State)

	return true
end

function SpawnService:IsKillPartRespawnPending(player: Player): boolean
	return self._arenaRespawn ~= nil and self._arenaRespawn.Pending[player] ~= nil
end

function SpawnService:BeginKillPartRespawn(player: Player, session: MatchSession, eliminationId: string, kind: string?): boolean
	local rounds = self:_getRoundService()
	if not player or player.Parent ~= Players or not session or not rounds
		or rounds:GetSessionForPlayer(player) ~= session or not rounds:IsSessionActive(session.Id)
		or not rounds:GetSessionParticipant(session.Id, player) then return false end
	if session.State ~= Constants.RoundState.Playing or session.PointInProgress or session.GameplayFrozen then return false end
	return self._arenaRespawn:Begin(player, session, eliminationId, kind)
end

function SpawnService:CancelSessionRespawns(sessionId: string, reason: string)
	if self._arenaRespawn then self._arenaRespawn:CancelSession(sessionId, reason, true) end
end

-- ==================================================
-- BLOQUEO Y RESTAURACIÓN DE MOVIMIENTO (Countdowns)
-- ==================================================

-- Obtiene la lista de jugadores participantes válidos de una MatchSession
-- Reutiliza la misma estrategia que SpawnMatchPlayers() soportando RedTeam/BlueTeam y RedPlayer/BluePlayer
function SpawnService:GetSessionParticipants(session: MatchSession?): { Player }
	if not session then return {} end
	local participants: { Player } = {}

	local addPlayer = function(p: any)
		if isPlayer(p) and p:IsDescendantOf(Players) then
			if not table.find(participants, p) then
				table.insert(participants, p)
			end
		end
	end

	if session.RedTeam and #session.RedTeam > 0 then
		for _, p in ipairs(session.RedTeam) do
			addPlayer(p)
		end
	elseif session.RedPlayer then
		addPlayer(session.RedPlayer)
	end

	if session.BlueTeam and #session.BlueTeam > 0 then
		for _, p in ipairs(session.BlueTeam) do
			addPlayer(p)
		end
	elseif session.BluePlayer then
		addPlayer(session.BluePlayer)
	end

	for index, participant in ipairs(participants) do
		warn(
			"[DEBUG Participants]",
			index,
			tostring(participant),
			typeof(participant)
		)
	end

	return participants
end

-- Bloquea autoritativamente el movimiento del Character durante countdowns (Start / PointRestart)
-- Garantiza: WalkSpeed = 0, JumpPower = 0, JumpHeight = 0, AutoRotate = false, AssemblyVelocities = 0
-- NO usa Anchored, NO usa PlatformStand, NO crea Characters nuevos.
function SpawnService:LockCharacterMovement(player: Player?): boolean
	warn(
		"[DEBUG LockCharacterMovement]",
		"player=", tostring(player),
		"typeof=", typeof(player)
	)

	if typeof(player) ~= "Instance" then
		warn("[DEBUG LockCharacterMovement] INVALID PLAYER:", tostring(player))
		return false
	end

	if not player:IsA("Player") then
		warn("[DEBUG LockCharacterMovement] INVALID CLASS:", player.ClassName)
		return false
	end

	if player.Parent ~= Players then
		warn("[DEBUG LockCharacterMovement] PLAYER NOT IN PLAYERS:", player:GetFullName())
		return false
	end

	local character = player.Character
	if not character or not character.Parent or not character:IsDescendantOf(Workspace) then
		return false
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local rootPart = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not humanoid or humanoid.Health <= 0 or not rootPart then
		return false
	end

	local defaultWalkSpeed = (Config.Character and Config.Character.DefaultWalkSpeed) or 16
	local defaultJumpPower = (Config.Character and Config.Character.DefaultJumpPower) or 50
	local defaultJumpHeight = (Config.Character and Config.Character.DefaultJumpHeight) or 7.2

	if not humanoid:GetAttribute("BaseWalkSpeed") then
		local currentSpeed = humanoid.WalkSpeed
		humanoid:SetAttribute("BaseWalkSpeed", if currentSpeed > 0 then currentSpeed else defaultWalkSpeed)
	end
	if not humanoid:GetAttribute("BaseJumpPower") then
		local currentPower = humanoid.JumpPower
		humanoid:SetAttribute("BaseJumpPower", if currentPower > 0 then currentPower else defaultJumpPower)
	end
	if not humanoid:GetAttribute("BaseJumpHeight") then
		local currentHeight = humanoid.JumpHeight
		humanoid:SetAttribute("BaseJumpHeight", if currentHeight > 0 then currentHeight else defaultJumpHeight)
	end

	humanoid:SetAttribute("MovementLocked", true)
	humanoid.WalkSpeed = 0
	humanoid.JumpPower = 0
	humanoid.JumpHeight = 0
	humanoid.AutoRotate = false

	-- Detener cualquier inercia o velocidad física residual
	rootPart.AssemblyLinearVelocity = Vector3.zero
	rootPart.AssemblyAngularVelocity = Vector3.zero
	for _, desc in ipairs(character:GetDescendants()) do
		if desc:IsA("BasePart") then
			desc.AssemblyLinearVelocity = Vector3.zero
			desc.AssemblyAngularVelocity = Vector3.zero
		end
	end

	return true
end

-- Restaura autoritativamente el movimiento normal del Character al pasar a PLAYING o Lobby
function SpawnService:UnlockCharacterMovement(player: Player?): boolean
	if typeof(player) ~= "Instance" or not player:IsA("Player") or player.Parent ~= Players then
		return false
	end

	local character = player.Character
	if not character or not character.Parent then
		return false
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return false
	end

	local defaultWalkSpeed = (Config.Character and Config.Character.DefaultWalkSpeed) or 16
	local defaultJumpPower = (Config.Character and Config.Character.DefaultJumpPower) or 50
	local defaultJumpHeight = (Config.Character and Config.Character.DefaultJumpHeight) or 7.2

	local baseWalkSpeed = humanoid:GetAttribute("BaseWalkSpeed")
	local baseJumpPower = humanoid:GetAttribute("BaseJumpPower")
	local baseJumpHeight = humanoid:GetAttribute("BaseJumpHeight")

	humanoid:SetAttribute("MovementLocked", nil)
	humanoid.WalkSpeed = if typeof(baseWalkSpeed) == "number" and baseWalkSpeed > 0 then baseWalkSpeed else defaultWalkSpeed
	humanoid.JumpPower = if typeof(baseJumpPower) == "number" and baseJumpPower > 0 then baseJumpPower else defaultJumpPower
	humanoid.JumpHeight = if typeof(baseJumpHeight) == "number" and baseJumpHeight > 0 then baseJumpHeight else defaultJumpHeight
	humanoid.AutoRotate = true

	return true
end

-- Bloquea movimiento para todos los participantes válidos de una sesión
function SpawnService:LockSessionPlayers(session: MatchSession)
	if not session then
		warn("[SpawnService] LockSessionPlayers: MatchSession nula o inválida")
		return
	end

	local participants = self:GetSessionParticipants(session)
	if #participants == 0 then
		warn(string.format("[SpawnService] LockSessionPlayers: no se encontraron participantes válidos para Match '%s'", tostring(session.Id)))
		return
	end

	if session.Mode == "1v1" and #participants < 2 then
		warn(string.format("[SpawnService] LockSessionPlayers: participante faltante en 1v1 para Match '%s' (encontrados: %d)",
			tostring(session.Id), #participants))
	end

	for _, player in ipairs(participants) do
		warn(
			"[DEBUG MovementLock]",
			"Match=", tostring(session.Id),
			"Participant=", tostring(player),
			"Type=", typeof(player),
			"Class=", if typeof(player) == "Instance" then player.ClassName else "N/A"
		)
		self:LockCharacterMovement(player)
	end
end

-- Restaura movimiento para todos los participantes válidos de una sesión
function SpawnService:UnlockSessionPlayers(session: MatchSession)
	if not session then
		warn("[SpawnService] UnlockSessionPlayers: MatchSession nula o inválida")
		return
	end

	local participants = self:GetSessionParticipants(session)
	for _, player in ipairs(participants) do
		self:UnlockCharacterMovement(player)
	end
end


-- Deprecated (Fase 4B Zero-Death): En arquitectura Zero-Death el Character es persistente y no requiere rescue reactivo
function SpawnService:StartMatchRespawnTracking(_session: MatchSession)
	-- No-op: Zero-Death elimina el ciclo de muerte/respawn nativo en partida
end

-- Deprecated (Fase 4B Zero-Death): Limpieza no requerida al no existir listeners activos
function SpawnService:StopMatchRespawnTracking(_matchId: string)
	-- No-op
end

-- Valida spawns de la partida y posiciona a RedPlayer y BluePlayer
function SpawnService:SpawnMatchPlayers(session: MatchSession): SpawnBatchResult
	local sessionId = if session then session.Id else ""
	local result: SpawnBatchResult = {
		Success = false,
		SessionId = sessionId,
		Required = 0,
		Placed = 0,
		PlacedPlayers = {},
		Failures = {},
	}
	if not session then
		warn("[SpawnService] MatchSession invalida")
		table.insert(result.Failures, { Reason = "InvalidSession" })
		return result
	end

	local participants = session.Participants or {}
	-- Resolve the whole batch before moving anyone. Never prepare only one side.
	for _, participant in ipairs(participants) do
		if participant.State ~= "Left" and participant.State ~= "Released" then
			local target, reason = self:ResolveParticipantSpawn(session.Id, participant.Player)
			if not target then
				table.insert(result.Failures, { Player=participant.Player, Reason=reason or "SpawnUnavailable" })
			end
		end
	end
	if #result.Failures > 0 then
		for _,participant in ipairs(participants) do if participant.State~="Left" and participant.State~="Released" then result.Required+=1 end end
		return result
	end
	for _, participant in ipairs(participants) do
		if participant.State ~= "Left" and participant.State ~= "Released" then
			result.Required += 1
			local spawnPart, reason = self:ResolveParticipantSpawn(session.Id, participant.Player)
			if not spawnPart then
				table.insert(result.Failures, { Player = participant.Player, UserId = participant.UserId, Team = participant.Team, Slot = participant.Slot, Reason = reason or "SpawnUnavailable" })
			elseif self:TeleportCharacterToSpawn(participant.Player, spawnPart) then
				result.Placed += 1
				table.insert(result.PlacedPlayers, participant.Player)
			else
				table.insert(result.Failures, { Player = participant.Player, UserId = participant.UserId, Team = participant.Team, Slot = participant.Slot, Reason = "TeleportFailed" })
			end
		end
	end
	result.Success = result.Required > 0 and result.Placed == result.Required and #result.Failures == 0
	print(string.format("[SpawnService] Posicionamiento Match '%s': %d/%d; Success=%s", session.Id, result.Placed, result.Required, tostring(result.Success)))

	-- Asegurar que los jugadores cuenten con su Slap equipado tras el reposicionamiento
	local slapService = self:_getSlapService()
	if result.Success and slapService then
		for _,p in ipairs(result.PlacedPlayers) do slapService:GiveSlap(p) end
	end

	return result
end

-- Retorna a los jugadores al punto de spawn del lobby reutilizando sus Characters existentes
function SpawnService:ReturnPlayersToLobby(redPlayer: any?, bluePlayer: any?): boolean
	local lobbySpawn = self._lobbySpawn
	if not lobbySpawn or not lobbySpawn:IsDescendantOf(Workspace) then
		local lobby = Workspace:FindFirstChild("Lobby")
		lobbySpawn = lobby and lobby:FindFirstChild("SpawnLocation") :: SpawnLocation?
		self._lobbySpawn = lobbySpawn
	end

	if not lobbySpawn then
		warn("[SpawnService] No se puede retornar al lobby: SpawnLocation no encontrado")
		return false
	end

	local ragdollService = self:_getRagdollService()
	local allReturned = true

	local returnSinglePlayer = function(player: Player?)
		if not player or not player:IsA("Player") or not player:IsDescendantOf(Players) then return end
		local character = player.Character
			-- Invalidate competitive work BEFORE recovery/teleport, including individual results exits.
			self._arenaRespawn:Cancel(player, "ReturnToLobby", false)
			if character then
				character:SetAttribute("ArenaPhysicsGeneration", (character:GetAttribute("ArenaPhysicsGeneration") or 0) + 1)
				character:SetAttribute("ArenaPhysicsPhase", "Lobby")
				CharacterPhysics.Restore(character)
			end
		if character and character.Parent then
			if ragdollService and type(ragdollService.ResetRagdollImmediate) == "function" then
				ragdollService:ResetRagdollImmediate(character)
			elseif ragdollService then
				ragdollService:RemoveRagdoll(character)
			end

			self:UnlockCharacterMovement(player)

			local hum = character:FindFirstChildOfClass("Humanoid")
			if hum then
				pcall(function()
					hum.PlatformStand = false
					hum.AutoRotate = true
					hum:SetStateEnabled(Enum.HumanoidStateType.Dead, true)
					hum:SetStateEnabled(Enum.HumanoidStateType.GettingUp, true)
					hum:ChangeState(Enum.HumanoidStateType.Running)
				end)
			end
		end

			if not self:TeleportCharacterToSpawn(player, lobbySpawn) then
			allReturned = false
		end
			if player.Character then CharacterPhysics.Restore(player.Character) end
			local returnedHumanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
			if returnedHumanoid then
				returnedHumanoid.Jump = false
				returnedHumanoid.PlatformStand = false
				returnedHumanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, true)
				returnedHumanoid:ChangeState(Enum.HumanoidStateType.Running)
			end
			local rounds = self:_getRoundService()
			local returningSession = rounds and rounds:GetSessionForPlayer(player)
			CharacterPhysics.Trace(player, "LobbyReturned", lobbySpawn, returningSession and returningSession.State)

		-- Limpieza inmediata de identidad de match a nivel de player
		pcall(function()
			player:SetAttribute("MatchId", nil)
			player:SetAttribute("MatchTeam", nil)
		end)
	end

	local processTarget = function(target: any?)
		if not target then return end
		if type(target) == "table" and not (typeof(target) == "Instance") then
			for _, p in ipairs(target) do
				returnSinglePlayer(p)
			end
		else
			returnSinglePlayer(target)
		end
	end

	processTarget(redPlayer)
	processTarget(bluePlayer)

	print("[SpawnService] Jugadores retornados a Workspace.Lobby.SpawnLocation con estados normales restaurados")
	return allReturned
end

return SpawnService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="561">
        <Properties>
          <string name="Name">TeamSpawnResolver</string>
          <string name="Source"><![CDATA[--!strict
-- Authored reference markers; never moves them or requires collidable surfaces.
local Resolver = {}
local function positiveInteger(value: any): boolean
 return type(value)=="number" and value>0 and value<math.huge and value%1==0
end
function Resolver.Resolve(map: Instance, required: number?): (any?, number, string?)
 local count=required or 1
 if not positiveInteger(count) then return nil,0,"InvalidRequiredTeamSize" end
 local result={Red={},Blue={}}
 local capacity=math.huge
 for _,team in ipairs({"Red","Blue"}) do
  local folder=map:FindFirstChild(team.."Team")
  if not folder or not folder:IsA("Folder") then return nil,0,"MissingTeamFolder:"..team.."Team" end
  local slots={};local highest=0
  for _,part in ipairs(folder:GetChildren()) do
   local raw=part.Name:match("^Spawn([1-9]%d*)$")
   if raw then
    local slot=tonumber(raw)
    if not slot or not positiveInteger(slot) or slot>1024 then return nil,0,"InvalidSpawnIndex:"..part.Name end
    if slots[slot] then return nil,0,"DuplicateSpawn:"..team.."Team/"..part.Name end
    if not part:IsA("BasePart") then return nil,0,"InvalidSpawnPart:"..team.."Team/"..part.Name end
    slots[slot]=part;highest=math.max(highest,slot)
   end
  end
  for slot=1,math.max(count,highest) do
   local part=slots[slot]
   if not part then return nil,0,"MissingSpawn:"..team.."Team/Spawn"..slot end
   table.insert(result[team],part)
  end
  capacity=math.min(capacity,#result[team])
 end
 return result,capacity,nil
end
return Resolver
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="562">
        <Properties>
          <string name="Name">ThunderController</string>
          <string name="Source"><![CDATA[--!strict
-- ThunderController (Re-export / alias en Services para compatibilidad)
-- La implementación canónica reside en ServerScriptService.PointEffectControllers.ThunderController
local ServerScriptService = game:GetService("ServerScriptService")
local pec = ServerScriptService:WaitForChild("PointEffectControllers", 10)
local thunderMod = pec and pec:WaitForChild("ThunderController", 10)
assert(thunderMod and thunderMod:IsA("ModuleScript"), "[ThunderController] ModuleScript no encontrado en PointEffectControllers")

return require(thunderMod)
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="563">
        <Properties>
          <string name="Name">Trading</string>
        </Properties>
        <Item class="ModuleScript" referent="564">
          <Properties>
            <string name="Name">PublicInventory</string>
            <string name="Source"><![CDATA[--!nonstrict
local Policy=require(script.Parent.TradePolicy)
local View={}
function View.Build(data,uid,catalog)
 local inventory=data.Inventory or {};local equipped=inventory.Equipped and inventory.Equipped.Slaps
 local rows,represented={},{}
 local function row(reward,unit,key)
  local v=catalog.Variations.ById[reward.VariationId]
  local allowed,reason=false,'LegacyEntitlement'
  if unit then allowed,reason=Policy.Check(unit,inventory,uid,catalog)end
  return {EntryId=key,UnitId=unit and unit.UnitId,RewardId=reward.RewardId,SlapId=reward.SlapId,VariationId=reward.VariationId,
   DisplayName=reward.DisplayName,VariationName=v.DisplayName,Rarity=v.Id,Owned=true,Equipped=equipped==reward.RewardId,
   Tradable=allowed,Restriction=reason}
 end
 for key,unit in pairs(type(inventory.SlapUnits)=='table'and inventory.SlapUnits or {})do
  if type(key)=='string' and type(unit)=='table' and unit.UnitId==key and unit.OwnerUserId==uid then
   local reward=catalog.Rewards[unit.RewardId]
   if reward and reward.SlapId==unit.SlapId and reward.VariationId==unit.VariationId then
    table.insert(rows,row(reward,unit,key));represented[unit.RewardId]=true
   end
  end
 end
 for id,owned in pairs(inventory.Owned and inventory.Owned.Slaps or {})do
  local reward=catalog.Rewards[id]
  if owned==true and reward and not represented[id] then table.insert(rows,row(reward,nil,'Legacy:'..id));represented[id]=true end
 end
 -- The existing default entitlement is universal, even before crates extend the schema.
 if not represented[catalog.DefaultRewardId]then table.insert(rows,row(catalog.Rewards[catalog.DefaultRewardId],nil,'Legacy:'..catalog.DefaultRewardId))end
 table.sort(rows,function(a,b)return a.RewardId==b.RewardId and a.EntryId<b.EntryId or a.RewardId<b.RewardId end)
 return rows
end
function View.Profile(player,data,catalog,config,page)
 local all=View.Build(data,player.UserId,catalog);local start=(page-1)*config.InventoryPageSize+1;local entries={}
 for i=start,math.min(#all,start+config.InventoryPageSize-1)do table.insert(entries,all[i])end
 local function stat(n)return type(n)=='number' and n==n and n>=0 and n<math.huge and math.floor(n)or 0 end
 return {UserId=player.UserId,DisplayName=player.DisplayName,Username=player.Name,
  Stats={Wins=stat(data.Wins),Losses=stat(data.Losses),TotalKills=stat(data.Kills),Streaks=stat(type(data.WinStreak)=='table'and data.WinStreak.Total)},
  Progression={Available=false,Status='Nivel y EXP pendientes'},Inventory=entries,Page=page,TotalItems=#all,
  HasNext=start+#entries<=#all,TradeCommitEnabled=false}
end
return View
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="565">
          <Properties>
            <string name="Name">TradeEngine</string>
            <string name="Source"><![CDATA[--!nonstrict
-- No yielding or inventory writes. Transport/clock/player state are injected for deterministic tests.
local Engine={};Engine.__index=Engine
local function copy(x)if type(x)~='table'then return x end;local y={};for k,v in pairs(x)do y[k]=copy(v)end;return y end
function Engine.new(config,deps)return setmetatable({C=config,D=deps,Trades={},Busy={},Reserved={},Cooldown={}},Engine)end
function Engine:_pair(a,b,near)
 if a==b then return false,'SelfTarget' end
 if not self.D.Eligible(a)or not self.D.Eligible(b)then return false,'PlayerUnavailable' end
 if near then local distance=self.D.Distance(a,b);if type(distance)~='number'or not(distance<=self.C.InspectDistance)or distance<0 then return false,'OutOfRange'end end
 return true
end
function Engine:_publish(t)
 t.Sequence=(t.Sequence or 0)+1
 local function keys(values)local out={};for k,v in pairs(values)do out[tostring(k)]=copy(v)end;return out end
 local packet={TradeId=t.Id,State=t.State,Revision=t.Revision,A=t.A,B=t.B,
  Sequence=t.Sequence,Names={[tostring(t.A)]=self.D.Name(t.A),[tostring(t.B)]=self.D.Name(t.B)},Offers=keys(t.Offers),Accepted=keys(t.Accepted),Confirmed=keys(t.Confirmed),
  Deadline=t.Deadline,ExpiresAt=t.ExpiresAt,Reason=t.Reason,TradeCommitEnabled=false}
 self.D.Emit(t.A,'Trade',packet);self.D.Emit(t.B,'Trade',packet)
end
function Engine:_release(t)
 for _,uid in ipairs({t.A,t.B})do
  if self.Busy[uid]==t.Id then self.Busy[uid]=nil end
  for key,owner in pairs(self.Reserved)do if owner==t.Id then self.Reserved[key]=nil end end
 end
end
function Engine:_cancel(t,why)
 if t.Terminal or t.State=='Committing'then return false,'CannotCancel' end
 t.State='Cancelled';t.Reason=why;t.Terminal=true;t.FinishedAt=self.D.Clock();self:_release(t);self:_publish(t);return true
end
function Engine:Invite(a,b)
 local ok,why=self:_pair(a,b,true);if not ok then return false,why end
 if self.C.TradeInvitationsEnabled~=true then return false,'InvitationsDisabled' end
 if self.Busy[a]or self.Busy[b]then return false,'PlayerBusy' end
 local now=self.D.Clock();if (self.Cooldown[a]or 0)>now then return false,'InviteCooldown' end
 local id=self.D.Id();local t={Id=id,A=a,B=b,State='Requested',Revision=0,Offers={[a]={},[b]={}},Accepted={},Confirmed={},
  CreatedAt=now,ExpiresAt=now+self.C.InviteTimeoutSeconds,MaxUntil=now+self.C.MaxTradeSeconds}
 self.Cooldown[a]=now+self.C.InviteCooldownSeconds;self.Trades[id]=t;self.Busy[a]=id;self.Busy[b]=id
 self:_publish(t);return true,id
end
function Engine:_validateOffers(t)
 for _,uid in ipairs({t.A,t.B})do for _,row in ipairs(t.Offers[uid])do
  local current=self.D.Unit(uid,row.UnitId)
  if not current or not current.Tradable or current.RewardId~=row.RewardId or current.VariationId~=row.VariationId
   or self.Reserved[tostring(uid)..':'..row.UnitId]~=t.Id then return false,'OfferChangedOrUnavailable' end
 end end
 return true
end
function Engine:Act(uid,action,id,revision,item)
 local t=self.Trades[id]
 if not t or uid~=t.A and uid~=t.B then return false,'NotParticipant' end
 if t.Terminal then return false,'TradeClosed' end
 local valid,why=self:_pair(t.A,t.B,false);if not valid then self:_cancel(t,why);return false,why end
 local now=self.D.Clock()
 if now>=t.MaxUntil or t.State=='Requested'and now>=t.ExpiresAt then self:_cancel(t,'Expired');return false,'Expired' end
 if revision~=t.Revision then return false,'StaleRevision' end
 if action=='Cancel'then return self:_cancel(t,'CancelledByPlayer')end
 if action=='Respond'then
  if t.State~='Requested'or uid~=t.B then return false,'InvalidAcceptance' end
  if item~=true then return self:_cancel(t,'InvitationDeclined')end
  local near,err=self:_pair(t.A,t.B,true);if not near then self:_cancel(t,err);return false,err end
  t.State='Negotiating';self:_publish(t);return true
 end
 if action=='Add'or action=='Remove'then
  if t.State~='Negotiating'then return false,'OffersLocked' end
  if type(item)~='string'or #item>256 then return false,'InvalidUnitId' end
  local rows=t.Offers[uid];local at
  for i,row in ipairs(rows)do if row.UnitId==item then at=i end end
  local key=tostring(uid)..':'..item
  if action=='Add'then
   if at then return false,'DuplicateUnit' end
   if #rows>=self.C.MaxSlapsPerSide then return false,'OfferFull' end
   local row=self.D.Unit(uid,item)
   if not row or not row.Tradable then return false,'ItemNotTradable' end
   if self.Reserved[key]and self.Reserved[key]~=id then return false,'UnitReserved' end
   self.Reserved[key]=id;table.insert(rows,copy(row))
  else
   if not at then return false,'NotOffered' end
   table.remove(rows,at);self.Reserved[key]=nil
  end
  t.Revision+=1;t.Accepted={};t.Confirmed={};t.Deadline=nil
 elseif action=='Accept'then
  if t.State~='Negotiating'then return false,'InvalidState' end
  local ok,err=self:_validateOffers(t);if not ok then self:_cancel(t,err);return false,err end
  if #t.Offers[t.A]+#t.Offers[t.B]==0 then return false,'EmptyTrade' end
  t.Accepted[uid]=true
  if t.Accepted[t.A]and t.Accepted[t.B]then t.State='SafetyCountdown';t.Deadline=now+self.C.SafetyCountdownSeconds end
 elseif action=='Confirm'then
  if t.State~='FinalConfirmation'or not t.Deadline or now<t.Deadline then return false,'FinalConfirmationNotReady' end
  local ok,err=self:_validateOffers(t);if not ok then self:_cancel(t,err);return false,err end
  t.Confirmed[uid]=true
  if t.Confirmed[t.A]and t.Confirmed[t.B]then
   -- Never display Completed for a simulation and never manufacture a durable journal.
   t.BothConfirmations=true
   local committed,reason=self.D.Commit({TradeId=t.Id,Revision=t.Revision,A=t.A,B=t.B,Offers=copy(t.Offers)})
   assert(not committed,'Real transfers are not installed in V1.0')
   return self:_cancel(t,reason or 'TradeCommitDisabled')
  end
 else return false,'UnknownAction' end
 self:_publish(t);return true
end
function Engine:Tick()
 local now=self.D.Clock()
 for id,t in pairs(self.Trades)do
  if t.Terminal then if now-t.FinishedAt>=self.C.TerminalRetentionSeconds then self.Trades[id]=nil end
  elseif not self.D.Eligible(t.A)or not self.D.Eligible(t.B)then self:_cancel(t,'PlayerUnavailable')
  elseif now>=t.MaxUntil or t.State=='Requested'and now>=t.ExpiresAt then self:_cancel(t,'Expired')
  elseif t.State=='SafetyCountdown'and now>=t.Deadline then
   local ok,why=self:_validateOffers(t);if not ok then self:_cancel(t,why)else t.State='FinalConfirmation';self:_publish(t)end
  end
 end
end
function Engine:CancelForPlayer(uid)
 local t=self.Trades[self.Busy[uid]];if t then self:_cancel(t,'PlayerUnavailable')end
end
function Engine:Disconnect(uid)
 self:CancelForPlayer(uid);self.Cooldown[uid]=nil
end
return Engine
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="566">
          <Properties>
            <string name="Name">TradePolicy</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Explicit ordinary crate provenance only. Legacy entitlements are never tradable units.
local Policy={}
Policy.AllowedSlapIds={Classic=true}
Policy.NonTradableSlapIds={}
Policy.AllowedVariationIds={Common=true,Uncommon=true,Rare=true,Gold=true,Arcoiris=true,Emote=true,Wings=true,Epic=true,Legendary=true,Blood=true,Galaxy=true}
Policy.NonTradableRewardIds={['Classic:Basic']=true}
Policy.NonTradableSourceTypes={Premium=true,Temporary=true,Test=true,Reward=true}
function Policy.Check(unit,inventory,uid,catalog)
 if type(unit)~='table' or type(unit.UnitId)~='string' or unit.OwnerUserId~=uid then return false,'OwnershipMismatch' end
 local reward=catalog.Rewards[unit.RewardId]
 if not reward or reward.SlapId~=unit.SlapId or reward.VariationId~=unit.VariationId then return false,'InvalidVariation' end
 if type(inventory.Owned)~='table' or type(inventory.Owned.Slaps)~='table' or inventory.Owned.Slaps[unit.RewardId]~=true then return false,'NotOwned' end
 local variation=catalog.Variations.ById[unit.VariationId]
 if not Policy.AllowedSlapIds[unit.SlapId]or Policy.NonTradableSlapIds[unit.SlapId]then return false,'RestrictedSlap'end
 if not Policy.AllowedVariationIds[unit.VariationId] or Policy.NonTradableRewardIds[unit.RewardId] then return false,'RestrictedItem' end
 if unit.Locked or unit.TradeLocked or unit.NonTradable or unit.PremiumOnly or unit.Temporary or unit.TestOnly or reward.LimitedStock or variation.LimitedStock then return false,'RestrictedItem' end
 if unit.Origin~='Crate' or Policy.NonTradableSourceTypes[unit.Origin] then return false,'RestrictedSource' end
 local op=type(inventory.CrateOperations)=='table' and inventory.CrateOperations[unit.OperationId]
 if type(op)~='table'then return false,'UnverifiedProvenance'end
 local crate=op and catalog.Crates.ById[op.CrateId]
 if not crate or crate.PremiumOnly or op.OwnerUserId~=uid or op.State~='Completed' then return false,'UnverifiedProvenance' end
 -- The immutable opening journal must really contain this unit, including batch rewards.
 local found=op.UnitId==unit.UnitId and op.RewardId==unit.RewardId
 if op.Rewards~=nil and type(op.Rewards)~='table'then return false,'UnverifiedProvenance'end
 for _,row in ipairs(op.Rewards or {})do if type(row)=='table'and row.UnitId==unit.UnitId and row.RewardId==unit.RewardId then found=true end end
 if not found then return false,'UnverifiedProvenance' end
 return true
end
return Policy
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="567">
          <Properties>
            <string name="Name">TradeRecoveryService</string>
            <string name="Source"><![CDATA[--!strict
-- Deliberately has no adapter/DataStore access. No durable trade can start in V1.0.
local Recovery={}
function Recovery.Status()
 return {DurableRecoveryAvailable=false,Reason='ProfileLifecycleIntegrationPending',RequiresFencedProfileBridge=true}
end
function Recovery.Reconcile(_tradeId: string): (boolean,string)
 return false,'DurableRecoveryUnavailable'
end
return Recovery
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="568">
          <Properties>
            <string name="Name">TradeTransactionService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- No inventory mutation path is installed until ALL profile saves/mutators are fenced.
local Transaction={}
function Transaction.Availability(config,info,isStudio)
 if isStudio or not info or info.ProviderName=='InMemory' or info.Environment~='Production' or info.WritesToCloud~=true then return false,'InMemoryCommitForbidden' end
 if config.TradeCommitEnabled~=true then return false,'TradeCommitDisabled' end
 return false,'ProfileLifecycleIntegrationPending'
end
function Transaction.Commit(_intent,_backend)
 -- A boolean, fake backend, client confirmation or two UpdateAsync calls cannot bypass this gate.
 return false,'TradeCommitDisabled'
end
return Transaction
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
    <Item class="Folder" referent="569">
      <Properties>
        <string name="Name">Shop</string>
      </Properties>
      <Item class="ModuleScript" referent="570">
        <Properties>
          <string name="Name">ProfilePurchase</string>
          <string name="Source"><![CDATA[--!strict
-- Pure staging only: no profile, provider, notifications, yields or persistence.
local Purchase = {}
function Purchase.Stage(data: any, product: any): (any?, string?)
 if type(product) ~= "table" or product.Currency ~= "Coins" or (product.ProductType ~= "Cosmetic" and product.ProductType ~= "Ability") then return nil,"UnsupportedProduct" end
 if product.ProductType == "Ability" and (product.Category ~= "Abilities" or type(product.Metadata) ~= "table"
  or product.Metadata.PurchaseEnabled ~= true or product.Metadata.PriceApproved ~= true) then return nil,"PurchasesNotEnabled" end
 if type(product.Id) ~= "string" or product.Id == "" or type(product.Category) ~= "string" or product.Category == "" then return nil,"InvalidProductId" end
 local price = product.Price
 if type(price) ~= "number" or price ~= price or price < 0 or price == math.huge or price % 1 ~= 0 then return nil,"InvalidPrice" end
 if not product.IsAvailable then return nil,"ProductUnavailable" end
 if type(data) ~= "table" or type(data.Coins) ~= "number" or data.Coins ~= data.Coins or data.Coins < 0 or data.Coins == math.huge then return nil,"InvalidProfile" end
 local inventory = data.Inventory
 if type(inventory) ~= "table" or type(inventory.Owned) ~= "table" or type(inventory.Equipped) ~= "table" then return nil,"InvalidInventory" end
 local owned = inventory.Owned[product.Category]
 if owned and owned[product.Id] == true then return nil,"AlreadyOwned" end
 if data.Coins < price then return nil,"InsufficientFunds" end
 -- Copy-on-write: an exception while staging cannot leave half a purchase.
 local nextData = table.clone(data)
 local nextInventory = table.clone(inventory)
 nextInventory.Owned = table.clone(inventory.Owned)
 local nextOwned = table.clone(owned or {})
 nextOwned[product.Id] = true
 nextInventory.Owned[product.Category] = nextOwned
 nextData.Inventory = nextInventory
 nextData.Coins = data.Coins - price
 return nextData,nil
end
return Purchase
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="571">
        <Properties>
          <string name="Name">Providers</string>
        </Properties>
        <Item class="ModuleScript" referent="572">
          <Properties>
            <string name="Name">AbilityProvider</string>
            <string name="Source"><![CDATA[--!nonstrict
local Definitions=require(game.ReplicatedStorage.Shared.AbilityDefinitions)
local Registry=require(game.ServerScriptService.Services.AbilityRegistry)
local Provider={}
local function players() return require(game.ServerScriptService.Services.PlayerService) end
function Provider:GetCategory() return Definitions.Category end
function Provider:GetProduct(id)
 local entry=Registry:Get(id)
 if not entry or not entry.Enabled then return nil end
 local d=entry.Public;local shop=entry.Shop
 local approved=shop.PriceApproved==true and type(shop.Price)=="number" and shop.Price>=0
  and shop.Price<math.huge and shop.Price%1==0
 return {Id=id,Category=Definitions.Category,ProductType="Ability",DisplayName=d.DisplayName,
  Description=d.Description,Price=if id==Definitions.DefaultId then 0 elseif approved then shop.Price else 0,
  Currency="Coins",Rarity="Common",Icon=d.Icon,IsAvailable=d.Enabled==true,
  Metadata={PriceApproved=approved,PurchaseEnabled=id~=Definitions.DefaultId and approved and shop.Price>0 and shop.PurchaseEnabled==true,PricePending=id~=Definitions.DefaultId and not approved,
   Cooldown=d.Cooldown,Duration=d.Duration}}
end
function Provider:GetProducts()
 local result={} for _,id in ipairs(Registry.GetPublicCatalog().Order) do table.insert(result,self:GetProduct(id)) end return result
end
function Provider:CanPurchase(player,product)
 if not players():IsShopDataReady(player) then return false,"DataNotLoaded" end
 local actual=self:GetProduct(product.Id)
 if not actual or not actual.IsAvailable then return false,"ProductUnavailable" end
 if players():HasItem(player,Definitions.Category,product.Id) then return false,"AlreadyOwned" end
 if not actual.Metadata.PurchaseEnabled then return false,"PurchasesNotEnabled" end
 return true
end
function Provider:CanEquip(player,product)
 if not players():IsShopDataReady(player) then return false,"DataNotLoaded" end
 if not self:GetProduct(product.Id) or not players():HasItem(player,Definitions.Category,product.Id) then return false,"NotOwned" end
 -- Shop equipment is only the saved preference, never the current round selection.
 return true
end
function Provider:OnEquipped(player,product)
 local ok,reason=self:CanEquip(player,product);if not ok then return false,reason end
 if players():GetEquippedItem(player,Definitions.Category)==product.Id then return true end
 return players():SetEquippedItem(player,Definitions.Category,product.Id)
end
function Provider:OnUnequipped(player,_product)
 local product=self:GetProduct(Definitions.DefaultId)
 if not product then return false,"ProductUnavailable" end
 return self:OnEquipped(player,product)
end
function Provider:OnPurchased(player,product)
 local ok,reason=self:CanPurchase(player,product);if not ok then return false,reason end
 return players():CommitShopPurchase(player,self:GetProduct(product.Id))
end
return Provider
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="573">
          <Properties>
            <string name="Name">CrateProviders</string>
            <string name="Source"><![CDATA[--!nonstrict
local RS=game:GetService("ReplicatedStorage")
local Catalog=require(RS.Shared.SlapCrates.Catalog)
local Inventory=require(RS.Shared.SlapCrates.Inventory)
local Providers={}
function Providers.Create(service)
 local crates={}
 function crates:GetCategory()return "Crates"end
 function crates:GetProducts()return service:GetCatalog()end
 function crates:GetProduct(id)for _,p in ipairs(self:GetProducts())do if p.Id==id then return p end end end
 function crates:CanPurchase()return false,"UseCratePurchaseWithOdds"end
 function crates:CanEquip()return false,"NotEquippable"end
 function crates:OnPurchased()return false,"UseCratePurchaseWithOdds"end
 function crates:OnEquipped()return false,"NotEquippable"end
 function crates:OnUnequipped()return false,"NotEquippable"end
 local slaps={}
 function slaps:GetCategory()return "Slaps"end
 function slaps:GetProduct(id)
  local reward=Catalog.Rewards[id];if not reward then return nil end
  return {Id=id,Category="Slaps",ProductType="Cosmetic",DisplayName=reward.DisplayName,Description="Se obtiene mediante cajas. Selección para el próximo combate.",
   Price=0,Currency="Coins",Rarity=reward.VariationId,Icon=Catalog.Variations.ById[reward.VariationId].Icon,
   IsAvailable=service:_resource(reward),Metadata={CrateExclusive=true,PurchaseEnabled=false}}
 end
 function slaps:GetProducts()local r={}for id in pairs(Catalog.Rewards)do table.insert(r,self:GetProduct(id))end;return r end
 function slaps:CanPurchase()return false,"CrateExclusive"end
 function slaps:OnPurchased()return false,"CrateExclusive"end
 function slaps:CanEquip(player,product)
  local ps=service:_players();if not ps:IsShopDataReady(player)then return false,"DataNotLoaded"end
  if not service:_lobby(player)then return false,"LobbyOnly"end
  local r=Catalog.Rewards[product.Id];local inv=Inventory.Extend(ps:GetInventory(player))
  if not r or not inv.Owned.Slaps[product.Id]then return false,"NotOwned"end
  if not service:_resource(r)then return false,"ProductUnavailable"end
  return true
 end
 function slaps:OnEquipped(player,product)
  local ok,err=self:CanEquip(player,product);if not ok then return false,err end
  return service:_players():SetEquippedItem(player,"Slaps",product.Id)
 end
 function slaps:OnUnequipped(player)return self:OnEquipped(player,self:GetProduct(Catalog.DefaultRewardId))end
 return {crates,slaps}
end
return Providers
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="574">
          <Properties>
            <string name="Name">DeathEffectProvider</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Adapter to the existing Shop/Inventory and coherent Coins purchase contracts.
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local ServerStorage=game:GetService("ServerStorage")
local Catalog=require(ReplicatedStorage.Shared.DeathEffectDefinitions)
local Settings=require(ReplicatedStorage.Shared.DeathFeedbackConfig).DeathEffects
local Provider={}
local function players(self)
 if self._playerService then return self._playerService end
 return require(game.ServerScriptService.Services.PlayerService)
end
function Provider:GetCategory() return "DeathEffects" end
function Provider:GetDefaultProductId() return Settings.DefaultKillEffectId end
function Provider:GetResource(id)
 local definition=type(id)=="string" and Catalog[id]
 if not definition or definition.IsShopProduct~=true or id==Settings.DefaultFallEffectId then return nil end
 local folder=ServerStorage:FindFirstChild("DeathEffects")
 local model=folder and folder:FindFirstChild(definition.ModelName)
 local origin=model and model:FindFirstChild("Origin")
 if not model or not model:IsA("Model") or not origin or not origin:IsA("BasePart") then return nil end
 local particles=0
 local duration=model:GetAttribute("Duration")
 if type(duration)~="number" or duration~=duration or duration<=0 or duration>Settings.MaxDuration then return nil end
 for _,v in model:GetDescendants() do
  if v:IsA("LuaSourceContainer") or v:IsA("Explosion") then return nil end
  if v:IsA("BasePart") and (not v.Anchored or v.CanCollide or v.CanTouch or v.CanQuery) then return nil end
  if v:IsA("ParticleEmitter") then
   local count=v:GetAttribute("EmitCount")
   local delay=v:GetAttribute("EmitDelay")
   if v.Rate~=0 or v.Enabled or v.Texture=="" or type(count)~="number" or count~=count or count<=0 or count>80
    or type(delay)~="number" or delay~=delay or delay<0 or delay+v.Lifetime.Max>duration then return nil end
   particles+=1
  end
 end
 return if particles>0 then model else nil
end
function Provider:GetProduct(id)
 local definition=type(id)=="string" and Catalog[id]
 if not definition or definition.IsShopProduct~=true or id==Settings.DefaultFallEffectId then return nil end
 return {Id=id,Category=self:GetCategory(),ProductType="Cosmetic",DisplayName=definition.DisplayName,
  Description=definition.Description,Price=definition.Price,Currency="Coins",Rarity=definition.Rarity,
  Icon=definition.Icon,IsAvailable=self:GetResource(id)~=nil,Metadata={ModelName=definition.ModelName}}
end
function Provider:GetProducts()
 local products={}
 for id in pairs(Catalog) do local product=self:GetProduct(id);if product then table.insert(products,product) end end
 table.sort(products,function(a,b)return a.Id<b.Id end)
 return products
end
function Provider:HasProduct(player,id)
 return self:GetProduct(id)~=nil and players(self):HasItem(player,self:GetCategory(),id)
end
function Provider:GetEquippedEffectId(player)
 local ps=players(self)
 local inventory=ps:GetInventory(player)
 local selected=inventory and inventory.Equipped and inventory.Equipped[self:GetCategory()]
 local product=self:GetProduct(selected)
 if product and product.IsAvailable and self:HasProduct(player,selected) then return selected end
 -- Read-only fallback: do not overwrite a future owned selection when its asset is temporarily absent.
 return self:GetDefaultProductId()
end
local function validate(self,player,product)
 local ps=players(self)
 if not ps:IsShopDataReady(player) then return false,"DataNotLoaded" end
 if type(product)~="table" or product.Category~=self:GetCategory() then return false,"InvalidCategory" end
 local actual=self:GetProduct(product.Id)
 if not actual then return false,"ProductNotFound" end
 if not actual.IsAvailable then return false,"ProductUnavailable" end
 return true
end
function Provider:CanPurchase(player,product)
 local ok,reason=validate(self,player,product);if not ok then return false,reason end
 if self:HasProduct(player,product.Id) then return false,"AlreadyOwned" end
 return true,nil
end
function Provider:OnPurchased(player,product)
 local ok,reason=self:CanPurchase(player,product);if not ok then return false,reason end
 return players(self):CommitShopPurchase(player,self:GetProduct(product.Id))
end
function Provider:CanEquip(player,product)
 local ok,reason=validate(self,player,product);if not ok then return false,reason end
 if not self:HasProduct(player,product.Id) then return false,"NotOwned" end
 if self:GetEquippedEffectId(player)==product.Id then return false,"AlreadyEquipped" end
 return true
end
function Provider:OnEquipped(player,product)
 local ok,reason=validate(self,player,product);if not ok then return false,reason end
 if not self:HasProduct(player,product.Id) then return false,"NotOwned" end
 return players(self):SetEquippedItem(player,self:GetCategory(),product.Id)
end
function Provider:OnUnequipped(player,_product)
 local product=self:GetProduct(self:GetDefaultProductId())
 local ok,reason=validate(self,player,product);if not ok then return false,reason end
 return players(self):SetEquippedItem(player,self:GetCategory(),product.Id)
end
return Provider
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="575">
          <Properties>
            <string name="Name">PointEffectProvider</string>
            <string name="Source"><![CDATA[--!strict
-- PointEffectProvider
-- Adaptador entre el catálogo y estado de Point Effects y el Shop Framework.
-- Implementa estrictamente el contrato ProductProvider de Types.luau.
-- Reutiliza PointEffectDefinitions y PlayerService sin crear inventarios ni economías paralelas.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Types = require(ReplicatedStorage.Shared.Types)
local PointEffectDefinitions = require(ReplicatedStorage.Shared.PointEffectDefinitions)

type ProductDefinition = Types.ProductDefinition
type ProductProvider = Types.ProductProvider

local PointEffectProvider = {}

local _playerService: any = nil
local function hasResource(productId: string): boolean
	local folder = game:GetService("ServerStorage"):FindFirstChild("PointEffects")
	local model = folder and folder:FindFirstChild(productId)
	return model ~= nil and model:IsA("Model")
end

local function getPlayerService(): any
	if _playerService then
		return _playerService
	end

	local servicesFolder = ServerScriptService:FindFirstChild("Services")
	local mod = servicesFolder and servicesFolder:FindFirstChild("PlayerService")
	if mod and mod:IsA("ModuleScript") then
		local ok, result = pcall(require, mod)
		if ok and result then
			_playerService = result
			return result
		end
	end

	return nil
end

-- ==================================================
-- CONTRATO PRODUCT PROVIDER
-- ==================================================

function PointEffectProvider:GetCategory(): string
	return "PointEffects"
end

function PointEffectProvider:GetProducts(): { ProductDefinition }
	local products: { ProductDefinition } = {}
	local allDefs = PointEffectDefinitions.GetAll()

	for _, def in pairs(allDefs) do
		local prod: ProductDefinition = {
			Id = def.Id,
			Category = "PointEffects",
			ProductType = "Cosmetic",
			DisplayName = def.DisplayName,
			Description = def.Description,
			Price = def.Price,
			Currency = "Coins",
			IsAvailable = hasResource(def.Id),
			Rarity = def.Rarity,
			Metadata = {
				Rarity = def.Rarity,
			},
		}
		table.insert(products, prod)
	end

	-- Ordenar alfabéticamente o por precio para consistencia
	table.sort(products, function(a, b)
		if a.Price == b.Price then
			return a.Id < b.Id
		end
		return a.Price < b.Price
	end)

	return products
end

function PointEffectProvider:GetProduct(productId: string): ProductDefinition?
	if type(productId) ~= "string" or productId == "" then
		return nil
	end

	local def = PointEffectDefinitions.Get(productId)
	if not def then
		return nil
	end

	return {
		Id = def.Id,
		Category = "PointEffects",
		ProductType = "Cosmetic",
		DisplayName = def.DisplayName,
		Description = def.Description,
		Price = def.Price,
		Currency = "Coins",
		IsAvailable = hasResource(def.Id),
		Rarity = def.Rarity,
		Metadata = {
			Rarity = def.Rarity,
		},
	}
end

function PointEffectProvider:CanPurchase(player: Player, product: ProductDefinition): (boolean, string?)
	if not player then
		return false, "InvalidPlayer"
	end

	if product.Category ~= "PointEffects" then
		return false, "InvalidCategory"
	end
	if not self:GetProduct(product.Id) then return false, "ProductNotFound" end
	if not hasResource(product.Id) then return false, "ProductUnavailable" end

	if not product.IsAvailable then
		return false, "ProductUnavailable"
	end

	local ps = getPlayerService()
	if not ps then
		return false, "PlayerServiceNotAvailable"
	end

	-- Si el jugador ya posee este cosmético en su inventario genérico, se rechaza la recompra
	if ps:HasItem(player, "PointEffects", product.Id) then
		return false, "AlreadyOwned"
	end

	return true, nil
end

function PointEffectProvider:CanEquip(player: Player, product: ProductDefinition): (boolean, string?)
	if not player then
		return false, "InvalidPlayer"
	end

	if product.Category ~= "PointEffects" then
		return false, "InvalidCategory"
	end
	if not self:GetProduct(product.Id) then return false, "ProductNotFound" end
	if not hasResource(product.Id) then return false, "ProductUnavailable" end

	if product.ProductType ~= "Cosmetic" then
		return false, "NotEquippable"
	end

	local ps = getPlayerService()
	if not ps then
		return false, "PlayerServiceNotAvailable"
	end

	-- Verificar si el jugador posee el ítem en su inventario genérico
	if not ps:HasItem(player, "PointEffects", product.Id) then
		return false, "NotOwned"
	end

	-- Verificar si ya está equipado actualmente
	if ps:GetEquippedItem(player, "PointEffects") == product.Id then
		return false, "AlreadyEquipped"
	end

	return true, nil
end

function PointEffectProvider:OnPurchased(player: Player, product: ProductDefinition): (boolean, string?)
	if not self:GetProduct(product.Id) or not hasResource(product.Id) then return false, "ProductUnavailable" end
	local ps = getPlayerService()
	if not ps then
		return false, "PlayerServiceNotAvailable"
	end

	local ok, err = ps:AddItem(player, "PointEffects", product.Id)
	if not ok then
		return false, err or "FailedToAddOwnership"
	end

	return true, nil
end

function PointEffectProvider:OnEquipped(player: Player, product: ProductDefinition): (boolean, string?)
	if not self:GetProduct(product.Id) or not hasResource(product.Id) then return false, "ProductUnavailable" end
	local ps = getPlayerService()
	if not ps then
		return false, "PlayerServiceNotAvailable"
	end

	local ok, err = ps:SetEquippedItem(player, "PointEffects", product.Id)
	if not ok then
		return false, err or "FailedToEquip"
	end

	return true, nil
end

function PointEffectProvider:OnUnequipped(player: Player, _product: ProductDefinition?): (boolean, string?)
	local ps = getPlayerService()
	if not ps then
		return false, "PlayerServiceNotAvailable"
	end

	-- Al desequipar un PointEffect, se restituye al efecto base universal (Basic)
	local ok, err = ps:SetEquippedItem(player, "PointEffects", PointEffectDefinitions.DefaultEffectId)
	if not ok then
		return false, err or "FailedToUnequip"
	end

	return true, nil
end

return PointEffectProvider
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="576">
        <Properties>
          <string name="Name">ShopRegistry</string>
          <string name="Source"><![CDATA[--!strict
-- ShopRegistry
-- Registro en memoria de ProductProviders y resolución desacoplada de catálogos.
-- Completamente agnóstico respecto a categorías concretas (no contiene lógica hardcodeada).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Types = require(ReplicatedStorage.Shared.Types)

type ProductDefinition = Types.ProductDefinition
type ProductProvider = Types.ProductProvider

local ShopRegistry = {}

ShopRegistry._providers = {} :: { [string]: ProductProvider }
ShopRegistry._productsById = {} :: { [string]: ProductDefinition }
ShopRegistry._productsByRobloxId = {} :: { [number]: ProductDefinition }

-- ==================================================
-- VALIDACIÓN Y REGISTRO DE PROVIDERS
-- ==================================================

-- Registra un ProductProvider e indexa sus productos en el catálogo unificado
function ShopRegistry:Register(provider: ProductProvider)
	assert(type(provider) == "table", "[ShopRegistry] El proveedor debe ser una tabla")

	-- Validación estricta del contrato de métodos de ProductProvider
	assert(type(provider.GetCategory) == "function", "[ShopRegistry] Proveedor no implementa GetCategory()")
	assert(type(provider.GetProducts) == "function", "[ShopRegistry] Proveedor no implementa GetProducts()")
	assert(type(provider.GetProduct) == "function", "[ShopRegistry] Proveedor no implementa GetProduct()")
	assert(type(provider.CanPurchase) == "function", "[ShopRegistry] Proveedor no implementa CanPurchase()")
	assert(type(provider.CanEquip) == "function", "[ShopRegistry] Proveedor no implementa CanEquip()")
	assert(type(provider.OnPurchased) == "function", "[ShopRegistry] Proveedor no implementa OnPurchased()")
	assert(type(provider.OnEquipped) == "function", "[ShopRegistry] Proveedor no implementa OnEquipped()")
	assert(type(provider.OnUnequipped) == "function", "[ShopRegistry] Proveedor no implementa OnUnequipped()")

	local category = provider:GetCategory()
	assert(type(category) == "string" and category ~= "", "[ShopRegistry] GetCategory() debe retornar un string no vacío")
	assert(self._providers[category] == nil, string.format("[ShopRegistry] Categoría duplicada: el proveedor para '%s' ya está registrado", category))

	local products = provider:GetProducts()
	assert(type(products) == "table", string.format("[ShopRegistry] GetProducts() para '%s' debe retornar una tabla", category))

	-- Validación e indexación de cada producto del proveedor
	for _, product in ipairs(products) do
		assert(type(product) == "table", string.format("[ShopRegistry] Producto inválido encontrado en la categoría '%s'", category))
		assert(type(product.Id) == "string" and product.Id ~= "", string.format("[ShopRegistry] Producto sin Id válido en la categoría '%s'", category))
		assert(product.Category == category, string.format("[ShopRegistry] Category del producto '%s' ('%s') no coincide con la categoría del provider ('%s')", product.Id, tostring(product.Category), category))
		assert(product.ProductType == "Cosmetic" or product.ProductType == "Consumable" or product.ProductType == "Ability", string.format("[ShopRegistry] ProductType inválido ('%s') en el producto '%s'", tostring(product.ProductType), product.Id))
		assert(type(product.DisplayName) == "string" and product.DisplayName ~= "", string.format("[ShopRegistry] DisplayName inválido en el producto '%s'", product.Id))
		assert(type(product.Price) == "number" and product.Price >= 0 and product.Price < math.huge and product.Price % 1 == 0, string.format("[ShopRegistry] Price inválido (debe ser >= 0) en el producto '%s'", product.Id))
		assert(product.Currency == "Coins" or product.Currency == "Robux", string.format("[ShopRegistry] Currency inválido ('%s') en el producto '%s'. Debe ser 'Coins' o 'Robux'", tostring(product.Currency), product.Id))
		assert(type(product.IsAvailable) == "boolean", string.format("[ShopRegistry] IsAvailable debe ser booleano en el producto '%s'", product.Id))

		if product.Currency == "Robux" then
			assert(type(product.RobloxProductId) == "number" and product.RobloxProductId > 0, string.format("[ShopRegistry] Producto Robux '%s' requiere un RobloxProductId numérico positivo obligatorio", product.Id))
		end

		local key = category .. ":" .. product.Id
			assert(self._productsById[key] == nil, string.format("[ShopRegistry] Id de producto duplicado detectado: '%s'", product.Id))

		self._productsById[key] = product
		if product.RobloxProductId then
			self._productsByRobloxId[product.RobloxProductId] = product
		end
	end

	self._providers[category] = provider
	print(string.format("[ShopRegistry] Proveedor registrado exitosamente para la categoría '%s' (%d productos indexados)", category, #products))
end

-- ==================================================
-- CONSULTA Y RESOLUCIÓN
-- ==================================================

-- Retorna el ProductProvider registrado para una categoría
function ShopRegistry:GetProvider(category: string): ProductProvider?
	if type(category) ~= "string" or category == "" then
		return nil
	end
	return self._providers[category]
end

-- Retorna todos los proveedores registrados en un diccionario por categoría
function ShopRegistry:GetProviders(): { [string]: ProductProvider }
	local copy: { [string]: ProductProvider } = {}
	for category, provider in pairs(self._providers) do
		copy[category] = provider
	end
	return copy
end

-- Identity is (Category, Id). An ambiguous legacy Id alone is rejected.
function ShopRegistry:GetProduct(productId: string, category: string?): ProductDefinition?
 if type(productId) ~= "string" or productId == "" then return nil end
 if category ~= nil then
  if type(category) ~= "string" or category == "" then return nil end
  if not self._productsById[category .. ":" .. productId] then return nil end
  local provider = self:GetProvider(category)
  return if provider then provider:GetProduct(productId) else nil
 end
 -- Legacy one-argument API remains valid only for unambiguous IDs.
 local result: ProductDefinition? = nil
 for _, product in pairs(self._productsById) do
  if product.Id == productId then
   if result then return nil end
   result = product
  end
 end
 return if result then self:GetProduct(result.Id,result.Category) else nil
end

-- Retorna la definición de un producto por su RobloxProductId oficial
function ShopRegistry:GetProductByRobloxId(robloxId: number): ProductDefinition?
	if type(robloxId) ~= "number" or robloxId <= 0 then
		return nil
	end
	return self._productsByRobloxId[robloxId]
end

-- Retorna el catálogo completo unificado de todos los productos registrados
function ShopRegistry:GetCatalog(): { ProductDefinition }
	local catalog: { ProductDefinition } = {}
	for _, product in pairs(self._productsById) do
		local current = self:GetProduct(product.Id, product.Category)
		if current then table.insert(catalog, current) end
	end
	return catalog
end

-- Retorna los productos pertenecientes a una categoría específica
function ShopRegistry:GetCategoryProducts(category: string): { ProductDefinition }
	local provider = self:GetProvider(category)
	if not provider then
		return {}
	end
	return provider:GetProducts()
end

-- Verifica si existe un proveedor registrado para una categoría
function ShopRegistry:HasCategory(category: string): boolean
	return self._providers[category] ~= nil
end

-- Verifica si existe un producto registrado por su Id
function ShopRegistry:HasProduct(productId: string): boolean
	return self:GetProduct(productId) ~= nil
end

-- Limpia todos los proveedores y productos registrados (útil para pruebas o reinicialización)
function ShopRegistry:Clear()
	self._providers = {}
	self._productsById = {}
	self._productsByRobloxId = {}
end

return ShopRegistry
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="577">
        <Properties>
          <string name="Name">ShopRemotes</string>
          <string name="Source"><![CDATA[--!strict
-- ShopRemotes
-- Puente cliente-servidor del Shop Framework (Remote API definida en docs/SHOP_SYSTEM.md).
-- Expone en ReplicatedStorage.Remotes.Shop los RemoteFunctions:
--   GetCatalog()                  -> { ProductDefinition }   (vista pública, Metadata permitida explícitamente)
--   PurchaseProduct(productId)    -> (boolean, string?)
--   EquipProduct(productId)       -> (boolean, string?)
--   UnequipProduct(category)      -> (boolean, string?)
-- No contiene lógica de negocio: valida tipos, aplica rate-limit y delega en la API pública de ShopService.
-- Las actualizaciones de Coins e Inventory llegan al cliente por el contrato existente Remotes.Player.DataUpdated.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerScriptService = game:GetService("ServerScriptService")

local ShopRemotes = {}

local MAX_ARG_LENGTH = 64
local MIN_REQUEST_INTERVAL = 0.3 -- segundos entre operaciones mutantes por jugador

local _initialized = false
local _shopService: any = nil
local _lastRequest: { [Player]: number } = {}
local _connections: { RBXScriptConnection } = {}

local function ensureChild(parent: Instance, name: string, className: string): Instance
	local existing = parent:FindFirstChild(name)
	if existing and existing.ClassName == className then
		return existing
	end
	local inst = Instance.new(className)
	inst.Name = name
	inst.Parent = parent
	return inst
end

local function isValidArg(value: any): boolean
	return type(value) == "string" and value ~= "" and #value <= MAX_ARG_LENGTH
end

-- Rate-limit por jugador para operaciones que modifican estado
local function consumeRequest(player: Player): boolean
	local now = os.clock()
	local last = _lastRequest[player]
	if last and (now - last) < MIN_REQUEST_INTERVAL then
		return false
	end
	_lastRequest[player] = now
	return true
end

-- Ejecuta una operación de ShopService protegida contra errores internos
local function safeCall(fn: () -> (boolean, string?)): (boolean, string?)
	local ok, success, err = pcall(fn)
	if not ok then
		warn(string.format("[ShopRemotes] Error interno: %s", tostring(success)))
		return false, "InternalError"
	end
	return success == true, if success == true then nil else (err or "Failed")
end

-- Vista pública y serializable de un producto (whitelist de campos de ProductDefinition)
local function toPublicProduct(product: any): { [string]: any }
	local public: { [string]: any } = {
		Id = product.Id,
		Category = product.Category,
		ProductType = product.ProductType,
		DisplayName = product.DisplayName,
		Description = product.Description,
		Price = product.Price,
		Currency = product.Currency,
		IsAvailable = product.IsAvailable == true,
		Rarity = product.Rarity,
		Icon = product.Icon,
	}
	-- The UI needs commercial flags, never executable provider/server metadata.
	-- Missing/invalid flags fail closed; the server still resolves every price.
	if product.ProductType == "Ability" then
		local metadata = if type(product.Metadata) == "table" then product.Metadata else {}
		public.Metadata = {
			PurchaseEnabled = metadata.PurchaseEnabled == true,
			PriceApproved = metadata.PriceApproved == true,
			PricePending = metadata.PricePending == true,
		}
	end
		if product.Category == "Crates" then
			local metadata = if type(product.Metadata) == "table" then product.Metadata else {}
				public.SortOrder = product.SortOrder
			public.Metadata = {
					PriceApproved = metadata.PriceApproved == true,
				PricePending = metadata.PricePending == true,
					OddsApproved = metadata.OddsApproved == true,
					Enabled = metadata.Enabled == true,
					Model = if type(metadata.Model) == "string" then metadata.Model else "",
				PurchaseEnabled = metadata.PurchaseEnabled == true,
				ApprovalStatus = if type(metadata.ApprovalStatus) == "string" then metadata.ApprovalStatus else "Pending",
				FavouredVariations = if type(metadata.FavouredVariations) == "string" then metadata.FavouredVariations else "Pendiente",
			}
		end
	return public
end

-- Resuelve PlayerService por el contexto del Bootstrap (o la carpeta Services como respaldo)
local function getPlayerService(): any
	local context = _shopService and _shopService._context
	if context and type(context.GetService) == "function" then
		local s = context:GetService("PlayerService")
		if s then return s end
	end
	local servicesFolder = ServerScriptService:FindFirstChild("Services")
	local mod = servicesFolder and servicesFolder:FindFirstChild("PlayerService")
	if mod and mod:IsA("ModuleScript") then
		local ok, result = pcall(require, mod)
		if ok then return result end
	end
	return nil
end

-- Reenvía el snapshot autoritativo de PlayerData por el contrato existente DataUpdated.
-- Permite que la tienda conozca Coins/Inventory al abrirse aunque el evento inicial ya se haya consumido.
local function pushDataSnapshot(player: Player)
	if not player.Parent then return end
	local playerService = getPlayerService()
	if not playerService or type(playerService.GetPlayerData) ~= "function" then return end

	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	local playerFolder = remotes and remotes:FindFirstChild("Player")
	local dataUpdated = playerFolder and playerFolder:FindFirstChild("DataUpdated")
	if dataUpdated and dataUpdated:IsA("RemoteEvent") then
		dataUpdated:FireClient(player, playerService:GetPlayerData(player))
	end
end

function ShopRemotes:Init(shopService: any)
	if _initialized then return end
	-- No crear remotes en el DataModel de edición (evita contaminar el place al ejecutar tests en Edit Mode)
	if not RunService:IsRunning() then return end
	_initialized = true
	_shopService = shopService

	local remotesFolder = ensureChild(ReplicatedStorage, "Remotes", "Folder")
	local shopFolder = ensureChild(remotesFolder, "Shop", "Folder")

	local getCatalog = ensureChild(shopFolder, "GetCatalog", "RemoteFunction") :: RemoteFunction
	local purchase = ensureChild(shopFolder, "PurchaseProduct", "RemoteFunction") :: RemoteFunction
	local equip = ensureChild(shopFolder, "EquipProduct", "RemoteFunction") :: RemoteFunction
	local unequip = ensureChild(shopFolder, "UnequipProduct", "RemoteFunction") :: RemoteFunction

	getCatalog.OnServerInvoke = function(player: Player, category: any)
		local filter: string? = if isValidArg(category) then category else nil
		local ok, catalog = pcall(function()
			return _shopService:GetCatalog(filter)
		end)
		local result = {}
		if ok and type(catalog) == "table" then
			for _, product in ipairs(catalog) do
				table.insert(result, toPublicProduct(product))
			end
		else
			warn(string.format("[ShopRemotes] GetCatalog falló: %s", tostring(catalog)))
		end
		task.defer(pushDataSnapshot, player)
		return result
	end

	purchase.OnServerInvoke = function(player: Player, productId: any, category: any)
		if not isValidArg(productId) then return false, "InvalidProductId" end
		if category ~= nil and not isValidArg(category) then return false, "InvalidCategory" end
		if not consumeRequest(player) then return false, "RateLimited" end
		return safeCall(function()
			return _shopService:PurchaseProduct(player, productId, category)
		end)
	end

	equip.OnServerInvoke = function(player: Player, productId: any, category: any)
		if not isValidArg(productId) then return false, "InvalidProductId" end
		if category ~= nil and not isValidArg(category) then return false, "InvalidCategory" end
		if not consumeRequest(player) then return false, "RateLimited" end
		return safeCall(function()
			return _shopService:EquipProduct(player, productId, category)
		end)
	end

	unequip.OnServerInvoke = function(player: Player, category: any)
		if not isValidArg(category) then return false, "InvalidCategory" end
		if not consumeRequest(player) then return false, "RateLimited" end
		return safeCall(function()
			return _shopService:UnequipProduct(player, category)
		end)
	end

	table.insert(_connections, Players.PlayerRemoving:Connect(function(player)
		_lastRequest[player] = nil
	end))

	print("[ShopRemotes] Remote API de tienda lista (GetCatalog, PurchaseProduct, EquipProduct, UnequipProduct)")
end

return ShopRemotes
